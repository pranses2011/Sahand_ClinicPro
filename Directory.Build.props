<Project>
  <!-- ═══════════════════════════════════════════════════════════════
       تنظیمات مشترک ساخت برای همه پروژه‌های Solution
       پروژه: Sahand ClinicPro - سامانه جامع مدیریت درمانگاه سهند
       این فایل به‌صورت خودکار روی تمام ۱۱ پروژه اعمال می‌شود.
       ═══════════════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <!-- زبان C# نسخه ۱۲ روی .NET 8 LTS -->
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- تولید فایل مستندات XML — الزام کامنت XML فارسی برای اعضای عمومی -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- هشدار «کامنت XML ندارد» غیرفعال است تا قالب‌ها هشدار ندهند؛
         اما قاعده پروژه: هر عضو عمومی حتماً کامنت XML فارسی دارد -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- ⚠️ سرکوب هشدار ممیزی NU1903 در خروجی Build (نظیر به نظیر):
         AutoMapper 13.0.1 — آسیب‌پذیری GHSA-rvv3-g6hj-g44x (DoS نگاشت گراف عمیق)
         رفع فقط در نسخه‌های تجاری 15.1.1+/16.1.1+ است. ریسک پذیرفته‌شده است چون:
         ۱) همه نوع‌های نگاشت توسط تیم تعریف می‌شوند نه مهاجم
         ۲) ورودی مرزی با FluentValidation و سقف سایز درخواست محدود است
         ۳) بازبینی و تصمیم مهاجرت (Mapperly یا خرید لایسنس) در گام ۲۹
         نکته: ممیزی امنیتی همچنان با دستور «dotnet list package» به‌همراه
         سوییچ vulnerable در dotnet فعال است.
         بعد از ارتقاء SDK یا خروج از AutoMapper، این سرکوب باید حذف شود. -->

    <!-- ساخت پروژه‌های ویندوزی (WPF) روی لینوکس/CI نیز ممکن باشد -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- اطلاعات اسمبلی -->
    <!-- نسخهٔ ۲.۴.۹: وصلهٔ فوری چرخهٔ سی‌وششم — ترمیم خطای ساخت بستهٔ v2.4.۸ (using رسانه‌ای + ترتیب استاتیک + کامنت XML پارامتر) -->
    <!-- نسخهٔ ۲.۴.۱۰: چرخهٔ سی‌وهفتم — ۸ گزارش مالک (منو/کمبو/پیام‌ها/نسخه/ساعت/تعرفه/فوق‌تخصص/بندانگشتی) -->
    <!-- نسخهٔ ۲.۵.۰: چرخهٔ سی‌وهشتم — ۱۱ گزارش مالک (تور RTL/همزمانی لایسنس/سطح دسترسی/پروفایل کاربر/گزارش‌ها و چاپ/وسط‌چین سربرگ/لاگ رنگی/توست/دیالوگ/اسپلش) -->
    <!-- نسخهٔ ۲.۵.۱: چرخهٔ چهلم — وصلهٔ بیلد: ریشه‌یابی کامل خطاهای Rebuild مالک
         (MC3074 xmlns بی‌winfx تور/MC3089 فرزند دوتایی ScrollViewer حسابداری و Border داشبورد/
         CS0165 متغیر الگوی sc/CS8603 DateFa + سه خطای ماسک‌شده که فقط پس از عبور از لایهٔ
         اول آشکار شدند) → بیلد کامل سولوشن ۱۱ پروژه بدون هیچ خطا و هشدار -->
    <!-- نسخهٔ ۲.۶.۱: چرخهٔ چهل‌ودوم — ۴ گزارش مالک: رفع خطای خروج از حساب (Show روی
         پنجرهٔ بستهٔ Singleton؛ معماری «نمونهٔ زنده یا نمونهٔ نو» + DI پنجره‌ها Transient) +
         حذف Breadcrumb از هدر (فقط نام صفحه و بج ساعت وسط، با لایهٔ ColumnSpan برای وسط واقعی) +
         پرسنل: بذر ۳۰ سمت/۱۷ دپارتمان درمانگاهی + رفع پاک‌شدن سمت/دپارتمان هنگام ویرایش +
         بازطراحی حرفه‌ای انتخابگر میانبرهای داشبورد (گروه‌بندی دسته‌ای/انتخاب چندگانه) -->
    <!-- نسخهٔ ۲.۸.۰: چرخهٔ چهل‌وچهارم — ۱۱ گزارش مالک: ریشهٔ قطعی لاگ عملیات
         (نگاشت زیرمنبعی hr/employees → Employees؛ زنجیرهٔ ۴مرحله‌ای دوبستگی/کامل/پسوندی/
         مستعار) + معماری «شروع نشست» (خروج از حساب و ورود کاربر دوم، همه‌چیز نو می‌شود:
         نام/عکس/منو/میانبرها/بلادرنگ) + خطای خروج از برنامه (Close تعویق‌شده پس از await
         در هندلر Closing) + بیمهٔ خودکار پذیرش از پروندهٔ بیمار + بازسازی کامل تعریف
         شیفت/تخصیص به پرسنل (انتخابگر ساعت/تاریخ + جستجوی پرسنل + ویرایش/حذف/پایان) +
         دکمه‌های مردهٔ انتخابگر ساعت در دیتاگرید (Focusable=False + ClickMode=Press) +
         تولتیپ چسبیده به نشانگر (استایل ضمنی سراسری) + حذف داشبورد از لیست میانبرها +
         نقش‌ها: عنوان فارسی ۵ ماژول جدید + جستجو + ردیابی ذخیره‌نشده + بازطراحی +
         سربرگ‌های گرادیانی پذیرش/نوبت‌دهی/داشبورد/نقش‌ها -->
    <!-- نسخهٔ ۲.۹.۰: چرخهٔ چهل‌وپنجم — ۶ گزارش مالک: رفع کاشی‌های میانبر ناقص (سازوکار
         برش DropShadowEffect + MinHeight تضمینی) + بریده‌شدن پایین توست (پایهٔ نادرست
         TranslateTransform) + دکمه‌های مدیریتی کاملاً گرد + ریشهٔ نیامدن لیست اقلام
         مصرفی پذیرش (بارگذاری یک‌بارهٔ تک‌نمونه — اکنون با هر نوسازی صفحه تازه
         می‌شود + آشکارسازی خطا) + ورود کالای دسته‌جمعی (فهرستی: افزودن ردیف‌ها و
         ثبت همه با گزارش مستقل هر ردیف) + سربرگ‌های گرادیانی بیماران/مصرفی‌ها/
         ویزیت/میزکار پزشک -->
    <!-- نسخهٔ ۲.۱۳.۰: چرخهٔ چهل‌ونهم و پنجاهم «فاز ۰ — تثبیت اضطراری» (بازبینی
         مستقل ai-review): حذف کلید امضای JWT از مخزن (BUG-01) + گارد Fail-Fast
         سه‌لایه در تولید (غایب/کوتاه/الگوی ناامن — کلید پیشین مخزن از گارد قدیمی
         رد می‌شد) + پشتیبانی DOTNET_ENVIRONMENT + سیاست Rate Limit اندپوینت‌های
         لایسنس (۲۰/دقیقه) + رفع انسداد رشته‌ای ساخت سرویس پشتیبان ابری با قفل
         SemaphoreSlim (BUG-02) + رفع خواندن هم‌گام نتیجهٔ Taskها در صفحهٔ گزارش‌ها
         (BUG-03) + اسکنر ۶ گیته الگوهای ممنوعه scripts/security/scan_secrets.sh +
         راهنمای استقرار کلید docs/guides/deploy-jwt.md + ۳ تست رگرسیون امنیتی
         و ۴ تست رگرسیون پایداری (۵۰ درخواست همزمان ابری + گزارش‌ها) -->
    <!-- نسخهٔ ۲.۱۵.۱: چرخهٔ ۶۸ «وصلهٔ انبارگردانی» — رفع کرش ۵۰۰ فهرست انبارگردانی
         (خواندن پراپرتی محاسباتی Difference در پروجکشن سمت-سرور که قابل ترجمه به
         SQL نبود) + ترمیم جابه‌جایی تاریخی کسری/زیادندی در فهرست و جزئیات +
         دو تست رگرسیون SQLite (موتور ترجمهٔ واقعی؛ InMemory هرگز SQL تولید نمی‌کرد) -->
    <!-- نسخهٔ ۲.۱۶.۰: چرخهٔ ۶۹ «فاز ۳ — قابلیت‌های ایمنی و تجربه» — یادآوری خودکار
         نوبت (پیامک ۲۴/۲ ساعت + ساعات سکوت + Hangfire ساعتی) · مرکز هشدار انقضای
         پلکانی ۹۰/۶۰/۳۰/۷ · موتور تفسیر نتیجهٔ آزمایش بر اساس سن/جنسیت (فلگ
         L/H/LL/HH + رنگ ردیف + فرم اختصاصی ثبت با دابل‌کلیک + مقدار بحرانی با
         دیالوگ مسدودکننده) + رفع دو باگ تاریخی تفسیر · جستجوی یکپارچهٔ Ctrl+K ·
         QR راستی‌آزمایی نسخه + امضای دیجیتال پزشک + برچسب QR نمونهٔ آزمایشگاه ·
         کپی ویزیت قبلی + یادداشت سریع + برچسب بیمار (VIP/مزمن) · کیوسک سالن
         انتظار + رفع باگ تاریخی صف پیامک (ارسال کد قالب به بیمار) -->
    <!-- نسخهٔ ۲.۱۷.۲: چرخهٔ ۷۲ «بازه‌های مرجع + لاگ عملیات + داشبورد جدید» —
         پنج گزارش مالک: بذر کامل بازه‌های مرجع و حدود بحرانی ۱۵۰+ آزمایش
         (خودکار هنگام نصب + فرم ویرایش مالک)، ریشه‌کن نام‌کاربری/خط‌تیرهٔ
         لاگ عملیات، رفع صفرِ گزارش‌ها + گره مرز روز ایران، انتخابگر تاریخ
         دوگانه (تایپ دستی + آیکون تقویم)، بازطراحی کامل داشبورد (۵ کارت
         KPI + سه نمودار جدید) و پنل میانبرهای طراحی صفرِ جدید -->
    <!-- نسخهٔ ۲.۱۷.۱: چرخهٔ ۷۱ «وصلهٔ راه‌اندازی سرور» — رفع سه لاگِ هر استارتِ
         API: ERR «InvalidCastException Int32→Int64» (خط ~۲۵۵ InitializeDatabaseAsync)
         + WRN «First/FirstOrDefault without OrderBy and filter» + WRN «پرکردن
         سندهای قدیمی ناموفق». ریشه: کوئری شمارش با SqlQueryRaw<long> روی COUNT(*)
         که در SQL Server همیشه int برمی‌گرداند و EF برای long سرراست GetInt64
         می‌زند. رفع: حذف کوئری شمارش — تعداد ردیف‌های پرشده از خروجی خودِ
         ExecuteSqlRawAsync (سطرهای تحت‌تأثیر UPDATE)؛ یک رفت‌وبرگشت کمتر و
         بدون هشدار، حتی روی دیتابیسِ کاملاً سالم -->
    <!-- نسخهٔ ۲.۱۹.۲: چرخهٔ ۷۷ «وصلهٔ بحرانی راه‌اندازی» — رفع کرش کامل
         برنامه هنگام بالا آمدن با تم تیرهٔ ذخیره‌شده:
         InvalidOperationException «ColorReference does not contain any color»
         در PaletteHelper.SetTheme. ریشه: چرخهٔ ۷۶ برای کنتراست تیره، کل شیء
         Theme.Cards را با نمونهٔ نو (فقط Background مقداردهی‌شده) جایگزین
         می‌کرد؛ مرجع رنگ Borderِ Card خالی می‌ماند و ApplyThemeColors
         کتابخانه هنگام تبدیل به Color منفجر می‌شد. رفع: تغییر درجا
         (Cards.Background/Cards.Border روی همان شیء موجود) + حاشیهٔ کارت
         تیره به‌جای خاکستری روشن پیش‌فرض کتابخانه -->
    <Version>2.28.31</Version>
    <Authors>Sahand ClinicPro Team</Authors>
    <Company>Sahand</Company>
    <Product>Sahand ClinicPro</Product>
    <Description>سامانه جامع مدیریت درمانگاه سهند - Clinic Management System</Description>
    <Copyright>Copyright © 2026 Sahand ClinicPro</Copyright>
    <NeutralLanguage>fa-IR</NeutralLanguage>
    <RepositoryUrl>https://github.com/pranses2011/Sahand_ClinicPro</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- ساخت تکرارپذیر و امن -->
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- ⚠️ چرخه ۲۵ — ریشهٔ هشدارهای MC3072/MC3074 در ویژوال استودیو:
         تا اینجا true بود و «بیلد شتاب‌یافته» (Accelerated Build) در VS
         بخش‌های Design-Time Build را دور می‌زند؛ در نتیجه ویرایشگر XAML
         اسمبلی‌های NuGet (مثل MaterialDesignThemes) را resolve نمی‌کرد و
         برای همهٔ PackIcon/BundledTheme/Card/HintAssist/ColorZoneAssist/
         DataGridAssist هشدارِ «در XML namespace وجود ندارد» می‌داد، در
         حالی که بیلد واقعی (dotnet build) کاملاً تمیز و بدون هیچ خطا/
         هشدار MC است. با false شدن، هوشمندی XAML و Intellisense کامل
         برمی‌گردد؛ تنها بهای آن کمی کندتر شدن بیلدِ داخل IDE است. -->
    <AccelerateBuildsInVisualStudio>false</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

  <ItemGroup>
    <!-- ⚠️ سرکوب دقیق پکیج/نسخه برای SDKهای آینده (NuGetAuditSuppress در
         NuGet 6.13+ معتبر است؛ در SDK فعلی توسط NoWarn بالا پوشش داده می‌شود):
         AutoMapper 13.0.1 — جزئیات و توجیه در TODO.md پیگیری می‌شود. -->
  </ItemGroup>
</Project>
