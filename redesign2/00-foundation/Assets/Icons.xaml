<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔══════════════════════════════════════════════════════════════════════╗
    ║  کتابخانهٔ آیکون — آیکون‌های خطیِ حرفه‌ای                              ║
    ║  منبع: Lucide 0.469 (مجوز MIT) · قالب: StreamGeometry                ║
    ╠══════════════════════════════════════════════════════════════════════╣
    ║  نحوهٔ استفاده:                                                       ║
    ║      <Path Style="{DynamicResource Icon.Small}"                       ║
    ║            Data="{DynamicResource Icon.HeartPulse}" />               ║
    ║                                                                       ║
    ║  چرا Stroke و نه Fill؟                                                ║
    ║      Lucide یک مجموعهٔ خطی است (fill:none; stroke:currentColor).      ║
    ║      ترسیم آن با Fill شکلِ درستی نمی‌سازد؛ بنابراین سبک‌های Icon.*   ║
    ║      از Stroke با سرِ گرد و اتصالِ گرد استفاده می‌کنند.                ║
    ║                                                                       ║
    ║  رنگ: همهٔ سبک‌ها از قلم‌موهای معناییِ تم استفاده می‌کنند؛              ║
    ║  تعویضِ تمِ روشن/تاریک نیازی به تغییر این فایل ندارد.                  ║
    ║                                                                       ║
    ║  این فایل به‌صورت خودکار توسط tools/build_icons.py ساخته شده است؛     ║
    ║  آن را دستی ویرایش نکنید.                                             ║
    ╚══════════════════════════════════════════════════════════════════════╝
    -->

    <!-- ══════════════════════════════════════════════════════════════════
         اندازه‌های استانداردِ آیکون

         ضخامتِ خط به‌صورت «ضخامتِ هدف ÷ مقیاس» محاسبه می‌شود تا وزنِ
         بصریِ آیکون در همهٔ اندازه‌ها یکسان بماند:
             مقیاس = اندازه ÷ 24  →  ضخامت = 1.75 ÷ مقیاس
    ══════════════════════════════════════════════════════════════════ -->

    <!-- آیکونِ همراهِ متنِ ریز -->
    <Style x:Key="Icon.XSmall" TargetType="Path">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="StrokeThickness" Value="3.5" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeMiterLimit" Value="10" />
    </Style>

    <!-- آیکونِ درون‌خطی (دکمه‌ها، برچسب‌ها) -->
    <Style x:Key="Icon.Small" TargetType="Path">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource Brush.Text}" />
        <Setter Property="StrokeThickness" Value="2.8" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeMiterLimit" Value="10" />
    </Style>

    <!-- آیکونِ استانداردِ منو و تب -->
    <Style x:Key="Icon.Medium" TargetType="Path">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource Brush.Text}" />
        <Setter Property="StrokeThickness" Value="2.33" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeMiterLimit" Value="10" />
    </Style>

    <!-- آیکونِ شاخص و سربرگ -->
    <Style x:Key="Icon.Large" TargetType="Path">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource Brush.Text}" />
        <Setter Property="StrokeThickness" Value="1.91" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeMiterLimit" Value="10" />
    </Style>

    <!-- آیکونِ نمایشی روی زمینهٔ رنگی -->
    <Style x:Key="Icon.Display" TargetType="Path">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource Brush.OnPrimary}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeMiterLimit" Value="10" />
    </Style>

