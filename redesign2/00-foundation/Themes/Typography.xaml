<!--
  🔤 مقیاس نوعی — فونت Vazirmatn برای متن فارسی
  ═══════════════════════════════════════════════════════════════════════
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- خانواده‌ی قلم -->
    <FontFamily x:Key="Font.Regular">pack://application:,,,/Fonts/#Vazirmatn Regular</FontFamily>
    <FontFamily x:Key="Font.Medium">pack://application:,,,/Fonts/#Vazirmatn Medium</FontFamily>
    <FontFamily x:Key="Font.Bold">pack://application:,,,/Fonts/#Vazirmatn Bold</FontFamily>

    <!-- مقیاس اندازه‌ها -->
    <sys:Double x:Key="Fs.Overline">11</sys:Double>
    <sys:Double x:Key="Fs.Caption">12</sys:Double>
    <sys:Double x:Key="Fs.Body">14</sys:Double>
    <sys:Double x:Key="Fs.Subtitle">16</sys:Double>
    <sys:Double x:Key="Fs.Title">20</sys:Double>
    <sys:Double x:Key="Fs.Headline">24</sys:Double>
    <sys:Double x:Key="Fs.Display">32</sys:Double>
    <sys:Double x:Key="Fs.Hero">44</sys:Double>

    <!-- ══════════ سبک‌های متنی ══════════ -->
    <Style x:Key="Txt.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Bold}" />
        <Setter Property="FontSize" Value="{DynamicResource Fs.Display}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="LineHeight" Value="40" />
    </Style>

    <Style x:Key="Txt.Headline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Bold}" />
        <Setter Property="FontSize" Value="{DynamicResource Fs.Headline}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="LineHeight" Value="32" />
    </Style>

    <Style x:Key="Txt.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Medium}" />
        <Setter Property="FontSize" Value="{DynamicResource Fs.Title}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="LineHeight" Value="28" />
    </Style>

    <Style x:Key="Txt.Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Medium}" />
        <Setter Property="FontSize" Value="{DynamicResource Fs.Subtitle}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="LineHeight" Value="24" />
    </Style>

    <Style x:Key="Txt.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Regular}" />
        <Setter Property="FontSize" Value="{DynamicResource Fs.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="LineHeight" Value="22" />
    </Style>

    <Style x:Key="Txt.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Txt.Body}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>

    <Style x:Key="Txt.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Regular}" />
        <Setter Property="FontSize" Value="{DynamicResource Fs.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="LineHeight" Value="18" />
    </Style>

    <Style x:Key="Txt.Overline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Medium}" />
        <Setter Property="FontSize" Value="{DynamicResource Fs.Overline}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="LineHeight" Value="16" />
    </Style>

    <Style x:Key="Txt.Numeric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Medium}" />
        <Setter Property="FontSize" Value="{DynamicResource Fs.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

</ResourceDictionary>
