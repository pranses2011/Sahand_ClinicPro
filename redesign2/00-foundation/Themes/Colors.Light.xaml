<!--
  ═══════════════════════════════════════════════════════════════════════
  🎨 پالت رنگ — تم روشن (Light)
  ═══════════════════════════════════════════════════════════════════════
  این فایل تنها شامل «رنگ‌های خام» است. برای استفاده در Viewها
  هرگز مستقیماً از این کلیدها استفاده نکنید؛ همیشه از کلیدهای
  معناییِ Tokens.xaml (مانند Brush.Primary) استفاده شود تا
  تعویض تم در لحظه به‌درستی کار کند.
  ═══════════════════════════════════════════════════════════════════════
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 🎯 رنگ اصلی برند (Teal) -->
    <Color x:Key="C.Primary">#0D9488</Color>
    <Color x:Key="C.PrimaryDark">#0F766E</Color>
    <Color x:Key="C.PrimaryLight">#CCFBF1</Color>
    <Color x:Key="C.OnPrimary">#FFFFFF</Color>

    <!-- 💜 رنگ ثانویه -->
    <Color x:Key="C.Secondary">#7C3AED</Color>
    <Color x:Key="C.SecondaryLight">#EDE9FE</Color>
    <Color x:Key="C.OnSecondary">#FFFFFF</Color>

    <!-- 📊 رنگ‌های وضعیت -->
    <Color x:Key="C.Success">#15803D</Color>
    <Color x:Key="C.SuccessLight">#DCFCE7</Color>
    <Color x:Key="C.Warning">#B45309</Color>
    <Color x:Key="C.WarningLight">#FEF3C7</Color>
    <Color x:Key="C.Danger">#BE123C</Color>
    <Color x:Key="C.DangerLight">#FFE4E6</Color>
    <Color x:Key="C.Info">#0369A1</Color>
    <Color x:Key="C.InfoLight">#E0F2FE</Color>

    <!-- 🔤 رنگ‌های متن -->
    <Color x:Key="C.Text">#1E293B</Color>
    <Color x:Key="C.TextSecondary">#64748B</Color>
    <Color x:Key="C.TextMuted">#94A3B8</Color>
    <Color x:Key="C.TextDisabled">#CBD5E1</Color>

    <!-- 🩶 رنگ‌های سطح -->
    <Color x:Key="C.Surface">#FFFFFF</Color>
    <Color x:Key="C.SurfaceAlt">#F8FAFC</Color>
    <Color x:Key="C.SurfaceHover">#F1F5F9</Color>
    <Color x:Key="C.Canvas">#EFF3F8</Color>
    <Color x:Key="C.Sidebar">#0F766E</Color>

    <!-- 📏 رنگ‌های خطوط -->
    <Color x:Key="C.Border">#E2E8F0</Color>
    <Color x:Key="C.BorderStrong">#CBD5E1</Color>
    <Color x:Key="C.Focus">#0D9488</Color>

    <!-- 🏥 رنگ‌های تخصصی پزشکی -->
    <Color x:Key="C.Med.Blood">#DC2626</Color>
    <Color x:Key="C.Med.Heart">#E11D48</Color>
    <Color x:Key="C.Med.Bone">#78716C</Color>
    <Color x:Key="C.Med.Drug">#8B5CF6</Color>
    <Color x:Key="C.Med.Lab">#0891B2</Color>
    <Color x:Key="C.Med.Imaging">#475569</Color>
    <Color x:Key="C.Med.Dental">#0EA5E9</Color>

    <!-- 🌑 سایه -->
    <Color x:Key="C.Shadow">#1E293B</Color>

</ResourceDictionary>
