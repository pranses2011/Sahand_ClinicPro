<!--
  🔍 مولکول: SearchBox — جستجو با تأخیر، دکمه‌ی پاک‌کردن و میانبر
  ═══════════════════════════════════════════════════════════════════════
    Text         — متن جستجو (دوطرفه)
    Placeholder  — متن راهنما
    SearchCommand— فرمان اجرا پس از تأخیر
  ═══════════════════════════════════════════════════════════════════════
-->
<UserControl x:Class="Sahand.ClinicPro.Desktop.Controls.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Sahand.ClinicPro.Desktop.Localization"
             x:Name="Root"
             FlowDirection="RightToLeft">

    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.BorderStrong}"
            BorderThickness="1"
            CornerRadius="{DynamicResource R.Pill}"
            Height="{DynamicResource Size.InputHeight}"
            MinWidth="220"
            Padding="14,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ذره‌بین -->
            <Path Grid.Column="0"
                  Data="{DynamicResource Icon.Search}"
                  Width="15" Height="15"
                  Stretch="Uniform"
                  VerticalAlignment="Center"
                  Stroke="{DynamicResource Brush.TextMuted}"
                  StrokeThickness="2.8"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Margin="0,0,8,0" />

            <!-- ورودی -->
            <TextBox Grid.Column="1"
                     x:Name="InputBox"
                     Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                     Background="Transparent"
                     BorderThickness="0"
                     VerticalContentAlignment="Center"
                     FontFamily="{DynamicResource Font.Regular}"
                     FontSize="{DynamicResource Fs.Body}"
                     Foreground="{DynamicResource Brush.Text}"
                     CaretBrush="{DynamicResource Brush.Primary}" />

            <!-- متن راهنما -->
            <TextBlock Grid.Column="1"
                       Text="{Binding Placeholder, ElementName=Root}"
                       Style="{DynamicResource Txt.Caption}"
                       Foreground="{DynamicResource Brush.TextMuted}"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Txt.Caption}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=Root}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Text, ElementName=Root}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- دکمه‌ی پاک‌کردن -->
            <Button Grid.Column="2"
                    Style="{DynamicResource Btn.Icon}"
                    Width="24" Height="24"
                    Click="OnClearClick"
                    ToolTip="{loc:Loc Common.Clear}">
                <Button.Content>
                    <Path Data="{DynamicResource Icon.X}"
                          Width="12" Height="12"
                          Stretch="Uniform"
                          Stroke="{DynamicResource Brush.TextMuted}"
                          StrokeThickness="3.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />
                </Button.Content>
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=Root}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Text, ElementName=Root}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>
