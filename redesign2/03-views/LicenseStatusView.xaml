<!--
╔══════════════════════════════════════════════════════════════════════╗
║  وضعیت لایسنس — LicenseStatusView
╠══════════════════════════════════════════════════════════════════════╣
║  گروه        : سیستم
║  کهن‌الگو     : detail-tabs
║  ViewModel   : LicenseStatusViewModel
║  وایرفریم    : 01-wireframes-html/LicenseStatusView.html
╠══════════════════════════════════════════════════════════════════════╣
║  توضیح       : کارت وضعیت با نوار پیشرفتِ روزهای باقیمانده؛ جدول 
║                ماژول‌ها با چیپ‌های سبز/خاکستری.
╠══════════════════════════════════════════════════════════════════════╣
║  ساختار (اندازه‌ی هر فیلد/ستون بر پایه‌ی ۱۲ ستون است تا
║  «بزرگیِ عنصر متناسب با کارکردش» باشد — کد ملی ۳ ستون، نشانی ۱۲ ستون)
╠══════════════════════════════════════════════════════════════════════╣
║  نام              نوع              پهنا   الزامی
║  ─────────────────────────────────────────────────
║  ▸ ستون‌های جدول
║    Module          text             *      Right
║    Key             text             150px  Right
║    Expiry          date             130px  Right
║    Status          chip             124px  Center
╠══════════════════════════════════════════════════════════════════════╣
║  ارتباطات این صفحه
║  ─────────────────────────────────────────────────
║    وضعیت لایسنس  ──▶  فعال‌سازی لایسنس
║         ورود کلید مجوز
║    وضعیت لایسنس  ──▶  تنظیمات
║         تنظیمات پنل لایسنس
╚══════════════════════════════════════════════════════════════════════╝

  قواعدِ رعایت‌شده در این فایل:
    • راست‌چین (RTL) و قلمِ وزیرمتن در سراسرِ صفحه
    • هیچ رنگِ ثابت (هگز) — همه از نشانه‌های معناییِ DynamicResource
    • الگوی MVVM: هیچ منطقی در code-behind، همه چیز از ViewModel
    • متن‌ها از فایلِ زبان (loc:Loc) برای پشتیبانیِ دو زبانهٔ آینده
    • تاریخ‌ها با تبدیل‌گرِ PersianDate به شمسی نمایش داده می‌شوند
    • نقشهٔ ارتباطات در پایینِ صفحه مسیرِ حرکت را نشان می‌دهد
-->

<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.LicenseStatusView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        xmlns:loc="clr-namespace:Sahand.ClinicPro.Desktop.Localization"
        xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DesignHeight="820" d:DesignWidth="1280"
        d:DataContext="{d:DesignInstance vm:LicenseStatusViewModel}"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource Brush.Canvas}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ سربرگِ یکپارچه‌ی صفحه ═══ -->
        <ctrl:PageHeader Grid.Row="0"
                        Title="وضعیت لایسنس"
                        Subtitle="وضعیت مجوز و ماژول‌های فعال"
                        Icon="{DynamicResource Icon.ShieldCheck}"
                        Margin="{StaticResource P.Page}" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="{StaticResource P.Page}">
            <StackPanel>
                <ctrl:StatCard Margin="{StaticResource S.3}"
                                  Title="وضعیت"
                                  Value="فعال"
                                  Icon="{DynamicResource Icon.ShieldCheck}"
                                  Accent="{DynamicResource Brush.Success}"
                                  />
                <ctrl:StatCard Margin="{StaticResource S.3}"
                                  Title="روز باقیمانده"
                                  Value="۳۴۲"
                                  Icon="{DynamicResource Icon.CalendarClock}"
                                  Accent="{DynamicResource Brush.Primary}"
                                  />
                <ctrl:StatCard Margin="{StaticResource S.3}"
                                  Title="ماژول‌های فعال"
                                  Value="۲۷ از ۳۹"
                                  Icon="{DynamicResource Icon.Boxes}"
                                  Accent="{DynamicResource Brush.Info}"
                                  />
                <ctrl:StatCard Margin="{StaticResource S.3}"
                                  Title="کاربران مجاز"
                                  Value="۱۲"
                                  Icon="{DynamicResource Icon.Users}"
                                  Accent="{DynamicResource Brush.Warning}"
                                  />

                    <TabControl Style="{DynamicResource Tab.Modern}">
                        <TabItem Style="{DynamicResource Tab.Item}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{DynamicResource Icon.Small}"
                                          Data="{DynamicResource Icon.LayoutDashboard}" />
                                    <TextBlock Text="نمای کلی"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </TabItem.Header>
                            <!-- محتوای تب «نمای کلی» در ViewModel تأمین می‌شود -->
                            <ContentControl Content="{Binding TabContents[0]}" />
                        </TabItem>
                        <TabItem Style="{DynamicResource Tab.Item}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{DynamicResource Icon.Small}"
                                          Data="{DynamicResource Icon.Boxes}" />
                                    <TextBlock Text="ماژول‌ها"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </TabItem.Header>
                            <!-- محتوای تب «ماژول‌ها» در ViewModel تأمین می‌شود -->
                            <ContentControl Content="{Binding TabContents[1]}" />
                        </TabItem>
                        <TabItem Style="{DynamicResource Tab.Item}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{DynamicResource Icon.Small}"
                                          Data="{DynamicResource Icon.History}" />
                                    <TextBlock Text="تاریخچه"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </TabItem.Header>
                            <!-- محتوای تب «تاریخچه» در ViewModel تأمین می‌شود -->
                            <ContentControl Content="{Binding TabContents[2]}" />
                        </TabItem>
                        <TabItem Style="{DynamicResource Tab.Item}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{DynamicResource Icon.Small}"
                                          Data="{DynamicResource Icon.LifeBuoy}" />
                                    <TextBlock Text="پشتیبانی"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </TabItem.Header>
                            <!-- محتوای تب «پشتیبانی» در ViewModel تأمین می‌شود -->
                            <ContentControl Content="{Binding TabContents[3]}" />
                        </TabItem>
                    </TabControl>

                    <DataGrid Style="{DynamicResource Grid.Modern}"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              RowHeight="{StaticResource Size.RowHeight}"
                              FlowDirection="RightToLeft">
                        <DataGrid.Columns>
                            <!-- ماژول — نوع: text -->
                            <DataGridTextColumn Header="ماژول"
                                                Binding="{Binding Module}"
                                                Width="*"
                                                ElementStyle="{DynamicResource Txt.Body}" />
                            <!-- کلید — نوع: text -->
                            <DataGridTextColumn Header="کلید"
                                                Binding="{Binding Key}"
                                                Width="150"
                                                ElementStyle="{DynamicResource Txt.Body}" />
                            <!-- تاریخ انقضا — نوع: date -->
                            <DataGridTextColumn Header="تاریخ انقضا" Width="130" Binding="{Binding Expiry, Converter={StaticResource PersianDate}}" />
                            <!-- وضعیت — نوع: chip -->
                            <DataGridTemplateColumn Header="وضعیت" Width="124">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource Badge}"
                                                HorizontalAlignment="Center"
                                                Background="{Binding StatusTone, Converter={StaticResource StatusTone}}">
                                            <TextBlock Text="{Binding Status}"
                                                       Style="{DynamicResource Badge.Text}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ctrl:EmptyState Icon="{DynamicResource Icon.ShieldCheck}"
                                      Title="{loc:Loc Common.EmptyTitle}"
                                      Message="{loc:Loc Common.EmptyMessage}"
                                      Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            <!-- ══════════════════════════════════════════════════════════
     ارتباطاتِ این صفحه با دیگر صفحات
     هر ردیف: «مبدأ» → «مقصد» با توضیحِ نوعِ پیوند
     این بلوک در همه‌ی صفحات حضور دارد تا مسیرِ حرکتِ کاربر گم نشود.
     ══════════════════════════════════════════════════════════ -->
            <Border Style="{DynamicResource Card.Flat}" Margin="0,{StaticResource S.3},0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,{StaticResource S.3}">
                        <Path Style="{DynamicResource Icon.Small}"
                              Data="{DynamicResource Icon.GitBranch}"
                               Stroke="{DynamicResource Brush.Primary}" />
                        <TextBlock Text="{loc:Loc Common.Relations}"
                                   Style="{DynamicResource Txt.Subtitle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource S.2},0,0,0" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Relations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,{StaticResource S.2}">
                                    <Border Style="{DynamicResource Badge.Neutral}">
                                        <TextBlock Text="{Binding From}"
                                                   Style="{DynamicResource Badge.Text}" />
                                    </Border>
                                        <Path Style="{DynamicResource Icon.XSmall}"
                                              Data="{DynamicResource Icon.ArrowLeft}"
                                               Stroke="{DynamicResource Brush.TextMuted}" />
                                    <Border Style="{DynamicResource Badge.Info}">
                                        <TextBlock Text="{Binding To}"
                                                   Style="{DynamicResource Badge.Text}" />
                                    </Border>
                                    <TextBlock Text="{Binding Why}"
                                               Style="{DynamicResource Txt.Caption}"
                                               VerticalAlignment="Center"
                                               Margin="{StaticResource S.2},0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>