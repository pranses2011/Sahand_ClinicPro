<!--
╔══════════════════════════════════════════════════════════════════════╗
║  ویزیت پزشک — DoctorVisitView
╠══════════════════════════════════════════════════════════════════════╣
║  گروه        : نوبت‌دهی
║  کهن‌الگو     : split
║  ViewModel   : DoctorVisitViewModel
║  وایرفریم    : 01-wireframes-html/DoctorVisitView.html
╠══════════════════════════════════════════════════════════════════════╣
║  ساختار (اندازه‌ی هر فیلد/ستون بر پایه‌ی ۱۲ ستون است تا
║  «بزرگیِ عنصر متناسب با کارکردش» باشد — کد ملی ۳ ستون، نشانی ۱۲ ستون)
╠══════════════════════════════════════════════════════════════════════╣
║  نام              نوع              پهنا   الزامی
║  ─────────────────────────────────────────────────
║  ▸ ستون‌های جدول
║    Queue           num              64px   Center
║    Patient         who              *      Right
║    Service         text             140px  Right
║    Time            date             86px   Center
║    Status          chip             112px  Center
╠══════════════════════════════════════════════════════════════════════╣
║  ارتباطات این صفحه
║  ─────────────────────────────────────────────────
║    ویزیت پزشک  ──▶  پذیرش و صف
║         بیمار از صف می‌آید
║    ویزیت پزشک  ──▶  ویزیت (SOAP)
║         فرم ویزیت باز می‌شود
║    ویزیت پزشک  ──▶  فرم نسخه
║         پس از ویزیت
╚══════════════════════════════════════════════════════════════════════╝

  قواعدِ رعایت‌شده در این فایل:
    • راست‌چین (RTL) و قلمِ وزیرمتن در سراسرِ صفحه
    • هیچ رنگِ ثابت (هگز) — همه از نشانه‌های معناییِ DynamicResource
    • الگوی MVVM: هیچ منطقی در code-behind، همه چیز از ViewModel
    • متن‌ها از فایلِ زبان (loc:Loc) برای پشتیبانیِ دو زبانهٔ آینده
    • تاریخ‌ها با تبدیل‌گرِ PersianDate به شمسی نمایش داده می‌شوند
    • نقشهٔ ارتباطات در پایینِ صفحه مسیرِ حرکت را نشان می‌دهد
-->

<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.DoctorVisitView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        xmlns:loc="clr-namespace:Sahand.ClinicPro.Desktop.Localization"
        xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DesignHeight="820" d:DesignWidth="1280"
        d:DataContext="{d:DesignInstance vm:DoctorVisitViewModel}"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource Brush.Canvas}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ سربرگِ یکپارچه‌ی صفحه ═══ -->
        <ctrl:PageHeader Grid.Row="0"
                        Title="ویزیت پزشک"
                        Subtitle="میزکار پزشک: صف بیماران + فرم ویزیت"
                        Icon="{DynamicResource Icon.Stethoscope}"
                        Margin="{StaticResource P.Page}" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="{StaticResource P.Page}">
            <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
            <ItemsControl ItemsSource="{Binding Kpis}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ctrl:StatCard Margin="{StaticResource S.3}"
                                      Title="{Binding Title}"
                                      Value="{Binding Value}"
                                      Trend="{Binding Trend}"
                                      Icon="{Binding Icon}"
                                      Accent="{Binding Accent}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{DynamicResource Card.Flat}"
                    Padding="{StaticResource S.3}"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">

                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Left">
                    <Button Style="{DynamicResource Btn.Primary}"
                            Command="{Binding StartVisitCommand}"
                            Margin="0,0,{StaticResource S.2},0"
                            MinHeight="{StaticResource Size.ButtonHeight}"
                            Padding="{StaticResource P.Button}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{DynamicResource Icon.Small}"
                                  Data="{DynamicResource Icon.Play}"
                                  Margin="0,0,{StaticResource S.2},0" />
                            <TextBlock Text="شروع ویزیت" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource Btn.Secondary}"
                            Command="{Binding CallNextCommand}"
                            Margin="0,0,{StaticResource S.2},0"
                            MinHeight="{StaticResource Size.ButtonHeight}"
                            Padding="{StaticResource P.Button}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{DynamicResource Icon.Small}"
                                  Data="{DynamicResource Icon.ChevronLeft}"
                                  Margin="0,0,{StaticResource S.2},0" />
                            <TextBlock Text="فراخوانی بعدی" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource Btn.Secondary}"
                            Command="{Binding CompleteCommand}"
                            Margin="0,0,{StaticResource S.2},0"
                            MinHeight="{StaticResource Size.ButtonHeight}"
                            Padding="{StaticResource P.Button}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{DynamicResource Icon.Small}"
                                  Data="{DynamicResource Icon.Check}"
                                  Margin="0,0,{StaticResource S.2},0" />
                            <TextBlock Text="پایان ویزیت" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    </StackPanel>
                </Grid>
            </Border>

                    <DataGrid Style="{DynamicResource Grid.Modern}"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              RowHeight="{StaticResource Size.RowHeight}"
                              FlowDirection="RightToLeft">
                        <DataGrid.Columns>
                            <!-- نوبت — نوع: num -->
                            <DataGridTextColumn Header="نوبت"
                                                Binding="{Binding Queue}"
                                                Width="64"
                                                ElementStyle="{DynamicResource Txt.Body}" />
                            <!-- بیمار — نوع: who -->
                            <DataGridTemplateColumn Header="بیمار" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- نشانِ تصویریِ بیمار/کاربر -->
                                            <Border Width="30" Height="30"
                                                    CornerRadius="{StaticResource R.Pill}"
                                                    Background="{Binding PatientAvatar}"
                                                    Margin="0,0,{StaticResource S.2},0">
                                                <TextBlock Text="{Binding PatientInitials}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.OnPrimary}"
                                                           FontSize="{StaticResource Fs.Caption}" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Patient}"
                                                           Style="{DynamicResource Txt.Body}" />
                                                <TextBlock Text="{Binding PatientSub}"
                                                           Style="{DynamicResource Txt.Caption}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- خدمت — نوع: text -->
                            <DataGridTextColumn Header="خدمت"
                                                Binding="{Binding Service}"
                                                Width="140"
                                                ElementStyle="{DynamicResource Txt.Body}" />
                            <!-- ورود — نوع: date -->
                            <DataGridTextColumn Header="ورود" Width="86" Binding="{Binding Time, Converter={StaticResource PersianDate}}" />
                            <!-- وضعیت — نوع: chip -->
                            <DataGridTemplateColumn Header="وضعیت" Width="112">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource Badge}"
                                                HorizontalAlignment="Center"
                                                Background="{Binding StatusTone, Converter={StaticResource StatusTone}}">
                                            <TextBlock Text="{Binding Status}"
                                                       Style="{DynamicResource Badge.Text}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ctrl:EmptyState Icon="{DynamicResource Icon.Stethoscope}"
                                      Title="{loc:Loc Common.EmptyTitle}"
                                      Message="{loc:Loc Common.EmptyMessage}"
                                      Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    <Border Style="{DynamicResource Card.Flat}"
                            Padding="{StaticResource S.3}"
                            Margin="0,{StaticResource S.3},0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding PageSummary}"
                                       Style="{DynamicResource Txt.Caption}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{DynamicResource Btn.Icon}"
                                        Command="{Binding PreviousPageCommand}"
                                        ToolTip="{loc:Loc Common.Previous}">
                                    <Path Style="{DynamicResource Icon.Small}"
                                          Data="{DynamicResource Icon.ChevronRight}" />
                                </Button>
                                <Button Style="{DynamicResource Btn.Icon}"
                                        Command="{Binding NextPageCommand}"
                                        ToolTip="{loc:Loc Common.Next}">
                                    <Path Style="{DynamicResource Icon.Small}"
                                          Data="{DynamicResource Icon.ChevronLeft}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
                <Border Style="{DynamicResource Card}"
                        MinWidth="300"
                        Margin="{StaticResource S.3},0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,{StaticResource S.3}">
                            <Path Style="{DynamicResource Icon.Medium}"
                                  Data="{DynamicResource Icon.Stethoscope}"
                                   Stroke="{DynamicResource Brush.Primary}" />
                            <TextBlock Text="ویزیت جاری"
                                       Style="{DynamicResource Txt.Subtitle}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <Grid Margin="0,0,0,{StaticResource S.2}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="بیمار"
                                       Style="{DynamicResource Txt.Caption}"
                                       Margin="0,0,{StaticResource S.3},0" />
                            <TextBlock Grid.Column="1" Text="سارا احمدی"
                                       Style="{DynamicResource Txt.Body}"
                                       TextAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,{StaticResource S.2}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="سن"
                                       Style="{DynamicResource Txt.Caption}"
                                       Margin="0,0,{StaticResource S.3},0" />
                            <TextBlock Grid.Column="1" Text="۴۲ سال"
                                       Style="{DynamicResource Txt.Body}"
                                       TextAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,{StaticResource S.2}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="بیمه"
                                       Style="{DynamicResource Txt.Caption}"
                                       Margin="0,0,{StaticResource S.3},0" />
                            <TextBlock Grid.Column="1" Text="تأمین اجتماعی"
                                       Style="{DynamicResource Txt.Body}"
                                       TextAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,{StaticResource S.2}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="حساسیت"
                                       Style="{DynamicResource Txt.Caption}"
                                       Margin="0,0,{StaticResource S.3},0" />
                            <TextBlock Grid.Column="1" Text="پنی‌سیلین"
                                       Style="{DynamicResource Txt.Body}"
                                       TextAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,{StaticResource S.2}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="آخرین ویزیت"
                                       Style="{DynamicResource Txt.Caption}"
                                       Margin="0,0,{StaticResource S.3},0" />
                            <TextBlock Grid.Column="1" Text="۱۴۰۴/۰۵/۱۲"
                                       Style="{DynamicResource Txt.Body}"
                                       TextAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,{StaticResource S.2}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="تعداد ویزیت"
                                       Style="{DynamicResource Txt.Caption}"
                                       Margin="0,0,{StaticResource S.3},0" />
                            <TextBlock Grid.Column="1" Text="۱۸"
                                       Style="{DynamicResource Txt.Body}"
                                       TextAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,{StaticResource S.2}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="فشار خون"
                                       Style="{DynamicResource Txt.Caption}"
                                       Margin="0,0,{StaticResource S.3},0" />
                            <TextBlock Grid.Column="1" Text="۱۲۰/۸۰"
                                       Style="{DynamicResource Txt.Body}"
                                       TextAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,{StaticResource S.2}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="وزن"
                                       Style="{DynamicResource Txt.Caption}"
                                       Margin="0,0,{StaticResource S.3},0" />
                            <TextBlock Grid.Column="1" Text="۶۵ کیلوگرم"
                                       Style="{DynamicResource Txt.Body}"
                                       TextAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- ══════════════════════════════════════════════════════════
     ارتباطاتِ این صفحه با دیگر صفحات
     هر ردیف: «مبدأ» → «مقصد» با توضیحِ نوعِ پیوند
     این بلوک در همه‌ی صفحات حضور دارد تا مسیرِ حرکتِ کاربر گم نشود.
     ══════════════════════════════════════════════════════════ -->
            <Border Style="{DynamicResource Card.Flat}" Margin="0,{StaticResource S.3},0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,{StaticResource S.3}">
                        <Path Style="{DynamicResource Icon.Small}"
                              Data="{DynamicResource Icon.GitBranch}"
                               Stroke="{DynamicResource Brush.Primary}" />
                        <TextBlock Text="{loc:Loc Common.Relations}"
                                   Style="{DynamicResource Txt.Subtitle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource S.2},0,0,0" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Relations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,{StaticResource S.2}">
                                    <Border Style="{DynamicResource Badge.Neutral}">
                                        <TextBlock Text="{Binding From}"
                                                   Style="{DynamicResource Badge.Text}" />
                                    </Border>
                                        <Path Style="{DynamicResource Icon.XSmall}"
                                              Data="{DynamicResource Icon.ArrowLeft}"
                                               Stroke="{DynamicResource Brush.TextMuted}" />
                                    <Border Style="{DynamicResource Badge.Info}">
                                        <TextBlock Text="{Binding To}"
                                                   Style="{DynamicResource Badge.Text}" />
                                    </Border>
                                    <TextBlock Text="{Binding Why}"
                                               Style="{DynamicResource Txt.Caption}"
                                               VerticalAlignment="Center"
                                               Margin="{StaticResource S.2},0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>