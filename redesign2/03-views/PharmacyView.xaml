<!--
╔══════════════════════════════════════════════════════════════════════╗
║  داروخانه — PharmacyView
╠══════════════════════════════════════════════════════════════════════╣
║  گروه        : داروخانه
║  کهن‌الگو     : pos
║  ViewModel   : PharmacyViewModel
║  وایرفریم    : 01-wireframes-html/PharmacyView.html
╠══════════════════════════════════════════════════════════════════════╣
║  توضیح       : ستون چپ: کاتالوگِ داروها با جستجوی بارکد. ستون راست: 
║                سبدِ تحویل با جمع مبالغ؛ الگوی FEFO بچ نزدیک‌تر به 
║                انقضا را اول مصرف می‌کند.
╠══════════════════════════════════════════════════════════════════════╣
║  ساختار (اندازه‌ی هر فیلد/ستون بر پایه‌ی ۱۲ ستون است تا
║  «بزرگیِ عنصر متناسب با کارکردش» باشد — کد ملی ۳ ستون، نشانی ۱۲ ستون)
╠══════════════════════════════════════════════════════════════════════╣
║  نام              نوع              پهنا   الزامی
║  ─────────────────────────────────────────────────
║  ▸ ستون‌های جدول
║    Code            text             92px   Right
║    Name            text             *      Right
║    Generic         text             150px  Right
║    Batch           num              92px   Center
║    Stock           num              92px   Center
║    Price           money            104px  Left
║    Expiry          date             108px  Right
║    Status          chip             104px  Center
╠══════════════════════════════════════════════════════════════════════╣
║  ارتباطات این صفحه
║  ─────────────────────────────────────────────────
║    داروخانه  ──▶  فرم قلم دارویی
║         تعریف قلم
║    داروخانه  ──▶  ورود کالا
║         تأمین موجودی
║    داروخانه  ──▶  انبارگردانی
║         شمارش
║    داروخانه  ──▶  نسخه‌ها
║         تحویل بر اساس نسخه
╚══════════════════════════════════════════════════════════════════════╝

  قواعدِ رعایت‌شده در این فایل:
    • راست‌چین (RTL) و قلمِ وزیرمتن در سراسرِ صفحه
    • هیچ رنگِ ثابت (هگز) — همه از نشانه‌های معناییِ DynamicResource
    • الگوی MVVM: هیچ منطقی در code-behind، همه چیز از ViewModel
    • متن‌ها از فایلِ زبان (loc:Loc) برای پشتیبانیِ دو زبانهٔ آینده
    • تاریخ‌ها با تبدیل‌گرِ PersianDate به شمسی نمایش داده می‌شوند
    • نقشهٔ ارتباطات در پایینِ صفحه مسیرِ حرکت را نشان می‌دهد
-->

<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.PharmacyView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        xmlns:loc="clr-namespace:Sahand.ClinicPro.Desktop.Localization"
        xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DesignHeight="820" d:DesignWidth="1280"
        d:DataContext="{d:DesignInstance vm:PharmacyViewModel}"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource Brush.Canvas}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ سربرگِ یکپارچه‌ی صفحه ═══ -->
        <ctrl:PageHeader Grid.Row="0"
                        Title="داروخانه"
                        Subtitle="تحویل نسخه و فروشِ دارو با الگوی FEFO"
                        Icon="{DynamicResource Icon.Pill}"
                        Margin="{StaticResource P.Page}" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="{StaticResource P.Page}">
            <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
            <ItemsControl ItemsSource="{Binding Kpis}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ctrl:StatCard Margin="{StaticResource S.3}"
                                      Title="{Binding Title}"
                                      Value="{Binding Value}"
                                      Trend="{Binding Trend}"
                                      Icon="{Binding Icon}"
                                      Accent="{Binding Accent}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{DynamicResource Card.Flat}"
                    Padding="{StaticResource S.3}"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- جستجو -->
                    <StackPanel Margin="0,0,{StaticResource S.3},0">
                        <TextBlock Text="جستجو"
                                   Style="{DynamicResource Input.Label}" />
                        <ctrl:SearchBox Width="260"
                                        Text="{Binding SearchText, Mode=TwoWay}"
                                        Placeholder="نام دارو یا بارکد…" />
                    </StackPanel>
                    <!-- گروه دارویی -->
                    <StackPanel Margin="0,0,{StaticResource S.3},0">
                        <TextBlock Text="گروه دارویی"
                                   Style="{DynamicResource Input.Label}" />
                        <ComboBox Width="160"
                                  Style="{DynamicResource Input.ComboBox}"
                                  SelectedItem="{Binding Filter2, Mode=TwoWay}">
                            <ComboBoxItem Content="همه" IsSelected="True" />
                        </ComboBox>
                    </StackPanel>
                    <!-- فقط موجود -->
                    <StackPanel Margin="0,0,{StaticResource S.3},0">
                        <TextBlock Text="فقط موجود"
                                   Style="{DynamicResource Input.Label}" />
                        <CheckBox Style="{DynamicResource Input.CheckBox}"
                                  IsChecked="{Binding Filter3, Mode=TwoWay}" />
                    </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Left">
                    <Button Style="{DynamicResource Btn.Primary}"
                            Command="{Binding DispenseCommand}"
                            Margin="0,0,{StaticResource S.2},0"
                            MinHeight="{StaticResource Size.ButtonHeight}"
                            Padding="{StaticResource P.Button}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{DynamicResource Icon.Small}"
                                  Data="{DynamicResource Icon.PackageCheck}"
                                  Margin="0,0,{StaticResource S.2},0" />
                            <TextBlock Text="تحویل نسخه" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource Btn.Secondary}"
                            Command="{Binding StockInCommand}"
                            Margin="0,0,{StaticResource S.2},0"
                            MinHeight="{StaticResource Size.ButtonHeight}"
                            Padding="{StaticResource P.Button}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{DynamicResource Icon.Small}"
                                  Data="{DynamicResource Icon.PackagePlus}"
                                  Margin="0,0,{StaticResource S.2},0" />
                            <TextBlock Text="ورود کالا" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource Btn.Secondary}"
                            Command="{Binding StocktakeCommand}"
                            Margin="0,0,{StaticResource S.2},0"
                            MinHeight="{StaticResource Size.ButtonHeight}"
                            Padding="{StaticResource P.Button}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{DynamicResource Icon.Small}"
                                  Data="{DynamicResource Icon.ClipboardCheck}"
                                  Margin="0,0,{StaticResource S.2},0" />
                            <TextBlock Text="انبارگردانی" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    </StackPanel>
                </Grid>
            </Border>

                    <DataGrid Style="{DynamicResource Grid.Modern}"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              RowHeight="{StaticResource Size.RowHeight}"
                              FlowDirection="RightToLeft">
                        <DataGrid.Columns>
                            <!-- کد — نوع: text -->
                            <DataGridTextColumn Header="کد"
                                                Binding="{Binding Code}"
                                                Width="92"
                                                ElementStyle="{DynamicResource Txt.Body}" />
                            <!-- نام دارو — نوع: text -->
                            <DataGridTextColumn Header="نام دارو"
                                                Binding="{Binding Name}"
                                                Width="*"
                                                ElementStyle="{DynamicResource Txt.Body}" />
                            <!-- نام ژنریک — نوع: text -->
                            <DataGridTextColumn Header="نام ژنریک"
                                                Binding="{Binding Generic}"
                                                Width="150"
                                                ElementStyle="{DynamicResource Txt.Body}" />
                            <!-- بچ — نوع: num -->
                            <DataGridTextColumn Header="بچ"
                                                Binding="{Binding Batch}"
                                                Width="92"
                                                ElementStyle="{DynamicResource Txt.Body}" />
                            <!-- موجودی — نوع: num -->
                            <DataGridTextColumn Header="موجودی"
                                                Binding="{Binding Stock}"
                                                Width="92"
                                                ElementStyle="{DynamicResource Txt.Body}" />
                            <!-- قیمت — نوع: money -->
                            <DataGridTextColumn Header="قیمت" Width="104" Binding="{Binding Price}"
                                                ElementStyle="{DynamicResource Txt.Numeric}">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource Grid.Header}">
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <!-- انقضا — نوع: date -->
                            <DataGridTextColumn Header="انقضا" Width="108" Binding="{Binding Expiry, Converter={StaticResource PersianDate}}" />
                            <!-- وضعیت — نوع: chip -->
                            <DataGridTemplateColumn Header="وضعیت" Width="104">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource Badge}"
                                                HorizontalAlignment="Center"
                                                Background="{Binding StatusTone, Converter={StaticResource StatusTone}}">
                                            <TextBlock Text="{Binding Status}"
                                                       Style="{DynamicResource Badge.Text}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ctrl:EmptyState Icon="{DynamicResource Icon.Pill}"
                                      Title="{loc:Loc Common.EmptyTitle}"
                                      Message="{loc:Loc Common.EmptyMessage}"
                                      Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    <Border Style="{DynamicResource Card.Flat}"
                            Padding="{StaticResource S.3}"
                            Margin="0,{StaticResource S.3},0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding PageSummary}"
                                       Style="{DynamicResource Txt.Caption}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{DynamicResource Btn.Icon}"
                                        Command="{Binding PreviousPageCommand}"
                                        ToolTip="{loc:Loc Common.Previous}">
                                    <Path Style="{DynamicResource Icon.Small}"
                                          Data="{DynamicResource Icon.ChevronRight}" />
                                </Button>
                                <Button Style="{DynamicResource Btn.Icon}"
                                        Command="{Binding NextPageCommand}"
                                        ToolTip="{loc:Loc Common.Next}">
                                    <Path Style="{DynamicResource Icon.Small}"
                                          Data="{DynamicResource Icon.ChevronLeft}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
                <!-- سبدِ فروش -->
                <Border Grid.Column="1" Style="{DynamicResource Card}"
                        Margin="{StaticResource S.3},0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,12">
                            <Path Style="{DynamicResource Icon.Medium}"
                                  Data="{DynamicResource Icon.ShoppingCart}"
                                   Stroke="{DynamicResource Brush.Primary}" />
                            <TextBlock Text="سبد فروش"
                                       Style="{DynamicResource Txt.Subtitle}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding CartItems}" />
                        <Separator Style="{DynamicResource Separator.H}" />
                        <TextBlock Text="{Binding CartTotal}"
                                   Style="{DynamicResource Txt.Title}" />
                    </StackPanel>
                </Border>
            </Grid>
            <!-- ══════════════════════════════════════════════════════════
     ارتباطاتِ این صفحه با دیگر صفحات
     هر ردیف: «مبدأ» → «مقصد» با توضیحِ نوعِ پیوند
     این بلوک در همه‌ی صفحات حضور دارد تا مسیرِ حرکتِ کاربر گم نشود.
     ══════════════════════════════════════════════════════════ -->
            <Border Style="{DynamicResource Card.Flat}" Margin="0,{StaticResource S.3},0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,{StaticResource S.3}">
                        <Path Style="{DynamicResource Icon.Small}"
                              Data="{DynamicResource Icon.GitBranch}"
                               Stroke="{DynamicResource Brush.Primary}" />
                        <TextBlock Text="{loc:Loc Common.Relations}"
                                   Style="{DynamicResource Txt.Subtitle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource S.2},0,0,0" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Relations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,{StaticResource S.2}">
                                    <Border Style="{DynamicResource Badge.Neutral}">
                                        <TextBlock Text="{Binding From}"
                                                   Style="{DynamicResource Badge.Text}" />
                                    </Border>
                                        <Path Style="{DynamicResource Icon.XSmall}"
                                              Data="{DynamicResource Icon.ArrowLeft}"
                                               Stroke="{DynamicResource Brush.TextMuted}" />
                                    <Border Style="{DynamicResource Badge.Info}">
                                        <TextBlock Text="{Binding To}"
                                                   Style="{DynamicResource Badge.Text}" />
                                    </Border>
                                    <TextBlock Text="{Binding Why}"
                                               Style="{DynamicResource Txt.Caption}"
                                               VerticalAlignment="Center"
                                               Margin="{StaticResource S.2},0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>