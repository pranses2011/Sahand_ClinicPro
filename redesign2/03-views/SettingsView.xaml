<!--
╔══════════════════════════════════════════════════════════════════════╗
║  تنظیمات — SettingsView
╠══════════════════════════════════════════════════════════════════════╣
║  گروه        : پیشخوان
║  کهن‌الگو     : settings
║  ViewModel   : SettingsViewModel
║  وایرفریم    : 01-wireframes-html/SettingsView.html
╠══════════════════════════════════════════════════════════════════════╣
║  ساختار (اندازه‌ی هر فیلد/ستون بر پایه‌ی ۱۲ ستون است تا
║  «بزرگیِ عنصر متناسب با کارکردش» باشد — کد ملی ۳ ستون، نشانی ۱۲ ستون)
╠══════════════════════════════════════════════════════════════════════╣
║  نام              نوع              پهنا   الزامی
║  ─────────────────────────────────────────────────
║  ▸ عمومی
║    ClinicName      TextBox          8      بله
║    ClinicPhone     TextBox          4      خیر
║    Address         TextBox (چندخطی  12     خیر
║    AutoBackup      CheckBox         6      خیر
║    DarkTheme       CheckBox         6      خیر
║  ▸ مالی
║    Currency        ComboBox         4      بله
║    TaxPercent      TextBox (عددی)   4      خیر
║    DefaultInsuranc ComboBox         4      خیر
╠══════════════════════════════════════════════════════════════════════╣
║  ارتباطات این صفحه
║  ─────────────────────────────────────────────────
║    تنظیمات  ──▶  پشتیبان‌گیری
║         تنظیمات بکاپ در این‌جا
║    تنظیمات  ──▶  شعب
║         نام شعبهٔ اصلی
╚══════════════════════════════════════════════════════════════════════╝

  قواعدِ رعایت‌شده در این فایل:
    • راست‌چین (RTL) و قلمِ وزیرمتن در سراسرِ صفحه
    • هیچ رنگِ ثابت (هگز) — همه از نشانه‌های معناییِ DynamicResource
    • الگوی MVVM: هیچ منطقی در code-behind، همه چیز از ViewModel
    • متن‌ها از فایلِ زبان (loc:Loc) برای پشتیبانیِ دو زبانهٔ آینده
    • تاریخ‌ها با تبدیل‌گرِ PersianDate به شمسی نمایش داده می‌شوند
    • نقشهٔ ارتباطات در پایینِ صفحه مسیرِ حرکت را نشان می‌دهد
-->

<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        xmlns:loc="clr-namespace:Sahand.ClinicPro.Desktop.Localization"
        xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DesignHeight="820" d:DesignWidth="1280"
        d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource Brush.Canvas}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ سربرگِ یکپارچه‌ی صفحه ═══ -->
        <ctrl:PageHeader Grid.Row="0"
                        Title="تنظیمات"
                        Subtitle="تنظیمات سراسری برنامه"
                        Icon="{DynamicResource Icon.Settings}"
                        Margin="{StaticResource P.Page}" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="{StaticResource P.Page}">
            <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- فهرستِ بخش‌های تنظیمات -->
                <ListBox Grid.Column="0"
                         ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                         Margin="0,0,12,0" />
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- ── بخش: عمومی ── -->
                        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="12"
                                Margin="0,{StaticResource S.2},0,{StaticResource S.3}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Small}"
                                      Data="{DynamicResource Icon.SlidersHorizontal}"
                                       Stroke="{DynamicResource Brush.Primary}" />
                                <TextBlock Text="عمومی"
                                           Style="{DynamicResource Txt.Title}"
                                           VerticalAlignment="Center"
                                           Margin="{StaticResource S.2},0,0,0" />
                            </StackPanel>
                        </Border>
                        <!-- نام درمانگاه — TextBox · پهنای 8/۱۲ -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="8"
                                    Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                            <TextBlock Text="نام درمانگاه"
                                       Style="{DynamicResource Input.LabelRequired}" />
                            <TextBox Style="{DynamicResource Input.TextBox}"
                                     Text="{Binding ClinicName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="درمانگاه تخصصی سهند"
                                     />
                            <!-- خطاهای اعتبارسنجی به‌صورت خودکار از INotifyDataErrorInfo نمایش داده می‌شوند -->
                        </StackPanel>
                        <!-- تلفن — TextBox · پهنای 4/۱۲ -->
                        <StackPanel Grid.Row="1" Grid.Column="8" Grid.ColumnSpan="4"
                                    Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                            <TextBlock Text="تلفن"
                                       Style="{DynamicResource Input.Label}" />
                            <TextBox Style="{DynamicResource Input.TextBox}"
                                     Text="{Binding ClinicPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="11"
                                     TextAlignment="Left"
                                     FlowDirection="LeftToRight" />
                        </StackPanel>
                        <!-- نشانی — TextBox (چندخطی) · پهنای 12/۱۲ -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="12"
                                    Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                            <TextBlock Text="نشانی"
                                       Style="{DynamicResource Input.Label}" />
                            <TextBox Style="{DynamicResource Input.TextBox}"
                                     Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="88"
                                     VerticalContentAlignment="Top"
                                     Tag="تبریز، خیابان ولیعصر، پلاک ۱۲۰"
                                     />
                        </StackPanel>
                        <!-- پشتیبان‌گیری خودکار هر شب — CheckBox · پهنای 6/۱۲ -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="6"
                                    Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                            <CheckBox Style="{DynamicResource Input.CheckBox}"
                                      Content="پشتیبان‌گیری خودکار هر شب"
                                      IsChecked="{Binding AutoBackup, Mode=TwoWay}" />
                        </StackPanel>
                        <!-- تم تاریک — CheckBox · پهنای 6/۱۲ -->
                        <StackPanel Grid.Row="3" Grid.Column="6" Grid.ColumnSpan="6"
                                    Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                            <CheckBox Style="{DynamicResource Input.CheckBox}"
                                      Content="تم تاریک"
                                      IsChecked="{Binding DarkTheme, Mode=TwoWay}" />
                        </StackPanel>
                        <!-- ── بخش: مالی ── -->
                        <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="12"
                                Margin="0,{StaticResource S.2},0,{StaticResource S.3}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Small}"
                                      Data="{DynamicResource Icon.Wallet}"
                                       Stroke="{DynamicResource Brush.Primary}" />
                                <TextBlock Text="مالی"
                                           Style="{DynamicResource Txt.Title}"
                                           VerticalAlignment="Center"
                                           Margin="{StaticResource S.2},0,0,0" />
                            </StackPanel>
                        </Border>
                        <!-- واحد پول — ComboBox · پهنای 4/۱۲ -->
                        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4"
                                    Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                            <TextBlock Text="واحد پول"
                                       Style="{DynamicResource Input.LabelRequired}" />
                            <ComboBox Style="{DynamicResource Input.ComboBox}"
                                      SelectedItem="{Binding Currency, Mode=TwoWay}">
                                <ComboBoxItem Content="تومان" IsSelected="True" />
                                <ComboBoxItem Content="ریال" />
                            </ComboBox>
                            <!-- خطاهای اعتبارسنجی به‌صورت خودکار از INotifyDataErrorInfo نمایش داده می‌شوند -->
                        </StackPanel>
                        <!-- درصد مالیات — TextBox (عددی) · پهنای 4/۱۲ -->
                        <StackPanel Grid.Row="5" Grid.Column="4" Grid.ColumnSpan="4"
                                    Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                            <TextBlock Text="درصد مالیات"
                                       Style="{DynamicResource Input.Label}" />
                            <TextBox Style="{DynamicResource Input.TextBox}"
                                     Text="{Binding TaxPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="12"
                                     TextAlignment="Left"
                                     FlowDirection="LeftToRight" />
                        </StackPanel>
                        <!-- بیمه پیش‌فرض — ComboBox · پهنای 4/۱۲ -->
                        <StackPanel Grid.Row="5" Grid.Column="8" Grid.ColumnSpan="4"
                                    Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                            <TextBlock Text="بیمه پیش‌فرض"
                                       Style="{DynamicResource Input.Label}" />
                            <ComboBox Style="{DynamicResource Input.ComboBox}"
                                      SelectedItem="{Binding DefaultInsurance, Mode=TwoWay}">
                                <ComboBoxItem Content="آزاد" IsSelected="True" />
                                <ComboBoxItem Content="تأمین اجتماعی" />
                                <ComboBoxItem Content="سلامت" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
     ارتباطاتِ این صفحه با دیگر صفحات
     هر ردیف: «مبدأ» → «مقصد» با توضیحِ نوعِ پیوند
     این بلوک در همه‌ی صفحات حضور دارد تا مسیرِ حرکتِ کاربر گم نشود.
     ══════════════════════════════════════════════════════════ -->
            <Border Style="{DynamicResource Card.Flat}" Margin="0,{StaticResource S.3},0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,{StaticResource S.3}">
                        <Path Style="{DynamicResource Icon.Small}"
                              Data="{DynamicResource Icon.GitBranch}"
                               Stroke="{DynamicResource Brush.Primary}" />
                        <TextBlock Text="{loc:Loc Common.Relations}"
                                   Style="{DynamicResource Txt.Subtitle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource S.2},0,0,0" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Relations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,{StaticResource S.2}">
                                    <Border Style="{DynamicResource Badge.Neutral}">
                                        <TextBlock Text="{Binding From}"
                                                   Style="{DynamicResource Badge.Text}" />
                                    </Border>
                                        <Path Style="{DynamicResource Icon.XSmall}"
                                              Data="{DynamicResource Icon.ArrowLeft}"
                                               Stroke="{DynamicResource Brush.TextMuted}" />
                                    <Border Style="{DynamicResource Badge.Info}">
                                        <TextBlock Text="{Binding To}"
                                                   Style="{DynamicResource Badge.Text}" />
                                    </Border>
                                    <TextBlock Text="{Binding Why}"
                                               Style="{DynamicResource Txt.Caption}"
                                               VerticalAlignment="Center"
                                               Margin="{StaticResource S.2},0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>