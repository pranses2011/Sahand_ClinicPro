<!--
╔══════════════════════════════════════════════════════════════════════╗
║  فرم قلم دارویی — PharmacyItemFormWindow
╠══════════════════════════════════════════════════════════════════════╣
║  گروه        : داروخانه
║  کهن‌الگو     : form-std
║  ViewModel   : PharmacyItemFormViewModel
║  وایرفریم    : 01-wireframes-html/PharmacyItemFormWindow.html
╠══════════════════════════════════════════════════════════════════════╣
║  ساختار (اندازه‌ی هر فیلد/ستون بر پایه‌ی ۱۲ ستون است تا
║  «بزرگیِ عنصر متناسب با کارکردش» باشد — کد ملی ۳ ستون، نشانی ۱۲ ستون)
╠══════════════════════════════════════════════════════════════════════╣
║  نام              نوع              پهنا   الزامی
║  ─────────────────────────────────────────────────
║  ▸ شناسه قلم
║    Code            TextBox          3      بله
║    Name            TextBox          5      بله
║    GenericName     TextBox          4      بله
║    Kind            ComboBox         3      بله
║    Category        ComboBox         3      خیر
║    Form            ComboBox         3      خیر
║    Unit            ComboBox         3      خیر
║  ▸ موجودی و قیمت
║    MinStock        TextBox (عددی)   3      خیر
║    SalePrice       TextBox          3      خیر
║    PurchasePrice   TextBox          3      خیر
║    TaxRate         TextBox (عددی)   3      خیر
║    Barcode         TextBox + بارکد  6      خیر
║    IrcCode         TextBox          6      خیر
║    RequiresPrescri CheckBox         6      خیر
║    IsNarcotic      CheckBox         6      خیر
╠══════════════════════════════════════════════════════════════════════╣
║  ارتباطات این صفحه
║  ─────────────────────────────────────────────────
║    فرم قلم دارویی  ──▶  ورود کالا
║         بچ برای این قلم
╚══════════════════════════════════════════════════════════════════════╝

  قواعدِ رعایت‌شده در این فایل:
    • راست‌چین (RTL) و قلمِ وزیرمتن در سراسرِ صفحه
    • هیچ رنگِ ثابت (هگز) — همه از نشانه‌های معناییِ DynamicResource
    • الگوی MVVM: هیچ منطقی در code-behind، همه چیز از ViewModel
    • متن‌ها از فایلِ زبان (loc:Loc) برای پشتیبانیِ دو زبانهٔ آینده
    • تاریخ‌ها با تبدیل‌گرِ PersianDate به شمسی نمایش داده می‌شوند
    • نقشهٔ ارتباطات در پایینِ صفحه مسیرِ حرکت را نشان می‌دهد
-->

<Window x:Class="Sahand.ClinicPro.Desktop.Views.PharmacyItemFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        xmlns:loc="clr-namespace:Sahand.ClinicPro.Desktop.Localization"
        xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="فرم قلم دارویی"
        Style="{DynamicResource Window.Modern}"
        WindowStartupLocation="CenterScreen"
        Height="820" Width="960"
        d:DataContext="{d:DesignInstance vm:PharmacyItemFormViewModel}"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource Brush.Canvas}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ سربرگِ یکپارچه‌ی صفحه ═══ -->
        <ctrl:PageHeader Grid.Row="0"
                        Title="فرم قلم دارویی"
                        Subtitle="تعریف یا ویرایش قلم دارویی"
                        Icon="{DynamicResource Icon.PackagePlus}"
                        Margin="{StaticResource P.Page}" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="{StaticResource P.Page}">
            <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- ── بخش: شناسه قلم ── -->
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="12"
                        Margin="0,{StaticResource S.2},0,{StaticResource S.3}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{DynamicResource Icon.Small}"
                              Data="{DynamicResource Icon.Package}"
                               Stroke="{DynamicResource Brush.Primary}" />
                        <TextBlock Text="شناسه قلم"
                                   Style="{DynamicResource Txt.Title}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource S.2},0,0,0" />
                    </StackPanel>
                </Border>
                <!-- کد قلم — TextBox · پهنای 3/۱۲ -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="کد قلم"
                               Style="{DynamicResource Input.LabelRequired}" />
                    <TextBox Style="{DynamicResource Input.TextBox}"
                             Text="{Binding Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Tag="D-۱۰۰۵"
                             />
                    <!-- خطاهای اعتبارسنجی به‌صورت خودکار از INotifyDataErrorInfo نمایش داده می‌شوند -->
                </StackPanel>
                <!-- نام تجاری — TextBox · پهنای 5/۱۲ -->
                <StackPanel Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="5"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="نام تجاری"
                               Style="{DynamicResource Input.LabelRequired}" />
                    <TextBox Style="{DynamicResource Input.TextBox}"
                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Tag="سفکسیم ۴۰۰ کپسول"
                             />
                    <!-- خطاهای اعتبارسنجی به‌صورت خودکار از INotifyDataErrorInfo نمایش داده می‌شوند -->
                </StackPanel>
                <!-- نام ژنریک — TextBox · پهنای 4/۱۲ -->
                <StackPanel Grid.Row="1" Grid.Column="8" Grid.ColumnSpan="4"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="نام ژنریک"
                               Style="{DynamicResource Input.LabelRequired}" />
                    <TextBox Style="{DynamicResource Input.TextBox}"
                             Text="{Binding GenericName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Cefixime"
                             />
                    <!-- خطاهای اعتبارسنجی به‌صورت خودکار از INotifyDataErrorInfo نمایش داده می‌شوند -->
                </StackPanel>
                <!-- نوع قلم — ComboBox · پهنای 3/۱۲ -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="نوع قلم"
                               Style="{DynamicResource Input.LabelRequired}" />
                    <ComboBox Style="{DynamicResource Input.ComboBox}"
                              SelectedItem="{Binding Kind, Mode=TwoWay}">
                        <ComboBoxItem Content="دارو" IsSelected="True" />
                        <ComboBoxItem Content="لوازم مصرفی" />
                    </ComboBox>
                    <!-- خطاهای اعتبارسنجی به‌صورت خودکار از INotifyDataErrorInfo نمایش داده می‌شوند -->
                </StackPanel>
                <!-- گروه دارویی — ComboBox · پهنای 3/۱۲ -->
                <StackPanel Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="3"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="گروه دارویی"
                               Style="{DynamicResource Input.Label}" />
                    <ComboBox Style="{DynamicResource Input.ComboBox}"
                              SelectedItem="{Binding Category, Mode=TwoWay}">
                    </ComboBox>
                </StackPanel>
                <!-- شکل دارویی — ComboBox · پهنای 3/۱۲ -->
                <StackPanel Grid.Row="2" Grid.Column="6" Grid.ColumnSpan="3"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="شکل دارویی"
                               Style="{DynamicResource Input.Label}" />
                    <ComboBox Style="{DynamicResource Input.ComboBox}"
                              SelectedItem="{Binding Form, Mode=TwoWay}">
                        <ComboBoxItem Content="قرص" />
                        <ComboBoxItem Content="کپسول" IsSelected="True" />
                        <ComboBoxItem Content="شربت" />
                        <ComboBoxItem Content="آمپول" />
                        <ComboBoxItem Content="قطره" />
                        <ComboBoxItem Content="پماد" />
                    </ComboBox>
                </StackPanel>
                <!-- واحد — ComboBox · پهنای 3/۱۲ -->
                <StackPanel Grid.Row="2" Grid.Column="9" Grid.ColumnSpan="3"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="واحد"
                               Style="{DynamicResource Input.Label}" />
                    <ComboBox Style="{DynamicResource Input.ComboBox}"
                              SelectedItem="{Binding Unit, Mode=TwoWay}">
                        <ComboBoxItem Content="عدد" IsSelected="True" />
                        <ComboBoxItem Content="بسته" />
                        <ComboBoxItem Content="بطری" />
                        <ComboBoxItem Content="جعبه" />
                    </ComboBox>
                </StackPanel>
                <!-- ── بخش: موجودی و قیمت ── -->
                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="12"
                        Margin="0,{StaticResource S.2},0,{StaticResource S.3}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{DynamicResource Icon.Small}"
                              Data="{DynamicResource Icon.Coins}"
                               Stroke="{DynamicResource Brush.Primary}" />
                        <TextBlock Text="موجودی و قیمت"
                                   Style="{DynamicResource Txt.Title}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource S.2},0,0,0" />
                    </StackPanel>
                </Border>
                <!-- حد سفارش — TextBox (عددی) · پهنای 3/۱۲ -->
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="حد سفارش"
                               Style="{DynamicResource Input.Label}" />
                    <TextBox Style="{DynamicResource Input.TextBox}"
                             Text="{Binding MinStock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="12"
                             TextAlignment="Left"
                             FlowDirection="LeftToRight" />
                </StackPanel>
                <!-- قیمت فروش — TextBox · پهنای 3/۱۲ -->
                <StackPanel Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="3"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="قیمت فروش"
                               Style="{DynamicResource Input.Label}" />
                    <TextBox Style="{DynamicResource Input.TextBox}"
                             Text="{Binding SalePrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Left"
                             FlowDirection="LeftToRight" />
                </StackPanel>
                <!-- قیمت خرید — TextBox · پهنای 3/۱۲ -->
                <StackPanel Grid.Row="4" Grid.Column="6" Grid.ColumnSpan="3"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="قیمت خرید"
                               Style="{DynamicResource Input.Label}" />
                    <TextBox Style="{DynamicResource Input.TextBox}"
                             Text="{Binding PurchasePrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Left"
                             FlowDirection="LeftToRight" />
                </StackPanel>
                <!-- درصد مالیات — TextBox (عددی) · پهنای 3/۱۲ -->
                <StackPanel Grid.Row="4" Grid.Column="9" Grid.ColumnSpan="3"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="درصد مالیات"
                               Style="{DynamicResource Input.Label}" />
                    <TextBox Style="{DynamicResource Input.TextBox}"
                             Text="{Binding TaxRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="12"
                             TextAlignment="Left"
                             FlowDirection="LeftToRight" />
                </StackPanel>
                <!-- بارکد — TextBox + بارکدخوان · پهنای 6/۱۲ -->
                <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="6"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="بارکد"
                               Style="{DynamicResource Input.Label}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{DynamicResource Input.TextBox}"
                                 Text="{Binding Barcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FlowDirection="LeftToRight"
                                 TextAlignment="Left" />
                        <Button Grid.Column="1"
                                Style="{DynamicResource Btn.Icon}"
                                Command="{Binding ScanBarcodeCommand}"
                                Margin="{StaticResource S.2},0,0,0"
                                ToolTip="بارکدخوان">
                            <Path Style="{DynamicResource Icon.Small}"
                                  Data="{DynamicResource Icon.Barcode}" />
                        </Button>
                    </Grid>
                </StackPanel>
                <!-- کد IRC — TextBox · پهنای 6/۱۲ -->
                <StackPanel Grid.Row="5" Grid.Column="6" Grid.ColumnSpan="6"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="کد IRC"
                               Style="{DynamicResource Input.Label}" />
                    <TextBox Style="{DynamicResource Input.TextBox}"
                             Text="{Binding IrcCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Tag="۱۲۳۴۵۶۷۸۹۰"
                             />
                </StackPanel>
                <!-- نیازمند نسخه — CheckBox · پهنای 6/۱۲ -->
                <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="6"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <CheckBox Style="{DynamicResource Input.CheckBox}"
                              Content="نیازمند نسخه"
                              IsChecked="{Binding RequiresPrescription, Mode=TwoWay}" />
                </StackPanel>
                <!-- داروی مخدر — CheckBox · پهنای 6/۱۲ -->
                <StackPanel Grid.Row="6" Grid.Column="6" Grid.ColumnSpan="6"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <CheckBox Style="{DynamicResource Input.CheckBox}"
                              Content="داروی مخدر"
                              IsChecked="{Binding IsNarcotic, Mode=TwoWay}" />
                </StackPanel>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
     ارتباطاتِ این صفحه با دیگر صفحات
     هر ردیف: «مبدأ» → «مقصد» با توضیحِ نوعِ پیوند
     این بلوک در همه‌ی صفحات حضور دارد تا مسیرِ حرکتِ کاربر گم نشود.
     ══════════════════════════════════════════════════════════ -->
            <Border Style="{DynamicResource Card.Flat}" Margin="0,{StaticResource S.3},0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,{StaticResource S.3}">
                        <Path Style="{DynamicResource Icon.Small}"
                              Data="{DynamicResource Icon.GitBranch}"
                               Stroke="{DynamicResource Brush.Primary}" />
                        <TextBlock Text="{loc:Loc Common.Relations}"
                                   Style="{DynamicResource Txt.Subtitle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource S.2},0,0,0" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Relations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,{StaticResource S.2}">
                                    <Border Style="{DynamicResource Badge.Neutral}">
                                        <TextBlock Text="{Binding From}"
                                                   Style="{DynamicResource Badge.Text}" />
                                    </Border>
                                        <Path Style="{DynamicResource Icon.XSmall}"
                                              Data="{DynamicResource Icon.ArrowLeft}"
                                               Stroke="{DynamicResource Brush.TextMuted}" />
                                    <Border Style="{DynamicResource Badge.Info}">
                                        <TextBlock Text="{Binding To}"
                                                   Style="{DynamicResource Badge.Text}" />
                                    </Border>
                                    <TextBlock Text="{Binding Why}"
                                               Style="{DynamicResource Txt.Caption}"
                                               VerticalAlignment="Center"
                                               Margin="{StaticResource S.2},0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ نوارِ اقدام‌های ثابت ═══ -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="{StaticResource S.4}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left">
                <Button Style="{DynamicResource Btn.Primary}"
                        Command="{Binding SaveCommand}"
                        Margin="0,0,{StaticResource S.2},0"
                        MinHeight="{StaticResource Size.ButtonHeight}"
                        Padding="{StaticResource P.Button}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{DynamicResource Icon.Small}"
                              Data="{DynamicResource Icon.Save}"
                              Margin="0,0,{StaticResource S.2},0" />
                        <TextBlock Text="ذخیره" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource Btn.Ghost}"
                        Command="{Binding CancelCommand}"
                        Margin="0,0,{StaticResource S.2},0"
                        MinHeight="{StaticResource Size.ButtonHeight}"
                        Padding="{StaticResource P.Button}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="انصراف" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>

</Window>