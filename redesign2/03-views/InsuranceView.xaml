<!--
╔══════════════════════════════════════════════════════════════════════╗
║  بیمه و مطالبات — InsuranceView
╠══════════════════════════════════════════════════════════════════════╣
║  گروه        : مالی
║  کهن‌الگو     : detail-tabs
║  ViewModel   : InsuranceViewModel
║  وایرفریم    : 01-wireframes-html/InsuranceView.html
╠══════════════════════════════════════════════════════════════════════╣
║  ساختار (اندازه‌ی هر فیلد/ستون بر پایه‌ی ۱۲ ستون است تا
║  «بزرگیِ عنصر متناسب با کارکردش» باشد — کد ملی ۳ ستون، نشانی ۱۲ ستون)
╠══════════════════════════════════════════════════════════════════════╣
║  نام              نوع              پهنا   الزامی
║  ─────────────────────────────────────────────────
║  ▸ ستون‌های جدول
║    Period          text             112px  Right
║    Company         text             *      Right
║    Claims          num              84px   Center
║    Amount          money            124px  Left
║    Approved        money            124px  Left
║    Status          chip             120px  Center
╠══════════════════════════════════════════════════════════════════════╣
║  ارتباطات این صفحه
║  ─────────────────────────────────────────────────
║    بیمه و مطالبات  ──▶  صورتحساب
║         فاکتورهای دوره
║    بیمه و مطالبات  ──▶  فرم شرکت بیمه
║         شرکت‌های طرف قرارداد
╚══════════════════════════════════════════════════════════════════════╝

  قواعدِ رعایت‌شده در این فایل:
    • راست‌چین (RTL) و قلمِ وزیرمتن در سراسرِ صفحه
    • هیچ رنگِ ثابت (هگز) — همه از نشانه‌های معناییِ DynamicResource
    • الگوی MVVM: هیچ منطقی در code-behind، همه چیز از ViewModel
    • متن‌ها از فایلِ زبان (loc:Loc) برای پشتیبانیِ دو زبانهٔ آینده
    • تاریخ‌ها با تبدیل‌گرِ PersianDate به شمسی نمایش داده می‌شوند
    • نقشهٔ ارتباطات در پایینِ صفحه مسیرِ حرکت را نشان می‌دهد
-->

<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.InsuranceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        xmlns:loc="clr-namespace:Sahand.ClinicPro.Desktop.Localization"
        xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DesignHeight="820" d:DesignWidth="1280"
        d:DataContext="{d:DesignInstance vm:InsuranceViewModel}"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource Brush.Canvas}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ سربرگِ یکپارچه‌ی صفحه ═══ -->
        <ctrl:PageHeader Grid.Row="0"
                        Title="بیمه و مطالبات"
                        Subtitle="پیگیری مطالبات از شرکت‌های بیمه"
                        Icon="{DynamicResource Icon.ShieldCheck}"
                        Margin="{StaticResource P.Page}" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="{StaticResource P.Page}">
            <StackPanel>
                <ctrl:StatCard Margin="{StaticResource S.3}"
                                  Title="مطالبات جاری"
                                  Value="۸۴,۵۰۰,۰۰۰"
                                  Trend="7"
                                  Icon="{DynamicResource Icon.ShieldCheck}"
                                  Accent="{DynamicResource Brush.Info}"
                                  />
                <ctrl:StatCard Margin="{StaticResource S.3}"
                                  Title="در انتظار تأیید"
                                  Value="۲۳,۱۰۰,۰۰۰"
                                  Icon="{DynamicResource Icon.Clock}"
                                  Accent="{DynamicResource Brush.Warning}"
                                  />
                <ctrl:StatCard Margin="{StaticResource S.3}"
                                  Title="وصول شده"
                                  Value="۶۱,۴۰۰,۰۰۰"
                                  Trend="12"
                                  Icon="{DynamicResource Icon.CircleCheck}"
                                  Accent="{DynamicResource Brush.Success}"
                                  />
                <ctrl:StatCard Margin="{StaticResource S.3}"
                                  Title="برگشتی"
                                  Value="۳,۲۰۰,۰۰۰"
                                  Trend="-2"
                                  Icon="{DynamicResource Icon.CircleX}"
                                  Accent="{DynamicResource Brush.Danger}"
                                  />

                    <TabControl Style="{DynamicResource Tab.Modern}">
                        <TabItem Style="{DynamicResource Tab.Item}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{DynamicResource Icon.Small}"
                                          Data="{DynamicResource Icon.CalendarRange}" />
                                    <TextBlock Text="دوره‌ها"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                    <Border Style="{DynamicResource Badge.Neutral}"
                                            Margin="6,0,0,0">
                                        <TextBlock Text="6"
                                                   Style="{DynamicResource Badge.Text}" />
                                    </Border>
                                </StackPanel>
                            </TabItem.Header>
                            <!-- محتوای تب «دوره‌ها» در ViewModel تأمین می‌شود -->
                            <ContentControl Content="{Binding TabContents[0]}" />
                        </TabItem>
                        <TabItem Style="{DynamicResource Tab.Item}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{DynamicResource Icon.Small}"
                                          Data="{DynamicResource Icon.Receipt}" />
                                    <TextBlock Text="صورت‌حساب‌ها"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                    <Border Style="{DynamicResource Badge.Neutral}"
                                            Margin="6,0,0,0">
                                        <TextBlock Text="128"
                                                   Style="{DynamicResource Badge.Text}" />
                                    </Border>
                                </StackPanel>
                            </TabItem.Header>
                            <!-- محتوای تب «صورت‌حساب‌ها» در ViewModel تأمین می‌شود -->
                            <ContentControl Content="{Binding TabContents[1]}" />
                        </TabItem>
                        <TabItem Style="{DynamicResource Tab.Item}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{DynamicResource Icon.Small}"
                                          Data="{DynamicResource Icon.RotateCcw}" />
                                    <TextBlock Text="برگشتی‌ها"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                    <Border Style="{DynamicResource Badge.Neutral}"
                                            Margin="6,0,0,0">
                                        <TextBlock Text="9"
                                                   Style="{DynamicResource Badge.Text}" />
                                    </Border>
                                </StackPanel>
                            </TabItem.Header>
                            <!-- محتوای تب «برگشتی‌ها» در ViewModel تأمین می‌شود -->
                            <ContentControl Content="{Binding TabContents[2]}" />
                        </TabItem>
                        <TabItem Style="{DynamicResource Tab.Item}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{DynamicResource Icon.Small}"
                                          Data="{DynamicResource Icon.Signature}" />
                                    <TextBlock Text="قراردادها"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                    <Border Style="{DynamicResource Badge.Neutral}"
                                            Margin="6,0,0,0">
                                        <TextBlock Text="4"
                                                   Style="{DynamicResource Badge.Text}" />
                                    </Border>
                                </StackPanel>
                            </TabItem.Header>
                            <!-- محتوای تب «قراردادها» در ViewModel تأمین می‌شود -->
                            <ContentControl Content="{Binding TabContents[3]}" />
                        </TabItem>
                    </TabControl>

                    <DataGrid Style="{DynamicResource Grid.Modern}"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              RowHeight="{StaticResource Size.RowHeight}"
                              FlowDirection="RightToLeft">
                        <DataGrid.Columns>
                            <!-- دوره — نوع: text -->
                            <DataGridTextColumn Header="دوره"
                                                Binding="{Binding Period}"
                                                Width="112"
                                                ElementStyle="{DynamicResource Txt.Body}" />
                            <!-- شرکت بیمه — نوع: text -->
                            <DataGridTextColumn Header="شرکت بیمه"
                                                Binding="{Binding Company}"
                                                Width="*"
                                                ElementStyle="{DynamicResource Txt.Body}" />
                            <!-- تعداد — نوع: num -->
                            <DataGridTextColumn Header="تعداد"
                                                Binding="{Binding Claims}"
                                                Width="84"
                                                ElementStyle="{DynamicResource Txt.Body}" />
                            <!-- مبلغ — نوع: money -->
                            <DataGridTextColumn Header="مبلغ" Width="124" Binding="{Binding Amount}"
                                                ElementStyle="{DynamicResource Txt.Numeric}">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource Grid.Header}">
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <!-- تأیید شده — نوع: money -->
                            <DataGridTextColumn Header="تأیید شده" Width="124" Binding="{Binding Approved}"
                                                ElementStyle="{DynamicResource Txt.Numeric}">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource Grid.Header}">
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <!-- وضعیت — نوع: chip -->
                            <DataGridTemplateColumn Header="وضعیت" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource Badge}"
                                                HorizontalAlignment="Center"
                                                Background="{Binding StatusTone, Converter={StaticResource StatusTone}}">
                                            <TextBlock Text="{Binding Status}"
                                                       Style="{DynamicResource Badge.Text}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ctrl:EmptyState Icon="{DynamicResource Icon.ShieldCheck}"
                                      Title="{loc:Loc Common.EmptyTitle}"
                                      Message="{loc:Loc Common.EmptyMessage}"
                                      Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            <!-- ══════════════════════════════════════════════════════════
     ارتباطاتِ این صفحه با دیگر صفحات
     هر ردیف: «مبدأ» → «مقصد» با توضیحِ نوعِ پیوند
     این بلوک در همه‌ی صفحات حضور دارد تا مسیرِ حرکتِ کاربر گم نشود.
     ══════════════════════════════════════════════════════════ -->
            <Border Style="{DynamicResource Card.Flat}" Margin="0,{StaticResource S.3},0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,{StaticResource S.3}">
                        <Path Style="{DynamicResource Icon.Small}"
                              Data="{DynamicResource Icon.GitBranch}"
                               Stroke="{DynamicResource Brush.Primary}" />
                        <TextBlock Text="{loc:Loc Common.Relations}"
                                   Style="{DynamicResource Txt.Subtitle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource S.2},0,0,0" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Relations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,{StaticResource S.2}">
                                    <Border Style="{DynamicResource Badge.Neutral}">
                                        <TextBlock Text="{Binding From}"
                                                   Style="{DynamicResource Badge.Text}" />
                                    </Border>
                                        <Path Style="{DynamicResource Icon.XSmall}"
                                              Data="{DynamicResource Icon.ArrowLeft}"
                                               Stroke="{DynamicResource Brush.TextMuted}" />
                                    <Border Style="{DynamicResource Badge.Info}">
                                        <TextBlock Text="{Binding To}"
                                                   Style="{DynamicResource Badge.Text}" />
                                    </Border>
                                    <TextBlock Text="{Binding Why}"
                                               Style="{DynamicResource Txt.Caption}"
                                               VerticalAlignment="Center"
                                               Margin="{StaticResource S.2},0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>