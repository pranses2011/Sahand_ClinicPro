<!--
╔══════════════════════════════════════════════════════════════════════╗
║  فیزیوتراپی — PhysiotherapyView
╠══════════════════════════════════════════════════════════════════════╣
║  گروه        : ویزیت
║  کهن‌الگو     : detail-tabs
║  ViewModel   : PhysiotherapyViewModel
║  وایرفریم    : 01-wireframes-html/PhysiotherapyView.html
╠══════════════════════════════════════════════════════════════════════╣
║  ساختار (اندازه‌ی هر فیلد/ستون بر پایه‌ی ۱۲ ستون است تا
║  «بزرگیِ عنصر متناسب با کارکردش» باشد — کد ملی ۳ ستون، نشانی ۱۲ ستون)
╠══════════════════════════════════════════════════════════════════════╣
║  نام              نوع              پهنا   الزامی
║  ─────────────────────────────────────────────────
║  ▸ ارزیابی درد
║    PainLevel       TextBox (عددی)   4      خیر
║    PainLocation    ComboBox         4      خیر
║    Sessions        TextBox (عددی)   4      خیر
║  ▸ ستون‌های جدول
║    Session         num              86px   Center
║    Date            date             112px  Right
║    Pain            num              104px  Center
║    Exercise        text             *      Right
║    Status          chip             112px  Center
╠══════════════════════════════════════════════════════════════════════╣
║  ارتباطات این صفحه
║  ─────────────────────────────────────────────────
║    فیزیوتراپی  ──▶  ویزیت (SOAP)
║         ویزیت تخصصی
╚══════════════════════════════════════════════════════════════════════╝

  قواعدِ رعایت‌شده در این فایل:
    • راست‌چین (RTL) و قلمِ وزیرمتن در سراسرِ صفحه
    • هیچ رنگِ ثابت (هگز) — همه از نشانه‌های معناییِ DynamicResource
    • الگوی MVVM: هیچ منطقی در code-behind، همه چیز از ViewModel
    • متن‌ها از فایلِ زبان (loc:Loc) برای پشتیبانیِ دو زبانهٔ آینده
    • تاریخ‌ها با تبدیل‌گرِ PersianDate به شمسی نمایش داده می‌شوند
    • نقشهٔ ارتباطات در پایینِ صفحه مسیرِ حرکت را نشان می‌دهد
-->

<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.PhysiotherapyView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        xmlns:loc="clr-namespace:Sahand.ClinicPro.Desktop.Localization"
        xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DesignHeight="820" d:DesignWidth="1280"
        d:DataContext="{d:DesignInstance vm:PhysiotherapyViewModel}"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource Brush.Canvas}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ سربرگِ یکپارچه‌ی صفحه ═══ -->
        <ctrl:PageHeader Grid.Row="0"
                        Title="فیزیوتراپی"
                        Subtitle="برنامه تمرینی و پیگیری جلسات فیزیوتراپی"
                        Icon="{DynamicResource Icon.Accessibility}"
                        Margin="{StaticResource P.Page}" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="{StaticResource P.Page}">
            <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- ── بخش: ارزیابی درد ── -->
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="12"
                        Margin="0,{StaticResource S.2},0,{StaticResource S.3}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{DynamicResource Icon.Small}"
                              Data="{DynamicResource Icon.Activity}"
                               Stroke="{DynamicResource Brush.Primary}" />
                        <TextBlock Text="ارزیابی درد"
                                   Style="{DynamicResource Txt.Title}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource S.2},0,0,0" />
                    </StackPanel>
                </Border>
                <!-- نمره درد (۰ تا ۱۰) — TextBox (عددی) · پهنای 4/۱۲ -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="نمره درد (۰ تا ۱۰)"
                               Style="{DynamicResource Input.Label}" />
                    <TextBox Style="{DynamicResource Input.TextBox}"
                             Text="{Binding PainLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="12"
                             TextAlignment="Left"
                             FlowDirection="LeftToRight" />
                </StackPanel>
                <!-- محل درد — ComboBox · پهنای 4/۱۲ -->
                <StackPanel Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="4"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="محل درد"
                               Style="{DynamicResource Input.Label}" />
                    <ComboBox Style="{DynamicResource Input.ComboBox}"
                              SelectedItem="{Binding PainLocation, Mode=TwoWay}">
                        <ComboBoxItem Content="گردن" />
                        <ComboBoxItem Content="کمر" IsSelected="True" />
                        <ComboBoxItem Content="زانو" />
                        <ComboBoxItem Content="شانه" />
                    </ComboBox>
                </StackPanel>
                <!-- تعداد جلسات — TextBox (عددی) · پهنای 4/۱۲ -->
                <StackPanel Grid.Row="1" Grid.Column="8" Grid.ColumnSpan="4"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="تعداد جلسات"
                               Style="{DynamicResource Input.Label}" />
                    <TextBox Style="{DynamicResource Input.TextBox}"
                             Text="{Binding Sessions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="12"
                             TextAlignment="Left"
                             FlowDirection="LeftToRight" />
                </StackPanel>
            </Grid>

                    <TabControl Style="{DynamicResource Tab.Modern}">
                        <TabItem Style="{DynamicResource Tab.Item}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{DynamicResource Icon.Small}"
                                          Data="{DynamicResource Icon.CalendarDays}" />
                                    <TextBlock Text="جلسات"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </TabItem.Header>
                            <!-- محتوای تب «جلسات» در ViewModel تأمین می‌شود -->
                            <ContentControl Content="{Binding TabContents[0]}" />
                        </TabItem>
                        <TabItem Style="{DynamicResource Tab.Item}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{DynamicResource Icon.Small}"
                                          Data="{DynamicResource Icon.Activity}" />
                                    <TextBlock Text="ارزیابی درد"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </TabItem.Header>
                            <!-- محتوای تب «ارزیابی درد» در ViewModel تأمین می‌شود -->
                            <ContentControl Content="{Binding TabContents[1]}" />
                        </TabItem>
                        <TabItem Style="{DynamicResource Tab.Item}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{DynamicResource Icon.Small}"
                                          Data="{DynamicResource Icon.ListChecks}" />
                                    <TextBlock Text="برنامه تمرینی"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </TabItem.Header>
                            <!-- محتوای تب «برنامه تمرینی» در ViewModel تأمین می‌شود -->
                            <ContentControl Content="{Binding TabContents[2]}" />
                        </TabItem>
                    </TabControl>

                    <DataGrid Style="{DynamicResource Grid.Modern}"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              RowHeight="{StaticResource Size.RowHeight}"
                              FlowDirection="RightToLeft">
                        <DataGrid.Columns>
                            <!-- جلسه — نوع: num -->
                            <DataGridTextColumn Header="جلسه"
                                                Binding="{Binding Session}"
                                                Width="86"
                                                ElementStyle="{DynamicResource Txt.Body}" />
                            <!-- تاریخ — نوع: date -->
                            <DataGridTextColumn Header="تاریخ" Width="112" Binding="{Binding Date, Converter={StaticResource PersianDate}}" />
                            <!-- نمره درد — نوع: num -->
                            <DataGridTextColumn Header="نمره درد"
                                                Binding="{Binding Pain}"
                                                Width="104"
                                                ElementStyle="{DynamicResource Txt.Body}" />
                            <!-- برنامه تمرینی — نوع: text -->
                            <DataGridTextColumn Header="برنامه تمرینی"
                                                Binding="{Binding Exercise}"
                                                Width="*"
                                                ElementStyle="{DynamicResource Txt.Body}" />
                            <!-- وضعیت — نوع: chip -->
                            <DataGridTemplateColumn Header="وضعیت" Width="112">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource Badge}"
                                                HorizontalAlignment="Center"
                                                Background="{Binding StatusTone, Converter={StaticResource StatusTone}}">
                                            <TextBlock Text="{Binding Status}"
                                                       Style="{DynamicResource Badge.Text}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ctrl:EmptyState Icon="{DynamicResource Icon.Accessibility}"
                                      Title="{loc:Loc Common.EmptyTitle}"
                                      Message="{loc:Loc Common.EmptyMessage}"
                                      Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            <!-- ══════════════════════════════════════════════════════════
     ارتباطاتِ این صفحه با دیگر صفحات
     هر ردیف: «مبدأ» → «مقصد» با توضیحِ نوعِ پیوند
     این بلوک در همه‌ی صفحات حضور دارد تا مسیرِ حرکتِ کاربر گم نشود.
     ══════════════════════════════════════════════════════════ -->
            <Border Style="{DynamicResource Card.Flat}" Margin="0,{StaticResource S.3},0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,{StaticResource S.3}">
                        <Path Style="{DynamicResource Icon.Small}"
                              Data="{DynamicResource Icon.GitBranch}"
                               Stroke="{DynamicResource Brush.Primary}" />
                        <TextBlock Text="{loc:Loc Common.Relations}"
                                   Style="{DynamicResource Txt.Subtitle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource S.2},0,0,0" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Relations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,{StaticResource S.2}">
                                    <Border Style="{DynamicResource Badge.Neutral}">
                                        <TextBlock Text="{Binding From}"
                                                   Style="{DynamicResource Badge.Text}" />
                                    </Border>
                                        <Path Style="{DynamicResource Icon.XSmall}"
                                              Data="{DynamicResource Icon.ArrowLeft}"
                                               Stroke="{DynamicResource Brush.TextMuted}" />
                                    <Border Style="{DynamicResource Badge.Info}">
                                        <TextBlock Text="{Binding To}"
                                                   Style="{DynamicResource Badge.Text}" />
                                    </Border>
                                    <TextBlock Text="{Binding Why}"
                                               Style="{DynamicResource Txt.Caption}"
                                               VerticalAlignment="Center"
                                               Margin="{StaticResource S.2},0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>