<!--
╔══════════════════════════════════════════════════════════════════════╗
║  بیماران — PatientsView
╠══════════════════════════════════════════════════════════════════════╣
║  گروه        : بیماران
║  کهن‌الگو     : list-detail
║  ViewModel   : PatientsViewModel
║  وایرفریم    : 01-wireframes-html/PatientsView.html
╠══════════════════════════════════════════════════════════════════════╣
║  ساختار (اندازه‌ی هر فیلد/ستون بر پایه‌ی ۱۲ ستون است تا
║  «بزرگیِ عنصر متناسب با کارکردش» باشد — کد ملی ۳ ستون، نشانی ۱۲ ستون)
╠══════════════════════════════════════════════════════════════════════╣
║  نام              نوع              پهنا   الزامی
║  ─────────────────────────────────────────────────
║  ▸ ستون‌های جدول
║    Code            text             104px  Right
║    FullName        who              *      Right
║    NationalId      num              118px  Left
║    Phone           num              124px  Left
║    Age             num              58px   Center
║    Gender          text             74px   Center
║    LastVisit       date             118px  Right
║    Balance         money            110px  Left
║    Status          chip             96px   Center
╠══════════════════════════════════════════════════════════════════════╣
║  ارتباطات این صفحه
║  ─────────────────────────────────────────────────
║    بیماران  ──▶  پرونده‌ی بیمار
║         هر ردیف به پرونده می‌رود
║    بیماران  ──▶  پذیرش و صف
║         بیمار پذیرش می‌شود
║    بیماران  ──▶  نوبت‌دهی
║         نوبت برای بیمار ثبت می‌شود
║    بیماران  ──▶  صورتحساب
║         مانده حساب از فاکتورها
╚══════════════════════════════════════════════════════════════════════╝

  قواعدِ رعایت‌شده در این فایل:
    • راست‌چین (RTL) و قلمِ وزیرمتن در سراسرِ صفحه
    • هیچ رنگِ ثابت (هگز) — همه از نشانه‌های معناییِ DynamicResource
    • الگوی MVVM: هیچ منطقی در code-behind، همه چیز از ViewModel
    • متن‌ها از فایلِ زبان (loc:Loc) برای پشتیبانیِ دو زبانهٔ آینده
    • تاریخ‌ها با تبدیل‌گرِ PersianDate به شمسی نمایش داده می‌شوند
    • نقشهٔ ارتباطات در پایینِ صفحه مسیرِ حرکت را نشان می‌دهد
-->

<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.PatientsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        xmlns:loc="clr-namespace:Sahand.ClinicPro.Desktop.Localization"
        xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DesignHeight="820" d:DesignWidth="1280"
        d:DataContext="{d:DesignInstance vm:PatientsViewModel}"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource Brush.Canvas}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ سربرگِ یکپارچه‌ی صفحه ═══ -->
        <ctrl:PageHeader Grid.Row="0"
                        Title="بیماران"
                        Subtitle="مدیریت پرونده‌ها و جستجوی بیماران"
                        Icon="{DynamicResource Icon.Users}"
                        Margin="{StaticResource P.Page}" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="{StaticResource P.Page}">
            <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
            <ItemsControl ItemsSource="{Binding Kpis}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ctrl:StatCard Margin="{StaticResource S.3}"
                                      Title="{Binding Title}"
                                      Value="{Binding Value}"
                                      Trend="{Binding Trend}"
                                      Icon="{Binding Icon}"
                                      Accent="{Binding Accent}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{DynamicResource Card.Flat}"
                    Padding="{StaticResource S.3}"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- جستجو -->
                    <StackPanel Margin="0,0,{StaticResource S.3},0">
                        <TextBlock Text="جستجو"
                                   Style="{DynamicResource Input.Label}" />
                        <ctrl:SearchBox Width="260"
                                        Text="{Binding SearchText, Mode=TwoWay}"
                                        Placeholder="نام، کد ملی یا موبایل…" />
                    </StackPanel>
                    <!-- شعبه -->
                    <StackPanel Margin="0,0,{StaticResource S.3},0">
                        <TextBlock Text="شعبه"
                                   Style="{DynamicResource Input.Label}" />
                        <ComboBox Width="160"
                                  Style="{DynamicResource Input.ComboBox}"
                                  SelectedItem="{Binding Filter2, Mode=TwoWay}">
                            <ComboBoxItem Content="همه شعب" IsSelected="True" />
                            <ComboBoxItem Content="مرکزی" />
                            <ComboBoxItem Content="شعبه ۲" />
                        </ComboBox>
                    </StackPanel>
                    <!-- وضعیت -->
                    <StackPanel Margin="0,0,{StaticResource S.3},0">
                        <TextBlock Text="وضعیت"
                                   Style="{DynamicResource Input.Label}" />
                        <ComboBox Width="120"
                                  Style="{DynamicResource Input.ComboBox}"
                                  SelectedItem="{Binding Filter3, Mode=TwoWay}">
                            <ComboBoxItem Content="فعال" IsSelected="True" />
                            <ComboBoxItem Content="غیرفعال" />
                            <ComboBoxItem Content="بایگانی" />
                        </ComboBox>
                    </StackPanel>
                    <!-- جنسیت -->
                    <StackPanel Margin="0,0,{StaticResource S.3},0">
                        <TextBlock Text="جنسیت"
                                   Style="{DynamicResource Input.Label}" />
                        <ComboBox Width="120"
                                  Style="{DynamicResource Input.ComboBox}"
                                  SelectedItem="{Binding Filter4, Mode=TwoWay}">
                            <ComboBoxItem Content="همه" IsSelected="True" />
                            <ComboBoxItem Content="زن" />
                            <ComboBoxItem Content="مرد" />
                        </ComboBox>
                    </StackPanel>
                    <!-- از تاریخ -->
                    <StackPanel Margin="0,0,{StaticResource S.3},0">
                        <TextBlock Text="از تاریخ"
                                   Style="{DynamicResource Input.Label}" />
                        <DatePicker Width="160"
                                    Style="{DynamicResource Input.Date}"
                                    SelectedDate="{Binding Filter5, Mode=TwoWay}" />
                    </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Left">
                    <Button Style="{DynamicResource Btn.Primary}"
                            Command="{Binding NewCommand}"
                            Margin="0,0,{StaticResource S.2},0"
                            MinHeight="{StaticResource Size.ButtonHeight}"
                            Padding="{StaticResource P.Button}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{DynamicResource Icon.Small}"
                                  Data="{DynamicResource Icon.UserPlus}"
                                  Margin="0,0,{StaticResource S.2},0" />
                            <TextBlock Text="بیمار جدید" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource Btn.Secondary}"
                            Command="{Binding ExportCommand}"
                            Margin="0,0,{StaticResource S.2},0"
                            MinHeight="{StaticResource Size.ButtonHeight}"
                            Padding="{StaticResource P.Button}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{DynamicResource Icon.Small}"
                                  Data="{DynamicResource Icon.FileSpreadsheet}"
                                  Margin="0,0,{StaticResource S.2},0" />
                            <TextBlock Text="خروجی Excel" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource Btn.Secondary}"
                            Command="{Binding PrintCommand}"
                            Margin="0,0,{StaticResource S.2},0"
                            MinHeight="{StaticResource Size.ButtonHeight}"
                            Padding="{StaticResource P.Button}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{DynamicResource Icon.Small}"
                                  Data="{DynamicResource Icon.Printer}"
                                  Margin="0,0,{StaticResource S.2},0" />
                            <TextBlock Text="چاپ کارت" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    </StackPanel>
                </Grid>
            </Border>

                    <DataGrid Style="{DynamicResource Grid.Modern}"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              RowHeight="{StaticResource Size.RowHeight}"
                              FlowDirection="RightToLeft">
                        <DataGrid.Columns>
                            <!-- کد پرونده — نوع: text -->
                            <DataGridTextColumn Header="کد پرونده"
                                                Binding="{Binding Code}"
                                                Width="104"
                                                ElementStyle="{DynamicResource Txt.Body}" />
                            <!-- نام بیمار — نوع: who -->
                            <DataGridTemplateColumn Header="نام بیمار" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- نشانِ تصویریِ بیمار/کاربر -->
                                            <Border Width="30" Height="30"
                                                    CornerRadius="{StaticResource R.Pill}"
                                                    Background="{Binding FullNameAvatar}"
                                                    Margin="0,0,{StaticResource S.2},0">
                                                <TextBlock Text="{Binding FullNameInitials}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.OnPrimary}"
                                                           FontSize="{StaticResource Fs.Caption}" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}"
                                                           Style="{DynamicResource Txt.Body}" />
                                                <TextBlock Text="{Binding FullNameSub}"
                                                           Style="{DynamicResource Txt.Caption}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- کد ملی — نوع: num -->
                            <DataGridTextColumn Header="کد ملی"
                                                Binding="{Binding NationalId}"
                                                Width="118"
                                                ElementStyle="{DynamicResource Txt.Body}" />
                            <!-- موبایل — نوع: num -->
                            <DataGridTextColumn Header="موبایل"
                                                Binding="{Binding Phone}"
                                                Width="124"
                                                ElementStyle="{DynamicResource Txt.Body}" />
                            <!-- سن — نوع: num -->
                            <DataGridTextColumn Header="سن"
                                                Binding="{Binding Age}"
                                                Width="58"
                                                ElementStyle="{DynamicResource Txt.Body}" />
                            <!-- جنسیت — نوع: text -->
                            <DataGridTextColumn Header="جنسیت"
                                                Binding="{Binding Gender}"
                                                Width="74"
                                                ElementStyle="{DynamicResource Txt.Body}" />
                            <!-- آخرین ویزیت — نوع: date -->
                            <DataGridTextColumn Header="آخرین ویزیت" Width="118" Binding="{Binding LastVisit, Converter={StaticResource PersianDate}}" />
                            <!-- مانده — نوع: money -->
                            <DataGridTextColumn Header="مانده" Width="110" Binding="{Binding Balance}"
                                                ElementStyle="{DynamicResource Txt.Numeric}">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource Grid.Header}">
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <!-- وضعیت — نوع: chip -->
                            <DataGridTemplateColumn Header="وضعیت" Width="96">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource Badge}"
                                                HorizontalAlignment="Center"
                                                Background="{Binding StatusTone, Converter={StaticResource StatusTone}}">
                                            <TextBlock Text="{Binding Status}"
                                                       Style="{DynamicResource Badge.Text}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ctrl:EmptyState Icon="{DynamicResource Icon.Users}"
                                      Title="{loc:Loc Common.EmptyTitle}"
                                      Message="{loc:Loc Common.EmptyMessage}"
                                      Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    <Border Style="{DynamicResource Card.Flat}"
                            Padding="{StaticResource S.3}"
                            Margin="0,{StaticResource S.3},0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding PageSummary}"
                                       Style="{DynamicResource Txt.Caption}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{DynamicResource Btn.Icon}"
                                        Command="{Binding PreviousPageCommand}"
                                        ToolTip="{loc:Loc Common.Previous}">
                                    <Path Style="{DynamicResource Icon.Small}"
                                          Data="{DynamicResource Icon.ChevronRight}" />
                                </Button>
                                <Button Style="{DynamicResource Btn.Icon}"
                                        Command="{Binding NextPageCommand}"
                                        ToolTip="{loc:Loc Common.Next}">
                                    <Path Style="{DynamicResource Icon.Small}"
                                          Data="{DynamicResource Icon.ChevronLeft}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
                <Border Style="{DynamicResource Card}"
                        MinWidth="300"
                        Margin="{StaticResource S.3},0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,{StaticResource S.3}">
                            <Path Style="{DynamicResource Icon.Medium}"
                                  Data="{DynamicResource Icon.IdCard}"
                                   Stroke="{DynamicResource Brush.Primary}" />
                            <TextBlock Text="خلاصه پرونده"
                                       Style="{DynamicResource Txt.Subtitle}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <Grid Margin="0,0,0,{StaticResource S.2}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="کد پرونده"
                                       Style="{DynamicResource Txt.Caption}"
                                       Margin="0,0,{StaticResource S.3},0" />
                            <TextBlock Grid.Column="1" Text="P-۱۰۲۴"
                                       Style="{DynamicResource Txt.Body}"
                                       TextAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,{StaticResource S.2}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="نام"
                                       Style="{DynamicResource Txt.Caption}"
                                       Margin="0,0,{StaticResource S.3},0" />
                            <TextBlock Grid.Column="1" Text="سارا احمدی"
                                       Style="{DynamicResource Txt.Body}"
                                       TextAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,{StaticResource S.2}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="کد ملی"
                                       Style="{DynamicResource Txt.Caption}"
                                       Margin="0,0,{StaticResource S.3},0" />
                            <TextBlock Grid.Column="1" Text="۰۰۱-۲۳۴۵۶۷-۸"
                                       Style="{DynamicResource Txt.Body}"
                                       TextAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,{StaticResource S.2}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="سن/جنسیت"
                                       Style="{DynamicResource Txt.Caption}"
                                       Margin="0,0,{StaticResource S.3},0" />
                            <TextBlock Grid.Column="1" Text="۴۲ سال · زن"
                                       Style="{DynamicResource Txt.Body}"
                                       TextAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,{StaticResource S.2}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="بیمه"
                                       Style="{DynamicResource Txt.Caption}"
                                       Margin="0,0,{StaticResource S.3},0" />
                            <TextBlock Grid.Column="1" Text="تأمین اجتماعی"
                                       Style="{DynamicResource Txt.Body}"
                                       TextAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,{StaticResource S.2}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="موبایل"
                                       Style="{DynamicResource Txt.Caption}"
                                       Margin="0,0,{StaticResource S.3},0" />
                            <TextBlock Grid.Column="1" Text="۰۹۱۴۴۲۲۰۴۳۰"
                                       Style="{DynamicResource Txt.Body}"
                                       TextAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,{StaticResource S.2}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="آخرین ویزیت"
                                       Style="{DynamicResource Txt.Caption}"
                                       Margin="0,0,{StaticResource S.3},0" />
                            <TextBlock Grid.Column="1" Text="۱۴۰۴/۰۷/۱۲"
                                       Style="{DynamicResource Txt.Body}"
                                       TextAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,{StaticResource S.2}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="مانده حساب"
                                       Style="{DynamicResource Txt.Caption}"
                                       Margin="0,0,{StaticResource S.3},0" />
                            <TextBlock Grid.Column="1" Text="۰ تومان"
                                       Style="{DynamicResource Txt.Body}"
                                       TextAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- ══════════════════════════════════════════════════════════
     ارتباطاتِ این صفحه با دیگر صفحات
     هر ردیف: «مبدأ» → «مقصد» با توضیحِ نوعِ پیوند
     این بلوک در همه‌ی صفحات حضور دارد تا مسیرِ حرکتِ کاربر گم نشود.
     ══════════════════════════════════════════════════════════ -->
            <Border Style="{DynamicResource Card.Flat}" Margin="0,{StaticResource S.3},0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,{StaticResource S.3}">
                        <Path Style="{DynamicResource Icon.Small}"
                              Data="{DynamicResource Icon.GitBranch}"
                               Stroke="{DynamicResource Brush.Primary}" />
                        <TextBlock Text="{loc:Loc Common.Relations}"
                                   Style="{DynamicResource Txt.Subtitle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource S.2},0,0,0" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Relations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,{StaticResource S.2}">
                                    <Border Style="{DynamicResource Badge.Neutral}">
                                        <TextBlock Text="{Binding From}"
                                                   Style="{DynamicResource Badge.Text}" />
                                    </Border>
                                        <Path Style="{DynamicResource Icon.XSmall}"
                                              Data="{DynamicResource Icon.ArrowLeft}"
                                               Stroke="{DynamicResource Brush.TextMuted}" />
                                    <Border Style="{DynamicResource Badge.Info}">
                                        <TextBlock Text="{Binding To}"
                                                   Style="{DynamicResource Badge.Text}" />
                                    </Border>
                                    <TextBlock Text="{Binding Why}"
                                               Style="{DynamicResource Txt.Caption}"
                                               VerticalAlignment="Center"
                                               Margin="{StaticResource S.2},0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>