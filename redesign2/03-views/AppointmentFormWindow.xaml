<!--
╔══════════════════════════════════════════════════════════════════════╗
║  فرم نوبت — AppointmentFormWindow
╠══════════════════════════════════════════════════════════════════════╣
║  گروه        : نوبت‌دهی
║  کهن‌الگو     : form-std
║  ViewModel   : AppointmentFormViewModel
║  وایرفریم    : 01-wireframes-html/AppointmentFormWindow.html
╠══════════════════════════════════════════════════════════════════════╣
║  ساختار (اندازه‌ی هر فیلد/ستون بر پایه‌ی ۱۲ ستون است تا
║  «بزرگیِ عنصر متناسب با کارکردش» باشد — کد ملی ۳ ستون، نشانی ۱۲ ستون)
╠══════════════════════════════════════════════════════════════════════╣
║  نام              نوع              پهنا   الزامی
║  ─────────────────────────────────────────────────
║  ▸ زمان و پزشک
║    PatientId       ComboBox         6      بله
║    DoctorId        ComboBox         3      بله
║    Date            DatePicker       3      بله
║    Time            TextBox          3      بله
║    Duration        ComboBox         3      خیر
║    VisitType       ComboBox         3      خیر
║    RoomId          ComboBox         3      خیر
║  ▸ توضیحات
║    Reason          TextBox          12     خیر
║    Notes           TextBox (چندخطی  12     خیر
║    SendSms         CheckBox         6      خیر
║    IsUrgent        CheckBox         6      خیر
╠══════════════════════════════════════════════════════════════════════╣
║  ارتباطات این صفحه
║  ─────────────────────────────────────────────────
║    فرم نوبت  ──▶  اتاق‌ها
║         اتاق از فهرست اتاق‌ها
║    فرم نوبت  ──▶  پیامک
║         یادآوری پیامکی
╚══════════════════════════════════════════════════════════════════════╝

  قواعدِ رعایت‌شده در این فایل:
    • راست‌چین (RTL) و قلمِ وزیرمتن در سراسرِ صفحه
    • هیچ رنگِ ثابت (هگز) — همه از نشانه‌های معناییِ DynamicResource
    • الگوی MVVM: هیچ منطقی در code-behind، همه چیز از ViewModel
    • متن‌ها از فایلِ زبان (loc:Loc) برای پشتیبانیِ دو زبانهٔ آینده
    • تاریخ‌ها با تبدیل‌گرِ PersianDate به شمسی نمایش داده می‌شوند
    • نقشهٔ ارتباطات در پایینِ صفحه مسیرِ حرکت را نشان می‌دهد
-->

<Window x:Class="Sahand.ClinicPro.Desktop.Views.AppointmentFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        xmlns:loc="clr-namespace:Sahand.ClinicPro.Desktop.Localization"
        xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="فرم نوبت"
        Style="{DynamicResource Window.Modern}"
        WindowStartupLocation="CenterScreen"
        Height="820" Width="960"
        d:DataContext="{d:DesignInstance vm:AppointmentFormViewModel}"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource Brush.Canvas}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ سربرگِ یکپارچه‌ی صفحه ═══ -->
        <ctrl:PageHeader Grid.Row="0"
                        Title="فرم نوبت"
                        Subtitle="ثبت نوبت جدید"
                        Icon="{DynamicResource Icon.CalendarPlus}"
                        Margin="{StaticResource P.Page}" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="{StaticResource P.Page}">
            <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- ── بخش: زمان و پزشک ── -->
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="12"
                        Margin="0,{StaticResource S.2},0,{StaticResource S.3}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{DynamicResource Icon.Small}"
                              Data="{DynamicResource Icon.CalendarClock}"
                               Stroke="{DynamicResource Brush.Primary}" />
                        <TextBlock Text="زمان و پزشک"
                                   Style="{DynamicResource Txt.Title}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource S.2},0,0,0" />
                    </StackPanel>
                </Border>
                <!-- بیمار — ComboBox · پهنای 6/۱۲ -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="بیمار"
                               Style="{DynamicResource Input.LabelRequired}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  Style="{DynamicResource Input.ComboBox}"
                                  IsEditable="True"
                                  Text="{Binding PatientId, Mode=TwoWay}" />
                        <Button Grid.Column="1"
                                Style="{DynamicResource Btn.Icon}"
                                Command="{Binding LookupPatientIdCommand}"
                                Margin="{StaticResource S.2},0,0,0"
                                ToolTip="{loc:Loc Common.Search}">
                            <Path Style="{DynamicResource Icon.Small}"
                                  Data="{DynamicResource Icon.Search}" />
                        </Button>
                    </Grid>
                    <!-- خطاهای اعتبارسنجی به‌صورت خودکار از INotifyDataErrorInfo نمایش داده می‌شوند -->
                </StackPanel>
                <!-- پزشک — ComboBox · پهنای 3/۱۲ -->
                <StackPanel Grid.Row="1" Grid.Column="6" Grid.ColumnSpan="3"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="پزشک"
                               Style="{DynamicResource Input.LabelRequired}" />
                    <ComboBox Style="{DynamicResource Input.ComboBox}"
                              SelectedItem="{Binding DoctorId, Mode=TwoWay}">
                        <ComboBoxItem Content="دکتر موسوی" IsSelected="True" />
                        <ComboBoxItem Content="دکتر رضایی" />
                        <ComboBoxItem Content="دکتر کریمی" />
                    </ComboBox>
                    <!-- خطاهای اعتبارسنجی به‌صورت خودکار از INotifyDataErrorInfo نمایش داده می‌شوند -->
                </StackPanel>
                <!-- تاریخ نوبت — DatePicker · پهنای 3/۱۲ -->
                <StackPanel Grid.Row="1" Grid.Column="9" Grid.ColumnSpan="3"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="تاریخ نوبت"
                               Style="{DynamicResource Input.LabelRequired}" />
                    <DatePicker Style="{DynamicResource Input.Date}"
                                SelectedDate="{Binding Date, Mode=TwoWay}"
                                SelectedDateFormat="Short" />
                    <!-- خطاهای اعتبارسنجی به‌صورت خودکار از INotifyDataErrorInfo نمایش داده می‌شوند -->
                </StackPanel>
                <!-- ساعت — TextBox · پهنای 3/۱۲ -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="ساعت"
                               Style="{DynamicResource Input.LabelRequired}" />
                    <TextBox Style="{DynamicResource Input.TextBox}"
                             Text="{Binding Time, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Tag="۱۰:۳۰"
                             />
                    <!-- خطاهای اعتبارسنجی به‌صورت خودکار از INotifyDataErrorInfo نمایش داده می‌شوند -->
                </StackPanel>
                <!-- مدت — ComboBox · پهنای 3/۱۲ -->
                <StackPanel Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="3"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="مدت"
                               Style="{DynamicResource Input.Label}" />
                    <ComboBox Style="{DynamicResource Input.ComboBox}"
                              SelectedItem="{Binding Duration, Mode=TwoWay}">
                        <ComboBoxItem Content="۱۵ دقیقه" />
                        <ComboBoxItem Content="۲۰ دقیقه" IsSelected="True" />
                        <ComboBoxItem Content="۳۰ دقیقه" />
                    </ComboBox>
                </StackPanel>
                <!-- نوع ویزیت — ComboBox · پهنای 3/۱۲ -->
                <StackPanel Grid.Row="2" Grid.Column="6" Grid.ColumnSpan="3"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="نوع ویزیت"
                               Style="{DynamicResource Input.Label}" />
                    <ComboBox Style="{DynamicResource Input.ComboBox}"
                              SelectedItem="{Binding VisitType, Mode=TwoWay}">
                        <ComboBoxItem Content="ویزیت عمومی" IsSelected="True" />
                        <ComboBoxItem Content="تخصصی" />
                        <ComboBoxItem Content="پیگیری" />
                        <ComboBoxItem Content="معاینه دوره‌ای" />
                    </ComboBox>
                </StackPanel>
                <!-- اتاق — ComboBox · پهنای 3/۱۲ -->
                <StackPanel Grid.Row="2" Grid.Column="9" Grid.ColumnSpan="3"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="اتاق"
                               Style="{DynamicResource Input.Label}" />
                    <ComboBox Style="{DynamicResource Input.ComboBox}"
                              SelectedItem="{Binding RoomId, Mode=TwoWay}">
                        <ComboBoxItem Content="اتاق ۱" />
                        <ComboBoxItem Content="اتاق ۲" IsSelected="True" />
                        <ComboBoxItem Content="اتاق ۳" />
                    </ComboBox>
                </StackPanel>
                <!-- ── بخش: توضیحات ── -->
                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="12"
                        Margin="0,{StaticResource S.2},0,{StaticResource S.3}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{DynamicResource Icon.Small}"
                              Data="{DynamicResource Icon.MessageSquare}"
                               Stroke="{DynamicResource Brush.Primary}" />
                        <TextBlock Text="توضیحات"
                                   Style="{DynamicResource Txt.Title}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource S.2},0,0,0" />
                    </StackPanel>
                </Border>
                <!-- علت مراجعه — TextBox · پهنای 12/۱۲ -->
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="12"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="علت مراجعه"
                               Style="{DynamicResource Input.Label}" />
                    <TextBox Style="{DynamicResource Input.TextBox}"
                             Text="{Binding Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Tag="درد معده"
                             />
                </StackPanel>
                <!-- یادداشت — TextBox (چندخطی) · پهنای 12/۱۲ -->
                <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="12"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="یادداشت"
                               Style="{DynamicResource Input.Label}" />
                    <TextBox Style="{DynamicResource Input.TextBox}"
                             Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="88"
                             VerticalContentAlignment="Top"
                             Tag=""
                             />
                </StackPanel>
                <!-- ارسال پیامک یادآوری — CheckBox · پهنای 6/۱۲ -->
                <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="6"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <CheckBox Style="{DynamicResource Input.CheckBox}"
                              Content="ارسال پیامک یادآوری"
                              IsChecked="{Binding SendSms, Mode=TwoWay}" />
                </StackPanel>
                <!-- نوبت فوری — CheckBox · پهنای 6/۱۲ -->
                <StackPanel Grid.Row="6" Grid.Column="6" Grid.ColumnSpan="6"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <CheckBox Style="{DynamicResource Input.CheckBox}"
                              Content="نوبت فوری"
                              IsChecked="{Binding IsUrgent, Mode=TwoWay}" />
                </StackPanel>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
     ارتباطاتِ این صفحه با دیگر صفحات
     هر ردیف: «مبدأ» → «مقصد» با توضیحِ نوعِ پیوند
     این بلوک در همه‌ی صفحات حضور دارد تا مسیرِ حرکتِ کاربر گم نشود.
     ══════════════════════════════════════════════════════════ -->
            <Border Style="{DynamicResource Card.Flat}" Margin="0,{StaticResource S.3},0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,{StaticResource S.3}">
                        <Path Style="{DynamicResource Icon.Small}"
                              Data="{DynamicResource Icon.GitBranch}"
                               Stroke="{DynamicResource Brush.Primary}" />
                        <TextBlock Text="{loc:Loc Common.Relations}"
                                   Style="{DynamicResource Txt.Subtitle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource S.2},0,0,0" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Relations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,{StaticResource S.2}">
                                    <Border Style="{DynamicResource Badge.Neutral}">
                                        <TextBlock Text="{Binding From}"
                                                   Style="{DynamicResource Badge.Text}" />
                                    </Border>
                                        <Path Style="{DynamicResource Icon.XSmall}"
                                              Data="{DynamicResource Icon.ArrowLeft}"
                                               Stroke="{DynamicResource Brush.TextMuted}" />
                                    <Border Style="{DynamicResource Badge.Info}">
                                        <TextBlock Text="{Binding To}"
                                                   Style="{DynamicResource Badge.Text}" />
                                    </Border>
                                    <TextBlock Text="{Binding Why}"
                                               Style="{DynamicResource Txt.Caption}"
                                               VerticalAlignment="Center"
                                               Margin="{StaticResource S.2},0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ نوارِ اقدام‌های ثابت ═══ -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="{StaticResource S.4}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left">
                <Button Style="{DynamicResource Btn.Primary}"
                        Command="{Binding SaveCommand}"
                        Margin="0,0,{StaticResource S.2},0"
                        MinHeight="{StaticResource Size.ButtonHeight}"
                        Padding="{StaticResource P.Button}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{DynamicResource Icon.Small}"
                              Data="{DynamicResource Icon.Check}"
                              Margin="0,0,{StaticResource S.2},0" />
                        <TextBlock Text="ثبت نوبت" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource Btn.Ghost}"
                        Command="{Binding CancelCommand}"
                        Margin="0,0,{StaticResource S.2},0"
                        MinHeight="{StaticResource Size.ButtonHeight}"
                        Padding="{StaticResource P.Button}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="انصراف" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>

</Window>