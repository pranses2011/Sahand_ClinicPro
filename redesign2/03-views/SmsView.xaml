<!--
╔══════════════════════════════════════════════════════════════════════╗
║  پیامک — SmsView
╠══════════════════════════════════════════════════════════════════════╣
║  گروه        : ارتباطات
║  کهن‌الگو     : detail-tabs
║  ViewModel   : SmsViewModel
║  وایرفریم    : 01-wireframes-html/SmsView.html
╠══════════════════════════════════════════════════════════════════════╣
║  توضیح       : شمارندهٔ نویسه‌ها و هزینهٔ تخمینی زیر جعبهٔ متن؛ 
║                متغیرهای الگو با دکمه‌های درج خودکار.
╠══════════════════════════════════════════════════════════════════════╣
║  ساختار (اندازه‌ی هر فیلد/ستون بر پایه‌ی ۱۲ ستون است تا
║  «بزرگیِ عنصر متناسب با کارکردش» باشد — کد ملی ۳ ستون، نشانی ۱۲ ستون)
╠══════════════════════════════════════════════════════════════════════╣
║  نام              نوع              پهنا   الزامی
║  ─────────────────────────────────────────────────
║  ▸ ارسال پیامک
║    Recipients      ComboBox         6      بله
║    TemplateId      ComboBox         6      خیر
║    ManualNumbers   TextBox (چندخطی  6      خیر
║    Message         TextBox (چندخطی  12     بله
║    SendAt          DatePicker       6      خیر
║    Provider        ComboBox         6      خیر
║  ▸ ستون‌های جدول
║    Time            date             150px  Right
║    Recipient       who              170px  Right
║    Template        text             150px  Right
║    Cost            money            92px   Left
║    Status          chip             112px  Center
╠══════════════════════════════════════════════════════════════════════╣
║  ارتباطات این صفحه
║  ─────────────────────────────────────────────────
║    پیامک  ──▶  نوبت‌دهی
║         یادآوری نوبت
║    پیامک  ──▶  آزمایشگاه
║         اطلاع‌رسانی نتیجه
║    پیامک  ──▶  بیماران
║         دریافت‌کنندگان
╚══════════════════════════════════════════════════════════════════════╝

  قواعدِ رعایت‌شده در این فایل:
    • راست‌چین (RTL) و قلمِ وزیرمتن در سراسرِ صفحه
    • هیچ رنگِ ثابت (هگز) — همه از نشانه‌های معناییِ DynamicResource
    • الگوی MVVM: هیچ منطقی در code-behind، همه چیز از ViewModel
    • متن‌ها از فایلِ زبان (loc:Loc) برای پشتیبانیِ دو زبانهٔ آینده
    • تاریخ‌ها با تبدیل‌گرِ PersianDate به شمسی نمایش داده می‌شوند
    • نقشهٔ ارتباطات در پایینِ صفحه مسیرِ حرکت را نشان می‌دهد
-->

<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.SmsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        xmlns:loc="clr-namespace:Sahand.ClinicPro.Desktop.Localization"
        xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DesignHeight="820" d:DesignWidth="1280"
        d:DataContext="{d:DesignInstance vm:SmsViewModel}"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource Brush.Canvas}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ سربرگِ یکپارچه‌ی صفحه ═══ -->
        <ctrl:PageHeader Grid.Row="0"
                        Title="پیامک"
                        Subtitle="ارسال پیامک و مدیریت الگوها"
                        Icon="{DynamicResource Icon.MessageSquare}"
                        Margin="{StaticResource P.Page}" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="{StaticResource P.Page}">
            <StackPanel>
                <ctrl:StatCard Margin="{StaticResource S.3}"
                                  Title="ارسالی امروز"
                                  Value="۱۴۲"
                                  Trend="21"
                                  Icon="{DynamicResource Icon.Send}"
                                  Accent="{DynamicResource Brush.Primary}"
                                  />
                <ctrl:StatCard Margin="{StaticResource S.3}"
                                  Title="تحویل شده"
                                  Value="۱۳۶"
                                  Icon="{DynamicResource Icon.CircleCheck}"
                                  Accent="{DynamicResource Brush.Success}"
                                  />
                <ctrl:StatCard Margin="{StaticResource S.3}"
                                  Title="ناموفق"
                                  Value="۶"
                                  Trend="-2"
                                  Icon="{DynamicResource Icon.CircleX}"
                                  Accent="{DynamicResource Brush.Danger}"
                                  />
                <ctrl:StatCard Margin="{StaticResource S.3}"
                                  Title="هزینه امروز"
                                  Value="۴۲,۶۰۰"
                                  Icon="{DynamicResource Icon.Wallet}"
                                  Accent="{DynamicResource Brush.Warning}"
                                  />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- ── بخش: ارسال پیامک ── -->
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="12"
                        Margin="0,{StaticResource S.2},0,{StaticResource S.3}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{DynamicResource Icon.Small}"
                              Data="{DynamicResource Icon.Send}"
                               Stroke="{DynamicResource Brush.Primary}" />
                        <TextBlock Text="ارسال پیامک"
                                   Style="{DynamicResource Txt.Title}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource S.2},0,0,0" />
                    </StackPanel>
                </Border>
                <!-- گیرندگان — ComboBox · پهنای 6/۱۲ -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="گیرندگان"
                               Style="{DynamicResource Input.LabelRequired}" />
                    <ComboBox Style="{DynamicResource Input.ComboBox}"
                              SelectedItem="{Binding Recipients, Mode=TwoWay}">
                        <ComboBoxItem Content="بیماران امروز" IsSelected="True" />
                        <ComboBoxItem Content="بیماران هفته" />
                        <ComboBoxItem Content="پرسنل" />
                        <ComboBoxItem Content="همه بیماران" />
                        <ComboBoxItem Content="دستی" />
                    </ComboBox>
                    <!-- خطاهای اعتبارسنجی به‌صورت خودکار از INotifyDataErrorInfo نمایش داده می‌شوند -->
                </StackPanel>
                <!-- الگو — ComboBox · پهنای 6/۱۲ -->
                <StackPanel Grid.Row="1" Grid.Column="6" Grid.ColumnSpan="6"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="الگو"
                               Style="{DynamicResource Input.Label}" />
                    <ComboBox Style="{DynamicResource Input.ComboBox}"
                              SelectedItem="{Binding TemplateId, Mode=TwoWay}">
                    </ComboBox>
                </StackPanel>
                <!-- شماره‌های دستی — TextBox (چندخطی) · پهنای 6/۱۲ -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="6"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="شماره‌های دستی"
                               Style="{DynamicResource Input.Label}" />
                    <TextBox Style="{DynamicResource Input.TextBox}"
                             Text="{Binding ManualNumbers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="88"
                             VerticalContentAlignment="Top"
                             Tag=""
                             />
                </StackPanel>
                <!-- متن پیام — TextBox (چندخطی) · پهنای 12/۱۲ -->
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="12"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="متن پیام"
                               Style="{DynamicResource Input.LabelRequired}" />
                    <TextBox Style="{DynamicResource Input.TextBox}"
                             Text="{Binding Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="88"
                             VerticalContentAlignment="Top"
                             Tag=" بیمار گرامی، نوبت شما فردا ساعت ۱۰:۳۰ نزد دکتر موسوی است."
                             />
                    <!-- خطاهای اعتبارسنجی به‌صورت خودکار از INotifyDataErrorInfo نمایش داده می‌شوند -->
                </StackPanel>
                <!-- زمان ارسال — DatePicker · پهنای 6/۱۲ -->
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="6"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="زمان ارسال"
                               Style="{DynamicResource Input.Label}" />
                    <DatePicker Style="{DynamicResource Input.Date}"
                                SelectedDate="{Binding SendAt, Mode=TwoWay}"
                                SelectedDateFormat="Short" />
                </StackPanel>
                <!-- پنل ارسال — ComboBox · پهنای 6/۱۲ -->
                <StackPanel Grid.Row="4" Grid.Column="6" Grid.ColumnSpan="6"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="پنل ارسال"
                               Style="{DynamicResource Input.Label}" />
                    <ComboBox Style="{DynamicResource Input.ComboBox}"
                              SelectedItem="{Binding Provider, Mode=TwoWay}">
                        <ComboBoxItem Content="کاوه‌نگار" IsSelected="True" />
                        <ComboBoxItem Content="ملی‌پیامک" />
                        <ComboBoxItem Content="فراز‌اس‌ام‌اس" />
                    </ComboBox>
                </StackPanel>
            </Grid>

                    <TabControl Style="{DynamicResource Tab.Modern}">
                        <TabItem Style="{DynamicResource Tab.Item}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{DynamicResource Icon.Small}"
                                          Data="{DynamicResource Icon.Send}" />
                                    <TextBlock Text="ارسال جدید"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </TabItem.Header>
                            <!-- محتوای تب «ارسال جدید» در ViewModel تأمین می‌شود -->
                            <ContentControl Content="{Binding TabContents[0]}" />
                        </TabItem>
                        <TabItem Style="{DynamicResource Tab.Item}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{DynamicResource Icon.Small}"
                                          Data="{DynamicResource Icon.FileText}" />
                                    <TextBlock Text="الگوها"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </TabItem.Header>
                            <!-- محتوای تب «الگوها» در ViewModel تأمین می‌شود -->
                            <ContentControl Content="{Binding TabContents[1]}" />
                        </TabItem>
                        <TabItem Style="{DynamicResource Tab.Item}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{DynamicResource Icon.Small}"
                                          Data="{DynamicResource Icon.ChartBar}" />
                                    <TextBlock Text="گزارش ارسال"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </TabItem.Header>
                            <!-- محتوای تب «گزارش ارسال» در ViewModel تأمین می‌شود -->
                            <ContentControl Content="{Binding TabContents[2]}" />
                        </TabItem>
                        <TabItem Style="{DynamicResource Tab.Item}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{DynamicResource Icon.Small}"
                                          Data="{DynamicResource Icon.Settings}" />
                                    <TextBlock Text="تنظیمات پنل"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </TabItem.Header>
                            <!-- محتوای تب «تنظیمات پنل» در ViewModel تأمین می‌شود -->
                            <ContentControl Content="{Binding TabContents[3]}" />
                        </TabItem>
                    </TabControl>

                    <DataGrid Style="{DynamicResource Grid.Modern}"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              RowHeight="{StaticResource Size.RowHeight}"
                              FlowDirection="RightToLeft">
                        <DataGrid.Columns>
                            <!-- زمان — نوع: date -->
                            <DataGridTextColumn Header="زمان" Width="150" Binding="{Binding Time, Converter={StaticResource PersianDate}}" />
                            <!-- گیرنده — نوع: who -->
                            <DataGridTemplateColumn Header="گیرنده" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- نشانِ تصویریِ بیمار/کاربر -->
                                            <Border Width="30" Height="30"
                                                    CornerRadius="{StaticResource R.Pill}"
                                                    Background="{Binding RecipientAvatar}"
                                                    Margin="0,0,{StaticResource S.2},0">
                                                <TextBlock Text="{Binding RecipientInitials}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.OnPrimary}"
                                                           FontSize="{StaticResource Fs.Caption}" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Recipient}"
                                                           Style="{DynamicResource Txt.Body}" />
                                                <TextBlock Text="{Binding RecipientSub}"
                                                           Style="{DynamicResource Txt.Caption}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- الگو — نوع: text -->
                            <DataGridTextColumn Header="الگو"
                                                Binding="{Binding Template}"
                                                Width="150"
                                                ElementStyle="{DynamicResource Txt.Body}" />
                            <!-- هزینه — نوع: money -->
                            <DataGridTextColumn Header="هزینه" Width="92" Binding="{Binding Cost}"
                                                ElementStyle="{DynamicResource Txt.Numeric}">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource Grid.Header}">
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <!-- وضعیت — نوع: chip -->
                            <DataGridTemplateColumn Header="وضعیت" Width="112">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource Badge}"
                                                HorizontalAlignment="Center"
                                                Background="{Binding StatusTone, Converter={StaticResource StatusTone}}">
                                            <TextBlock Text="{Binding Status}"
                                                       Style="{DynamicResource Badge.Text}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ctrl:EmptyState Icon="{DynamicResource Icon.MessageSquare}"
                                      Title="{loc:Loc Common.EmptyTitle}"
                                      Message="{loc:Loc Common.EmptyMessage}"
                                      Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            <!-- ══════════════════════════════════════════════════════════
     ارتباطاتِ این صفحه با دیگر صفحات
     هر ردیف: «مبدأ» → «مقصد» با توضیحِ نوعِ پیوند
     این بلوک در همه‌ی صفحات حضور دارد تا مسیرِ حرکتِ کاربر گم نشود.
     ══════════════════════════════════════════════════════════ -->
            <Border Style="{DynamicResource Card.Flat}" Margin="0,{StaticResource S.3},0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,{StaticResource S.3}">
                        <Path Style="{DynamicResource Icon.Small}"
                              Data="{DynamicResource Icon.GitBranch}"
                               Stroke="{DynamicResource Brush.Primary}" />
                        <TextBlock Text="{loc:Loc Common.Relations}"
                                   Style="{DynamicResource Txt.Subtitle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource S.2},0,0,0" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Relations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,{StaticResource S.2}">
                                    <Border Style="{DynamicResource Badge.Neutral}">
                                        <TextBlock Text="{Binding From}"
                                                   Style="{DynamicResource Badge.Text}" />
                                    </Border>
                                        <Path Style="{DynamicResource Icon.XSmall}"
                                              Data="{DynamicResource Icon.ArrowLeft}"
                                               Stroke="{DynamicResource Brush.TextMuted}" />
                                    <Border Style="{DynamicResource Badge.Info}">
                                        <TextBlock Text="{Binding To}"
                                                   Style="{DynamicResource Badge.Text}" />
                                    </Border>
                                    <TextBlock Text="{Binding Why}"
                                               Style="{DynamicResource Txt.Caption}"
                                               VerticalAlignment="Center"
                                               Margin="{StaticResource S.2},0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>