<!--
╔══════════════════════════════════════════════════════════════════════╗
║  پرداخت — PaymentWindow
╠══════════════════════════════════════════════════════════════════════╣
║  گروه        : پذیرش
║  کهن‌الگو     : form-narrow
║  ViewModel   : PaymentViewModel
║  وایرفریم    : 01-wireframes-html/PaymentWindow.html
╠══════════════════════════════════════════════════════════════════════╣
║  ساختار (اندازه‌ی هر فیلد/ستون بر پایه‌ی ۱۲ ستون است تا
║  «بزرگیِ عنصر متناسب با کارکردش» باشد — کد ملی ۳ ستون، نشانی ۱۲ ستون)
╠══════════════════════════════════════════════════════════════════════╣
║  نام              نوع              پهنا   الزامی
║  ─────────────────────────────────────────────────
║  ▸ پرداخت
║    PatientId       ComboBox         12     بله
║    Amount          TextBox          6      بله
║    PayMethod       ComboBox         6      بله
║    Ref             TextBox          12     خیر
║    Notes           TextBox (چندخطی  12     خیر
╠══════════════════════════════════════════════════════════════════════╣
║  ارتباطات این صفحه
║  ─────────────────────────────────────────────────
╚══════════════════════════════════════════════════════════════════════╝

  قواعدِ رعایت‌شده در این فایل:
    • راست‌چین (RTL) و قلمِ وزیرمتن در سراسرِ صفحه
    • هیچ رنگِ ثابت (هگز) — همه از نشانه‌های معناییِ DynamicResource
    • الگوی MVVM: هیچ منطقی در code-behind، همه چیز از ViewModel
    • متن‌ها از فایلِ زبان (loc:Loc) برای پشتیبانیِ دو زبانهٔ آینده
    • تاریخ‌ها با تبدیل‌گرِ PersianDate به شمسی نمایش داده می‌شوند
    • نقشهٔ ارتباطات در پایینِ صفحه مسیرِ حرکت را نشان می‌دهد
-->

<Window x:Class="Sahand.ClinicPro.Desktop.Views.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        xmlns:loc="clr-namespace:Sahand.ClinicPro.Desktop.Localization"
        xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="پرداخت"
        Style="{DynamicResource Window.Modern}"
        WindowStartupLocation="CenterScreen"
        Height="720" Width="520"
        d:DataContext="{d:DesignInstance vm:PaymentViewModel}"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource Brush.Canvas}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ سربرگِ یکپارچه‌ی صفحه ═══ -->
        <ctrl:PageHeader Grid.Row="0"
                        Title="پرداخت"
                        Subtitle="ثبت پرداخت برای بیمار"
                        Icon="{DynamicResource Icon.CreditCard}"
                        Margin="{StaticResource P.Page}" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="{StaticResource P.Page}">
            <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- ── بخش: پرداخت ── -->
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="12"
                        Margin="0,{StaticResource S.2},0,{StaticResource S.3}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{DynamicResource Icon.Small}"
                              Data="{DynamicResource Icon.CreditCard}"
                               Stroke="{DynamicResource Brush.Primary}" />
                        <TextBlock Text="پرداخت"
                                   Style="{DynamicResource Txt.Title}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource S.2},0,0,0" />
                    </StackPanel>
                </Border>
                <!-- بیمار — ComboBox · پهنای 12/۱۲ -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="12"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="بیمار"
                               Style="{DynamicResource Input.LabelRequired}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  Style="{DynamicResource Input.ComboBox}"
                                  IsEditable="True"
                                  Text="{Binding PatientId, Mode=TwoWay}" />
                        <Button Grid.Column="1"
                                Style="{DynamicResource Btn.Icon}"
                                Command="{Binding LookupPatientIdCommand}"
                                Margin="{StaticResource S.2},0,0,0"
                                ToolTip="{loc:Loc Common.Search}">
                            <Path Style="{DynamicResource Icon.Small}"
                                  Data="{DynamicResource Icon.Search}" />
                        </Button>
                    </Grid>
                    <!-- خطاهای اعتبارسنجی به‌صورت خودکار از INotifyDataErrorInfo نمایش داده می‌شوند -->
                </StackPanel>
                <!-- مبلغ — TextBox · پهنای 6/۱۲ -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="6"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="مبلغ"
                               Style="{DynamicResource Input.LabelRequired}" />
                    <TextBox Style="{DynamicResource Input.TextBox}"
                             Text="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Left"
                             FlowDirection="LeftToRight" />
                    <!-- خطاهای اعتبارسنجی به‌صورت خودکار از INotifyDataErrorInfo نمایش داده می‌شوند -->
                </StackPanel>
                <!-- شیوه پرداخت — ComboBox · پهنای 6/۱۲ -->
                <StackPanel Grid.Row="2" Grid.Column="6" Grid.ColumnSpan="6"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="شیوه پرداخت"
                               Style="{DynamicResource Input.LabelRequired}" />
                    <ComboBox Style="{DynamicResource Input.ComboBox}"
                              SelectedItem="{Binding PayMethod, Mode=TwoWay}">
                        <ComboBoxItem Content="نقد" />
                        <ComboBoxItem Content="کارت‌خوان" IsSelected="True" />
                        <ComboBoxItem Content="کارت به کارت" />
                    </ComboBox>
                    <!-- خطاهای اعتبارسنجی به‌صورت خودکار از INotifyDataErrorInfo نمایش داده می‌شوند -->
                </StackPanel>
                <!-- شماره پیگیری — TextBox · پهنای 12/۱۲ -->
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="12"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="شماره پیگیری"
                               Style="{DynamicResource Input.Label}" />
                    <TextBox Style="{DynamicResource Input.TextBox}"
                             Text="{Binding Ref, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Tag="۱۲۳۴۵۶"
                             />
                </StackPanel>
                <!-- توضیحات — TextBox (چندخطی) · پهنای 12/۱۲ -->
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="12"
                            Margin="0,0,{StaticResource S.3},{StaticResource S.3}">
                    <TextBlock Text="توضیحات"
                               Style="{DynamicResource Input.Label}" />
                    <TextBox Style="{DynamicResource Input.TextBox}"
                             Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="88"
                             VerticalContentAlignment="Top"
                             Tag=""
                             />
                </StackPanel>
            </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ نوارِ اقدام‌های ثابت ═══ -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="{StaticResource S.4}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left">
                <Button Style="{DynamicResource Btn.Primary}"
                        Command="{Binding SaveCommand}"
                        Margin="0,0,{StaticResource S.2},0"
                        MinHeight="{StaticResource Size.ButtonHeight}"
                        Padding="{StaticResource P.Button}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{DynamicResource Icon.Small}"
                              Data="{DynamicResource Icon.Check}"
                              Margin="0,0,{StaticResource S.2},0" />
                        <TextBlock Text="ثبت" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource Btn.Ghost}"
                        Command="{Binding CancelCommand}"
                        Margin="0,0,{StaticResource S.2},0"
                        MinHeight="{StaticResource Size.ButtonHeight}"
                        Padding="{StaticResource P.Button}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="انصراف" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>

</Window>