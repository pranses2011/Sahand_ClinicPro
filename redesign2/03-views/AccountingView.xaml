<!--
╔══════════════════════════════════════════════════════════════════════╗
║  حسابداری — AccountingView
╠══════════════════════════════════════════════════════════════════════╣
║  گروه        : مالی
║  کهن‌الگو     : split
║  ViewModel   : AccountingViewModel
║  وایرفریم    : 01-wireframes-html/AccountingView.html
╠══════════════════════════════════════════════════════════════════════╣
║  توضیح       : قانون طلایی حسابداری دوبل: جمع بدهکار باید برابر با 
║                جمع بستانکار باشد؛ سند نامتوازن هرگز ذخیره نمی‌شود.
╠══════════════════════════════════════════════════════════════════════╣
║  ساختار (اندازه‌ی هر فیلد/ستون بر پایه‌ی ۱۲ ستون است تا
║  «بزرگیِ عنصر متناسب با کارکردش» باشد — کد ملی ۳ ستون، نشانی ۱۲ ستون)
╠══════════════════════════════════════════════════════════════════════╣
║  نام              نوع              پهنا   الزامی
║  ─────────────────────────────────────────────────
║  ▸ ستون‌های جدول
║    No              text             104px  Right
║    Date            date             112px  Right
║    Desc            text             *      Right
║    Debit           money            124px  Left
║    Credit          money            124px  Left
║    Status          chip             112px  Center
╠══════════════════════════════════════════════════════════════════════╣
║  ارتباطات این صفحه
║  ─────────────────────────────────────────────────
║    حسابداری  ──▶  جزئیات سند حسابداری
║         سطرهای سند
║    حسابداری  ──▶  صورتحساب
║         سند خودکارِ فاکتور
║    حسابداری  ──▶  حقوق و دستمزد
║         سند حقوق
╚══════════════════════════════════════════════════════════════════════╝

  قواعدِ رعایت‌شده در این فایل:
    • راست‌چین (RTL) و قلمِ وزیرمتن در سراسرِ صفحه
    • هیچ رنگِ ثابت (هگز) — همه از نشانه‌های معناییِ DynamicResource
    • الگوی MVVM: هیچ منطقی در code-behind، همه چیز از ViewModel
    • متن‌ها از فایلِ زبان (loc:Loc) برای پشتیبانیِ دو زبانهٔ آینده
    • تاریخ‌ها با تبدیل‌گرِ PersianDate به شمسی نمایش داده می‌شوند
    • نقشهٔ ارتباطات در پایینِ صفحه مسیرِ حرکت را نشان می‌دهد
-->

<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.AccountingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        xmlns:loc="clr-namespace:Sahand.ClinicPro.Desktop.Localization"
        xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DesignHeight="820" d:DesignWidth="1280"
        d:DataContext="{d:DesignInstance vm:AccountingViewModel}"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource Brush.Canvas}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ سربرگِ یکپارچه‌ی صفحه ═══ -->
        <ctrl:PageHeader Grid.Row="0"
                        Title="حسابداری"
                        Subtitle="درخت سرفصل‌ها و اسناد حسابداری دوبل"
                        Icon="{DynamicResource Icon.Calculator}"
                        Margin="{StaticResource P.Page}" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="{StaticResource P.Page}">
            <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
            <ItemsControl ItemsSource="{Binding Kpis}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ctrl:StatCard Margin="{StaticResource S.3}"
                                      Title="{Binding Title}"
                                      Value="{Binding Value}"
                                      Trend="{Binding Trend}"
                                      Icon="{Binding Icon}"
                                      Accent="{Binding Accent}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{DynamicResource Card.Flat}"
                    Padding="{StaticResource S.3}"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- جستجو -->
                    <StackPanel Margin="0,0,{StaticResource S.3},0">
                        <TextBlock Text="جستجو"
                                   Style="{DynamicResource Input.Label}" />
                        <ctrl:SearchBox Width="260"
                                        Text="{Binding SearchText, Mode=TwoWay}"
                                        Placeholder="شماره سند یا شرح…" />
                    </StackPanel>
                    <!-- از تاریخ -->
                    <StackPanel Margin="0,0,{StaticResource S.3},0">
                        <TextBlock Text="از تاریخ"
                                   Style="{DynamicResource Input.Label}" />
                        <DatePicker Width="160"
                                    Style="{DynamicResource Input.Date}"
                                    SelectedDate="{Binding Filter2, Mode=TwoWay}" />
                    </StackPanel>
                    <!-- تا تاریخ -->
                    <StackPanel Margin="0,0,{StaticResource S.3},0">
                        <TextBlock Text="تا تاریخ"
                                   Style="{DynamicResource Input.Label}" />
                        <DatePicker Width="160"
                                    Style="{DynamicResource Input.Date}"
                                    SelectedDate="{Binding Filter3, Mode=TwoWay}" />
                    </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Left">
                    <Button Style="{DynamicResource Btn.Primary}"
                            Command="{Binding NewCommand}"
                            Margin="0,0,{StaticResource S.2},0"
                            MinHeight="{StaticResource Size.ButtonHeight}"
                            Padding="{StaticResource P.Button}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{DynamicResource Icon.Small}"
                                  Data="{DynamicResource Icon.Plus}"
                                  Margin="0,0,{StaticResource S.2},0" />
                            <TextBlock Text="سند جدید" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource Btn.Secondary}"
                            Command="{Binding DetailCommand}"
                            Margin="0,0,{StaticResource S.2},0"
                            MinHeight="{StaticResource Size.ButtonHeight}"
                            Padding="{StaticResource P.Button}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{DynamicResource Icon.Small}"
                                  Data="{DynamicResource Icon.Eye}"
                                  Margin="0,0,{StaticResource S.2},0" />
                            <TextBlock Text="جزئیات سند" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource Btn.Secondary}"
                            Command="{Binding TrialCommand}"
                            Margin="0,0,{StaticResource S.2},0"
                            MinHeight="{StaticResource Size.ButtonHeight}"
                            Padding="{StaticResource P.Button}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{DynamicResource Icon.Small}"
                                  Data="{DynamicResource Icon.Scale}"
                                  Margin="0,0,{StaticResource S.2},0" />
                            <TextBlock Text="تراز آزمایشی" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource Btn.Secondary}"
                            Command="{Binding ExportCommand}"
                            Margin="0,0,{StaticResource S.2},0"
                            MinHeight="{StaticResource Size.ButtonHeight}"
                            Padding="{StaticResource P.Button}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{DynamicResource Icon.Small}"
                                  Data="{DynamicResource Icon.FileSpreadsheet}"
                                  Margin="0,0,{StaticResource S.2},0" />
                            <TextBlock Text="خروجی" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    </StackPanel>
                </Grid>
            </Border>

                    <DataGrid Style="{DynamicResource Grid.Modern}"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              RowHeight="{StaticResource Size.RowHeight}"
                              FlowDirection="RightToLeft">
                        <DataGrid.Columns>
                            <!-- شماره سند — نوع: text -->
                            <DataGridTextColumn Header="شماره سند"
                                                Binding="{Binding No}"
                                                Width="104"
                                                ElementStyle="{DynamicResource Txt.Body}" />
                            <!-- تاریخ — نوع: date -->
                            <DataGridTextColumn Header="تاریخ" Width="112" Binding="{Binding Date, Converter={StaticResource PersianDate}}" />
                            <!-- شرح — نوع: text -->
                            <DataGridTextColumn Header="شرح"
                                                Binding="{Binding Desc}"
                                                Width="*"
                                                ElementStyle="{DynamicResource Txt.Body}" />
                            <!-- بدهکار — نوع: money -->
                            <DataGridTextColumn Header="بدهکار" Width="124" Binding="{Binding Debit}"
                                                ElementStyle="{DynamicResource Txt.Numeric}">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource Grid.Header}">
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <!-- بستانکار — نوع: money -->
                            <DataGridTextColumn Header="بستانکار" Width="124" Binding="{Binding Credit}"
                                                ElementStyle="{DynamicResource Txt.Numeric}">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource Grid.Header}">
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <!-- وضعیت — نوع: chip -->
                            <DataGridTemplateColumn Header="وضعیت" Width="112">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource Badge}"
                                                HorizontalAlignment="Center"
                                                Background="{Binding StatusTone, Converter={StaticResource StatusTone}}">
                                            <TextBlock Text="{Binding Status}"
                                                       Style="{DynamicResource Badge.Text}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ctrl:EmptyState Icon="{DynamicResource Icon.Calculator}"
                                      Title="{loc:Loc Common.EmptyTitle}"
                                      Message="{loc:Loc Common.EmptyMessage}"
                                      Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    <Border Style="{DynamicResource Card.Flat}"
                            Padding="{StaticResource S.3}"
                            Margin="0,{StaticResource S.3},0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding PageSummary}"
                                       Style="{DynamicResource Txt.Caption}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{DynamicResource Btn.Icon}"
                                        Command="{Binding PreviousPageCommand}"
                                        ToolTip="{loc:Loc Common.Previous}">
                                    <Path Style="{DynamicResource Icon.Small}"
                                          Data="{DynamicResource Icon.ChevronRight}" />
                                </Button>
                                <Button Style="{DynamicResource Btn.Icon}"
                                        Command="{Binding NextPageCommand}"
                                        ToolTip="{loc:Loc Common.Next}">
                                    <Path Style="{DynamicResource Icon.Small}"
                                          Data="{DynamicResource Icon.ChevronLeft}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
                <Border Style="{DynamicResource Card}"
                        MinWidth="300"
                        Margin="{StaticResource S.3},0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,{StaticResource S.3}">
                            <Path Style="{DynamicResource Icon.Medium}"
                                  Data="{DynamicResource Icon.GitFork}"
                                   Stroke="{DynamicResource Brush.Primary}" />
                            <TextBlock Text="درخت سرفصل‌ها"
                                       Style="{DynamicResource Txt.Subtitle}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <Grid Margin="0,0,0,{StaticResource S.2}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="۱ — دارایی‌ها"
                                       Style="{DynamicResource Txt.Caption}"
                                       Margin="0,0,{StaticResource S.3},0" />
                            <TextBlock Grid.Column="1" Text="۱,۲۴۰,۰۰۰,۰۰۰"
                                       Style="{DynamicResource Txt.Body}"
                                       TextAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,{StaticResource S.2}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="۲ — بدهی‌ها"
                                       Style="{DynamicResource Txt.Caption}"
                                       Margin="0,0,{StaticResource S.3},0" />
                            <TextBlock Grid.Column="1" Text="۴۱۸,۰۰۰,۰۰۰"
                                       Style="{DynamicResource Txt.Body}"
                                       TextAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,{StaticResource S.2}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="۳ — سرمایه"
                                       Style="{DynamicResource Txt.Caption}"
                                       Margin="0,0,{StaticResource S.3},0" />
                            <TextBlock Grid.Column="1" Text="۶۸۰,۰۰۰,۰۰۰"
                                       Style="{DynamicResource Txt.Body}"
                                       TextAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,{StaticResource S.2}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="۴ — درآمدها"
                                       Style="{DynamicResource Txt.Caption}"
                                       Margin="0,0,{StaticResource S.3},0" />
                            <TextBlock Grid.Column="1" Text="۴۲۸,۰۰۰,۰۰۰"
                                       Style="{DynamicResource Txt.Body}"
                                       TextAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,{StaticResource S.2}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="۵ — هزینه‌ها"
                                       Style="{DynamicResource Txt.Caption}"
                                       Margin="0,0,{StaticResource S.3},0" />
                            <TextBlock Grid.Column="1" Text="۲۹۱,۰۰۰,۰۰۰"
                                       Style="{DynamicResource Txt.Body}"
                                       TextAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- ══════════════════════════════════════════════════════════
     ارتباطاتِ این صفحه با دیگر صفحات
     هر ردیف: «مبدأ» → «مقصد» با توضیحِ نوعِ پیوند
     این بلوک در همه‌ی صفحات حضور دارد تا مسیرِ حرکتِ کاربر گم نشود.
     ══════════════════════════════════════════════════════════ -->
            <Border Style="{DynamicResource Card.Flat}" Margin="0,{StaticResource S.3},0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,{StaticResource S.3}">
                        <Path Style="{DynamicResource Icon.Small}"
                              Data="{DynamicResource Icon.GitBranch}"
                               Stroke="{DynamicResource Brush.Primary}" />
                        <TextBlock Text="{loc:Loc Common.Relations}"
                                   Style="{DynamicResource Txt.Subtitle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource S.2},0,0,0" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Relations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,{StaticResource S.2}">
                                    <Border Style="{DynamicResource Badge.Neutral}">
                                        <TextBlock Text="{Binding From}"
                                                   Style="{DynamicResource Badge.Text}" />
                                    </Border>
                                        <Path Style="{DynamicResource Icon.XSmall}"
                                              Data="{DynamicResource Icon.ArrowLeft}"
                                               Stroke="{DynamicResource Brush.TextMuted}" />
                                    <Border Style="{DynamicResource Badge.Info}">
                                        <TextBlock Text="{Binding To}"
                                                   Style="{DynamicResource Badge.Text}" />
                                    </Border>
                                    <TextBlock Text="{Binding Why}"
                                               Style="{DynamicResource Txt.Caption}"
                                               VerticalAlignment="Center"
                                               Margin="{StaticResource S.2},0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>