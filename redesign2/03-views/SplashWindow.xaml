<!--
╔══════════════════════════════════════════════════════════════════════╗
║  در حال بارگذاری — SplashWindow
╠══════════════════════════════════════════════════════════════════════╣
║  گروه        : پیشخوان
║  کهن‌الگو     : splash
║  ViewModel   : SplashViewModel
║  وایرفریم    : 01-wireframes-html/SplashWindow.html
╠══════════════════════════════════════════════════════════════════════╣
║  توضیح       : نشان برنامه با حلقهٔ پیشرفت و نوار وضعیتِ مرحله‌ای (در 
║                حال اتصال… ← بارگذاری تنظیمات… ← آماده).
╠══════════════════════════════════════════════════════════════════════╣
║  ساختار (اندازه‌ی هر فیلد/ستون بر پایه‌ی ۱۲ ستون است تا
║  «بزرگیِ عنصر متناسب با کارکردش» باشد — کد ملی ۳ ستون، نشانی ۱۲ ستون)
╠══════════════════════════════════════════════════════════════════════╣
║  نام              نوع              پهنا   الزامی
║  ─────────────────────────────────────────────────
╠══════════════════════════════════════════════════════════════════════╣
║  ارتباطات این صفحه
║  ─────────────────────────────────────────────────
╚══════════════════════════════════════════════════════════════════════╝

  قواعدِ رعایت‌شده در این فایل:
    • راست‌چین (RTL) و قلمِ وزیرمتن در سراسرِ صفحه
    • هیچ رنگِ ثابت (هگز) — همه از نشانه‌های معناییِ DynamicResource
    • الگوی MVVM: هیچ منطقی در code-behind، همه چیز از ViewModel
    • متن‌ها از فایلِ زبان (loc:Loc) برای پشتیبانیِ دو زبانهٔ آینده
    • تاریخ‌ها با تبدیل‌گرِ PersianDate به شمسی نمایش داده می‌شوند
    • نقشهٔ ارتباطات در پایینِ صفحه مسیرِ حرکت را نشان می‌دهد
-->

<Window x:Class="Sahand.ClinicPro.Desktop.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        xmlns:loc="clr-namespace:Sahand.ClinicPro.Desktop.Localization"
        xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="در حال بارگذاری"
        Style="{DynamicResource Window.Modern}"
        WindowStartupLocation="CenterScreen"
        Height="420" Width="560"
        ResizeMode="NoResize" WindowStyle="None"
        d:DataContext="{d:DesignInstance vm:SplashViewModel}"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource Brush.Canvas}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ سربرگِ یکپارچه‌ی صفحه ═══ -->
        <ctrl:PageHeader Grid.Row="0"
                        Title="در حال بارگذاری"
                        Subtitle="صفحه آغازین برنامه"
                        Icon="{DynamicResource Icon.Loader}"
                        Margin="{StaticResource P.Page}" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="{StaticResource P.Page}">
            <StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Style="{DynamicResource Icon.Display}"
                      Data="{DynamicResource Icon.HeartPulse}"
                      Width="72" Height="72"
                      Stroke="{DynamicResource Brush.Primary}"
                      StrokeThickness="1.5"
                      HorizontalAlignment="Center" />
                <TextBlock Text="{Binding AppName}"
                           Style="{DynamicResource Txt.Display}"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,4" />
                <TextBlock Text="{Binding AppTagline}"
                           Style="{DynamicResource Txt.Caption}"
                           HorizontalAlignment="Center" />
                <ProgressBar IsIndeterminate="True"
                             Width="220" Height="4"
                             Margin="0,24,0,0" />
                <TextBlock Text="{Binding StatusText}"
                           Style="{DynamicResource Txt.Caption}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ نوارِ اقدام‌های ثابت ═══ -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="{StaticResource S.4}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left">

            </StackPanel>
        </Border>
    </Grid>

</Window>