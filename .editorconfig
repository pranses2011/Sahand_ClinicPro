# ═══════════════════════════════════════════════════════════════════
# قواعد سبک کد پروژه Sahand ClinicPro - سامانه جامع درمانگاه سهند
# قانون طلایی پروژه: کد به انگلیسی، کامنت‌ها و مستندات به فارسی
# ═══════════════════════════════════════════════════════════════════
root = true

# ── قواعد عمومی همه فایل‌ها ──
[*]
charset = utf-8-bom
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets,xml,razor}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,sh}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# ── قواعد اختصاصی C# ──
[*.cs]
# namespace در یک خط (file-scoped) مطابق C# 12
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:silent
csharp_prefer_braces = true:suggestion
# using های System همیشه اول بیایند
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# ── قواعد نام‌گذاری ──
# اینترفیس‌ها با پیشوند I و سبک PascalCase
dotnet_naming_rule.interface_names_must_start_with_I.symbols = interfaces
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_rule.interface_names_must_start_with_I.style = pascal_case_with_i_prefix
dotnet_naming_rule.interface_names_must_start_with_I.severity = suggestion
dotnet_naming_style.pascal_case_with_i_prefix.required_prefix = I
dotnet_naming_style.pascal_case_with_i_prefix.capitalization = pascal_case

# فیلدهای خصوصی با پیشوند _ و سبک camelCase
dotnet_naming_rule.private_fields_with_underscore.symbols = private_fields
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_rule.private_fields_with_underscore.style = camel_case_with_underscore
dotnet_naming_rule.private_fields_with_underscore.severity = suggestion
dotnet_naming_style.camel_case_with_underscore.required_prefix = _
dotnet_naming_style.camel_case_with_underscore.capitalization = camel_case
