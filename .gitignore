# ============================================================
# ⚠️ قواعد امنیتی الزامی پروژه Sahand_ClinicPro
# هیچ Secret یا کلیدی هرگز در Git ذخیره نمی‌شود
# از appsettings.template.json به عنوان الگو استفاده کنید
# برای Development از User Secrets استفاده شود:
#   dotnet user-secrets set "..." "..."
# ============================================================

# فایل‌های تنظیمات حاوی مقادیر واقعی (فقط نسخه template نگه داشته می‌شود)
appsettings.*.json
!appsettings.template.json
appsettings.local.json
*.secret.json
secrets.json
user.secrets.json

# کلیدها و گواهی‌ها
*.pfx
*.p12
*.pem
*.key
*.snk
*.pubxml
id_rsa*
*.jks
LicensePrivateKey.xml
*.lic
*.req

# فایل‌های لایسنس تولیدی محلی (خروجی تست فعال‌سازی)
license-request.req
activation-response.lic

# ---------- Logs / Serilog / Seq ----------
*.log
logs/
Serilog/
seq-data/

# ---------- Hangfire ----------
hangfire*.db*
Jobs/

# ---------- Backups محلی ----------
Backups/
*.zip
*.7z
!docs/**/*.zip

# ---------- Rider / ReSharper ----------
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# ----------点击 TeamX / SVN ----------
*.svn/
*.git-version

# ---------- AI Tools فایل‌های لوکال ----------
.claude/
.agent/
*.prompt-tmp.md

# فایل‌های موقت مولد اسکرین‌شات
scripts/_mockups/
scripts/_mockups13/

# ═══ چرخه دوازدهم (D2): آرشیو LicensePortal — فقط تاریخچه، بدون بیلد/توسعه ═══
src/Sahand.ClinicPro.LicensePortal/

# پوشه‌های کش پایتون
__pycache__/
*.pyc
