<Window x:Class="Sahand.ClinicPro.Desktop.Views.DicomViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Sahand.ClinicPro.Desktop.Controls;assembly=Sahand.ClinicPro.Desktop"
    xmlns:loc="clr-namespace:Sahand.ClinicPro.Desktop.Localization;assembly=Sahand.ClinicPro.Desktop"
    xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels.Redesign;assembly=Sahand.ClinicPro.Desktop"
    mc:Ignorable="d"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DataContext="{d:DesignInstance Type=vm:DicomViewerViewModel}"
    SnapsToDevicePixels="True"
    Title="{loc:Loc DicomViewer.Title}"
    Style="{DynamicResource Window.Modern}"
    FlowDirection="RightToLeft">

    <!--
    ═══════════════════════════════════════════════════════════════════════
      🖼 نمایشگر تصاویر پزشکی  —  بازطراحی شده
    ═══════════════════════════════════════════════════════════════════════
      • تمام رنگ‌ها از Tokens.xaml و با DynamicResource دریافت می‌شوند
        → تعویض تمِ روشن/تاریک در لحظه بدون تغییر این فایل
      • تمام متن‌ها از Strings.resx از طریق {loc:Loc} دریافت می‌شوند
        → افزودن زبان جدید بدون تغییر این فایل
      • وایرفریم مرجع:  02-wireframes-md/DicomViewerWindow.md
        وایرفریم گرافیکی: 01-wireframes-html/DicomViewerWindow.html
    ═══════════════════════════════════════════════════════════════════════
    -->

    <Grid Background="{DynamicResource Brush.Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 🛠 نوار ابزار -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1" Padding="12">
            <StackPanel Orientation="Horizontal">
                <Button Style="{DynamicResource Btn.Ghost}"
                        Content="{loc:Loc DicomViewer.Act_ZoomIn}"
                        Command="{Binding ZoomInCommand}"
                        MinHeight="{DynamicResource Size.ButtonHeight}" />
                <Button Style="{DynamicResource Btn.Ghost}"
                        Content="{loc:Loc DicomViewer.Act_ZoomOut}"
                        Command="{Binding ZoomOutCommand}"
                        MinHeight="{DynamicResource Size.ButtonHeight}" />
                <Button Style="{DynamicResource Btn.Ghost}"
                        Content="{loc:Loc DicomViewer.Act_Pan}"
                        Command="{Binding PanCommand}"
                        MinHeight="{DynamicResource Size.ButtonHeight}" />
                <Button Style="{DynamicResource Btn.Ghost}"
                        Content="{loc:Loc DicomViewer.Act_Measure}"
                        Command="{Binding MeasureCommand}"
                        MinHeight="{DynamicResource Size.ButtonHeight}" />
                <Button Style="{DynamicResource Btn.Ghost}"
                        Content="{loc:Loc DicomViewer.Act_WindowLevel}"
                        Command="{Binding WindowLevelCommand}"
                        MinHeight="{DynamicResource Size.ButtonHeight}" />
                <Button Style="{DynamicResource Btn.Primary}"
                        Content="{loc:Loc DicomViewer.Act_Report}"
                        Command="{Binding ReportCommand}"
                        MinHeight="{DynamicResource Size.ButtonHeight}" />
            </StackPanel>
        </Border>

        <!-- 🖼 ناحیه‌ی تصویر -->
        <Border Grid.Row="1" Margin="12" Style="{DynamicResource Card}"
                ClipToBounds="True">
            <Image Source="{Binding CurrentImage}" Stretch="Uniform" />
        </Border>
    </Grid>

</Window>
