<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.AccountingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Sahand.ClinicPro.Desktop.Controls;assembly=Sahand.ClinicPro.Desktop"
    xmlns:loc="clr-namespace:Sahand.ClinicPro.Desktop.Localization;assembly=Sahand.ClinicPro.Desktop"
    xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels.Redesign;assembly=Sahand.ClinicPro.Desktop"
    mc:Ignorable="d"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DataContext="{d:DesignInstance Type=vm:AccountingViewModel}"
    SnapsToDevicePixels="True"
    Style="{DynamicResource Page.Modern}"
    FlowDirection="RightToLeft">

    <!--
    ═══════════════════════════════════════════════════════════════════════
      📒 حسابداری  —  بازطراحی شده
    ═══════════════════════════════════════════════════════════════════════
      • تمام رنگ‌ها از Tokens.xaml و با DynamicResource دریافت می‌شوند
        → تعویض تمِ روشن/تاریک در لحظه بدون تغییر این فایل
      • تمام متن‌ها از Strings.resx از طریق {loc:Loc} دریافت می‌شوند
        → افزودن زبان جدید بدون تغییر این فایل
      • وایرفریم مرجع:  02-wireframes-md/AccountingView.md
        وایرفریم گرافیکی: 01-wireframes-html/AccountingView.html
    ═══════════════════════════════════════════════════════════════════════
    -->

    <Grid Background="{DynamicResource Brush.Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 🧭 هدر صفحه -->
        <ctrl:PageHeader Grid.Row="0"
                         Icon="📒"
                         Title="{loc:Loc Accounting.Title}"
                         Subtitle="{loc:Loc Accounting.Subtitle}">
            <ctrl:PageHeader.PrimaryAction>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{DynamicResource Btn.Primary}"
                            Content="{loc:Loc Accounting.Act_NewVoucher}"
                            Command="{Binding NewVoucherCommand}"
                            MinHeight="{DynamicResource Size.ButtonHeight}" />
                    <Button Style="{DynamicResource Btn.Secondary}"
                            Content="{loc:Loc Accounting.Act_TrialBalance}"
                            Command="{Binding TrialBalanceCommand}"
                            MinHeight="{DynamicResource Size.ButtonHeight}" />
                    <Button Style="{DynamicResource Btn.Danger}"
                            Content="{loc:Loc Accounting.Act_CloseYear}"
                            Command="{Binding CloseYearCommand}"
                            MinHeight="{DynamicResource Size.ButtonHeight}" />
                </StackPanel>
            </ctrl:PageHeader.PrimaryAction>
        </ctrl:PageHeader>

        <!-- 📊 شاخص‌های کلیدی -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ctrl:StatCard Grid.Column="0"
                               Icon="📒"
                               Title="{loc:Loc Accounting.Kpi1}"
                               Value="{Binding Kpi1Value}"
                               Trend="{Binding Kpi1Trend}"
                               Margin="0,0,12,0" />
                <ctrl:StatCard Grid.Column="1"
                               Icon="💰"
                               Title="{loc:Loc Accounting.Kpi2}"
                               Value="{Binding Kpi2Value}"
                               Trend="{Binding Kpi2Trend}"
                               Margin="0,0,12,0" />
                <ctrl:StatCard Grid.Column="2"
                               Icon="💸"
                               Title="{loc:Loc Accounting.Kpi3}"
                               Value="{Binding Kpi3Value}"
                               Trend="{Binding Kpi3Trend}"
                               Margin="0,0,12,0" />
                <ctrl:StatCard Grid.Column="3"
                               Icon="⚖"
                               Title="{loc:Loc Accounting.Kpi4}"
                               Value="{Binding Kpi4Value}"
                               Trend="{Binding Kpi4Trend}"
                               Margin="0,0,12,0" />
        </Grid>

            <!-- 🔍 نوار فیلتر -->
            <Border Grid.Row="2" Style="{DynamicResource Card.Flat}"
                    Padding="12" Margin="0,0,0,12">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <DatePicker Style="{DynamicResource Input.Date}"
                                Width="160" Margin="0,0,8,0"
                                SelectedDate="{Binding FilterFromdate, Mode=TwoWay}" />
                    <DatePicker Style="{DynamicResource Input.Date}"
                                Width="160" Margin="0,0,8,0"
                                SelectedDate="{Binding FilterTodate, Mode=TwoWay}" />
                    <ComboBox Style="{DynamicResource Input.ComboBox}"
                              Width="170" Margin="0,0,8,0"
                              SelectedValue="{Binding FilterAccount, Mode=TwoWay}" />
                </WrapPanel>
            </Border>

            <!-- 📑 تب‌ها -->
            <TabControl Grid.Row="2" Style="{DynamicResource Tab.Modern}">
                        <TabItem Style="{DynamicResource Tab.Item}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Loc Accounting.Tab1}" />
                                </StackPanel>
                            </TabItem.Header>
                            <Border Padding="0,16,0,0">
                                <!-- محتوای این تب در ViewModel مربوطه بارگذاری می‌شود -->
                            <TextBlock Text="{loc:Loc Accounting.Tab1}" Style="{DynamicResource Txt.Secondary}" />
                            </Border>
                        </TabItem>
                        <TabItem Style="{DynamicResource Tab.Item}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📒" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Loc Accounting.Tab2}" />
                                </StackPanel>
                            </TabItem.Header>
                            <Border Padding="0,16,0,0">
                                <!-- محتوای این تب در ViewModel مربوطه بارگذاری می‌شود -->
                            <TextBlock Text="{loc:Loc Accounting.Tab2}" Style="{DynamicResource Txt.Secondary}" />
                            </Border>
                        </TabItem>
                        <TabItem Style="{DynamicResource Tab.Item}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚖" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Loc Accounting.Tab3}" />
                                </StackPanel>
                            </TabItem.Header>
                            <Border Padding="0,16,0,0">
                                <!-- محتوای این تب در ViewModel مربوطه بارگذاری می‌شود -->
                            <TextBlock Text="{loc:Loc Accounting.Tab3}" Style="{DynamicResource Txt.Secondary}" />
                            </Border>
                        </TabItem>
                        <TabItem Style="{DynamicResource Tab.Item}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Loc Accounting.Tab4}" />
                                </StackPanel>
                            </TabItem.Header>
                            <Border Padding="0,16,0,0">
                                <!-- محتوای این تب در ViewModel مربوطه بارگذاری می‌شود -->
                            <TextBlock Text="{loc:Loc Accounting.Tab4}" Style="{DynamicResource Txt.Secondary}" />
                            </Border>
                        </TabItem>
            </TabControl>




            <!-- 📋 جدول داده‌ها -->
            <Border Grid.Row="3" Style="{DynamicResource Card}"
                    Padding="0" ClipToBounds="True">
                <Grid>
                    <DataGrid Style="{DynamicResource Grid.Modern}"
                              ColumnHeaderStyle="{DynamicResource Grid.Header}"
                              RowStyle="{DynamicResource Grid.Row}"
                              CellStyle="{DynamicResource Grid.Cell}"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              BorderThickness="0"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc Accounting.Col_VoucherNumber}"
                                        Binding="{Binding VoucherNumber}"
                                        Width="110" />
                    <DataGridTextColumn Header="{loc:Loc Accounting.Col_VoucherDate}"
                                        Binding="{Binding VoucherDate, Converter={StaticResource PersianDate}}"
                                        Width="120" />
                    <DataGridTextColumn Header="{loc:Loc Accounting.Col_Description}"
                                        Binding="{Binding Description}"
                                        Width="*" />
                    <DataGridTextColumn Header="{loc:Loc Accounting.Col_Debit}"
                                        Binding="{Binding Debit}"
                                        Width="130" />
                    <DataGridTextColumn Header="{loc:Loc Accounting.Col_Credit}"
                                        Binding="{Binding Credit}"
                                        Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- وضعیت تهی -->
                    <ctrl:EmptyState Icon="🗒"
                                     Title="{loc:Loc Common.NoData}"
                                     Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <!-- 📄 صفحه‌بندی -->
            <Border Grid.Row="4" Padding="12,10,12,0">
                <Grid>
                    <TextBlock Text="{Binding PageSummary}"
                               Style="{DynamicResource Txt.Caption}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Style="{DynamicResource Btn.Secondary}"
                                Content="{loc:Loc Common.Previous}"
                                Command="{Binding PreviousPageCommand}" />
                        <Button Style="{DynamicResource Btn.Secondary}"
                                Content="{loc:Loc Common.Next}"
                                Command="{Binding NextPageCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

        <!-- ⏳ نشانگر بارگذاری -->
        <Border Grid.Row="0" Grid.RowSpan="6"
                Background="{DynamicResource Brush.Canvas}" Opacity="0.6"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⏳" FontSize="32" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding BusyMessage}"
                           Style="{DynamicResource Txt.Body}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>

</UserControl>
