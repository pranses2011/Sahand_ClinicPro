<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.RolePermissionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Sahand.ClinicPro.Desktop.Controls;assembly=Sahand.ClinicPro.Desktop"
    xmlns:loc="clr-namespace:Sahand.ClinicPro.Desktop.Localization;assembly=Sahand.ClinicPro.Desktop"
    xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels.Redesign;assembly=Sahand.ClinicPro.Desktop"
    mc:Ignorable="d"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DataContext="{d:DesignInstance Type=vm:RolePermissionViewModel}"
    SnapsToDevicePixels="True"
    Style="{DynamicResource Page.Modern}"
    FlowDirection="RightToLeft">

    <!--
    ═══════════════════════════════════════════════════════════════════════
      🔐 نقش‌ها و مجوزها  —  بازطراحی شده
    ═══════════════════════════════════════════════════════════════════════
      • تمام رنگ‌ها از Tokens.xaml و با DynamicResource دریافت می‌شوند
        → تعویض تمِ روشن/تاریک در لحظه بدون تغییر این فایل
      • تمام متن‌ها از Strings.resx از طریق {loc:Loc} دریافت می‌شوند
        → افزودن زبان جدید بدون تغییر این فایل
      • وایرفریم مرجع:  02-wireframes-md/RolePermissionView.md
        وایرفریم گرافیکی: 01-wireframes-html/RolePermissionView.html
    ═══════════════════════════════════════════════════════════════════════
    -->

    <Grid Background="{DynamicResource Brush.Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 🧭 هدر صفحه -->
        <ctrl:PageHeader Grid.Row="0"
                         Icon="🔐"
                         Title="{loc:Loc RolePermission.Title}"
                         Subtitle="{loc:Loc RolePermission.Subtitle}">
            <ctrl:PageHeader.PrimaryAction>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{DynamicResource Btn.Primary}"
                            Content="{loc:Loc RolePermission.Act_NewRole}"
                            Command="{Binding NewRoleCommand}"
                            MinHeight="{DynamicResource Size.ButtonHeight}" />
                    <Button Style="{DynamicResource Btn.Success}"
                            Content="{loc:Loc RolePermission.Act_Save}"
                            Command="{Binding SaveCommand}"
                            MinHeight="{DynamicResource Size.ButtonHeight}" />
                    <Button Style="{DynamicResource Btn.Secondary}"
                            Content="{loc:Loc RolePermission.Act_CopyRole}"
                            Command="{Binding CopyRoleCommand}"
                            MinHeight="{DynamicResource Size.ButtonHeight}" />
                </StackPanel>
            </ctrl:PageHeader.PrimaryAction>
        </ctrl:PageHeader>

        <!-- 📊 شاخص‌های کلیدی -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ctrl:StatCard Grid.Column="0"
                               Icon="🔐"
                               Title="{loc:Loc RolePermission.Kpi1}"
                               Value="{Binding Kpi1Value}"
                               Trend="{Binding Kpi1Trend}"
                               Margin="0,0,12,0" />
                <ctrl:StatCard Grid.Column="1"
                               Icon="🔑"
                               Title="{loc:Loc RolePermission.Kpi2}"
                               Value="{Binding Kpi2Value}"
                               Trend="{Binding Kpi2Trend}"
                               Margin="0,0,12,0" />
        </Grid>

            <!-- 🔍 نوار فیلتر -->
            <Border Grid.Row="2" Style="{DynamicResource Card.Flat}"
                    Padding="12" Margin="0,0,0,12">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ctrl:SearchBox Width="260"
                                    Text="{Binding SearchText, Mode=TwoWay}"
                                    Placeholder="{loc:Loc RolePermission.Filter_search}"
                                    Margin="0,0,8,0" />
                    <ComboBox Style="{DynamicResource Input.ComboBox}"
                              Width="170" Margin="0,0,8,0"
                              SelectedValue="{Binding FilterModule, Mode=TwoWay}" />
                </WrapPanel>
            </Border>





            <!-- 📋 جدول داده‌ها -->
            <Border Grid.Row="2" Style="{DynamicResource Card}"
                    Padding="0" ClipToBounds="True">
                <Grid>
                    <DataGrid Style="{DynamicResource Grid.Modern}"
                              ColumnHeaderStyle="{DynamicResource Grid.Header}"
                              RowStyle="{DynamicResource Grid.Row}"
                              CellStyle="{DynamicResource Grid.Cell}"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              BorderThickness="0"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc RolePermission.Col_PermissionName}"
                                        Binding="{Binding PermissionName}"
                                        Width="*" />
                    <DataGridTextColumn Header="{loc:Loc RolePermission.Col_Module}"
                                        Binding="{Binding Module}"
                                        Width="150" />
                    <DataGridTextColumn Header="{loc:Loc RolePermission.Col_Description}"
                                        Binding="{Binding Description}"
                                        Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- وضعیت تهی -->
                    <ctrl:EmptyState Icon="🗒"
                                     Title="{loc:Loc Common.NoData}"
                                     Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <!-- 📄 صفحه‌بندی -->
            <Border Grid.Row="3" Padding="12,10,12,0">
                <Grid>
                    <TextBlock Text="{Binding PageSummary}"
                               Style="{DynamicResource Txt.Caption}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Style="{DynamicResource Btn.Secondary}"
                                Content="{loc:Loc Common.Previous}"
                                Command="{Binding PreviousPageCommand}" />
                        <Button Style="{DynamicResource Btn.Secondary}"
                                Content="{loc:Loc Common.Next}"
                                Command="{Binding NextPageCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

        <!-- ⏳ نشانگر بارگذاری -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Background="{DynamicResource Brush.Canvas}" Opacity="0.6"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⏳" FontSize="32" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding BusyMessage}"
                           Style="{DynamicResource Txt.Body}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>

</UserControl>
