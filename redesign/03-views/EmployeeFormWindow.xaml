<Window x:Class="Sahand.ClinicPro.Desktop.Views.EmployeeFormWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Sahand.ClinicPro.Desktop.Controls;assembly=Sahand.ClinicPro.Desktop"
    xmlns:loc="clr-namespace:Sahand.ClinicPro.Desktop.Localization;assembly=Sahand.ClinicPro.Desktop"
    xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels.Redesign;assembly=Sahand.ClinicPro.Desktop"
    mc:Ignorable="d"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DataContext="{d:DesignInstance Type=vm:EmployeeFormViewModel}"
    SnapsToDevicePixels="True"
    Title="{loc:Loc EmployeeForm.Title}"
    Style="{DynamicResource Window.Modern}"
    FlowDirection="RightToLeft">

    <!--
    ═══════════════════════════════════════════════════════════════════════
      👤 فرم کارمند  —  بازطراحی شده
    ═══════════════════════════════════════════════════════════════════════
      • تمام رنگ‌ها از Tokens.xaml و با DynamicResource دریافت می‌شوند
        → تعویض تمِ روشن/تاریک در لحظه بدون تغییر این فایل
      • تمام متن‌ها از Strings.resx از طریق {loc:Loc} دریافت می‌شوند
        → افزودن زبان جدید بدون تغییر این فایل
      • وایرفریم مرجع:  02-wireframes-md/EmployeeFormWindow.md
        وایرفریم گرافیکی: 01-wireframes-html/EmployeeFormWindow.html
    ═══════════════════════════════════════════════════════════════════════
    -->

    <Grid Background="{DynamicResource Brush.Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 🧭 هدر -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👤" FontSize="24" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding WindowTitle}"
                                   Style="{DynamicResource Txt.Headline}" />
                        <TextBlock Text="{loc:Loc EmployeeForm.Subtitle}"
                                   Style="{DynamicResource Txt.Caption}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 📝 محتوا -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Padding="20,16">
            <StackPanel MaxWidth="960">

                    <!-- 🪪 اطلاعات فردی -->
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc EmployeeForm.Sec1}"
                                       Style="{DynamicResource Txt.Subtitle}"
                                       Margin="0,0,0,12" />
                            <UniformGrid Columns="2">
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc EmployeeForm.Fld_FirstName}"/> <Run Text="*" Foreground="{DynamicResource Brush.Danger}" />
                                </TextBlock>
                                <TextBox Style="{DynamicResource Input.TextBox}" Text="{Binding FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc EmployeeForm.Fld_LastName}"/> <Run Text="*" Foreground="{DynamicResource Brush.Danger}" />
                                </TextBlock>
                                <TextBox Style="{DynamicResource Input.TextBox}" Text="{Binding LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc EmployeeForm.Fld_NationalCode}"/> <Run Text="*" Foreground="{DynamicResource Brush.Danger}" />
                                </TextBlock>
                                <TextBox Style="{DynamicResource Input.TextBox}" Text="{Binding NationalCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc EmployeeForm.Fld_BirthDate}"/>
                                </TextBlock>
                                <DatePicker Style="{DynamicResource Input.Date}" SelectedDate="{Binding BirthDate, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc EmployeeForm.Fld_Gender}"/>
                                </TextBlock>
                                <ComboBox Style="{DynamicResource Input.ComboBox}" SelectedValue="{Binding Gender, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc EmployeeForm.Fld_MaritalStatus}"/>
                                </TextBlock>
                                <ComboBox Style="{DynamicResource Input.ComboBox}" SelectedValue="{Binding MaritalStatus, Mode=TwoWay}" />
                            </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- 💼 اطلاعات شغلی -->
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc EmployeeForm.Sec2}"
                                       Style="{DynamicResource Txt.Subtitle}"
                                       Margin="0,0,0,12" />
                            <UniformGrid Columns="2">
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc EmployeeForm.Fld_EmployeeCode}"/> <Run Text="*" Foreground="{DynamicResource Brush.Danger}" />
                                </TextBlock>
                                <TextBox Style="{DynamicResource Input.TextBox}" Text="{Binding EmployeeCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc EmployeeForm.Fld_PositionId}"/> <Run Text="*" Foreground="{DynamicResource Brush.Danger}" />
                                </TextBlock>
                                <ComboBox Style="{DynamicResource Input.ComboBox}" SelectedValue="{Binding PositionId, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc EmployeeForm.Fld_DepartmentId}"/> <Run Text="*" Foreground="{DynamicResource Brush.Danger}" />
                                </TextBlock>
                                <ComboBox Style="{DynamicResource Input.ComboBox}" SelectedValue="{Binding DepartmentId, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc EmployeeForm.Fld_HireDate}"/> <Run Text="*" Foreground="{DynamicResource Brush.Danger}" />
                                </TextBlock>
                                <DatePicker Style="{DynamicResource Input.Date}" SelectedDate="{Binding HireDate, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc EmployeeForm.Fld_EmploymentType}"/>
                                </TextBlock>
                                <ComboBox Style="{DynamicResource Input.ComboBox}" SelectedValue="{Binding EmploymentType, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc EmployeeForm.Fld_ManagerId}"/>
                                </TextBlock>
                                <ComboBox Style="{DynamicResource Input.ComboBox}" SelectedValue="{Binding ManagerId, Mode=TwoWay}" />
                            </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- 📞 اطلاعات تماس -->
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc EmployeeForm.Sec3}"
                                       Style="{DynamicResource Txt.Subtitle}"
                                       Margin="0,0,0,12" />
                            <UniformGrid Columns="2">
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc EmployeeForm.Fld_MobileNumber}"/>
                                </TextBlock>
                                <TextBox Style="{DynamicResource Input.TextBox}" Text="{Binding MobileNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc EmployeeForm.Fld_Email}"/>
                                </TextBlock>
                                <TextBox Style="{DynamicResource Input.TextBox}" Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc EmployeeForm.Fld_Address}"/>
                                </TextBlock>
                                <TextBox Style="{DynamicResource Input.TextBox}" Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88" VerticalContentAlignment="Top" />
                            </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- 💵 حقوق و مزایا -->
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc EmployeeForm.Sec4}"
                                       Style="{DynamicResource Txt.Subtitle}"
                                       Margin="0,0,0,12" />
                            <UniformGrid Columns="2">
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc EmployeeForm.Fld_BaseSalary}"/>
                                </TextBlock>
                                <TextBox Style="{DynamicResource Input.TextBox}" Text="{Binding BaseSalary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" HorizontalContentAlignment="Right" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc EmployeeForm.Fld_Allowances}"/>
                                </TextBlock>
                                <TextBox Style="{DynamicResource Input.TextBox}" Text="{Binding Allowances, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" HorizontalContentAlignment="Right" />
                            </StackPanel>
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc EmployeeForm.Fld_InsuranceNumber}"/>
                                </TextBlock>
                                <TextBox Style="{DynamicResource Input.TextBox}" Text="{Binding InsuranceNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc EmployeeForm.Fld_BankAccount}"/>
                                </TextBlock>
                                <TextBox Style="{DynamicResource Input.TextBox}" Text="{Binding BankAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>


            </StackPanel>
        </ScrollViewer>

        <!-- ⚡ نوار اقدام -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Style="{DynamicResource Btn.Primary}"
                        Content="{loc:Loc EmployeeForm.Act_Save}"
                        Command="{Binding SaveCommand}"
                        MinHeight="{DynamicResource Size.ButtonHeight}" />
                <Button Style="{DynamicResource Btn.Ghost}"
                        Content="{loc:Loc EmployeeForm.Act_Cancel}"
                        Command="{Binding CancelCommand}"
                        MinHeight="{DynamicResource Size.ButtonHeight}" />
            </StackPanel>
        </Border>

        <!-- نشانگر بارگذاری -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Background="{DynamicResource Brush.Canvas}" Opacity="0.6"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⏳" FontSize="32" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding BusyMessage}"
                           Style="{DynamicResource Txt.Body}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>

</Window>
