<Window x:Class="Sahand.ClinicPro.Desktop.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Sahand.ClinicPro.Desktop.Controls;assembly=Sahand.ClinicPro.Desktop"
    xmlns:loc="clr-namespace:Sahand.ClinicPro.Desktop.Localization;assembly=Sahand.ClinicPro.Desktop"
    xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels.Redesign;assembly=Sahand.ClinicPro.Desktop"
    mc:Ignorable="d"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
    SnapsToDevicePixels="True"
    Title="{loc:Loc Login.Title}"
    Style="{DynamicResource Window.Modern}"
    FlowDirection="RightToLeft">

    <!--
    ═══════════════════════════════════════════════════════════════════════
      🔐 ورود به برنامه  —  بازطراحی شده
    ═══════════════════════════════════════════════════════════════════════
      • تمام رنگ‌ها از Tokens.xaml و با DynamicResource دریافت می‌شوند
        → تعویض تمِ روشن/تاریک در لحظه بدون تغییر این فایل
      • تمام متن‌ها از Strings.resx از طریق {loc:Loc} دریافت می‌شوند
        → افزودن زبان جدید بدون تغییر این فایل
      • وایرفریم مرجع:  02-wireframes-md/LoginWindow.md
        وایرفریم گرافیکی: 01-wireframes-html/LoginWindow.html
    ═══════════════════════════════════════════════════════════════════════
    -->

    <Grid Background="{DynamicResource Brush.Canvas}">
        <Border Style="{DynamicResource Card}"
                Width="400" VerticalAlignment="Center" HorizontalAlignment="Center"
                Padding="32">
            <StackPanel>
                <TextBlock Text="🏥" FontSize="44" HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Loc Login.Title}"
                           Style="{DynamicResource Txt.Headline}"
                           HorizontalAlignment="Center" Margin="0,8,0,24" />

                    <!-- 🔐 ورود -->
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Login.Sec1}"
                                       Style="{DynamicResource Txt.Subtitle}"
                                       Margin="0,0,0,12" />
                            <UniformGrid Columns="2">
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc Login.Fld_UserName}"/> <Run Text="*" Foreground="{DynamicResource Brush.Danger}" />
                                </TextBlock>
                                <TextBox Style="{DynamicResource Input.TextBox}" Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc Login.Fld_Password}"/> <Run Text="*" Foreground="{DynamicResource Brush.Danger}" />
                                </TextBlock>
                                <PasswordBox Style="{DynamicResource Input.Password}" ctrl:PasswordHelper.Attach="True" ctrl:PasswordHelper.Password="{Binding Password, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc Login.Fld_RememberMe}"/>
                                </TextBlock>
                                <CheckBox Style="{DynamicResource Input.CheckBox}" IsChecked="{Binding RememberMe, Mode=TwoWay}" />
                            </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                <!-- پیام خطا -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{DynamicResource Input.Error}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"
                           Margin="0,8" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,16,0,0">
                <Button Style="{DynamicResource Btn.Primary}"
                        Content="{loc:Loc Login.Act_Login}"
                        Command="{Binding LoginCommand}"
                        MinHeight="{DynamicResource Size.ButtonHeight}" />
                <Button Style="{DynamicResource Btn.Ghost}"
                        Content="{loc:Loc Login.Act_Cancel}"
                        Command="{Binding CancelCommand}"
                        MinHeight="{DynamicResource Size.ButtonHeight}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

</Window>
