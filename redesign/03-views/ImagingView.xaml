<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.ImagingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Sahand.ClinicPro.Desktop.Controls;assembly=Sahand.ClinicPro.Desktop"
    xmlns:loc="clr-namespace:Sahand.ClinicPro.Desktop.Localization;assembly=Sahand.ClinicPro.Desktop"
    xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels.Redesign;assembly=Sahand.ClinicPro.Desktop"
    mc:Ignorable="d"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DataContext="{d:DesignInstance Type=vm:ImagingViewModel}"
    SnapsToDevicePixels="True"
    Style="{DynamicResource Page.Modern}"
    FlowDirection="RightToLeft">

    <!--
    ═══════════════════════════════════════════════════════════════════════
      🩻 تصویربرداری  —  بازطراحی شده
    ═══════════════════════════════════════════════════════════════════════
      • تمام رنگ‌ها از Tokens.xaml و با DynamicResource دریافت می‌شوند
        → تعویض تمِ روشن/تاریک در لحظه بدون تغییر این فایل
      • تمام متن‌ها از Strings.resx از طریق {loc:Loc} دریافت می‌شوند
        → افزودن زبان جدید بدون تغییر این فایل
      • وایرفریم مرجع:  02-wireframes-md/ImagingView.md
        وایرفریم گرافیکی: 01-wireframes-html/ImagingView.html
    ═══════════════════════════════════════════════════════════════════════
    -->

    <Grid Background="{DynamicResource Brush.Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 🧭 هدر صفحه -->
        <ctrl:PageHeader Grid.Row="0"
                         Icon="🩻"
                         Title="{loc:Loc Imaging.Title}"
                         Subtitle="{loc:Loc Imaging.Subtitle}">
            <ctrl:PageHeader.PrimaryAction>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{DynamicResource Btn.Primary}"
                            Content="{loc:Loc Imaging.Act_NewOrder}"
                            Command="{Binding NewOrderCommand}"
                            MinHeight="{DynamicResource Size.ButtonHeight}" />
                    <Button Style="{DynamicResource Btn.Success}"
                            Content="{loc:Loc Imaging.Act_OpenViewer}"
                            Command="{Binding OpenViewerCommand}"
                            MinHeight="{DynamicResource Size.ButtonHeight}" />
                    <Button Style="{DynamicResource Btn.Secondary}"
                            Content="{loc:Loc Imaging.Act_Upload}"
                            Command="{Binding UploadCommand}"
                            MinHeight="{DynamicResource Size.ButtonHeight}" />
                </StackPanel>
            </ctrl:PageHeader.PrimaryAction>
        </ctrl:PageHeader>


            <!-- 🔍 نوار فیلتر -->
            <Border Grid.Row="2" Style="{DynamicResource Card.Flat}"
                    Padding="12" Margin="0,0,0,12">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ctrl:SearchBox Width="260"
                                    Text="{Binding SearchText, Mode=TwoWay}"
                                    Placeholder="{loc:Loc Imaging.Filter_search}"
                                    Margin="0,0,8,0" />
                    <ComboBox Style="{DynamicResource Input.ComboBox}"
                              Width="170" Margin="0,0,8,0"
                              SelectedValue="{Binding FilterModality, Mode=TwoWay}" />
                    <ComboBox Style="{DynamicResource Input.ComboBox}"
                              Width="170" Margin="0,0,8,0"
                              SelectedValue="{Binding FilterStatus, Mode=TwoWay}" />
                    <DatePicker Style="{DynamicResource Input.Date}"
                                Width="160" Margin="0,0,8,0"
                                SelectedDate="{Binding FilterDate, Mode=TwoWay}" />
                </WrapPanel>
            </Border>





            <!-- 📋 جدول داده‌ها -->
            <Border Grid.Row="2" Style="{DynamicResource Card}"
                    Padding="0" ClipToBounds="True">
                <Grid>
                    <DataGrid Style="{DynamicResource Grid.Modern}"
                              ColumnHeaderStyle="{DynamicResource Grid.Header}"
                              RowStyle="{DynamicResource Grid.Row}"
                              CellStyle="{DynamicResource Grid.Cell}"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              BorderThickness="0"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc Imaging.Col_StudyNumber}"
                                        Binding="{Binding StudyNumber}"
                                        Width="110" />
                    <DataGridTextColumn Header="{loc:Loc Imaging.Col_PatientName}"
                                        Binding="{Binding PatientName}"
                                        Width="*" />
                    <DataGridTextColumn Header="{loc:Loc Imaging.Col_Modality}"
                                        Binding="{Binding Modality}"
                                        Width="120" />
                    <DataGridTextColumn Header="{loc:Loc Imaging.Col_BodyPart}"
                                        Binding="{Binding BodyPart}"
                                        Width="120" />
                    <DataGridTextColumn Header="{loc:Loc Imaging.Col_StudyDate}"
                                        Binding="{Binding StudyDate, Converter={StaticResource PersianDate}}"
                                        Width="120" />
                    <DataGridTemplateColumn Header="{loc:Loc Imaging.Col_Status}"
                                            Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ctrl:StatusBadge Text="{Binding StatusText}"
                                                  Level="{Binding StatusLevel}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- وضعیت تهی -->
                    <ctrl:EmptyState Icon="🗒"
                                     Title="{loc:Loc Common.NoData}"
                                     Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <!-- 📄 صفحه‌بندی -->
            <Border Grid.Row="3" Padding="12,10,12,0">
                <Grid>
                    <TextBlock Text="{Binding PageSummary}"
                               Style="{DynamicResource Txt.Caption}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Style="{DynamicResource Btn.Secondary}"
                                Content="{loc:Loc Common.Previous}"
                                Command="{Binding PreviousPageCommand}" />
                        <Button Style="{DynamicResource Btn.Secondary}"
                                Content="{loc:Loc Common.Next}"
                                Command="{Binding NextPageCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

        <!-- ⏳ نشانگر بارگذاری -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                Background="{DynamicResource Brush.Canvas}" Opacity="0.6"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⏳" FontSize="32" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding BusyMessage}"
                           Style="{DynamicResource Txt.Body}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>

</UserControl>
