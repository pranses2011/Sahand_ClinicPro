<Window x:Class="Sahand.ClinicPro.Desktop.Views.LabOrderFormWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Sahand.ClinicPro.Desktop.Controls;assembly=Sahand.ClinicPro.Desktop"
    xmlns:loc="clr-namespace:Sahand.ClinicPro.Desktop.Localization;assembly=Sahand.ClinicPro.Desktop"
    xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels.Redesign;assembly=Sahand.ClinicPro.Desktop"
    mc:Ignorable="d"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DataContext="{d:DesignInstance Type=vm:LabOrderFormViewModel}"
    SnapsToDevicePixels="True"
    Title="{loc:Loc LabOrderForm.Title}"
    Style="{DynamicResource Window.Modern}"
    FlowDirection="RightToLeft">

    <!--
    ═══════════════════════════════════════════════════════════════════════
      🧫 درخواست آزمایش  —  بازطراحی شده
    ═══════════════════════════════════════════════════════════════════════
      • تمام رنگ‌ها از Tokens.xaml و با DynamicResource دریافت می‌شوند
        → تعویض تمِ روشن/تاریک در لحظه بدون تغییر این فایل
      • تمام متن‌ها از Strings.resx از طریق {loc:Loc} دریافت می‌شوند
        → افزودن زبان جدید بدون تغییر این فایل
      • وایرفریم مرجع:  02-wireframes-md/LabOrderFormWindow.md
        وایرفریم گرافیکی: 01-wireframes-html/LabOrderFormWindow.html
    ═══════════════════════════════════════════════════════════════════════
    -->

    <Grid Background="{DynamicResource Brush.Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 🧭 هدر -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🧫" FontSize="24" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding WindowTitle}"
                                   Style="{DynamicResource Txt.Headline}" />
                        <TextBlock Text="{loc:Loc LabOrderForm.Subtitle}"
                                   Style="{DynamicResource Txt.Caption}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 📝 محتوا -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Padding="20,16">
            <StackPanel MaxWidth="960">

                    <!-- 👤 بیمار -->
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc LabOrderForm.Sec1}"
                                       Style="{DynamicResource Txt.Subtitle}"
                                       Margin="0,0,0,12" />
                            <UniformGrid Columns="2">
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc LabOrderForm.Fld_PatientId}"/> <Run Text="*" Foreground="{DynamicResource Brush.Danger}" />
                                </TextBlock>
                                <ctrl:SearchBox Text="{Binding PatientIdText, Mode=TwoWay}" Placeholder="جستجو و انتخاب…" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc LabOrderForm.Fld_VisitId}"/>
                                </TextBlock>
                                <ctrl:SearchBox Text="{Binding VisitIdText, Mode=TwoWay}" Placeholder="جستجو و انتخاب…" />
                            </StackPanel>
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc LabOrderForm.Fld_RequestingDoctorId}"/> <Run Text="*" Foreground="{DynamicResource Brush.Danger}" />
                                </TextBlock>
                                <ComboBox Style="{DynamicResource Input.ComboBox}" SelectedValue="{Binding RequestingDoctorId, Mode=TwoWay}" />
                            </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- 🧪 آزمایش‌ها -->
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc LabOrderForm.Sec2}"
                                       Style="{DynamicResource Txt.Subtitle}"
                                       Margin="0,0,0,12" />
                            <UniformGrid Columns="2">
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc LabOrderForm.Fld_TestIds}"/> <Run Text="*" Foreground="{DynamicResource Brush.Danger}" />
                                </TextBlock>
                                <ctrl:SearchBox Text="{Binding TestIdsText, Mode=TwoWay}" Placeholder="جستجو و انتخاب…" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc LabOrderForm.Fld_Priority}"/>
                                </TextBlock>
                                <ComboBox Style="{DynamicResource Input.ComboBox}" SelectedValue="{Binding Priority, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc LabOrderForm.Fld_FastingRequired}"/>
                                </TextBlock>
                                <CheckBox Style="{DynamicResource Input.CheckBox}" IsChecked="{Binding FastingRequired, Mode=TwoWay}" />
                            </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- 📝 نمونه و توضیحات -->
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc LabOrderForm.Sec3}"
                                       Style="{DynamicResource Txt.Subtitle}"
                                       Margin="0,0,0,12" />
                            <UniformGrid Columns="2">
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc LabOrderForm.Fld_SampleType}"/>
                                </TextBlock>
                                <ComboBox Style="{DynamicResource Input.ComboBox}" SelectedValue="{Binding SampleType, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc LabOrderForm.Fld_CollectionDate}"/>
                                </TextBlock>
                                <DatePicker Style="{DynamicResource Input.Date}" SelectedDate="{Binding CollectionDate, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc LabOrderForm.Fld_ClinicalNotes}"/>
                                </TextBlock>
                                <TextBox Style="{DynamicResource Input.TextBox}" Text="{Binding ClinicalNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88" VerticalContentAlignment="Top" />
                            </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>


            </StackPanel>
        </ScrollViewer>

        <!-- ⚡ نوار اقدام -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Style="{DynamicResource Btn.Primary}"
                        Content="{loc:Loc LabOrderForm.Act_Save}"
                        Command="{Binding SaveCommand}"
                        MinHeight="{DynamicResource Size.ButtonHeight}" />
                <Button Style="{DynamicResource Btn.Success}"
                        Content="{loc:Loc LabOrderForm.Act_SaveAndPrint}"
                        Command="{Binding SaveAndPrintCommand}"
                        MinHeight="{DynamicResource Size.ButtonHeight}" />
                <Button Style="{DynamicResource Btn.Ghost}"
                        Content="{loc:Loc LabOrderForm.Act_Cancel}"
                        Command="{Binding CancelCommand}"
                        MinHeight="{DynamicResource Size.ButtonHeight}" />
            </StackPanel>
        </Border>

        <!-- نشانگر بارگذاری -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Background="{DynamicResource Brush.Canvas}" Opacity="0.6"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⏳" FontSize="32" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding BusyMessage}"
                           Style="{DynamicResource Txt.Body}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>

</Window>
