<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.DentistryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Sahand.ClinicPro.Desktop.Controls;assembly=Sahand.ClinicPro.Desktop"
    xmlns:loc="clr-namespace:Sahand.ClinicPro.Desktop.Localization;assembly=Sahand.ClinicPro.Desktop"
    xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels.Redesign;assembly=Sahand.ClinicPro.Desktop"
    mc:Ignorable="d"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DataContext="{d:DesignInstance Type=vm:DentistryViewModel}"
    SnapsToDevicePixels="True"
    Style="{DynamicResource Page.Modern}"
    FlowDirection="RightToLeft">

    <!--
    ═══════════════════════════════════════════════════════════════════════
      🦷 دندانپزشکی  —  بازطراحی شده
    ═══════════════════════════════════════════════════════════════════════
      • تمام رنگ‌ها از Tokens.xaml و با DynamicResource دریافت می‌شوند
        → تعویض تمِ روشن/تاریک در لحظه بدون تغییر این فایل
      • تمام متن‌ها از Strings.resx از طریق {loc:Loc} دریافت می‌شوند
        → افزودن زبان جدید بدون تغییر این فایل
      • وایرفریم مرجع:  02-wireframes-md/DentistryView.md
        وایرفریم گرافیکی: 01-wireframes-html/DentistryView.html
    ═══════════════════════════════════════════════════════════════════════
    -->

    <Grid Background="{DynamicResource Brush.Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 🧭 هدر صفحه -->
        <ctrl:PageHeader Grid.Row="0"
                         Icon="🦷"
                         Title="{loc:Loc Dentistry.Title}"
                         Subtitle="{loc:Loc Dentistry.Subtitle}">
            <ctrl:PageHeader.PrimaryAction>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{DynamicResource Btn.Primary}"
                            Content="{loc:Loc Dentistry.Act_Save}"
                            Command="{Binding SaveCommand}"
                            MinHeight="{DynamicResource Size.ButtonHeight}" />
                    <Button Style="{DynamicResource Btn.Secondary}"
                            Content="{loc:Loc Dentistry.Act_Print}"
                            Command="{Binding PrintCommand}"
                            MinHeight="{DynamicResource Size.ButtonHeight}" />
                </StackPanel>
            </ctrl:PageHeader.PrimaryAction>
        </ctrl:PageHeader>

        <!-- 📊 شاخص‌های کلیدی -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ctrl:StatCard Grid.Column="0"
                               Icon="🦷"
                               Title="{loc:Loc Dentistry.Kpi1}"
                               Value="{Binding Kpi1Value}"
                               Trend="{Binding Kpi1Trend}"
                               Margin="0,0,12,0" />
                <ctrl:StatCard Grid.Column="1"
                               Icon="⚠"
                               Title="{loc:Loc Dentistry.Kpi2}"
                               Value="{Binding Kpi2Value}"
                               Trend="{Binding Kpi2Trend}"
                               Margin="0,0,12,0" />
        </Grid>


            <!-- 📑 تب‌ها -->
            <TabControl Grid.Row="2" Style="{DynamicResource Tab.Modern}">
                        <TabItem Style="{DynamicResource Tab.Item}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🦷" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Loc Dentistry.Tab1}" />
                                </StackPanel>
                            </TabItem.Header>
                            <Border Padding="0,16,0,0">
                                <!-- محتوای این تب در ViewModel مربوطه بارگذاری می‌شود -->
                            <TextBlock Text="{loc:Loc Dentistry.Tab1}" Style="{DynamicResource Txt.Secondary}" />
                            </Border>
                        </TabItem>
                        <TabItem Style="{DynamicResource Tab.Item}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔧" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Loc Dentistry.Tab2}" />
                                </StackPanel>
                            </TabItem.Header>
                            <Border Padding="0,16,0,0">
                                <!-- محتوای این تب در ViewModel مربوطه بارگذاری می‌شود -->
                            <TextBlock Text="{loc:Loc Dentistry.Tab2}" Style="{DynamicResource Txt.Secondary}" />
                            </Border>
                        </TabItem>
                        <TabItem Style="{DynamicResource Tab.Item}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🩻" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Loc Dentistry.Tab3}" />
                                </StackPanel>
                            </TabItem.Header>
                            <Border Padding="0,16,0,0">
                                <!-- محتوای این تب در ViewModel مربوطه بارگذاری می‌شود -->
                            <TextBlock Text="{loc:Loc Dentistry.Tab3}" Style="{DynamicResource Txt.Secondary}" />
                            </Border>
                        </TabItem>
            </TabControl>






        <!-- ⏳ نشانگر بارگذاری -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Background="{DynamicResource Brush.Canvas}" Opacity="0.6"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⏳" FontSize="32" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding BusyMessage}"
                           Style="{DynamicResource Txt.Body}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>

</UserControl>
