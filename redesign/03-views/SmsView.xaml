<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.SmsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Sahand.ClinicPro.Desktop.Controls;assembly=Sahand.ClinicPro.Desktop"
    xmlns:loc="clr-namespace:Sahand.ClinicPro.Desktop.Localization;assembly=Sahand.ClinicPro.Desktop"
    xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels.Redesign;assembly=Sahand.ClinicPro.Desktop"
    mc:Ignorable="d"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DataContext="{d:DesignInstance Type=vm:SmsViewModel}"
    SnapsToDevicePixels="True"
    Style="{DynamicResource Page.Modern}"
    FlowDirection="RightToLeft">

    <!--
    ═══════════════════════════════════════════════════════════════════════
      📨 پیامک  —  بازطراحی شده
    ═══════════════════════════════════════════════════════════════════════
      • تمام رنگ‌ها از Tokens.xaml و با DynamicResource دریافت می‌شوند
        → تعویض تمِ روشن/تاریک در لحظه بدون تغییر این فایل
      • تمام متن‌ها از Strings.resx از طریق {loc:Loc} دریافت می‌شوند
        → افزودن زبان جدید بدون تغییر این فایل
      • وایرفریم مرجع:  02-wireframes-md/SmsView.md
        وایرفریم گرافیکی: 01-wireframes-html/SmsView.html
    ═══════════════════════════════════════════════════════════════════════
    -->

    <Grid Background="{DynamicResource Brush.Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 🧭 هدر صفحه -->
        <ctrl:PageHeader Grid.Row="0"
                         Icon="📨"
                         Title="{loc:Loc Sms.Title}"
                         Subtitle="{loc:Loc Sms.Subtitle}">
            <ctrl:PageHeader.PrimaryAction>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{DynamicResource Btn.Primary}"
                            Content="{loc:Loc Sms.Act_Send}"
                            Command="{Binding SendCommand}"
                            MinHeight="{DynamicResource Size.ButtonHeight}" />
                    <Button Style="{DynamicResource Btn.Secondary}"
                            Content="{loc:Loc Sms.Act_Preview}"
                            Command="{Binding PreviewCommand}"
                            MinHeight="{DynamicResource Size.ButtonHeight}" />
                    <Button Style="{DynamicResource Btn.Secondary}"
                            Content="{loc:Loc Sms.Act_SaveTemplate}"
                            Command="{Binding SaveTemplateCommand}"
                            MinHeight="{DynamicResource Size.ButtonHeight}" />
                </StackPanel>
            </ctrl:PageHeader.PrimaryAction>
        </ctrl:PageHeader>

        <!-- 📊 شاخص‌های کلیدی -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ctrl:StatCard Grid.Column="0"
                               Icon="📨"
                               Title="{loc:Loc Sms.Kpi1}"
                               Value="{Binding Kpi1Value}"
                               Trend="{Binding Kpi1Trend}"
                               Margin="0,0,12,0" />
                <ctrl:StatCard Grid.Column="1"
                               Icon="✅"
                               Title="{loc:Loc Sms.Kpi2}"
                               Value="{Binding Kpi2Value}"
                               Trend="{Binding Kpi2Trend}"
                               Margin="0,0,12,0" />
                <ctrl:StatCard Grid.Column="2"
                               Icon="❌"
                               Title="{loc:Loc Sms.Kpi3}"
                               Value="{Binding Kpi3Value}"
                               Trend="{Binding Kpi3Trend}"
                               Margin="0,0,12,0" />
                <ctrl:StatCard Grid.Column="3"
                               Icon="💰"
                               Title="{loc:Loc Sms.Kpi4}"
                               Value="{Binding Kpi4Value}"
                               Trend="{Binding Kpi4Trend}"
                               Margin="0,0,12,0" />
        </Grid>


            <!-- 📑 تب‌ها -->
            <TabControl Grid.Row="2" Style="{DynamicResource Tab.Modern}">
                        <TabItem Style="{DynamicResource Tab.Item}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📤" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Loc Sms.Tab1}" />
                                </StackPanel>
                            </TabItem.Header>
                            <Border Padding="0,16,0,0">
                                <!-- محتوای این تب در ViewModel مربوطه بارگذاری می‌شود -->
                            <TextBlock Text="{loc:Loc Sms.Tab1}" Style="{DynamicResource Txt.Secondary}" />
                            </Border>
                        </TabItem>
                        <TabItem Style="{DynamicResource Tab.Item}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Loc Sms.Tab2}" />
                                </StackPanel>
                            </TabItem.Header>
                            <Border Padding="0,16,0,0">
                                <!-- محتوای این تب در ViewModel مربوطه بارگذاری می‌شود -->
                            <TextBlock Text="{loc:Loc Sms.Tab2}" Style="{DynamicResource Txt.Secondary}" />
                            </Border>
                        </TabItem>
                        <TabItem Style="{DynamicResource Tab.Item}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Loc Sms.Tab3}" />
                                </StackPanel>
                            </TabItem.Header>
                            <Border Padding="0,16,0,0">
                                <!-- محتوای این تب در ViewModel مربوطه بارگذاری می‌شود -->
                            <TextBlock Text="{loc:Loc Sms.Tab3}" Style="{DynamicResource Txt.Secondary}" />
                            </Border>
                        </TabItem>
            </TabControl>


                    <!-- 📤 ارسال -->
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Sms.Sec1}"
                                       Style="{DynamicResource Txt.Subtitle}"
                                       Margin="0,0,0,12" />
                            <UniformGrid Columns="2">
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc Sms.Fld_Recipients}"/> <Run Text="*" Foreground="{DynamicResource Brush.Danger}" />
                                </TextBlock>
                                <ctrl:SearchBox Text="{Binding RecipientsText, Mode=TwoWay}" Placeholder="جستجو و انتخاب…" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc Sms.Fld_TemplateId}"/>
                                </TextBlock>
                                <ComboBox Style="{DynamicResource Input.ComboBox}" SelectedValue="{Binding TemplateId, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc Sms.Fld_MessageText}"/> <Run Text="*" Foreground="{DynamicResource Brush.Danger}" />
                                </TextBlock>
                                <TextBox Style="{DynamicResource Input.TextBox}" Text="{Binding MessageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88" VerticalContentAlignment="Top" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc Sms.Fld_SendAt}"/>
                                </TextBlock>
                                <DatePicker Style="{DynamicResource Input.Date}" SelectedDate="{Binding SendAt, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,10">
                                <TextBlock Style="{DynamicResource Input.Label}">
                                    <Run Text="{loc:Loc Sms.Fld_RespectOptOut}"/>
                                </TextBlock>
                                <CheckBox Style="{DynamicResource Input.CheckBox}" IsChecked="{Binding RespectOptOut, Mode=TwoWay}" />
                            </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>




        <!-- ⏳ نشانگر بارگذاری -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Background="{DynamicResource Brush.Canvas}" Opacity="0.6"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⏳" FontSize="32" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding BusyMessage}"
                           Style="{DynamicResource Txt.Body}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>

</UserControl>
