<!--
  📊 مولکول: StatCard — کارتِ شاخص کلیدی (KPI)
  ═══════════════════════════════════════════════════════════════════════
    Title    — عنوان شاخص
    Value    — مقدار
    Icon     — شکلک
    Trend    — درصد تغییر (مثبت = سبز، منفی = قرمز)
    Accent   — نام رنگ تاکیدی: Primary | Success | Warning | Danger | Info
  ═══════════════════════════════════════════════════════════════════════
-->
<UserControl x:Class="Sahand.ClinicPro.Desktop.Controls.StatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             FlowDirection="RightToLeft">

    <Border Style="{DynamicResource Card}"
            MinHeight="110"
            Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- برچسب -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{Binding Title, ElementName=Root}"
                       Style="{DynamicResource Txt.Caption}"
                       TextTrimming="CharacterEllipsis" />

            <!-- آیکون -->
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                    Width="42" Height="42"
                    CornerRadius="{DynamicResource R.Medium}"
                    Background="{DynamicResource Brush.PrimaryLight}"
                    VerticalAlignment="Top"
                    Margin="8,0,0,0">
                <TextBlock Text="{Binding Icon, ElementName=Root}"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Primary}" />
            </Border>

            <!-- مقدار -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="{Binding Value, ElementName=Root}"
                       FontFamily="{DynamicResource Font.Bold}"
                       FontSize="{DynamicResource Fs.Headline}"
                       Foreground="{DynamicResource Brush.Text}"
                       VerticalAlignment="Center"
                       Margin="0,6,0,0" />

            <!-- روند -->
            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        Margin="0,6,0,0">
                <TextBlock Text="{Binding TrendText, ElementName=Root}"
                           FontFamily="{DynamicResource Font.Medium}"
                           FontSize="{DynamicResource Fs.Caption}"
                           Foreground="{Binding TrendBrush, ElementName=Root}"
                           Visibility="{Binding TrendText, ElementName=Root,
                                        Converter={StaticResource NullToCollapsed}}" />
                <TextBlock Text="{Binding Hint, ElementName=Root}"
                           Style="{DynamicResource Txt.Caption}"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           Margin="8,0,0,0"
                           Visibility="{Binding Hint, ElementName=Root,
                                        Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
