<!--
  🗒 مولکول: EmptyState — وضعیتِ تهی برای جداول و لیست‌های خالی
  ═══════════════════════════════════════════════════════════════════════
    Icon     — شکلک بزرگ
    Title    — عنوان
    Message  — توضیح
    Action   — دکمه‌ی اقدام (اختیاری)
  ═══════════════════════════════════════════════════════════════════════
-->
<UserControl x:Class="Sahand.ClinicPro.Desktop.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             FlowDirection="RightToLeft">
    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="24,48">
        <TextBlock Text="{Binding Icon, ElementName=Root}"
                   FontSize="52"
                   HorizontalAlignment="Center"
                   Opacity="0.55" />
        <TextBlock Text="{Binding Title, ElementName=Root}"
                   Style="{DynamicResource Txt.Subtitle}"
                   HorizontalAlignment="Center"
                   Margin="0,14,0,4" />
        <TextBlock Text="{Binding Message, ElementName=Root}"
                   Style="{DynamicResource Txt.Caption}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="380"
                   Visibility="{Binding Message, ElementName=Root,
                                Converter={StaticResource NullToCollapsed}}" />
        <ContentPresenter Content="{Binding Action, ElementName=Root}"
                          HorizontalAlignment="Center"
                          Margin="0,16,0,0" />
    </StackPanel>
</UserControl>
