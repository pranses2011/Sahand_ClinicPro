<!--
  🧭 مولکول: PageHeader — هدر یکپارچه‌ی همه‌ی صفحات
  ═══════════════════════════════════════════════════════════════════════
  ویژگی‌های قابل اتصال (DependencyProperty):
    Title         — عنوان صفحه
    Subtitle      — زیرعنوان / توضیح
    Icon          — شکلک یا گلیف آیکون
    PrimaryAction — محتوای دکمه‌ی اصلی (اختیاری)
    ShowBack      — نمایش دکمه‌ی بازگشت
  ═══════════════════════════════════════════════════════════════════════
-->
<UserControl x:Class="Sahand.ClinicPro.Desktop.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
             x:Name="Root"
             FlowDirection="RightToLeft">

    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1"
            Padding="{DynamicResource P.Page}"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 🎨 آیکون -->
            <Border Grid.Column="0"
                    Width="48" Height="48"
                    CornerRadius="{DynamicResource R.Large}"
                    Background="{DynamicResource Brush.PrimaryLight}"
                    Margin="0,0,16,0"
                    Visibility="{Binding Icon, ElementName=Root,
                                 Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding Icon, ElementName=Root}"
                           FontSize="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Primary}" />
            </Border>

            <!-- 📝 عنوان و زیرعنوان -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title, ElementName=Root}"
                           Style="{DynamicResource Txt.Headline}" />
                <TextBlock Text="{Binding Subtitle, ElementName=Root}"
                           Style="{DynamicResource Txt.Caption}"
                           Margin="0,2,0,0"
                           Visibility="{Binding Subtitle, ElementName=Root,
                                        Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>

            <!-- ⚡ ناحیه‌ی اقدام‌های اصلی -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <ContentPresenter Content="{Binding SecondaryActions, ElementName=Root}" />
                <ContentPresenter Content="{Binding PrimaryAction, ElementName=Root}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
