<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════
     پیکربندی منبع NuGet برای پروژه Sahand ClinicPro
     فقط منبع رسمی nuget.org مجاز است (جلوگیری از منابع ناشناس).
     ═══════════════════════════════════════════════════════════════ -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
