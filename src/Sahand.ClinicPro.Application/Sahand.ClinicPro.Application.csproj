<Project Sdk="Microsoft.NET.Sdk">
  <!-- ═══════════════════════════════════════════════════════════════
       لایه کاربرد (Application Layer) — فقط به لایه دامنه وابسته است
       شامل: موارد CQRS (Command/Query)، رفتارهای خط لوله، DTOها،
       نگاشت‌ها، اعتبارسنج‌ها و اینترفیس سرویس‌های خارجی
       ═══════════════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- نکته Mapperly (گام V11): نگاشت source-generated جایگزین AutoMapper شد؛
         هشدار امنیتی GHSA-rvv3-g6hj-g44x با حذف کامل پکیج بسته شد. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- CQRS: فرستنده و خط لوله Command/Query -->
    <PackageReference Include="MediatR" />
    <!-- اعتبارسنجی با پیام‌های فارسی -->
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <!-- نگاشت موجودیت‌ها به DTO و برعکس — source-generated (بسته تحلیلی) -->
    <PackageReference Include="Riok.Mapperly" PrivateAssets="all" />
    <!-- انتزاع‌های DI برای نوشتن متد الحاقی AddApplication -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- برای ILogger در رفتار لاگ‌گذاری (گام ۵) -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
      <!-- پرس‌وجوهای LINQ صفحه‌بندی در Handlerها -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- تنها وابستگی مجاز لایه کاربرد: لایه دامنه -->
    <ProjectReference Include="..\Sahand.ClinicPro.Domain\Sahand.ClinicPro.Domain.csproj" />
  </ItemGroup>
</Project>
