@page "/activation-requests"
@using Sahand.ClinicPro.LicensePortal.Services
@inject LicenseAdminService Admin

<PageTitle>درخواست‌های فعال‌سازی — پنل لایسنس سهند</PageTitle>

<h1 class="page-title">⏳ درخواست‌های فعال‌سازی</h1>
<p class="page-desc">لایسنس‌های صادرشده‌ای که هنوز توسط درمانگاه فعال‌سازی نشده‌اند — کلید را برای مشتری ارسال کنید</p>

@if (_rows.Count == 0)
{
    <div class="panel"><div class="empty">درخواست فعال‌سازی در انتظاری وجود ندارد</div></div>
}
else
{
    <div class="panel">
        <table class="table">
            <thead>
                <tr>
                    <th>کلید لایسنس</th>
                    <th>نوع</th>
                    <th>حد کاربر</th>
                    <th>حد پزشک</th>
                    <th>حد بیمار</th>
                    <th>انقضا</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr>
                        <td class="mono">@row.LicenseKey</td>
                        <td>@row.TypeText</td>
                        <td>@row.MaxUsers</td>
                        <td>@row.MaxDoctors</td>
                        <td>@row.MaxPatients</td>
                        <td>@row.ExpiryText</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<LicenseRowDto> _rows = new();

    protected override async Task OnInitializedAsync()
    {
        _rows = await Admin.ListAsync("pending");
    }
}