@page "/"
@using Sahand.ClinicPro.LicensePortal.Services
@inject LicenseAdminService Admin

<PageTitle>داشبورد — پنل لایسنس سهند</PageTitle>

<h1 class="page-title">📊 داشبورد مدیریت لایسنس</h1>
<p class="page-desc">نمای کلی وضعیت لایسنس‌های صادرشده و اعتبارسنجی‌های اخیر درمانگاه‌ها</p>

@if (_stats is null)
{
    <div class="loading">در حال بارگذاری…</div>
}
else
{
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-value">@_stats.Total</div>
            <div class="stat-label">کل لایسنس‌ها</div>
        </div>
        <div class="stat-card green">
            <div class="stat-value">@_stats.Active</div>
            <div class="stat-label">فعال</div>
        </div>
        <div class="stat-card orange">
            <div class="stat-value">@_stats.PendingActivation</div>
            <div class="stat-label">در انتظار فعال‌سازی</div>
        </div>
        <div class="stat-card red">
            <div class="stat-value">@_stats.Expired</div>
            <div class="stat-label">منقضی‌شده</div>
        </div>
        <div class="stat-card teal">
            <div class="stat-value">@_stats.Subscription</div>
            <div class="stat-label">اشتراکی</div>
        </div>
        <div class="stat-card indigo">
            <div class="stat-value">@_stats.Perpetual</div>
            <div class="stat-label">دائمی</div>
        </div>
    </div>

    <div class="two-col">
        <div class="panel">
            <h3>🧾 آخرین لایسنس‌ها</h3>
            @if (_recent.Count == 0)
            {
                <div class="empty">هنوز لایسنسی صادر نشده است</div>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>کلید</th>
                            <th>نوع</th>
                            <th>انقضا</th>
                            <th>وضعیت</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _recent)
                        {
                            <tr>
                                <td class="mono">@row.LicenseKey</td>
                                <td>@row.TypeText</td>
                                <td>@row.ExpiryText</td>
                                <td><span class="badge" style="background:@row.StatusColor">@row.StatusText</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="panel">
            <h3>📜 اعتبارسنجی‌های اخیر</h3>
            @if (_checks.Count == 0)
            {
                <div class="empty">لاگی ثبت نشده است</div>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>زمان</th>
                            <th>نتیجه</th>
                            <th>برخط</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in _checks)
                        {
                            <tr>
                                <td>@(log.CheckDate?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "—")</td>
                                <td>@log.ResultText</td>
                                <td>@(log.IsOnline ? "بله" : "خیر")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    @* ── اطلاعات پشتیبانی محصول — منبع ارسال به کلاینت‌ها هنگام فعال‌سازی؛ بدون نیاز به استقرار مجدد قابل ویرایش است ── *@
    <div class="panel" style="margin-top:24px">
        <h3>🧑‍💻 اطلاعات پشتیبانی محصول</h3>
        <p class="page-desc" style="margin-bottom:14px">
            این اطلاعات هنگام <b>فعال‌سازی اولیه</b> به نرم‌افزار کلاینت ارسال و در سراسر برنامه
            (صفحه لایسنس، درباره برنامه و راهنماها) نمایش داده می‌شود. هیچ مقداری هاردکد نیست و همین‌جا قابل ویرایش است.
        </p>
        <EditForm Model="_support" OnValidSubmit="SaveSupportAsync" style="max-width:760px">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                <label>نام پشتیبان<br><InputText @bind-Value="_support.Name" /></label>
                <label>نام شرکت<br><InputText @bind-Value="_support.Company" /></label>
                <label>تلفن ثابت (با کد)<br><InputText @bind-Value="_support.Phone" dir="ltr" /></label>
                <label>موبایل<br><InputText @bind-Value="_support.Mobile" dir="ltr" /></label>
                <label>ایمیل<br><InputText @bind-Value="_support.Email" dir="ltr" /></label>
                <label>وب‌سایت<br><InputText @bind-Value="_support.Website" dir="ltr" /></label>
            </div>
            <div style="margin-top:14px;display:flex;align-items:center;gap:12px">
                <button type="submit" class="btn-primary" disabled="@_supportBusy">
                    @(_supportBusy ? "در حال ذخیره…" : "💾 ذخیره اطلاعات پشتیبانی")
                </button>
                @if (_supportSaved)
                {
                    <span style="color:#2e7d32">✅ ذخیره شد — از فعال‌سازی/تپ‌قلب بعدی در کلاینت‌ها اعمال می‌شود.</span>
                }
            </div>
        </EditForm>
    </div>
}

@code {
    private PortalStatsDto? _stats;
    private List<LicenseRowDto> _recent = new();
    private List<CheckLogRow> _checks = new();

    // اطلاعات پشتیبانی — قابل ویرایش از همین داشبورد؛ هنگام فعال‌سازی به کلاینت ارسال می‌شود
    private SupportSettingsDto _support = new();
    private bool _supportSaved;
    private bool _supportBusy;

    protected override async Task OnInitializedAsync()
    {
        _stats = await Admin.GetStatsAsync();
        _recent = (await Admin.ListAsync()).Take(8).ToList();
        _checks = await Admin.RecentChecksAsync(10);
        _support = await Admin.GetSupportInfoAsync();
    }

    /// <summary>ذخیره اطلاعات پشتیبانی — بدون نیاز به استقرار مجدد</summary>
    private async Task SaveSupportAsync()
    {
        _supportBusy = true;
        try
        {
            await Admin.SaveSupportInfoAsync(_support);
            _supportSaved = true;
        }
        finally
        {
            _supportBusy = false;
        }
    }
}