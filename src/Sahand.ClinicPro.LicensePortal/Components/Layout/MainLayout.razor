@inherits LayoutComponentBase

<div class="shell" dir="rtl">
    <aside class="sidebar">
        <div class="brand">
            <span class="logo">🔑</span>
            <div>
                <div class="brand-title">پنل لایسنس سهند</div>
                <div class="brand-sub">Sahand ClinicPro</div>
            </div>
        </div>
        <nav class="nav">
            <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
                <span class="ico">📊</span> داشبورد
            </NavLink>
            <NavLink class="nav-item" href="/licenses">
                <span class="ico">🧾</span> مدیریت لایسنس‌ها
            </NavLink>
            <NavLink class="nav-item" href="/activation-requests">
