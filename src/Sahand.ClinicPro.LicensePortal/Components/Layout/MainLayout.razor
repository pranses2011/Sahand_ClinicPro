            </NavLink>
            <NavLink class="nav-item" href="/check-logs">
                <span class="ico">📜</span> لاگ اعتبارسنجی
            </NavLink>
        </nav>
        <div class="sidebar-foot">
            نسخه ۱.۱.۰ — گام V9
        </div>
    </aside>

    <main class="main">
        @Body
    </main>
