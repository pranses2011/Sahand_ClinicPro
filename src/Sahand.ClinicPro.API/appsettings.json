{
  "Database": {
    "AutoMigrateOnStartup": true
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=SahandClinicProDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": {
            "type": "Sahand.ClinicPro.API.Logging.PersianConsoleTextFormatter, Sahand.ClinicPro.API"
          }
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ]
  },
  "AllowedHosts": "*",
  "Cache": {
    "L2": {
      "Enabled": false,
      "L1TtlSeconds": 90,
      "L2TtlSeconds": 600,
      "Provider": "Memory"
    }
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "Sahand.ClinicPro",
    "Audience": "Sahand.ClinicPro.Clients",
    "AccessTokenExpiryMinutes": 30,
    "RefreshTokenExpiryDays": 7
  },
  "Security": {
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 30,
    "PasswordHistoryDepth": 5
  },
  "Sms": {
    "Kavenegar": {
      "ApiKey": "",
      "Sender": "10004346"
    }
  },
  "Jobs": {
    "Enabled": false
  },
  "Backup": {
    "Directory": "C:/Backups/SahandClinicPro",
    "RetentionCount": 14,
    "Cloud": {
      "Provider": "",
      "Endpoint": "",
      "Bucket": "",
      "AccessKey": "",
      "SecretKey": "",
      "Region": "us-east-1",
      "Prefix": "backups/",
      "LocalFolder": "",
      "EncryptionKey": ""
    }
  },
  "Insurance": {
    "TimeoutSeconds": 15,
    "RetryCount": 3,
    "OfflineFallback": true
  },
  "License": {
    "PortalUrl": "",
    "HardwareFingerprint": "",
    "RsaPublicKey": "",
    "ClinicName": "",
    "OfflineGraceDays": 30
  },
  "Government": {
    "Sepas": {
      "Endpoint": "",
      "Token": ""
    },
    "EPrescription": {
      "Endpoint": "",
      "Token": ""
    }
  }
}