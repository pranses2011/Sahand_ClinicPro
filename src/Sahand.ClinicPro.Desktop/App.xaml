<Application x:Class="Sahand.ClinicPro.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Sahand.ClinicPro.Desktop"
             xmlns:converters="clr-namespace:Sahand.ClinicPro.Desktop.Converters"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnMainWindowClose">
    <!-- ═══════════════════════════════════════════════════════════
         نقطه ورود کلاینت دسکتاپ درمانگاه سهند — گام ۱۰
         • تم Material Design 3 (روشن/تیره با ThemeService)
         • رنگ سازمانی: آبی (نیلی) — چرخه هفدهم (گزارش یازدهم مالک):
           PrimaryColor از Teal (سبز) به Blue تغییر کرد تا با اسکرین‌شات‌های
           طراحی و هویت بصری محصول (سایدبار #16355E→#1C4E89 و لهجهٔ #1565C0)
           یکدست شود؛ پیش‌تر همهٔ دکمه‌ها/آیکون‌ها/های‌لایت‌ها سبز دیده می‌شدند
         • فونت وزیرمتن جاسازی‌شده داخل exe (Assets/Fonts) — بدون نیاز به نصب فونت
         • ناوبری و سرویس‌ها در App.xaml.cs ثبت می‌شوند
         ═══════════════════════════════════════════════════════════ -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Blue"
                                             SecondaryColor="Indigo" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══ منابع پویای ظاهر — چرخه بیستم (گزارش چهاردهم مالک) ═══
                 ThemeService این منابع را در زمان اجرا بازنویسی می‌کند؛
                 سبک‌ها با DynamicReference می‌خوانند تا تغییر فونت/سایز/گوشه
                 بی‌درنگ روی همهٔ پنجره‌ها اعمال شود. مقادیر اینجا پیش‌فرض‌های
                 محصول‌اند (وزیرمتن ۱۳ / گوشهٔ ۸ / چگالی استاندارد). -->
            <FontFamily x:Key="App.FontFamily">pack://application:,,,/Assets/Fonts/#Vazirmatn</FontFamily>
            <system:Double x:Key="App.BaseFontSize">13</system:Double>
            <!-- ═══ چرخهٔ بیست‌وششم (گزارش هجدهم مالک) — فونت متن‌های عددی/کدی ═══
                 «اعدادی که فارسی شده‌اند، فونت روی آن‌ها اعمال نمی‌شود و با فونت
                 پیش‌فرض نمایش می‌دهند»: پیش‌تر ۱۹۵ جای برنامه فونت هاردکد Consolas
                 داشتند؛ Consolas ارقام فارسی ندارد و WPF برای نویسه‌های فارسی به
                 فونت سیستم fallback می‌کرد → ارقام فارسی با فونتی متفاوت از انتخاب
                 کاربر رندر می‌شدند. اکنون همهٔ آن‌جاها این منبع پویا را می‌خوانند
                 که ThemeService آن را به همان فونت انتخابی کاربر مقداردهی می‌کند —
                 ارقام فارسی/لاتین هم‌خانوادهٔ بقیهٔ متن برنامه دیده می‌شوند. -->
            <FontFamily x:Key="App.CodeFont">pack://application:,,,/Assets/Fonts/#Vazirmatn</FontFamily>
            <!-- ═══ چرخه ۲۴ — مقیاس سراسری فونت/رابط ═══ «اندازهٔ فونت فقط صفحهٔ تم را
                 تغییر می‌داد نه کل برنامه را» — این تبدیل روی محتوای پنجرهٔ اصلی
                 اعمال می‌شود و همه‌چیز (متن/آیکون/فاصله‌ها) هماهنگ و پیوسته مقیاس
                 می‌گیرد؛ مقدار پایه = BaseFontSize ÷ ۱۳ و از سوی ThemeService
                 بازنویسی می‌شود (مثل زوم مرورگر). -->
            <ScaleTransform x:Key="App.FontScaleTransform" ScaleX="1" ScaleY="1" />
            <CornerRadius x:Key="App.CardRadius">8</CornerRadius>
            <Thickness x:Key="App.CardPadding">20</Thickness>
            <system:Boolean x:Key="App.AnimationsEnabled">True</system:Boolean>
            <system:String x:Key="App.CurrencyLabel">ریال</system:String>
            <!-- رنگ‌های منوی کناری — چرخه بیست‌ویکم (گزارش پانزدهم مالک):
                 «تغییر رنگ، رنگ منوی کناری را عوض نمی‌کند» — ThemeService این دو
                 منبع پویا را با تعویض تم/رنگ سفارشی منو بازنویسی می‌کند؛
                 مقادیر اینجا گرادیان پیش‌فرض آبی رسمی طرح است.
                 ═══ چرخه بیست‌وسوم (گزارش شانزدهم مالک): «رنگ منو تا ری‌استارت
                 عوض نمی‌شود» — ریشه: قلم‌های تعریف‌شده در XAML توسط بهینه‌ساز
                 BAML فریز (IsFrozen) می‌شوند؛ بازنویسی رنگ در همان نمونه ممکن
                 نبود و جایگزینی کل منبع هم با StaticResource دیده نمی‌شد.
                 رفع قطعی: به‌جای دو قلمِ جامد، یک «قلم گرادیانی کامل» به‌صورت
                 منبع پویا (App.SidebarBrush) تعریف شد؛ ThemeService هر بار
                 قلمِ گرادیانیِ نو می‌سازد و کل منبع را جایگزین می‌کند و سایدبار
                 با DynamicReference بی‌درنگ تازه می‌شود. -->
            <LinearGradientBrush x:Key="App.SidebarBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#16355E" Offset="0" />
                <GradientStop Color="#1C4E89" Offset="1" />
            </LinearGradientBrush>

            <!-- فونت سراسری — وزیرمتن به‌صورت Resource داخل خود exe جاسازی شده است
                 (Assets/Fonts — مجوز آزاد OFL)؛ ارجاع pack URI بدون توجه به فونت‌های
                 نصب‌شدهٔ ویندوز کار می‌کند و روی هر دستگاهی اعمال می‌شود.
                 ارجاع به «پوشه» (نه فایل تکی) عمدی است تا همه وزن‌ها فعال باشند.
                 چرخه بیستم: مقدار از منبع پویای App.FontFamily خوانده می‌شود تا
                 تغییر فونت از تنظیمات روی همهٔ پنجره‌ها اثر کند. -->
            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="{DynamicResource App.FontFamily}" />
                <Setter Property="FontSize" Value="{DynamicResource App.BaseFontSize}" />
                <Setter Property="FlowDirection" Value="RightToLeft" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
                <!-- آیکون رسمی محصول — روی همه پنجره‌های برنامه (نوار عنوان و Taskbar) -->
                <Setter Property="Icon" Value="/Assets/appicon.ico" />
                <!-- ═══ چرخهٔ سی‌ودوم (گزارش مالک) — عنوان شناور همهٔ فیلدهای فرم ═══
                     «در فرم‌ها عنوان فیلدها وجود ندارد و فقط داخل خود فیلدها حالت
                     نمایشی دارد؛ وقتی فیلدی پر بشود نمی‌شود تشخیص داد عنوانش چیست.
                     همشون رو مانند کادر کد ملی بکن که هنگام پر شدن عنوانش بره بالاش»
                     ریشه: فیلد کد ملی با استایل MaterialDesignOutlinedTextBox ساخته
                     شده که در MaterialDesignThemes 5.3.2 بر پایهٔ FloatingHint است
                     (عنوان هنگام پر شدن به بالای کادر می‌رود) ولی بقیهٔ فیلدها با
                     استایل پیش‌فرض filled ساخته می‌شوند که Hint فقط به‌صورت placeholder
                     داخل کادر است و با تایپ کاربر برای همیشه ناپدید می‌شود.
                     راه‌حل: خاصیت ضمیمهٔ HintAssist.IsFloating با FrameworkProperty-
                     MetadataOptions.Inherits ثبت شده است — یک‌بار روی استایل پنجره
                     تنظیم می‌شود و «همهٔ» TextBox/ComboBox/PasswordBox در «همهٔ»
                     فرم‌ها و پنجره‌های برنامه ارث می‌برند: عنوان هر فیلدی هنگام
                     فوکوس یا پر شدن به بالای کادر شناور می‌شود (رفتار Material
                     استاندارد). انتخابگر تاریخ/ساعت برنامه هم داخلش TextBox با Hint
                     دارد و همین‌طور شناور می‌شود. -->
                <Setter Property="materialDesign:HintAssist.IsFloating" Value="True" />
            </Style>

            <!-- سبک کارت‌های MaterialDesign — گوشه و پدینگ از تم فعال
                 (هر پوسته گوشه و چگالی خودش را دارد — ظاهر همهٔ عناصر) -->
            <Style TargetType="materialDesign:Card">
                <Setter Property="UniformCornerRadius" Value="{DynamicResource App.CardRadius}" />
                <Setter Property="Padding" Value="{DynamicResource App.CardPadding}" />
            </Style>

            <!-- ═══ وسط‌چین عمودی + کشش افقی محتوای سلول‌های همهٔ جدول‌های برنامه ═══
                 چرخه بیست‌ویکم (گزارش پانزدهم مالک): «محتویات سطرهای لیست‌ها رو
                 وسط چین عمودی بکن که همه محتوا در یک راستا باشن — الان بعضی
                 از فیلدها رو بالای سلول میاره»
                 تمپلیت پیش‌فرض DataGridCell کتابخانه، ContentPresenter را بدون
                 تراز عمودی می‌گذارد و محتوا در سلول‌های بلند بالای سلول می‌چسبد؛
                 این تمپلیت همان Border/Background/BorderBrush استایل MaterialDesign
                 (که تریگرهای انتخاب/هاور روی آن‌ها اثر می‌گذارند) را حفظ و صرفاً
                 تراز عمودی را از VerticalContentAlignment می‌خواند.
                 ═══ چرخهٔ سی‌وسوم (گزارش نوزدهم مالک — قانون هم‌کلاسی‌ها) ═══
                 «کنترل ساعت در برنامهٔ کاری ثابت مانده و در وسط سلول نشسته»:
                 HorizontalContentAlignment=Stretch هم پیش‌فرض شد و ContentPresenter
                 تراز افقی را از آن می‌خواند — محتوای قالبیِ همهٔ سلول‌ها (نه فقط
                 انتخابگر ساعت) در تمام عرض سلول می‌نشیند؛ در غیر این صورت عنصر
                 قالب بدون تراز صریح، در تراز پیش‌فرض قالب کتابخانه می‌ماند. -->
            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══ سبک دکمه‌های آیکونی ردیف‌های جدول ═══
                 چرخه بیست‌ویکم: «کلیدهای عملیاتی آخر سطرها ناقص دیده می‌شوند» —
                 حاشیهٔ داخلی فشرده + حداقل عرض تضمینی تا هیچ دکمه‌ای در ستون
                 عملیات بریده نشود؛ همهٔ گریدها از این سبک استفاده می‌کنند. -->
            <Style x:Key="App.RowIconButton" TargetType="Button"
                   BasedOn="{StaticResource MaterialDesignIconForegroundButton}">
                <Setter Property="Padding" Value="4" />
                <Setter Property="MinWidth" Value="26" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="Margin" Value="1,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- سبک متن عنوان بخش‌ها -->
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="0,4,0,12" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
            </Style>

            <!-- مبدل شیء غیرتهی به فعال بودن دکمه -->
            <converters:NotNullToBoolConverter x:Key="NotNullToBool" />

            <!-- مبدل‌های مشترک گام U0 — تاریخ شمسی و دیدپذیری و مبلغ -->
            <converters:ShamsiDateConverter x:Key="ShamsiDate" />
            <converters:ShamsiDateTimeConverter x:Key="ShamsiDateTime" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:Base64ToImageConverter x:Key="Base64ToImage" />
            <converters:BoolToTextConverter x:Key="BoolToText" />
            <converters:NullToBoolConverter x:Key="NullToBool" />
            <converters:ZeroToCollapsedConverter x:Key="ZeroToCollapsed" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
            <converters:InvertBoolConverter x:Key="InvertBool" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <converters:SectionToVisibilityConverter x:Key="SectionToVisibility" />
            <!-- چرخه بیست‌وسوم: مبدل سراسری ارقام فارسی — همهٔ ستون‌های جدول‌ها -->
            <converters:PersianDigitsConverter x:Key="PersianDigits" />
            <!-- چرخه ۲۴: مبدل برچسب فارسی متغیرهای قالب چاپ -->
            <converters:VariableLabelConverter x:Key="VariableLabel" />
            <!-- چرخه ۲۴: مبدل رنگ آیکون‌های منو (حالت رنگی/یکدست) -->
            <converters:IconTintConverter x:Key="IconTint" />
            <converters:IconTintMultiConverter x:Key="IconTintMulti" />
            <!-- چرخهٔ بیست‌وهفتم: مبدل مجموعهٔ آیکون‌ها (کلاسیک/مدرن/مینیمال) -->
            <converters:IconSetKindConverter x:Key="IconSetKind" />
            <!-- چرخهٔ بیست‌وهشتم: مبدل رنگ متمایز هر بیمه در لیست بیماران -->
            <converters:InsuranceBrushConverter x:Key="InsuranceBrush" />
            <!-- چرخهٔ بیست‌ونهم: مبدل کد HEX → قلم‌وی — نمونهٔ رنگِ مؤثر تنظیمات تم -->
            <converters:HexToBrushConverter x:Key="HexToBrush" />
            <!-- چرخه بیست‌وسوم: مبدل bool → «فعال/غیرفعال» فارسی — ستون وضعیت بیمه/تعرفه -->
            <converters:BoolToFaTextConverter x:Key="BoolToFaText" />
            <converters:CurrencyRialConverter x:Key="CurrencyRial" />
            <!-- چرخه بیستم: مبدل ریال ↔ نمایش برای کادرهای ورود مبلغ -->
            <converters:MoneyRialConverter x:Key="MoneyRial" />
            <!-- چرخه بیستم: مبلغ با واحد پول نمایشی — ریال/تومان از تنظیمات -->
            <converters:MoneyWithUnitConverter x:Key="MoneyWithUnit" />

            <!-- سبک کارت آمار داشبورد -->
            <Style x:Key="StatCard" TargetType="materialDesign:Card">
                <Setter Property="Padding" Value="20" />
                <Setter Property="Margin" Value="6" />
                <Setter Property="UniformCornerRadius" Value="14" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
