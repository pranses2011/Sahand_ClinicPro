<Application x:Class="Sahand.ClinicPro.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Sahand.ClinicPro.Desktop"
             xmlns:converters="clr-namespace:Sahand.ClinicPro.Desktop.Converters"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnMainWindowClose">
    <!-- ═══════════════════════════════════════════════════════════
         نقطه ورود کلاینت دسکتاپ درمانگاه سهند — گام ۱۰
         • تم Material Design 3 (روشن/تیره با ThemeService)
         • رنگ سازمانی: آبی (نیلی) — چرخه هفدهم (گزارش یازدهم مالک):
           PrimaryColor از Teal (سبز) به Blue تغییر کرد تا با اسکرین‌شات‌های
           طراحی و هویت بصری محصول (سایدبار #16355E→#1C4E89 و لهجهٔ #1565C0)
           یکدست شود؛ پیش‌تر همهٔ دکمه‌ها/آیکون‌ها/های‌لایت‌ها سبز دیده می‌شدند
         • فونت وزیرمتن جاسازی‌شده داخل exe (Assets/Fonts) — بدون نیاز به نصب فونت
         • ناوبری و سرویس‌ها در App.xaml.cs ثبت می‌شوند
         ═══════════════════════════════════════════════════════════ -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Blue"
                                             SecondaryColor="Indigo" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══ منابع پویای ظاهر — چرخه بیستم (گزارش چهاردهم مالک) ═══
                 ThemeService این منابع را در زمان اجرا بازنویسی می‌کند؛
                 سبک‌ها با DynamicReference می‌خوانند تا تغییر فونت/سایز/گوشه
                 بی‌درنگ روی همهٔ پنجره‌ها اعمال شود. مقادیر اینجا پیش‌فرض‌های
                 محصول‌اند (وزیرمتن ۱۳ / گوشهٔ ۸ / چگالی استاندارد). -->
            <FontFamily x:Key="App.FontFamily">pack://application:,,,/Assets/Fonts/#Vazirmatn</FontFamily>
            <system:Double x:Key="App.BaseFontSize">13</system:Double>
            <CornerRadius x:Key="App.CardRadius">8</CornerRadius>
            <Thickness x:Key="App.CardPadding">20</Thickness>
            <system:Boolean x:Key="App.AnimationsEnabled">True</system:Boolean>
            <system:String x:Key="App.CurrencyLabel">ریال</system:String>

            <!-- فونت سراسری — وزیرمتن به‌صورت Resource داخل خود exe جاسازی شده است
                 (Assets/Fonts — مجوز آزاد OFL)؛ ارجاع pack URI بدون توجه به فونت‌های
                 نصب‌شدهٔ ویندوز کار می‌کند و روی هر دستگاهی اعمال می‌شود.
                 ارجاع به «پوشه» (نه فایل تکی) عمدی است تا همه وزن‌ها فعال باشند.
                 چرخه بیستم: مقدار از منبع پویای App.FontFamily خوانده می‌شود تا
                 تغییر فونت از تنظیمات روی همهٔ پنجره‌ها اثر کند. -->
            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="{DynamicResource App.FontFamily}" />
                <Setter Property="FontSize" Value="{DynamicResource App.BaseFontSize}" />
                <Setter Property="FlowDirection" Value="RightToLeft" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
                <!-- آیکون رسمی محصول — روی همه پنجره‌های برنامه (نوار عنوان و Taskbar) -->
                <Setter Property="Icon" Value="/Assets/appicon.ico" />
            </Style>

            <!-- سبک کارت‌های MaterialDesign — گوشه و پدینگ از تم فعال
                 (هر پوسته گوشه و چگالی خودش را دارد — ظاهر همهٔ عناصر) -->
            <Style TargetType="materialDesign:Card">
                <Setter Property="UniformCornerRadius" Value="{DynamicResource App.CardRadius}" />
                <Setter Property="Padding" Value="{DynamicResource App.CardPadding}" />
            </Style>

            <!-- سبک متن عنوان بخش‌ها -->
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="0,4,0,12" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
            </Style>

            <!-- مبدل شیء غیرتهی به فعال بودن دکمه -->
            <converters:NotNullToBoolConverter x:Key="NotNullToBool" />

            <!-- مبدل‌های مشترک گام U0 — تاریخ شمسی و دیدپذیری و مبلغ -->
            <converters:ShamsiDateConverter x:Key="ShamsiDate" />
            <converters:ShamsiDateTimeConverter x:Key="ShamsiDateTime" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:Base64ToImageConverter x:Key="Base64ToImage" />
            <converters:BoolToTextConverter x:Key="BoolToText" />
            <converters:NullToBoolConverter x:Key="NullToBool" />
            <converters:ZeroToCollapsedConverter x:Key="ZeroToCollapsed" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
            <converters:InvertBoolConverter x:Key="InvertBool" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <converters:SectionToVisibilityConverter x:Key="SectionToVisibility" />
            <converters:CurrencyRialConverter x:Key="CurrencyRial" />
            <!-- چرخه بیستم: مبدل ریال ↔ نمایش برای کادرهای ورود مبلغ -->
            <converters:MoneyRialConverter x:Key="MoneyRial" />
            <!-- چرخه بیستم: مبلغ با واحد پول نمایشی — ریال/تومان از تنظیمات -->
            <converters:MoneyWithUnitConverter x:Key="MoneyWithUnit" />

            <!-- سبک کارت آمار داشبورد -->
            <Style x:Key="StatCard" TargetType="materialDesign:Card">
                <Setter Property="Padding" Value="20" />
                <Setter Property="Margin" Value="6" />
                <Setter Property="UniformCornerRadius" Value="14" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
