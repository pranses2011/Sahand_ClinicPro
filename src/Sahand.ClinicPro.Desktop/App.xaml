<Application x:Class="Sahand.ClinicPro.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Sahand.ClinicPro.Desktop"
             xmlns:converters="clr-namespace:Sahand.ClinicPro.Desktop.Converters"
             xmlns:controls="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnMainWindowClose">
    <!-- ═══════════════════════════════════════════════════════════
         نقطه ورود کلاینت دسکتاپ درمانگاه سهند — گام ۱۰
         • تم Material Design 3 (روشن/تیره با ThemeService)
         • رنگ سازمانی: آبی (نیلی) — چرخه هفدهم (گزارش یازدهم مالک):
           PrimaryColor از Teal (سبز) به Blue تغییر کرد تا با اسکرین‌شات‌های
           طراحی و هویت بصری محصول (سایدبار #16355E→#1C4E89 و لهجهٔ #1565C0)
           یکدست شود؛ پیش‌تر همهٔ دکمه‌ها/آیکون‌ها/های‌لایت‌ها سبز دیده می‌شدند
         • فونت وزیرمتن جاسازی‌شده داخل exe (Assets/Fonts) — بدون نیاز به نصب فونت
         • ناوبری و سرویس‌ها در App.xaml.cs ثبت می‌شوند
         ═══════════════════════════════════════════════════════════ -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Blue"
                                             SecondaryColor="Indigo" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══ منابع پویای ظاهر — چرخه بیستم (گزارش چهاردهم مالک) ═══
                 ThemeService این منابع را در زمان اجرا بازنویسی می‌کند؛
                 سبک‌ها با DynamicReference می‌خوانند تا تغییر فونت/سایز/گوشه
                 بی‌درنگ روی همهٔ پنجره‌ها اعمال شود. مقادیر اینجا پیش‌فرض‌های
                 محصول‌اند (وزیرمتن ۱۳ / گوشهٔ ۸ / چگالی استاندارد). -->
            <FontFamily x:Key="App.FontFamily">pack://application:,,,/Assets/Fonts/#Vazirmatn</FontFamily>
            <system:Double x:Key="App.BaseFontSize">13</system:Double>
            <!-- ═══ چرخهٔ بیست‌وششم (گزارش هجدهم مالک) — فونت متن‌های عددی/کدی ═══
                 «اعدادی که فارسی شده‌اند، فونت روی آن‌ها اعمال نمی‌شود و با فونت
                 پیش‌فرض نمایش می‌دهند»: پیش‌تر ۱۹۵ جای برنامه فونت هاردکد Consolas
                 داشتند؛ Consolas ارقام فارسی ندارد و WPF برای نویسه‌های فارسی به
                 فونت سیستم fallback می‌کرد → ارقام فارسی با فونتی متفاوت از انتخاب
                 کاربر رندر می‌شدند. اکنون همهٔ آن‌جاها این منبع پویا را می‌خوانند
                 که ThemeService آن را به همان فونت انتخابی کاربر مقداردهی می‌کند —
                 ارقام فارسی/لاتین هم‌خانوادهٔ بقیهٔ متن برنامه دیده می‌شوند. -->
            <FontFamily x:Key="App.CodeFont">pack://application:,,,/Assets/Fonts/#Vazirmatn</FontFamily>
            <!-- ═══ چرخه ۲۴ — مقیاس سراسری فونت/رابط ═══ «اندازهٔ فونت فقط صفحهٔ تم را
                 تغییر می‌داد نه کل برنامه را» — این تبدیل روی محتوای پنجرهٔ اصلی
                 اعمال می‌شود و همه‌چیز (متن/آیکون/فاصله‌ها) هماهنگ و پیوسته مقیاس
                 می‌گیرد؛ مقدار پایه = BaseFontSize ÷ ۱۳ و از سوی ThemeService
                 بازنویسی می‌شود (مثل زوم مرورگر). -->
            <!-- ═══ چرخهٔ ۷۴ — قلم رنگ سطرهای یک‌درمیان (گوره‌خری) ═══
                 گزارش مالک: «تمامی لیست ها در تمامی صفحات و فرم ها رو بصورت
                 گوره خری (رنگ های یک در میان) دربیار تا زیباتر دیده بشه و تشخیص
                 سطرها راحت باشه». این قلم با تم هم‌رنگ می‌شود (ThemeService):
                 روشن = #F6F9FC (آبی‌فیروزه‌ای بسیار ملایم) / تیره = #28303A. -->
            <SolidColorBrush x:Key="App.ZebraRowBrush" Color="#F6F9FC" />
            <!-- ═══ چرخهٔ سی‌وهفتم (ریشهٔ قطعی پنج گزارش پیاپی سایدبار + بریدگی ساعت) ═══
                 MaterialDesign3.Defaults.xaml (که در MergedDictionaries بالا ادغام شده)
                 برای «همهٔ ToggleButtonها» استایل ضمنی تعریف می‌کند:
                     <Style TargetType="ToggleButton"
                            BasedOn="{StaticResource MaterialDesignSwitchToggleButton}" />
                 یعنی هر تاگلی که Style صریح نداشته باشد، ابعاد سوییچِ iOS-مانند
                 (Height=32 و Width=52) را به ارث می‌برد و قالب سفارشی‌اش در همان
                 قاب کوچک زندانی می‌شود — سربرگ گروه‌های منوی کناری به قرصِ ۲۶px
                 با متن له‌شده فرومی‌رفت و انتخابگر ساعت، متن «10:30» را به «10:3»
                 و آیکونش را به نصف برید (قانون هم‌کلاسی‌ها: هر دو از یک ریشه).
                 پادزهر سراسری: این استایلِ خالیِ صریح زنجیرهٔ ارث‌بری را کامل قطع
                 می‌کند (استایل صریح مقدم بر استایل ضمنی است) و مصرف‌کننده‌اش
                 Template محلی خودش را با ابعاد طبیعی می‌سازد. ابعاد را تعیین
                 نکنید تا تداخلی با Measure طبیعی محتوا ایجاد نشود. -->
            <Style x:Key="App.PlainToggleButton" TargetType="ToggleButton" />
            <CornerRadius x:Key="App.CardRadius">8</CornerRadius>
            <Thickness x:Key="App.CardPadding">20</Thickness>
            <system:Boolean x:Key="App.AnimationsEnabled">True</system:Boolean>
            <system:String x:Key="App.CurrencyLabel">ریال</system:String>
            <!-- رنگ‌های منوی کناری — چرخه بیست‌ویکم (گزارش پانزدهم مالک):
                 «تغییر رنگ، رنگ منوی کناری را عوض نمی‌کند» — ThemeService این دو
                 منبع پویا را با تعویض تم/رنگ سفارشی منو بازنویسی می‌کند؛
                 مقادیر اینجا گرادیان پیش‌فرض آبی رسمی طرح است.
                 ═══ چرخه بیست‌وسوم (گزارش شانزدهم مالک): «رنگ منو تا ری‌استارت
                 عوض نمی‌شود» — ریشه: قلم‌های تعریف‌شده در XAML توسط بهینه‌ساز
                 BAML فریز (IsFrozen) می‌شوند؛ بازنویسی رنگ در همان نمونه ممکن
                 نبود و جایگزینی کل منبع هم با StaticResource دیده نمی‌شد.
                 رفع قطعی: به‌جای دو قلمِ جامد، یک «قلم گرادیانی کامل» به‌صورت
                 منبع پویا (App.SidebarBrush) تعریف شد؛ ThemeService هر بار
                 قلمِ گرادیانیِ نو می‌سازد و کل منبع را جایگزین می‌کند و سایدبار
                 با DynamicReference بی‌درنگ تازه می‌شود. -->
            <LinearGradientBrush x:Key="App.SidebarBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#16355E" Offset="0" />
                <GradientStop Color="#1C4E89" Offset="1" />
            </LinearGradientBrush>

            <!-- فونت سراسری — وزیرمتن به‌صورت Resource داخل خود exe جاسازی شده است
                 (Assets/Fonts — مجوز آزاد OFL)؛ ارجاع pack URI بدون توجه به فونت‌های
                 نصب‌شدهٔ ویندوز کار می‌کند و روی هر دستگاهی اعمال می‌شود.
                 ارجاع به «پوشه» (نه فایل تکی) عمدی است تا همه وزن‌ها فعال باشند.
                 چرخه بیستم: مقدار از منبع پویای App.FontFamily خوانده می‌شود تا
                 تغییر فونت از تنظیمات روی همهٔ پنجره‌ها اثر کند. -->
            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="{DynamicResource App.FontFamily}" />
                <Setter Property="FontSize" Value="{DynamicResource App.BaseFontSize}" />
                <Setter Property="FlowDirection" Value="RightToLeft" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
                <!-- آیکون رسمی محصول — روی همه پنجره‌های برنامه (نوار عنوان و Taskbar) -->
                <Setter Property="Icon" Value="/Assets/appicon.ico" />
                <!-- ═══ چرخهٔ سی‌ودوم (گزارش مالک) — عنوان شناور همهٔ فیلدهای فرم ═══
                     «در فرم‌ها عنوان فیلدها وجود ندارد و فقط داخل خود فیلدها حالت
                     نمایشی دارد؛ وقتی فیلدی پر بشود نمی‌شود تشخیص داد عنوانش چیست.
                     همشون رو مانند کادر کد ملی بکن که هنگام پر شدن عنوانش بره بالاش»
                     ریشه: فیلد کد ملی با استایل MaterialDesignOutlinedTextBox ساخته
                     شده که در MaterialDesignThemes 5.3.2 بر پایهٔ FloatingHint است
                     (عنوان هنگام پر شدن به بالای کادر می‌رود) ولی بقیهٔ فیلدها با
                     استایل پیش‌فرض filled ساخته می‌شوند که Hint فقط به‌صورت placeholder
                     داخل کادر است و با تایپ کاربر برای همیشه ناپدید می‌شود.
                     راه‌حل: خاصیت ضمیمهٔ HintAssist.IsFloating با FrameworkProperty-
                     MetadataOptions.Inherits ثبت شده است — یک‌بار روی استایل پنجره
                     تنظیم می‌شود و «همهٔ» TextBox/ComboBox/PasswordBox در «همهٔ»
                     فرم‌ها و پنجره‌های برنامه ارث می‌برند: عنوان هر فیلدی هنگام
                     فوکوس یا پر شدن به بالای کادر شناور می‌شود (رفتار Material
                     استاندارد). انتخابگر تاریخ/ساعت برنامه هم داخلش TextBox با Hint
                     دارد و همین‌طور شناور می‌شود. -->
                <Setter Property="materialDesign:HintAssist.IsFloating" Value="True" />
            </Style>

            <!-- ═══════════════════════════════════════════════════════════
                 سبک‌های ضمنی سراسری فیلدها — چرخهٔ چهل‌وسوم (گزارش مالک):
                 «یا همشون رو مانند کادر کد ملی بکن که هنگام پر شدن عنوانش
                 بره بالاش و نشون بده و یا برای همشون عنوان بزار» + «تمامی
                 فیلدهایی که بصورت کمبوباس هستند… قابلیت تایپ کردن هم بهشون
                 اضافه بکن». کادر کد ملی از استایل MaterialDesignOutlinedTextBox
                 ساخته شده که عنوان شناور (FloatingHint) دارد؛ پیش‌تر «همهٔ»
                 فیلدهای بدون استایلِ صریح با استایل filled پیش‌فرض ساخته
                 می‌شدند که Hint فقط placeholder داخلی است و با پر شدن برای
                 همیشه ناپدید می‌شد. اکنون استایل ضمنی «خط‌دار» برای هر سهٔ
                 TextBox/ComboBox/PasswordBox تثبیت می‌شود: عنوانِ هر فیلد
                 هنگام فوکوس/پر شدن به بالای کادر می‌رود — همان ظاهری که مالک
                 به‌عنوان نمونهٔ درست (کد ملی) نشان داده بود.
                 کمبوباکس‌ها هم‌زمان «جستجوی تایپی» می‌گیرند (پالایش زندهٔ
                 «شامل‌بودن» با نرمال‌سازی فارسی — رفتار Controls.ComboBoxSearch).
                 فیلدهای دارای استایل صریح دست‌نخورده می‌مانند.
                 ═══════════════════════════════════════════════════════════ -->
            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <!-- ارث‌بری عنوان شناور از استایل پنجره (چرخهٔ ۳۲) حفظ می‌شود -->
                <Setter Property="materialDesign:HintAssist.IsFloating" Value="True" />
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                <Setter Property="materialDesign:HintAssist.IsFloating" Value="True" />
                <!-- جستجوی تایپی برای همهٔ کمبوباکس‌ها؛ خروج صریح با
                     controls:ComboBoxSearch.IsEnabled="False" -->
                <Setter Property="controls:ComboBoxSearch.IsEnabled" Value="True" />
            </Style>
            <Style TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
                <Setter Property="materialDesign:HintAssist.IsFloating" Value="True" />
            </Style>

            <!-- سبک کارت‌های MaterialDesign — گوشه و پدینگ از تم فعال
                 (هر پوسته گوشه و چگالی خودش را دارد — ظاهر همهٔ عناصر) -->
            <Style TargetType="materialDesign:Card">
                <Setter Property="UniformCornerRadius" Value="{DynamicResource App.CardRadius}" />
                <Setter Property="Padding" Value="{DynamicResource App.CardPadding}" />
            </Style>

            <!-- ═══ وسط‌چین عمودی + کشش افقی محتوای سلول‌های همهٔ جدول‌های برنامه ═══
                 چرخه بیست‌ویکم (گزارش پانزدهم مالک): «محتویات سطرهای لیست‌ها رو
                 وسط چین عمودی بکن که همه محتوا در یک راستا باشن — الان بعضی
                 از فیلدها رو بالای سلول میاره»
                 تمپلیت پیش‌فرض DataGridCell کتابخانه، ContentPresenter را بدون
                 تراز عمودی می‌گذارد و محتوا در سلول‌های بلند بالای سلول می‌چسبد؛
                 این تمپلیت همان Border/Background/BorderBrush استایل MaterialDesign
                 (که تریگرهای انتخاب/هاور روی آن‌ها اثر می‌گذارند) را حفظ و صرفاً
                 تراز عمودی را از VerticalContentAlignment می‌خواند.
                 ═══ چرخهٔ سی‌وسوم (گزارش نوزدهم مالک — قانون هم‌کلاسی‌ها) ═══
                 «کنترل ساعت در برنامهٔ کاری ثابت مانده و در وسط سلول نشسته»:
                 HorizontalContentAlignment=Stretch هم پیش‌فرض شد و ContentPresenter
                 تراز افقی را از آن می‌خواند — محتوای قالبیِ همهٔ سلول‌ها (نه فقط
                 انتخابگر ساعت) در تمام عرض سلول می‌نشیند؛ در غیر این صورت عنصر
                 قالب بدون تراز صریح، در تراز پیش‌فرض قالب کتابخانه می‌ماند. -->
            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══ سبک دکمه‌های آیکونی ردیف‌های جدول ═══
                 چرخه بیست‌ویکم: «کلیدهای عملیاتی آخر سطرها ناقص دیده می‌شوند» —
                 حاشیهٔ داخلی فشرده + حداقل عرض تضمینی تا هیچ دکمه‌ای در ستون
                 عملیات بریده نشود؛ همهٔ گریدها از این سبک استفاده می‌کنند. -->
            <Style x:Key="App.RowIconButton" TargetType="Button"
                   BasedOn="{StaticResource MaterialDesignIconForegroundButton}">
                <Setter Property="Padding" Value="4" />
                <Setter Property="MinWidth" Value="26" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="Margin" Value="1,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- سبک متن عنوان بخش‌ها -->
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="0,4,0,12" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
            </Style>

            <!-- مبدل شیء غیرتهی به فعال بودن دکمه -->
            <converters:NotNullToBoolConverter x:Key="NotNullToBool" />

            <!-- مبدل‌های مشترک گام U0 — تاریخ شمسی و دیدپذیری و مبلغ -->
            <converters:ShamsiDateConverter x:Key="ShamsiDate" />
            <converters:ShamsiDateTimeConverter x:Key="ShamsiDateTime" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:Base64ToImageConverter x:Key="Base64ToImage" />
            <converters:BoolToTextConverter x:Key="BoolToText" />
            <converters:NullToBoolConverter x:Key="NullToBool" />
            <converters:ZeroToCollapsedConverter x:Key="ZeroToCollapsed" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
            <converters:InvertBoolConverter x:Key="InvertBool" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <converters:SectionToVisibilityConverter x:Key="SectionToVisibility" />
            <!-- چرخه بیست‌وسوم: مبدل سراسری ارقام فارسی — همهٔ ستون‌های جدول‌ها -->
            <converters:PersianDigitsConverter x:Key="PersianDigits" />
            <!-- چرخه ۲۴: مبدل برچسب فارسی متغیرهای قالب چاپ -->
            <converters:VariableLabelConverter x:Key="VariableLabel" />
            <!-- چرخه ۲۴: مبدل رنگ آیکون‌های منو (حالت رنگی/یکدست) -->
            <converters:IconTintConverter x:Key="IconTint" />
            <converters:IconTintMultiConverter x:Key="IconTintMulti" />
            <!-- چرخهٔ بیست‌وهفتم: مبدل مجموعهٔ آیکون‌ها (کلاسیک/مدرن/مینیمال) -->
            <converters:IconSetKindConverter x:Key="IconSetKind" />
            <!-- چرخهٔ بیست‌وهشتم: مبدل رنگ متمایز هر بیمه در لیست بیماران -->
            <converters:InsuranceBrushConverter x:Key="InsuranceBrush" />
            <!-- چرخهٔ سی‌ونه‌م: مبدل فهرست خالی → دیدپذیری — راهنماهای حالت خالی (انبار مصرفی بدون قلم) -->
            <converters:EmptyListToVisibilityConverter x:Key="EmptyListToVisibility" />
            <!-- چرخهٔ ۷۵: مبدل چندمقداری جای‌نگهدار کارت/بخش مخفی داشبورد —
                 مخفی + حالت شخصی‌سازی = قاب نقطه‌چین راه بازگشت -->
            <converters:HiddenPlaceholderVisibilityConverter x:Key="HiddenPlaceholderVis" />
            <!-- چرخهٔ بیست‌ونهم: مبدل کد HEX → قلم‌وی — نمونهٔ رنگِ مؤثر تنظیمات تم -->
            <converters:HexToBrushConverter x:Key="HexToBrush" />
            <!-- چرخهٔ سی‌وپنجم: مبدل هگز → براش با حالت «soft» (پس‌زمینهٔ ملایم ۱۴٪)
                 — رنگ کادر پیام‌های سرور لایسنس از پنل فروشنده -->
            <converters:HexBrushConverter x:Key="HexBrush" />
            <!-- چرخه بیست‌وسوم: مبدل bool → «فعال/غیرفعال» فارسی — ستون وضعیت بیمه/تعرفه -->
            <converters:BoolToFaTextConverter x:Key="BoolToFaText" />
            <converters:CurrencyRialConverter x:Key="CurrencyRial" />
            <!-- چرخه بیستم: مبدل ریال ↔ نمایش برای کادرهای ورود مبلغ -->
            <converters:MoneyRialConverter x:Key="MoneyRial" />
            <!-- چرخه بیستم: مبلغ با واحد پول نمایشی — ریال/تومان از تنظیمات -->
            <converters:MoneyWithUnitConverter x:Key="MoneyWithUnit" />
            <!-- چرخهٔ ۴۸: مبدلهای چارت دندان‌شکل — هندسهٔ جنس دندان از شمارهٔ FDI
                 + قلم خوانای شماره بر اساس رنگ وضعیت (گزارش مالک: نشانگرها به‌جای
                 کادر مربع باید خودِ دندان باشند) -->
            <converters:ToothShapeConverter x:Key="ToothShape" />
            <converters:ToothNumberBrushConverter x:Key="ToothNumberBrush" />

            <!-- سبک کارت آمار داشبورد -->
            <Style x:Key="StatCard" TargetType="materialDesign:Card">
                <Setter Property="Padding" Value="20" />
                <Setter Property="Margin" Value="6" />
                <Setter Property="UniformCornerRadius" Value="14" />
            </Style>

            <!-- ═══ چرخهٔ چهل‌وچهارم (گزارش مالک) — سبک ضمنی سراسری تولتیپ‌ها ═══
                 «تول تیپ ها با فاصلهٔ زیادی نسبت به کلید و نشانگر ماوس نشان داده
                 میشوند» (داشبورد، کاشی‌های میانبر و فرم افزودن میانبر).
                 ریشه: تولتیپِ بدون استایل، با جای‌گذاری پیش‌فرضِ «نسبت به گوشهٔ
                 عنصر» رندر می‌شود؛ روی دکمه‌های قالب‌سفارشی (کاشی‌ها) فاصلهٔ
                 مرئی زیادی با نشانگر می‌افتد.
                 رفع سراسری (قانون الگو در کل برنامه): استایل ضمنی ToolTip با
                 Placement=Mouse — لنگر همان نقطهٔ نشانگر؛ آفست عمودی ۱۴px
                 (کمی پایین‌تر، همیشه خوانا) و افقی ۰؛ کارت گوشه‌گردِ تم با
                 سایهٔ نرم، فونت برنامه و عرض بیشینه تا متن‌های بلند شکسته شوند.
                 InitialShowDelay=۴۰۰ms (خوانا ولی مزاحم نیست) و ShowDuration=۶s.
                 ═══ چرخهٔ چهل‌وهفتم (گزارش مالک) — کنتراست قطعی ═══
                 «تول تیپ ها(Tooltip) به خاطر رنگ فونت و زمینه شان خوانایی کمی
                 دارند» — ریشه: پس‌زمینه از قلمِ MaterialDesign.Brush.ToolTip.
                 Background خوانده می‌شد (در تم پایهٔ متریال «خاکستری تیره» است
                 که متنِ سفید می‌خواهد) ولی متن از قلم Foreground عمومی تم
                 (تیره) می‌آمد ⇒ در تم‌های روشن سفارشی، متنِ تیره روی زمینهٔ
                 تیره/خاکستری می‌افتاد و خوانا نبود. اکنون جفتِ رنگ قطعی و
                 مستقل از تم: زمینهٔ سرمه‌ای تیره #263238 + متن سفید — در هر
                 تم و هر پس‌زمینهٔ صفحه‌ای بیشینهٔ خوانایی؛ نوار رنگی راست هم
                 سفید ماند (نشان RTL هم‌زبان توست‌ها). -->
            <Style TargetType="ToolTip">
                <Setter Property="Placement" Value="Mouse" />
                <Setter Property="VerticalOffset" Value="14" />
                <Setter Property="HorizontalOffset" Value="0" />
                <!-- تأخیرها/دوام خصوصیت‌های الحاقی ToolTipService‌اند نه مستقیم -->
                <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
                <Setter Property="ToolTipService.ShowDuration" Value="6000" />
                <Setter Property="ToolTipService.BetweenShowDelay" Value="200" />
                <Setter Property="HasDropShadow" Value="True" />
                <!-- چرخهٔ ۴۷: جفتِ رنگ قطعی — متن سفید روی سرمه‌ای تیره، مستقل از تم -->
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="FontFamily" Value="{StaticResource App.FontFamily}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <!-- چرخهٔ ۴۷: زمینهٔ قطعی سرمه‌ای — دیگر از قلم تم خوانده نمی‌شود -->
                            <Border x:Name="TipCard"
                                    Background="#263238"
                                    BorderBrush="#3E5468"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,6"
                                    MaxWidth="320"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2"
                                                      Direction="270" Opacity="0.22" Color="#25405E" />
                                </Border.Effect>
                                <!-- نوار رنگی راست — هم‌زبان توست‌ها/کارت‌های برنامه (RTL).
                                     TextWrapping روی خود قالب متن نشسته (Setter صریح زیر
                                     ContentPresenter) چون خصوصیت الحاقی روی میزبان محتوا
                                     معتبر نیست (خطای MC3015). -->
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="3.5" RadiusX="2" RadiusY="2" Fill="#FFFFFFFF"
                                               Opacity="0.5" VerticalAlignment="Stretch" />
                                    <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <!-- چرخهٔ ۴۷: متنِ داخل قالب هم سفید —
                                                     اتصال‌های خودکار TextBlockForeground توسط
                                                     استایل قالب والد به ارث می‌رسد ولی صراحت
                                                     قطعی‌تر است -->
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══════════════════════════════════════════════════════════
                 چرخهٔ چهل‌وششم (گزارش مالک: «ظاهر و چیدمان صفحات بیماران، لوازم
                 مصرفی، ویزیت و معاینه، نوبت‌دهی، پذیرش و میز کار پزشک رو خیلی
                 حرفه‌ای‌تر و زیباتر بکن») — زبان طراحی مشترک شش صفحهٔ اصلی.
                 پیش از این هر چرخه فقط سربرگ گرادیانی می‌افزود؛ این چرخه یک
                 «سیستم طراحی» واقعی تعریف می‌کند تا همهٔ صفحات از یک واژگان
                 بصری (کارت آماری، نشان آیکونی، نوار کادر جستجو) استفاده کنند.
                 قاعدهٔ ضدبریدگی چرخهٔ ۴۵ اینجا هم برقرار است: افکت سایهٔ کارت
                 با Padding داخلی ۱۴px از مرز چیدمان فاصله دارد و محتوا هرگز
                 سرریز نمی‌کند.
                 ═══════════════════════════════════════════════════════════ -->

            <!-- ─── ۱) کارت آماری صفحات — ظرف پایه ───
                 هر صفحه ردیفی از این کارت‌ها را زیر سربرگ می‌نشیند تا کاربر
                 وضعیت کل صفحه را «در یک نگاه» ببیند (قاعدهٔ شناختی UI:
                 پیش‌نمایش کم‌ّتلاش قبل از تعامل). -->
            <Style x:Key="App.StatCard" TargetType="Border">
                <!-- پس‌زمینهٔ کارت تم — در حالت روشن/تیره خودش تعویض می‌شود -->
                <Setter Property="Background"
                        Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource MaterialDesign.Brush.Separator.Background}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <!-- Padding عمودی ۱۱ + افقی ۱۴: عدد بزرگ دیده می‌شود ولی کارت
                     جمع‌وجور می‌ماند؛ ردیف کارت‌ها هرگز از ۶۴px بلندتر نمی‌شود -->
                <Setter Property="Padding" Value="14,11" />
                <!-- سایهٔ بسیار نرم — عمق بدون جلب توجه؛ عمق ۱٫۵px و کدورت ۱۰٪
                     چون کارت‌ها کنار هم‌اند و سایهٔ سنگین حس «جدول» می‌داد -->
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="9" ShadowDepth="1.5"
                                          Direction="270" Opacity="0.10" Color="#31465E" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ─── ۲) نشان آیکونی کارت آماری — مربع گوشه‌گرد همیشه‌متحرک ───
                 پس‌زمینهٔ ملایمِ رنگ هویت هر صفحه (استفادهٔ مستقیم در صفحات:
                 Background/Foreground هاردکد رنگی صفحه + این قالب اندازه/شکل) -->
            <Style x:Key="App.StatIcon" TargetType="Border">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="12" />
                <!-- قاب بسیار کم‌رنگِ همان رنگ پس‌زمینه — لبهٔ نشان در هر تم دیده شود -->
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#26FFFFFF" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- ─── ۳) متن عدد بزرگ کارت آماری ───
                 فونت کد (ارقام هم‌عرض) تا اعداد لرزش افقی نداشته باشند و در
                 همهٔ کارت‌ها یک‌قدر دیده شوند -->
            <Style x:Key="App.StatValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontFamily" Value="{DynamicResource App.CodeFont}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            </Style>

            <!-- ─── ۴) زیرعنوان ریز کارت آماری ─── -->
            <Style x:Key="App.StatLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Opacity" Value="0.62" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>

            <!-- ─── ۵) نوار ابزار-جستجوی یکدست صفحات ───
                 ظرف سفید تم با قاب ظریف که جعبهٔ جستجو + دکمه‌های صفحه را در
                 خود دارد؛ هم‌قد سربرگ و با همان شعاع گوشه تا ستون‌بندی عمودی
                 صفحه از بالا تا پایین یک ریتم داشته باشد -->
            <Style x:Key="App.ToolBar" TargetType="Border">
                <Setter Property="Background"
                        Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource MaterialDesign.Brush.Separator.Background}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="10,8" />
            </Style>

            <!-- ─── ۶) استایل مشترک جدول‌های صفحات (حس «حرفه‌ای» در بدنه) ───
                 ارتفاع راحت ردیف‌ها (۳۶px) — هدف‌گیری موس روی دسکتاپ آسان‌تر و
                 خوانایی بهتر؛ فونت ۱۲٫۵ توازن چگالی/خوانایی صفحه‌های داده‌محور -->
            <Style x:Key="App.DataGrid" TargetType="DataGrid"
                   BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="RowHeight" Value="36" />
                <Setter Property="GridLinesVisibility" Value="None" />
                <Setter Property="BorderThickness" Value="0" />
                <!-- نوار یک‌درمیان بسیار ملایم — قلم پویای مشترک با استایل ضمنی
                     زیر (چرخهٔ ۷۴) تا در تم تیره هم خودش را تنظیم کند -->
                <Setter Property="AlternationCount" Value="2" />
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource App.ZebraRowBrush}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!-- ═══ چرخهٔ ۷۴ — استایل ضمنی جدول‌ها: گوره‌خری سراسری ═══
                 هر DataGrid در هر صفحه/فرم — حتی بی‌استایل — سطرهای یک‌درمیان
                 می‌گیرد؛ سازوکار داخلی AlternatingRowBackground انتخاب سطر را
                 بی‌وقفه نگه می‌دارد (هایلایت انتخاب در قالب ردیف، مقدم است).
                 مقادیر محلی هر جدول (رنگ دلخواه یا بدون نوار) بر این پیش‌فرض
                 مقدم می‌ماند. -->
            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="AlternationCount" Value="2" />
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource App.ZebraRowBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

