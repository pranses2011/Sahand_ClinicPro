<Window x:Class="Sahand.ClinicPro.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:Sahand.ClinicPro.Desktop.Helpers"
        xmlns:views="clr-namespace:Sahand.ClinicPro.Desktop.Views"
        xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="سامانه جامع مدیریت درمانگاه سهند"
        Height="780" Width="1280" MinHeight="620" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}">
    <Window.Resources>
        <!-- نگاشت ViewModel به View — ناوبری مبتنی بر مدل‌نما -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PatientsViewModel}">
            <views:PatientsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DoctorsViewModel}">
            <views:DoctorsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppointmentsViewModel}">
            <views:AppointmentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReceptionsViewModel}">
            <views:ReceptionsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VisitsViewModel}">
            <views:VisitsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrescriptionsViewModel}">
            <views:PrescriptionsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BillingViewModel}">
            <views:BillingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountingViewModel}">
            <views:AccountingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InsuranceViewModel}">
            <views:InsuranceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ParaclinicalViewModel}">
            <views:ParaclinicalView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LabViewModel}">
            <views:LabView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PharmacyViewModel}">
            <views:PharmacyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StocktakingViewModel}">
            <views:StocktakingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportBrowserViewModel}">
            <views:ReportBrowserView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminViewModel}">
            <views:AdminView />
        </DataTemplate>
        <!-- چرخه بیستم: ViewModel پرسنل فرزند AdminViewModel است؛ قالب صریح تا
             بدون ابهام AdminView برای آن هم به‌کار رود (زبانهٔ ۲ پیش‌فرض) -->
        <DataTemplate DataType="{x:Type vm:PersonnelViewModel}">
            <views:AdminView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersViewModel}">
            <views:UsersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RolesViewModel}">
            <views:RolePermissionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SmsViewModel}">
            <views:SmsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SurveyViewModel}">
            <views:SurveyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NotificationsViewModel}">
            <views:NotificationsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupViewModel}">
            <views:BackupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditLogViewModel}">
            <views:AuditLogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BranchesViewModel}">
            <views:BranchesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SepasViewModel}">
            <views:SepasView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EPrescriptionViewModel}">
            <views:EPrescriptionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LicenseStatusViewModel}">
            <views:LicenseStatusView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ComplementaryViewModel}">
            <views:ComplementaryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdvancedEmrViewModel}">
            <views:AdvancedEmrView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PayrollViewModel}">
            <views:PayrollView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AttendanceViewModel}">
            <views:AttendanceView />
        </DataTemplate>
        <!-- مرکز آموزش — چرخه سیزدهم (درخواست ۸-۶) -->
        <DataTemplate DataType="{x:Type vm:TrainingCenterViewModel}">
            <views:TrainingCenterView />
        </DataTemplate>
    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════
         پوسته اصلی — ارتقای گام U0 (طبق قوانین کلی پرامپت UI بخش ۱)
         ساختار: ستون کنار ۲۲۰px + TopBar (مسیر/ساعت/زنگ/تم/کاربر) + میزکار + StatusBar
         ═══════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- ستون کنار راست — ناوبری (RTL) طبق مشخصات: Width=220 -->
            <ColumnDefinition Width="220" />
            <!-- میزکار اصلی -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ ستون کنار ═══ — چرخه هفدهم (گزارش یازدهم): پس‌زمینهٔ سایدبار
             گرادیان آبی رسمی طرح؛ چرخه بیست‌ویکم (گزارش پانزدهم مالک):
             «تغییر رنگ، رنگ منوی کناری را عوض نمی‌کند» — رنگ‌ها از منابع پویای
             App.SidebarTop/Bottom خوانده می‌شوند که ThemeService آنها را از رنگ
             تم (یا رنگ سفارشی کاربر) بازمی‌سازد؛ متن‌ها سفید/آبی‌روشن و آیتم
             فعال با های‌لایت نیمه‌شفاف سفیدِ گوشه‌گرد. -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{Binding Color, Source={StaticResource App.SidebarTop}}" Offset="0" />
                    <GradientStop Color="{Binding Color, Source={StaticResource App.SidebarBottom}}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <!-- لوگو و نام درمانگاه (بالا) -->
                    <RowDefinition Height="Auto" />
                    <!-- منوی درختی ماژول‌ها (وسط - با پیمایش) -->
                    <RowDefinition Height="*" />
                    <!-- اطلاعات کاربر + خروج (پایین) -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- لوگو و نام سامانه — چرخه بیست‌ویکم (گزارش پانزدهم مالک):
                     «در بالای منوی کناری آیکون برنامه باید باشد ولی یک آیکون دیگر
                     هست» — آیکون PackIcon عمومی با آیکون رسمی خود برنامه (appicon.ico)
                     جایگزین شد تا هویت بصری محصول در سایدبار هم دیده شود -->
                <StackPanel Grid.Row="0" Margin="16,20,16,16">
                    <Image Source="/Assets/appicon.ico"
                           Width="42" Height="42"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Right" />
                    <TextBlock Text="درمانگاه سهند"
                               FontSize="20" FontWeight="Bold" Margin="0,10,0,0"
                               Foreground="White" HorizontalAlignment="Right" />
                    <TextBlock Text="سامانه جامع مدیریت"
                               FontSize="12" Opacity="0.72"
                               Foreground="#DCE9FA" HorizontalAlignment="Right" />
                </StackPanel>

                <!-- فهرست ناوبری ماژول‌ها — چرخه هفدهم: قالب آیتم سفارشی برای
                     سایدبار تیره — متن آبی‌روشن، آیتم فعال/هاور با های‌لایت
                     سفید نیمه‌شفاف گوشه‌گرد (الگوی فرم‌های طراحی).
                     ═══ چرخه بیست‌ویکم (گزارش پانزدهم مالک) ═══
                     «گزینه‌های لیست کناری مرتب نیستند و شلوغ است؛ بر اساس عملکرد
                     به‌صورت زیر منو قرار بده» — آیتم‌های گروه‌دار با HasChildren
                     تشخیص داده می‌شوند و به‌صورت گروه بازشو (زیرمنوی تودرتو)
                     دیده می‌شوند؛ آیتم‌های تکی همان دکمهٔ قبلی‌اند. -->

                <!-- منابع مشترک قالب آیتم‌ها -->
                <Border.Resources>
                    <!-- سبک پایهٔ آیتم تکی منو — دکمهٔ تمام‌عرض با آیکون و عنوان -->
                    <ControlTemplate x:Key="LeafNavItemTemplate" TargetType="Button">
                        <Border x:Name="LeafBd" Background="Transparent"
                                CornerRadius="9" Padding="10,9"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="{Binding Icon}"
                                                         Width="20" Height="20"
                                                         Foreground="#DCE9FA"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}"
                                           FontSize="13.5"
                                           Foreground="#DCE9FA"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LeafBd" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <!-- هایلایت صفحهٔ فعال — چرخه بیست‌ویکم -->
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="LeafBd" Property="Background" Value="#33FFFFFF" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Border.Resources>

                <ListBox x:Name="NavList" Grid.Row="1"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="#DCE9FA" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="8,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                            <!-- قالب شفاف: هایلایت/انتخاب خودِ ListBox غیرفعال است؛
                                 آیتم تکی دکمه است و آیتم گروه خودش هدر بازشو دارد -->
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- انتخاب‌گر قالب: آیتم تکی ↔ گروه زیرمنودار -->
                            <ContentControl Content="{Binding}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <!-- قالب آیتم تکی — دکمهٔ ناوبری -->
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Template="{StaticResource LeafNavItemTemplate}"
                                                            Cursor="Hand"
                                                            HorizontalContentAlignment="Stretch"
                                                            HorizontalAlignment="Stretch" />
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasChildren}" Value="True">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <!-- قالب گروه — سربرگ بازشو + زیرمنو -->
                                                        <DataTemplate>
                                                            <StackPanel>
                                                                <!-- سربرگ گروه — کلیک: باز/بسته -->
                                                                <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                              Cursor="Hand">
                                                                    <ToggleButton.Template>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border x:Name="GrpBd" Background="Transparent"
                                                                                    CornerRadius="9" Padding="10,9"
                                                                                    SnapsToDevicePixels="True">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <materialDesign:PackIcon Kind="{Binding Icon}"
                                                                                                             Width="20" Height="20"
                                                                                                             Foreground="#DCE9FA"
                                                                                                             VerticalAlignment="Center" />
                                                                                    <TextBlock Text="{Binding Title}"
                                                                                               FontSize="13.5" FontWeight="SemiBold"
                                                                                               Foreground="#E8F1FC"
                                                                                               Margin="10,0,0,0"
                                                                                               VerticalAlignment="Center" />
                                                                                    <!-- فلش باز/بسته -->
                                                                                    <materialDesign:PackIcon x:Name="Chev"
                                                                                                             Kind="ChevronDown"
                                                                                                             Width="15" Height="15"
                                                                                                             Foreground="#9FB8D8"
                                                                                                             Margin="8,0,0,0"
                                                                                                             VerticalAlignment="Center"
                                                                                                             RenderTransformOrigin="0.5,0.5">
                                                                                        <materialDesign:PackIcon.RenderTransform>
                                                                                            <RotateTransform Angle="0" />
                                                                                        </materialDesign:PackIcon.RenderTransform>
                                                                                    </materialDesign:PackIcon>
                                                                                </StackPanel>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="GrpBd" Property="Background" Value="#1FFFFFFF" />
                                                                                </Trigger>
                                                                                <Trigger Property="IsChecked" Value="True">
                                                                                    <Setter TargetName="Chev" Property="RenderTransform">
                                                                                        <Setter.Value>
                                                                                            <RotateTransform Angle="180" />
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </ToggleButton.Template>
                                                                </ToggleButton>

                                                                <!-- زیرمنو — فقط هنگام باز بودن گروه -->
                                                                <ListBox ItemsSource="{Binding Children}"
                                                                         Background="Transparent"
                                                                         BorderThickness="0"
                                                                         Margin="14,2,0,2"
                                                                         Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}"
                                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                                    <ListBox.ItemContainerStyle>
                                                                        <Style TargetType="ListBoxItem">
                                                                            <Setter Property="Padding" Value="0" />
                                                                            <Setter Property="Margin" Value="0,1" />
                                                                            <Setter Property="Background" Value="Transparent" />
                                                                            <Setter Property="BorderThickness" Value="0" />
                                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                                            <Setter Property="Focusable" Value="False" />
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="ListBoxItem">
                                                                                        <ContentPresenter />
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Style>
                                                                    </ListBox.ItemContainerStyle>
                                                                    <ListBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <!-- فرزند گروه — همان دکمهٔ تکی با تورفتگی -->
                                                                            <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Template="{StaticResource LeafNavItemTemplate}"
                                                                                    Cursor="Hand"
                                                                                    HorizontalContentAlignment="Stretch"
                                                                                    HorizontalAlignment="Stretch" />
                                                                        </DataTemplate>
                                                                    </ListBox.ItemTemplate>
                                                                </ListBox>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- اطلاعات کاربر + خروج -->
                <StackPanel Grid.Row="2" Margin="16,8,16,16">
                    <StackPanel Orientation="Horizontal" Margin="4,0,4,10">
                        <materialDesign:PackIcon Kind="AccountCircle"
                                                 Width="26" Height="26"
                                                 Foreground="#DCE9FA"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentUser}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Command="{Binding LogoutCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="White" BorderBrush="#66FFFFFF"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Logout" VerticalAlignment="Center" />
                            <TextBlock Text="خروج از حساب" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ میزکار ═══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══ TopBar — مسیر صفحه + ساعت شمسی لحظه‌ای + زنگ اعلان + تم + کاربر ═══
                 چرخه هجدهم (گزارش دوازدهم): نام TopBar ثبت شد تا تور آموزشی بتواند
                 این نوار را هایلایت کند — پیش‌تر نام‌گذاری نشده بود و گام «نوار بالا»
                 تور به سوراخ مرکزی خالی می‌افتاد -->
            <Border x:Name="TopBar"
                    Grid.Row="0"
                    Padding="24,10,24,8"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                    BorderThickness="0,0,0,1">
                <DockPanel>
                    <!-- چپ: کاربر و آواتار -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountCircle"
                                                 Width="30" Height="30"
                                                 VerticalAlignment="Center" />
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUser}"
                                       FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{Binding CurrentDate}"
                                       FontSize="10" Opacity="0.7" />
                        </StackPanel>
                    </StackPanel>

                    <!-- راست: انتخابگر شعبه + زنگ اعلان با شمارنده + تم -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- انتخابگر شعبه — فقط وقتی بیش از یک شعبه فعال است (گام U17) -->
                        <ComboBox ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}"
                                  DisplayMemberPath="Name" MinWidth="130" FontSize="12"
                                  materialDesign:HintAssist.Hint="شعبه"
                                  Visibility="{Binding HasMultipleBranches, Converter={StaticResource BoolToVisibility}}"
                                  Margin="0,0,14,0" VerticalAlignment="Center" />
                        <ToggleButton Command="{Binding ToggleThemeCommand}"
                                      Style="{StaticResource MaterialDesignFlatToggleButton}"
                                      ToolTip="تغییر تم روشن و تاریک"
                                      Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="ThemeLightDark" />
                        </ToggleButton>

                        <!-- زنگ اعلان — با Badge تعداد خوانده‌نشده -->
                        <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                Command="{Binding ShowNotificationsCommand}"
                                ToolTip="مرکز اعلان‌ها">
                            <Grid>
                                <materialDesign:PackIcon Kind="BellOutline" />
                                <!-- نشانگر تعداد — فقط وقتی بزرگ‌تر از صفر -->
                                <Border CornerRadius="8"
                                        Background="#e53935"
                                        MinWidth="16" MinHeight="16"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="-4,-6,0,0"
                                        Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding UnreadCount}"
                                               FontSize="9" Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- میانه: مسیر صفحه (Breadcrumb) + ساعت شمسی لحظه‌ای -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Home"
                                                 Width="16" Height="16"
                                                 Opacity="0.6"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Breadcrumb}"
                                   FontSize="12" Opacity="0.75"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentTitle}"
                                   FontSize="18" FontWeight="Bold"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center" />

                        <!-- ساعت زنده شمسی -->
                        <Border CornerRadius="10"
                                Background="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                                Padding="10,3"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClockOutline"
                                                         Width="14" Height="14"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,6,0" />
                                <!-- چرخه هجدهم: فونت پیش‌فرض وزیرمتن برای ارقام فارسی ساعت -->
                                <TextBlock Text="{Binding ClockText}"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══ میزکار صفحات ═══
                 چرخه هجدهم (گزارش دوازدهم): نام PageHost ثبت شد تا تور آموزشی
                 محتوای صفحه فعلی را (نه آیتم ریز منو) هایلایت کند -->
            <ContentControl x:Name="PageHost" Grid.Row="1"
                            Content="{Binding CurrentPage}" />

            <!-- ═══ StatusBar — وضعیت اتصال + کاربر + لایسنس + تاریخ ═══ -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                    BorderThickness="0,1,0,0"
                    Padding="16,4">
                <DockPanel LastChildFill="False">
                    <!-- راست: وضعیت آماده -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8"
                                 Fill="#43a047"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConnectionStatus}"
                                   FontSize="11" Opacity="0.8"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- چپ: لایسنس + آموزش + نسخه -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding OpenTrainingCommand}" Style="{StaticResource MaterialDesignFlatButton}"
                                Padding="8,4" Margin="0,0,10,0" ToolTip="مرکز آموزش — ۱۰ درس تعاملی گام‌به‌گام">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="School" Width="14" Height="14" VerticalAlignment="Center"
                                                         Foreground="#1565C0" />
                                <TextBlock Text="آموزش" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <materialDesign:PackIcon Kind="Key"
                                                 Width="13" Height="13"
                                                 VerticalAlignment="Center"
                                                 Foreground="#43a047" />
                        <TextBlock Text="{Binding LicenseStatus}"
                                   FontSize="11" Opacity="0.8"
                                   Margin="4,0,16,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static helpers:AppInfo.VersionText}"
                                   FontSize="10" Opacity="0.5"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══ میزبان پیام‌های شناور — سراسری برای همه صفحات ═══ -->
        <materialDesign:Snackbar MessageQueue="{Binding SnackbarQueue}"
                                 VerticalAlignment="Bottom"
                                 HorizontalAlignment="Center"
                                 Margin="0,0,0,36"
                                 Grid.Column="1" />
    </Grid>
</Window>
