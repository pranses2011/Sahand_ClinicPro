<Window x:Class="Sahand.ClinicPro.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:Sahand.ClinicPro.Desktop.Helpers"
        xmlns:views="clr-namespace:Sahand.ClinicPro.Desktop.Views"
        xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="سامانه جامع مدیریت درمانگاه سهند"
        Height="780" Width="1280" MinHeight="620" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}">
    <Window.Resources>
        <!-- نگاشت ViewModel به View — ناوبری مبتنی بر مدل‌نما -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PatientsViewModel}">
            <views:PatientsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DoctorsViewModel}">
            <views:DoctorsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppointmentsViewModel}">
            <views:AppointmentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReceptionsViewModel}">
            <views:ReceptionsView />
        </DataTemplate>
        <!-- چرخهٔ ۴۱ — صفحهٔ مستقل لوازم مصرفی (بدون نیاز به ماژول داروخانه) -->
        <DataTemplate DataType="{x:Type vm:ConsumablesViewModel}">
            <views:ConsumablesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VisitsViewModel}">
            <views:VisitsView />
        </DataTemplate>
        <!-- چرخهٔ بیست‌وهفتم — میزکار پزشک (صفحهٔ ویزیت پزشک) -->
        <DataTemplate DataType="{x:Type vm:DoctorVisitViewModel}">
            <views:DoctorVisitView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrescriptionsViewModel}">
            <views:PrescriptionsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BillingViewModel}">
            <views:BillingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountingViewModel}">
            <views:AccountingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InsuranceViewModel}">
            <views:InsuranceView />
        </DataTemplate>
        <!-- ═══ چرخهٔ ۴۳ — چهار صفحهٔ مستقل به‌جای پاراکلینیکِ تب‌دار ═══ -->
        <DataTemplate DataType="{x:Type vm:DentistryViewModel}">
            <views:DentistryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OphthalmologyViewModel}">
            <views:OphthalmologyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PhysiotherapyViewModel}">
            <views:PhysiotherapyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImagingViewModel}">
            <views:ImagingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LabViewModel}">
            <views:LabView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PharmacyViewModel}">
            <views:PharmacyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StocktakingViewModel}">
            <views:StocktakingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportBrowserViewModel}">
            <views:ReportBrowserView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminViewModel}">
            <views:AdminView />
        </DataTemplate>
        <!-- چرخه بیست‌وسوم (گزارش شانزدهم مالک): «گزینه پرسنل صفحهٔ تنظیمات را باز
             می‌کند... پرسنل باید یک صفحه جدا باشد» — قالب پیش‌تر روی AdminView بود؛
             اکنون نمای اختصاصی و مستقل به کار می‌رود -->
        <DataTemplate DataType="{x:Type vm:PersonnelViewModel}">
            <views:PersonnelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersViewModel}">
            <views:UsersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RolesViewModel}">
            <views:RolePermissionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SmsViewModel}">
            <views:SmsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SurveyViewModel}">
            <views:SurveyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NotificationsViewModel}">
            <views:NotificationsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupViewModel}">
            <views:BackupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditLogViewModel}">
            <views:AuditLogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BranchesViewModel}">
            <views:BranchesView />
        </DataTemplate>
        <!-- چرخهٔ سی‌ونه‌م (گزارش مالک): صفحهٔ منوی کناری «مدیریت اتاق‌ها» -->
        <DataTemplate DataType="{x:Type vm:RoomsManagerViewModel}">
            <views:RoomsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SepasViewModel}">
            <views:SepasView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EPrescriptionViewModel}">
            <views:EPrescriptionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LicenseStatusViewModel}">
            <views:LicenseStatusView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ComplementaryViewModel}">
            <views:ComplementaryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdvancedEmrViewModel}">
            <views:AdvancedEmrView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PayrollViewModel}">
            <views:PayrollView />
        </DataTemplate>
        <!-- چرخهٔ ۴۷ — صفحهٔ مستقل مدیریت شیفت‌ها -->
        <DataTemplate DataType="{x:Type vm:ShiftsViewModel}">
            <views:ShiftsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AttendanceViewModel}">
            <views:AttendanceView />
        </DataTemplate>
        <!-- مرکز آموزش — چرخه سیزدهم (درخواست ۸-۶) -->
        <DataTemplate DataType="{x:Type vm:TrainingCenterViewModel}">
            <views:TrainingCenterView />
        </DataTemplate>
    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════
         پوسته اصلی — ارتقای گام U0 (طبق قوانین کلی پرامپت UI بخش ۱)
         ساختار: ستون کنار ۲۲۰px + TopBar (مسیر/ساعت/زنگ/تم/کاربر) + میزکار + StatusBar
         ═══════════════════════════════════════════════════════════ -->
    <Grid>
        <!-- ═══ میان‌بر سراسری جستجوی یکپارچه — چرخهٔ ۶۹ (فاز ۳ / F-06) ═══
             Ctrl+K از هر جای برنامه، پنجرهٔ جستجوی سریع (بیمار/نوبت/نسخه)
             را باز می‌کند — بدون گشتن در منوها. -->
        <Grid.InputBindings>
            <KeyBinding Modifiers="Control" Key="K"
                        Command="{Binding OpenQuickSearchCommand}" />
        </Grid.InputBindings>
        <Grid.ColumnDefinitions>
            <!-- ستون کنار راست — ناوبری (RTL) طبق مشخصات: Width=220 -->
            <ColumnDefinition Width="220" />
            <!-- میزکار اصلی -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ ستون کنار ═══ — چرخه هفدهم (گزارش یازدهم): پس‌زمینهٔ سایدبار
             گرادیان آبی رسمی طرح؛ چرخه بیست‌ویکم: رنگ‌ها از منابع پویا خوانده
             می‌شوند؛ چرخه بیست‌وسوم (گزارش شانزدهم مالک): «رنگ منو تا ری‌استارت
             عوض نمی‌شود» — ریشه: قلم‌های XAML فریز می‌شوند و StaticResource
             جایگزینیِ منبع را نمی‌بیند؛ اکنون پس‌زمینه با DynamicResource از
             قلمِ گرادیانیِ کاملِ App.SidebarBrush خوانده می‌شود که ThemeService
             با هر تغییر تم/رنگ سفارشی، نمونهٔ نوِ آن را می‌سازد — بی‌درنگ و
             بدون ری‌استارت. متن‌ها سفید/آبی‌روشن و آیتم فعال با های‌لایت
             نیمه‌شفاف سفیدِ گوشه‌گرد. -->
        <Border Grid.Column="0" Background="{DynamicResource App.SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- لوگو و نام درمانگاه (بالا) -->
                    <RowDefinition Height="Auto" />
                    <!-- منوی درختی ماژول‌ها (وسط - با پیمایش) -->
                    <RowDefinition Height="*" />
                    <!-- اطلاعات کاربر + خروج (پایین) -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- منابع مشترک قالب آیتم‌ها -->
                <Grid.Resources>
                    <!-- سبک پایهٔ آیتم تکی منو — دکمهٔ تمام‌عرض با آیکون و عنوان.
                         چرخهٔ سی‌وسوم (قانون هم‌کلاسی‌ها با سربرگ گروه): چیدمان از
                         StackPanel به گرید سه‌ستونه — عنوان ستون * و فضای تضمینی؛
                         عنوان‌های بلند (مانند «مدیریت سامانه (تب‌بندی کامل)») دیگر
                         از لبهٔ منو بیرون نمی‌زنند و در کمبود فضا فقط «…» می‌گیرند -->
                    <ControlTemplate x:Key="LeafNavItemTemplate" TargetType="Button">
                        <Border x:Name="LeafBd" Background="Transparent"
                                CornerRadius="9" Padding="10,9"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <!-- آیکون -->
                                    <ColumnDefinition Width="*" />
                                    <!-- عنوان — تمام عرض باقی‌مانده -->
                                </Grid.ColumnDefinitions>
                                <!-- چرخه ۲۴: رنگ آیکون از مبدل حالت رنگی/یکدست — MultiBinding با شمارندهٔ
                                     نوسازی تا تعویض حالت بدون ری‌استارت اعمال شود -->
                                <materialDesign:PackIcon Grid.Column="0" Width="20" Height="20"
                                                         VerticalAlignment="Center">
                                                         <materialDesign:PackIcon.Kind>
                                                             <MultiBinding Converter="{StaticResource IconSetKind}">
                                                                 <Binding Path="Icon" />
                                                                 <Binding Path="DataContext.IconRefreshTick" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                             </MultiBinding>
                                                         </materialDesign:PackIcon.Kind>
                                    <materialDesign:PackIcon.Foreground>
                                        <MultiBinding Converter="{StaticResource IconTintMulti}">
                                            <Binding Path="Icon" />
                                            <Binding Path="DataContext.IconRefreshTick" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        </MultiBinding>
                                    </materialDesign:PackIcon.Foreground>
                                </materialDesign:PackIcon>
                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                           FontSize="13.5"
                                           Foreground="#DCE9FA"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LeafBd" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <!-- هایلایت صفحهٔ فعال — چرخه بیست‌ویکم -->
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="LeafBd" Property="Background" Value="#33FFFFFF" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Grid.Resources>

                <!-- ═══ چرخه بیست‌وچهارم (گزارش هفدهم مالک) — لوگوی اصلی برنامه ═══
                     «آیکون بالای منو را عوض کردی ولی من می‌خواهم همان آیکون اصلی
                     خود برنامه باشد ولی یک تصویر بزرگ و باکیفیت؛ فایل تصویر بزرگش
                     داخل ریپو و پوشهٔ docs/assets/ClinicPro.png هست» — نسخهٔ ۲۵۶
                     پیکسلی از همان فایل رسمی (با زمینهٔ شفاف) جاسازی شد و نشانِ
                     برداریِ قبلی جای خود را به لوگوی واقعی محصول داد. -->
                <!-- ═══ چرخه سی‌ویکم (گزارش مالک) — «در بالای منوی کناری که تصویر و
                     نام برنامه هست، اونارو وسط چین بکن تا زیباتر دیده بشن» — لوگو و هر
                     دو سطر نام از لبهٔ راست به میانهٔ ستون منتقل شدند (HorizontalAlignment
                     و TextAlignment هر دو Center تا متن‌ها هم حول مرکز بچینند) ═══ -->
                <StackPanel Grid.Row="0" Margin="16,20,16,16">
                    <!-- لوگوی رسمی ClinicPro — تصویر بزرگ باکیفیت با زمینهٔ شفاف — وسط‌چین -->
                    <Image Source="/Assets/Logo/ClinicPro-256.png"
                           Width="72" Height="72"
                           HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           ToolTip="سامانه جامع مدیریت درمانگاه سهند">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" />
                        </Image.Effect>
                    </Image>
                    <TextBlock Text="درمانگاه سهند"
                               FontSize="20" FontWeight="Bold" Margin="0,10,0,0"
                               Foreground="White" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="سامانه جامع مدیریت"
                               FontSize="12" Opacity="0.72"
                               Foreground="#DCE9FA" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>

                <!-- فهرست ناوبری ماژول‌ها — چرخه بیست‌وسوم (گزارش شانزدهم مالک):
                     «عنوان لیست‌های اصلی که زیرمنو دارند دیده نمی‌شوند» — الگوی
                     قبلیِ سوییچ قالب با ContentControl+Style.Triggers شکننده بود؛
                     اکنون هر دو بخش (سربرگ گروه و دکمهٔ تکی) همیشه در قالب هستند و
                     فقط با دیدپذیری جداسازی می‌شوند — عنوان گروه در همهٔ حالت‌ها
                     نمایان است.
                     «گزینه‌های زیرمنو با رنگ متفاوت باشند تا زودتر تشخیص داده شوند» —
                     فرزندان گروه با رنگ آبی‌روشنِ متمایز + نوار تأکیدی در لبهٔ راست. -->
                <ListBox x:Name="NavList" Grid.Row="1"
                         ItemsSource="{Binding NavItems}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="#DCE9FA" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="8,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                            <!-- قالب شفاف: هایلایت/انتخاب خودِ ListBox غیرفعال است.
                                 ═══ چرخهٔ سی‌وپنجم (چهارمین گزارش عنوان گروه‌ها) ═══
                                 ContentPresenter حالا صریحاً HorizontalContentAlignmentِ
                                 والد قالب را با TemplateBinding می‌خواند — تضمین
                                 مستقیم کششِ افقی محتوا؛ دیگر اتکایی به همگام‌سازی
                                 خودکار WPF نیست که در ترکیب‌های خاص تم/کنترل
                                 می‌شکند و سربرگ‌ها به عرضِ محتوا (۵۵px فقط‌آیکونی)
                                 جمع می‌شدند. -->
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <!-- ═══ سربرگ گروه — همیشه رندر می‌شود؛ عنوان همیشه دیده
                                     می‌شود (رفع «عنوان والد دیده نمی‌شود») ═══
                                     ═══ چرخهٔ بیست‌وششم (گزارش هجدهم مالک — مهم) ═══
                                     «منوهای اصلی که زیرمنو دارند با یک رنگ متفاوت از
                                     زیرمنوها باشند و عنوانشان کاملاً دیده شود»: سربرگ
                                     گروه اکنون کاملاً متمایز است — رنگ طلایی گرم، نوار
                                     تأکیدی پررنگ در لبهٔ راست، فونت درشت‌تر و پررنگ‌تر
                                     و پس‌زمینهٔ قوی‌تر؛ در نگاه اول از فرزندان آبی‌روشن
                                     و آیتم‌های تکی سفید جدا می‌شود.
                                     ═══ چرخهٔ سی‌وسوم (گزارش نوزدهم مالک — مهم؛ سومین
                                     گزارش همین مورد) ═══
                                     «گزینه‌های اصلی که زیرمنو دارند بدون عنوان‌اند و فقط
                                     آیکونشان دیده می‌شود؛ گزینه‌های اصلی تمام عرض باشند»:
                                     بازطراحی ساختاری — چیدمان از StackPanel افقی (که در
                                     فونت/زوم بزرگ می‌توانست عنوان را از لبه بیرون براند)
                                     به گرید چهارستونه تبدیل شد: [نوار][آیکون][عنوان *][فلش]
                                     — ستون عنوان «*» است یعنی تمام عرض باقی‌مانده به آن
                                     تضمین می‌شود و در هیچ فونت/زومی تنگ نمی‌شود؛ فلش هم
                                     همیشه در انتهای چپ (RTL) پین است. تاگل صریحاً
                                     تمام‌عرض (Stretch) شد تا پس‌زمینهٔ سربرگ تمام عرض
                                     ستون منو را بپوشاند. بریدگی فقط در حالت غیرممکنِ
                                     کمبود فضا و به‌صورت «…» انتهای متن است (TextTrimming). -->
                                <!-- ═══ چرخهٔ سی‌وهفتم (پنجمین گزارش عنوان گروه‌ها — ریشهٔ قطعی) ═══
                                     ریشهٔ واقعی پنج گزارش پیاپی «ارتفاع سربرگ‌ها کم است و عنوان
                                     خوانده نمی‌شود» سرانجام با تحلیل پیکسلی اسکرین‌شات مالک و
                                     کاوش منابع MaterialDesignThemes 5.3.2 کشف شد:
                                     فایل MaterialDesign3.Defaults.xaml (که از App.xaml ادغام
                                     می‌شود) یک استایل «ضمنی» برای همهٔ ToggleButtonها تعریف
                                     می‌کند: BasedOn=MaterialDesignSwitchToggleButton یعنی
                                     Height=32 و Width=52 — ابعاد سوییچ iOS-مانند! تاگلِ بدون
                                     Style صریح از این استایل ضمنی پیروی می‌کند؛ قالب محلی ما
                                     Template را درست جایگزین می‌کند ولی Height=32 ستون فقرات
                                     قرص را می‌شکند: قالب با Padding=10,10 و آیکون ۲۲px به
                                     فضای محتوای ~۵px فرو می‌ریزد و متن/آیکون له می‌شود.
                                     رفع قطعی: Style صریحِ خالی «App.PlainToggleButton»
                                     (تعریف در App.xaml) زنجیرهٔ استایل سوییچ را کامل می‌بُرد؛
                                     Width/Height صریح Auto هم سپر دومی است که حتی اگر روزی
                                     استایل ضمنی دیگری معرفی شود، مقدار محلی بر آن می‌چربد.
                                     MinWidth=190 (چرخهٔ ۳۵) عرض را تضمین می‌کرد ولی هیچ‌چیز
                                     ارتفاع را تضمین نمی‌کرد — به همین دلیل رفع‌های چرخهٔ ۳۳
                                     و ۳۵ در ایستگاه مالک بی‌اثر می‌ماند. -->
                                <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                              Cursor="Hand"
                                              Style="{StaticResource App.PlainToggleButton}"
                                              Width="Auto"
                                              Height="Auto"
                                              HorizontalAlignment="Stretch"
                                              MinWidth="190"
                                              Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibility}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="GrpBd" Background="#22FFFFFF"
                                                    BorderBrush="#FFD54F" BorderThickness="0,0,0,1"
                                                    CornerRadius="9" Padding="10,10"
                                                    Margin="0,4,0,2"
                                                    MinHeight="46"
                                                    SnapsToDevicePixels="True">
                                                <!-- گرید تضمینی — عنوان ستون * دارد (چرخهٔ ۳۳) -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <!-- نوار تأکیدی طلایی — لبهٔ راست (RTL) -->
                                                        <ColumnDefinition Width="Auto" />
                                                        <!-- آیکون گروه -->
                                                        <ColumnDefinition Width="Auto" />
                                                        <!-- عنوان — تمام عرض باقی‌مانده؛ تضمینی -->
                                                        <ColumnDefinition Width="*" />
                                                        <!-- فلش باز/بسته — انتهای چپ -->
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="4" CornerRadius="2"
                                                            Background="#FFD54F"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Stretch" />
                                                    <materialDesign:PackIcon Grid.Column="1" Width="22" Height="22"
                                                                             VerticalAlignment="Center">
                                                                             <materialDesign:PackIcon.Kind>
                                                                                 <MultiBinding Converter="{StaticResource IconSetKind}">
                                                                                     <Binding Path="Icon" />
                                                                                     <Binding Path="DataContext.IconRefreshTick" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                                 </MultiBinding>
                                                                             </materialDesign:PackIcon.Kind>
                                                        <materialDesign:PackIcon.Foreground>
                                                            <MultiBinding Converter="{StaticResource IconTintMulti}">
                                                                <Binding Path="Icon" />
                                                                <Binding Path="DataContext.IconRefreshTick" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            </MultiBinding>
                                                        </materialDesign:PackIcon.Foreground>
                                                    </materialDesign:PackIcon>
                                                    <!-- عنوان گروه — طلایی، درشت و پررنگ برای تمایز کامل از فرزندان؛
                                                         ستون * یعنی فضای تضمینی؛ … فقط در کمبود غیرممکن فضایی -->
                                                    <TextBlock Grid.Column="2" Text="{Binding Title}"
                                                               FontSize="14.5" FontWeight="Bold"
                                                               Foreground="#FFD54F"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <!-- فلش باز/بسته -->
                                                    <materialDesign:PackIcon x:Name="Chev" Grid.Column="3"
                                                                             Kind="ChevronDown"
                                                                             Width="15" Height="15"
                                                                             Foreground="#FFD54F"
                                                                             Margin="8,0,2,0"
                                                                             VerticalAlignment="Center"
                                                                             RenderTransformOrigin="0.5,0.5">
                                                        <materialDesign:PackIcon.RenderTransform>
                                                            <RotateTransform Angle="0" />
                                                        </materialDesign:PackIcon.RenderTransform>
                                                    </materialDesign:PackIcon>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="GrpBd" Property="Background" Value="#33FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="GrpBd" Property="Background" Value="#2AFFFFFF" />
                                                    <Setter TargetName="Chev" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="180" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!-- ═══ آیتم تکی (بدون زیرمنو) — فقط وقتی گروه نیست ═══
                                     MinWidth=۱۹۰ همان تضمین پادفنی سربرگ‌ها: حتی اگر
                                     بایندینگ عنوانی روزی تهی بماند، دکمه هرگز به
                                     فقط‌آیکونیِ ۵۵px فرونمی‌ریزد (چرخهٔ ۳۵) -->
                                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Template="{StaticResource LeafNavItemTemplate}"
                                        Cursor="Hand"
                                        MinWidth="190"
                                        Visibility="{Binding HasChildren, Converter={StaticResource InverseBoolToVisibility}}"
                                        HorizontalContentAlignment="Stretch"
                                        HorizontalAlignment="Stretch" />

                                <!-- ═══ زیرمنو — فرزندان با رنگ متمایز (گزارش شانزدهم
                                     مالک: «گزینه‌های زیرمنو با رنگ متفاوت باشند») ═══
                                     ═══ چرخهٔ سی‌وسوم (گزارش نوزدهم مالک) ═══
                                     «زیرمنوها کمی از سمت راست فاصله داشته باشند تا مشخص
                                     باشد زیرمنو هستند»: حاشیهٔ راست ۲۰px — در چیدمان RTL
                                     سمت راست «آغاز» است و این تورفتگی، فرزندان را از
                                     سربرگ طلایی والد و آیتم‌های تکی جدا و سلسله‌مراتب را
                                     در نگاه اول آشکار می‌کند. -->
                                <ListBox ItemsSource="{Binding Children}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Margin="8,2,20,4"
                                         Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,1" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- فرزند گروه — رنگ آبی‌روشن متمایز + نوار تأکیدی
                                                 در لبهٔ راست تا از آیتم‌های تکی جدا دیده شود.
                                                 چرخهٔ سی‌وسوم: گرید دوستونه (قانون هم‌کلاسی‌ها) —
                                                 عنوان ستون * و «…» در کمبود فضا؛ بیرون‌زدگی ممنوع -->
                                            <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand"
                                                    HorizontalContentAlignment="Stretch"
                                                    HorizontalAlignment="Stretch">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ChildBd" Background="#0FFFFFFF"
                                                                CornerRadius="8" Padding="8,7"
                                                                SnapsToDevicePixels="True">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <!-- نوار تأکیدی -->
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <!-- آیکون -->
                                                                    <ColumnDefinition Width="*" />
                                                                    <!-- عنوان -->
                                                                </Grid.ColumnDefinitions>
                                                                <!-- نوار تأکیدی متمایز — لبهٔ راست (RTL) -->
                                                                <Border Grid.Column="0" Width="3" CornerRadius="2"
                                                                        Background="#7FD3FF"
                                                                        Margin="0,0,8,0"
                                                                        VerticalAlignment="Stretch" />
                                                                <materialDesign:PackIcon Grid.Column="1" Width="17" Height="17"
                                                                                         VerticalAlignment="Center">
                                                                                         <materialDesign:PackIcon.Kind>
                                                                                             <MultiBinding Converter="{StaticResource IconSetKind}">
                                                                                                 <Binding Path="Icon" />
                                                                                                 <Binding Path="DataContext.IconRefreshTick" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                                             </MultiBinding>
                                                                                         </materialDesign:PackIcon.Kind>
                                                                    <materialDesign:PackIcon.Foreground>
                                                                        <MultiBinding Converter="{StaticResource IconTintMulti}">
                                                                            <Binding Path="Icon" />
                                                                            <Binding Path="DataContext.IconRefreshTick" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                        </MultiBinding>
                                                                    </materialDesign:PackIcon.Foreground>
                                                                </materialDesign:PackIcon>
                                                                <TextBlock Grid.Column="2" Text="{Binding Title}"
                                                                           FontSize="12.5"
                                                                           Foreground="#BBDEFB"
                                                                           Margin="9,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ChildBd" Property="Background" Value="#26FFFFFF" />
                                                            </Trigger>
                                                            <!-- هایلایت صفحهٔ فعال در زیرمنو -->
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter TargetName="ChildBd" Property="Background" Value="#38FFFFFF" />
                                                                <Setter TargetName="ChildBd" Property="BorderBrush" Value="#7FD3FF" />
                                                                <Setter TargetName="ChildBd" Property="BorderThickness" Value="1" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- ═══ اطلاعات کاربر + خروج — چرخهٔ ۳۸ (گزارش مالک): نام کامل
                     (در صورت وجود، وگرنه نام کاربری) + تصویر کاربر ═══ -->
                <StackPanel Grid.Row="2" Margin="16,8,16,16">
                    <StackPanel Orientation="Horizontal" Margin="4,0,4,12">
                        <!-- عکس کاربر — دایرهٔ سه‌لایه (همان الگوی لیست پزشکان/پرسنل چرخهٔ ۳۷):
                             حلقهٔ زمینه + آدمک جای‌گزین + برش دایره‌ای عکس واقعی روی آن؛
                             ImageBrush تهی هیچ نمی‌کشد پس بی‌عکس همان آدمک دیده می‌شود -->
                        <Grid Width="38" Height="38" VerticalAlignment="Center">
                            <Ellipse Fill="#33FFFFFF" />
                            <materialDesign:PackIcon Kind="Account" Width="20" Height="20"
                                                     Foreground="#DCE9FA"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding CurrentUserPhoto}"
                                                Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <TextBlock Text="{Binding CurrentUser}"
                                   FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="135"
                                   ToolTip="{Binding CurrentUser}" />
                    </StackPanel>
                    <Button Command="{Binding LogoutCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="White" BorderBrush="#66FFFFFF"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Logout" VerticalAlignment="Center" />
                            <TextBlock Text="خروج از حساب" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- ═══ نشان نسخهٔ در حال اجرا — چرخهٔ سی‌وسوم (گزارش نوزدهم مالک) ═══
                         سومین گزارش پیاپی «عنوان گروه‌های منو دیده نمی‌شود» در حالی که
                         رفعش در دو رلیز قبل هم اعمال شده بود؛ محتمل‌ترین علت، ماندن
                         بیلد قدیمی روی ایستگاه است (BAML کش‌شده یا جایگزینی‌نشدن فایل).
                         این نشانِ همیشه‌نمایان زیر دکمهٔ خروج، تک‌منبعی همان AppInfo.VersionText
                         (ویژگی Version فایل ساخت) است تا در یک نگاه مشخص شود نسخهٔ
                         در حال اجرا کدام است — اگر پس از آپدیت این عدد تازه نشده،
                         بیلد/کش ایستایش تازه نیست و باید Clean و بازبیلد شود. -->
                    <TextBlock Text="{x:Static helpers:AppInfo.VersionText}"
                               FontSize="10" Foreground="#9FB6D4" Opacity="0.75"
                               HorizontalAlignment="Center" Margin="0,10,0,0"
                               ToolTip="نسخهٔ در حال اجرای برنامه — پس از هر به‌روزرسانی باید تازه باشد؛ اگر نبود، بیلد ایستگاه شما تازه نشده است" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ میزکار ═══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══ TopBar — مسیر صفحه + ساعت شمسی لحظه‌ای + زنگ اعلان + تم + کاربر ═══
                 چرخه هجدهم (گزارش دوازدهم): نام TopBar ثبت شد تا تور آموزشی بتواند
                 این نوار را هایلایت کند — پیش‌تر نام‌گذاری نشده بود و گام «نوار بالا»
                 تور به سوراخ مرکزی خالی می‌افتاد.
                 ═══ چرخهٔ سی‌وهشتم (گزارش مالک) ═══
                 «در قسمت بالای صفحات، نام صفحه و بج ساعت و زمان را وسط‌چین بکن» —
                 چیدمان از DockPanel به گرید سه‌ستونه تغییر کرد: DockPanel فضای میانهٔ
                 باقی‌مانده را به محتوا می‌داد و با ناموزش عرض دو سمت، گروه میانه از
                 مرکز واقعی می‌افتاد. در RTL ستون‌ها آینه می‌شوند: ستون ۰ = راست
                 بصری (کاربر)، ستون ۲ = چپ بصری (شعبه/تم/زنگ). نام کاربر هم حالا عکس
                 دایره‌ای دارد (گزارش مالک: «تصویر هر کاربر هم نمایش داده شود» +
                 «نام کامل در صورت وجود»).
                 ═══ چرخهٔ چهل‌ودوم (گزارش مالک) ═══
                 «تو Breadcrumb رو هم وسط چین کردی. اونو پاکش بکن و فقط نام صفحه و
                 بج ساعت و زمان وسط باشن» — مسیر/آیکون خانه حذف شد و گروه میانه به
                 لایهٔ همپوش روی کل عرض منتقل شد (جزئیات روی خود گروه). -->
            <Border x:Name="TopBar"
                    Grid.Row="0"
                    Padding="24,10,24,8"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- ستون ۰ — در RTL سمت راست بصری: کاربر و آواتار -->
                        <ColumnDefinition Width="Auto" />
                        <!-- ستون ۱ — میانه: نام صفحه + بج ساعت (وسط‌چین واقعی) -->
                        <ColumnDefinition Width="*" />
                        <!-- ستون ۲ — در RTL سمت چپ بصری: شعبه + تم + زنگ -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- ═══ ستون ۰ (راست بصری): کاربر و آواتار و تاریخ ═══ -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- عکس کاربر — دایرهٔ سه‌لایه (الگوی چرخهٔ ۳۷/۳۸): زمینه +
                             آدمک جای‌گزین + برش دایره‌ای عکس واقعی؛ بی‌عکس آدمک می‌ماند -->
                        <Grid Width="34" Height="34" VerticalAlignment="Center">
                            <Ellipse Fill="#E3F2FD" />
                            <materialDesign:PackIcon Kind="Account" Width="19" Height="19"
                                                     Foreground="#1565C0"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding CurrentUserPhoto}"
                                                Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUser}"
                                       FontWeight="SemiBold" FontSize="13"
                                       TextTrimming="CharacterEllipsis" MaxWidth="170"
                                       ToolTip="{Binding CurrentUser}" />
                            <TextBlock Text="{Binding CurrentDate}"
                                       FontSize="10" Opacity="0.7" />
                        </StackPanel>
                    </StackPanel>

                    <!-- ═══ ستون ۱ (میانه): فقط نام صفحه + بج ساعت — وسط‌چین واقعی ═══
                         ═══ چرخهٔ چهل‌ودوم (گزارش مالک) ═══
                         «گفته بودم در قسمت بالای صفحات، نام صفحه و بج ساعت و زمان
                         رو وسط چین بکن ولی تو Breadcrumb رو هم وسط چین کردی. اونو
                         پاکش بکن و فقط نام صفحه و بج ساعت و زمان وسط باشن» —
                         مسیر «خانه > عنوان» و آیکون خانه از گروه میانه حذف شدند.
                         چرخهٔ ۴۲ (تثبیت وسط‌چین): گروه میانه از ستون «*» به لایهٔ
                         همپوش روی کل عرض (ColumnSpan=3) با Center منتقل شد تا
                         وسطِ واقعیِ پنجره را بگیرد حتی وقتی ستون‌های کاربر/شعبه
                         عرض نابرابر باشند (وسطِ ستونِ میانه، با ستون‌های نابرابر
                         از مرکز پنجره می‌افتاد — همان مسالهٔ چرخهٔ ۳۸). عنوان
                         MaxWidth و اوراقی دارد و گروه IsHitTestVisible=False است
                         تا هرگز کلیک‌های عناصر زیر خودش را نبلعد. -->
                    <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <TextBlock Text="{Binding CurrentTitle}"
                                   FontSize="18" FontWeight="Bold"
                                   MaxWidth="420" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding CurrentTitle}"
                                   VerticalAlignment="Center" />

                        <!-- ساعت زنده شمسی -->
                        <Border CornerRadius="10"
                                Background="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                                Padding="10,3"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClockOutline"
                                                         Width="14" Height="14"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,6,0" />
                                <!-- چرخه هجدهم: فونت پیش‌فرض وزیرمتن برای ارقام فارسی ساعت -->
                                <TextBlock Text="{Binding ClockText}"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══ ستون ۲ (چپ بصری): انتخابگر شعبه + زنگ اعلان + تم ═══ -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <!-- انتخابگر شعبه — فقط وقتی بیش از یک شعبه فعال است (گام U17) -->
                        <ComboBox ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}"
                                  DisplayMemberPath="Name" MinWidth="130" FontSize="12"
                                  materialDesign:HintAssist.Hint="شعبه"
                                  Visibility="{Binding HasMultipleBranches, Converter={StaticResource BoolToVisibility}}"
                                  Margin="0,0,14,0" VerticalAlignment="Center" />
                        <ToggleButton Command="{Binding ToggleThemeCommand}"
                                      Style="{StaticResource MaterialDesignFlatToggleButton}"
                                      ToolTip="تغییر تم روشن و تاریک"
                                      Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="ThemeLightDark" />
                        </ToggleButton>

                        <!-- زنگ اعلان — با Badge تعداد خوانده‌نشده -->
                        <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                Command="{Binding ShowNotificationsCommand}"
                                ToolTip="مرکز اعلان‌ها">
                            <Grid>
                                <materialDesign:PackIcon Kind="BellOutline" />
                                <!-- نشانگر تعداد — فقط وقتی بزرگ‌تر از صفر -->
                                <Border CornerRadius="8"
                                        Background="#e53935"
                                        MinWidth="16" MinHeight="16"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="-4,-6,0,0"
                                        Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding UnreadCount}"
                                               FontSize="9" Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ میزکار صفحات ═══
                 چرخه هجدهم (گزارش دوازدهم): نام PageHost ثبت شد تا تور آموزشی
                 محتوای صفحه فعلی را (نه آیتم ریز منو) هایلایت کند -->
            <ContentControl x:Name="PageHost" Grid.Row="1"
                            Content="{Binding CurrentPage}" />

            <!-- ═══ StatusBar — وضعیت اتصال + کاربر + لایسنس + تاریخ ═══ -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                    BorderThickness="0,1,0,0"
                    Padding="16,4">
                <DockPanel LastChildFill="False">
                    <!-- راست: وضعیت آماده -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8"
                                 Fill="#43a047"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConnectionStatus}"
                                   FontSize="11" Opacity="0.8"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- چپ: لایسنس + آموزش + نسخه -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding OpenTrainingCommand}" Style="{StaticResource MaterialDesignFlatButton}"
                                Padding="8,4" Margin="0,0,10,0" ToolTip="مرکز آموزش — ۱۰ درس تعاملی گام‌به‌گام">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="School" Width="14" Height="14" VerticalAlignment="Center"
                                                         Foreground="#1565C0" />
                                <TextBlock Text="آموزش" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <materialDesign:PackIcon Kind="Key"
                                                 Width="13" Height="13"
                                                 VerticalAlignment="Center"
                                                 Foreground="#43a047" />
                        <TextBlock Text="{Binding LicenseStatus}"
                                   FontSize="11" Opacity="0.8"
                                   Margin="4,0,16,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static helpers:AppInfo.VersionText}"
                                   FontSize="10" Opacity="0.5"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>


        <!-- ═══ میزبان پیام‌های شناور — چرخهٔ سی‌وهشتم (گزارش مالک) ═══
             «ظاهر توست‌ها مانند تصویر نمونهٔ ToastNotif.png با رنگبندی بر طبق
             نوع و پیام»: کپسول کاملاً گوشه‌گرد سفید/تابع تم با حاشیهٔ روشن و
             سایهٔ نرم؛ دایرهٔ پرشدهٔ رنگی با نویسهٔ سفید (سبز=تیک، قرمز=ضربدر،
             کهربایی=تعجب، آبی=i) در سمت راست، متن تیره در ادامه و ضربدرِ بستن
             در انتهای چپ. کل کپسول کلیک‌پذیر است (بستن) و هر توست خودکار پس از
             چند ثانیه محو می‌شود (زمان‌سنج در ViewModel). جایگزین Snackbar
             متریال شد که ظاهر و رفتارش با نمونه فرق داشت. -->
        <!-- ═══ چرخهٔ ۴۳ (گزارش مالک): «پیام‌های توست کم بالا میان و کمی از
             کادر زیر استاتوس بار میمونه و خوب دیده نمیشه» — حاشیهٔ پایین از ۳۶
             به ۶۴ پیکسل افزایش یافت تا کپسول کاملاً بالای StatusBar (ارتفاع
             ~۲۸px + فاصلهٔ تنفس) بنشیند و هیچ بخشی زیر نوار پنهان نماند. ═══ -->
        <!-- ═══ چرخهٔ ۴۷ (گزارش مالک: «هنوز هم پیام توست ناقص نمایش داده میشود
             و قسمت پایینش بریده شده») — جابه‌جایی ساختاری ═══
             میزبان توست از گرید ریشه (که کل ارتفاع پنجره از جمله StatusBar را
             می‌پوشاند و تنها با «حاشیهٔ تقریبی ۶۴px» از نوار فاصله می‌گرفت) به
             «ردیف میزکار» گرید داخلی منتقل شد؛ در این ردیف، سقفِ پایینیِ چیدمان
             خودِ لبهٔ بالای StatusBar است ⇒ توست به‌طور ساختاری هرگز زیر نوار
             وضعیت نمی‌رود (نسبت به حاشیهٔ عددی مقاوم است: فونت بزرگ/تم فشرده/
             هر ارتفاع نوار). حاشیهٔ ۱۶px فقط نقش نفس‌گیری دارد. -->
        <ItemsControl ItemsSource="{Binding Toasts}"
                      Grid.Row="1"
                      VerticalAlignment="Bottom"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,16"
                      Panel.ZIndex="60"
                      IsHitTestVisible="True"
                      Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- انبارش عمودی از پایین؛ جدیدترین زیرِ قبلی می‌نشیند -->
                    <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- کل کپسول یک دکمه است: کلیک روی هر جای توست = بستن -->
                    <Button Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Cursor="Hand" Margin="0,0,0,10"
                            HorizontalAlignment="Center"
                            Focusable="False"
                            ToolTip="بستن پیام">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <!-- ═══ چرخهٔ ۴۳ (گزارش مالک) ═══
                                     «گوشه هاش کاملاً گرد نباشه بلکه مستطیل با گوشه های
                                     زیاد گرد باشه» — شعاع گوشه از ۲۶ (قرص کامل) به ۱۲
                                     تغییر کرد؛ «در حاشیه سمت راستش نوار عمودی همرنگ نوعش
                                     هم باشه» — نوار عمودی ۵ پیکسری همرنگ نوع در لبهٔ
                                     فیزیکی راست (ستون نخست گرید در RTL) اضافه شد؛ قرصِ
                                     عمودیِ تورفته (Margin عمودی ۱۱) از گوشه‌های گرد کارت
                                     امن است و در هر دو تم خوانا. -->
                                <!-- چرخهٔ ۴۷: پس‌زمینهٔ قطعی سفید — پیشتر قلمِ تم
                                     (MaterialDesign.Brush.Background) خوانده می‌شد که در تم‌های
                                     سفارشی همان رنگ پنجره (#F1F1F1) است و کارت روی پنجره
                                     نامرئی می‌شد (ریشهٔ یکی از تصاویر گزارش مالک). -->
                                <Border x:Name="ToastCard"
                                        CornerRadius="12"
                                        Background="#FFFFFF"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        Padding="0"
                                        MinHeight="52"
                                        MaxWidth="470"
                                        SnapsToDevicePixels="True"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.Effect>
                                        <!-- ═══ چرخهٔ ۴۶ (گزارش مالک: «توست هیچ فرقی نکرده») ═══
                                             سایهٔ پیشین عمق ۴ + بلور ۱۸ داشت ⇒ ~۲۲px سرریز
                                             پایین‌تر از مرز چیدمان کپسول — همان سازوکار بریدنِ
                                             کاشی (افکت، محتوای سرریز را در مرز می‌بُرد) اینجا
                                             هم می‌توانست لبهٔ پایین توست را ببُرد، به‌ویژه وقتی
                                             توست پایین‌ترین عنصر نوار است. سایهٔ جمع‌وجورِ
                                             اطراف (عمق ۲ + بلور ۹ + کدورت ۱۶٪) عمق بصری را
                                             حفظ می‌کند ولی سرریزش ناچیز و بی‌خطر است. -->
                                        <DropShadowEffect BlurRadius="9" ShadowDepth="2"
                                                          Direction="270" Opacity="0.16"
                                                          Color="#0A1E3C" />
                                    </Border.Effect>
                                    <!-- ═══ چرخهٔ ۴۵ (گزارش مالک: «پیام توست ناقص نمایش داده
                                         می‌شود و قسمت پایینش بریده شده») ═══
                                         ریشه: مقدارِ پایهٔ TranslateTransform «Y=14» بود —
                                         RenderTransform جای چیدمان را جابه‌جا نمی‌کند؛ اگر
                                         انیمیشن ورود به هر دلیلی اجرا/تثبیت نشود (یا ساعتش
                                         کنسل شود)، کپسول برای همیشه ۱۴px پایین‌تر از جایگاه
                                         خود رندر می‌شود و DropShadowEffect همین سرریز را در
                                         مرز چیدمان می‌بُرَد → لبهٔ پایین (گوشه‌ها + حاشیه)
                                         ناپدید. رفع: مقدار پایه «Y=0» (حالت سکونِ همیشه
                                         درست) و انیمیشن با From=14 شروع می‌شود — حتی اگر
                                         انیمیشن بیفتد، کپسول سرِ جای خود است. -->
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ToastShift" Y="0" />
                                    </Border.RenderTransform>

                                    <!-- محتوا: [نوار رنگی][آیکون رنگی][متن][ضربدر بستن]
                                         — در RTL ستون نخست = لبهٔ فیزیکی راست -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- نوار عمودی همرنگ نوع — لبهٔ راست کپسول -->
                                        <Border x:Name="AccentStrip" Grid.Column="0"
                                                Width="5" CornerRadius="3"
                                                Margin="0,11,0,11"
                                                Background="#059669" />

                                        <!-- ستون محتوا: آیکون + متن + ضربدر -->
                                        <Grid Grid.Column="1" Margin="17,0,19,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- دایرهٔ آیکون — رنگ/نویسه با تریگر نوع تعیین می‌شود -->
                                            <Border x:Name="IconCircle" Grid.Column="0"
                                                    Width="34" Height="34" CornerRadius="17"
                                                    VerticalAlignment="Center"
                                                    Background="#059669">
                                                <materialDesign:PackIcon x:Name="IconGlyph"
                                                                         Kind="Check"
                                                                         Width="17" Height="17"
                                                                         Foreground="White"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center" />
                                            </Border>

                                            <!-- متن پیام — تیره، نیمه‌درشت، راست‌چین (RTL طبیعی) -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Text}"
                                                       FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="#1F2937"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       Margin="12,8,14,8"
                                                       MaxWidth="360" />

                                            <!-- ضربدرِ بستن — کم‌رنگ؛ با هاور پررنگ -->
                                            <materialDesign:PackIcon x:Name="ToastClose" Grid.Column="2"
                                                                     Kind="Close" Width="13" Height="13"
                                                                     Foreground="#9AA5B1"
                                                                     VerticalAlignment="Center"
                                                                     HorizontalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <!-- ═══ رنگ‌بندی بر طبق نوع — چرخهٔ ۳۸؛ نوار راست چرخهٔ ۴۳ ═══ -->
                                    <DataTrigger Binding="{Binding Kind}" Value="Success">
                                        <Setter TargetName="IconCircle" Property="Background" Value="#059669" />
                                        <Setter TargetName="IconGlyph" Property="Kind" Value="Check" />
                                        <Setter TargetName="AccentStrip" Property="Background" Value="#059669" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Error">
                                        <Setter TargetName="IconCircle" Property="Background" Value="#DC2626" />
                                        <Setter TargetName="IconGlyph" Property="Kind" Value="Close" />
                                        <Setter TargetName="AccentStrip" Property="Background" Value="#DC2626" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                        <Setter TargetName="IconCircle" Property="Background" Value="#D97706" />
                                        <Setter TargetName="IconGlyph" Property="Kind" Value="Alert" />
                                        <Setter TargetName="AccentStrip" Property="Background" Value="#D97706" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Info">
                                        <Setter TargetName="IconCircle" Property="Background" Value="#2563EB" />
                                        <Setter TargetName="IconGlyph" Property="Kind" Value="InformationOutline" />
                                        <Setter TargetName="AccentStrip" Property="Background" Value="#2563EB" />
                                    </DataTrigger>

                                    <!-- هاور: پررنگ‌شدن ضربدر و کمی بالا آمدن کپسول -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ToastClose" Property="Foreground" Value="#5B6773" />
                                        <Setter TargetName="ToastCard" Property="Opacity" Value="0.94" />
                                    </Trigger>

                                    <!-- انیمیشن ورود: محوشدن از پایین داخل خود قالب — نام‌های
                                         قالب فقط از رویدادهای همان قالب قابل نشانه‌گیری‌اند -->
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ToastCard"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ToastShift"
                                                                 Storyboard.TargetProperty="Y"
                                                                 From="14" To="0" Duration="0:0:0.26"
                                                                 FillBehavior="HoldEnd">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </Grid>

        <!-- ═══ لایهٔ همپوشان تور آموزشی — چرخهٔ سی‌وهشتم ═══
             میزبان درون‌پنجره‌ای تور اولین ورود: تور به‌صورت کنترل کاربر
             داخل همین پنجره می‌نشیند (نه پنجرهٔ جدا) تا اندازه‌گیری هدف و
             ترسیم ماسک در همان درخت بصری انجام شود؛ ریشهٔ «هایلایت‌های
             آینه‌ای» تور در پنجره‌های RTL همین جدایی دو پنجره بود.
             پس‌زمینه ندارد → خالی که باشد هیچ نمی‌کشد و کلیک هم از میانش
             به رابط می‌رسد (hit-test شفاف)؛ اما هنگام تور، ماسکِ داخلش
             کلیک ناحیهٔ تیره را می‌بلعد (Fill + IsHitTestVisible خود Path). -->
        <Grid x:Name="TourLayer" Grid.Column="0" Grid.ColumnSpan="2"
              Panel.ZIndex="90" />

    </Grid>
</Window>
