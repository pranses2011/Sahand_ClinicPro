<Window x:Class="Sahand.ClinicPro.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:Sahand.ClinicPro.Desktop.Views"
        xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="سامانه جامع مدیریت درمانگاه سهند"
        Height="780" Width="1280" MinHeight="620" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        FontFamily="Vazirmatn, Segoe UI, Tahoma">
    <Window.Resources>
        <!-- نگاشت ViewModel به View — ناوبری مبتنی بر مدل‌نما -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PatientsViewModel}">
            <views:PatientsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppointmentsViewModel}">
            <views:AppointmentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReceptionsViewModel}">
            <views:ReceptionsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VisitsViewModel}">
            <views:VisitsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrescriptionsViewModel}">
            <views:PrescriptionsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BillingViewModel}">
            <views:BillingView />
        </DataTemplate>
    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════
         پوسته اصلی — گام ۱۰
         ساختار: ستون کنار (ناوبری) + هدر (کاربر/تم/خروج) + میزکار
         همه صفحات در ContentControl میانی با DataTemplate نگاشت می‌شوند
         ═══════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- ستون کنار راست — ناوبری (RTL) -->
            <ColumnDefinition Width="240" />
            <!-- میزکار اصلی -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ ستون کنار ═══ -->
        <Border Grid.Column="0"
                Background="{DynamicResource MaterialDesign.Brush.Primary.Container}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- نام سامانه -->
                <StackPanel Grid.Row="0" Margin="16,20,16,16">
                    <materialDesign:PackIcon Kind="Hospital"
                                             Width="40" Height="40"
                                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                    <TextBlock Text="درمانگاه سهند"
                               FontSize="20" FontWeight="Bold" Margin="0,10,0,0"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                    <TextBlock Text="سامانه جامع مدیریت"
                               FontSize="12" Opacity="0.7"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                </StackPanel>

                <!-- فهرست ناوبری -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="8,10">
                                <materialDesign:PackIcon Kind="{Binding Icon}"
                                                         Width="22" Height="22"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}"
                                           FontSize="14"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- خروج -->
                <Button Grid.Row="2"
                        Command="{Binding LogoutCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="16,8,16,16"
                        HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Logout" VerticalAlignment="Center" />
                        <TextBlock Text="خروج از حساب" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ میزکار ═══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- هدر — عنوان صفحه + کاربر + تم -->
            <Border Grid.Row="0"
                    Padding="24,12"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Background.Variant}"
                    BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <TextBlock Text="{Binding CurrentTitle}"
                                   FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ToggleButton Command="{Binding ToggleThemeCommand}"
                                      Style="{StaticResource MaterialDesignFlatToggleButton}"
                                      ToolTip="تغییر تم روشن و تیره"
                                      Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="ThemeLightDark" />
                        </ToggleButton>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AccountCircle"
                                                     Width="28" Height="28"
                                                     VerticalAlignment="Center" />
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUser}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CurrentDate}"
                                           FontSize="11" Opacity="0.7" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- میزکار صفحات -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
