<UserControl xmlns:shortcuts="clr-namespace:Sahand.ClinicPro.Desktop.Services" x:Class="Sahand.ClinicPro.Desktop.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!-- ═══════════════════════════════════════════════════════════
         تنظیمات و اداری — گام V8
         تنظیمات / لاگ حسابرسی / پرسنل / پشتیبان
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="تنظیمات و مدیریت سامانه"
                       Style="{StaticResource SectionTitle}"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                       FontSize="12" VerticalAlignment="Center"
                       HorizontalAlignment="Left" Margin="12,0,0,0" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                       FontSize="12" VerticalAlignment="Center"
                       HorizontalAlignment="Right" />
        </DockPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding TabIndex}"
                    materialDesign:ColorZoneAssist.Mode="PrimaryLight">

            <!-- تنظیمات -->
            <TabItem Header="تنظیمات کلینیک">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button HorizontalAlignment="Left"
                            Command="{Binding LoadSettingsCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Content="بازخوانی" Margin="0,0,0,8" />
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Settings}"
                              SelectedItem="{Binding SelectedSetting}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                             >
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="کلید" Binding="{Binding Key, Converter={StaticResource PersianDigits}}" Width="Auto" IsReadOnly="True" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="شرح" Binding="{Binding Description, Converter={StaticResource PersianDigits}}" Width="Auto" IsReadOnly="True" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="مقدار" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridCheckBoxColumn Header="رمزنگاری‌شده" Binding="{Binding IsEncrypted}" Width="Auto" IsReadOnly="True" MaxWidth="420" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button shortcuts:SaveShortcut.Number="1" Grid.Row="2"
                            Command="{Binding SaveSettingCommand}"
                            IsEnabled="{Binding SelectedSetting, Converter={StaticResource NotNullToBool}}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Content="ذخیره تنظیم انتخاب‌شده (Ctrl+Shift+1)"
                            Height="40" Margin="0,12,0,0" HorizontalAlignment="Left" />
                </Grid>
            </TabItem>

            <!-- لاگ حسابرسی -->
            <TabItem Header="لاگ حسابرسی">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox materialDesign:HintAssist.Hint="فیلتر نام موجودیت (مثال Patient)"
                                 Text="{Binding AuditEntityFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Width="240" Margin="0,0,12,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding LoadAuditCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Command="{Binding LoadAuditCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Content="اعمال فیلتر" Margin="0,0,8,0" />
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding AuditLogs}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                             >
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="کاربر" Binding="{Binding Username, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="عملیات" Binding="{Binding Action, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="110" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="موجودیت" Binding="{Binding EntityName, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="شناسه" Binding="{Binding EntityId, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="ماژول" Binding="{Binding Module, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="زمان" Binding="{Binding Time, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Command="{Binding AuditPrevCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Content="صفحه قبل" Margin="0,0,8,0" />
                        <Button Command="{Binding AuditNextCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Content="صفحه بعد" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- پرسنل -->
            <!-- چرخه بیست‌وسوم (گزارش شانزدهم مالک): زبانهٔ پرسنل از صفحهٔ تنظیمات حذف شد —
                 پرسنل اکنون صفحهٔ مستقل خودش را دارد (PersonnelView) و آیتم منویی جدا؛
                 زبانه‌های بعدی یک seat عقب رفتند (پشتیبان‌گیری=۲، آرشیو=۳) -->

            <!-- پشتیبان -->
            <TabItem Header="پشتیبان‌گیری">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Command="{Binding RunBackupCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Content="اجرای پشتیبان‌گیری" Margin="0,0,8,0" />
                        <Button Command="{Binding LoadBackupsCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Content="بازخوانی" />
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Backups}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                             >
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="نوع" Binding="{Binding Mode, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="زمان" Binding="{Binding Date, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ═══ آرشیو سالانه — چرخه سیزدهم (درخواست ۷-۷) ═══ -->
            <TabItem Header="🗄 آرشیو سالانه">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- کنترل اجرای آرشیو -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="سال شمسی آرشیو (قدیمی‌تر از این سال):" VerticalAlignment="Center" FontSize="12.5" Margin="0,0,8,0" />
                        <TextBox Text="{Binding ArchiveYear, UpdateSourceTrigger=PropertyChanged}" Width="80" FontSize="12.5"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" FontFamily="{DynamicResource App.CodeFont}" Margin="0,0,8,0" />
                        <Button Command="{Binding ArchivePreviewCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Content="پیش‌نمایش شمارشی" Margin="0,0,8,0" />
                        <Button Command="{Binding ArchiveRunCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                Content="اجرای آرشیو" Margin="0,0,8,0" />
                        <CheckBox Content="حذف فیزیکی (پس از ثبت نسخه آرشیو)"
                                  IsChecked="{Binding ArchiveHardPurge}" VerticalAlignment="Center" FontSize="11.5"
                                  ToolTip="پیش‌فرض خاموش: حذف نرم امن. روشن کنید تا ردیف‌ها بلافاصله فیزیکی حذف شوند — پیش از آن از بانک پشتیبان بگیرید" Margin="0,0,8,0" />
                    </StackPanel>

                    <!-- گزارش اجرا -->
                    <TextBlock Grid.Row="1" Text="{Binding ArchiveReport}" FontSize="12" Foreground="#1565C0"
                               TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding ArchiveReport, Converter={StaticResource StringToVisibility}}" />

                    <!-- مرورگر آرشیو — جستجوی پرونده قدیمی -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <materialDesign:PackIcon Kind="ArchiveSearch" Width="18" Height="18" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <TextBlock Text="مرورگر آرشیو — جستجوی پرونده قدیمی بیمار" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBox Text="{Binding ArchiveSearchTerm, UpdateSourceTrigger=PropertyChanged}" Width="220" FontSize="12"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="نام بیمار یا شرح رکورد" Margin="14,0,0,0" />
                            <Button Command="{Binding ArchiveSearchCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Margin="6,0,0,0" Content="جستجو" />
                        </StackPanel>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding ArchiveRows}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                 
                                  FontSize="11.5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="مقصد" Binding="{Binding TableTitle, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                                <DataGridTextColumn Header="بیمار" Binding="{Binding PatientName, TargetNullValue=—, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                                <DataGridTextColumn Header="شرح" Binding="{Binding SummaryLine, TargetNullValue=—, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                                <DataGridTextColumn Header="تاریخ" Binding="{Binding DateText, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                                <DataGridTextColumn Header="سال" Binding="{Binding YearJalali, Converter={StaticResource PersianDigits}}" Width="Auto" FontFamily="{DynamicResource App.CodeFont}" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>