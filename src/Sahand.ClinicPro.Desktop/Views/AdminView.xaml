<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="Vazirmatn, Segoe UI, Tahoma">
    <!-- ═══════════════════════════════════════════════════════════
         تنظیمات و اداری — گام V8
         تنظیمات / لاگ حسابرسی / پرسنل / پشتیبان
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="تنظیمات و مدیریت سامانه"
                       Style="{StaticResource SectionTitle}"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                       FontSize="12" VerticalAlignment="Center"
                       HorizontalAlignment="Left" Margin="12,0,0,0" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.Error}"
                       FontSize="12" VerticalAlignment="Center"
                       HorizontalAlignment="Right" />
        </DockPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding TabIndex}"
                    materialDesign:ColorZoneAssist.Mode="PrimaryLight">

            <!-- تنظیمات -->
            <TabItem Header="تنظیمات کلینیک">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button HorizontalAlignment="Left"
                            Command="{Binding LoadSettingsCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Content="بازخوانی" Margin="0,0,0,8" />
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Settings}"
                              SelectedItem="{Binding SelectedSetting}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="کلید" Binding="{Binding Key}" Width="220" IsReadOnly="True" />
                            <DataGridTextColumn Header="شرح" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="مقدار" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                            <DataGridCheckBoxColumn Header="رمزنگاری‌شده" Binding="{Binding IsEncrypted}" Width="110" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="2"
                            Command="{Binding SaveSettingCommand}"
                            IsEnabled="{Binding SelectedSetting, Converter={StaticResource NotNullToBool}}"
                            Style="{StaticResource MaterialDesignFilledButton}"
                            Content="ذخیره تنظیم انتخاب‌شده"
                            Height="40" Margin="0,12,0,0" HorizontalAlignment="Left" />
                </Grid>
            </TabItem>

            <!-- لاگ حسابرسی -->
            <TabItem Header="لاگ حسابرسی">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox materialDesign:HintAssist.Hint="فیلتر نام موجودیت (مثال Patient)"
                                 Text="{Binding AuditEntityFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Width="240" Margin="0,0,12,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding LoadAuditCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Command="{Binding LoadAuditCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Content="اعمال فیلتر" Margin="0,0,8,0" />
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding AuditLogs}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="کاربر" Binding="{Binding Username}" Width="130" />
                            <DataGridTextColumn Header="عملیات" Binding="{Binding Action}" Width="110" />
                            <DataGridTextColumn Header="موجودیت" Binding="{Binding EntityName}" Width="140" />
                            <DataGridTextColumn Header="شناسه" Binding="{Binding EntityId}" Width="90" />
                            <DataGridTextColumn Header="ماژول" Binding="{Binding Module}" Width="130" />
                            <DataGridTextColumn Header="زمان" Binding="{Binding Time}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Command="{Binding AuditPrevCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Content="صفحه قبل" Margin="0,0,8,0" />
                        <Button Command="{Binding AuditNextCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Content="صفحه بعد" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- پرسنل -->
            <TabItem Header="پرسنل">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Command="{Binding NewEmployeeCommand}"
                                Style="{StaticResource MaterialDesignFilledButton}"
                                Content="پرسنل جدید" Margin="0,0,8,0" />
                        <Button Command="{Binding LoadEmployeesCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Content="بازخوانی" />
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Employees}"
                              SelectedItem="{Binding SelectedEmployee}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="کد پرسنلی" Binding="{Binding PersonnelCode}" Width="110" />
                            <DataGridTextColumn Header="نام کامل" Binding="{Binding FullName}" Width="*" />
                            <DataGridTextColumn Header="سمت" Binding="{Binding PositionName}" Width="150" />
                            <DataGridTextColumn Header="دپارتمان" Binding="{Binding DepartmentName}" Width="150" />
                            <DataGridTextColumn Header="موبایل" Binding="{Binding Mobile}" Width="120" />
                            <DataGridTextColumn Header="نوع" Binding="{Binding TypeText}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- پشتیبان -->
            <TabItem Header="پشتیبان‌گیری">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Command="{Binding RunBackupCommand}"
                                Style="{StaticResource MaterialDesignFilledButton}"
                                Content="اجرای پشتیبان‌گیری" Margin="0,0,8,0" />
                        <Button Command="{Binding LoadBackupsCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Content="بازخوانی" />
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Backups}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="نوع" Binding="{Binding Mode}" Width="200" />
                            <DataGridTextColumn Header="زمان" Binding="{Binding Date}" Width="180" />
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>