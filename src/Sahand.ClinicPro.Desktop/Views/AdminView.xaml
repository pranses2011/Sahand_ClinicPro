<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!-- ═══════════════════════════════════════════════════════════
         تنظیمات و اداری — گام V8
         تنظیمات / لاگ حسابرسی / پرسنل / پشتیبان
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="تنظیمات و مدیریت سامانه"
                       Style="{StaticResource SectionTitle}"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                       FontSize="12" VerticalAlignment="Center"
                       HorizontalAlignment="Left" Margin="12,0,0,0" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                       FontSize="12" VerticalAlignment="Center"
                       HorizontalAlignment="Right" />
        </DockPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding TabIndex}"
                    materialDesign:ColorZoneAssist.Mode="PrimaryLight">

            <!-- تنظیمات -->
            <TabItem Header="تنظیمات کلینیک">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button HorizontalAlignment="Left"
                            Command="{Binding LoadSettingsCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Content="بازخوانی" Margin="0,0,0,8" />
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Settings}"
                              SelectedItem="{Binding SelectedSetting}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="کلید" Binding="{Binding Key}" Width="220" IsReadOnly="True" />
                            <DataGridTextColumn Header="شرح" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="مقدار" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                            <DataGridCheckBoxColumn Header="رمزنگاری‌شده" Binding="{Binding IsEncrypted}" Width="110" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="2"
                            Command="{Binding SaveSettingCommand}"
                            IsEnabled="{Binding SelectedSetting, Converter={StaticResource NotNullToBool}}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Content="ذخیره تنظیم انتخاب‌شده"
                            Height="40" Margin="0,12,0,0" HorizontalAlignment="Left" />
                </Grid>
            </TabItem>

            <!-- لاگ حسابرسی -->
            <TabItem Header="لاگ حسابرسی">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox materialDesign:HintAssist.Hint="فیلتر نام موجودیت (مثال Patient)"
                                 Text="{Binding AuditEntityFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Width="240" Margin="0,0,12,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding LoadAuditCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Command="{Binding LoadAuditCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Content="اعمال فیلتر" Margin="0,0,8,0" />
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding AuditLogs}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="کاربر" Binding="{Binding Username}" Width="130" />
                            <DataGridTextColumn Header="عملیات" Binding="{Binding Action}" Width="Auto" MinWidth="110" />
                            <DataGridTextColumn Header="موجودیت" Binding="{Binding EntityName}" Width="140" />
                            <DataGridTextColumn Header="شناسه" Binding="{Binding EntityId}" Width="90" />
                            <DataGridTextColumn Header="ماژول" Binding="{Binding Module}" Width="130" />
                            <DataGridTextColumn Header="زمان" Binding="{Binding Time}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Command="{Binding AuditPrevCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Content="صفحه قبل" Margin="0,0,8,0" />
                        <Button Command="{Binding AuditNextCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Content="صفحه بعد" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- پرسنل -->
            <TabItem Header="پرسنل">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Command="{Binding NewEmployeeCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Content="پرسنل جدید" Margin="0,0,8,0" />
                        <Button Command="{Binding LoadEmployeesCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Content="بازخوانی" />
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Employees}"
                              SelectedItem="{Binding SelectedEmployee}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <!-- ─── عکس — چرخه هجدهم (گزارش دوازدهم): نمایش/تعویض/حذف ─── -->
                            <DataGridTemplateColumn Header="عکس" Width="128">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                                    ToolTip="نمایش بزرگ عکس"
                                                    Command="{Binding DataContext.ViewPhotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Foreground="#1565C0" Padding="4,2">
                                                <materialDesign:PackIcon Kind="Image" Width="18" Height="18" />
                                            </Button>
                                            <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                                    ToolTip="انتخاب / تعویض عکس"
                                                    Command="{Binding DataContext.ChangePhotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Foreground="#2E7D32" Padding="4,2">
                                                <materialDesign:PackIcon Kind="ImagePlus" Width="18" Height="18" />
                                            </Button>
                                            <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                                    ToolTip="حذف عکس"
                                                    Command="{Binding DataContext.DeletePhotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Foreground="#C62828" Padding="4,2"
                                                    Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVisibility}}">
                                                <materialDesign:PackIcon Kind="ImageRemove" Width="18" Height="18" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="کد پرسنلی" Binding="{Binding PersonnelCode}" Width="100" />
                            <DataGridTextColumn Header="نام کامل" Binding="{Binding FullName}" Width="170" />
                            <DataGridTextColumn Header="سمت" Binding="{Binding PositionName}" Width="120" />
                            <DataGridTextColumn Header="دپارتمان" Binding="{Binding DepartmentName}" Width="120" />
                            <DataGridTextColumn Header="موبایل" Binding="{Binding Mobile}" Width="110" />
                            <DataGridTextColumn Header="نوع" Binding="{Binding TypeText}" Width="90" />
                            <DataGridTextColumn Header="حقوق پایه (ریال)" Binding="{Binding BaseSalary, StringFormat='#,0'}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="درصد از سود (٪)" Binding="{Binding CommissionPercent, StringFormat='{}{0:0.##}'}" Width="105">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="#8E24AA" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- دکمه ویرایش حقوقی کنار هر ردیف — چرخه دهم -->
                            <DataGridTemplateColumn Header="عملیات" Width="Auto" MinWidth="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✏️ ویرایش حقوقی"
                                                FontSize="11"

                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Command="{Binding DataContext.EditSalaryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- پشتیبان -->
            <TabItem Header="پشتیبان‌گیری">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Command="{Binding RunBackupCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Content="اجرای پشتیبان‌گیری" Margin="0,0,8,0" />
                        <Button Command="{Binding LoadBackupsCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Content="بازخوانی" />
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Backups}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="نوع" Binding="{Binding Mode}" Width="200" />
                            <DataGridTextColumn Header="زمان" Binding="{Binding Date}" Width="180" />
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ═══ آرشیو سالانه — چرخه سیزدهم (درخواست ۷-۷) ═══ -->
            <TabItem Header="🗄 آرشیو سالانه">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- کنترل اجرای آرشیو -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="سال شمسی آرشیو (قدیمی‌تر از این سال):" VerticalAlignment="Center" FontSize="12.5" Margin="0,0,8,0" />
                        <TextBox Text="{Binding ArchiveYear, UpdateSourceTrigger=PropertyChanged}" Width="80" FontSize="12.5"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" FontFamily="Consolas" Margin="0,0,8,0" />
                        <Button Command="{Binding ArchivePreviewCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Content="پیش‌نمایش شمارشی" Margin="0,0,8,0" />
                        <Button Command="{Binding ArchiveRunCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                Content="اجرای آرشیو" Margin="0,0,8,0" />
                        <CheckBox Content="حذف فیزیکی (پس از ثبت نسخه آرشیو)"
                                  IsChecked="{Binding ArchiveHardPurge}" VerticalAlignment="Center" FontSize="11.5"
                                  ToolTip="پیش‌فرض خاموش: حذف نرم امن. روشن کنید تا ردیف‌ها بلافاصله فیزیکی حذف شوند — پیش از آن از بانک پشتیبان بگیرید" Margin="0,0,8,0" />
                    </StackPanel>

                    <!-- گزارش اجرا -->
                    <TextBlock Grid.Row="1" Text="{Binding ArchiveReport}" FontSize="12" Foreground="#1565C0"
                               TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding ArchiveReport, Converter={StaticResource StringToVisibility}}" />

                    <!-- مرورگر آرشیو — جستجوی پرونده قدیمی -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <materialDesign:PackIcon Kind="ArchiveSearch" Width="18" Height="18" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <TextBlock Text="مرورگر آرشیو — جستجوی پرونده قدیمی بیمار" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBox Text="{Binding ArchiveSearchTerm, UpdateSourceTrigger=PropertyChanged}" Width="220" FontSize="12"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="نام بیمار یا شرح رکورد" Margin="14,0,0,0" />
                            <Button Command="{Binding ArchiveSearchCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Margin="6,0,0,0" Content="جستجو" />
                        </StackPanel>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding ArchiveRows}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  FontSize="11.5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="مقصد" Binding="{Binding TableTitle}" Width="100" />
                                <DataGridTextColumn Header="بیمار" Binding="{Binding PatientName, TargetNullValue=—}" Width="170" />
                                <DataGridTextColumn Header="شرح" Binding="{Binding SummaryLine, TargetNullValue=—}" Width="*" />
                                <DataGridTextColumn Header="تاریخ" Binding="{Binding DateText}" Width="110" />
                                <DataGridTextColumn Header="سال" Binding="{Binding YearJalali}" Width="60" FontFamily="Consolas" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>