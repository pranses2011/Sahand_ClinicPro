<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.TrainingCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="660" d:DesignWidth="1140"
             FlowDirection="RightToLeft"
             FontFamily="pack://application:,,,/Assets/Fonts/#Vazirmatn">
    <!-- ═══ مرکز آموزش — چرخه سیزدهم (درخواست ۸-۶):
         فهرست ۱۰ درس + نمایشگر HTML گام‌به‌گام + پیشرفت یادگیری ═══ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <materialDesign:PackIcon Kind="School" Width="26" Height="26"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
            <TextBlock Text="مرکز آموزش" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="۱۰ درس تعاملی گام‌به‌گام — پیشرفت شما در سرور ذخیره می‌شود" FontSize="11.5" Opacity="0.6"
                       VerticalAlignment="Center" Margin="14,3,0,0" />
        </StackPanel>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- فهرست درس‌ها + پیشرفت کلی -->
            <Border Grid.Column="0" CornerRadius="10" Margin="0,0,8,0" Padding="8"
                    Background="{DynamicResource MaterialDesign.Brush.Separator.Background}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- نوار پیشرفت کلی -->
                    <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="12,8" Margin="2,0,2,8">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="پیشرفت یادگیری شما" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ProgressText}" FontSize="12.5" FontWeight="Bold"
                                           Foreground="#1565C0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                            </DockPanel>
                            <ProgressBar Height="8" Margin="0,7,0,3"
                                         Background="#ECEFF1" Foreground="#1565C0"
                                         Value="{Binding ProgressPercent}" Maximum="100" />
                            <Button Command="{Binding ResetProgressCommand}" Style="{StaticResource MaterialDesignFlatButton}"
                                    Content="بازنشانی پیشرفت" FontSize="10.5" Foreground="#E53935"
                                    HorizontalAlignment="Left" Padding="4,2" />
                        </StackPanel>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Lessons}" SelectedItem="{Binding SelectedLesson}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="9" Padding="10,8" Margin="2,3" Background="White">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="19" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="10,0,4,0">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Opacity="0.6" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <!-- نشانگر تکمیل -->
                                        <Border Grid.Column="2" CornerRadius="9" Padding="6,2" VerticalAlignment="Center"
                                                Background="{Binding DoneColor}">
                                            <TextBlock Text="{Binding DoneBadge}" FontSize="10" Foreground="White" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- نمایشگر درس -->
            <materialDesign:Card Grid.Column="1" UniformCornerRadius="12" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WebBrowser Grid.Row="0" x:Name="LessonBrowser" Visibility="Hidden" />
                    <TextBlock Grid.Row="0" Text="از فهرست راست یک درس انتخاب کنید" FontSize="13" Opacity="0.45"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasLesson, Converter={StaticResource InverseBoolToVisibility}}" />
                    <Border Grid.Row="1" Padding="12,8" Background="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                            CornerRadius="0,0,12,12">
                        <DockPanel>
                            <Button Command="{Binding MarkDoneCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                    DockPanel.Dock="Left">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CheckCircle" Width="15" Height="15" VerticalAlignment="Center" />
                                    <TextBlock Text="این درس را تکمیل کردم" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding LessonMeta}" FontSize="11" Opacity="0.65" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
