<Window x:Class="Sahand.ClinicPro.Desktop.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Sahand.ClinicPro.Desktop.Helpers"
        Title="در حال بارگذاری…"
        Width="640" Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Cursor="Wait"
        FlowDirection="RightToLeft">
    <!-- ═══════════════════════════════════════════════════════════
         پنجرهٔ اسپلش — چرخه بیست‌وچهارم (گزارش هفدهم مالک):
         «برنامه Splash با انیمیشن و نوار پیشرفت بساز که خیلی زیبا و با
         زمینهٔ شفاف باشه و از همون تصویر بزرگ آیکون استفاده بکن که زمینهٔ
         شفاف هم داره چون نمیخوام معمولی و مثل فرم دیده بشه».
         چرخهٔ سی‌وسوم: تصویر بزرگ‌تر شد و هیچ ظرف پس‌زمینه‌ای نماند.
         ═══ چرخهٔ سی‌وهشتم (گزارش مالک) ═══
         «در صفحه Splash فقط پشت تصویر کامل شفاف باشه و زیر نوشته‌ها یک
         کادر مستطیلی با گوشه‌های گرد بگذار»:
         • لوگو حالا هیچ جلوهٔ بصری ندارد — DropShadow قبلی روی PNG شفاف،
           هالهٔ تیره‌ای «پشت تصویر» می‌کشید و شفافیت کامل را می‌شکست؛ حذف شد.
         • نوشته‌ها (عنوان + نسخه + پیام مرحله‌ای + نوار پیشرفت) حالا داخل
           یک کادر مستطیلی گوشه‌گرد نیمه‌مات نیلی با حاشیهٔ آبی‌روشن
           نشسته‌اند؛ چون کادر خودش زمینهٔ تیرهٔ خوانا می‌دهد، سایه‌های
           جداگانهٔ هر متن حذف شدند — تمیزتر و یکدست‌تر.
         ═══════════════════════════════════════════════════════════ -->
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <!-- لوگوی بزرگ — بدون هیچ جلوه: پس‌زمینهٔ پشت تصویر کاملاً شفاف است -->
        <Image x:Name="LogoImage"
               Source="/Assets/Logo/ClinicPro-512.png"
               Width="280" Height="280"
               RenderTransformOrigin="0.5,0.5"
               Margin="0,0,0,18">
            <Image.RenderTransform>
                <ScaleTransform x:Name="LogoScale" ScaleX="0.8" ScaleY="0.8" />
            </Image.RenderTransform>
            <Image.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <!-- محوشدن ورود -->
                            <DoubleAnimation Storyboard.TargetName="LogoImage"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.55">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <!-- بزرگ‌نمایی نرم تا اندازهٔ واقعی -->
                            <DoubleAnimation Storyboard.TargetName="LogoScale"
                                             Storyboard.TargetProperty="ScaleX"
                                             From="0.8" To="1" Duration="0:0:0.6">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase Amplitude="0.3" EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LogoScale"
                                             Storyboard.TargetProperty="ScaleY"
                                             From="0.8" To="1" Duration="0:0:0.6">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase Amplitude="0.3" EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <!-- نبض آرام بی‌نهایت — حس زنده‌بودن -->
                            <DoubleAnimation Storyboard.TargetName="LogoImage"
                                             Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.88" BeginTime="0:0:0.8"
                                             Duration="0:0:1.1" AutoReverse="True"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Image.Triggers>
        </Image>

        <!-- ═══ کادر مستطیلی گوشه‌گرد زیر نوشته‌ها — چرخهٔ ۳۸ ═══
             شیشهٔ نیلی نیمه‌مات (۸۵٪ آلفا) با حاشیهٔ آبی‌روشن و سایهٔ نرمِ
             خودش؛ زمینهٔ تیرهٔ خوانا برای متن‌های سفید بدون نیاز به سایه‌های
             جداگانه (که حذف شدند). -->
        <Border Background="#D9132B50" CornerRadius="18"
                Padding="26,18,26,20"
                BorderBrush="#5C8CB4E3" BorderThickness="1"
                Width="430">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.35" Color="#0A1E3C" />
            </Border.Effect>
            <StackPanel>
                <!-- نام محصول — سفید درشت؛ زمینهٔ تیرهٔ کادر خوانایی را می‌دهد -->
                <TextBlock Text="سامانه جامع مدیریت درمانگاه سهند"
                           FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"
                           HorizontalAlignment="Center" Margin="0,0,0,4" />

                <!-- شمارهٔ نسخه — پیل ریز درخشان؛ منبع تک‌نسخهٔ AppInfo -->
                <Border Background="#331E4E85" CornerRadius="11" Padding="13,4"
                        HorizontalAlignment="Center" Margin="0,6,0,4"
                        BorderBrush="#8CB4E3" BorderThickness="1">
                    <TextBlock Text="{x:Static helpers:AppInfo.VersionText}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#EAF3FE" />
                </Border>

                <!-- پیام مرحله‌ای -->
                <TextBlock x:Name="SubtitleText" Text="در حال آماده‌سازی…"
                           FontSize="13" Foreground="#EAF3FE"
                           HorizontalAlignment="Center" Margin="0,6,0,14" />

                <!-- نوار پیشرفت — درون کادر؛ پس‌زمینهٔ تیره‌تر از خود شیشه -->
                <Grid Width="370" HorizontalAlignment="Center">
                    <Border Background="#4D0C1C33" CornerRadius="9" Height="16" />
                    <Border x:Name="ProgressFill" HorizontalAlignment="Left"
                            Width="0" CornerRadius="9" Height="16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#4FA3E3" Offset="0" />
                                <GradientStop Color="#8FD4FF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <!-- درصد فارسی روی نوار -->
                    <TextBlock x:Name="ProgressText" Text="۰٪"
                               FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
