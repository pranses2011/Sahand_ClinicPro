<Window x:Class="Sahand.ClinicPro.Desktop.Views.WaitingRoomSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        Title="تنظیمات نمایشگر سالن انتظار"
        Width="1060" Height="700"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        ResizeMode="NoResize">
    <!-- ═══════════════════════════════════════════════════════════════
         تنظیمات نمایشگر سالن انتظار — چرخهٔ ۷۴ (گزارش مالک)
         «برای نمایشگر سالن انتظار تنظیمات هم بزار تا بتونیم تعیین بکنیم که
         چه چیزی رو نمایش بده (لیست انتظار پزشک با انتخاب پزشک مورد نظر،
         لیست انتظار خدمات درمانی، لیست انتظار دندانپزشکی، لیست انتظار چشم
         پزشکی، و همچنین سایر موارد… مانند تنظیمات ساعت آنالوگ و ساعت
         دیجیتال و تاریخ). فقط اینو در نظر داشته باش که تبلیغات نرم افزار
         همیشه عضو ثابت این صفحه باشه و بقیه موارد رو بشه تنظیم کرد و
         همچنین میخوام این تنظیمات بصورت Drag &amp; Drop پیاده سازی بشه و
         پیش نمایش هم داشته باشه».
         چیدمان: ستون تنظیمات (راست) + پیش‌نمایش زندهٔ کوچک‌شده (چپ).
         D&D: جابه‌جایی ردیف‌های فهرست بخش‌ها با درگ ماوس یا دکمه‌های بالا/پایین.
         ═══════════════════════════════════════════════════════════════ -->
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <!-- ستون تنظیمات -->
            <ColumnDefinition Width="430" />
            <!-- پیش‌نمایش زنده -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════ ستون تنظیمات ═══════ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
            <StackPanel>
                <TextBlock Text="نمایش و چیدمان" FontSize="16" FontWeight="Bold" Margin="2,0,2,10" />

                <!-- نام درمانگاه -->
                <TextBlock Text="نام درمانگاه روی نمایشگر" FontSize="11.5" Opacity="0.7" Margin="2,0,2,4" />
                <TextBox x:Name="ClinicNameBox"
                         materialDesign:HintAssist.Hint="خالی = نام همگام‌شده از سرور لایسنس" />
                <TextBlock Text="خالی بگذارید تا نام درمانگاه از سرور لایسنس بیاید؛ «درمانگاه سهند» نام نرم‌افزار است."
                           FontSize="10" Opacity="0.55" Margin="2,4,2,0" TextWrapping="Wrap" />

                <!-- ═══ چرخهٔ ۷۵ — اعلان زیر نام درمانگاه ═══ -->
                <TextBlock Text="اعلان زیر نام درمانگاه (اختیاری)" FontSize="11.5" Opacity="0.7" Margin="2,14,2,4" />
                <TextBox x:Name="AnnouncementBox"
                         materialDesign:HintAssist.Hint="مثلاً: امروز ویزیت اطفال برقرار است"
                         TextWrapping="Wrap" MaxLength="180" />
                <TextBlock Text="خالی = پیام پیش‌فرض «لطفاً در سالن انتظار حضور داشته باشید…»"
                           FontSize="10" Opacity="0.55" Margin="2,4,2,0" TextWrapping="Wrap" />

                <!-- ═══ چرخهٔ ۷۵ — تعداد ستون‌های ناحیهٔ صف‌ها ═══ -->
                <TextBlock Text="تعداد ستون‌های صف‌ها (پایین نمایشگر)" FontSize="11.5" Opacity="0.7" Margin="2,14,2,4" />
                <!-- ═══ چرخهٔ ۷۶ — SelectedIndex عمداً در XAML تنظیم نمی‌شود:
                     مقداردهی در سازنده انجام می‌شود. تنظیم XAMLی رویداد
                     SelectionChanged را «وسطِ InitializeComponent» شعله‌ور
                     می‌کرد و پیش‌نمایش هنوز ساخته‌نشده بود → NullReference ═══ -->
                <ComboBox x:Name="ColumnCountCombo" SelectionChanged="OnAnySettingChanged">
                    <ComboBoxItem Content="۱ ستون" Tag="1" />
                    <ComboBoxItem Content="۲ ستون" Tag="2" />
                    <ComboBoxItem Content="۳ ستون (پیشنهادی)" Tag="3" />
                    <ComboBoxItem Content="۴ ستون" Tag="4" />
                </ComboBox>
                <TextBlock Text="بخش‌ها ستونی چیده می‌شوند و هر ستون می‌تواند دو بخش را روی هم جا دهد."
                           FontSize="10" Opacity="0.55" Margin="2,4,2,0" TextWrapping="Wrap" />

                <!-- مانیتور هدف -->
                <TextBlock Text="نمایشگر هدف (مانیتور / تلویزیون سالن)" FontSize="11.5" Opacity="0.7" Margin="2,14,2,4" />
                <ComboBox x:Name="ScreenCombo" DisplayMemberPath="Title" />
                <TextBlock Text="نمایشگر روی همان صفحهٔ انتخابی تمام‌صفحه باز می‌شود تا نرم‌افزار روی مانیتور اصلی آزاد بماند."
                           FontSize="10" Opacity="0.55" Margin="2,4,2,0" TextWrapping="Wrap" />

                <!-- سوییچ‌های ساعت/تاریخ + تنظیمات قالب و رنگ ساعت (چرخهٔ ۷۹) -->
                <TextBlock Text="ساعت و تاریخ" FontSize="13" FontWeight="Bold" Margin="2,16,2,6" />
                <CheckBox x:Name="AnalogClockCheck" Content="ساعت آنالوگ (خطوط ساعت/دقیقه + ثانیه‌شمار پیوسته)" Margin="2,2" />
                <CheckBox x:Name="DigitalClockCheck" Content="ساعت دیجیتال کوچک (زیر آنالوگ، با ثانیه)" Margin="2,2" />
                <CheckBox x:Name="LongDateCheck" Content="تاریخ بلند (تاریخ امروز : ۲۳ مهر ماه ۱۴۰۵)" Margin="2,2" />

                <!-- ═══ چرخهٔ ۷۹ — تنظیمات قالب صفحه و رنگ ساعت ═══
                     گزارش مالک: «برای ساعت هم تنظیمات بزار تا هم بتونیم صفحه
                     ساعت و هم رنگشو تغییر بدیم» — پیش‌نمایش زنده در ستون راست
                     همان کنترل واقعی AnalogClock است (نه دایرهٔ ساده) و بلافاصله
                     با تغییر هر تنظیم تازه می‌شود. -->
                <TextBlock Text="قالب صفحهٔ ساعت آنالوگ" FontSize="11.5" Opacity="0.7" Margin="2,10,2,4" />
                <ComboBox x:Name="ClockFaceStyleCombo" SelectionChanged="OnClockFaceOrThemeChanged">
                    <ComboBoxItem Content="کلاسیک — خطوط ساعت/دقیقه + اعداد ۱۲/۳/۶/۹ (پیش‌فرض)" Tag="0" />
                    <ComboBoxItem Content="اعداد کامل — ۱۲ عدد فارسی روی صفحه" Tag="1" />
                    <ComboBoxItem Content="مینیمال — فقط خطوط کلفت ساعت، بدون عدد" Tag="2" />
                </ComboBox>
                <TextBlock Text="رنگ ساعت (صفحه، عقربه‌ها، اعداد و متن ساعت دیجیتال)" FontSize="11.5" Opacity="0.7" Margin="2,10,2,4" />
                <ComboBox x:Name="ClockColorThemeCombo" SelectionChanged="OnClockFaceOrThemeChanged">
                    <ComboBoxItem Content="نیلی (پیش‌فرض)" Tag="0" />
                    <ComboBoxItem Content="زمردی" Tag="1" />
                    <ComboBoxItem Content="کهربایی — مناسب سالن کم‌نور" Tag="2" />
                    <ComboBoxItem Content="یاقوتی — تشخیص بالا از دور" Tag="3" />
                    <ComboBoxItem Content="نقره‌ای" Tag="4" />
                </ComboBox>

                <!-- ═══ چرخهٔ ۷۵ — اقلام اختیاری تبلیغ (تصویر و نام همیشه ثابت‌اند) ═══ -->
                <TextBlock Text="تبلیغ نرم‌افزار (ستون چپ)" FontSize="13" FontWeight="Bold" Margin="2,16,2,6" />
                <TextBlock Text="تصویر و نام نرم‌افزار همیشه نمایش داده می‌شوند؛ اقلام زیر اختیاری‌اند:"
                           FontSize="10" Opacity="0.55" Margin="2,0,2,4" TextWrapping="Wrap" />
                <CheckBox x:Name="AdSubtitleCheck" Content="زیرنویس «سامانهٔ جامع مدیریتی»" Margin="2,2" />
                <CheckBox x:Name="AdFeaturesCheck" Content="فهرست ویژگی‌های محصول" Margin="2,2" />
                <CheckBox x:Name="AdVersionCheck" Content="نسخهٔ محصول در پایین کارت" Margin="2,2" />

                <!-- بخش‌ها -->
                <TextBlock Text="بخش‌های نمایشی (صف‌ها و لیست‌ها)" FontSize="13" FontWeight="Bold" Margin="2,16,2,6" />
                <TextBlock Text="جابه‌جایی با کشیدن و رها کردن (Drag &amp; Drop) یا دکمه‌های پیکان — ترتیب همین ترتیب روی نمایشگر است."
                           FontSize="10" Opacity="0.55" Margin="2,0,2,6" TextWrapping="Wrap" />

                <Border CornerRadius="10" BorderBrush="#E1E8F2" BorderThickness="1" Background="#FAFCFF">
                    <DockPanel>
                        <!-- دکمه‌های جابه‌جایی و افزودن -->
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8,8,8,8">
                            <Button x:Name="AddSectionButton" Click="OnAddSection"
                                    Style="{StaticResource MaterialDesignRaisedButton}" FontSize="11.5">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock Text="افزودن بخش" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RemoveSectionButton" Click="OnRemoveSection"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="11.5"
                                    Foreground="#C62828" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock Text="حذف بخش انتخابی" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="MoveUpButton" Click="OnMoveUp" Width="38" Padding="0" Margin="8,0,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" ToolTip="جابه‌جایی به بالا">
                                <materialDesign:PackIcon Kind="ChevronUp" Width="16" Height="16" />
                            </Button>
                            <Button x:Name="MoveDownButton" Click="OnMoveDown" Width="38" Padding="0" Margin="4,0,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" ToolTip="جابه‌جایی به پایین">
                                <materialDesign:PackIcon Kind="ChevronDown" Width="16" Height="16" />
                            </Button>
                        </StackPanel>

                        <!-- فهرست بخش‌ها — قابل درگ -->
                        <ListBox x:Name="SectionsList" MinHeight="150" MaxHeight="230"
                                 BorderThickness="0" SelectionMode="Single"
                                 SelectionChanged="OnSectionsListSelectionChanged"
                                 PreviewMouseMove="OnSectionsListPreviewMouseMove"
                                 Drop="OnSectionsListDrop" AllowDrop="True"
                                 DragOver="OnSectionsListDragOver">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,4">
                                        <materialDesign:PackIcon Kind="DragVertical" Width="15" Height="15"
                                                                 Opacity="0.4" VerticalAlignment="Center" Cursor="Hand" />
                                        <materialDesign:PackIcon Kind="{Binding Icon}" Width="16" Height="16"
                                                                 Margin="8,0,0,0" VerticalAlignment="Center"
                                                                 Foreground="#1565C0" />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Detail}" FontSize="10.5" Opacity="0.6"
                                                   Margin="10,1,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- ویرایش بخش انتخابی -->
                <TextBlock x:Name="EditorHeader" Text="ویرایش بخش انتخابی" FontSize="12.5" FontWeight="Bold"
                           Margin="2,14,2,6" Visibility="Collapsed" />
                <Border x:Name="EditorPanel" CornerRadius="10" BorderBrush="#E1E8F2" BorderThickness="1"
                        Background="#FAFCFF" Padding="10" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="عنوان روی کارت" FontSize="11" Opacity="0.7" Margin="2,0,2,3" />
                        <TextBox x:Name="SectionTitleBox" TextChanged="OnEditorChanged" />
                        <TextBlock x:Name="EditorTargetLabel" Text="پزشک" FontSize="11" Opacity="0.7" Margin="2,10,2,3" />
                        <ComboBox x:Name="EditorTargetCombo" DisplayMemberPath="Name"
                                  SelectionChanged="OnEditorChanged" />
                    </StackPanel>
                </Border>

                <!-- دکمه‌های پایانی -->
                <StackPanel Orientation="Horizontal" Margin="2,18,2,0">
                    <Button x:Name="SaveAndOpenButton" Click="OnSaveAndOpen"
                            Style="{StaticResource MaterialDesignRaisedButton}" FontSize="12.5" MinWidth="170">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Monitor" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="ذخیره و باز کردن نمایشگر" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ResetButton" Click="OnReset" Style="{StaticResource MaterialDesignOutlinedButton}"
                            FontSize="12" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Restore" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="بازگشت به پیش‌فرض" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelButton" Click="OnCancel" Style="{StaticResource MaterialDesignFlatButton}"
                            FontSize="12" Margin="10,0,0,0" Content="انصراف" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════ ستون پیش‌نمایش زنده — کوچک‌شدهٔ نمایشگر واقعی ═══════ -->
        <Border Grid.Column="1" CornerRadius="14" Background="#0A1626" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="پیش‌نمایش زنده" FontSize="12" Foreground="#7FC4FF" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,10" />
                <!-- ماکت چیدمان -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>
                    <!-- راست: پشتهٔ ساعت — چرخهٔ ۷۹: پیش‌نمایش ساعت آنالوگ حالا
                         «کنترل واقعی» است؛ قالب صفحه و رنگ انتخابی بلافاصله
                         همان‌جا دیده می‌شود (پیش‌تر فقط یک دایرهٔ ساده بود) -->
                    <StackPanel Grid.Column="0">
                        <controls:AnalogClock x:Name="PreviewAnalogClock" Width="74" Height="74" Margin="0,4,0,8"
                                              HorizontalAlignment="Center"
                                              Visibility="{Binding ShowAnalogClock, Mode=OneWay}" />
                        <TextBlock x:Name="PreviewDigital" Text="۱۴:۳۵:۰۵" FontSize="9.5" Foreground="#BBDEFB"
                                   HorizontalAlignment="Center" FontFamily="{DynamicResource App.CodeFont}" />
                        <TextBlock x:Name="PreviewDate" Text="تاریخ امروز : ۲۳ مهر ماه ۱۴۰۵" FontSize="6.5"
                                   Foreground="#8FBFE8" HorizontalAlignment="Center" TextWrapping="Wrap"
                                   Margin="2,4,2,0" />
                    </StackPanel>
                    <!-- میانه: نام درمانگاه + اعلان + بخش‌های ستونی -->
                    <DockPanel Grid.Column="1" Margin="10,0">
                        <!-- بالا: نام درمانگاه + اعلان زیرش (چرخهٔ ۷۵) -->
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock x:Name="PreviewClinicName" Text="درمانگاه" FontSize="15" FontWeight="Black"
                                       Foreground="White" HorizontalAlignment="Center" />
                            <TextBlock x:Name="PreviewAnnouncement" Text="لطفاً در سالن انتظار حضور داشته باشید…"
                                       FontSize="6.5" Foreground="#7FA8CC" HorizontalAlignment="Center"
                                       Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="220" TextAlignment="Center" />
                        </StackPanel>
                        <!-- پایین: بخش‌های صف در چیدمان ستونی (چرخهٔ ۷۵) —
                             ستون‌ها و کارت‌ها در کد پشت ساخته می‌شوند -->
                        <Grid x:Name="PreviewColumns" Margin="0,8,0,0" VerticalAlignment="Top" />
                    </DockPanel>
                    <!-- چپ: تبلیغ — تصویر + نام ثابت؛ اقلام دیگر اختیاری -->
                    <StackPanel Grid.Column="2">
                        <Border Background="#0E2036" BorderBrush="#1E3A5C" BorderThickness="1" CornerRadius="8"
                                Padding="6">
                            <StackPanel>
                                <Image Source="pack://application:,,,/Assets/Logo/ClinicPro-512.png"
                                       Width="52" Height="52" HorizontalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock x:Name="PreviewAdSubtitle" Text="سامانهٔ جامع مدیریتی" FontSize="7.5"
                                           Foreground="#E3F2FD" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                <TextBlock Text="درمانگاه سهند" FontSize="9" FontWeight="Black" Foreground="#7FC4FF"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="PreviewAdFeatures" Text="✓ پروندهٔ الکترونیک …" FontSize="6.5"
                                           Foreground="#9DB8CF" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                <TextBlock x:Name="PreviewAdVersion" Text="نسخهٔ ۲.۱۸.۰" FontSize="6"
                                           Foreground="#54718C" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="تصویر و نام همیشه ثابت — بقیه اقلام از تنظیمات"
                                   FontSize="6" Foreground="#54718C" HorizontalAlignment="Center"
                                   Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="2" Text="خروج از نمایشگر: Esc — باز کردن تنظیمات: راست‌کلیک روی نمایشگر"
                           FontSize="9.5" Foreground="#54718C" HorizontalAlignment="Center" Margin="0,10,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
