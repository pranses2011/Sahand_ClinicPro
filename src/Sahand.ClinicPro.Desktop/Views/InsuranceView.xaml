<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.InsuranceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:behaviors="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="1080"
             FlowDirection="RightToLeft">
    <!-- ═══ مدیریت بیمه — گام U11 طبق فرم ۱۹: ۴ تب ═══ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <materialDesign:PackIcon Kind="ShieldAccount" Width="26" Height="26"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
            <TextBlock Text="مدیریت بیمه" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
            <Button Command="{Binding LoadCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="14,0,0,0">
                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" />
            </Button>
        </StackPanel>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <TabControl Grid.Row="2" Style="{StaticResource MaterialDesignTabControl}">
            <!-- ═══ تب بیمه‌ها — چرخه بیست‌وسوم (گزارش شانزدهم مالک): «بتوان بیمه جدید
                 تعریف کرد و یا بیمه‌های موجود را ویرایش کرد» — نوار ابزار + ستون نوع/وضعیت ═══ -->
            <TabItem Header="🏦 شرکت‌های بیمه">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,8">
                        <Button Command="{Binding NewCompanyCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="بیمهٔ جدید" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding EditCompanyCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Pencil" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="ویرایش بیمهٔ انتخاب‌شده" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Companies}" SelectedItem="{Binding SelectedCompany}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="نام شرکت" Binding="{Binding Name, Converter={StaticResource PersianDigits}}" Width="Auto" FontWeight="SemiBold" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="کد" Binding="{Binding Code, TargetNullValue=—, Converter={StaticResource PersianDigits}}" Width="Auto" FontFamily="{DynamicResource App.CodeFont}" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="نوع" Binding="{Binding TypeName, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="درصد پوشش" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="CoveragePercent" StringFormat="{}{0:N0}٪" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <!-- وضعیت فعال — متن فارسی از خاصیت محاسبه‌شدهٔ رکورد -->
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420"  ElementStyle="{StaticResource App.TableCellTextBlock}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ═══ تب تعرفه‌ها — چرخه بیست‌وسوم: «بتوان تعرفه جدید تعریف کرد و یا
                 تعرفه‌های موجود را ویرایش کرد» — نوار ابزار + ستون وضعیت ═══ -->
            <TabItem Header="💲 تعرفه‌ها">
                <DockPanel>
                    <!-- ═══ چرخه ۲۴ — نوار ابزار: هدف تعرفه (آزاد/بیمه‌ها) + دکمه‌ها ═══
                         «تعرفه‌ها برای بیمه‌ها متفاوت می‌تواند باشد و برای آزاد هم
                         تعرفه تعریف بشود» — انتخاب هدف، فهرست را برای همان هدف می‌آورد -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,8">
                        <TextBlock Text="هدف تعرفه:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                        <!-- فهرست اهداف: «آزاد» + شرکت‌های بیمه — از VM (TariffTargetNames)
                             چرخه ۲۴: تعرفه‌ها به‌تفکیک بیمه + تعرفهٔ آزاد -->
                        <ComboBox MinWidth="180" SelectedIndex="{Binding TariffTargetIndex}"
                                  ItemsSource="{Binding TariffTargetNames}" />
                        <Button Command="{Binding NewTariffCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}" Margin="14,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="تعرفهٔ جدید" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding EditTariffCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Pencil" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="ویرایش تعرفهٔ انتخاب‌شده" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="📍 نمایش تعرفه‌ها برای:" VerticalAlignment="Center"
                                   FontWeight="Bold" Foreground="#1565C0" Margin="14,0,6,0" />
                        <TextBlock Text="{Binding TariffTargetLabel, Mode=OneWay}" VerticalAlignment="Center"
                                   FontWeight="Bold" Foreground="#1565C0" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Tariffs}" SelectedItem="{Binding SelectedTariff}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="کد خدمت" Binding="{Binding Code, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="نام خدمت" Binding="{Binding ServiceName, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <!-- چرخه ۲۴: نشان «اختصاصی/پایه» — آیا خدمت برای بیمهٔ منتخب تعرفهٔ جدا دارد؟ -->
                            <DataGridTextColumn Header="نوع تعرفه" Binding="{Binding TargetBadge, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <!-- ═══ چرخهٔ سی‌ودوم (گزارش مالک) ═══ سه اصلاح:
                                 ۱) «برای لیست تعرفه‌ها برای ستون تعرفه و درصد بیمار و
                                 درصد بیمه فونت اعمال نمی‌شود» — فونت هاردکد Consolas
                                 (که ارقام فارسی ندارد → fallback ناهمگون) با منبع پویای
                                 فونت کد برنامه جایگزین شد.
                                 ۲) هدر ستون‌های سهم پیش‌تر «(ریال)» بود در حالی که این
                                 درصدهای ۰-۱۰۰ هستند — اکنون «٪» درست است.
                                 ۳) برای هدف «آزاد» سرور همیشه ۰/۱۰۰ برمی‌گرداند و لیست
                                 دیگر سهم بیمهٔ غیرواقعی نشان نمی‌دهد. -->
                            <!-- ستون‌های عددی لیست تعرفه — چرخهٔ سی‌وهفتم (گزارش مالک):
                                 «در لیست تعرفه‌ها ستون تعرفه و درصد بیمار و درصد بیمه رو وسط‌چین بکن»
                                 — هر سه ستون عددی از راست‌چین به وسط‌چین تغییر یافت. -->
                            <DataGridTextColumn Header="قیمت تعرفه" Width="Auto" MaxWidth="420">
                                <!-- ⚠ اصلاح خطای MC3000 (v2.4.7): در کامیت تعرفهٔ بیمه، کوتیشنِ
                                     آغازینِ مقدار صفت Converter جا افتاده بود و آکولادِ بی‌کوتیشن
                                     XML را نامعتبر می‌کرد؛ حالا مقدار در جفت‌کوتیشن کامل است. -->
                                <DataGridTextColumn.Binding><Binding Path="Price" Converter="{StaticResource CurrencyRial}" /></DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource App.TableCellTextBlock}">
                                        <Setter Property="FontFamily" Value="{DynamicResource App.CodeFont}" />
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="٪ سهم بیمه" Width="Auto" MaxWidth="420">
                                <DataGridTextColumn.Binding><Binding Path="InsuranceShare" StringFormat="{}{0} ٪" /></DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource App.TableCellTextBlock}">
                                        <Setter Property="FontFamily" Value="{DynamicResource App.CodeFont}" />
                                        <Setter Property="Foreground" Value="#2E7D32" />
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="٪ سهم بیمار" Width="Auto" MaxWidth="420">
                                <DataGridTextColumn.Binding><Binding Path="PatientShare" StringFormat="{}{0} ٪" /></DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource App.TableCellTextBlock}">
                                        <Setter Property="FontFamily" Value="{DynamicResource App.CodeFont}" />
                                        <Setter Property="Foreground" Value="#C62828" />
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420"  ElementStyle="{StaticResource App.TableCellTextBlock}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="📋 مطالبات">
                <Grid Margin="4,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Command="{Binding NewClaimCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                            HorizontalAlignment="Left" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="ایجاد مطالبه دوره‌ای جدید" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Claims}" SelectedItem="{Binding SelectedClaim}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="شماره مطالبه" Binding="{Binding ClaimNumber, TargetNullValue=—, Converter={StaticResource PersianDigits}}" Width="Auto" FontFamily="{DynamicResource App.CodeFont}" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="بیمه" Binding="{Binding InsuranceName, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="دوره" Binding="{Binding PeriodText, TargetNullValue=—, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <!-- ═══ چرخهٔ بیست‌وششم (گزارش هجدهم مالک) ═══ «تمامی اعداد
                                 بدون استثنا فارسی باشند» — سه ستون مبلغ با
                                 StringFormat لاتین بودند (ارقام و کامای انگلیسی)؛
                                 اکنون مبدل مبلغ برنامه (ارقام فارسی + جداکنندهٔ
                                 فارسی + واحد پول کاربر) اعمال می‌شود -->
                            <DataGridTextColumn Header="مبلغ ارسالی" Width="Auto"
                                Binding="{Binding TotalAmount, Converter={StaticResource CurrencyRial}}" MaxWidth="420">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource App.TableCellTextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="مبلغ تأییدی" Width="Auto"
                                Binding="{Binding ApprovedAmount, Converter={StaticResource CurrencyRial}}" MaxWidth="420">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource App.TableCellTextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="دریافتی" Width="Auto"
                                Binding="{Binding ReceivedAmount, Converter={StaticResource CurrencyRial}}" MaxWidth="420">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource App.TableCellTextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="وضعیت" Width="Auto" MaxWidth="420">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="9,2" HorizontalAlignment="Center"
                                                Background="{Binding StatusColor}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="🔍 استعلامات">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="CardSearchOutline" Width="56" Height="56" Opacity="0.4" HorizontalAlignment="Center" />
                    <TextBlock Text="استعلامات برخط از فرم پذیرخ اجرا می‌شود" FontSize="13" Opacity="0.7"
                               Margin="0,10,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="سابقه کامل استعلامات در گام U18 همراه گزارش سامانه بیمه فعال می‌شود"
                               FontSize="11.5" Opacity="0.55" Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </TabItem>
            <!-- ═══ تب تسویه حساب بیمه — چرخه ۱۳ (درخواست ۲-۱) ═══ -->
            <TabItem Header="⚖️ تسویه بیمه">
                <Grid Margin="4,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- فرم محاسبه -->
                    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBox Text="{Binding FractionInvoiceId, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="شناسه فاکتور بیمه‌ای"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Width="190" FontSize="12.5" Margin="0,0,8,4" />
                        <Button Command="{Binding CalculateFractionmentCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Calculator" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="محاسبه سهم بیمه/بیمار" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ApplyFractionmentCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="اعمال روی فاکتور" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- خلاصه صورتحساب -->
                    <Border Grid.Row="1" Background="#E8F0FE" CornerRadius="10" Padding="11,8" Margin="0,0,0,8"
                            Visibility="{Binding FractionSummaryText, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{Binding FractionSummaryText}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" TextWrapping="Wrap" />
                    </Border>

                    <!-- جدول تفکیک اقلام -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding FractionLines}" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                              FlowDirection="RightToLeft">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="شرح خدمت" Binding="{Binding Description, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="تعداد" Binding="{Binding Quantity, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Binding="{Binding ItemTotal, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}"><DataGridTextColumn.Header><TextBlock><Run Text="مبلغ قلم (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock></DataGridTextColumn.Header></DataGridTextColumn>
                            <DataGridTextColumn Header="فرانشیز" Binding="{Binding Franchise, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420"  ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="سهم بیمه" Binding="{Binding InsuranceShare, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource App.TableCellTextBlock}">
                                        <Setter Property="Foreground" Value="#2E7D32" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="سهم بیمار" Binding="{Binding PatientShare, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource App.TableCellTextBlock}">
                                        <Setter Property="Foreground" Value="#C62828" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="نوع قاعده" Binding="{Binding RuleType, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="مأخذ محاسبه" Binding="{Binding RuleSource, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- فرم قواعد قرارداد -->
                    <WrapPanel Grid.Row="3" Margin="0,12,0,8">
                        <TextBlock Text="📖 قواعد قرارداد بیمه:" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,4" />
                        <ComboBox SelectedIndex="{Binding RuleCompanyIndex}" Width="170" FontSize="11.5" Margin="0,0,7,4"
                                  ItemsSource="{Binding Companies}" DisplayMemberPath="Name" />
                        <ToggleButton IsChecked="{Binding RuleIsNominal}" Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      Content="قاعده اسمی" FontSize="11" Margin="0,0,10,4" VerticalAlignment="Center" />
                        <TextBox Text="{Binding RulePercent, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="درصد بیمه"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="105" FontSize="11.5" Margin="0,0,7,4"
                                 IsEnabled="{Binding RuleIsNominal, Converter={StaticResource InvertBool}, FallbackValue=False}" />
                        <!-- چرخه بیست‌ویکم: جداکنندهٔ زندهٔ ۳ رقمی هنگام تایپ -->
                        <TextBox behaviors:MoneyInput.IsEnabled="True" behaviors:MoneyInput.NumericValue="{Binding RuleNominal, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MoneyRial}}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="140" FontSize="11.5" Margin="0,0,7,4" IsEnabled="{Binding RuleIsNominal}"><materialDesign:HintAssist.Hint><TextBlock><Run Text="مبلغ اسمی (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock></materialDesign:HintAssist.Hint></TextBox>
                        <TextBox behaviors:MoneyInput.IsEnabled="True" behaviors:MoneyInput.NumericValue="{Binding RuleFranchise, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MoneyRial}}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="135" FontSize="11.5" Margin="0,0,7,4"><materialDesign:HintAssist.Hint><TextBlock><Run Text="فرانشیز (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock></materialDesign:HintAssist.Hint></TextBox>
                        <Button Command="{Binding AddRuleCommand}" Style="{StaticResource MaterialDesignRaisedButton}" FontSize="11" Margin="0,0,6,4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="13" Height="13" VerticalAlignment="Center" />
                                <TextBlock Text="ثبت قاعده" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding LoadRulesCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="11" Margin="0,0,0,4">
                            <materialDesign:PackIcon Kind="Refresh" Width="13" Height="13" />
                        </Button>
                    </WrapPanel>

                    <!-- جدول قواعد -->
                    <DataGrid Grid.Row="4" ItemsSource="{Binding FractionRules}" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                              FlowDirection="RightToLeft" MinHeight="90">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="خدمت" Binding="{Binding ServiceName, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="نوع" Binding="{Binding RuleType, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="جزئیات" Binding="{Binding Detail, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="فرانشیز" Binding="{Binding Franchise, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTemplateColumn Header="عملیات" Width="Auto" MinWidth="70" MaxWidth="420">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- چرخهٔ ۷۹: کلید عملیاتی آیکونی (هم‌الگوی لیست بیماران) -->
                                        <Button Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource App.RowIconButton}"
                                                Foreground="#C62828" ToolTip="حذف قانون">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="15" Height="15" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
