<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.InsuranceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="1080"
             FlowDirection="RightToLeft">
    <!-- ═══ مدیریت بیمه — گام U11 طبق فرم ۱۹: ۴ تب ═══ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <materialDesign:PackIcon Kind="ShieldAccount" Width="26" Height="26"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
            <TextBlock Text="مدیریت بیمه" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
            <Button Command="{Binding LoadCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="14,0,0,0">
                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" />
            </Button>
        </StackPanel>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <TabControl Grid.Row="2" Style="{StaticResource MaterialDesignTabControl}">
            <TabItem Header="🏦 شرکت‌های بیمه">
                <DataGrid ItemsSource="{Binding Companies}" AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" HeadersVisibility="Column" FontSize="12" AlternatingRowBackground="#F7FAFD">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="نام شرکت" Binding="{Binding Name}" Width="*" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="کد" Binding="{Binding Code, TargetNullValue=—}" Width="110" FontFamily="Consolas" />
                        <DataGridTextColumn Header="درصد پوشش" Width="110">
                            <DataGridTextColumn.Binding>
                                <Binding Path="CoveragePercent" StringFormat="{}{0:N0}٪" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="💲 تعرفه‌ها">
                <DataGrid ItemsSource="{Binding Tariffs}" AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" HeadersVisibility="Column" FontSize="12" AlternatingRowBackground="#F7FAFD">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="کد خدمت" Binding="{Binding Code}" Width="110" FontFamily="Consolas" />
                        <DataGridTextColumn Header="نام خدمت" Binding="{Binding ServiceName}" Width="*" />
                        <DataGridTextColumn Header="قیمت آزاد (ریال)" Width="130">
                            <DataGridTextColumn.Binding><Binding Path="Price" StringFormat="{}{0:N0}" /></DataGridTextColumn.Binding>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas" /></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="سهم بیمه (ریال)" Width="130">
                            <DataGridTextColumn.Binding><Binding Path="InsuranceShare" StringFormat="{}{0:N0}" /></DataGridTextColumn.Binding>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="Foreground" Value="#2E7D32" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="سهم بیمار (ریال)" Width="130">
                            <DataGridTextColumn.Binding><Binding Path="PatientShare" StringFormat="{}{0:N0}" /></DataGridTextColumn.Binding>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="Foreground" Value="#C62828" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="📋 مطالبات">
                <Grid Margin="4,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Command="{Binding NewClaimCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                            HorizontalAlignment="Left" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="ایجاد مطالبه دوره‌ای جدید" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Claims}" SelectedItem="{Binding SelectedClaim}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" FontSize="12" AlternatingRowBackground="#F7FAFD">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="شماره مطالبه" Binding="{Binding ClaimNumber, TargetNullValue=—}" Width="120" FontFamily="Consolas" />
                            <DataGridTextColumn Header="بیمه" Binding="{Binding InsuranceName}" Width="150" />
                            <DataGridTextColumn Header="دوره" Binding="{Binding PeriodText, TargetNullValue=—}" Width="170" />
                            <DataGridTextColumn Header="مبلغ ارسالی" Width="120">
                                <DataGridTextColumn.Binding><Binding Path="TotalAmount" StringFormat="{}{0:N0}" /></DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="مبلغ تأییدی" Width="120">
                                <DataGridTextColumn.Binding><Binding Path="ApprovedAmount" StringFormat="{}{0:N0}" /></DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="دریافتی" Width="120">
                                <DataGridTextColumn.Binding><Binding Path="ReceivedAmount" StringFormat="{}{0:N0}" /></DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="وضعیت" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="9,2" HorizontalAlignment="Center"
                                                Background="{Binding StatusColor}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="🔍 استعلامات">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="CardSearchOutline" Width="56" Height="56" Opacity="0.4" HorizontalAlignment="Center" />
                    <TextBlock Text="استعلامات برخط از فرم پذیرخ اجرا می‌شود" FontSize="13" Opacity="0.7"
                               Margin="0,10,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="سابقه کامل استعلامات در گام U18 همراه گزارش سامانه بیمه فعال می‌شود"
                               FontSize="11.5" Opacity="0.55" Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </TabItem>
            <!-- ═══ تب تسویه حساب بیمه — چرخه ۱۳ (درخواست ۲-۱) ═══ -->
            <TabItem Header="⚖️ تسویه بیمه">
                <Grid Margin="4,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- فرم محاسبه -->
                    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBox Text="{Binding FractionInvoiceId, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="شناسه فاکتور بیمه‌ای"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Width="190" FontSize="12.5" Margin="0,0,8,4" />
                        <Button Command="{Binding CalculateFractionmentCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Calculator" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="محاسبه سهم بیمه/بیمار" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ApplyFractionmentCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="اعمال روی فاکتور" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- خلاصه صورتحساب -->
                    <Border Grid.Row="1" Background="#E8F0FE" CornerRadius="10" Padding="11,8" Margin="0,0,0,8"
                            Visibility="{Binding FractionSummaryText, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{Binding FractionSummaryText}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#16355E" TextWrapping="Wrap" />
                    </Border>

                    <!-- جدول تفکیک اقلام -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding FractionLines}" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" FlowDirection="RightToLeft">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="شرح خدمت" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="تعداد" Binding="{Binding Quantity}" Width="60" />
                            <DataGridTextColumn Header="مبلغ قلم (ریال)" Binding="{Binding ItemTotal}" Width="120" />
                            <DataGridTextColumn Header="فرانشیز" Binding="{Binding Franchise}" Width="100" />
                            <DataGridTextColumn Header="سهم بیمه" Binding="{Binding InsuranceShare}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#2E7D32" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="سهم بیمار" Binding="{Binding PatientShare}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#C62828" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="نوع قاعده" Binding="{Binding RuleType}" Width="80" />
                            <DataGridTextColumn Header="مأخذ محاسبه" Binding="{Binding RuleSource}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- فرم قواعد قرارداد -->
                    <WrapPanel Grid.Row="3" Margin="0,12,0,8">
                        <TextBlock Text="📖 قواعد قرارداد بیمه:" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,4" />
                        <ComboBox SelectedIndex="{Binding RuleCompanyIndex}" Width="170" FontSize="11.5" Margin="0,0,7,4"
                                  ItemsSource="{Binding Companies}" DisplayMemberPath="Name" />
                        <ToggleButton IsChecked="{Binding RuleIsNominal}" Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      Content="قاعده اسمی" FontSize="11" Margin="0,0,10,4" VerticalAlignment="Center" />
                        <TextBox Text="{Binding RulePercent, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="درصد بیمه"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="105" FontSize="11.5" Margin="0,0,7,4"
                                 IsEnabled="{Binding RuleIsNominal, Converter={StaticResource InvertBool}, FallbackValue=False}" />
                        <TextBox Text="{Binding RuleNominal, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="مبلغ اسمی (ریال)"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="140" FontSize="11.5" Margin="0,0,7,4"
                                 IsEnabled="{Binding RuleIsNominal}" />
                        <TextBox Text="{Binding RuleFranchise, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="فرانشیز (ریال)"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="135" FontSize="11.5" Margin="0,0,7,4" />
                        <Button Command="{Binding AddRuleCommand}" Style="{StaticResource MaterialDesignRaisedButton}" FontSize="11" Margin="0,0,6,4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="13" Height="13" VerticalAlignment="Center" />
                                <TextBlock Text="ثبت قاعده" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding LoadRulesCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="11" Margin="0,0,0,4">
                            <materialDesign:PackIcon Kind="Refresh" Width="13" Height="13" />
                        </Button>
                    </WrapPanel>

                    <!-- جدول قواعد -->
                    <DataGrid Grid.Row="4" ItemsSource="{Binding FractionRules}" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" FlowDirection="RightToLeft" MinHeight="90">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="خدمت" Binding="{Binding ServiceName}" Width="*" />
                            <DataGridTextColumn Header="نوع" Binding="{Binding RuleType}" Width="80" />
                            <DataGridTextColumn Header="جزئیات" Binding="{Binding Detail}" Width="150" />
                            <DataGridTextColumn Header="فرانشیز" Binding="{Binding Franchise}" Width="130" />
                            <DataGridTemplateColumn Header="عملیات" Width="Auto" MinWidth="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                FontSize="10" Foreground="#C62828">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="12" Height="12" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
