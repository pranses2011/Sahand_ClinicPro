<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.ShiftsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1180"
             FlowDirection="RightToLeft">
    <!-- ═══════════════════════════════════════════════════════════
         صفحهٔ مستقل «مدیریت شیفت‌ها» — چرخهٔ چهل‌وهفتم (گزارش مالک):
         «مدیریت شیفت ها یک صفحه مجزا باشه» — چیدمان و رفتارها عین تب سوم
         صفحهٔ حضور و غیاب (چرخهٔ ۴۴) است: ستون کارت‌های شیفت رنگی + ستون
         تخصیص‌های فعال + دو فرم پایینی (تعریف/ویرایش شیفت با انتخابگر عقربه‌ای
         ساعت و پالت رنگ؛ تخصیص با کمبوی جستجویی پرسنل/شیفت و انتخابگر تاریخ
         شمسی و چیپ‌های روز هفته). فقط جابه‌جایی به صفحهٔ خودش، نه بازطراحی.
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2.4*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ سربرگ صفحه — هم‌زبان طراحی صفحات چرخهٔ ۴۶ ═══ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Width="42" Height="42" CornerRadius="12" Background="#EDF3FA"
                    VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="ClockOutline" Width="22" Height="22"
                                         Foreground="#1565C0"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="مدیریت شیفت‌ها" FontSize="19" FontWeight="Bold" />
                <Border Height="2.5" CornerRadius="1.2" Width="46" HorizontalAlignment="Right"
                        Background="{DynamicResource MaterialDesign.Brush.Primary}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Command="{Binding LoadShiftsCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Margin="16,0,0,0" VerticalAlignment="Center"
                    ToolTip="بارگذاری مجدد شیفت‌ها و تخصیص‌ها">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Width="15" Height="15" VerticalAlignment="Center" />
                    <TextBlock Text="بازخوانی" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Text="تعریف الگوهای زمانی کار و تخصیص آن‌ها به پرسنل — مبنای محاسبهٔ تأخیر، کارکرد و اضافه‌کاری"
                       FontSize="11.5" Opacity="0.65" VerticalAlignment="Center"
                       Margin="14,0,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- نوار وضعیت/خطا -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        <Border Grid.Row="1" Padding="12,8" CornerRadius="10" Background="#FDECEA"
                Margin="0,0,0,8" HorizontalAlignment="Stretch"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="AlertCircle" Width="17" Height="17"
                                         Foreground="#C62828" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#8E2A20"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ═══ بدنه دو ستونه: کارت‌های شیفت (راست) + تخصیص‌های فعال (چپ) ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="330" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.35*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- ─── ستون راست: شیفت‌های تعریف‌شده — کارت‌های رنگی ─── -->
            <Border Grid.Column="0" CornerRadius="12" Padding="10"
                    Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="🧭 شیفت‌های تعریف‌شده" FontWeight="Bold" FontSize="13" Margin="4,0,0,8" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Shifts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="3,4" Padding="10,8" CornerRadius="10"
                                            Background="{DynamicResource MaterialDesign.Brush.Background}"
                                            BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <!-- لبهٔ رنگی راستِ کارت = رنگ تقویمی شیفت -->
                                                <Setter Property="BorderBrush" Value="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />
                                                <Setter Property="BorderThickness" Value="0,0,3.5,0" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F4F9FF" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- نام + نوع -->
                                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                                <Border CornerRadius="8" Padding="7,1.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Background="{Binding ColorHex, Converter={StaticResource HexBrush}, ConverterParameter=tint}"
                                                        BorderBrush="{Binding ColorHex, Converter={StaticResource HexToBrush}}" BorderThickness="1">
                                                    <TextBlock Text="{Binding Kind}" FontSize="9.5" FontWeight="SemiBold"
                                                               Foreground="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />
                                                </Border>
                                            </StackPanel>
                                            <!-- دکمه‌های ویرایش/حذف -->
                                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                                <Button Command="{Binding DataContext.EditShiftCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource App.RowIconButton}" Padding="4"
                                                        ToolTip="ویرایش این شیفت">
                                                    <materialDesign:PackIcon Kind="PencilOutline" Width="14" Height="14" />
                                                </Button>
                                                <Button Command="{Binding DataContext.DeleteShiftCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource App.RowIconButton}" Padding="4"
                                                        Foreground="#C62828" ToolTip="حذف این شیفت">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14" />
                                                </Button>
                                            </StackPanel>
                                            <!-- بازهٔ ساعتی + تحمل + شمار تخصیص -->
                                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,5,0,0">
                                                <materialDesign:PackIcon Kind="ClockOutline" Width="13" Height="13" Opacity="0.6" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding TimeRange, Converter={StaticResource PersianDigits}}"
                                                           FontSize="11" Margin="5,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Grace, Converter={StaticResource PersianDigits}}"
                                                           FontSize="10" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <Border CornerRadius="8" Padding="7,1.5" VerticalAlignment="Center"
                                                        Background="#EDF3FA" BorderBrush="#D3E2F0" BorderThickness="1">
                                                    <TextBlock FontSize="9.5" Foreground="#1F2937">
                                                        <!-- Mode=OneWay — چرخهٔ ۶۷: Run.Text پیش‌فرض TwoWay است؛
                                                             برای پراپرتی‌های init-only رکوردها هم یک‌طرفه باید باشد -->
                                                        <Run Text="{Binding Assigned, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                                                        <Run Text="پرسنل" />
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ─── ستون چپ: تخصیص‌های فعال ─── -->
            <Border Grid.Column="2" CornerRadius="12" Padding="10"
                    Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="👥 تخصیص‌های فعال شیفت‌ها" FontWeight="Bold" FontSize="13" Margin="4,0,0,8" />

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Assignments}" IsReadOnly="True"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              Style="{StaticResource App.TableDataGrid}" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="پرسنل" Binding="{Binding EmployeeName, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="کد پرسنلی" Binding="{Binding PersonnelCode, TargetNullValue=—, Converter={StaticResource PersianDigits}}" Width="Auto" FontFamily="{DynamicResource App.CodeFont}" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTemplateColumn Header="شیفت" Width="Auto" MaxWidth="420">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,6,0"
                                                     Fill="{Binding ShiftColor, Converter={StaticResource HexToBrush}}" />
                                            <TextBlock Text="{Binding ShiftName, Converter={StaticResource PersianDigits}}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="بازه" Binding="{Binding Range, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="تکرار" Binding="{Binding Recurrence, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="روزها" Binding="{Binding WeekDays, TargetNullValue=—, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTemplateColumn Header="عملیات" Width="Auto" MinWidth="92" MaxWidth="420">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.EndAssignmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource App.RowIconButton}" Padding="6,3"
                                                Foreground="#C62828" ToolTip="پایان این تخصیص از امروز">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="StopCircleOutline" Width="13" Height="13" VerticalAlignment="Center" />
                                                <TextBlock Text="پایان" FontSize="10.5" Margin="4,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ دو فرم پایینی: تعریف/ویرایش شیفت + تخصیص ═══ -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="330" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.35*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- فرم ۱: ثبت/ویرایش شیفت -->
            <Border Grid.Column="0" CornerRadius="12" Padding="12"
                    Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                    BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <materialDesign:PackIcon DockPanel.Dock="Right" Kind="ClockPlusOutline" Width="17" Height="17"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ShiftFormTitle}" FontWeight="Bold" FontSize="13"
                                   Margin="2,0,8,0" VerticalAlignment="Center" />
                    </DockPanel>
                    <WrapPanel>
                        <!-- نام شیفت — عنوان شناور خودکار (استایل سراسری) -->
                        <TextBox materialDesign:HintAssist.Hint="نام شیفت (مثلاً صبح اداری)"
                                 Text="{Binding ShiftName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Width="200" Margin="0,0,8,8" />
                        <!-- ساعت شروع/پایان — انتخابگر عقربه‌ای (قانون ۵ مالک) -->
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="شروع" FontSize="10" Opacity="0.6" Margin="2,0,0,2" />
                            <controls:TimePicker TimeText="{Binding ShiftStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="پایان" FontSize="10" Opacity="0.6" Margin="2,0,0,2" />
                            <controls:TimePicker TimeText="{Binding ShiftEnd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <ToggleButton IsChecked="{Binding ShiftIsNight}" Margin="0,4,10,6" VerticalAlignment="Center"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      ToolTip="شیفت عبورکننده از نیمه‌شب — پایان کوچک‌تر از شروع یعنی فردا">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="WeatherNight" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="شیفت شبانه" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </WrapPanel>
                    <WrapPanel>
                        <TextBox materialDesign:HintAssist.Hint="تحمل تأخیر (دقیقه)" Text="{Binding ShiftLateGrace, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="118" Margin="0,0,6,8" />
                        <TextBox materialDesign:HintAssist.Hint="تحمل تعجیل (دقیقه)" Text="{Binding ShiftEarlyGrace, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="118" Margin="0,0,6,8" />
                        <TextBox materialDesign:HintAssist.Hint="استراحت کسرشونده (دقیقه)" Text="{Binding ShiftBreak, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="150" Margin="0,0,6,8" />
                        <TextBox materialDesign:HintAssist.Hint="اضافه‌کاری پس از (دقیقه)" Text="{Binding ShiftOvertimeAfter, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="150" Margin="0,0,6,8" />
                    </WrapPanel>
                    <!-- پالت رنگ تقویمی — ListBox بدون قلم: آیتم همان رشتهٔ هگز است و
                         SelectedItem دوسویه مستقیماً به ShiftColor بسته می‌شود -->
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                        <TextBlock Text="رنگ تقویم:" FontSize="10.5" Opacity="0.65" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ListBox ItemsSource="{Binding ShiftColorPalette, Mode=OneWay}"
                                 SelectedItem="{Binding ShiftColor, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 Focusable="False" Cursor="Hand"
                                 ToolTip="رنگ نمایش شیفت در تقویم و کارت‌ها">
                            <!-- پالت نقطه‌ای است، نه فهرست متنی؛ فاصلهٔ ردیف‌های معمول را خنثی می‌کنیم. -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Dot" Width="22" Height="22" CornerRadius="11" Margin="0,0,7,0"
                                            Background="{Binding Converter={StaticResource HexToBrush}}"
                                            BorderThickness="2" BorderBrush="Transparent" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                            <Setter TargetName="Dot" Property="BorderBrush" Value="#37474F" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                            <Setter TargetName="Dot" Property="Opacity" Value="0.8" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding SaveShiftCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"
                                MinHeight="40">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="15" Height="15" VerticalAlignment="Center" />
                                <!-- متن دکمه با حالت فرم هم‌قدم می‌شود: ثبت یا به‌روزرسانی -->
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="به‌روزرسانی شیفت" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EditingShiftId}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="ثبت شیفت جدید" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CancelShiftEditCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                MinHeight="40"
                                Visibility="{Binding EditingShiftId, Converter={StaticResource NullToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CloseCircleOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="انصراف ویرایش" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- فرم ۲: تخصیص شیفت به پرسنل -->
            <Border Grid.Column="2" CornerRadius="12" Padding="12"
                    Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                    BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <materialDesign:PackIcon DockPanel.Dock="Right" Kind="AccountPlusOutline" Width="17" Height="17"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
                        <TextBlock Text="تخصیص شیفت به پرسنل" FontWeight="Bold" FontSize="13"
                                   Margin="2,0,8,0" VerticalAlignment="Center" />
                    </DockPanel>
                    <WrapPanel>
                        <!-- پرسنل — کمبوی جستجویی (تایپ = پالایش شامل؛ استایل سراسری) -->
                        <ComboBox materialDesign:HintAssist.Hint="جستجوی پرسنل (نام / کد پرسنلی)"
                                  ItemsSource="{Binding Employees}"
                                  SelectedItem="{Binding SelectedAssignEmployee}"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Width="270" Margin="0,0,8,8"
                                  ToolTip="با تایپ بخشی از نام یا کد پرسنلی، فهرست پالایش می‌شود" />
                        <!-- شیفت — کمبوی جستجویی -->
                        <ComboBox materialDesign:HintAssist.Hint="شیفت"
                                  ItemsSource="{Binding ShiftOptions}"
                                  SelectedItem="{Binding SelectedAssignShift}"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Width="190" Margin="0,0,8,8" />
                        <!-- بازهٔ اعتبار — انتخابگر تاریخ شمسی (قانون ۵) -->
                        <StackPanel Margin="0,0,8,6">
                            <TextBlock Text="اعتبار از" FontSize="10" Opacity="0.6" Margin="2,0,0,2" />
                            <controls:PersianDatePicker DateShamsiText="{Binding AssignFromDate, Mode=TwoWay}"
                                                        Placeholder="تاریخ شروع *" Width="150" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,6">
                            <TextBlock Text="تا (اختیاری)" FontSize="10" Opacity="0.6" Margin="2,0,0,2" />
                            <controls:PersianDatePicker DateShamsiText="{Binding AssignToDate, Mode=TwoWay}"
                                                        Placeholder="بی‌پایان" Width="150" />
                        </StackPanel>
                    </WrapPanel>
                    <WrapPanel>
                        <!-- الگوی تکرار -->
                        <ComboBox materialDesign:HintAssist.Hint="الگوی تکرار"
                                  ItemsSource="{Binding RecurrenceOptions}"
                                  SelectedIndex="{Binding AssignRecurrenceIndex}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Width="225" Margin="0,0,8,8" />
                        <TextBox materialDesign:HintAssist.Hint="اولویت در تعارض (عدد بزرگ‌تر برنده)"
                                 Text="{Binding AssignPriority, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="185" Margin="0,0,8,8" />
                        <TextBox materialDesign:HintAssist.Hint="یادداشت (اختیاری)"
                                 Text="{Binding AssignNotes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="240" Margin="0,0,0,8" />
                    </WrapPanel>
                    <!-- چیپ‌های روز هفته — فقط در حالت هفتگی/سفارشی -->
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,8"
                                Visibility="{Binding ShowWeekDays, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="روزهای فعال:" FontSize="10.5" Opacity="0.65" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <!-- دکمه‌های تاگل روز — بیت‌ها: شنبه=۱ … جمعه=۶۴ -->
                        <ToggleButton Content="شنبه" IsChecked="{Binding WeekSat}" Margin="0,0,5,0" Style="{StaticResource MaterialDesignFlatToggleButton}" FontSize="10.5" Padding="9,3" />
                        <ToggleButton Content="یکشنبه" IsChecked="{Binding WeekSun}" Margin="0,0,5,0" Style="{StaticResource MaterialDesignFlatToggleButton}" FontSize="10.5" Padding="9,3" />
                        <ToggleButton Content="دوشنبه" IsChecked="{Binding WeekMon}" Margin="0,0,5,0" Style="{StaticResource MaterialDesignFlatToggleButton}" FontSize="10.5" Padding="9,3" />
                        <ToggleButton Content="سه‌شنبه" IsChecked="{Binding WeekTue}" Margin="0,0,5,0" Style="{StaticResource MaterialDesignFlatToggleButton}" FontSize="10.5" Padding="9,3" />
                        <ToggleButton Content="چهارشنبه" IsChecked="{Binding WeekWed}" Margin="0,0,5,0" Style="{StaticResource MaterialDesignFlatToggleButton}" FontSize="10.5" Padding="9,3" />
                        <ToggleButton Content="پنجشنبه" IsChecked="{Binding WeekThu}" Margin="0,0,5,0" Style="{StaticResource MaterialDesignFlatToggleButton}" FontSize="10.5" Padding="9,3" />
                        <ToggleButton Content="جمعه" IsChecked="{Binding WeekFri}" Style="{StaticResource MaterialDesignFlatToggleButton}" FontSize="10.5" Padding="9,3" />
                    </StackPanel>
                    <Button Command="{Binding AssignShiftCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            MinHeight="40">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LinkPlus" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="ثبت تخصیص" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
