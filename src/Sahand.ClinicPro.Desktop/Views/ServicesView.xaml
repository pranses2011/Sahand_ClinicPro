<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1080"
             FlowDirection="RightToLeft">
    <!-- ═══ چرخهٔ ۷۸ (گزارش مالک) — صف مستقل خدمات درمانی ═══
         «در صفحه ویزیت و معاینه فقط صف پذیرش‌های پزشکان رو نشون بده و برای صف
         و انجام خدمات درمانی یک صفحه جداگانه باشه» — سه ستون:
         در انتظار (فراخوان به اتاق) / در حال انجام (انجام شد) / انجام‌شده‌ها.
         هم‌زبان طراحی صف ویزیت: سربرگ گرادیانی + کارت‌های آماری + کارت‌های ردیفی. -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ سربرگ گرادیانی برند — فیروزه‌ای خدماتی ═══ -->
        <Border Grid.Row="0" CornerRadius="14" Padding="16,10" Margin="0,0,0,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#00695C" Offset="0" />
                    <GradientStop Color="#00838F" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.16" Color="#0E4A52" />
            </Border.Effect>
            <DockPanel>
                <!-- نوسازی — گوشهٔ چپ فیزیکی (RTL) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Command="{Binding LoadCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="White" MinWidth="42" MinHeight="36" Margin="6,0,0,0"
                            VerticalAlignment="Center" ToolTip="بارگذاری مجدد">
                        <materialDesign:PackIcon Kind="Refresh" Width="15" Height="15" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="23" VerticalAlignment="Center" Margin="0,0,12,0"
                            Background="#33FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1">
                        <materialDesign:PackIcon Kind="Needle" Width="24" Height="24"
                                                 Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="صف خدمات درمانی" FontSize="18" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="تزریقات، پانسمان و خدمات پرستاری — فراخوان به اتاق و ثبت انجام؛ صف هر ۳۰ ثانیه خودکار تازه می‌شود"
                                   FontSize="10.5" Foreground="#CDE8E8" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ سه کارت آماری ═══ -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,10">
            <!-- کارت ۱: در انتظار خدمت — کهربایی -->
            <Border Style="{StaticResource App.StatCard}" Margin="0,0,6,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource App.StatIcon}"
                            Background="#FFF8E1" BorderBrush="#FFE082" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="ClockOutline" Width="21" Height="21"
                                                 Foreground="#F57F17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource App.StatValue}" Foreground="#E65100"
                                   Text="{Binding WaitingCount, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                        <TextBlock Style="{StaticResource App.StatLabel}" Text="در انتظار خدمت" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- کارت ۲: روی میز خدمت — فیروزه‌ای فعال -->
            <Border Style="{StaticResource App.StatCard}" Margin="6,0,6,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource App.StatIcon}"
                            Background="#E0F2F1" BorderBrush="#B2DFDB" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="AccountConvert" Width="21" Height="21"
                                                 Foreground="#00838F" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource App.StatValue}" Foreground="#00838F"
                                   Text="{Binding InProgressCount, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                        <TextBlock Style="{StaticResource App.StatLabel}" Text="روی میز خدمت" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- کارت ۳: انجام‌شدهٔ امروز — سبز موفقیت -->
            <Border Style="{StaticResource App.StatCard}" Margin="6,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource App.StatIcon}"
                            Background="#E8F5E9" BorderBrush="#C8E6C9" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="CheckCircle" Width="21" Height="21"
                                                 Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource App.StatValue}"
                                   Text="{Binding DoneCount, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                        <TextBlock Style="{StaticResource App.StatLabel}" Text="انجام‌شدهٔ امروز" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>

        <!-- ═══ سه ستون: در انتظار / روی میز / انجام‌شده ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- ستون ۱: در انتظار خدمت -->
            <Border Grid.Column="0" CornerRadius="12" Padding="12"
                    Background="{DynamicResource MaterialDesign.Brush.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                    BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="در انتظار خدمت" FontWeight="Bold" FontSize="13.5" Margin="2,0,2,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Waiting}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="10,8" Margin="0,0,0,6" Background="#FFF8E1"
                                            ToolTip="{Binding Notes, Mode=OneWay, TargetNullValue='بدون توضیح'}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#F9A825"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding QueueNumber, Mode=OneWay, Converter={StaticResource PersianDigits}}" FontWeight="Bold"
                                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" FontSize="13" Foreground="#1F2937" />
                                                <!-- خدمت + اتاق + زمان انتظار — چرخهٔ ۷۸: نام اتاق همراه ردیف -->
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="11" Foreground="#00695C" FontWeight="SemiBold">
                                                        <Run Text="{Binding ServiceName, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Opacity="0.75" Margin="10,0,0,0" Foreground="#1F2937">
                                                        <Run Text="{Binding RoomDisplay, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Foreground="#E65100" Margin="10,0,0,0">
                                                        <Run Text="انتظار: " /><Run Text="{Binding WaitingText, Mode=OneWay}" FontWeight="SemiBold" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock FontSize="10.5" Opacity="0.65" Margin="0,2,0,0" Foreground="#1F2937">
                                                    <Run Text="ساعت پذیرش: " /><Run Text="{Binding ReceptionTime, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <!-- فراخوان به اتاق انجام -->
                                            <Button Grid.Column="2" Command="{Binding DataContext.CallServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="11" Padding="10,6"
                                                    MinWidth="104" MinHeight="34">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="BellRing" Width="13" Height="13" VerticalAlignment="Center" Foreground="#1F2937" />
                                                    <TextBlock Text="فراخوان به اتاق" Margin="6,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#1F2937" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <controls:EmptyState Message="بیماری در انتظار خدمت نیست" IconKind="ClockOutline"
                                         Visibility="{Binding Waiting.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" />
                </DockPanel>
            </Border>

            <!-- ستون ۲: روی میز خدمت — اعلام انجام -->
            <Border Grid.Column="2" CornerRadius="12" Padding="12"
                    Background="{DynamicResource MaterialDesign.Brush.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                    BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="روی میز خدمت" FontWeight="Bold" FontSize="13.5" Margin="2,0,2,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding InProgress}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="10,8" Margin="0,0,0,6" Background="#E0F2F1">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="AccountConvert" Width="15" Height="15" Foreground="#00838F" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" FontSize="12.5" Margin="8,0,0,0" Foreground="#1F2937" />
                                            </StackPanel>
                                            <TextBlock FontSize="11" Foreground="#00695C" Margin="0,3,0,0" FontWeight="SemiBold">
                                                <Run Text="{Binding ServiceName, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock FontSize="10.5" Opacity="0.75" Margin="0,2,0,0" Foreground="#1F2937">
                                                <Run Text="{Binding RoomDisplay, Mode=OneWay}" />
                                            </TextBlock>
                                            <!-- اعلام انجام — پایان خدمت و انتقال به انجام‌شده‌ها -->
                                            <Button Command="{Binding DataContext.CompleteServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignRaisedButton}" FontSize="11" Padding="10,6"
                                                    Background="#2E7D32" BorderBrush="#2E7D32"
                                                    Margin="0,7,0,0" MinWidth="104" MinHeight="34" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CheckBold" Width="13" Height="13" VerticalAlignment="Center" />
                                                    <TextBlock Text="انجام شد" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <controls:EmptyState Message="خدمتی در حال انجام نیست" IconKind="AccountConvert"
                                         Visibility="{Binding InProgress.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" />
                </DockPanel>
            </Border>

            <!-- ستون ۳: انجام‌شده‌های امروز -->
            <Border Grid.Column="4" CornerRadius="12" Padding="12"
                    Background="{DynamicResource MaterialDesign.Brush.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                    BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="انجام‌شده‌های امروز" FontWeight="Bold" FontSize="13.5" Margin="2,0,2,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Done}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="10,7" Margin="0,0,0,6" Background="#E8F5E9">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CheckCircle" Width="15" Height="15" Foreground="#2E7D32" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" FontSize="12.5" Margin="8,0,0,0" Foreground="#1F2937" />
                                            </StackPanel>
                                            <TextBlock FontSize="11" Opacity="0.8" Margin="0,3,0,0" Foreground="#1F2937">
                                                <Run Text="{Binding ServiceName, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock FontSize="10.5" Opacity="0.65" Margin="0,2,0,0" Foreground="#1F2937">
                                                <Run Text="{Binding RoomDisplay, Mode=OneWay, TargetNullValue=—}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <controls:EmptyState Message="هنوز خدمتی انجام نشده" IconKind="ClipboardCheckOutline"
                                         Visibility="{Binding Done.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
