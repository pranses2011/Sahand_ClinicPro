<Window x:Class="Sahand.ClinicPro.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:Sahand.ClinicPro.Desktop.Helpers"
        Title="ورود به سامانه درمانگاه سهند"
        Height="800" Width="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <!-- لوگو مانند Splash بدون پنل یا پس‌زمینهٔ پشت خودش شناور است؛ نیمهٔ بالایی
         آن بیرون کارت فرم می‌ماند. فرم نیز قاب/حاشیهٔ مستطیلی ندارد و فقط سایهٔ نرم دارد. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="Login.Text.Primary" Color="#172B4D" />
        <SolidColorBrush x:Key="Login.Text.Muted" Color="#718096" />
        <SolidColorBrush x:Key="Login.Accent" Color="#1769C2" />

        <Style x:Key="Login.CloseButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#B42318" />
            <Setter Property="Background" Value="#FFFDE8E7" />
            <Setter Property="BorderBrush" Value="#FFF2B8B5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseSurface" Property="Background" Value="#FFFAC9C6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseSurface" Property="Background" Value="#FFF2AAA5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- زمینهٔ پنجره و فضای پشت لوگو کاملاً شفاف است -->
    <Grid Margin="18">
        <!-- فرم شناور؛ بدون BorderBrush یا قاب مستطیلی دور فرم -->
        <Grid Width="500" Margin="0,142,0,14" HorizontalAlignment="Center">
          <Border x:Name="LoginCard"
                  MouseLeftButtonDown="OnDragWindow"
                  CornerRadius="28"
                  Padding="42,119,42,22"
                  SnapsToDevicePixels="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#E6F0FB" Offset="0" />
                    <GradientStop Color="#F1F6FC" Offset="0.55" />
                    <GradientStop Color="#E4F3F1" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="9" Opacity="0.20" Color="#243B59" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Center">
                    <!-- فرم از فضای خالی کارت قابل‌کشیدن است؛ کنترل‌های تعاملی مستثنا هستند -->
                    <!-- چرخهٔ ۸۲: با باز شدن پنل «فراموشی رمز» فرم کنار می‌رود -->
                    <StackPanel x:Name="LoginFormPanel"
                                Visibility="{Binding IsLoginFormVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="خوش آمدید"
                                   FontSize="25" FontWeight="Bold"
                                   Foreground="{StaticResource Login.Text.Primary}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="برای ادامه، به حساب کاربری خود وارد شوید."
                                   FontSize="12.5" Foreground="{StaticResource Login.Text.Muted}"
                                   HorizontalAlignment="Center" Margin="0,6,0,22" />
                    <!-- ═══ چرخهٔ ۸۴ — «فرم بازیابی با فرم لاگین مخلوط می‌شود» ═══
                         پنل LoginFormPanel باید «همهٔ» کنترل‌های ورود (نام کاربری،
                         رمز، دکمه‌ها) را دربر بگیرد؛ قبلاً فقط عنوان‌ها داخلش بود
                         و بقیهٔ فرم هنگام بازیابی هم روی کارت می‌ماند و دو فرم
                         درهم و ناخوانا دیده می‌شدند. از اینجا تا دکمهٔ فعال‌سازی
                         لایسنس، همه داخل همین پنل‌اند و با بازشدن بازیابی، کلّاً
                         Collapsed می‌شوند. -->

                    <!-- نام کاربری -->
                    <TextBlock Text="نام کاربری" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="#52647A" Margin="2,0,0,6" />
                    <TextBox x:Name="UsernameBox"
                             materialDesign:HintAssist.Hint="نام کاربری خود را وارد کنید"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="50"
                             FlowDirection="LeftToRight"
                             TextAlignment="Left"
                             FontSize="14" Padding="12,9"
                             Margin="0,0,0,14">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- رمز عبور و دکمهٔ نمایش؛ همگام‌سازی امن PasswordBox حفظ شده است -->
                    <TextBlock Text="رمز عبور" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="#52647A" Margin="2,0,0,6" />
                    <Grid Margin="0,0,0,7" FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <PasswordBox x:Name="PasswordBox"
                                         materialDesign:HintAssist.Hint="رمز عبور خود را وارد کنید"
                                         MaxLength="100"
                                         FontSize="14" Padding="12,9"
                                         FlowDirection="LeftToRight"
                                         Visibility="Visible"
                                         KeyDown="OnPasswordKeyDown" />
                            <TextBox x:Name="PasswordRevealBox"
                                     materialDesign:HintAssist.Hint="رمز عبور خود را وارد کنید"
                                     Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14" Padding="12,9"
                                     FlowDirection="LeftToRight"
                                     TextAlignment="Left"
                                     Visibility="Collapsed"
                                     IsReadOnly="False" />
                        </Grid>
                        <ToggleButton x:Name="EyeToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                      Margin="7,0,0,0"
                                      Width="40" Height="40"
                                      VerticalAlignment="Center"
                                      ToolTip="نمایش یا پنهان‌کردن رمز"
                                      Checked="OnEyeToggled"
                                      Unchecked="OnEyeToggled">
                            <materialDesign:PackIcon Kind="EyeOutline" Width="18" Height="18" />
                        </ToggleButton>
                    </Grid>

                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  Content="مرا به خاطر بسپار"
                                  IsChecked="{Binding RememberMe}"
                                  FontSize="12" VerticalAlignment="Center" />
                        <!-- ═══ چرخهٔ ۸۲ (گزارش مالک) — «فراموشی رمز کار نمی‌کند» ═══
                             پیش‌تر این فقط یک TextBlock با ToolTip بود و هیچ
                             اقدامی انجام نمی‌داد؛ اکنون دکمهٔ واقعی پنل بازیابی
                             را باز می‌کند. -->
                        <Button Grid.Column="1"
                                Command="{Binding OpenForgotCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Content="فراموشی رمز؟"
                                FontSize="11.5" Foreground="{StaticResource Login.Accent}"
                                Padding="6,2" MinWidth="0" Height="26"
                                Cursor="Hand" VerticalAlignment="Center"
                                ToolTip="ارسال رمز موقت به ایمیل ثبت‌شدهٔ حساب شما" />
                    </Grid>

                    <!-- پیام خطا -->
                    <Border Background="#FFF1F0" BorderBrush="#F7C7C3" BorderThickness="1"
                            CornerRadius="9" Padding="10,8" Margin="0,12,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                                   FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <!-- دکمهٔ ورود -->
                    <Button Command="{Binding LoginCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="48" Margin="0,16,0,0"
                            FontSize="14" FontWeight="Bold"
                            Background="#1769C2" Foreground="White"
                            IsDefault="True">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="ورود به سامانه" VerticalAlignment="Center" />
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18"
                                                     Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <ProgressBar IsIndeterminate="True"
                                 Height="3" Margin="0,10,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                    <!-- مسیر فعال‌سازی لایسنس -->
                    <Grid Margin="0,18,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="1" Background="#E5EAF0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="دسترسی و فعال‌سازی" FontSize="10.5"
                                   Foreground="#8794A5" Margin="12,0" />
                        <Border Grid.Column="2" Height="1" Background="#E5EAF0" VerticalAlignment="Center" />
                    </Grid>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding ActivateLicenseCommand}"
                            Height="42" FontSize="12.5" FontWeight="SemiBold"
                            BorderBrush="#C8D8EA" Foreground="#315A83"
                            ToolTip="در صورت نداشتن لایسنس فعال، از اینجا شروع کنید">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="KeyVariant" Width="17" Height="17"
                                                     Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="فعال‌سازی لایسنس" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                    </StackPanel><!-- /LoginFormPanel — پایان فرم ورود -->

                <!-- ═══ چرخهٔ ۸۲ — پنل «بازیابی رمز عبور» (گزارش مالک) ═══
                     کاربر نام کاربری یا ایمیل خود را می‌دهد؛ سرور رمز موقت تازه
                     می‌سازد و به ایمیل ثبت‌شدهٔ همان حساب می‌فرستد. رمزها فقط
                     هش‌شده ذخیره می‌شوند و ارسال «رمز فعلی» از نظر امنیتی ممکن
                     نیست؛ پس از ورود با رمز موقت، سامانه تغییر رمز را الزام می‌کند. -->
                <Border Grid.Row="0" VerticalAlignment="Center" Margin="0,8,0,0"
                        Visibility="{Binding IsForgotOpen, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="KeyVariant" Width="40" Height="40"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{StaticResource Login.Accent}" />
                        <TextBlock Text="بازیابی رمز عبور"
                                   FontSize="21" FontWeight="Bold"
                                   Foreground="{StaticResource Login.Text.Primary}"
                                   HorizontalAlignment="Center" Margin="0,10,0,4" />
                        <TextBlock Text="نام کاربری یا ایمیل حساب خود را وارد کنید؛ رمز موقت به ایمیل ثبت‌شدهٔ همان حساب فرستاده می‌شود. رمز فعلی شما تا وقتی با رمز موقت وارد نشوید، تغییر نمی‌کند."
                                   FontSize="12" Foreground="{StaticResource Login.Text.Muted}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16" />

                        <TextBlock Text="نام کاربری یا ایمیل" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="#52647A" Margin="2,0,0,6" />
                        <TextBox Text="{Binding ForgotInput, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="مثال: admin یا name@clinic.ir"
                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                 MaxLength="256"
                                 FlowDirection="LeftToRight" TextAlignment="Left"
                                 FontSize="14" Padding="12,9" Margin="0,0,0,12">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SendForgotCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <Border Background="#EAF3FC" BorderBrush="#BBD9F5" BorderThickness="1"
                                CornerRadius="9" Padding="10,8" Margin="0,0,0,12"
                                Visibility="{Binding HasForgotMessage, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ForgotMessage}" TextWrapping="Wrap"
                                       FontSize="12" Foreground="{Binding ForgotMessageColor}" />
                        </Border>

                        <Button Command="{Binding SendForgotCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Height="44" FontSize="13" FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="EmailOutline" Width="17" Height="17"
                                                         Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="ارسال رمز موقت به ایمیل" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CloseForgotCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Content="بازگشت به صفحهٔ ورود"
                                FontSize="12" Foreground="{StaticResource Login.Text.Muted}"
                                Height="34" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,14,0,0">
                    <TextBlock Text="{x:Static helpers:AppInfo.VersionText}"
                               FontSize="10.5" Foreground="#8492A4" />
                    <TextBlock Text="  ·  " FontSize="10.5" Foreground="#B1BBC8" />
                    <TextBlock Text="{x:Static helpers:AppInfo.CopyrightText}"
                               FontSize="10" Foreground="#A1ACB9" />
                </StackPanel>
            </Grid>
          </Border>

          <!-- دکمهٔ بستن با رنگ متضاد، داخل گوشهٔ فرم -->
          <Button x:Name="CloseButton"
                  Style="{StaticResource Login.CloseButton}"
                  HorizontalAlignment="Left" VerticalAlignment="Top"
                  Margin="18,16,0,0"
                  Panel.ZIndex="3"
                  ToolTip="بستن برنامه" Click="OnCloseClick">
              <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
          </Button>
        </Grid>

        <!-- لوگوی PNG شفاف؛ هیچ Border/Brushای پشت تصویر نیست.
             نیمهٔ بالایی در فضای کاملاً شفاف پنجره و نیمهٔ پایینی روی کارت قرار می‌گیرد. -->
        <Image x:Name="LogoImage"
               Source="/Assets/Logo/ClinicPro-512.png"
               Width="236" Height="236"
               HorizontalAlignment="Center" VerticalAlignment="Top"
               Margin="0,10,0,0"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"
               Panel.ZIndex="2"
               ToolTip="نشان سامانهٔ مدیریت درمانگاه سهند" />

    </Grid>
</Window>
