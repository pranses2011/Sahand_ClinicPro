<Window x:Class="Sahand.ClinicPro.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:Sahand.ClinicPro.Desktop.Helpers"
        Title="ورود به سامانه درمانگاه سهند"
        Height="600" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        FontFamily="pack://application:,,,/Assets/Fonts/#Vazirmatn"
        MouseLeftButtonDown="OnDragWindow"
        FlowDirection="RightToLeft">
    <!-- ═══════════════════════════════════════════════════════════
         پنجره ورود — گام U1 طبق پرامپت UI بخش ۱ (فرم ۱)
         ۵۰۰×۶۰۰ ثابت | بدون حاشیه ویندوز | گرادیان آبی-سبز |
         دکمه نمایش رمز | مرا به خاطر بسپار | فعال‌سازی لایسنس شرطی
         ═══════════════════════════════════════════════════════════ -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <!-- پس‌زمینه گرادیان آبی-سبز -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0D47A1" Offset="0" />
                <GradientStop Color="#1565C0" Offset="0.5" />
                <GradientStop Color="#00897B" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- دکمه بستن -->
        <Button x:Name="CloseButton"
                Style="{StaticResource MaterialDesignIconForegroundButton}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="8" Width="34" Height="30"
                Foreground="White"
                ToolTip="خروج"
                Click="OnCloseClick">
            <materialDesign:PackIcon Kind="Close" />
        </Button>

        <!-- کارت ورود مرکزی -->
        <Border MaxWidth="400"
                Background="{DynamicResource MaterialDesign.Brush.Background}"
                CornerRadius="20" Padding="32"
                VerticalAlignment="Center" Margin="40,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.35" />
            </Border.Effect>

            <StackPanel>
                <!-- لوگو دایره‌ای ۷۰×۷۰ -->
                <Border Width="70" Height="70" CornerRadius="35"
                        Background="#E3F2FD"
                        HorizontalAlignment="Center" Margin="0,4,0,12">
                    <materialDesign:PackIcon Kind="Hospital"
                                             Width="38" Height="38"
                                             Foreground="#1565C0"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                </Border>

                <!-- نام سیستم -->
                <TextBlock Text="ClinicPro"
                           FontSize="22" FontWeight="Black"
                           HorizontalAlignment="Center"
                           Foreground="#1565C0" />
                <TextBlock Text="سامانه مدیریت درمانگاه سهند"
                           FontSize="13" Opacity="0.75"
                           HorizontalAlignment="Center" Margin="0,2,0,24" />

                <!-- نام کاربری — چرخه چهاردهم (گزارش پنجم مالک): کادر چپ‌به‌راست و وسط‌چین شد
                     تا نام کاربری لاتین وارونه نمایش داده نشود و زیر دکمه پاک‌کردن نرود؛
                     پنجره راست‌به‌چپ است اما محتوای این کادر لاتین است -->
                <TextBox x:Name="UsernameBox"
                         materialDesign:HintAssist.Hint="👤 نام کاربری"
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="50"
                         FlowDirection="LeftToRight"
                         TextAlignment="Center"
                         FontSize="14" Margin="0,0,0,14">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <!-- رمز عبور + دکمه نمایش — چرخه هفدهم (گزارش یازدهم مالک):
                     بایندینگ materialDesign:PasswordBoxAssist.Password (دوطرفه) حذف شد —
                     سورس پکیج 5.3.2 نشان داد این بایندینگ با DefaultUpdateSourceTrigger=LostFocus
                     در HandlePasswordChanged مقدار را «بدون بررسی برابری» دوباره داخل
                     PasswordBox.Password می‌نویسد؛ بازنویسی برنامه‌ای Password مکان‌نما را
                     به ابتدای کادر می‌پراند و کاراکتر بعدی «در ابتدای رشته» درج می‌شد —
                     نتیجه: Admin@123 به‌صورت 321@nimdA در ViewModel می‌نشست و چون کادر ماسک
                     است کاربر فقط «رمز نادرست» می‌دید؛ با آیکون چشم (TextBox معمولی) مشکل
                     نبود چرا که TextBox مسیر بایندینگ سالمی دارد.
                     همگام‌سازی اکنون «تک‌مسیری» است: فقط رویداد PasswordChanged در کد پشت
                     (LoginWindow.xaml.cs) مقدار را به ViewModel می‌برد و هیچ‌چیز هرگز به
                     داخل کادرِ در حال تایپ بازنویسی نمی‌کند. -->
                <Grid Margin="0,0,0,6" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <PasswordBox x:Name="PasswordBox"
                                     materialDesign:HintAssist.Hint="🔒 رمز عبور"
                                     MaxLength="100"
                                     FontSize="14"
                                     FlowDirection="LeftToRight"
                                     Visibility="Visible"
                                     KeyDown="OnPasswordKeyDown" />
                        <TextBox x:Name="PasswordRevealBox"
                                 materialDesign:HintAssist.Hint="🔒 رمز عبور"
                                 Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14"
                                 FlowDirection="LeftToRight"
                                 TextAlignment="Center"
                                 Visibility="Collapsed"
                                 IsReadOnly="False" />
                    </Grid>
                    <ToggleButton x:Name="EyeToggle"
                                  Grid.Column="1"
                                  Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                  Margin="6,0,0,0"
                                  Width="32" Height="26"
                                  VerticalAlignment="Center"
                                  ToolTip="نمایش رمز عبور"
                                  Checked="OnEyeToggled"
                                  Unchecked="OnEyeToggled">
                        <materialDesign:PackIcon Kind="EyeOutline" Width="18" Height="18" />
                    </ToggleButton>
                </Grid>

                <!-- مرا به خاطر بسپار + فراموشی رمز -->
                <DockPanel Margin="0,4,0,2">
                    <CheckBox Content="مرا به خاطر بسپار"
                              IsChecked="{Binding RememberMe}"
                              FontSize="12" />
                    <TextBlock Text="فراموشی رمز عبور؟"
                               FontSize="11" Foreground="#1565C0"
                               Cursor="Hand"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               ToolTip="در صورت فراموشی رمز با مدیر سیستم تماس بگیرید"
                               Margin="0,0,8,0" />
                </DockPanel>

                <!-- پیام خطا -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                           FontSize="12" TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                <!-- دکمه ورود — تمام عرض -->
                <Button Command="{Binding LoginCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Height="45" Margin="0,16,0,0"
                        FontSize="15" FontWeight="Bold"
                        IsDefault="True"
                        Content="🔓 ورود به سیستم" />

                <!-- نوار انتظار -->
                <ProgressBar IsIndeterminate="True"
                             Height="4" Margin="0,14,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                <!-- جداکننده یا -->
                <Grid Margin="0,18,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Separator Grid.Column="0" Opacity="0.3" />
                    <TextBlock Grid.Column="1" Text="یا" FontSize="11"
                               Opacity="0.6" Margin="10,0" />
                    <Separator Grid.Column="2" Opacity="0.3" />
                </Grid>

                <!-- فعال‌سازی لایسنس — فقط وقتی لایسنس فعال نیست -->
                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Content="🔑 فعال‌سازی لایسنس"
                        FontSize="13"
                        Command="{Binding ActivateLicenseCommand}"
                        ToolTip="در صورت نداشتن لایسنس فعال، از اینجا شروع کنید" />
            </StackPanel>
        </Border>

        <!-- پانویس نسخه -->
        <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,14"
                    HorizontalAlignment="Center">
            <TextBlock Text="{x:Static helpers:AppInfo.VersionText}"
                       FontSize="11" Foreground="#E3F2FD" Opacity="0.9"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{x:Static helpers:AppInfo.CopyrightText}"
                       FontSize="10" Foreground="#E3F2FD" Opacity="0.65"
                       HorizontalAlignment="Center" Margin="0,2,0,0" />
        </StackPanel>
    </Grid>
</Window>
