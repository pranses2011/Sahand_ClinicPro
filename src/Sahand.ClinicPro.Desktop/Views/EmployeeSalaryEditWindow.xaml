<Window x:Class="Sahand.ClinicPro.Desktop.Views.EmployeeSalaryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:behaviors="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        Title="ویرایش اطلاعات حقوقی"
        Height="480" Width="440"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!-- ═══════════════════════════════════════════════════════════
         پنجره ویرایش اطلاعات حقوقی پرسنل — چرخه دهم
         از دکمه «ویرایش حقوقی» کنار هر ردیف فهرست پرسنل باز می‌شود
         ═══════════════════════════════════════════════════════════ -->
    <StackPanel Margin="28">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <materialDesign:PackIcon Kind="CashEdit" Width="24" Height="24"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                     VerticalAlignment="Center" />
            <TextBlock Text="ویرایش اطلاعات حقوقی" FontSize="17" FontWeight="Bold"
                       Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding EmployeeName}" FontSize="14" FontWeight="SemiBold"
                   Foreground="#16355E" Margin="0,0,0,2" />
        <TextBlock Text="{Binding EmployeeInfo}" FontSize="11.5" Foreground="#5B7290"
                   Margin="0,0,0,16" />

        <Border Background="#F5F9FF" BorderBrush="#CFE2F5" BorderThickness="1"
                CornerRadius="8" Padding="12,10" Margin="0,0,0,4">
            <StackPanel>
                <TextBlock Text="📄 اطلاعات حقوقی" FontSize="13" FontWeight="Bold"
                           Foreground="#16355E" Margin="0,0,0,10" />
                <!-- چرخه بیستم: کادر مبلغ با جداکنندهٔ زندهٔ ۳ رقمی -->
                <TextBox materialDesign:HintAssist.Hint="حقوق پایه (ریال) — ماهانه"
                         behaviors:MoneyInput.IsEnabled="True"
                         behaviors:MoneyInput.NumericValue="{Binding BaseSalary, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MoneyRial}}"
                         materialDesign:TextFieldAssist.PrefixText="﷼"
                         Margin="0,0,0,12" />
                <TextBox materialDesign:HintAssist.Hint="درصد حقوق از سود خدمات (٪) — فقط از سود خدمات انجامی خود این پرسنل"
                         Text="{Binding CommissionPercent, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:TextFieldAssist.SuffixText="٪"
                         Margin="0,0,0,8" />
                <TextBlock Text="ℹ️ حقوق درصدی از «سود» خدمت محاسبه می‌شود (مبلغ خدمت منهای هزینه آن)؛ نه از کل فروش. خدمات انجام‌شده توسط پزشکِ متصل به این پرسنل نیز لحاظ می‌شود. صفر = فقط حقوق پایه."
                           FontSize="10.5" TextWrapping="Wrap" Foreground="#5B7290" />
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />

        <UniformGrid Columns="2">
            <Button Command="{Binding SaveCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="ذخیره" Height="42" Margin="4" />
            <Button Command="{Binding CancelCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="انصراف" Height="42" Margin="4" />
        </UniformGrid>

        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
    </StackPanel>
</Window>
