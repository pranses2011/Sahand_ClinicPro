<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.ParaclinicalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1080"
             FlowDirection="RightToLeft">
    <!-- ═══ پاراکلینیک تخصصی — گام U12 طبق فرم‌های ۲۰-۲۳ ═══ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <materialDesign:PackIcon Kind="MedicalBag" Width="26" Height="26"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
            <TextBlock Text="پاراکلینیک تخصصی" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <TabControl Grid.Row="1" Style="{StaticResource MaterialDesignTabControl}">
            <!-- ═══ تب دندانپزشکی ═══ -->
            <TabItem Header="🦷 دندانپزشکی">
                <Grid Margin="4,8">
                    <Grid.RowDefinitions>
                        <!-- نوار بیمار دندانپزشکی — چرخهٔ ۲۸ -->
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.6*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- ═══ نوار بیمار تب دندانپزشکی — چرخهٔ بیست‌وهشتم (گزارش هجدهم
                         مالک): «نمی‌شود بیمار را انتخاب کرد و مشخص نیست اطلاعات
                         برای چه کسی ذخیره می‌شود» — چارت و طرح درمان اکنون به
                         پروندهٔ همین بیمار وصل است و با جستجو، آخرین چارتِ ذخیره‌شده
                         خودکار بازیابی می‌شود ═══ -->
                    <Grid Grid.Row="0" Grid.ColumnSpan="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.4*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding DentalPatientSearch, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="🔍 بیمار دندانپزشکی — کد ملی / موبایل / نام">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchDentalPatientCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Command="{Binding SearchDentalPatientCommand}" Margin="8,0,0,0"
                                Style="{StaticResource MaterialDesignRaisedButton}" Padding="12,4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Magnify" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="جستجو" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <!-- کارت بیمار منتخب — محل ذخیره‌شدن داده‌ها همین پرونده است -->
                        <Border Grid.Column="2" Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1"
                                CornerRadius="8" Padding="10,5" Margin="8,0,8,0"
                                Visibility="{Binding DentalPatient, Converter={StaticResource NullToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountCheck" Width="16" Height="16" Foreground="#2E7D32" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DentalPatient.FullName, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding DentalPatient.NationalCode, Mode=OneWay}" Opacity="0.7" FontSize="11"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                                <TextBlock Text="{Binding DentalPatient.Allergies, Mode=OneWay, TargetNullValue='', FallbackValue=''}" Foreground="#C62828"
                                           FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Visibility="{Binding DentalPatient.Allergies, Converter={StaticResource StringToVisibility}}" />
                            </StackPanel>
                        </Border>
                        <Button Grid.Column="3" Command="{Binding ClearDentalPatientCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}" Padding="8,4" ToolTip="بستن پرونده و بیمار بعدی"
                                Visibility="{Binding DentalPatient, Converter={StaticResource NullToVisibility}}">
                            <materialDesign:PackIcon Kind="CloseCircleOutline" Width="18" Height="18" Foreground="#C62828" />
                        </Button>
                    </Grid>
                    <!-- راهنمای وضعیت ذخیره/بازیابی چارت — پاسخ «از کجا بازیابی می‌شود؟» -->
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding DentalChartInfo, Mode=OneWay}"
                               FontSize="10.5" Opacity="0.65" VerticalAlignment="Center" />

                    <!-- چارت FDI -->
                    <Border Grid.Row="2" Grid.Column="0" CornerRadius="12" Padding="12"
                            Background="{DynamicResource MaterialDesign.Brush.Background}">
                        <StackPanel>
                            <TextBlock Text="ماگزیلا (فک بالا)" FontWeight="Bold" FontSize="12.5" Margin="2,0,2,6" />
                            <ItemsControl ItemsSource="{Binding UpperTeeth}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- چرخه بیست‌وچهارم: هایلایت دندان انتخابی با DataTrigger ساده
                                             (Value از نوع CLR است و Binding روی آن XamlParseException می‌اندازد —
                                             گزارش هفدهم مالک؛ پرچم IsSelected اکنون از ViewModel می‌آید).
                                             فونت هاردکد Consolas هم حذف شد تا فونت تم برنامه اعمال شود. -->
                                        <Button Width="44" Height="44" Margin="2"
                                                Command="{Binding DataContext.SelectToothCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding ToolTip}"
                                                Content="{Binding NumberFa}"
                                                FontSize="12">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                                    <Setter Property="Background" Value="{Binding Color, Mode=OneWay}" />
                                                    <Setter Property="BorderBrush" Value="#B0BEC5" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#1565C0" />
                                                            <Setter Property="BorderThickness" Value="3" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator Margin="0,10,0,10" />

                            <TextBlock Text="مندیبل (فک پایین)" FontWeight="Bold" FontSize="12.5" Margin="2,0,2,6" />
                            <ItemsControl ItemsSource="{Binding LowerTeeth}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- فک پایین — همان قالب هایلایت انتخاب چرخه بیست‌وچهارم؛
                                             پیش‌تر این ردیف اصلاً استایل انتخاب نداشت و دندان انتخابی
                                             در فک پایین هایلایت نمی‌شد. ارقام فارسی + فونت تم. -->
                                        <Button Width="44" Height="44" Margin="2"
                                                Command="{Binding DataContext.SelectToothCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding ToolTip}"
                                                Content="{Binding NumberFa}"
                                                FontSize="12">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                                    <Setter Property="Background" Value="{Binding Color, Mode=OneWay}" />
                                                    <Setter Property="BorderBrush" Value="#B0BEC5" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#1565C0" />
                                                            <Setter Property="BorderThickness" Value="3" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ═══ راهنمای رنگ‌های وضعیت دندان — چرخهٔ سی‌وسوم (گزارش نوزدهم مالک) ═══
                                 «رنگ‌های وضعیت فک بالا/پایین درست نشان داده می‌شوند ولی راهنمای
                                 تشخیص رنگ‌ها که زیرشان هست درست نمی‌آید و مشخص نیست»:
                                 ریشه — راهنمای پیشین یک متن یگانه با نویسه‌های ایموجی (⬜🟥🟨…)
                                 بود؛ این گلیف‌ها در فونت فارسی برنامه (وزیرمتن) وجود ندارند و
                                 موتور رندر WPF آن‌ها را به‌صورت مربع تهی/علامت جایگزین می‌کشد —
                                 دقیقاً همان «مشخص نیست»ی که مالک می‌دید. راه‌حل قطعی: به‌جای
                                 نویسه، چیپ‌های رنگی واقعی (Border با Brush همان کد رنگ ViewModel
                                 ToothVM.Color) + برچسب فارسی کنار هرکدام — رندر آن در هر فونت و
                                 هر نسخهٔ ویندوز تضمینی است و رنگ‌ها با خود دکمه‌های چارت یکی‌اند.
                                 چیپ سفیدِ «سالم» حاشیهٔ خاکستری می‌گیرد تا روی پس‌زمینهٔ روشن
                                 دیده شود. WrapPanel در عرض کم می‌شکند و راهنما هرگز بیرون نمی‌زند. -->
                            <WrapPanel Margin="2,12,2,0">
                                <!-- آیتم راهنما: چیپ رنگ + برچسب — قالب مشترک با x:Shared و منبع -->
                                <WrapPanel.Resources>
                                    <Style x:Key="LegendChip" TargetType="Border">
                                        <Setter Property="Width" Value="15" />
                                        <Setter Property="Height" Value="15" />
                                        <Setter Property="CornerRadius" Value="4" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="BorderBrush" Value="#90A4AE" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="0,0,5,0" />
                                    </Style>
                                    <Style x:Key="LegendLabel" TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="11" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="0,0,12,2" />
                                        <Setter Property="Opacity" Value="0.85" />
                                    </Style>
                                </WrapPanel.Resources>
                                <!-- رنگ‌ها عیناً از ToothVM.Color (پوشهٔ ViewModelها):
                                     ۰ سالم #FFFFFF / ۱ پوسیدگی #E53935 / ۲ ترمیم #FDD835 /
                                     ۳ درمان #43A047 / ۴ روکش #1E88E5 / ۵ کشیده #37474F /
                                     ۶ ایمپلنت #8E24AA -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2" ToolTip="دندان بدون مشکل">
                                    <Border Style="{StaticResource LegendChip}" Background="#FFFFFF" />
                                    <TextBlock Style="{StaticResource LegendLabel}" Text="سالم" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2" ToolTip="نیاز به ترمیم دارد">
                                    <Border Style="{StaticResource LegendChip}" Background="#E53935" />
                                    <TextBlock Style="{StaticResource LegendLabel}" Text="پوسیدگی" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2" ToolTip="قبلاً پرکردگی شده">
                                    <Border Style="{StaticResource LegendChip}" Background="#FDD835" />
                                    <TextBlock Style="{StaticResource LegendLabel}" Text="ترمیم‌شده" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2" ToolTip="درمان ریشه/کامل انجام شده">
                                    <Border Style="{StaticResource LegendChip}" Background="#43A047" />
                                    <TextBlock Style="{StaticResource LegendLabel}" Text="درمان‌شده" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2" ToolTip="روکش نصب شده">
                                    <Border Style="{StaticResource LegendChip}" Background="#1E88E5" />
                                    <TextBlock Style="{StaticResource LegendLabel}" Text="روکش" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2" ToolTip="دندان کشیده شده">
                                    <Border Style="{StaticResource LegendChip}" Background="#37474F" />
                                    <TextBlock Style="{StaticResource LegendLabel}" Text="کشیده‌شده" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2" ToolTip="ایمپلنت کاشته شده">
                                    <Border Style="{StaticResource LegendChip}" Background="#8E24AA" />
                                    <TextBlock Style="{StaticResource LegendLabel}" Text="ایمپلنت" />
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- جزئیات و طرح درمان -->
                    <Grid Grid.Row="2" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" CornerRadius="12" Padding="12" Margin="0,0,0,8"
                                Background="{DynamicResource MaterialDesign.Brush.Background}">
                            <StackPanel>
                                <TextBlock FontSize="13" FontWeight="Bold" Margin="0,0,0,6">
                                    <Run Text="دندان انتخابی: " /><Run Text="{Binding SelectedTooth.Number, Mode=OneWay, TargetNullValue=—, Converter={StaticResource PersianDigits}}" FontFamily="{DynamicResource App.CodeFont}" />
                                </TextBlock>
                                <TextBlock Text="وضعیت" FontSize="10.5" Opacity="0.6" />
                                <ComboBox ItemsSource="{Binding ToothConditions}" SelectedIndex="{Binding ToothConditionIndex}" />
                                <Button Command="{Binding AddDentalPlanCommand}" Margin="0,10,0,0"
                                        Style="{StaticResource MaterialDesignRaisedButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="13" Height="13" />
                                        <TextBlock Text="افزودن به طرح درمان" Margin="7,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" CornerRadius="12" Padding="10"
                                Background="{DynamicResource MaterialDesign.Brush.Background}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="طرح درمان" FontWeight="Bold" FontSize="13" Margin="2,0,2,6" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding DentalPlan}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Padding="9,6" Margin="0,0,0,5" Background="#FFF8E1">
                                                    <StackPanel>
                                                        <TextBlock FontSize="12">
                                                            <Run Text="دندان " /><Run Text="{Binding Tooth, Mode=OneWay}" FontFamily="{DynamicResource App.CodeFont}" FontWeight="Bold" />
                                                            <Run Text=" — " /><Run Text="{Binding Procedure, Mode=OneWay}" FontWeight="SemiBold" />
                                                        </TextBlock>
                                                        <TextBlock FontSize="10.5" Opacity="0.75" FontFamily="{DynamicResource App.CodeFont}">
                                                            <!-- چرخهٔ بیست‌وهفتم: واحد پول پویا از تنظیمات (ریال/تومان) — حذف هاردکد -->
                                                            <Run Text="{Binding Price, Mode=OneWay, Converter={StaticResource CurrencyRial}}" /><Run Text=" " /><Run Text="{DynamicResource App.CurrencyLabel}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- ═══ ذخیرهٔ چارت و طرح درمان در پروندهٔ بیمار — چرخهٔ ۲۸ ═══
                             وضعیت هر ۳۲ دندان + ردیف‌های طرح، در طرح درمان بیمارِ
                             جستجوشده ذخیره می‌شود و دفعهٔ بعد با جستجوی همان بیمار
                             بازیابی می‌گردد -->
                        <Button Grid.Row="2" Command="{Binding SaveDentalChartCommand}" Margin="0,8,0,0"
                                Style="{StaticResource MaterialDesignRaisedButton}" Background="#2E7D32" BorderBrush="#2E7D32"
                                HorizontalAlignment="Stretch"
                                ToolTip="وضعیت همهٔ دندان‌ها و ردیف‌های طرح درمان در پروندهٔ بیمار ذخیره می‌شود">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="💾 ذخیرهٔ چارت و طرح درمان" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═══ تب چشم‌پزشکی ═══ -->
            <TabItem Header="👁️ چشم‌پزشکی">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                    <StackPanel>
                        <!-- ═══ نوار بیمار تب چشم — چرخهٔ بیست‌وهشتم (گزارش هجدهم مالک):
                             پیش‌تر این تب بیمار خودش را نداشت و باید بیمار در تب
                             فیزیوتراپی/تصویربرداری جستجو می‌شد؛ اکنون معاینه و سابقه
                             به پروندهٔ همین بیمار وصل است ═══ -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.4*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding EyePatientSearch, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="🔍 بیمار چشم‌پزشکی — کد ملی / موبایل / نام">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchEyePatientCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Command="{Binding SearchEyePatientCommand}" Margin="8,0,0,0"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Padding="12,4">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Magnify" Width="15" Height="15" VerticalAlignment="Center" />
                                    <TextBlock Text="جستجو" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <!-- کارت بیمار — معاینه در پروندهٔ همین بیمار ثبت می‌شود -->
                            <Border Grid.Column="2" Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1"
                                    CornerRadius="8" Padding="10,5" Margin="8,0,8,0"
                                    Visibility="{Binding EyePatient, Converter={StaticResource NullToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountCheck" Width="16" Height="16" Foreground="#2E7D32" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding EyePatient.FullName, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding EyePatient.NationalCode, Mode=OneWay}" Opacity="0.7" FontSize="11"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="3" Command="{Binding ClearEyePatientCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}" Padding="8,4" ToolTip="بستن پرونده و بیمار بعدی"
                                    Visibility="{Binding EyePatient, Converter={StaticResource NullToVisibility}}">
                                <materialDesign:PackIcon Kind="CloseCircleOutline" Width="18" Height="18" Foreground="#C62828" />
                            </Button>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- OD -->
                            <Border Grid.Column="0" CornerRadius="12" Padding="14" Background="#E3F2FD">
                                <StackPanel>
                                    <TextBlock Text="چشم راست (OD)" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,6,6"><TextBlock Text="Sphere" FontSize="10.5" Opacity="0.6" /><TextBox Text="{Binding OdSphere, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" /></StackPanel>
                                        <StackPanel Margin="0,0,0,6"><TextBlock Text="Cylinder" FontSize="10.5" Opacity="0.6" /><TextBox Text="{Binding OdCylinder, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" /></StackPanel>
                                        <StackPanel Margin="0,0,6,0"><TextBlock Text="Axis" FontSize="10.5" Opacity="0.6" /><TextBox Text="{Binding OdAxis, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" /></StackPanel>
                                        <StackPanel><TextBlock Text="Add" FontSize="10.5" Opacity="0.6" /><TextBox Text="{Binding OdAdd, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" /></StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="دید بدون عینک" FontSize="10.5" Opacity="0.6" Margin="0,8,0,2" />
                                    <ComboBox ItemsSource="{Binding VisionOptions}" SelectedIndex="{Binding OdVisionIndex}" />
                                    <TextBlock Text="فشار چشم IOP (mmHg)" FontSize="10.5" Opacity="0.6" Margin="0,8,0,2" />
                                    <TextBox Text="{Binding OdIop, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" />
                                    <TextBlock Text="{Binding OdIopWarning, Mode=OneWay}" Foreground="#C62828" FontWeight="Bold" FontSize="11.5" Margin="0,4,0,0"
                                               Visibility="{Binding OdIopWarning, Converter={StaticResource StringToVisibility}}" />
                                </StackPanel>
                            </Border>
                            <!-- OS -->
                            <Border Grid.Column="2" CornerRadius="12" Padding="14" Background="#F3E5F5">
                                <StackPanel>
                                    <TextBlock Text="چشم چپ (OS)" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,6,6"><TextBlock Text="Sphere" FontSize="10.5" Opacity="0.6" /><TextBox Text="{Binding OsSphere, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" /></StackPanel>
                                        <StackPanel Margin="0,0,0,6"><TextBlock Text="Cylinder" FontSize="10.5" Opacity="0.6" /><TextBox Text="{Binding OsCylinder, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" /></StackPanel>
                                        <StackPanel Margin="0,0,6,0"><TextBlock Text="Axis" FontSize="10.5" Opacity="0.6" /><TextBox Text="{Binding OsAxis, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" /></StackPanel>
                                        <StackPanel><TextBlock Text="Add" FontSize="10.5" Opacity="0.6" /><TextBox Text="{Binding OsAdd, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" /></StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="دید بدون عینک" FontSize="10.5" Opacity="0.6" Margin="0,8,0,2" />
                                    <ComboBox ItemsSource="{Binding VisionOptions}" SelectedIndex="{Binding OsVisionIndex}" />
                                    <TextBlock Text="فشار چشم IOP (mmHg)" FontSize="10.5" Opacity="0.6" Margin="0,8,0,2" />
                                    <TextBox Text="{Binding OsIop, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" />
                                    <TextBlock Text="{Binding OsIopWarning, Mode=OneWay}" Foreground="#C62828" FontWeight="Bold" FontSize="11.5" Margin="0,4,0,0"
                                               Visibility="{Binding OsIopWarning, Converter={StaticResource StringToVisibility}}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="PD فاصله مردمک (mm)" FontSize="10.5" Opacity="0.6" />
                                <TextBox Text="{Binding Pd, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="دید رنگ" FontSize="10.5" Opacity="0.6" />
                                <ComboBox ItemsSource="{Binding ColorVisionOptions}" SelectedIndex="{Binding ColorVisionIndex}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="یافته‌ها و تشخیص" FontSize="10.5" Opacity="0.6" />
                                <TextBox Text="{Binding EyeFindings, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                         TextWrapping="Wrap" Height="60" />
                            </StackPanel>
                        </Grid>

                        <Button Command="{Binding SaveEyeExamCommand}" Margin="0,14,0,0" HorizontalAlignment="Left"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="💾 ذخیره معاینهٔ چشم در پروندهٔ بیمار" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- ═══ سابقهٔ معاینه‌های چشم بیمار منتخب — چرخهٔ ۲۸ ═══
                             با انتخاب بیمار، ۲۰ معاینهٔ آخر او از پرونده خوانده می‌شود؛
                             آخرین معاینه در فرم می‌نشیند و بقیه برای مرور روند درمان است -->
                        <Border CornerRadius="12" BorderBrush="#B39DDB" BorderThickness="1" Padding="12" Margin="0,14,0,0"
                                Background="#F3E5F5"
                                Visibility="{Binding EyePatient, Converter={StaticResource NullToVisibility}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="History" Width="18" Height="18" Foreground="#5E35B1" VerticalAlignment="Center" />
                                    <TextBlock Text="سابقهٔ معاینه‌های چشم (۲۰ مورد آخر — از پروندهٔ بیمار)" FontSize="13"
                                               FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="170">
                                    <ItemsControl ItemsSource="{Binding EyeHistory}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Background="#FFFFFF" Padding="9,6" Margin="0,0,0,5">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding DateShamsi, Mode=OneWay}" FontWeight="SemiBold"
                                                                       FontFamily="{DynamicResource App.CodeFont}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" HorizontalAlignment="Left" FontSize="10.5" Opacity="0.8"
                                                                       VerticalAlignment="Center" Margin="14,0,0,0">
                                                                <Run Text="OD: " /><Run Text="{Binding OdSummary, Mode=OneWay}" FontFamily="{DynamicResource App.CodeFont}" />
                                                                <Run Text="   OS: " /><Run Text="{Binding OsSummary, Mode=OneWay}" FontFamily="{DynamicResource App.CodeFont}" />
                                                            </TextBlock>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Findings, Mode=OneWay, TargetNullValue=''}" FontSize="10.5" Opacity="0.7"
                                                                   TextWrapping="Wrap" Margin="0,3,0,0"
                                                                   Visibility="{Binding Findings, Converter={StaticResource StringToVisibility}}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ تب فیزیوتراپی ═══ -->
            <TabItem Header="🏃 فیزیوتراپی">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Center">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding PhysioPatientSearch, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="🔍 بیمار (کد ملی / موبایل)">
                                <!-- چرخه بیست‌وسوم: Enter = دکمهٔ جستجو -->
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchPhysioPatientCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Command="{Binding SearchPhysioPatientCommand}" Margin="8,0,0,0"
                                    Style="{StaticResource MaterialDesignRaisedButton}">
                                <materialDesign:PackIcon Kind="Magnify" Width="14" Height="14" />
                            </Button>
                        </Grid>
                        <Border Background="#E3F2FD" CornerRadius="8" Padding="10,5" Margin="0,0,0,10"
                                Visibility="{Binding PhysioPatient, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{Binding PhysioPatient.FullName, Mode=OneWay}" FontWeight="SemiBold" />
                        </Border>

                        <TextBlock Text="تکنیک‌های درمانی" FontWeight="Bold" FontSize="13" Margin="2,0,2,6" />
                        <ItemsControl ItemsSource="{Binding Techniques}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding}" Margin="4,3" FontSize="12"
                                              Checked="OnTechniqueChecked" Unchecked="OnTechniqueUnchecked" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Text="{Binding PhysioOtherTechnique, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="سایر تکنیک‌ها…" Margin="0,8,0,0" />

                        <TextBlock FontSize="13" FontWeight="Bold" Margin="2,14,2,4">
                            <Run Text="نمره درد (۰ تا ۱۰): " /><Run Text="{Binding PainScore, Mode=OneWay}" FontFamily="{DynamicResource App.CodeFont}" Foreground="{Binding PainColor, Mode=OneWay}" />
                        </TextBlock>
                        <Slider Minimum="0" Maximum="10" Value="{Binding PainScore}"
                                TickFrequency="1" IsSnapToTickEnabled="True" />
                        <!-- راهنمای رنگ نمرهٔ درد — چرخهٔ ۳۳: همان الگوی چیپ رنگی واقعی به‌جای
                             ایموجی (ایموجی‌ها در فونت فارسی رندر نمی‌شوند — رفع مشابه راهنمای
                             چارت دندان در همین نما). رنگ‌ها عیناً از PainColor ویژومدل:
                             ≤۳ #43A047 / ≤۶ #FDD835 / بقیه #E53935 -->
                        <StackPanel Orientation="Horizontal" Margin="2,4,2,0">
                            <Border Width="13" Height="13" CornerRadius="4" Background="#43A047"
                                    BorderThickness="1" BorderBrush="#90A4AE" VerticalAlignment="Center" />
                            <TextBlock Text="۰-۳ خفیف" FontSize="10.5" Opacity="0.85" VerticalAlignment="Center" Margin="5,0,14,0" />
                            <Border Width="13" Height="13" CornerRadius="4" Background="#FDD835"
                                    BorderThickness="1" BorderBrush="#90A4AE" VerticalAlignment="Center" />
                            <TextBlock Text="۴-۶ متوسط" FontSize="10.5" Opacity="0.85" VerticalAlignment="Center" Margin="5,0,14,0" />
                            <Border Width="13" Height="13" CornerRadius="4" Background="#E53935"
                                    BorderThickness="1" BorderBrush="#90A4AE" VerticalAlignment="Center" />
                            <TextBlock Text="۷-۱۰ شدید" FontSize="10.5" Opacity="0.85" VerticalAlignment="Center" Margin="5,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="یادداشت پیشرفت" FontSize="10.5" Opacity="0.6" Margin="2,10,2,2" />
                        <TextBox Text="{Binding PhysioNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                 TextWrapping="Wrap" Height="66" />

                        <Button Command="{Binding SavePhysioSessionCommand}" Margin="0,14,0,0" HorizontalAlignment="Left"
                                Style="{StaticResource MaterialDesignRaisedButton}" Background="#2E7D32" BorderBrush="#2E7D32">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="💾 ذخیره جلسه" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ تب تصویربرداری ═══ -->
            <TabItem Header="📷 تصویربرداری">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Center">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ImagingPatientSearch, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="🔍 بیمار (کد ملی / موبایل)">
                                <!-- چرخه بیست‌وسوم: Enter = دکمهٔ جستجو -->
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchImagingPatientCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Command="{Binding SearchImagingPatientCommand}" Margin="8,0,0,0"
                                    Style="{StaticResource MaterialDesignRaisedButton}">
                                <materialDesign:PackIcon Kind="Magnify" Width="14" Height="14" />
                            </Button>
                        </Grid>
                        <Border Background="#E3F2FD" CornerRadius="8" Padding="10,5" Margin="0,0,0,10"
                                Visibility="{Binding ImagingPatient, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{Binding ImagingPatient.FullName, Mode=OneWay}" FontWeight="SemiBold" />
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="نوع تصویربرداری" FontSize="10.5" Opacity="0.6" />
                                <ComboBox ItemsSource="{Binding ImagingTypes}" SelectedIndex="{Binding ImagingTypeIndex}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ناحیه بدن" FontSize="10.5" Opacity="0.6" />
                                <ComboBox ItemsSource="{Binding BodyRegions}" SelectedItem="{Binding ImagingRegion}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="اطلاعات بالینی" FontSize="10.5" Opacity="0.6" Margin="2,10,2,2" />
                        <TextBox Text="{Binding ImagingClinicalInfo, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                 TextWrapping="Wrap" Height="66" />

                        <CheckBox Content="فوری" IsChecked="{Binding ImagingUrgent}" Margin="2,8,0,0" FontWeight="SemiBold" />

                        <Button Command="{Binding SaveImagingOrderCommand}" Margin="0,14,0,0" HorizontalAlignment="Left"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Camera" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="✅ ثبت درخواست تصویربرداری" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- ═══ بخش فایل‌های DICOM — گام R4 ═══ -->
                        <Separator Margin="0,16,0,12" />
                        <TextBlock Text="🖼 فایل‌های تصویر و DICOM" FontWeight="Bold" FontSize="13.5"
                                   Margin="2,0,0,6" />

                        <WrapPanel Margin="0,0,0,8">
                            <Button Command="{Binding LoadImagingOrdersCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Content="🔄 درخواست‌های امروز" />
                            <Button Command="{Binding UploadImagingFileCommand}" Margin="8,0,0,0"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Content="⬆ بارگذاری فایل" IsEnabled="{Binding HasSelectedImagingOrder}" />
                            <Button Command="{Binding OpenDicomViewerCommand}" Margin="8,0,0,0"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Content="🩻 نمایش DICOM" />
                        </WrapPanel>

                        <TextBlock Text="درخواست تصویربرداری (انتخاب برای اتصال فایل)" FontSize="10.5" Opacity="0.6" Margin="2,2,2,3" />
                        <ComboBox ItemsSource="{Binding ImagingOrders}" SelectedItem="{Binding SelectedImagingOrder}"
                                  DisplayMemberPath="Display" MaxDropDownHeight="260" Margin="0,0,0,8" />

                        <DataGrid ItemsSource="{Binding ImagingFiles}" SelectedItem="{Binding SelectedImagingFile}"
                                  AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220"
                                  Style="{StaticResource MaterialDesignDataGrid}"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="نام فایل" Binding="{Binding FileName, Converter={StaticResource PersianDigits}}" />
                                <DataGridTextColumn Header="نوع" Binding="{Binding KindText, Converter={StaticResource PersianDigits}}" />
                                <DataGridTextColumn Header="حجم" Binding="{Binding SizeText, Converter={StaticResource PersianDigits}}" />
                                <DataGridTemplateColumn Header="عملیات">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑 حذف" FontSize="10"
                                                    Command="{Binding DataContext.DeleteImagingFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
