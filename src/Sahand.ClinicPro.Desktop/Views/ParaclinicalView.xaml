<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.ParaclinicalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1080"
             FlowDirection="RightToLeft"
             FontFamily="Vazirmatn, Segoe UI, Tahoma">
    <!-- ═══ پاراکلینیک تخصصی — گام U12 طبق فرم‌های ۲۰-۲۳ ═══ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <materialDesign:PackIcon Kind="MedicalBag" Width="26" Height="26"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
            <TextBlock Text="پاراکلینیک تخصصی" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <TabControl Grid.Row="1" Style="{StaticResource MaterialDesignTabControl}">
            <!-- ═══ تب دندانپزشکی ═══ -->
            <TabItem Header="🦷 دندانپزشکی">
                <Grid Margin="4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.6*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- چارت FDI -->
                    <Border Grid.Column="0" CornerRadius="12" Padding="12"
                            Background="{DynamicResource MaterialDesign.Brush.Background}">
                        <StackPanel>
                            <TextBlock Text="ماگزیلا (فک بالا)" FontWeight="Bold" FontSize="12.5" Margin="2,0,2,6" />
                            <ItemsControl ItemsSource="{Binding UpperTeeth}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="44" Height="44" Margin="2"
                                                Command="{Binding DataContext.SelectToothCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding ToolTip}"
                                                Content="{Binding Number}"
                                                FontFamily="Consolas" FontSize="12">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                                    <Setter Property="Background" Value="{Binding Color, Mode=OneWay}" />
                                                    <Setter Property="BorderBrush" Value="#B0BEC5" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Number}" Value="{Binding DataContext.SelectedTooth.Number, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                            <Setter Property="BorderBrush" Value="#1565C0" />
                                                            <Setter Property="BorderThickness" Value="3" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator Margin="0,10,0,10" />

                            <TextBlock Text="مندیبل (فک پایین)" FontWeight="Bold" FontSize="12.5" Margin="2,0,2,6" />
                            <ItemsControl ItemsSource="{Binding LowerTeeth}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="44" Height="44" Margin="2"
                                                Command="{Binding DataContext.SelectToothCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding ToolTip}"
                                                Content="{Binding Number}"
                                                FontFamily="Consolas" FontSize="12"
                                                Background="{Binding Color, Mode=OneWay}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                BorderBrush="#B0BEC5" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="راهنما: ⬜ سالم   🟥 پوسیدگی   🟨 ترمیم‌شده   🟩 درمان‌شده   🟦 روکش   ⬛ کشیده‌شده   🟪 ایمپلنت"
                                       FontSize="10.5" Opacity="0.6" Margin="2,12,2,0" />
                        </StackPanel>
                    </Border>

                    <!-- جزئیات و طرح درمان -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" CornerRadius="12" Padding="12" Margin="0,0,0,8"
                                Background="{DynamicResource MaterialDesign.Brush.Background}">
                            <StackPanel>
                                <TextBlock FontSize="13" FontWeight="Bold" Margin="0,0,0,6">
                                    <Run Text="دندان انتخابی: " /><Run Text="{Binding SelectedTooth.Number, Mode=OneWay, TargetNullValue=—}" FontFamily="Consolas" />
                                </TextBlock>
                                <TextBlock Text="وضعیت" FontSize="10.5" Opacity="0.6" />
                                <ComboBox ItemsSource="{Binding ToothConditions}" SelectedIndex="{Binding ToothConditionIndex}" />
                                <Button Command="{Binding AddDentalPlanCommand}" Margin="0,10,0,0"
                                        Style="{StaticResource MaterialDesignRaisedButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="13" Height="13" />
                                        <TextBlock Text="افزودن به طرح درمان" Margin="7,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" CornerRadius="12" Padding="10"
                                Background="{DynamicResource MaterialDesign.Brush.Background}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="طرح درمان" FontWeight="Bold" FontSize="13" Margin="2,0,2,6" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding DentalPlan}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Padding="9,6" Margin="0,0,0,5" Background="#FFF8E1">
                                                    <StackPanel>
                                                        <TextBlock FontSize="12">
                                                            <Run Text="دندان " /><Run Text="{Binding Tooth, Mode=OneWay}" FontFamily="Consolas" FontWeight="Bold" />
                                                            <Run Text=" — " /><Run Text="{Binding Procedure, Mode=OneWay}" FontWeight="SemiBold" />
                                                        </TextBlock>
                                                        <TextBlock FontSize="10.5" Opacity="0.75" FontFamily="Consolas">
                                                            <Run Text="{Binding Price, Mode=OneWay, StringFormat='{}{0:N0}'}" /><Run Text=" ریال" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═══ تب چشم‌پزشکی ═══ -->
            <TabItem Header="👁️ چشم‌پزشکی">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- OD -->
                            <Border Grid.Column="0" CornerRadius="12" Padding="14" Background="#E3F2FD">
                                <StackPanel>
                                    <TextBlock Text="چشم راست (OD)" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,6,6"><TextBlock Text="Sphere" FontSize="10.5" Opacity="0.6" /><TextBox Text="{Binding OdSphere, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" /></StackPanel>
                                        <StackPanel Margin="0,0,0,6"><TextBlock Text="Cylinder" FontSize="10.5" Opacity="0.6" /><TextBox Text="{Binding OdCylinder, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" /></StackPanel>
                                        <StackPanel Margin="0,0,6,0"><TextBlock Text="Axis" FontSize="10.5" Opacity="0.6" /><TextBox Text="{Binding OdAxis, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" /></StackPanel>
                                        <StackPanel><TextBlock Text="Add" FontSize="10.5" Opacity="0.6" /><TextBox Text="{Binding OdAdd, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" /></StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="دید بدون عینک" FontSize="10.5" Opacity="0.6" Margin="0,8,0,2" />
                                    <ComboBox ItemsSource="{Binding VisionOptions}" SelectedIndex="{Binding OdVisionIndex}" />
                                    <TextBlock Text="فشار چشم IOP (mmHg)" FontSize="10.5" Opacity="0.6" Margin="0,8,0,2" />
                                    <TextBox Text="{Binding OdIop, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                                    <TextBlock Text="{Binding OdIopWarning, Mode=OneWay}" Foreground="#C62828" FontWeight="Bold" FontSize="11.5" Margin="0,4,0,0"
                                               Visibility="{Binding OdIopWarning, Converter={StaticResource StringToVisibility}}" />
                                </StackPanel>
                            </Border>
                            <!-- OS -->
                            <Border Grid.Column="2" CornerRadius="12" Padding="14" Background="#F3E5F5">
                                <StackPanel>
                                    <TextBlock Text="چشم چپ (OS)" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,6,6"><TextBlock Text="Sphere" FontSize="10.5" Opacity="0.6" /><TextBox Text="{Binding OsSphere, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" /></StackPanel>
                                        <StackPanel Margin="0,0,0,6"><TextBlock Text="Cylinder" FontSize="10.5" Opacity="0.6" /><TextBox Text="{Binding OsCylinder, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" /></StackPanel>
                                        <StackPanel Margin="0,0,6,0"><TextBlock Text="Axis" FontSize="10.5" Opacity="0.6" /><TextBox Text="{Binding OsAxis, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" /></StackPanel>
                                        <StackPanel><TextBlock Text="Add" FontSize="10.5" Opacity="0.6" /><TextBox Text="{Binding OsAdd, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" /></StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="دید بدون عینک" FontSize="10.5" Opacity="0.6" Margin="0,8,0,2" />
                                    <ComboBox ItemsSource="{Binding VisionOptions}" SelectedIndex="{Binding OsVisionIndex}" />
                                    <TextBlock Text="فشار چشم IOP (mmHg)" FontSize="10.5" Opacity="0.6" Margin="0,8,0,2" />
                                    <TextBox Text="{Binding OsIop, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                                    <TextBlock Text="{Binding OsIopWarning, Mode=OneWay}" Foreground="#C62828" FontWeight="Bold" FontSize="11.5" Margin="0,4,0,0"
                                               Visibility="{Binding OsIopWarning, Converter={StaticResource StringToVisibility}}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="PD فاصله مردمک (mm)" FontSize="10.5" Opacity="0.6" />
                                <TextBox Text="{Binding Pd, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="دید رنگ" FontSize="10.5" Opacity="0.6" />
                                <ComboBox ItemsSource="{Binding ColorVisionOptions}" SelectedIndex="{Binding ColorVisionIndex}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="یافته‌ها و تشخیص" FontSize="10.5" Opacity="0.6" />
                                <TextBox Text="{Binding EyeFindings, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                         TextWrapping="Wrap" Height="60" />
                            </StackPanel>
                        </Grid>

                        <Button Command="{Binding SaveEyeExamCommand}" Margin="0,14,0,0" HorizontalAlignment="Left"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="💾 ذخیره معاینه چشم" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ تب فیزیوتراپی ═══ -->
            <TabItem Header="🏃 فیزیوتراپی">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Center">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding PhysioPatientSearch, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="🔍 بیمار (کد ملی / موبایل)" />
                            <Button Grid.Column="1" Command="{Binding SearchPhysioPatientCommand}" Margin="8,0,0,0"
                                    Style="{StaticResource MaterialDesignRaisedButton}">
                                <materialDesign:PackIcon Kind="Magnify" Width="14" Height="14" />
                            </Button>
                        </Grid>
                        <Border Background="#E3F2FD" CornerRadius="8" Padding="10,5" Margin="0,0,0,10"
                                Visibility="{Binding PhysioPatient, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{Binding PhysioPatient.FullName, Mode=OneWay}" FontWeight="SemiBold" />
                        </Border>

                        <TextBlock Text="تکنیک‌های درمانی" FontWeight="Bold" FontSize="13" Margin="2,0,2,6" />
                        <ItemsControl ItemsSource="{Binding Techniques}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding}" Margin="4,3" FontSize="12"
                                              Checked="OnTechniqueChecked" Unchecked="OnTechniqueUnchecked" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Text="{Binding PhysioOtherTechnique, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="سایر تکنیک‌ها…" Margin="0,8,0,0" />

                        <TextBlock FontSize="13" FontWeight="Bold" Margin="2,14,2,4">
                            <Run Text="نمره درد (۰ تا ۱۰): " /><Run Text="{Binding PainScore, Mode=OneWay}" FontFamily="Consolas" Foreground="{Binding PainColor, Mode=OneWay}" />
                        </TextBlock>
                        <Slider Minimum="0" Maximum="10" Value="{Binding PainScore}"
                                TickFrequency="1" IsSnapToTickEnabled="True" />
                        <TextBlock Text="🟢 ۰-۳ خفیف        🟡 ۴-۶ متوسط        🔴 ۷-۱۰ شدید"
                                   FontSize="10.5" Opacity="0.6" Margin="2,4,2,0" />

                        <TextBlock Text="یادداشت پیشرفت" FontSize="10.5" Opacity="0.6" Margin="2,10,2,2" />
                        <TextBox Text="{Binding PhysioNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                 TextWrapping="Wrap" Height="66" />

                        <Button Command="{Binding SavePhysioSessionCommand}" Margin="0,14,0,0" HorizontalAlignment="Left"
                                Style="{StaticResource MaterialDesignRaisedButton}" Background="#2E7D32" BorderBrush="#2E7D32">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="💾 ذخیره جلسه" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ تب تصویربرداری ═══ -->
            <TabItem Header="📷 تصویربرداری">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Center">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ImagingPatientSearch, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="🔍 بیمار (کد ملی / موبایل)" />
                            <Button Grid.Column="1" Command="{Binding SearchImagingPatientCommand}" Margin="8,0,0,0"
                                    Style="{StaticResource MaterialDesignRaisedButton}">
                                <materialDesign:PackIcon Kind="Magnify" Width="14" Height="14" />
                            </Button>
                        </Grid>
                        <Border Background="#E3F2FD" CornerRadius="8" Padding="10,5" Margin="0,0,0,10"
                                Visibility="{Binding ImagingPatient, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{Binding ImagingPatient.FullName, Mode=OneWay}" FontWeight="SemiBold" />
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="نوع تصویربرداری" FontSize="10.5" Opacity="0.6" />
                                <ComboBox ItemsSource="{Binding ImagingTypes}" SelectedIndex="{Binding ImagingTypeIndex}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ناحیه بدن" FontSize="10.5" Opacity="0.6" />
                                <ComboBox ItemsSource="{Binding BodyRegions}" SelectedItem="{Binding ImagingRegion}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="اطلاعات بالینی" FontSize="10.5" Opacity="0.6" Margin="2,10,2,2" />
                        <TextBox Text="{Binding ImagingClinicalInfo, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                 TextWrapping="Wrap" Height="66" />

                        <CheckBox Content="فوری" IsChecked="{Binding ImagingUrgent}" Margin="2,8,0,0" FontWeight="SemiBold" />

                        <Button Command="{Binding SaveImagingOrderCommand}" Margin="0,14,0,0" HorizontalAlignment="Left"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Camera" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="✅ ثبت درخواست تصویربرداری" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- ═══ بخش فایل‌های DICOM — گام R4 ═══ -->
                        <Separator Margin="0,16,0,12" />
                        <TextBlock Text="🖼 فایل‌های تصویر و DICOM" FontWeight="Bold" FontSize="13.5"
                                   Margin="2,0,0,6" />

                        <WrapPanel Margin="0,0,0,8">
                            <Button Command="{Binding LoadImagingOrdersCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Content="🔄 درخواست‌های امروز" />
                            <Button Command="{Binding UploadImagingFileCommand}" Margin="8,0,0,0"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Content="⬆ بارگذاری فایل" IsEnabled="{Binding HasSelectedImagingOrder}" />
                            <Button Command="{Binding OpenDicomViewerCommand}" Margin="8,0,0,0"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Content="🩻 نمایش DICOM" />
                        </WrapPanel>

                        <TextBlock Text="درخواست تصویربرداری (انتخاب برای اتصال فایل)" FontSize="10.5" Opacity="0.6" Margin="2,2,2,3" />
                        <ComboBox ItemsSource="{Binding ImagingOrders}" SelectedItem="{Binding SelectedImagingOrder}"
                                  DisplayMemberPath="Display" MaxDropDownHeight="260" Margin="0,0,0,8" />

                        <DataGrid ItemsSource="{Binding ImagingFiles}" SelectedItem="{Binding SelectedImagingFile}"
                                  AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220"
                                  Style="{StaticResource MaterialDesignDataGrid}"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="نام فایل" Binding="{Binding FileName}" />
                                <DataGridTextColumn Header="نوع" Binding="{Binding KindText}" />
                                <DataGridTextColumn Header="حجم" Binding="{Binding SizeText}" />
                                <DataGridTemplateColumn Header="عملیات">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑 حذف" FontSize="10" Padding="6,2"
                                                    Command="{Binding DataContext.DeleteImagingFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
