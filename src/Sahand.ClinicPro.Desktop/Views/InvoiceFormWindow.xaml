<Window x:Class="Sahand.ClinicPro.Desktop.Views.InvoiceFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:behaviors="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        Title="{Binding FormTitle, Mode=OneWay}"
        Width="1020" Height="720"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft">
    <!-- ═══ صدور فاکتور — گام U8 طبق فرم ۱۴: ستون اصلی ۲fr + خلاصه ۱fr ═══ -->
    <Window.Resources>
        <Style x:Key="FieldCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Margin" Value="1,4,1,2" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding FormTitle, Mode=OneWay}" FontSize="17" FontWeight="Bold" Margin="0,0,0,8" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- ═══ ستون اصلی ═══ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- اطلاعات پایه -->
                    <Border CornerRadius="12" Padding="12,10" Margin="0,0,0,10"
                            Background="{DynamicResource MaterialDesign.Brush.Background}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="🔍 بیمار (کد ملی / موبایل)" Style="{StaticResource FieldCaption}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding PatientSearch, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SearchPatientCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="1" Command="{Binding SearchPatientCommand}" Margin="8,0,0,0"
                                            Style="{StaticResource MaterialDesignRaisedButton}">
                                        <materialDesign:PackIcon Kind="Magnify" Width="14" Height="14" />
                                    </Button>
                                </Grid>
                                <Border Background="#E3F2FD" CornerRadius="8" Padding="9,4" Margin="0,6,0,0"
                                        Visibility="{Binding Patient, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock Text="{Binding Patient.FullName, Mode=OneWay}" FontWeight="SemiBold" FontSize="12.5"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="پزشک (اختیاری)" Style="{StaticResource FieldCaption}" />
                                <ComboBox ItemsSource="{Binding Doctors}" SelectedIndex="{Binding DoctorIndex}" DisplayMemberPath="Name" />
                                <TextBlock Text="بیمه" Style="{StaticResource FieldCaption}" />
                                <ComboBox ItemsSource="{Binding InsuranceCompanies}" SelectedIndex="{Binding InsuranceIndex}" DisplayMemberPath="Name" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="نرخ مالیات (٪)" Style="{StaticResource FieldCaption}" />
                                <TextBox Text="{Binding TaxPercent, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" TextAlignment="Center" />
                                <TextBlock Text="پیش‌فرض معمولاً صفر است" FontSize="9.5" Opacity="0.5" Margin="1,4,1,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- اقلام فاکتور -->
                    <Border CornerRadius="12" Padding="12,10" Margin="0,0,0,10"
                            Background="{DynamicResource MaterialDesign.Brush.Background}">
                        <StackPanel>
                            <TextBlock Text="اقلام فاکتور — با کد خدمت K" FontWeight="Bold" FontSize="13.5" Margin="2,0,2,8" />
                            <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                                      CanUserAddRows="False" HeadersVisibility="Column" FontSize="12"
                                      MinHeight="90">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="کد" Binding="{Binding Code, Converter={StaticResource PersianDigits}}" Width="Auto" FontFamily="{DynamicResource App.CodeFont}" IsReadOnly="True" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                                    <DataGridTextColumn Header="شرح خدمت" Binding="{Binding Name, Converter={StaticResource PersianDigits}}" Width="Auto" IsReadOnly="True" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                                    <DataGridTemplateColumn Header="انجام‌دهنده" Width="Auto" MaxWidth="420">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.Performers, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding Performer, UpdateSourceTrigger=PropertyChanged}"
                                                          DisplayMemberPath="FullName"
                                                          FontSize="11.5" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="تعداد" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                                    <DataGridTextColumn Header="قیمت واحد" Binding="{Binding UnitPrice, Mode=OneWay, Converter={StaticResource CurrencyRial}}" Width="Auto" IsReadOnly="True" FontFamily="{DynamicResource App.CodeFont}" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                                    <DataGridTextColumn Header="سهم بیمه" Binding="{Binding TotalInsurance, Mode=OneWay, Converter={StaticResource CurrencyRial}}" Width="Auto" IsReadOnly="True" FontFamily="{DynamicResource App.CodeFont}" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                                    <DataGridTextColumn Header="سهم بیمار" Binding="{Binding TotalPatient, Mode=OneWay, Converter={StaticResource CurrencyRial}}" Width="Auto" IsReadOnly="True" FontFamily="{DynamicResource App.CodeFont}" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                                    <DataGridTemplateColumn Header="" Width="Auto" MaxWidth="420">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignIconForegroundButton}"
                                                        Foreground="#C62828" Padding="4" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" VerticalAlignment="Center"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- افزودن خدمت -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="0.6*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="🔍 جستجوی خدمت" Style="{StaticResource FieldCaption}" />
                                    <ComboBox ItemsSource="{Binding Services}"
                                              SelectedItem="{Binding SelectedService}"
                                              DisplayMemberPath="ServiceName"
                                              IsEditable="True"
                                              Text="{Binding ServiceSearch, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="تعداد" Style="{StaticResource FieldCaption}" />
                                    <TextBox Text="{Binding ServiceQuantity, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" FontFamily="{DynamicResource App.CodeFont}" />
                                </StackPanel>
                                <Button Grid.Column="2" Command="{Binding AddServiceCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}" VerticalAlignment="Bottom">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="افزودن" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ ستون خلاصه ═══ -->
            <Border Grid.Column="2" CornerRadius="12" Padding="14,12"
                    Background="{DynamicResource MaterialDesign.Brush.Background}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="💰 خلاصه فاکتور" FontWeight="Bold" FontSize="14" Margin="2,0,2,10" />

                        <TextBlock Style="{StaticResource FieldCaption}"><Run Text="جمع کل (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock>
                        <TextBlock Text="{Binding GrossTotalText, Mode=OneWay}" FontSize="16" FontWeight="Bold" FontFamily="{DynamicResource App.CodeFont}" />

                        <TextBlock Style="{StaticResource FieldCaption}"><Run Text="تخفیف — مبلغ (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock>
                        <!-- چرخه بیستم: کادر مبلغ با جداکنندهٔ زندهٔ ۳ رقمی (MoneyInput)
                             + مبدل ریال↔نمایش برای حالت تومان -->
                        <TextBox behaviors:MoneyInput.IsEnabled="True"
                                 behaviors:MoneyInput.NumericValue="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MoneyRial}}"
                                 FontFamily="{DynamicResource App.CodeFont}" materialDesign:HintAssist.Hint="تخفیف (مبلغ)"/>
                        <TextBlock Text="تخفیف — درصد" Style="{StaticResource FieldCaption}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" />
                            <TextBlock Grid.Column="1" Text="٪" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldCaption}"><Run Text="سهم بیمه (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock>
                        <TextBlock Text="{Binding InsuranceShareText, Mode=OneWay}" FontSize="14" FontWeight="Bold"
                                   FontFamily="{DynamicResource App.CodeFont}" Foreground="#2E7D32" />

                        <TextBlock Style="{StaticResource FieldCaption}"><Run Text="مالیات (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock>
                        <TextBlock Text="{Binding TaxText, Mode=OneWay}" FontSize="13" FontFamily="{DynamicResource App.CodeFont}" />

                        <Separator Margin="0,12,0,8" />

                        <TextBlock FontSize="13" FontWeight="Bold"><Run Text="💵 قابل پرداخت (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock>
                        <TextBlock Text="{Binding PayableText, Mode=OneWay}" FontSize="20" FontWeight="Bold"
                                   FontFamily="{DynamicResource App.CodeFont}" Foreground="#C62828" />

                        <Separator Margin="0,12,0,8" />

                        <TextBlock Text="💳 روش پرداخت" Style="{StaticResource FieldCaption}" />
                        <ComboBox SelectedIndex="{Binding PaymentMethodIndex}">
                            <ComboBoxItem Content="💵 نقد" />
                            <ComboBoxItem Content="💳 کارت‌خوان" />
                            <ComboBoxItem Content="🏦 واریز بانکی" />
                            <ComboBoxItem Content="🧾 چک" />
                        </ComboBox>

                        <TextBlock Style="{StaticResource FieldCaption}"><Run Text="مبلغ دریافتی (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock>
                        <TextBox behaviors:MoneyInput.IsEnabled="True"
                                 behaviors:MoneyInput.NumericValue="{Binding ReceivedAmount, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MoneyRial}}"
                                 FontFamily="{DynamicResource App.CodeFont}" FontSize="14" materialDesign:HintAssist.Hint="مبلغ دریافتی"/>

                        <TextBlock Text="شماره ارجاع (برای کارت/بانک)" Style="{StaticResource FieldCaption}" />
                        <TextBox Text="{Binding ReferenceNumber, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource FieldCaption}"><Run Text="باقیمانده (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock>
                        <TextBlock Text="{Binding RemainingText, Mode=OneWay}" FontSize="14" FontFamily="{DynamicResource App.CodeFont}"
                                   Foreground="#C62828" />

                        <Button Command="{Binding SaveAndPrintCommand}" Margin="0,14,0,0"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#2E7D32" BorderBrush="#2E7D32" Height="42">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="CheckCircle" Width="17" Height="17" VerticalAlignment="Center" />
                                <TextBlock Text="✅ ثبت و چاپ" Margin="9,0,0,0" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding PreviewCommand}" Margin="0,8,0,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Printer" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="🖨️ پیش‌نمایش" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- خطا و پیشرفت -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <ProgressBar IsIndeterminate="True" Width="24" Height="16" DockPanel.Dock="Left" Margin="0,0,10,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" FontSize="12" VerticalAlignment="Center"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />
        </DockPanel>
    </Grid>
</Window>
