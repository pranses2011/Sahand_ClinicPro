<Window x:Class="Sahand.ClinicPro.Desktop.Views.TariffFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding Header}"
        Height="500" Width="440"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!-- ═══════════════════════════════════════════════════════════
         فرم ثبت/ویرایش خدمت/تعرفه — چرخه بیست‌وسوم (گزارش شانزدهم مالک):
         «در صفحه بیمه، بتوان تعرفه جدید تعریف کرد و یا تعرفه‌های موجود را
         ویرایش کرد» — نام/کد/قیمت/سهم بیمه/سهم بیمار/وضعیت فعال
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- سربرگ — چرخه ۲۴: برچسب هدف تعرفه (آزاد یا بیمهٔ منتخب) زیر عنوان -->
        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="CashPlus" Width="24" Height="24"
                                         Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Header}" FontSize="17" FontWeight="Bold"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding TargetLabel, Mode=OneWay}" FontSize="11.5" Opacity="0.7"
                       Margin="34,4,0,0"
                       ToolTip="این قیمت/سهم‌ها روی تعرفهٔ همین هدف ذخیره می‌شود" />
        </StackPanel>

        <!-- نام خدمت -->
        <TextBox Grid.Row="1" materialDesign:HintAssist.Hint="نام خدمت *"
                 Text="{Binding ServiceName, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"
                 Margin="0,0,0,12" />

        <!-- کد خدمت -->
        <TextBox Grid.Row="2" materialDesign:HintAssist.Hint="کد خدمت (خالی بگذارید = ساخت خودکار)"
                 Text="{Binding ServiceCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="20"
                 Margin="0,0,0,12" FontFamily="{DynamicResource App.CodeFont}" FlowDirection="LeftToRight" />

        <!-- قیمت -->
        <TextBox Grid.Row="3" materialDesign:HintAssist.Hint="قیمت تعرفه‌ای"
                 Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,12" />

        <!-- ═══ سهم بیمه / بیمار — دوستونه ═══
             چرخهٔ بیست‌وششم (گزارش هجدهم مالک): «برای آزاد، تمامی مبالغ بصورت
             پیش‌فرض سهم بیمار بکن و در ویرایش تعرفه‌های آزاد درصدهای بیمار و
             بیمه غیرفعال و ۱۰۰ درصد بیمار باشد» — برای هدف آزاد هر دو فیلد
             غیرفعال و مقادیر استاندارد (۰/۱۰۰) نمایش داده می‌شوند -->
        <UniformGrid Grid.Row="4" Columns="2" IsEnabled="{Binding IsInsuranceTarget, Mode=OneWay}">
            <TextBox materialDesign:HintAssist.Hint="٪ سهم بیمه (۰-۱۰۰)"
                     Text="{Binding InsuranceShare, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,4,12" />
            <TextBox materialDesign:HintAssist.Hint="٪ سهم بیمار (۰-۱۰۰)"
                     Text="{Binding PatientShare, UpdateSourceTrigger=PropertyChanged}"
                     Margin="4,0,0,12" />
        </UniformGrid>
        <!-- راهنمای سهم‌ها — برای آزاد: قاعدهٔ ۱۰۰٪ بیمار؛ برای بیمه: عادی -->
        <TextBlock Grid.Row="5" Text="{Binding ShareHint, Mode=OneWay}"
                   FontSize="10.5" TextWrapping="Wrap" Opacity="0.75"
                   Margin="2,0,0,10"
                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />

        <!-- فعال -->
        <CheckBox Grid.Row="6" Content="فعال باشد (در فرم فاکتور قابل انتخاب است)"
                  IsChecked="{Binding IsActive}"
                  Margin="0,0,0,12" />

        <!-- خطا + دکمه‌ها -->
        <StackPanel Grid.Row="7">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
            <UniformGrid Columns="2">
                <Button Command="{Binding SaveCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Content="ذخیره" Height="40" Margin="0,0,4,0" />
                <Button Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Content="انصراف" Height="40" Margin="4,0,0,0" />
            </UniformGrid>
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Grid>
</Window>
