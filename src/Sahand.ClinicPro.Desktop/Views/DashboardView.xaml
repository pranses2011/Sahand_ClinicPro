<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
             xmlns:charts="clr-namespace:Sahand.ClinicPro.Desktop.Controls.Charts"
             xmlns:helpers="clr-namespace:Sahand.ClinicPro.Desktop.Helpers"
             mc:Ignorable="d"
             FlowDirection="RightToLeft">
    <!-- ═══════════════════════════════════════════════════════════════════
         داشبورد — بازطراحی کامل چرخهٔ ۷۲ (گزارش مالک: «داشبورد رو بازطراحی
         بکن و خیلی حرفه ای و زیبا به همراه کارت های آماری و نموداری باشه و
         سپس پنل مبانبرها رو هم بصورت حرفه ای و زیبا از اول طراحی بکن —
         کدهای قبلی رو در نظر نگیر و کد جدید بنویس»)

         ساختار جدید (کاملاً بازنویسی‌شده — هیچ قالبی از نسخهٔ قبل عایش نشده):
           ۱) سربرگ قهرمان — گرادیان عمیق سرمه‌ای-فیروزه‌ای با خوش‌آمد، تاریخ
              شمسی، نشان نسخه، وضعیت اتصال و دکمه‌های اقدام (تازه‌سازی /
              نمایشگر سالن / شخصی‌سازی)
           ۲) پنل میانبرهای سریع — طراحی صفرِ جدید: کاشی افقی «آیکون مربع‌گوشه
              + عنوان + دسته» با ته‌رنگ ملایم دستهٔ هر صفحه؛ ارتفاع قطعی و
              بدون افکت سایه (درس بریدگیِ چرخه‌های ۴۳-۴۷)
           ۳) ردیف ۵ کارت KPI — نوار تأکید گرادیانی بالای هر کارت + عدد درشت
              فارسی + زیرنویس؛ شخصی‌سازی (ترتیب/نمایش) حفظ شد
           ۴) ردیف نمودارها — روند درآمد (سطحی، بازهٔ ۷/۱۴/۳۰) + ترکیب وضعیت
              نوبت‌های امروز (دونات با جمع مرکز)
           ۵) ردیف دوم نمودارها — ویزیت‌های روزانه (ستونی) + نوبت‌های پیش‌رو
           ۶) مرکز هشدار انبار (پلکانی ۹۰/۶۰/۳۰/۷) — بازطراحی‌شده
           ۷) فعالیت‌های اخیر + پیام‌های پشتیبانی
         ═══════════════════════════════════════════════════════════════════ -->
    <UserControl.Resources>
        <!-- مبدل‌های محلی — الگوی ثابت پروژه (هر نما BoolToVis خودش را تعریف می‌کند) -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ═══ قالب ردیف نوبت‌های پیش‌رو — بازطراحی چرخهٔ ۷۲ ═══
             کارت نازک با نوار وضعیت سمت راست، شمارهٔ صف درشت و زمان/پزشک چپ -->
        <DataTemplate x:Key="AppointmentItemTemplate">
            <Border Background="#FBFCFE" BorderBrush="#E4EAF2" BorderThickness="1"
                    CornerRadius="10" Padding="10,7" Margin="0,0,0,6">
                <DockPanel>
                    <!-- زمان و پزشک — لبهٔ چپ فیزیکی -->
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" MinWidth="62">
                        <TextBlock Text="{Binding Time}" FontSize="13.5" FontWeight="Bold"
                                   Foreground="#37474F" FontFamily="{DynamicResource App.CodeFont}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding DoctorName}" FontSize="9" Opacity="0.55"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="80" />
                    </StackPanel>

                    <!-- نوار وضعیت رنگی — سمت راست -->
                    <Border DockPanel.Dock="Right" Width="4" CornerRadius="2" Margin="0,0,8,0"
                            VerticalAlignment="Stretch">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#B0BEC5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                        <Setter Property="Background" Value="#1E88E5" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Arrived">
                                        <Setter Property="Background" Value="#43A047" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Confirmed">
                                        <Setter Property="Background" Value="#FDD835" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                        <Setter Property="Background" Value="#2E7D32" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- شمارهٔ صف و نام بیمار -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#EEF2F8" CornerRadius="11" Width="26" Height="26"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding QueueNumber, TargetNullValue=—}"
                                       Foreground="#37474F" FontSize="10.5" FontWeight="Bold"
                                       FontFamily="{DynamicResource App.CodeFont}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold"
                                       FontSize="12.5" Foreground="#1F2937" />
                            <TextBlock Text="{Binding StatusText}" FontSize="9.5" Opacity="0.6" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- ═══ قالب کارت KPI — طراحی جدید چرخهٔ ۷۲ ═══
             کارت سفید با نوار گرادیانی تأکید بالا، چیپ آیکون گردِ ته‌رنگ،
             عدد درشت فارسی، عنوان و زیرنویس؛ حالت شخصی‌سازی دکمه‌های
             ترتیب/نمایش را روی کارت می‌آورد (رفتار چرخهٔ ۱۳ حفظ شد). -->
        <DataTemplate x:Key="KpiCardTemplate">
            <Grid Margin="0,0,8,0">
                <!-- ═══ چرخهٔ ۷۳ (گزارش مالک: «زیرشون ناقص دیده میشه») — ارتفاع قطعی ممنوع ═══
                     پیشتر Height=112 قطعی بود؛ با متریک بلندِ قلم وزیرمتن (ارتفاع سطر ~۱٫۴ برابر
                     اندازهٔ قلم) محتوا (سربرگ ۳۴ + عدد درشت ۲۵px + زیرنویس مقایسه) از ۱۱۲ تجاوز
                     می‌کرد و زیرنویسِ زیرِ عدد بیرون از کارت می‌افتاد/بریده می‌شد. MinHeight همان
                     بلوک بصری را حفظ می‌کند ولی در برابر فونت/مقیاس/DPI کشسان است. -->
                <Border CornerRadius="14" Background="#FFFFFF" BorderBrush="#E2E8F0"
                        BorderThickness="1.2" Padding="14,12,12,12"
                        Visibility="{Binding Visible, Converter={StaticResource BoolToVis}}"
                        UseLayoutRounding="True" SnapsToDevicePixels="True">
                    <Border.MinHeight>112</Border.MinHeight>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- سربرگ کارت — آیکون + عنوان -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <Border Width="34" Height="34" CornerRadius="17" VerticalAlignment="Center"
                                    Background="{Binding Accent, Converter={StaticResource HexToBrush}}">
                                <materialDesign:PackIcon Kind="{Binding IconKind, TargetNullValue=ViewDashboard, FallbackValue=ViewDashboard}"
                                                         Width="17" Height="17" Foreground="White"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Label}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="#546E7A" Margin="9,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <!-- مقدار درشت + زیرنویس -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Value, Mode=OneWay}" FontSize="25" FontWeight="Bold"
                                       Foreground="#102A43" FontFamily="{DynamicResource App.CodeFont}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CompareText, Mode=OneWay}" FontSize="9.5"
                                       Opacity="0.55" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- نوار تأکید رنگ کارت — لایهٔ جدا روی قاب (بالای کارت) -->
                <Border Height="4" CornerRadius="2,2,0,0" VerticalAlignment="Top" Margin="1,1,9,0"
                        Background="{Binding Accent, Converter={StaticResource HexToBrush}, FallbackValue=#1565C0}"
                        Visibility="{Binding Visible, Converter={StaticResource BoolToVis}}" />

                <!-- کنترل‌های چیدمان — فقط در حالت شخصی‌سازی (روی کارت) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="6,0,0,8"
                            Visibility="{Binding DataContext.IsCustomizing, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}">
                    <Button Command="{Binding DataContext.MoveCardUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource MaterialDesignFlatButton}" Padding="3,1" ToolTip="جابه‌جایی به قبل">
                        <materialDesign:PackIcon Kind="ChevronUp" Width="12" Height="12" />
                    </Button>
                    <Button Command="{Binding DataContext.MoveCardDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource MaterialDesignFlatButton}" Padding="3,1" ToolTip="جابه‌جایی به بعد">
                        <materialDesign:PackIcon Kind="ChevronDown" Width="12" Height="12" />
                    </Button>
                    <ToggleButton IsChecked="{Binding Visible}" Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  Padding="2,0" ToolTip="نمایش/پنهان این کارت" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ═══ قالب چیپ بازهٔ نمودار درآمد — چیپ‌های ۷/۱۴/۳۰ روزه (چرخهٔ ۷۲) ═══ -->
        <Style x:Key="RangeChipStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip" CornerRadius="10" Padding="11,4" MinWidth="40"
                                Background="Transparent" BorderBrush="#CFD8DC" BorderThickness="1.2">
                            <TextBlock x:Name="ChipText" Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}"
                                       FontSize="11" FontWeight="SemiBold" Foreground="#607D8B"
                                       HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#0D47A1" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#0D47A1" />
                                <Setter TargetName="ChipText" Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ سربرگ استاندارد کارت‌های داشبورد — بازطراحی چرخهٔ ۷۲ ═══ -->
        <Style x:Key="CardHeaderTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,14">
        <StackPanel>

            <!-- ╔══════════════════════════════════════════════════════════╗
                 ║ ۱) سربرگ قهرمان — بازطراحی کامل چرخهٔ ۷۲                   ║
                 ╚══════════════════════════════════════════════════════════╝ -->
            <Border CornerRadius="18" Padding="20,14" Margin="0,0,0,12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1A237E" Offset="0" />
                        <GradientStop Color="#0D47A1" Offset="0.55" />
                        <GradientStop Color="#00695C" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270"
                                      Opacity="0.18" Color="#0D2A4E" />
                </Border.Effect>
                <DockPanel>
                    <!-- دکمه‌های اقدام — لبهٔ چپ فیزیکی -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding RefreshCommand}" Width="40" Height="40" Padding="0"
                                Cursor="Hand" Focusable="False" Margin="0,0,8,0"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#26FFFFFF" BorderBrush="#40FFFFFF"
                                ToolTip="تازه‌سازی کامل داشبورد (به‌روزرسانی خودکار هر ۶۰ ثانیه)">
                            <materialDesign:PackIcon Kind="Refresh" Width="17" Height="17" Foreground="White" />
                        </Button>
                        <Button Command="{Binding OpenWaitingRoomDisplayCommand}" Width="40" Height="40" Padding="0"
                                Cursor="Hand" Focusable="False" Margin="0,0,8,0"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#26FFFFFF" BorderBrush="#40FFFFFF"
                                ToolTip="نمایشگر سالن انتظار (حالت کیوسک — خروج با Esc)">
                            <materialDesign:PackIcon Kind="MonitorDashboard" Width="17" Height="17" Foreground="White" />
                        </Button>
                        <ToggleButton IsChecked="{Binding IsCustomizing}" Width="40" Height="40" Padding="0"
                                      Cursor="Hand" Focusable="False"
                                      ToolTip="مدیریت چیدمان داشبورد — ترتیب و نمایش کارت‌ها و بخش‌ها">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="CustBtn" Width="40" Height="40" CornerRadius="20"
                                            Background="Transparent" BorderBrush="#66FFFFFF" BorderThickness="1.4">
                                        <materialDesign:PackIcon x:Name="CustIcon" Kind="TuneVertical" Width="17" Height="17"
                                                                 Foreground="#E3F2FD"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="CustBtn" Property="Background" Value="#FFFFFF" />
                                            <Setter TargetName="CustBtn" Property="BorderBrush" Value="#FFFFFF" />
                                            <Setter TargetName="CustIcon" Property="Foreground" Value="#0D47A1" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CustBtn" Property="Opacity" Value="0.85" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </StackPanel>

                    <!-- خوش‌آمد + تاریخ + وضعیت -->
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewDashboardVariant" Width="20" Height="20"
                                                     Foreground="#80DEEA" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="داشبورد مدیریت درمانگاه" FontSize="17" FontWeight="Bold"
                                       Foreground="White" VerticalAlignment="Center" />
                            <!-- نشان نسخه + تاریخ ساخت — تشخیصیِ جایگزینی فایل‌ها (چرخهٔ ۶۷) -->
                            <Border CornerRadius="9" Padding="8,2" Margin="12,0,0,0"
                                    Background="#26FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1"
                                    VerticalAlignment="Center"
                                    ToolTip="نسخه و تاریخ ساختِ بیلدِ در حال اجرا — پس از نصب هر بستهٔ آپدیت، تاریخ بیلد باید همان روزِ نصب باشد؛ اگر قدیم ماند، فایل‌های جدید جایگزین نشده‌اند و باید bin/obj را پاک و Clean + Rebuild انجام شود">
                                <TextBlock Text="{x:Static helpers:AppInfo.VersionFullText}"
                                           FontSize="10" Foreground="#B3E5FC"
                                           FontFamily="{DynamicResource App.CodeFont}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <materialDesign:PackIcon Kind="CalendarMonthOutline" Width="13" Height="13"
                                                     Foreground="#80CBC4" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TodayDateShamsi}" FontSize="12" Foreground="#E1F5FE"
                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource App.CodeFont}" />
                            <Ellipse Width="7" Height="7" Fill="#69F0AE" Margin="14,0,6,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ConnectionStatus}" FontSize="10.5" Foreground="#B2DFDB"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- متن خوش‌آمد کامل — زیر سربرگ -->
            <TextBlock Text="{Binding WelcomeMessage}" Foreground="#1565C0" FontSize="12"
                       Margin="4,0,4,10" TextWrapping="Wrap" />

            <!-- ╔══════════════════════════════════════════════════════════╗
                 ║ ۲) پنل میانبرهای سریع — طراحی صفرِ جدید چرخهٔ ۷۲           ║
                 ║ گزارش مالک: «پنل مبانبرها رو هم بصورت حرفه ای و زیبا از   ║
                 ║ اول طراحی بکن (کدهای قبلی رو در نظر نگیر و کد جدید بنویس)» ║
                 ║ کاشی افقی: چیپ آیکون مربع‌گوشه‌ی ته‌رنگِ دسته + عنوان +      ║
                 ║ زیرنویس دسته؛ ارتفاع قطعی ۷۶px، بدون سایه/انیمیشن مرزبر  ║
                 ╚══════════════════════════════════════════════════════════╝ -->
            <Border Background="#FFFFFF" CornerRadius="16" Padding="14,10" Margin="0,0,0,12"
                    BorderBrush="#E2E8F0" BorderThickness="1.2">
                <StackPanel>
                    <!-- سربرگ پنل — عنوان + دکمه‌های مدیریتی دایره‌ای -->
                    <DockPanel Margin="2,0,2,6">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="9" VerticalAlignment="Center"
                                    Background="#FFF3E0">
                                <materialDesign:PackIcon Kind="LightningBolt" Width="15" Height="15"
                                                         Foreground="#EF6C00"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="میانبرهای سریع من" FontSize="14" FontWeight="Bold"
                                       Foreground="#1F2937" Margin="9,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="یک کلیک تا صفحهٔ مقصد" FontSize="10" Foreground="#90A4AE"
                                       Margin="10,2,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- دکمه‌های افزودن/ویرایش — دایره‌های کامل (الگوی چرخهٔ ۴۵) -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <Button Command="{Binding AddShortcutCommand}"
                                    Width="34" Height="34" Padding="0" Margin="0,0,7,0"
                                    Cursor="Hand" Focusable="False" ClickMode="Press"
                                    ToolTip="میانبر جدید — افزودن صفحهٔ دلخواه به این پنل">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="AddCircle" Width="34" Height="34" CornerRadius="17"
                                                Background="#EF6C00">
                                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16"
                                                                     Foreground="White"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="AddCircle" Property="Background" Value="#FB8C00" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="AddCircle" Property="Opacity" Value="0.75" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <ToggleButton IsChecked="{Binding IsEditingShortcuts}"
                                          Width="34" Height="34" Padding="0"
                                          Cursor="Hand" Focusable="False" ClickMode="Press"
                                          ToolTip="حالت ویرایش — دکمهٔ حذف روی هر کاشی نمایان می‌شود؛ پایان ویرایش = ذخیرهٔ خودکار">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="EditCircle" Width="34" Height="34" CornerRadius="17"
                                                Background="Transparent" BorderBrush="#B0BEC5" BorderThickness="1.5">
                                            <materialDesign:PackIcon x:Name="EditIcon" Kind="PencilOutline" Width="14" Height="14"
                                                                     Foreground="#78909C"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="EditCircle" Property="BorderBrush" Value="#EF6C00" />
                                                <Setter TargetName="EditCircle" Property="Background" Value="#EF6C00" />
                                                <Setter TargetName="EditIcon" Property="Foreground" Value="White" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="EditCircle" Property="Opacity" Value="0.85" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </StackPanel>
                    </DockPanel>

                    <!-- حالت خالی — دعوت به افزودن نخستین میانبر -->
                    <Border CornerRadius="12" Background="#F8FAFC" BorderBrush="#E8EDF3" BorderThickness="1"
                            Padding="14,10" Margin="2,2,2,6"
                            Visibility="{Binding HasShortcuts, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CursorDefaultClickOutline" Width="18" Height="18"
                                                     Foreground="#90A4AE" VerticalAlignment="Center" />
                            <TextBlock FontSize="11.5" Opacity="0.75" Margin="10,0,0,0" TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Text="هنوز میانبری نساخته‌اید — صفحات پرکاربرد خود را با دکمهٔ نارنجی «+» به این پنل اضافه کنید تا بدون گشتن در منو، با یک کلیک باز شوند." />
                        </StackPanel>
                    </Border>

                    <!-- کاشی‌های میانبر — طراحی جدید: عرض کشسان ۱۶۸px، ارتفاع قطعی ۷۶px -->
                    <ItemsControl ItemsSource="{Binding Shortcuts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,8,8" Width="168" MinHeight="76">
                                    <!-- کاشی اصلی — کلیک = ناوبری مستقیم
                                         (چرخهٔ ۷۳: Height قطعی ۷۶ ← MinHeight؛ محتوا هرگز
                                         از مرز پایین کاشی بیرون نمی‌زند و زیرنویس دسته
                                         کامل دیده می‌شود) -->
                                    <Button Command="{Binding DataContext.OpenShortcutCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand" Focusable="False"
                                            ToolTip="{Binding Title, StringFormat=باز کردن {0}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Tile" CornerRadius="14"
                                                        Background="{Binding GroupColor, Converter={StaticResource HexBrush}, ConverterParameter=tint, FallbackValue=#F5F7FB}"
                                                        BorderBrush="{Binding GroupColor, Converter={StaticResource HexToBrush}, FallbackValue=#CFD8DC}"
                                                        BorderThickness="1.3"
                                                        MinHeight="76" Padding="12,8"
                                                        UseLayoutRounding="True" SnapsToDevicePixels="True">
                                                    <DockPanel VerticalAlignment="Center">
                                                        <!-- چیپ آیکون — مربع گوشه‌گرد هم‌رنگ دسته -->
                                                        <Border Width="40" Height="40" CornerRadius="12"
                                                                VerticalAlignment="Center" Margin="0,0,10,0"
                                                                Background="{Binding GroupColor, Converter={StaticResource HexToBrush}, FallbackValue=#78909C}">
                                                            <materialDesign:PackIcon Kind="{Binding Icon, TargetNullValue=ViewDashboard, FallbackValue=ViewDashboard}"
                                                                                     Width="20" Height="20" Foreground="White"
                                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <!-- عنوان + دسته -->
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title, TargetNullValue=بدون عنوان, FallbackValue=بدون عنوان}"
                                                                       FontSize="12" FontWeight="Bold" Foreground="#1F2937"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="100" />
                                                            <TextBlock Text="{Binding Group}" FontSize="9.5"
                                                                       Foreground="#78909C" Margin="0,3,0,0"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="100" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Tile" Property="BorderThickness" Value="2" />
                                                        <Setter TargetName="Tile" Property="Opacity" Value="0.92" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Tile" Property="Opacity" Value="0.8" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- دکمهٔ حذف گوشه — فقط در حالت ویرایش -->
                                    <Button Command="{Binding DataContext.RemoveShortcutCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Width="24" Height="24" Padding="0"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="-6,-6,0,0"
                                            Cursor="Hand" Focusable="False"
                                            ToolTip="حذف این میانبر"
                                            Visibility="{Binding DataContext.IsEditingShortcuts, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="DelCircle" Width="24" Height="24" CornerRadius="12"
                                                        Background="#E53935" BorderBrush="White" BorderThickness="1.5">
                                                    <materialDesign:PackIcon Kind="Close" Width="11" Height="11"
                                                                             Foreground="White"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="DelCircle" Property="Background" Value="#C62828" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <!-- ╔══════════════════════════════════════════════════════════╗
                 ║ پیام‌های پشتیبانی سرور لایسنس — کارت‌های رنگی سطح اهمیت    ║
                 ╚══════════════════════════════════════════════════════════╝ -->
            <ItemsControl ItemsSource="{Binding SupportMessages}"
                          Visibility="{Binding HasSupportMessages, Converter={StaticResource BoolToVis}}"
                          Margin="0,0,0,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="12" Padding="14,10" Margin="0,0,0,8"
                                BorderThickness="0,3.5,0,0"
                                Background="{Binding EffectiveBrush, Converter={StaticResource HexBrush}, ConverterParameter=tint}"
                                BorderBrush="{Binding EffectiveBrush, Converter={StaticResource HexBrush}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding LevelIcon}" FontSize="15" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="9" Padding="9,2.5"
                                            Background="{Binding EffectiveBrush, Converter={StaticResource HexBrush}, ConverterParameter=tint}"
                                            BorderBrush="{Binding EffectiveBrush, Converter={StaticResource HexBrush}}" BorderThickness="1">
                                        <TextBlock Text="{Binding DateFa, Mode=OneWay}" FontSize="9.5" FontWeight="SemiBold"
                                                   Foreground="{Binding EffectiveBrush, Converter={StaticResource HexBrush}}"
                                                   FontFamily="{DynamicResource App.CodeFont}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Body}" FontSize="12" Margin="0,5,0,0"
                                           Opacity="0.85" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ╔══════════════════════════════════════════════════════════╗
                 ║ نوار مدیریت چیدمان — فقط در حالت شخصی‌سازی                 ║
                 ╚══════════════════════════════════════════════════════════╝ -->
            <Border CornerRadius="12" Padding="14,10" Margin="0,0,0,12"
                    Visibility="{Binding IsCustomizing, Converter={StaticResource BoolToVis}}"
                    BorderThickness="1,3.5,1,1" BorderBrush="#F9A825"
                    Background="#FFFDF5">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <materialDesign:PackIcon DockPanel.Dock="Right" Kind="TuneVertical" Width="18" Height="18"
                                                 Foreground="#E65100" VerticalAlignment="Center" />
                        <TextBlock Text="حالت مدیریت چیدمان — تغییرات به‌صورت خودکار ذخیره می‌شوند"
                                   FontWeight="Bold" FontSize="13" Foreground="#E65100" Margin="2,0,8,0"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,14,3">
                            <TextBlock Text="نمودار درآمد" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ToggleButton IsChecked="{Binding ShowRevenueChart}"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}" Padding="2,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,14,3">
                            <TextBlock Text="نوبت‌های پیش‌رو" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ToggleButton IsChecked="{Binding ShowUpcoming}"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}" Padding="2,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,14,3">
                            <TextBlock Text="فعالیت‌های اخیر" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ToggleButton IsChecked="{Binding ShowActivities}"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}" Padding="2,0" />
                        </StackPanel>
                        <Button Command="{Binding ResetLayoutCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Padding="10,2" FontSize="10.5" VerticalAlignment="Center"
                                ToolTip="بازگشت همهٔ کارت‌ها و بخش‌ها به حالت پیش‌فرض">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Restore" Width="12" Height="12" VerticalAlignment="Center" />
                                <TextBlock Text="چیدمان پیش‌فرض" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="با دکمه‌های ⬆⬇ پایین کارت‌ها ترتیب‌شان را جابه‌جا کنید و با سوییچ کنارشان پنهان‌شان کنید"
                                   FontSize="10" Opacity="0.6" VerticalAlignment="Center" Margin="0,3,0,3" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ╔══════════════════════════════════════════════════════════╗
                 ║ ۳) ردیف کارت‌های KPI — پنج کارت شخصی‌سازی‌پذیر (چرخهٔ ۷۲)  ║
                 ╚══════════════════════════════════════════════════════════╝ -->
            <ItemsControl ItemsSource="{Binding MainCards}"
                          ItemTemplate="{StaticResource KpiCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- ╔══════════════════════════════════════════════════════════╗
                 ║ ۴) ردیف نمودارهای اصلی — روند درآمد + ترکیب وضعیت نوبت‌ها ║
                 ╚══════════════════════════════════════════════════════════╝ -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- کارت روند درآمد — سطحی با چیپ‌های بازهٔ ۷/۱۴/۳۰ (چرخهٔ ۷۲) -->
                <Border Grid.Column="0" CornerRadius="16" Background="#FFFFFF" Padding="16,12"
                        BorderBrush="#E2E8F0" BorderThickness="1.2"
                        Visibility="{Binding ShowRevenueChart, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- سربرگ + چیپ‌های بازه -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="9" Background="#EDE7F6" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ChartAreaspline" Width="15" Height="15" Foreground="#5E35B1"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="روند درآمد" Style="{StaticResource CardHeaderTitle}" Margin="9,0,0,0" />
                                <TextBlock FontSize="10" Opacity="0.5" VerticalAlignment="Center" Margin="6,2,0,0">
                                    <Run Text="(" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" />
                                </TextBlock>
                            </StackPanel>
                            <!-- چیپ‌های بازه — دکمه‌های رادیویی چیپی -->
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <RadioButton Style="{StaticResource RangeChipStyle}" GroupName="RevDays"
                                             IsChecked="{Binding IsRevenue7, Mode=TwoWay}" Content="۷ روز" />
                                <RadioButton Style="{StaticResource RangeChipStyle}" GroupName="RevDays"
                                             IsChecked="{Binding IsRevenue14, Mode=TwoWay}" Content="۱۴ روز" />
                                <RadioButton Style="{StaticResource RangeChipStyle}" GroupName="RevDays"
                                             IsChecked="{Binding IsRevenue30, Mode=TwoWay}" Content="۳۰ روز" />
                            </StackPanel>
                        </DockPanel>

                        <!-- نمودار سطحی — نوع درست برای روند زمانی -->
                        <charts:AreaChart Grid.Row="1" Points="{Binding RevenueChart}" ValueFormat="N0" MinHeight="210" />
                    </Grid>
                </Border>

                <!-- کارت ترکیب وضعیت نوبت‌های امروز — دونات با جمع مرکز (چرخهٔ ۷۲) -->
                <Border Grid.Column="2" CornerRadius="16" Background="#FFFFFF" Padding="16,12"
                        BorderBrush="#E2E8F0" BorderThickness="1.2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="28" Height="28" CornerRadius="9" Background="#E3F2FD" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ChartDonut" Width="15" Height="15" Foreground="#1565C0"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="وضعیت نوبت‌های امروز" Style="{StaticResource CardHeaderTitle}" Margin="9,0,0,0" />
                        </StackPanel>

                        <charts:DoughnutChart Grid.Row="1" Points="{Binding StatusMix}"
                                              CenterText="{Binding StatusMixTotalText, Mode=OneWay}"
                                              CenterSubtext="{Binding StatusMixSubText, Mode=OneWay}"
                                              MinHeight="210" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ╔══════════════════════════════════════════════════════════╗
                 ║ ۵) ردیف دوم — ویزیت‌های روزانه + نوبت‌های پیش‌رو           ║
                 ╚══════════════════════════════════════════════════════════╝ -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <!-- کارت ویزیت‌های روزانه — ستونی (چرخهٔ ۷۲) -->
                <Border Grid.Column="0" CornerRadius="16" Background="#FFFFFF" Padding="16,12"
                        BorderBrush="#E2E8F0" BorderThickness="1.2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="28" Height="28" CornerRadius="9" Background="#E8F5E9" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ChartBar" Width="15" Height="15" Foreground="#2E7D32"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="ویزیت‌های ۷ روز اخیر" Style="{StaticResource CardHeaderTitle}" Margin="9,0,0,0" />
                        </StackPanel>

                        <charts:ColumnChart Grid.Row="1" Points="{Binding VisitsChart}" ValueFormat="N0"
                                            ShowValues="False" MinHeight="180" />
                    </Grid>
                </Border>

                <!-- کارت نوبت‌های پیش‌رو — نمایش قابل تنظیم -->
                <Border Grid.Column="2" CornerRadius="16" Background="#FFFFFF" Padding="14,12"
                        BorderBrush="#E2E8F0" BorderThickness="1.2"
                        Visibility="{Binding ShowUpcoming, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,2,8">
                            <Border Width="28" Height="28" CornerRadius="9" Background="#FFF3E0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ClockFast" Width="15" Height="15" Foreground="#E65100"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="نوبت‌های پیش‌رو" Style="{StaticResource CardHeaderTitle}" Margin="9,0,0,0" />
                        </StackPanel>

                        <ListBox Grid.Row="1" ItemsSource="{Binding UpcomingAppointments}"
                                 ItemTemplate="{StaticResource AppointmentItemTemplate}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                        <controls:EmptyState Grid.Row="1"
                                             Message="امروز نوبتی ثبت نشده است"
                                             IconKind="CalendarBlank"
                                             Visibility="{Binding UpcomingAppointments.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ╔══════════════════════════════════════════════════════════╗
                 ║ ۶) مرکز هشدار انبار — پلکانی ۹۰/۶۰/۳۰/۷ + موجودی کم       ║
                 ╚══════════════════════════════════════════════════════════╝ -->
            <Border CornerRadius="16" Background="#FFFFFF" Padding="14,10" Margin="0,12,0,0"
                    BorderBrush="#F3C1BD" BorderThickness="1.2"
                    Visibility="{Binding HasNoAlertsAtAll, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel>
                    <!-- سربرگ کلیک‌پذیر — باز/بستن مرکز هشدار -->
                    <Button Command="{Binding ToggleAlertCenterCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Right"
                            Padding="4,2" ToolTip="باز/بستن فهرست اقلام هشدار">
                        <DockPanel>
                            <Border Width="30" Height="30" CornerRadius="9" Background="#FDECEA" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="BellAlert" Width="16" Height="16" Foreground="#C62828"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="مرکز هشدار انبار" Style="{StaticResource CardHeaderTitle}" Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                            <!-- چیپ‌های پلکانی -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border CornerRadius="9" Padding="8,2" Margin="4,0" Background="#FDECEA"
                                        BorderBrush="#E53935" BorderThickness="1"
                                        Visibility="{Binding Expiring7Count, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock FontSize="10.5" Foreground="#C62828" FontFamily="{DynamicResource App.CodeFont}">
                                        <Run Text="بحرانی ≤۷روز: " /><Run Text="{Binding Expiring7Count, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                                    </TextBlock>
                                </Border>
                                <Border CornerRadius="9" Padding="8,2" Margin="4,0" Background="#FFF3E0"
                                        BorderBrush="#FB8C00" BorderThickness="1"
                                        Visibility="{Binding Expiring30Count, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock FontSize="10.5" Foreground="#E65100" FontFamily="{DynamicResource App.CodeFont}">
                                        <Run Text="فوری ≤۳۰روز: " /><Run Text="{Binding Expiring30Count, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                                    </TextBlock>
                                </Border>
                                <Border CornerRadius="9" Padding="8,2" Margin="4,0" Background="#FFFDE7"
                                        BorderBrush="#F9A825" BorderThickness="1"
                                        Visibility="{Binding Expiring60Count, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock FontSize="10.5" Foreground="#F57F17" FontFamily="{DynamicResource App.CodeFont}">
                                        <Run Text="هشدار ≤۶۰روز: " /><Run Text="{Binding Expiring60Count, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                                    </TextBlock>
                                </Border>
                                <Border CornerRadius="9" Padding="8,2" Margin="4,0" Background="#FFFDE7"
                                        BorderBrush="#FBC02D" BorderThickness="1"
                                        Visibility="{Binding Expiring90Count, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock FontSize="10.5" Foreground="#B58900" FontFamily="{DynamicResource App.CodeFont}">
                                        <Run Text="پایش ≤۹۰روز: " /><Run Text="{Binding Expiring90Count, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                                    </TextBlock>
                                </Border>
                                <Border CornerRadius="9" Padding="8,2" Margin="4,0" Background="#E3F2FD"
                                        BorderBrush="#1E88E5" BorderThickness="1"
                                        Visibility="{Binding LowStockCount, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock FontSize="10.5" Foreground="#1565C0" FontFamily="{DynamicResource App.CodeFont}">
                                        <Run Text="موجودی کم: " /><Run Text="{Binding LowStockCount, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                                    </TextBlock>
                                </Border>
                                <!-- چیپ آزمایش در انتظار — چرخهٔ ۷۲: از کارت‌های فرعی حذف‌شده به مرکز هشدار آمد -->
                                <Border CornerRadius="9" Padding="8,2" Margin="4,0" Background="#EDE7F6"
                                        BorderBrush="#5E35B1" BorderThickness="1"
                                        Visibility="{Binding PendingLabOrders, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock FontSize="10.5" Foreground="#4527A0" FontFamily="{DynamicResource App.CodeFont}">
                                        <Run Text="آزمایش در انتظار: " /><Run Text="{Binding PendingLabOrders, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                                    </TextBlock>
                                </Border>
                                <!-- فلش باز/بسته -->
                                <materialDesign:PackIcon Kind="ChevronDown" Width="16" Height="16"
                                                         VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#78909C">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAlertCenterOpen}" Value="True">
                                                    <Setter Property="Kind" Value="ChevronUp" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </StackPanel>
                        </DockPanel>
                    </Button>

                    <!-- فهرست اقلام — فقط در حالت باز -->
                    <StackPanel Visibility="{Binding IsAlertCenterOpen, Converter={StaticResource BoolToVis}}" Margin="2,8,2,0">
                        <DockPanel Margin="2,0,2,4">
                            <TextBlock Text="بچ‌های در حال انقضا (نزدیک‌ترین اول)" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="حداکثر ۲۰ قلم" FontSize="10" Opacity="0.5"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ExpiringItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Background="#FBFCFE" BorderBrush="#E8EDF3"
                                            BorderThickness="1" Padding="10,6" Margin="0,0,0,5">
                                        <DockPanel>
                                            <Border CornerRadius="8" Padding="7,2" DockPanel.Dock="Left"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding TierBrush, Converter={StaticResource HexToBrush}}">
                                                <TextBlock FontSize="10.5" Foreground="White" FontFamily="{DynamicResource App.CodeFont}">
                                                    <Run Text="{Binding TierText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DaysLeft, Mode=OneWay, Converter={StaticResource PersianDigits}}" /><Run Text=" روز" />
                                                </TextBlock>
                                            </Border>
                                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MedicationName}" FontSize="12.5" FontWeight="SemiBold" Foreground="#1F2937" />
                                                <TextBlock FontSize="10.5" Opacity="0.75" FontFamily="{DynamicResource App.CodeFont}">
                                                    <Run Text="بچ " /><Run Text="{Binding BatchNumber, Mode=OneWay, TargetNullValue=—}" /><Run Text=" · انقضا " /><Run Text="{Binding ExpiryDateShamsi, Mode=OneWay}" /><Run Text=" · موجودی " /><Run Text="{Binding QuantityText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <controls:EmptyState Message="بچ در حال انقضایی در ۹۰ روز آینده نیست"
                                             IconKind="CheckCircle"
                                             Visibility="{Binding ExpiringItems.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" />

                        <DockPanel Margin="2,10,2,4">
                            <TextBlock Text="زیر حداقل موجودی (بدترین وضعیت اول)" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding LowStockItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Background="#FBFCFE" BorderBrush="#E8EDF3"
                                            BorderThickness="1" Padding="10,6" Margin="0,0,0,5">
                                        <DockPanel>
                                            <Border CornerRadius="8" Padding="7,2" DockPanel.Dock="Left"
                                                    VerticalAlignment="Center" Background="#E3F2FD">
                                                <TextBlock FontSize="10.5" Foreground="#1565C0" FontFamily="{DynamicResource App.CodeFont}">
                                                    <Run Text="کمبود" />
                                                </TextBlock>
                                            </Border>
                                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MedicationName}" FontSize="12.5" FontWeight="SemiBold" Foreground="#1F2937" />
                                                <TextBlock FontSize="10.5" Opacity="0.75" FontFamily="{DynamicResource App.CodeFont}">
                                                    <Run Text="بچ " /><Run Text="{Binding BatchNumber, Mode=OneWay, TargetNullValue=—}" /><Run Text=" · موجودی " /><Run Text="{Binding QuantityText, Mode=OneWay}" /><Run Text=" · حداقل " /><Run Text="{Binding MinStockText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <controls:EmptyState Message="قلمی زیر حداقل موجودی نیست"
                                             IconKind="CheckCircle"
                                             Visibility="{Binding LowStockItems.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ╔══════════════════════════════════════════════════════════╗
                 ║ ۷) فعالیت‌های اخیر — نمایش قابل تنظیم                       ║
                 ╚══════════════════════════════════════════════════════════╝ -->
            <Border CornerRadius="16" Background="#FFFFFF" Padding="16,12" Margin="0,12,0,4"
                    BorderBrush="#E2E8F0" BorderThickness="1.2"
                    Visibility="{Binding ShowActivities, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="28" Height="28" CornerRadius="9" Background="#ECEFF1" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="History" Width="15" Height="15" Foreground="#455A64"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="فعالیت‌های اخیر" Style="{StaticResource CardHeaderTitle}" Margin="9,0,0,0" />
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding RecentActivities}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              CanUserAddRows="False" MinHeight="120" MaxHeight="220" FontSize="11"
                              AlternatingRowBackground="#F7FAFD" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="زمان"
                                                Binding="{Binding TimeShamsi, Converter={StaticResource PersianDigits}}"
                                                Width="150" />
                            <DataGridTextColumn Header="کاربر"
                                                Binding="{Binding User, Converter={StaticResource PersianDigits}}"
                                                Width="130" />
                            <DataGridTextColumn Header="عملیات"
                                                Binding="{Binding Action, Converter={StaticResource PersianDigits}}"
                                                Width="110" />
                            <DataGridTextColumn Header="موجودیت"
                                                Binding="{Binding Entity, Converter={StaticResource PersianDigits}}"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- پیام خطا در نبود سرور -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                       TextWrapping="Wrap" Margin="4,12,4,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
