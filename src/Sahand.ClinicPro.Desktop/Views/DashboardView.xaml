<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             FontFamily="Vazirmatn, Segoe UI, Tahoma">
    <!-- ═══════════════════════════════════════════════════════════
         داشبورد مدیریتی — گام U1 طبق پرامپت UI بخش ۱ (فرم ۲)
         نوار خوش‌آمد + ۴ کارت اصلی + ۳ کارت فرعی + نمودار درآمد ۷ روز
         + نوبت‌های پیش‌رو + فعالیت‌های اخیر (به‌روزرسانی ۶۰ ثانیه)
         ═══════════════════════════════════════════════════════════ -->
    <UserControl.Resources>
        <!-- قالب ردیف نوبت‌های پیش‌رو — شماره صف دایره‌ای + نام + وضعیت -->
        <DataTemplate x:Key="AppointmentItemTemplate">
            <Border Background="{DynamicResource MaterialDesign.Brush.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Background.Variant}"
                    BorderThickness="0,0,0,1" CornerRadius="6" Padding="8,6" Margin="4,2">
                <DockPanel>
                    <!-- نشان وضعیت رنگی -->
                    <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="5"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#9E9E9E" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                        <Setter Property="Background" Value="#1E88E5" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Arrived">
                                        <Setter Property="Background" Value="#43A047" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Confirmed">
                                        <Setter Property="Background" Value="#FDD835" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                        <Setter Property="Background" Value="#2E7D32" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- زمان و پزشک -->
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Time}" FontSize="13" FontWeight="Bold"
                                   FontFamily="Consolas" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding DoctorName}" FontSize="9" Opacity="0.6"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- شماره صف و نام بیمار -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                CornerRadius="11" Width="22" Height="22"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding QueueNumber}"
                                       Foreground="White" FontSize="10"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold"
                                       FontSize="12" />
                            <TextBlock Text="{Binding StatusText}" FontSize="9" Opacity="0.65" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
        <StackPanel>
            <!-- نوار عنوان + دکمه بارگذاری مجدد -->
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Left"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        ToolTip="بارگذاری مجدد (به‌روزرسانی خودکار هر ۶۰ ثانیه)">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="بارگذاری مجدد" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <StackPanel>
                    <TextBlock Text="📊 داشبورد مدیریتی"
                               Style="{StaticResource SectionTitle}" Margin="0" />
                    <TextBlock Text="خلاصه وضعیت امروز درمانگاه"
                               FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                </StackPanel>
            </DockPanel>

            <!-- نوار خوش‌آمد -->
            <Border Background="#E3F2FD" CornerRadius="10" Padding="14,8" Margin="0,0,0,12">
                <DockPanel>
                    <materialDesign:PackIcon Kind="LightbulbOn"
                                             Width="20" Height="20"
                                             Foreground="#1565C0"
                                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding WelcomeMessage}"
                               Foreground="#1565C0" FontSize="12"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- ردیف ۱: چهار کارت آمار اصلی -->
            <UniformGrid Columns="4" Rows="1">
                <controls:StatCard IconKind="AccountGroup"
                                   Value="{Binding TodayPatients, Mode=OneWay}"
                                   Label="بیماران امروز"
                                   CompareText="مجموع نوبت‌های ثبت‌شده امروز"
                                   AccentBrush="#1E88E5" />
                <controls:StatCard IconKind="Stethoscope"
                                   Value="{Binding TodayVisits, Mode=OneWay}"
                                   Label="ویزیت‌شده"
                                   CompareText="ویزیت‌های انجام‌شده امروز"
                                   AccentBrush="#43A047" />
                <controls:StatCard IconKind="ClockOutline"
                                   Value="{Binding WaitingCount, Mode=OneWay}"
                                   Label="در انتظار"
                                   CompareText="در صف انتظار باقی‌مانده"
                                   AccentBrush="#FB8C00" />
                <controls:StatCard IconKind="CashMultiple"
                                   Value="{Binding TodayRevenueText, Mode=OneWay}"
                                   Label="درآمد امروز (ریال)"
                                   CompareText="مجموع پرداخت‌های ثبت‌شده"
                                   AccentBrush="#8E24AA" />
            </UniformGrid>

            <!-- ردیف ۲: سه کارت فرعی -->
            <UniformGrid Columns="3" Rows="1">
                <controls:StatCard IconKind="AlertCircle"
                                   Value="{Binding LowStockCount, Mode=OneWay}"
                                   Label="موجودی کم دارو"
                                   CompareText="اقلام زیر حداقل موجودی"
                                   AccentBrush="#E53935" />
                <controls:StatCard IconKind="Prescription"
                                   Value="{Binding PendingLabOrders, Mode=OneWay}"
                                   Label="آزمایش در انتظار"
                                   CompareText="درخواست‌های بدون نتیجه"
                                   AccentBrush="#00897B" />
                <controls:StatCard IconKind="CalendarMonth"
                                   Value="{Binding TodayPatients, Mode=OneWay}"
                                   Label="نوبت‌های امروز"
                                   CompareText="شامل همه وضعیت‌ها به‌جز لغو"
                                   AccentBrush="#5C6BC0" />
            </UniformGrid>

            <!-- ردیف ۳: نمودار درآمد (۲fr) + نوبت‌های پیش‌رو (۱fr) -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- کارت نمودار درآمد ۷ روز -->
                <materialDesign:Card Grid.Column="0" UniformCornerRadius="14" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                            <TextBlock Text="نمودار درآمد ۷ روز اخیر"
                                       FontSize="14" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="(ریال)"
                                       FontSize="10" Opacity="0.5"
                                       VerticalAlignment="Bottom"
                                       Margin="6,0,0,2" />
                        </DockPanel>

                        <TextBlock Grid.Row="1" Text="{Binding ConnectionStatus}"
                                   FontSize="10" Opacity="0.6" Margin="0,0,0,8" />

                        <!-- میله‌های نمودار -->
                        <ItemsControl Grid.Row="2"
                                      ItemsSource="{Binding RevenueChart}"
                                      VerticalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="52" Margin="3,0"
                                                VerticalAlignment="Bottom"
                                                ToolTip="{Binding AmountText, StringFormat={}{0:N0} ریال}">
                                        <TextBlock Text="{Binding AmountText}"
                                                   FontSize="8" Opacity="0.7"
                                                   HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Height="{Binding BarHeight}"
                                                Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                                CornerRadius="4,4,0,0"
                                                VerticalAlignment="Bottom"
                                                Margin="0,4,0,0"
                                                Opacity="0.85" />
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="8" Opacity="0.6"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </materialDesign:Card>

                <!-- کارت نوبت‌های پیش‌رو -->
                <materialDesign:Card Grid.Column="2" UniformCornerRadius="14" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="4,0,4,6">
                            <materialDesign:PackIcon Kind="ClockFast"
                                                     Width="18" Height="18"
                                                     VerticalAlignment="Center" />
                            <TextBlock Text="نوبت‌های پیش‌رو"
                                       FontSize="13" FontWeight="Bold"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding UpcomingAppointments}"
                                 ItemTemplate="{StaticResource AppointmentItemTemplate}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                        <controls:EmptyState Grid.Row="1"
                                             Message="امروز نوبتی ثبت نشده است"
                                             IconKind="CalendarBlank"
                                             Visibility="{Binding UpcomingAppointments.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" />
                    </Grid>
                </materialDesign:Card>
            </Grid>

            <!-- ردیف ۴: فعالیت‌های اخیر -->
            <materialDesign:Card UniformCornerRadius="14" Padding="16" Margin="0,14,0,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <materialDesign:PackIcon Kind="History"
                                                 Width="18" Height="18"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="فعالیت‌های اخیر"
                                   FontSize="13" FontWeight="Bold"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding RecentActivities}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              MinHeight="120"
                              MaxHeight="220"
                              FontSize="11">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="زمان"
                                                Binding="{Binding TimeShamsi}"
                                                Width="140" />
                            <DataGridTextColumn Header="کاربر"
                                                Binding="{Binding User}"
                                                Width="120" />
                            <DataGridTextColumn Header="عملیات"
                                                Binding="{Binding Action}"
                                                Width="110" />
                            <DataGridTextColumn Header="موجودیت"
                                                Binding="{Binding Entity}"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>

            <!-- پیام خطا در نبود سرور -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.Error}"
                       TextWrapping="Wrap" Margin="4,12,4,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
