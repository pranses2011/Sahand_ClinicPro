<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
             xmlns:charts="clr-namespace:Sahand.ClinicPro.Desktop.Controls.Charts"
             xmlns:helpers="clr-namespace:Sahand.ClinicPro.Desktop.Helpers"
             mc:Ignorable="d"
             FlowDirection="RightToLeft">
    <!-- ═══════════════════════════════════════════════════════════
         داشبورد مدیریتی — گام U1 طبق پرامپت UI بخش ۱ (فرم ۲)
         نوار خوش‌آمد + ۴ کارت اصلی + ۳ کارت فرعی + نمودار درآمد ۷ روز
         + نوبت‌های پیش‌رو + فعالیت‌های اخیر (به‌روزرسانی ۶۰ ثانیه)
         ═══════════════════════════════════════════════════════════ -->
    <UserControl.Resources>
        <!-- مبدل دیدپذیری — چرخه شانزدهم (گزارش دهم مالک): این فایل در ۹ نقطه به
             BoolToVis ارجاع می‌داد اما نه محلی تعریفش کرده بود و نه در App.xaml
             موجود است؛ StaticResource فقط از منابع «همان فایل» یا App.xaml حل می‌شود
             (تعریف در پنجره‌های دیگر — مثل ورود — برای این فایل بی‌اثر است) → نخستین
             باز شدن داشبورد با XamlParseException می‌ریخت. الگوی ۱۳ فایل دیگر پروژه
             (تعریف محلی BooleanToVisibilityConverter با کلید BoolToVis) اعمال شد. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- قالب ردیف نوبت‌های پیش‌رو — شماره صف دایره‌ای + نام + وضعیت -->
        <DataTemplate x:Key="AppointmentItemTemplate">
            <Border Background="{DynamicResource MaterialDesign.Brush.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                    BorderThickness="0,0,0,1" CornerRadius="6" Padding="8,6" Margin="4,2">
                <DockPanel>
                    <!-- نشان وضعیت رنگی -->
                    <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="5"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#9E9E9E" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                        <Setter Property="Background" Value="#1E88E5" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Arrived">
                                        <Setter Property="Background" Value="#43A047" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Confirmed">
                                        <Setter Property="Background" Value="#FDD835" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                        <Setter Property="Background" Value="#2E7D32" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- زمان و پزشک -->
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Time}" FontSize="13" FontWeight="Bold"
                                   FontFamily="{DynamicResource App.CodeFont}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding DoctorName}" FontSize="9" Opacity="0.6"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- شماره صف و نام بیمار -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                CornerRadius="11" Width="22" Height="22"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding QueueNumber}"
                                       Foreground="White" FontSize="10"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold"
                                       FontSize="12" />
                            <TextBlock Text="{Binding StatusText}" FontSize="9" Opacity="0.65" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
        <StackPanel>
            <!-- نوار عنوان + دکمه بارگذاری مجدد -->
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Left"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        ToolTip="بارگذاری مجدد (به‌روزرسانی خودکار هر ۶۰ ثانیه)">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="بارگذاری مجدد" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- ═══ چرخهٔ ۴۴ (گزارش مالک: «مدیریت داشبورد رو خیلی حرفه ای تر و
                     زیباتر پیاده سازی بکن») — سربرگ گرادیانی برند به‌جای عنوان سادهٔ
                     متنی؛ هم‌الگوی صفحهٔ نقش‌ها: نشان شیشه‌ای + عنوان + زیرعنوان +
                     چیپ تاریخ شمسی امروز در گوشهٔ چپ فیزیکی -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="21" VerticalAlignment="Center" Margin="0,0,10,0"
                                Background="#331E88E5" BorderBrush="#661E88E5" BorderThickness="1">
                            <materialDesign:PackIcon Kind="ViewDashboard" Width="21" Height="21"
                                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="داشبورد مدیریتی"
                                       Style="{StaticResource SectionTitle}" Margin="0" />
                            <TextBlock Text="خلاصه وضعیت امروز درمانگاه"
                                       FontSize="12" Opacity="0.7" Margin="0,0,0,2" />
                        </StackPanel>
                        <!-- چیپ تاریخ امروز — گوشهٔ چپ فیزیکی (RTL) -->
                        <Border CornerRadius="9" Padding="10,3" VerticalAlignment="Center" Margin="14,4,0,0"
                                Background="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1">
                            <TextBlock Text="{Binding TodayDateShamsi, Mode=OneWay}" FontSize="10.5"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- چرخه ۱۳ (۴-۲): شخصی‌سازی داشبورد -->
                <ToggleButton DockPanel.Dock="Left" IsChecked="{Binding IsCustomizing}" Margin="0,0,10,0"
                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                              ToolTip="حالت شخصی‌سازی — جابه‌جایی/پنهان‌سازی کارت‌ها و بخش‌ها"
                              VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TuneVertical" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="شخصی‌سازی" FontSize="11.5" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Button DockPanel.Dock="Left" Command="{Binding ResetLayoutCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,10,0"
                        Visibility="{Binding IsCustomizing, Converter={StaticResource BoolToVis}}"
                        ToolTip="بازگشت به چیدمان پیش‌فرض">
                    <materialDesign:PackIcon Kind="Restore" Width="15" Height="15" />
                </Button>
            </DockPanel>

            <!-- نوار خوش‌آمد -->
            <Border Background="#E3F2FD" CornerRadius="10" Padding="14,8" Margin="0,0,0,12">
                <DockPanel>
                    <materialDesign:PackIcon Kind="LightbulbOn"
                                             Width="20" Height="20"
                                             Foreground="#1565C0"
                                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding WelcomeMessage}"
                               Foreground="#1565C0" FontSize="12"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- ═══ چرخهٔ سی‌ونه‌م (گزارش مالک) — پنل میانبرهای سریع شخصی ═══
                 «میخوام در داشبورد… دکمه‌های میانبر برای قسمت‌های مختلف رو داخلش
                 ایجاد بکنم که در هنگام نیاز، داخل منو و صفحات دنبالشون نگردم و
                 با کلیک بر روی اون دکمه مستقیم اون فرم باز بشه… برای هر کاربر
                 مختص خودش ذخیره بشه» — کاشی‌های گوشه‌گرد با آیکون و رنگ چرخه‌ای؛
                 حالت ویرایش دکمهٔ حذف هر کاشی را نمایان می‌کند؛ ذخیره خودکار در
                 پایان ویرایش، در فایل محلی مختص کاربر واردشده. -->
            <Border Background="#F5F7FB" CornerRadius="12" Padding="14,10" Margin="0,0,0,12"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <!-- سربرگ پنل + دکمه‌های مدیریت -->
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LightningBolt" Width="20" Height="20"
                                                     Foreground="#F57C00" VerticalAlignment="Center" />
                            <TextBlock Text="میانبرهای سریع من" FontSize="14.5" FontWeight="Bold"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                            <!-- ═══ چرخهٔ ۴۷ (گزارش مالک: «دکمه‌های میانبر ناقص
                                 هستند و آیکون و عنوان مشخص نیست») — نشان نسخهٔ
                                 تشخیصی روی خود داشبورد ═══
                                 تحلیل پیکسلی تصویر مالک نشان داد رندر ایستگاه با
                                 XAML های چرخهٔ ۴۴ و قدیمی‌تر است (کاشی ~۳۳px و توستِ
                                 بدون حاشیهٔ ۶۴px چرخهٔ ۴۳) در حالی که نسخهٔ نصب‌شده
                                 «به‌روز» اعلام شده — یعنی فایل‌های UI جدید هرگز به
                                 بیلد نرسیده‌اند (کش BAML/جایگزینی‌نشدن فایل). این نشان
                                 روی خودِ صفحهٔ داشبورد می‌نشیند تا در یک نگاه روشن
                                 شود بیلدِ در حال اجرا تازه است یا کهنه: اگر پس از
                                 آپدیت این نشان نبود، ایستگاه باید Clean + Rebuild شود
                                 (همان راهنمای داخل بستهٔ آپدیت). -->
                            <Border CornerRadius="9" Padding="8,2" Margin="10,0,0,0"
                                    Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1"
                                    VerticalAlignment="Center"
                                    ToolTip="نسخهٔ بیلدِ در حال اجرا — پس از نصب هر بستهٔ آپدیت باید با نسخهٔ همان بسته یکی باشد؛ اگر نبود، فایل‌های جدید جایگزین نشده‌اند و باید Clean + Rebuild انجام شود">
                                <TextBlock Text="{x:Static helpers:AppInfo.VersionText}"
                                           FontSize="10" Foreground="#1565C0"
                                           FontFamily="{DynamicResource App.CodeFont}" />
                            </Border>
                        </StackPanel>
                        <!-- ═══ چرخهٔ ۴۵ (گزارش مالک) — دکمه‌های مدیریتیِ کاملاً گرد ═══
                             «دکمه میانبر جدید در داشبورد رو همانند دکمه حالت ویرایش بکن
                             که گرد باشه و فقط آیکون باشه تا زیباتر دیده بشه» — هر دو
                             دکمه حالا با قالب دایرهٔ کامل ۳۶px خودِ این پنل رندر می‌شوند
                             (استایل‌های متریال گوشهٔ کم‌گرد می‌دادند نه دایرهٔ کامل):
                             افزودن = دایرهٔ توپر نارنجی با آیکون سفید (کانون توجه)؛
                             ویرایش = دایرهٔ کم‌رنگ که در حالت فعال با رنگ اصلی پر می‌شود؛
                             هر دو Focusable=False و ClickMode=Press تا در هر بافتی پاسخگو
                             باشند (الگوی چرخهٔ ۴۴). -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <!-- افزودن — دایرهٔ توپر نارنجی؛ فقط-آیکون -->
                            <Button Command="{Binding AddShortcutCommand}"
                                    Width="36" Height="36" Padding="0" Margin="0,0,8,0"
                                    Cursor="Hand" Focusable="False" ClickMode="Press"
                                    ToolTip="میانبر جدید — افزودن صفحهٔ دلخواه به این پنل">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="AddCircle" Width="36" Height="36" CornerRadius="18"
                                                Background="#F57C00">
                                            <materialDesign:PackIcon Kind="Plus" Width="17" Height="17"
                                                                     Foreground="White"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="AddCircle" Property="Opacity" Value="0.85" />
                                                <Setter TargetName="AddCircle" Property="Background" Value="#FB8C00" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="AddCircle" Property="Opacity" Value="0.7" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- ویرایش — دایرهٔ کم‌رنگ؛ فعال = توپرِ رنگ اصلی؛ پایان خودکارِ حالت = ذخیره -->
                            <ToggleButton IsChecked="{Binding IsEditingShortcuts}"
                                          Width="36" Height="36" Padding="0"
                                          Cursor="Hand" Focusable="False" ClickMode="Press"
                                          ToolTip="حالت ویرایش — دکمهٔ حذف روی هر کاشی نمایان می‌شود؛ با پایان ویرایش، تغییرات ذخیره می‌شوند">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="EditCircle" Width="36" Height="36" CornerRadius="18"
                                                Background="Transparent"
                                                BorderBrush="#B0BEC5" BorderThickness="1.6">
                                            <materialDesign:PackIcon x:Name="EditIcon" Kind="PencilOutline" Width="15" Height="15"
                                                                     Foreground="#78909C"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="EditCircle" Property="BorderBrush"
                                                        Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                                <Setter TargetName="EditCircle" Property="Background"
                                                        Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                                <Setter TargetName="EditIcon" Property="Foreground" Value="White" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="EditCircle" Property="Opacity" Value="0.8" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </StackPanel>
                    </DockPanel>

                    <!-- حالت خالی — دعوت به افزودن نخستین میانبر -->
                    <TextBlock FontSize="12" Opacity="0.7" Margin="4,2,4,4" TextWrapping="Wrap"
                               Text="هنوز میانبری نساخته‌اید — صفحات پرکاربرد خود را با «میانبر جدید» به این پنل اضافه کنید تا بدون گشتن در منو، با یک کلیک باز شوند."
                               Visibility="{Binding HasShortcuts, Converter={StaticResource InverseBoolToVisibility}}" />

                    <!-- ═══ کاشی‌های میانبر — چرخهٔ ۴۳ بازطراحی (گزارش مالک:
                         «ظاهر دکمه‌های میانبر رو زیباتر بکن… دکمه‌های میانبر رو وسط
                         چین بکن») ═══ بازطراحی مقاوم چرخهٔ ۴۵ (کاشی ~۳۱px با آیکون
                         ناقص و بدون عنوان) و ═══ ارزیابی حساب‌شدهٔ چرخهٔ ۴۶ (گزارش
                         مالک: «دکمه‌های میانبر و توست هیچ فرقی نکرده‌اند») ═══
                         ریشهٔ باقی‌ماندهٔ بریدگی: حساب ارتفاعِ چرخهٔ ۴۵ کافی نبود —
                         آیکون ۴۴ + فاصله ۷ + متن دوسطری ~۳۰ + حاشیهٔ عمودی ۲۲ =
                         ~۱۰۳px ولی دیوار کف فقط ۹۶ بود ⇒ هر عنوان دوسطری هنوز
                         در مرز می‌شکست و «عنوان مشخص نیست» باقی می‌ماند.
                         رفع حساب‌شدهٔ چرخهٔ ۴۶: کف ۱۱۰px (۷px حاشیهٔ اطمینان)،
                         MaxHeight متن حذف (MaxLines=2 جایگزین — برش تخت ناپدید)،
                         و حذف کامل هر افکت/انیمیشنی که محتوا را به مرز چیدمان
                         می‌راند. قواعد ۴۵ (بدون سایه/دیوار کف/هاور بی‌استوری‌بورد)
                         همگی برقرار ماندند. -->
                    <!-- ═══ چرخهٔ ۴۷ — ارتفاع قطعی کاشی ═══
                         «دکمه‌های میانبر ناقص هستند و آیکون و عنوان مشخص نیست» —
                         تجربهٔ چرخه‌های ۴۵/۴۶ نشان داد «کف ارتفاع» (MinHeight) در
                         برابر فشردگی‌های چیدمانیِ نامعمولِ ایستگاه‌های خاص کافی
                         نیست؛ ارتفاعِ قطعی (Height) روی هر دو لایهٔ گرید و قالب
                         تعیین می‌شود تا هیچ سنجه‌ای نتواند کاشی را له کند. هیچ
                         افکت سایه‌ای هم روی کاشی نیست (سازوکار بریدن مرز — درس
                         چرخهٔ ۴۵). -->
                    <ItemsControl ItemsSource="{Binding Shortcuts}"
                                  HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5,5,5,7" Width="120" Height="116">
                                    <!-- کاشی اصلی — کلیک = ناوبری مستقیم -->
                                    <Button Command="{Binding DataContext.OpenShortcutCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand" Focusable="False"
                                            ToolTip="{Binding Title, StringFormat=باز کردن {0}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <!-- چرخهٔ ۴۷: Height قطعی (نه فقط کف) —
                                                     ارتفاع ثابت ۱۱۶px روی قالب؛ محتوا
                                                     (آیکون ۴۴ + فاصله ۷ + متن دوسطری ۳۴ +
                                                     حاشیهٔ عمودی ۲۲ = ۱۰۷) با ۹px اطمینان جا
                                                     می‌شود و هیچ چیدمانی نمی‌تواند آن را فشرده کند -->
                                                <Border x:Name="Tile"
                                                        CornerRadius="14" Background="#FFFFFF"
                                                        BorderBrush="#D9E2EC" BorderThickness="1.4"
                                                        Padding="0,12,0,10"
                                                        Height="116"
                                                        UseLayoutRounding="True"
                                                        SnapsToDevicePixels="True">
                                                    <!-- ═══ چرخهٔ ۴۵: بدون DropShadowEffect — افکت،
                                                         محتوای سرریز از قالب چیدمان را در مرز می‌بُرید
                                                         (ریشهٔ «آیکون ناقص و عنوان ناموجود» در تصویر مالک).
                                                         چرخهٔ ۴۶: ارتفاع محتوا حساب شد — کف ۱۱۰px مازادِ ۷px
                                                         روی نیاز واقعی (~۱۰۳px) دارد تا هیچ فونت/مقیاسی
                                                         عنوان را در مرز نچپاند. ═══ -->
                                                    <StackPanel HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                        <!-- دایرهٔ آیکون — توپر با رنگ تأکیدی کاشی -->
                                                        <Border Width="44" Height="44" CornerRadius="22"
                                                                Background="{Binding Accent, Converter={StaticResource HexToBrush}}"
                                                                HorizontalAlignment="Center" Margin="0,0,0,7">
                                                            <!-- چرخهٔ ۴۷: گارد اتصال — میانبرِ
                                                                 ذخیره‌شدهٔ کهنه با کلید حذف‌شده نباید
                                                                 آیکون تهی بدهد؛ ViewDashboard پیش‌فرض -->
                                                            <materialDesign:PackIcon Kind="{Binding Icon, TargetNullValue=ViewDashboard, FallbackValue=ViewDashboard}" Width="22" Height="22"
                                                                                     Foreground="White"
                                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <!-- چرخهٔ ۴۶: MaxHeight=30 حذف شد (خط دوم عنوان را
                                                             برش می‌داد) — سقف حساب‌شدهٔ ۳۴px = دو سطر کامل
                                                             ۱۵px؛ ۴۴+۷+۳۴+۲۲=۱۰۷ ≤ کفِ ۱۱۰px کاشی ⇒ هیچ
                                                             سرریزی در مرز نمی‌ماند -->
                                                        <!-- چرخهٔ ۴۷: گارد اتصال عنوان — تهی
                                                             یعنی «بدون عنوان» نه کاشی بی‌متن -->
                                                        <TextBlock Text="{Binding Title, TargetNullValue=بدون عنوان, FallbackValue=بدون عنوان}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="#1F2937" Margin="6,0,6,0"
                                                                   HorizontalAlignment="Center" TextAlignment="Center"
                                                                   TextWrapping="Wrap" MaxHeight="34" MaxWidth="106"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <!-- هاور: حاشیهٔ رنگ تأکیدی کاشی + ته‌رنگ سرد -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Tile" Property="BorderBrush"
                                                                Value="{Binding Accent, Converter={StaticResource HexToBrush}}" />
                                                        <Setter TargetName="Tile" Property="Background" Value="#FDFEFF" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Tile" Property="Opacity" Value="0.88" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- دکمهٔ حذف گوشه — فقط در حالت ویرایش (روی کاشی، مستقل از کلیک اصلی) -->
                                    <Button Command="{Binding DataContext.RemoveShortcutCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource App.RowIconButton}"
                                            Width="24" Height="24" Padding="0"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="0,-6,-6,0"
                                            Background="#FFEBEE" Foreground="#C62828"
                                            ToolTip="حذف این میانبر"
                                            Visibility="{Binding DataContext.IsEditingShortcuts, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                                        <materialDesign:PackIcon Kind="Close" Width="13" Height="13" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ═══ چرخه دوازدهم: کارت پیام‌های پشتیبانی — پیام‌های مستقیم پنل لایسنس ═══
                 ═══ چرخهٔ سی‌وپنجم (گزارش مالک) ═══ رنگ کادر از EffectiveBrush (انتخاب پنل)
                 ═══ چرخهٔ سی‌وهفتم (گزارش مالک — سه اصلاح) ═══
                 ۱) «تاریخ زیر عنوان میلادی بود» — تجزیهٔ سه‌مرحله‌ای DateFa در DTO
                    (تاریخ خالص، تاریخ+ساعت، برشِ بخش نخست) همهٔ قالب‌های پنل را شمسی می‌کند
                 ۲) «تاریخ باید به‌صورت بج در گوشهٔ بالا و چپ کادر پیام باشد» — بجِ
                    چیپیِ هم‌رنگ کادر؛ جای‌گذاری نهایی در چرخهٔ ۳۹ با گرید دوسطونه
                    انجام شد (ستون آخر RTL = لبهٔ فیزیکی چپ) — کامنت درون قالب
                 ۳) «رنگ کادر با انتخاب پنل یکی است ولی تیره است» — پس‌زمینه از «soft»
                    (۱۴٪ آلفا — وابسته به پس‌زمینهٔ پشت) به «tint» (ترکیب کدر با سفید،
                    همیشه روشن) تغییر کرد؛ حاشیهٔ بالایی رنگ تأکید می‌ماند -->
            <ItemsControl ItemsSource="{Binding SupportMessages}"
                          Visibility="{Binding HasSupportMessages, Converter={StaticResource BoolToVis}}"
                          Margin="0,0,0,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="10" Padding="14,10" Margin="0,0,0,8"
                                BorderThickness="0,3,0,0">
                            <!-- رنگ کادر از سرور لایسنس: پس‌زمینهٔ روشنِ ثابت (tint) +
                                 حاشیهٔ بالاییِ توپر همان رنگ؛ در نبود رنگ سرور، رنگ سطح اهمیت -->
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background"
                                            Value="{Binding EffectiveBrush, Converter={StaticResource HexBrush}, ConverterParameter=tint}" />
                                    <Setter Property="BorderBrush"
                                            Value="{Binding EffectiveBrush, Converter={StaticResource HexBrush}}" />
                                </Style>
                            </Border.Style>
                            <!-- ═══ چرخهٔ چهلم (رفع خطای بیلد MC3089) ═══ Border فقط یک فرزند
                                 محتوایی می‌پذیرد؛ گرید سربرگ (عنوان + بج تاریخ) و متن پیام دو
                                 فرزند مستقل بودند ⇒ «The object 'Border' already has a child
                                 and cannot add 'TextBlock'». هر دو داخل StackPanel عمودی
                                 قرار گرفتند تا سربرگ و متن پشت سر هم و مرتب دیده شوند. -->
                            <StackPanel>
                            <!-- ═══ چرخهٔ سی‌ونه‌م (گزارش مالک) — جای بج تاریخ ═══
                                 «تاریخ رو گفته بودم در گوشه بالا و چپ کادر پیام قرار
                                 بگیره ولی در سمت راست و بالای عنوان هست» — ریشه:
                                 HorizontalAlignment در WPF «نسبت به جریان» است نه لبهٔ
                                 فیزیکی؛ در ظرف RTL مقدار Left به لبهٔ فیزیکی «راست»
                                 می‌نشیند (همان دلیلی که چرخهٔ ۳۷ تصور می‌کرد Left =
                                 چپ فیزیکی ولی روی صفحه راست افتاد). رفع قطعی: سربرگ
                                 کارت به گرید دوسطونه تبدیل شد — ستونِ نخستِ RTL از
                                 راست شروع می‌شود (عنوان) و ستونِ آخرِ RTL به لبهٔ
                                 فیزیکی «چپ» می‌رسد (بج تاریخ)؛ یعنی تاریخ دقیقاً در
                                 گوشهٔ بالا-چپ کادر و هم‌ردیف عنوان می‌نشیند و دیگر
                                 ردیف مجزایی اشغال نمی‌کند. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- ستون عنوان — در RTL سمت راست کارت -->
                                    <ColumnDefinition Width="*" />
                                    <!-- ستون بج تاریخ — در RTL لبهٔ فیزیکی چپ (گوشهٔ بالا-چپ) -->
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- ردیف عنوان: آیکون سطح + عنوان پیام (راست) -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                            Margin="0,0,12,0">
                                    <TextBlock Text="{Binding LevelIcon}" FontSize="15"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold"
                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- بج تاریخ ارسال — گوشهٔ بالا-چپ کادر؛ چیپِ هم‌رنگ کادر
                                     (پس‌زمینهٔ tint + متن و حاشیهٔ رنگ تأکید) تا در هر رنگی
                                     خوانا بماند؛ تاریخ شمسی/ارقام‌فارسی از DateFa -->
                                <Border Grid.Column="1"
                                        VerticalAlignment="Center"
                                        CornerRadius="9" Padding="9,2.5"
                                        Background="{Binding EffectiveBrush, Converter={StaticResource HexBrush}, ConverterParameter=tint}"
                                        BorderBrush="{Binding EffectiveBrush, Converter={StaticResource HexBrush}}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding DateFa, Mode=OneWay}" FontSize="9.5"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding EffectiveBrush, Converter={StaticResource HexBrush}}"
                                               FontFamily="{DynamicResource App.CodeFont}" />
                                </Border>
                            </Grid>
                            <!-- متن پیام -->
                            <TextBlock Text="{Binding Body}" FontSize="12" Margin="0,5,0,0"
                                       Opacity="0.85" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═══ چرخهٔ ۴۴ (گزارش مالک: «مدیریت داشبورد رو حرفه‌ای‌تر بکن») —
                 نوار مدیریت چرخهٔ شخصی‌سازی: به‌جای کادر زرد ساده با چک‌باکس‌های
                 خام، نوار راهنمای ساختاریافته: عنوان راهنما + چیپ‌های نمایش/پنهان
                 بخش‌ها (سوییچ متریال) + یادآوری ذخیرهٔ خودکار؛ فقط در حالت تنظیم -->
            <Border CornerRadius="12" Padding="14,10" Margin="0,0,0,12"
                    Visibility="{Binding IsCustomizing, Converter={StaticResource BoolToVis}}"
                    BorderThickness="1,3.5,1,1" BorderBrush="#F9A825">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFDF5" Offset="0" />
                        <GradientStop Color="#FFF8E1" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.12" Color="#8D6E00" />
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <materialDesign:PackIcon DockPanel.Dock="Right" Kind="TuneVertical" Width="18" Height="18"
                                                 Foreground="#E65100" VerticalAlignment="Center" />
                        <TextBlock Text="حالت مدیریت چیدمان — تغییرات به‌صورت خودکار ذخیره می‌شوند"
                                   FontWeight="Bold" FontSize="13" Foreground="#E65100" Margin="2,0,8,0"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <WrapPanel>
                        <!-- چیپ‌های نمایش بخش‌ها — سوییچ‌های هم‌خانوادهٔ فرم‌ها -->
                        <StackPanel Orientation="Horizontal" Margin="0,3,14,3">
                            <TextBlock Text="کارت‌های فرعی" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ToggleButton IsChecked="{Binding ShowSecondaryCards}"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}" Padding="2,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,14,3">
                            <TextBlock Text="نمودار درآمد" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ToggleButton IsChecked="{Binding ShowRevenueChart}"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}" Padding="2,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,14,3">
                            <TextBlock Text="نوبت‌های پیش‌رو" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ToggleButton IsChecked="{Binding ShowUpcoming}"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}" Padding="2,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,14,3">
                            <TextBlock Text="فعالیت‌های اخیر" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ToggleButton IsChecked="{Binding ShowActivities}"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}" Padding="2,0" />
                        </StackPanel>
                        <TextBlock Text="با دکمه‌های ⬆⬇ روی کارت‌های آمار، ترتیب‌شان را جابه‌جا کنید و با سوییچ کنارشان پنهان‌شان کنید"
                                   FontSize="10" Opacity="0.6" VerticalAlignment="Center" Margin="0,3,0,3" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ردیف ۱: کارت‌های آمار اصلی — داینامیک با ترتیب قابل جابه‌جایی (چرخه ۱۳) -->
            <ItemsControl ItemsSource="{Binding MainCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,8,0">
                            <!-- کارت آمار -->
                            <controls:StatCard IconKind="{Binding IconKind, Mode=OneWay}"
                                               Value="{Binding Value, Mode=OneWay}"
                                               Label="{Binding Label, Mode=OneWay}"
                                               CompareText="{Binding CompareText, Mode=OneWay}"
                                               AccentBrush="{Binding Accent, Mode=OneWay}"
                                               Visibility="{Binding Visible, Converter={StaticResource BoolToVis}}" />
                            <!-- کنترل‌های چیدمان — فقط در حالت شخصی‌سازی -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="4,2,0,0"
                                        Visibility="{Binding DataContext.IsCustomizing, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}">
                                <Button Command="{Binding DataContext.MoveCardUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}" Padding="3,1" ToolTip="جابه‌جایی به قبل">
                                    <materialDesign:PackIcon Kind="ChevronUp" Width="12" Height="12" />
                                </Button>
                                <Button Command="{Binding DataContext.MoveCardDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}" Padding="3,1" ToolTip="جابه‌جایی به بعد">
                                    <materialDesign:PackIcon Kind="ChevronDown" Width="12" Height="12" />
                                </Button>
                                <ToggleButton IsChecked="{Binding Visible}" Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              Padding="2,0" ToolTip="نمایش/پنهان این کارت" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ردیف ۲: سه کارت فرعی — نمایش قابل تنظیم (چرخه ۱۳) -->
            <UniformGrid Columns="3" Rows="1"
                         Visibility="{Binding ShowSecondaryCards, Converter={StaticResource BoolToVis}}">
                <controls:StatCard IconKind="AlertCircle"
                                   Value="{Binding LowStockCount, Mode=OneWay}"
                                   Label="موجودی کم دارو"
                                   CompareText="اقلام زیر حداقل موجودی"
                                   AccentBrush="#E53935" />
                <controls:StatCard IconKind="Prescription"
                                   Value="{Binding PendingLabOrders, Mode=OneWay}"
                                   Label="آزمایش در انتظار"
                                   CompareText="درخواست‌های بدون نتیجه"
                                   AccentBrush="#1E88E5" />
                <controls:StatCard IconKind="CalendarMonth"
                                   Value="{Binding TodayPatients, Mode=OneWay}"
                                   Label="نوبت‌های امروز"
                                   CompareText="شامل همه وضعیت‌ها به‌جز لغو"
                                   AccentBrush="#5C6BC0" />
            </UniformGrid>

            <!-- ردیف ۳: نمودار درآمد (۲fr) + نوبت‌های پیش‌رو (۱fr) — نمایش قابل تنظیم (چرخه ۱۳) -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" SharedSizeGroup="A" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- کارت نمودار درآمد ۷ روز -->
                <materialDesign:Card Grid.Column="0" UniformCornerRadius="14" Padding="16"
                                     Visibility="{Binding ShowRevenueChart, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                            <TextBlock Text="روند درآمد ۷ روز اخیر"
                                       FontSize="14" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <TextBlock FontSize="10" Opacity="0.5"
                                       VerticalAlignment="Bottom"
                                       Margin="6,0,0,2"><Run Text="(" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock>
                        </DockPanel>

                        <TextBlock Grid.Row="1" Text="{Binding ConnectionStatus}"
                                   FontSize="10" Opacity="0.6" Margin="0,0,0,8" />

                        <!-- نمودار سطحی — نوع درست برای روند زمانی (چرخه یازدهم) -->
                        <charts:AreaChart Grid.Row="2"
                                          Points="{Binding RevenueChart}"
                                          ValueFormat="N0" />
                    </Grid>
                </materialDesign:Card>

                <!-- کارت نوبت‌های پیش‌رو — نمایش قابل تنظیم (چرخه ۱۳) -->
                <materialDesign:Card Grid.Column="2" UniformCornerRadius="14" Padding="12"
                                     Visibility="{Binding ShowUpcoming, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="4,0,4,6">
                            <materialDesign:PackIcon Kind="ClockFast"
                                                     Width="18" Height="18"
                                                     VerticalAlignment="Center" />
                            <TextBlock Text="نوبت‌های پیش‌رو"
                                       FontSize="13" FontWeight="Bold"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding UpcomingAppointments}"
                                 ItemTemplate="{StaticResource AppointmentItemTemplate}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                        <controls:EmptyState Grid.Row="1"
                                             Message="امروز نوبتی ثبت نشده است"
                                             IconKind="CalendarBlank"
                                             Visibility="{Binding UpcomingAppointments.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" />
                    </Grid>
                </materialDesign:Card>
            </Grid>

            <!-- ردیف ۴: فعالیت‌های اخیر — نمایش قابل تنظیم (چرخه ۱۳) -->
            <materialDesign:Card UniformCornerRadius="14" Padding="16" Margin="0,14,0,4"
                                 Visibility="{Binding ShowActivities, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <materialDesign:PackIcon Kind="History"
                                                 Width="18" Height="18"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="فعالیت‌های اخیر"
                                   FontSize="13" FontWeight="Bold"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding RecentActivities}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              MinHeight="120"
                              MaxHeight="220"
                              FontSize="11">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="زمان"
                                                Binding="{Binding TimeShamsi, Converter={StaticResource PersianDigits}}"
                                                Width="140" />
                            <DataGridTextColumn Header="کاربر"
                                                Binding="{Binding User, Converter={StaticResource PersianDigits}}"
                                                Width="120" />
                            <DataGridTextColumn Header="عملیات"
                                                Binding="{Binding Action, Converter={StaticResource PersianDigits}}"
                                                Width="110" />
                            <DataGridTextColumn Header="موجودیت"
                                                Binding="{Binding Entity, Converter={StaticResource PersianDigits}}"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>

            <!-- پیام خطا در نبود سرور -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                       TextWrapping="Wrap" Margin="4,12,4,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
