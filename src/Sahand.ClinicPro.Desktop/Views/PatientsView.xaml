<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.PatientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="900"
             FlowDirection="RightToLeft">
    <!-- ═══════════════════════════════════════════════════════════
         فهرست بیماران — گام U2 طبق پرامپت UI بخش ۱ (فرم ۳):
         نوار عنوان با Badge تعداد + نوار ابزار + ۹ ستون DataGrid +
         منوی راست‌کلیک + دابل‌کلیک + PaginationBar + EmptyState
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- نوار عنوان صفحه — با Badge تعداد -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="AccountGroup"
                                         Width="26" Height="26"
                                         Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                         VerticalAlignment="Center" />
                <TextBlock Text="لیست بیماران"
                           FontSize="20" FontWeight="Bold"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
                <Border Background="{DynamicResource MaterialDesign.Brush.Primary}"
                        CornerRadius="10" Padding="10,2" VerticalAlignment="Center"
                        Margin="12,0,0,0">
                    <TextBlock Foreground="White" FontSize="11">
                        <Run Text="کل: " /><Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" نفر" />
                    </TextBlock>
                </Border>
            </StackPanel>
            <TextBlock Text="مدیریت و جستجوی بیماران ثبت‌شده در سامانه"
                       FontSize="12" Opacity="0.65" Margin="2,4,0,0" />
        </StackPanel>

        <!-- نوار ابزار -->
        <Border Grid.Row="1"
                Background="{DynamicResource MaterialDesign.Brush.Background}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                BorderThickness="1" CornerRadius="10"
                Padding="10,8" Margin="0,0,0,10">
            <DockPanel>
                <!-- راست: دکمه‌های عملیات -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding AddPatientCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            ToolTip="ثبت بیمار جدید (F3)" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="بیمار جدید" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            ToolTip="بارگذاری مجدد (F5)" Margin="0,0,8,0">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" />
                    </Button>
                    <Button Command="{Binding DeletePatientCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            ToolTip="حذف بیمار انتخاب‌شده"
                            Foreground="#C62828" Padding="8,6">
                        <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" />
                    </Button>
                </StackPanel>

                <!-- چپ: جستجو با آیکون -->
                <TextBox materialDesign:HintAssist.Hint="🔍 جستجو با نام، کد ملی، موبایل…"
                         Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="13"
                         VerticalAlignment="Center"
                         MinWidth="260">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </Border>

        <!-- نوار انتظار -->
        <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="3"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                     Margin="0,0,0,6" />

        <!-- جدول اطلاعات — ۹ ستون طبق مشخصات -->
        <DataGrid Grid.Row="3"
                  x:Name="PatientsGrid"
                  ItemsSource="{Binding Patients}"
                  SelectedItem="{Binding SelectedPatient}"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  AlternatingRowBackground="#F7FAFD"
                  HeadersVisibility="Column"
                  MouseDoubleClick="OnRowDoubleClick"
                  RowBackground="Transparent"
                  FontSize="12">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="👁️ مشاهده جزئیات" Command="{Binding ViewPatientCommand}" />
                                <MenuItem Header="✏️ ویرایش" Command="{Binding EditPatientCommand}" />
                                <MenuItem Header="📅 رزرو نوبت" Command="{Binding BookAppointmentCommand}" />
                                <Separator />
                                <MenuItem Header="🗑️ حذف" Command="{Binding DeletePatientCommand}" Foreground="#C62828" />
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <!-- چرخه بیست‌ویکم (گزارش پانزدهم مالک): عرض ستون‌ها بر اساس محتوا + عنوان
                     (Auto با MinWidth) و ستون نام برای پرکردن فضای باقی‌مانده (*) -->
                <!-- ۱. انتخاب چندتایی -->
                <DataGridCheckBoxColumn Header=""
                                        Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                        Width="Auto" MinWidth="36" />

                <!-- ۲. شماره پرونده -->
                <DataGridTextColumn Header="پرونده"
                                    Binding="{Binding MedicalRecordNo, Converter={StaticResource PersianDigits}}"
                                    Width="Auto" MinWidth="90"
                                    FontFamily="{DynamicResource App.CodeFont}"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />

                <!-- ۳. نام و نام‌خانوادگی — ستون کشسان برای پرکردن عرض جدول -->
                <DataGridTemplateColumn Header="نام و نام‌خانوادگی" Width="*" MinWidth="170" SortMemberPath="FullName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Account"
                                                         Width="15" Height="15"
                                                         Opacity="0.55"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding FullName}"
                                           FontWeight="SemiBold"
                                           Margin="7,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ۴. کد ملی -->
                <DataGridTextColumn Header="کد ملی"
                                    Binding="{Binding NationalCode, Converter={StaticResource PersianDigits}}"
                                    Width="Auto" MinWidth="105"
                                    FontFamily="{DynamicResource App.CodeFont}" />

                <!-- ۵. موبایل -->
                <DataGridTextColumn Header="موبایل"
                                    Binding="{Binding Mobile, Converter={StaticResource PersianDigits}}"
                                    Width="Auto" MinWidth="110"
                                    FontFamily="{DynamicResource App.CodeFont}" />

                <!-- ۶. بیمه — Badge رنگی ═══ چرخهٔ بیست‌وهشتم (گزارش هجدهم
                     مالک): «همهٔ بیمه‌ها با یک رنگ نشان داده می‌شوند» — چهار
                     DataTrigger ثابت فقط بیمه‌های پیش‌فرض را رنگ می‌داد و هر
                     بیمهٔ سفارشیِ درمانگاه خاکستری می‌ماند؛ اکنون مبدل پالت
                     پایدار «هر» بیمه را رنگ متمایز می‌دهد (بیمه‌های شناخته‌شده
                     رنگ همیشگی خودشان، بیمه‌های سفارشی از هش نام) ═══ -->
                <DataGridTemplateColumn Header="بیمه" Width="Auto" MinWidth="90" SortMemberPath="InsuranceName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="9,2" HorizontalAlignment="Center"
                                    Background="{Binding InsuranceName, TargetNullValue=آزاد, Converter={StaticResource InsuranceBrush}}">
                                <TextBlock Text="{Binding InsuranceName, TargetNullValue=آزاد}"
                                           FontSize="11" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ۷. سن -->
                <DataGridTextColumn Header="سن"
                                    Binding="{Binding Age, TargetNullValue=—, Converter={StaticResource PersianDigits}}"
                                    Width="Auto" MinWidth="45">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- ۸. آخرین مراجعه (شمسی از سرور) -->
                <DataGridTextColumn Header="آخرین مراجعه"
                                    Binding="{Binding LastVisitDateShamsi, TargetNullValue=—, Converter={StaticResource PersianDigits}}"
                                    Width="Auto" MinWidth="100" />

                <!-- ۹. عملیات — چرخه بیست‌ویکم: عرض کشسان بر اساس دکمه‌ها +
                     سبک فشردهٔ App.RowIconButton تا هیچ دکمه‌ای بریده نشود -->
                <DataGridTemplateColumn Header="عملیات" Width="Auto" MinWidth="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Command="{Binding DataContext.ViewPatientCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource App.RowIconButton}"
                                        ToolTip="مشاهده جزئیات بیمار">
                                    <materialDesign:PackIcon Kind="EyeOutline" Width="16" Height="16" />
                                </Button>
                                <Button Command="{Binding DataContext.EditPatientCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource App.RowIconButton}"
                                        ToolTip="ویرایش اطلاعات بیمار">
                                    <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" />
                                </Button>
                                <Button Command="{Binding DataContext.BookAppointmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource App.RowIconButton}"
                                        ToolTip="رزرو نوبت برای این بیمار">
                                    <materialDesign:PackIcon Kind="CalendarPlus" Width="16" Height="16" />
                                </Button>
                                <Button Command="{Binding DataContext.DeletePatientCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource App.RowIconButton}"
                                        ToolTip="حذف بیمار"
                                        Foreground="#C62828">
                                    <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- حالت خالی -->
        <controls:EmptyState Grid.Row="3"
                             Message="موردی یافت نشد — با تغییر عبارت جستجو دوباره تلاش کنید"
                             IconKind="AccountSearch"
                             Visibility="{Binding Patients.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" />

        <!-- صفحه‌بندی سروری -->
        <controls:PaginationBar Grid.Row="4"
                                PageNumber="{Binding PageNumber, Mode=TwoWay}"
                                TotalPages="{Binding TotalPages, Mode=OneWay}"
                                TotalCount="{Binding TotalCount, Mode=OneWay}"
                                PageSize="{Binding PageSize, Mode=TwoWay}"
                                PageChangedCommand="{Binding PageChangedCommand}" />
    </Grid>
</UserControl>
