<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.OphthalmologyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1080"
             FlowDirection="RightToLeft">
    <!-- ═══ چشم‌پزشکی — چرخهٔ چهل‌وسوم (گزارش مالک): «دندانپزشکی و چشم پزشکی و
         تصویربرداری و فزیوتراپی در یک صفحه و تب‌های جداگانه هستند. برای هر
         کدوم یک صفحه مستقل طراحی بکن تا با همدیگه تداخلی نداشته باشن» —
         محتوای این تب از پاراکلینیکِ سابقِ تب‌دار جدا شد و اکنون صفحهٔ
         اختصاصی مستقل خودش است؛ تمام منطق و اتصال‌ها بدون تغییر منتقل شدند. ═══ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <materialDesign:PackIcon Kind="EyeCircle" Width="26" Height="26"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
            <TextBlock Text="چشم‌پزشکی" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- محتوای صفحه — عیناً از تب پاراکلینیک سابق (اتصال‌ها بدون تغییر) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                            <StackPanel>
                                <!-- ═══ نوار بیمار تب چشم — چرخهٔ بیست‌وهشتم (گزارش هجدهم مالک):
                                     پیش‌تر این تب بیمار خودش را نداشت و باید بیمار در تب
                                     فیزیوتراپی/تصویربرداری جستجو می‌شد؛ اکنون معاینه و سابقه
                                     به پروندهٔ همین بیمار وصل است ═══ -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.4*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding EyePatientSearch, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="🔍 بیمار چشم‌پزشکی — کد ملی / موبایل / نام">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SearchEyePatientCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="1" Command="{Binding SearchEyePatientCommand}" Margin="8,0,0,0"
                                            Style="{StaticResource MaterialDesignRaisedButton}" Padding="12,4">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Magnify" Width="15" Height="15" VerticalAlignment="Center" />
                                            <TextBlock Text="جستجو" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <!-- کارت بیمار — معاینه در پروندهٔ همین بیمار ثبت می‌شود -->
                                    <Border Grid.Column="2" Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1"
                                            CornerRadius="8" Padding="10,5" Margin="8,0,8,0"
                                            Visibility="{Binding EyePatient, Converter={StaticResource NullToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AccountCheck" Width="16" Height="16" Foreground="#2E7D32" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding EyePatient.FullName, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding EyePatient.NationalCode, Mode=OneWay}" Opacity="0.7" FontSize="11"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Button Grid.Column="3" Command="{Binding ClearEyePatientCommand}"
                                            Style="{StaticResource MaterialDesignFlatButton}" Padding="8,4" ToolTip="بستن پرونده و بیمار بعدی"
                                            Visibility="{Binding EyePatient, Converter={StaticResource NullToVisibility}}">
                                        <materialDesign:PackIcon Kind="CloseCircleOutline" Width="18" Height="18" Foreground="#C62828" />
                                    </Button>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- OD -->
                                    <Border Grid.Column="0" CornerRadius="12" Padding="14" Background="#E3F2FD">
                                        <StackPanel>
                                            <TextBlock Text="چشم راست (OD)" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                                            <UniformGrid Columns="2">
                                                <StackPanel Margin="0,0,6,6"><TextBlock Text="Sphere" FontSize="10.5" Opacity="0.6" /><TextBox Text="{Binding OdSphere, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" /></StackPanel>
                                                <StackPanel Margin="0,0,0,6"><TextBlock Text="Cylinder" FontSize="10.5" Opacity="0.6" /><TextBox Text="{Binding OdCylinder, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" /></StackPanel>
                                                <StackPanel Margin="0,0,6,0"><TextBlock Text="Axis" FontSize="10.5" Opacity="0.6" /><TextBox Text="{Binding OdAxis, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" /></StackPanel>
                                                <StackPanel><TextBlock Text="Add" FontSize="10.5" Opacity="0.6" /><TextBox Text="{Binding OdAdd, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" /></StackPanel>
                                            </UniformGrid>
                                            <TextBlock Text="دید بدون عینک" FontSize="10.5" Opacity="0.6" Margin="0,8,0,2" />
                                            <ComboBox ItemsSource="{Binding VisionOptions}" SelectedIndex="{Binding OdVisionIndex}" />
                                            <TextBlock Text="فشار چشم IOP (mmHg)" FontSize="10.5" Opacity="0.6" Margin="0,8,0,2" />
                                            <TextBox Text="{Binding OdIop, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" />
                                            <TextBlock Text="{Binding OdIopWarning, Mode=OneWay}" Foreground="#C62828" FontWeight="Bold" FontSize="11.5" Margin="0,4,0,0"
                                                       Visibility="{Binding OdIopWarning, Converter={StaticResource StringToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                    <!-- OS -->
                                    <Border Grid.Column="2" CornerRadius="12" Padding="14" Background="#F3E5F5">
                                        <StackPanel>
                                            <TextBlock Text="چشم چپ (OS)" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                                            <UniformGrid Columns="2">
                                                <StackPanel Margin="0,0,6,6"><TextBlock Text="Sphere" FontSize="10.5" Opacity="0.6" /><TextBox Text="{Binding OsSphere, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" /></StackPanel>
                                                <StackPanel Margin="0,0,0,6"><TextBlock Text="Cylinder" FontSize="10.5" Opacity="0.6" /><TextBox Text="{Binding OsCylinder, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" /></StackPanel>
                                                <StackPanel Margin="0,0,6,0"><TextBlock Text="Axis" FontSize="10.5" Opacity="0.6" /><TextBox Text="{Binding OsAxis, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" /></StackPanel>
                                                <StackPanel><TextBlock Text="Add" FontSize="10.5" Opacity="0.6" /><TextBox Text="{Binding OsAdd, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" /></StackPanel>
                                            </UniformGrid>
                                            <TextBlock Text="دید بدون عینک" FontSize="10.5" Opacity="0.6" Margin="0,8,0,2" />
                                            <ComboBox ItemsSource="{Binding VisionOptions}" SelectedIndex="{Binding OsVisionIndex}" />
                                            <TextBlock Text="فشار چشم IOP (mmHg)" FontSize="10.5" Opacity="0.6" Margin="0,8,0,2" />
                                            <TextBox Text="{Binding OsIop, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" />
                                            <TextBlock Text="{Binding OsIopWarning, Mode=OneWay}" Foreground="#C62828" FontWeight="Bold" FontSize="11.5" Margin="0,4,0,0"
                                                       Visibility="{Binding OsIopWarning, Converter={StaticResource StringToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="PD فاصله مردمک (mm)" FontSize="10.5" Opacity="0.6" />
                                        <TextBox Text="{Binding Pd, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="دید رنگ" FontSize="10.5" Opacity="0.6" />
                                        <ComboBox ItemsSource="{Binding ColorVisionOptions}" SelectedIndex="{Binding ColorVisionIndex}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="یافته‌ها و تشخیص" FontSize="10.5" Opacity="0.6" />
                                        <TextBox Text="{Binding EyeFindings, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                                 TextWrapping="Wrap" Height="60" />
                                    </StackPanel>
                                </Grid>

                                <Button Command="{Binding SaveEyeExamCommand}" Margin="0,14,0,0" HorizontalAlignment="Left"
                                        Style="{StaticResource MaterialDesignRaisedButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSave" Width="15" Height="15" VerticalAlignment="Center" />
                                        <TextBlock Text="💾 ذخیره معاینهٔ چشم در پروندهٔ بیمار" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>

                                <!-- ═══ سابقهٔ معاینه‌های چشم بیمار منتخب — چرخهٔ ۲۸ ═══
                                     با انتخاب بیمار، ۲۰ معاینهٔ آخر او از پرونده خوانده می‌شود؛
                                     آخرین معاینه در فرم می‌نشیند و بقیه برای مرور روند درمان است -->
                                <Border CornerRadius="12" BorderBrush="#B39DDB" BorderThickness="1" Padding="12" Margin="0,14,0,0"
                                        Background="#F3E5F5"
                                        Visibility="{Binding EyePatient, Converter={StaticResource NullToVisibility}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="History" Width="18" Height="18" Foreground="#5E35B1" VerticalAlignment="Center" />
                                            <TextBlock Text="سابقهٔ معاینه‌های چشم (۲۰ مورد آخر — از پروندهٔ بیمار)" FontSize="13"
                                                       FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="170">
                                            <ItemsControl ItemsSource="{Binding EyeHistory}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="8" Background="#FFFFFF" Padding="9,6" Margin="0,0,0,5">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding DateShamsi, Mode=OneWay}" FontWeight="SemiBold"
                                                                               FontFamily="{DynamicResource App.CodeFont}" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" HorizontalAlignment="Left" FontSize="10.5" Opacity="0.8"
                                                                               VerticalAlignment="Center" Margin="14,0,0,0">
                                                                        <Run Text="OD: " /><Run Text="{Binding OdSummary, Mode=OneWay}" FontFamily="{DynamicResource App.CodeFont}" />
                                                                        <Run Text="   OS: " /><Run Text="{Binding OsSummary, Mode=OneWay}" FontFamily="{DynamicResource App.CodeFont}" />
                                                                    </TextBlock>
                                                                </Grid>
                                                                <TextBlock Text="{Binding Findings, Mode=OneWay, TargetNullValue=''}" FontSize="10.5" Opacity="0.7"
                                                                           TextWrapping="Wrap" Margin="0,3,0,0"
                                                                           Visibility="{Binding Findings, Converter={StaticResource StringToVisibility}}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
    </Grid>
</UserControl>
