<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.OphthalmologyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="774" d:DesignWidth="1030"
             FlowDirection="RightToLeft">
    <!-- چشمپزشکی — بازطراحی کامل بر اساس docs/design/approved/ophthalmology.html -->
    <Grid Background="{StaticResource Ds.PageBackground}" Margin="14,11,14,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><!-- سربرگ -->
            <RowDefinition Height="Auto" /><!-- کارتها -->
            <RowDefinition Height="Auto" /><!-- تبها -->
            <RowDefinition Height="Auto" /><!-- نوار ابزار -->
            <RowDefinition Height="Auto" /><!-- ردیف بالا: سه پنل -->
            <RowDefinition Height="Auto" /><!-- ردیف پایین: نمودار + یافتهها -->
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" /><!-- پانوشت -->
        </Grid.RowDefinitions>

        <!-- ══ سربرگ ══ -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="#1565C0" Margin="0,0,9,0">
                <TextBlock Text="👁" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="معاینهٔ چشمپزشکی" Style="{StaticResource Ds.PageTitle}" />
                <TextBlock Text="رفرکشن، فشار چشم، اسلیتلمپ و نسخهٔ عینک — یکپارچه" Style="{StaticResource Ds.Muted}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="معاینهٔ جدید" Style="{StaticResource Ds.FlatPrimary}" Height="32" Padding="14,0" Margin="0,0,7,0" />
                <Button Content="چاپ نسخه" Style="{StaticResource Ds.OutlineButton}" Height="32" Padding="13,0" />
            </StackPanel>
        </Grid>

        <!-- ══ پنج کارت آماری ══ -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource Ds.StatCard}" Background="#F4FBF4" BorderBrush="#81C784">
                <StackPanel><TextBlock Text="{Binding Kpis.V1}" Style="{StaticResource Ds.StatNumber}" Foreground="#2E7D32" />
                    <TextBlock Text="معاینات امروز" Style="{StaticResource Ds.StatLabel}" /></StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource Ds.StatCard}" Background="#FFF5F5" BorderBrush="#E57373">
                <StackPanel><TextBlock Text="{Binding Kpis.V2}" Style="{StaticResource Ds.StatNumber}" Foreground="#C62828" />
                    <TextBlock Text="فشار چشم بالا" Style="{StaticResource Ds.StatLabel}" /></StackPanel>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource Ds.StatCard}" Background="#FDF7FF" BorderBrush="#BA68C8">
                <StackPanel><TextBlock Text="{Binding Kpis.V3}" Style="{StaticResource Ds.StatNumber}" Foreground="#6A1B9A" />
                    <TextBlock Text="نسخهٔ عینک امروز" Style="{StaticResource Ds.StatLabel}" /></StackPanel>
            </Button>
            <Button Grid.Column="6" Style="{StaticResource Ds.StatCard}" Background="#FFFAF3" BorderBrush="#FFB74D">
                <StackPanel><TextBlock Text="{Binding Kpis.V4}" Style="{StaticResource Ds.StatNumber}" Foreground="#E65100" />
                    <TextBlock Text="پیگیریهای هفته" Style="{StaticResource Ds.StatLabel}" /></StackPanel>
            </Button>
            <Button Grid.Column="8" Style="{StaticResource Ds.StatCard}" Background="#F5FAFF" BorderBrush="#64B5F6">
                <StackPanel><TextBlock Text="{Binding Kpis.V5}" Style="{StaticResource Ds.StatNumber}" Foreground="#1565C0" />
                    <TextBlock Text="بیماران پروندهدار" Style="{StaticResource Ds.StatLabel}" /></StackPanel>
            </Button>
        </Grid>

        <!-- ══ تبها ══ -->
        <Border Grid.Row="2" Style="{StaticResource Ds.TabBar}" Padding="0,2,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border BorderBrush="#1565C0" BorderThickness="0,0,0,2" Margin="0,0,4,0">
                    <TextBlock Text="رفرکشن و حدت بینایی" Style="{StaticResource Ds.TabItemActiveText}" />
                </Border>
                <TextBlock Text="اسلیتلمپ و فوندوس" Style="{StaticResource Ds.TabItemText}" />
                <TextBlock Text="تستهای تخصصی" Style="{StaticResource Ds.TabItemText}" />
                <TextBlock Text="تصویربرداری چشم" Style="{StaticResource Ds.TabItemText}" />
                <TextBlock Text="تشخیص و درمان" Style="{StaticResource Ds.TabItemText}" />
            </StackPanel>
        </Border>

        <!-- ══ نوار ابزار ══ -->
        <Border Grid.Row="3" Style="{StaticResource Ds.Toolbar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" /><ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource Ds.CompactText}"
                         Text="{Binding EyePatientSearch, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Content="جستجو ⌕" Style="{StaticResource Ds.FlatPrimary}" Height="30"
                        Padding="13,0" Margin="7,0,0,0" />
                <Border Grid.Column="2" Background="#EDF5FF" BorderBrush="#BBDBFB" BorderThickness="1"
                        CornerRadius="7" Height="30" Margin="7,0,0,0" Padding="8,0">
                    <TextBlock Text="{Binding EyePatient.FullName, FallbackValue='علی احمدی — کد ۰۰۱۲۳۴'}"
                               FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <TextBlock Text="آخرین معاینه: ۱۴۰۵/۰۸/۰۳" Style="{StaticResource Ds.Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="تازهمسازی" Style="{StaticResource Ds.OutlineButton}" Padding="10,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ ردیف بالا: سه پنل چشمراست / چشمچپ / نسخه ══ -->
        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" /><ColumnDefinition Width="8" />
                <ColumnDefinition Width="1.15*" /><ColumnDefinition Width="8" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- چشم راست -->
            <Border Grid.Column="0" Style="{StaticResource Ds.Panel}">
                <StackPanel>
                    <TextBlock Text="چشم راست (OD) 👁" Style="{StaticResource Ds.PanelTitle}" HorizontalAlignment="Center" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0"><TextBlock Text="Sphere" Style="{StaticResource Ds.FieldLabel}" />
                            <Border Style="{StaticResource Ds.FieldValue}"><TextBlock Text="{Binding OdSphere, FallbackValue='+۳٫۰۰'}" FontSize="11" HorizontalAlignment="Center" /></Border></StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2"><TextBlock Text="Cylinder" Style="{StaticResource Ds.FieldLabel}" />
                            <Border Style="{StaticResource Ds.FieldValue}"><TextBlock Text="{Binding OdCylinder, FallbackValue='-۰٫۷۵'}" FontSize="11" HorizontalAlignment="Center" /></Border></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0"><TextBlock Text="Axis" Style="{StaticResource Ds.FieldLabel}" />
                            <Border Style="{StaticResource Ds.FieldValue}"><TextBlock Text="{Binding OdAxis, FallbackValue='۱۸۰'}" FontSize="11" HorizontalAlignment="Center" /></Border></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Add" Style="{StaticResource Ds.FieldLabel}" />
                            <Border Style="{StaticResource Ds.FieldValue}"><TextBlock Text="{Binding OdAdd, FallbackValue='+۱٫۵۰'}" FontSize="11" HorizontalAlignment="Center" /></Border></StackPanel>
                    </Grid>
                    <TextBlock Text="فشار چشم — (IOP) mmHg" Style="{StaticResource Ds.FieldLabel}" Margin="0,6,0,2" />
                    <Grid>
                        <ProgressBar Style="{StaticResource Ds.ProgressBar}" Value="14" Maximum="30" Foreground="#0D9488" />
                        <TextBlock Text="{Binding OdIop, FallbackValue='۱۴', StringFormat='{}{0} mmHg'}" FontSize="9.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                    </Grid>
                    <TextBlock Text="✅ در محدودهٔ طبیعی" Style="{StaticResource Ds.Muted}" Foreground="#2E7D32"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- چشم چپ -->
            <Border Grid.Column="2" Style="{StaticResource Ds.Panel}">
                <StackPanel>
                    <TextBlock Text="چشم چپ (OS) 👁" Style="{StaticResource Ds.PanelTitle}" HorizontalAlignment="Center" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0"><TextBlock Text="Sphere" Style="{StaticResource Ds.FieldLabel}" />
                            <Border Style="{StaticResource Ds.FieldValue}"><TextBlock Text="{Binding OsSphere, FallbackValue='+۲٫۵۰-'}" FontSize="11" HorizontalAlignment="Center" /></Border></StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2"><TextBlock Text="Cylinder" Style="{StaticResource Ds.FieldLabel}" />
                            <Border Style="{StaticResource Ds.FieldValue}"><TextBlock Text="{Binding OsCylinder, FallbackValue='-۱٫۰۰'}" FontSize="11" HorizontalAlignment="Center" /></Border></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0"><TextBlock Text="Axis" Style="{StaticResource Ds.FieldLabel}" />
                            <Border Style="{StaticResource Ds.FieldValue}"><TextBlock Text="{Binding OsAxis, FallbackValue='۱۷۵'}" FontSize="11" HorizontalAlignment="Center" /></Border></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Add" Style="{StaticResource Ds.FieldLabel}" />
                            <Border Style="{StaticResource Ds.FieldValue}"><TextBlock Text="{Binding OsAdd, FallbackValue='+۱٫۵۰'}" FontSize="11" HorizontalAlignment="Center" /></Border></StackPanel>
                    </Grid>
                    <TextBlock Text="فشار چشم — (IOP) mmHg" Style="{StaticResource Ds.FieldLabel}" Margin="0,6,0,2" />
                    <Grid>
                        <ProgressBar Style="{StaticResource Ds.ProgressBar}" Value="23" Maximum="30" Foreground="#EF4444" />
                        <TextBlock Text="{Binding OsIop, FallbackValue='۲۳', StringFormat='{}{0} mmHg'}" FontSize="9.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                    </Grid>
                    <TextBlock Text="⚠️ بالاتر از ۲۱ — احتمال گلوکوم" Style="{StaticResource Ds.Muted}" Foreground="#C62828"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- نسخهٔ عینک زنده -->
            <Border Grid.Column="4" Style="{StaticResource Ds.Panel}">
                <StackPanel>
                    <TextBlock Text="نسخهٔ عینک زنده 👓" Style="{StaticResource Ds.PanelTitle}" />
                    <Border Background="#F8FBFE" BorderBrush="#D9E2EC" BorderThickness="1" CornerRadius="7" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="OD" FontWeight="Bold" FontSize="11" Margin="0,0,8,3" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OdSphere, FallbackValue='+۳٫۰۰ / -۰٫۷۵ × ۱۸۰'}" FontSize="10.5" Margin="0,0,0,3" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="OS" FontWeight="Bold" FontSize="11" Margin="0,0,8,3" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GlassesPrescriptionText, FallbackValue='+۲٫۵۰ / -۱٫۰۰ × ۱۷۵'}" FontSize="10.5" Margin="0,0,0,3" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Add" FontWeight="Bold" FontSize="11" Margin="0,0,8,3" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OdAdd, FallbackValue='+۱٫۵۰'}" FontSize="10.5" Margin="0,0,0,3" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="PD" FontWeight="Bold" FontSize="11" Margin="0,0,8,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Pd, FallbackValue='mm ۶۲'}" FontSize="10.5" />
                        </Grid>
                    </Border>
                    <TextBlock Text="نسخه بر اساس حدت بینایی و رفرکشن ساخته میشود." Style="{StaticResource Ds.Muted}" Margin="0,7,0,0" />
                    <Button Content="چاپ نسخهٔ عینک" Style="{StaticResource Ds.FlatPrimary}" Height="32" Margin="0,9,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ ردیف پایین: روند فشار + یافتهها ══ -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Ds.Panel}">
                <StackPanel>
                    <TextBlock Text="روند فشار چشم 📈" Style="{StaticResource Ds.PanelTitle}" />
                    <Grid Height="86">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Bottom"><Border Height="40" Background="#EF4444" CornerRadius="4,4,0,0" Margin="8,0" /></StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom"><Border Height="32" Background="#90CAF9" CornerRadius="4,4,0,0" Margin="8,0" /></StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom"><Border Height="28" Background="#90CAF9" CornerRadius="4,4,0,0" Margin="8,0" /></StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Bottom"><Border Height="22" Background="#90CAF9" CornerRadius="4,4,0,0" Margin="8,0" /></StackPanel>
                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom"><Border Height="18" Background="#90CAF9" CornerRadius="4,4,0,0" Margin="8,0" /></StackPanel>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="۱۴۰۳/۰۸/۰۵" Style="{StaticResource Ds.Muted}" HorizontalAlignment="Center" FontSize="9" />
                        <TextBlock Grid.Column="1" Text="۱۴۰۴/۰۲/۱۸" Style="{StaticResource Ds.Muted}" HorizontalAlignment="Center" FontSize="9" />
                        <TextBlock Grid.Column="2" Text="۱۴۰۴/۰۸/۱۲" Style="{StaticResource Ds.Muted}" HorizontalAlignment="Center" FontSize="9" />
                        <TextBlock Grid.Column="3" Text="۱۴۰۵/۰۲/۲۵" Style="{StaticResource Ds.Muted}" HorizontalAlignment="Center" FontSize="9" />
                        <TextBlock Grid.Column="4" Text="۱۴۰۵/۰۸/۰۳" Style="{StaticResource Ds.Muted}" HorizontalAlignment="Center" FontSize="9" />
                    </Grid>
                    <TextBlock Text="آخرین معاینه: فشار چشم چپ ۲۳ — نیازمند پیگیری" Style="{StaticResource Ds.Muted}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Ds.Panel}">
                <StackPanel>
                    <TextBlock Text="یافتهها و تشخیص ⚕️" Style="{StaticResource Ds.PanelTitle}" />
                    <Border Background="#F8FBFE" BorderBrush="#D9E2EC" BorderThickness="1" CornerRadius="7" Padding="8,5" Margin="0,0,0,6">
                        <TextBlock Text="{Binding EyeFindings, FallbackValue='حدت بینایی دو چشم با عینک کامل؛ فشار چشم چپ بالاتر از حد طبیعی — پیگیری گلوکوم.'}"
                                   FontSize="10" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="تشخیص" Style="{StaticResource Ds.FieldLabel}" />
                    <Border Style="{StaticResource Ds.FieldValue}" Height="27">
                        <TextBlock Text="{Binding DiagnosisText, FallbackValue='آستیگماتیسم مرکب دوطرفه · مشکوک به گلوکوم'}" FontSize="9.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <TextBlock Text="برنامهٔ درمان" Style="{StaticResource Ds.FieldLabel}" />
                    <Border Style="{StaticResource Ds.FieldValue}" Height="27">
                        <TextBlock Text="{Binding CarePlanText, FallbackValue='OCT عصب بینایی + تونومتری مجدد'}" FontSize="9.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="7" Text="سهند کلینیکپرو — معاینهٔ چشمپزشکی · رفرکشن و حدت بینایی · نسخهٔ ۲٫۲۸٫۲۸"
                   Style="{StaticResource Ds.Muted}" HorizontalAlignment="Center" Margin="0,5,0,0" />
    </Grid>
</UserControl>
