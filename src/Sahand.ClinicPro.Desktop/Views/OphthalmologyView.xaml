<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.OphthalmologyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1080"
             FlowDirection="RightToLeft">
    <!-- ═══ چشم‌پزشکی — چرخهٔ چهل‌وسوم (گزارش مالک): «دندانپزشکی و چشم پزشکی و
         تصویربرداری و فزیوتراپی در یک صفحه و تب‌های جداگانه هستند. برای هر
         کدوم یک صفحه مستقل طراحی بکن تا با همدیگه تداخلی نداشته باشن» —
         محتوای این تب از پاراکلینیکِ سابقِ تب‌دار جدا شد و اکنون صفحهٔ
         اختصاصی مستقل خودش است؛ تمام منطق و اتصال‌ها بدون تغییر منتقل شدند. ═══ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#D3E2F0" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Left" Command="{Binding SaveEyeExamCommand}" IsEnabled="{Binding IsEyeExamEnabled}"
                        Style="{StaticResource MaterialDesignRaisedButton}" Padding="14,7" Content="ذخیره معاینه" />
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="9" Background="#E8F2FD" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="EyeCircle" Width="23" Height="23" Foreground="#176AC2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="معاینه چشم‌پزشکی" Foreground="#173657" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="رفرکشن، فشار چشم، یافته‌ها و سابقه بیمار" Foreground="#617992" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- محتوای صفحه — عیناً از تب پاراکلینیک سابق (اتصال‌ها بدون تغییر) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,8">
                            <StackPanel>
                                <!-- ═══ نوار بیمار تب چشم — چرخهٔ بیست‌وهشتم (گزارش هجدهم مالک):
                                     پیش‌تر این تب بیمار خودش را نداشت و باید بیمار در تب
                                     فیزیوتراپی/تصویربرداری جستجو می‌شد؛ اکنون معاینه و سابقه
                                     به پروندهٔ همین بیمار وصل است ═══ -->
                                <Border Background="White" BorderBrush="#D3E2F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                                <Grid IsEnabled="{Binding CanSelectEyePatient}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.4*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding EyePatientSearch, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="🔍 بیمار چشم‌پزشکی — کد ملی / موبایل / نام">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SearchEyePatientCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="1" Command="{Binding SearchEyePatientCommand}" Margin="8,0,0,0"
                                            Style="{StaticResource MaterialDesignRaisedButton}" Padding="12,4">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Magnify" Width="15" Height="15" VerticalAlignment="Center" />
                                            <TextBlock Text="جستجو" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <!-- کارت بیمار — معاینه در پروندهٔ همین بیمار ثبت می‌شود -->
                                    <Border Grid.Column="2" Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1"
                                            CornerRadius="8" Padding="10,5" Margin="8,0,8,0"
                                            Visibility="{Binding EyePatient, Converter={StaticResource NullToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AccountCheck" Width="16" Height="16" Foreground="#2E7D32" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding EyePatient.FullName, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                            <TextBlock Text="{Binding EyePatient.NationalCode, Mode=OneWay}" Opacity="0.7" FontSize="11"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Grid.Column="3" Command="{Binding ClearEyePatientCommand}"
                                            Style="{StaticResource MaterialDesignFlatButton}" Padding="8,4" ToolTip="بستن پرونده و بیمار بعدی"
                                            Visibility="{Binding EyePatient, Converter={StaticResource NullToVisibility}}">
                                        <materialDesign:PackIcon Kind="CloseCircleOutline" Width="18" Height="18" Foreground="#C62828" />
                                    </Button>
                                </Grid>
                                </Border>
                                <TextBlock Text="در حال دریافت سابقهٔ بیمار…" Foreground="#176AC2" Margin="0,0,0,8"
                                           Visibility="{Binding IsEyeHistoryLoading, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel IsEnabled="{Binding IsEyeExamEnabled}">
                                <TextBlock Text="این فرم برای معاینهٔ جدید است؛ اندازه‌های قبلی خودکار کپی نمی‌شوند. نسخهٔ قبلی را در سابقه بررسی کنید."
                                           FontSize="10.5" Foreground="#617992" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <Button Command="{Binding CopyPreviousRefractionCommand}" IsEnabled="{Binding HasPreviousRefraction}"
                                        Content="کپی مقادیر نسخهٔ قبلی پس از بررسی" HorizontalAlignment="Left" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="0.8*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- OD -->
                                    <Border Grid.Column="0" CornerRadius="10" Padding="14" Background="White" BorderBrush="#D3E2F0" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="چشم راست (OD)" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                            <UniformGrid Columns="2">
                                                <StackPanel Margin="0,0,6,6"><TextBlock Text="عدسی (Sphere)" FontSize="10.5" Opacity="0.6"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/><TextBox Text="{Binding OdSphere, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" /></StackPanel>
                                                <StackPanel Margin="0,0,0,6"><TextBlock Text="استوانه (Cylinder)" FontSize="10.5" Opacity="0.6"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/><TextBox Text="{Binding OdCylinder, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" /></StackPanel>
                                                <StackPanel Margin="0,0,6,0"><TextBlock Text="محور (Axis)" FontSize="10.5" Opacity="0.6"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/><TextBox Text="{Binding OdAxis, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" /></StackPanel>
                                                <StackPanel><TextBlock Text="افزوده نزدیک‌بین (Add)" FontSize="10.5" Opacity="0.6"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/><TextBox Text="{Binding OdAdd, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" /></StackPanel>
                                            </UniformGrid>
                                            <TextBlock Text="حدت بینایی بدون اصلاح (Visual Acuity)" FontSize="10.5" Opacity="0.6" Margin="0,8,0,2"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                            <ComboBox ItemsSource="{Binding VisionOptions}" SelectedIndex="{Binding OdVisionIndex}" />
                                            <TextBlock Text="حدت بینایی با اصلاح (عینک / لنز)" FontSize="10.5" Opacity="0.6" Margin="0,8,0,2" />
                                            <ComboBox ItemsSource="{Binding VisionOptions}" SelectedIndex="{Binding OdCorrectedVisionIndex}" />
                                            <TextBlock Text="فشار داخل چشم (IOP — mmHg)" FontSize="10.5" Opacity="0.6" Margin="0,8,0,2"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                            <TextBox Text="{Binding OdIop, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" />
                                            <Border Width="180" Height="10" CornerRadius="5" HorizontalAlignment="Left" Margin="0,5,0,0"
                                                    Background="#C8E6C9" BorderBrush="#90A4AE" BorderThickness="0.5">
                                                <Border Width="{Binding OdIopGaugeWidth, Mode=OneWay}" Height="10" CornerRadius="5" HorizontalAlignment="Left" Background="#3949AB" />
                                            </Border>
                                            <TextBlock Text="{Binding OdIopWarning, Mode=OneWay}" Foreground="#C62828" FontWeight="Bold" FontSize="11.5" Margin="0,4,0,0"
                                                       Visibility="{Binding OdIopWarning, Converter={StaticResource StringToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                    <!-- OS -->
                                    <Border Grid.Column="2" CornerRadius="10" Padding="14" Background="White" BorderBrush="#D3E2F0" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="چشم چپ (OS)" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                            <UniformGrid Columns="2">
                                                <StackPanel Margin="0,0,6,6"><TextBlock Text="عدسی (Sphere)" FontSize="10.5" Opacity="0.6"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/><TextBox Text="{Binding OsSphere, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" /></StackPanel>
                                                <StackPanel Margin="0,0,0,6"><TextBlock Text="استوانه (Cylinder)" FontSize="10.5" Opacity="0.6"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/><TextBox Text="{Binding OsCylinder, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" /></StackPanel>
                                                <StackPanel Margin="0,0,6,0"><TextBlock Text="محور (Axis)" FontSize="10.5" Opacity="0.6"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/><TextBox Text="{Binding OsAxis, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" /></StackPanel>
                                                <StackPanel><TextBlock Text="افزوده نزدیک‌بین (Add)" FontSize="10.5" Opacity="0.6"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/><TextBox Text="{Binding OsAdd, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" /></StackPanel>
                                            </UniformGrid>
                                            <TextBlock Text="حدت بینایی بدون اصلاح (Visual Acuity)" FontSize="10.5" Opacity="0.6" Margin="0,8,0,2"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                            <ComboBox ItemsSource="{Binding VisionOptions}" SelectedIndex="{Binding OsVisionIndex}" />
                                            <TextBlock Text="حدت بینایی با اصلاح (عینک / لنز)" FontSize="10.5" Opacity="0.6" Margin="0,8,0,2" />
                                            <ComboBox ItemsSource="{Binding VisionOptions}" SelectedIndex="{Binding OsCorrectedVisionIndex}" />
                                            <TextBlock Text="فشار داخل چشم (IOP — mmHg)" FontSize="10.5" Opacity="0.6" Margin="0,8,0,2"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                            <TextBox Text="{Binding OsIop, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" />
                                            <Border Width="180" Height="10" CornerRadius="5" HorizontalAlignment="Left" Margin="0,5,0,0"
                                                    Background="#C8E6C9" BorderBrush="#90A4AE" BorderThickness="0.5">
                                                <Border Width="{Binding OsIopGaugeWidth, Mode=OneWay}" Height="10" CornerRadius="5" HorizontalAlignment="Left" Background="#3949AB" />
                                            </Border>
                                            <TextBlock Text="{Binding OsIopWarning, Mode=OneWay}" Foreground="#C62828" FontWeight="Bold" FontSize="11.5" Margin="0,4,0,0"
                                                       Visibility="{Binding OsIopWarning, Converter={StaticResource StringToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                    <!-- خلاصهٔ زنده؛ بازتاب ورودی است، نه تأیید یا نسخهٔ چاپ‌شده. -->
                                    <Border Grid.Column="4" CornerRadius="10" Padding="14" Background="White" BorderBrush="#D3E2F0" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="👓 نسخهٔ عینک زنده" FontWeight="Bold" FontSize="14" Foreground="#173657" />
                                            <TextBlock Text="{Binding GlassesPrescriptionText, Mode=OneWay}" FontFamily="{DynamicResource App.CodeFont}"
                                                       FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#173657" />
                                            <TextBlock Text="خلاصه از ورودی‌های همین فرم ساخته می‌شود؛ برای ثبت در پرونده، معاینه را ذخیره کنید."
                                                       TextWrapping="Wrap" FontSize="10.5" Margin="0,14,0,0" Foreground="#617992" />
                                            <Button Content="🖨 چاپ پیش‌نویس نسخه" Click="PrintGlassesPrescription_Click"
                                                    IsEnabled="{Binding IsEyeExamEnabled}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="فاصله مردمک (PD — میلی‌متر)" FontSize="10.5" Opacity="0.6" />
                                        <TextBox Text="{Binding Pd, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource App.CodeFont}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="دید رنگی (Color Vision)" FontSize="10.5" Opacity="0.6" />
                                        <ComboBox ItemsSource="{Binding ColorVisionOptions}" SelectedIndex="{Binding ColorVisionIndex}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="یافته‌ها و تشخیص" FontSize="10.5" Opacity="0.6" />
                                        <TextBox Text="{Binding EyeFindings, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                                 TextWrapping="Wrap" Height="60" />
                                        <TextBlock Text="جزئیات معاینهٔ قبلی در بخش سابقه نمایش داده می‌شوند و خودکار وارد فرم جدید نمی‌شوند."
                                                   TextWrapping="Wrap" FontSize="10" Opacity="0.7" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!-- ماژول حرفه‌ای چشم‌پزشکی — طرح تأییدشدهٔ نسخهٔ ۲ -->
                                <Expander Margin="0,12,0,0" Header="🔬 اسلیت‌لمپ و فوندوس + پاچیمتری">
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="راست (OD): پلک، ملتحمه، قرنیه، عدسی، مردمک/RAPD، زجاجیه، دیسک و ماکولا" FontSize="10" Opacity="0.6" TextWrapping="Wrap" />
                                            <TextBox Text="{Binding SlitOd, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="52" />
                                            <TextBlock Text="پاچیمتری راست (میکرون)" FontSize="10" Opacity="0.6" Margin="0,6,0,0" />
                                            <TextBox Text="{Binding PachymetryOd, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="چپ (OS): همان ساختار قرینه" FontSize="10" Opacity="0.6" />
                                            <TextBox Text="{Binding SlitOs, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="52" />
                                            <TextBlock Text="پاچیمتری چپ (میکرون)" FontSize="10" Opacity="0.6" Margin="0,6,0,0" />
                                            <TextBox Text="{Binding PachymetryOs, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                </Expander>
                                <Expander Margin="0,8,0,0" Header="🧪 تست‌های تخصصی (میدان بینایی، آمسلر، ایشیهارا، شیرمر، کاور تست)">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="میدان بینایی (پریمتری) — الگوی نقص و MD هر چشم" FontSize="10" Opacity="0.6" />
                                        <TextBox Text="{Binding VisualFieldText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="40" />
                                        <TextBlock Text="آمادگی/نتیجهٔ آمسلر، ایشیهارا، شیرمر، کاور تست و دید عمق" FontSize="10" Opacity="0.6" Margin="0,6,0,0" />
                                        <TextBox Text="{Binding SpecialTestsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="40" />
                                    </StackPanel>
                                </Expander>
                                <Expander Margin="0,8,0,0" Header="📷 تصویربرداری چشم (OCT، عکس فوندوس، بیومتری)">
                                    <TextBox Text="{Binding ImagingNote, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="44" Margin="0,8,0,0"
                                             ToolTip="یادداشت نتیجه و تاریخ OCT/فوندوس/بیومتری" />
                                </Expander>
                                <Expander Margin="0,8,0,0" Header="🩺 تشخیص و برنامهٔ درمان / جراحی / ارجاع">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="تشخیص‌های این معاینه" FontSize="10" Opacity="0.6" />
                                        <TextBox Text="{Binding DiagnosisText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="38" />
                                        <TextBlock Text="برنامهٔ درمان، نامزدی جراحی (کاتراکت/لیزیک) و شرایط ارجاع" FontSize="10" Opacity="0.6" Margin="0,6,0,0" />
                                        <TextBox Text="{Binding CarePlanText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="38" />
                                    </StackPanel>
                                </Expander>
                                <Expander Margin="0,8,0,0" Header="💊 نسخهٔ دارویی چشمی">
                                    <TextBox Text="{Binding DrugPrescriptionText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="48" Margin="0,8,0,0"
                                             ToolTip="دارو، چشم، دستور مصرف و مدت — مثلاً: قطره تیمولول ۰٫۵٪، راست، هر شب ۱ قطره" />
                                </Expander>
                                <Expander Margin="0,8,0,0" Header="📅 پیگیری و یادآوری">
                                    <TextBox Text="{Binding FollowUpText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="40" Margin="0,8,0,0"
                                             ToolTip="کنترل فشار، تکرار تست‌ها و غربالگری‌های دوره‌ای با تاریخ" />
                                </Expander>

                                <Button Command="{Binding SaveEyeExamCommand}" Margin="0,14,0,0" HorizontalAlignment="Left"
                                        Style="{StaticResource MaterialDesignRaisedButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSave" Width="15" Height="15" VerticalAlignment="Center" />
                                        <TextBlock Text="💾 ذخیره معاینهٔ چشم در پروندهٔ بیمار" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>

                                </StackPanel>

                                <!-- ═══ سابقهٔ معاینه‌های چشم بیمار منتخب — چرخهٔ ۲۸ ═══
                                     با انتخاب بیمار، ۲۰ معاینهٔ آخر او از پرونده خوانده می‌شود؛
                                     همهٔ معاینه‌ها برای مرورند و به‌صورت خودکار وارد فرم جدید نمی‌شوند -->
                                <Border CornerRadius="12" BorderBrush="#B39DDB" BorderThickness="1" Padding="12" Margin="0,14,0,0"
                                        Background="#F3E5F5"
                                        Visibility="{Binding EyePatient, Converter={StaticResource NullToVisibility}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="History" Width="18" Height="18" Foreground="#5E35B1" VerticalAlignment="Center" />
                                            <TextBlock Text="سابقهٔ معاینه‌های چشم (۲۰ مورد آخر — از پروندهٔ بیمار)" FontSize="13"
                                                       FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding HistoryTrendText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="#4A148C"
                                                   Margin="0,0,0,6" TextWrapping="Wrap"
                                                   Visibility="{Binding HistoryTrendText, Converter={StaticResource StringToVisibility}}" />
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="170">
                                            <ItemsControl ItemsSource="{Binding EyeHistory}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="8" Background="{DynamicResource MaterialDesign.Brush.Card.Background}" Padding="9,6" Margin="0,0,0,5">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding DateShamsi, Mode=OneWay}" FontWeight="SemiBold"
                                                                               FontFamily="{DynamicResource App.CodeFont}" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                                                    <TextBlock Grid.Column="1" HorizontalAlignment="Left" FontSize="10.5" Opacity="0.8"
                                                                               VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                                                                        <Run Text="OD: " /><Run Text="{Binding OdSummary, Mode=OneWay}" FontFamily="{DynamicResource App.CodeFont}" />
                                                                        <Run Text="   OS: " /><Run Text="{Binding OsSummary, Mode=OneWay}" FontFamily="{DynamicResource App.CodeFont}" />
                                                                    </TextBlock>
                                                                </Grid>
                                                                <TextBlock Text="{Binding AdditionalDetails}" FontSize="10.5" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding EyewearPrescription}" FontSize="10.5" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding VisualField, StringFormat='میدان بینایی: {0}'}" FontSize="10.5" TextWrapping="Wrap"
                                                                           Visibility="{Binding VisualField, Converter={StaticResource StringToVisibility}}" />
                                                                <TextBlock Text="{Binding Findings, Mode=OneWay, TargetNullValue=''}" FontSize="10.5" Opacity="0.7"
                                                                           TextWrapping="Wrap" Margin="0,3,0,0"
                                                                           Visibility="{Binding Findings, Converter={StaticResource StringToVisibility}}"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
