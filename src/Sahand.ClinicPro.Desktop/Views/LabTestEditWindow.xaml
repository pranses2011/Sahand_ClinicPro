<Window x:Class="Sahand.ClinicPro.Desktop.Views.LabTestEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:behaviors="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        Title="ویرایش آزمایش"
        Height="780" Width="720"
        MinHeight="700" MinWidth="660"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════
         فرم ویرایش کاتالوگ آزمایش — چرخهٔ ۷۲
         گزارش مالک: «بازه‌های مرجع و حدود بحرانی هر آزمایش رو بطور کامل و
         دقیق تکمیل کن… در صورت نیاز بتونم اصلاحشون بکنم»
         ساختار: سربرگ شناسایی → عمومی (واحد/قیمت/زمان/متن‌های نمایشی) →
         سه کارت بازهٔ مرجع (مرد/زن/کودک) → کارت قرمز حدود بحرانی → پابرگ ذخیره.
         قواعد: فیلد خالی = «بدون محدودیت آن سمت»؛ همهٔ ورودی‌های عددی ارقام
         فارسی می‌پذیرند؛ قیمت با جداکنندهٔ سه‌رقمی زنده (MoneyInput).
         ═══════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ سربرگ — شناسایی آزمایش در حال ویرایش ═══ -->
        <Border Grid.Row="0" CornerRadius="0,0,14,14" Padding="18,12" Margin="0,0,0,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#00695C" Offset="0" />
                    <GradientStop Color="#004D40" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <Border Width="46" Height="46" CornerRadius="23" VerticalAlignment="Center" Margin="0,0,12,0"
                        Background="#33FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1">
                    <materialDesign:PackIcon Kind="TestTube" Width="23" Height="23"
                                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding TestName}" FontSize="16.5" FontWeight="Bold" Foreground="White" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Border CornerRadius="8" Padding="7,1.5" Background="#33FFFFFF" Margin="0,0,6,0"
                                Visibility="{Binding TestCode, Converter={StaticResource NullToVisibility}}">
                            <TextBlock FontSize="10" Foreground="#B2DFDB"
                                       Text="{Binding TestCode, StringFormat=کد: {0}}" />
                        </Border>
                        <Border CornerRadius="8" Padding="7,1.5" Background="#33FFFFFF" Margin="0,0,6,0"
                                Visibility="{Binding Category, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#B2DFDB" />
                        </Border>
                        <Border CornerRadius="8" Padding="7,1.5" Background="#33FFFFFF"
                                Visibility="{Binding TestNameEn, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{Binding TestNameEn}" FontSize="10" Foreground="#B2DFDB"
                                       FontFamily="{DynamicResource App.CodeFont}" FlowDirection="LeftToRight" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ بدنهٔ فرم — اسکرول‌شونده ═══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,0,18,8">
            <StackPanel>

                <!-- ─── بخش ۱: عمومی — واحد، قیمت، زمان جواب ─── -->
                <TextBlock Text="اطلاعات عمومی" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="2,4,2,6" />
                <Border Background="{DynamicResource MaterialDesign.Brush.Background}" CornerRadius="10" Padding="12,10" BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBox materialDesign:HintAssist.Hint="واحد اندازه‌شده (مثل mg/dL)"
                                     Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <!-- قیمت — قانون پروژه: جداکنندهٔ سه‌رقمی زنده + ارقام فارسی -->
                            <TextBox behaviors:MoneyInput.IsEnabled="True"
                                     Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontFamily="{DynamicResource App.CodeFont}"
                                     ToolTip="قیمت آزمایش — جداکنندهٔ سه‌رقمی خودکار">
                                <materialDesign:HintAssist.Hint>
                                    <TextBlock Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                                        <Run Text="قیمت (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" />
                                    </TextBlock>
                                </materialDesign:HintAssist.Hint>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBox materialDesign:HintAssist.Hint="زمان جواب (ساعت)"
                                     Text="{Binding TatText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     ToolTip="مثلاً ۲۴ یعنی نتیجه فردا آماده است" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ─── بخش ۲: بازه‌های مرجع — سه کارت مرد/زن/کودک ─── -->
                <TextBlock Text="بازه‌های مرجع ساخت‌یافته" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="2,0,2,4" />
                <TextBlock Text="موتور تفسیر خودکار نتیجه (طبیعی/بالا/پایین/بحرانی) از همین بازه‌ها بر اساس سن و جنسیتِ هر بیمار محاسبه می‌شود — فیلد خالی یعنی «بدون محدودیت در آن سمت»."
                           FontSize="10.5" Foreground="#78909C" TextWrapping="Wrap" Margin="2,0,2,8" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- کارت مردان -->
                    <Border Grid.Column="0" Background="#E3F2FD" CornerRadius="10" Padding="10,8"
                            BorderBrush="#90CAF9" BorderThickness="1.2">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <materialDesign:PackIcon Kind="HumanMale" Width="17" Height="17"
                                                         Foreground="#1565C0" VerticalAlignment="Center" />
                                <TextBlock Text="بزرگسال مرد" FontSize="12" FontWeight="Bold"
                                           Foreground="#1565C0" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox materialDesign:HintAssist.Hint="کف (مثلاً ۱۳.۵)"
                                     Text="{Binding MinMale, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,6"
                                     FontFamily="{DynamicResource App.CodeFont}"
                                     ToolTip="خالی بگذارید یعنی «بدون محدودیت» در آن سمت؛ فقط عدد (ارقام فارسی یا لاتین) بنویسید" />
                            <TextBox materialDesign:HintAssist.Hint="سقف (مثلاً ۱۷.۵)"
                                     Text="{Binding MaxMale, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontFamily="{DynamicResource App.CodeFont}"
                                     ToolTip="خالی بگذارید یعنی «بدون محدودیت» در آن سمت؛ فقط عدد (ارقام فارسی یا لاتین) بنویسید" />
                        </StackPanel>
                    </Border>

                    <!-- کارت زنان -->
                    <Border Grid.Column="2" Background="#FCE4EC" CornerRadius="10" Padding="10,8"
                            BorderBrush="#F48FB1" BorderThickness="1.2">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <materialDesign:PackIcon Kind="HumanFemale" Width="17" Height="17"
                                                         Foreground="#C2185B" VerticalAlignment="Center" />
                                <TextBlock Text="بزرگسال زن" FontSize="12" FontWeight="Bold"
                                           Foreground="#C2185B" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox materialDesign:HintAssist.Hint="کف (مثلاً ۱۲)"
                                     Text="{Binding MinFemale, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,6"
                                     FontFamily="{DynamicResource App.CodeFont}"
                                     ToolTip="خالی بگذارید یعنی «بدون محدودیت» در آن سمت؛ فقط عدد (ارقام فارسی یا لاتین) بنویسید" />
                            <TextBox materialDesign:HintAssist.Hint="سقف (مثلاً ۱۵.۵)"
                                     Text="{Binding MaxFemale, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontFamily="{DynamicResource App.CodeFont}"
                                     ToolTip="خالی بگذارید یعنی «بدون محدودیت» در آن سمت؛ فقط عدد (ارقام فارسی یا لاتین) بنویسید" />
                        </StackPanel>
                    </Border>

                    <!-- کارت کودک -->
                    <Border Grid.Column="4" Background="#FFF3E0" CornerRadius="10" Padding="10,8"
                            BorderBrush="#FFCC80" BorderThickness="1.2">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <materialDesign:PackIcon Kind="BabyCarriage" Width="17" Height="17"
                                                         Foreground="#E65100" VerticalAlignment="Center" />
                                <TextBlock Text="کودک" FontSize="12" FontWeight="Bold"
                                           Foreground="#E65100" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox materialDesign:HintAssist.Hint="کف بازهٔ کودک"
                                     Text="{Binding MinChild, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,6"
                                     FontFamily="{DynamicResource App.CodeFont}"
                                     ToolTip="مثلاً هموگلوبین کودک ۱۱ تا ۱۴ است" />
                            <TextBox materialDesign:HintAssist.Hint="سقف بازهٔ کودک"
                                     Text="{Binding MaxChild, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,6"
                                     FontFamily="{DynamicResource App.CodeFont}"
                                     ToolTip="مثلاً هموگلوبین کودک ۱۱ تا ۱۴ است" />
                            <TextBox materialDesign:HintAssist.Hint="تا چند سالگی؟ (پیش‌فرض ۱۲)"
                                     Text="{Binding ChildAgeText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontFamily="{DynamicResource App.CodeFont}"
                                     ToolTip="بیمار جوان‌تر از این سن بازهٔ کودک می‌گیرد — بین ۱ تا ۱۸" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ─── بخش ۳: حدود بحرانی — کارت هشدار ─── -->
                <Border Background="#FFF5F5" CornerRadius="10" Padding="12,10" Margin="0,0,0,12"
                        BorderBrush="#EF9A9A" BorderThickness="1.2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <materialDesign:PackIcon Kind="AlertOctagonOutline" Width="18" Height="18"
                                                     Foreground="#C62828" VerticalAlignment="Center" />
                            <TextBlock Text="حدود بحرانی — هشدار فوری پزشک" FontSize="13" FontWeight="Bold"
                                       Foreground="#C62828" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="نتیجهٔ برابر یا خارج از این حدود، هنگام ثبت با دیالوگ مسدودکنندهٔ هشدار به پزشک اعلام می‌شود (مثل پتاسیم کمتر از ۲٫۵ یا بیشتر از ۶٫۲)."
                                   FontSize="10.5" Foreground="#8E3A3A" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBox materialDesign:HintAssist.Hint="حد بحرانی پایین (کمتر از)"
                                         Text="{Binding CriticalLow, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontFamily="{DynamicResource App.CodeFont}"
                                         ToolTip="نتیجهٔ برابر یا کمتر از این مقدار = هشدار فوری" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBox materialDesign:HintAssist.Hint="حد بحرانی بالا (بیشتر از)"
                                         Text="{Binding CriticalHigh, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontFamily="{DynamicResource App.CodeFont}"
                                         ToolTip="نتیجهٔ برابر یا بیشتر از این مقدار = هشدار فوری" />
                            </StackPanel>
                            <!-- متن‌های نمایشی قدیمی — برگهٔ عمومی نتیجه -->
                            <StackPanel Grid.Column="4">
                                <TextBox materialDesign:HintAssist.Hint="متن حد مردان (نمایشی)"
                                         Text="{Binding NormalRangeMale, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         ToolTip="روی برگهٔ چاپی نتیجه نمایش داده می‌شود" />
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBox materialDesign:HintAssist.Hint="متن حد زنان (نمایشی)"
                                         Text="{Binding NormalRangeFemale, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         ToolTip="روی برگهٔ چاپی نتیجه نمایش داده می‌شود" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ پابرگ — خطا + دکمه‌ها ═══ -->
        <Border Grid.Row="2" Background="{DynamicResource MaterialDesign.Brush.Background}" Padding="18,10,18,12"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- خطای اعتبارسنجی/سرور — قرمز و شفاف -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="17" Height="17"
                                             Foreground="#C62828" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" FontSize="11.5"
                               TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="330" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
                    <Button Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#00695C" BorderBrush="#00695C" Foreground="White"
                            MinHeight="38" MinWidth="130" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="15" Height="15" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                            <TextBlock Text="ذخیرهٔ تغییرات" Margin="7,0,0,0" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Button Command="{Binding CancelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                            MinHeight="38" MinWidth="100" Cursor="Hand" Content="انصراف" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
