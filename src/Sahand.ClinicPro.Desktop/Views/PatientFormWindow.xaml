<Window x:Class="Sahand.ClinicPro.Desktop.Views.PatientFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        mc:Ignorable="d"
        Title="{Binding FormTitle}"
        Height="640" Width="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}">
    <!-- ═══════════════════════════════════════════════════════════
         فرم ثبت/ویرایش بیمار — گام U2 طبق پرامپت UI بخش ۱ (فرم ۴)
         ۵ تب: اطلاعات اصلی | بیمه | سوابق پزشکی | تماس اضطراری | اسناد
         ═══════════════════════════════════════════════════════════ -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- عنوان فرم -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="AccountPlus"
                                         Width="24" Height="24"
                                         Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                         VerticalAlignment="Center" />
                <TextBlock Text="{Binding FormTitle}"
                           FontSize="18" FontWeight="Bold"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- پنج تب فرم -->
        <TabControl Grid.Row="1"
                    materialDesign:ColorZoneAssist.Mode="PrimaryLight"
                    Background="Transparent">
            <!-- ═══ تب ۱: اطلاعات اصلی ═══ -->
            <TabItem Header="📋 اطلاعات اصلی">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- ستون راست -->
                        <StackPanel Grid.Column="0">
                            <!-- کد ملی با اعتبارسنجی زنده — چرخه بیستم (گزارش چهاردهم مالک):
                                 هنگام تایپ، زیر فیلد با متن رنگی بازخورد داده می‌شود -->
                            <TextBox materialDesign:HintAssist.Hint="کد ملی *"
                                     Text="{Binding NationalCode, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="10"
                                     FontFamily="Consolas">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NationalCode.Length}" Value="10">
                                                <Setter Property="BorderBrush" Value="#43A047" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBlock Text="{Binding NationalCodeValidationText, Mode=OneWay}"
                                       Foreground="{Binding NationalCodeValidationColor, Mode=OneWay}"
                                       FontSize="10.5" Margin="2,3,2,0"
                                       Visibility="{Binding NationalCodeValidationText, Converter={StaticResource StringToVisibility}}" />
                            <TextBox materialDesign:HintAssist.Hint="نام *"
                                     Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="50" Margin="0,12,0,0" />
                            <TextBox materialDesign:HintAssist.Hint="نام خانوادگی *"
                                     Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="50" Margin="0,12,0,0" />
                            <TextBox materialDesign:HintAssist.Hint="نام پدر"
                                     Text="{Binding FatherName, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="50" Margin="0,12,0,0" />
                            <ComboBox materialDesign:HintAssist.Hint="جنسیت *"
                                      SelectedIndex="{Binding GenderIndex}" Margin="0,12,0,0">
                                <ComboBoxItem Content="مرد" />
                                <ComboBoxItem Content="زن" />
                            </ComboBox>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:PersianDatePicker Grid.Column="0"
                                                            Placeholder="تاریخ تولد"
                                                            DateShamsiText="{Binding BirthDateShamsi, Mode=TwoWay}" />
                                <ComboBox Grid.Column="1"
                                          materialDesign:HintAssist.Hint="خون"
                                          ItemsSource="{Binding BloodTypes}"
                                          SelectedItem="{Binding BloodType}" />
                            </Grid>
                            <ComboBox materialDesign:HintAssist.Hint="وضعیت تأهل"
                                      ItemsSource="{Binding MaritalStates}"
                                      SelectedItem="{Binding MaritalStatus}" Margin="0,12,0,0" />
                        </StackPanel>

                        <!-- ستون چپ -->
                        <StackPanel Grid.Column="2">
                            <TextBox materialDesign:HintAssist.Hint="شماره موبایل * — ۰۹XXXXXXXXX"
                                     Text="{Binding Mobile, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="11" FontFamily="Consolas" />
                            <TextBox materialDesign:HintAssist.Hint="تلفن ثابت"
                                     Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,12,0,0" FontFamily="Consolas" />
                            <TextBox materialDesign:HintAssist.Hint="ایمیل"
                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,12,0,0" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- چرخه ۱۹: استان و شهر از فهرست کشویی — رفع نبودن فیلد شهر (در ستون فاصله‌دار ۱۲px بود) -->
                                <ComboBox Grid.Column="0" materialDesign:HintAssist.Hint="استان"
                                          ItemsSource="{Binding ProvinceOptions}"
                                          SelectedItem="{Binding Province, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox Grid.Column="2" materialDesign:HintAssist.Hint="شهر"
                                          ItemsSource="{Binding CityOptions}"
                                          SelectedItem="{Binding City, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="کد پستی"
                                         Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="10" FontFamily="Consolas" />
                                <!-- چرخه ۱۹: رفع نبودن فیلد شغل — قبلاً در ستون فاصله‌دار ۱۲px بود -->
                                <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="شغل"
                                         Text="{Binding Occupation, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <TextBox materialDesign:HintAssist.Hint="آدرس کامل"
                                     Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="False"
                                     Height="70" Margin="0,12,0,0" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ تب ۲: اطلاعات بیمه ═══ -->
            <TabItem Header="🏥 اطلاعات بیمه">
                <StackPanel Margin="4,14" MaxWidth="460" HorizontalAlignment="Center">
                    <ComboBox materialDesign:HintAssist.Hint="شرکت بیمه اصلی"
                              ItemsSource="{Binding InsuranceCompanies}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding InsuranceCompanyId}" />
                    <TextBox materialDesign:HintAssist.Hint="شماره دفترچه / بیمه"
                             Text="{Binding InsuranceNumber, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,14,0,0" FontFamily="Consolas" />
                    <ComboBox materialDesign:HintAssist.Hint="نوع بیمه"
                              ItemsSource="{Binding InsuranceTypes}"
                              SelectedItem="{Binding InsuranceTypeName}"
                              Margin="0,14,0,0" />
                    <TextBlock Text="🔗 استعلام آنلاین اعتبار بیمه در گام U5 (پذیرش) به این فرامع متصل می‌شود"
                               FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                               Margin="0,18,0,0" />
                </StackPanel>
            </TabItem>

            <!-- ═══ تب ۳: سوابق پزشکی — TagInput سه‌رنگ ═══ -->
            <TabItem Header="💊 سوابق پزشکی">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,14" MaxWidth="560">
                        <!-- چرخه هفدهم (گزارش یازدهم مالک): Mode از TwoWay به OneWay اصلاح شد —
                             پراپرتی‌های تگ در ViewModel فقط getter دارند (ObservableCollection
                             درجا تغییر می‌کند) و TwoWay روی پراپرتی بدون setter همان
                             InvalidOperationException کرش باز شدن فرم بود؛ TagInputControl
                             خودش Items را به همان مجموعه اضافه/حذف می‌کند و OneWay کافی است -->
                        <controls:TagInputControl Title="⚠️ آلرژی‌های شناخته‌شده"
                                                  Placeholder="نام آلرژی را بنویسید و Enter بزنید (مثلاً پنی‌سیلین)"
                                                  Tags="{Binding Allergies, Mode=OneWay}"
                                                  TagBackground="#E53935" />
                        <controls:TagInputControl Title="🏥 بیماری‌های مزمن"
                                                  Placeholder="مثلاً: دیابت نوع ۲ — Enter برای ثبت"
                                                  Tags="{Binding ChronicDiseases, Mode=OneWay}"
                                                  TagBackground="#FB8C00"
                                                  Margin="0,14,0,0" />
                        <controls:TagInputControl Title="💊 داروهای در حال مصرف"
                                                  Placeholder="مثلاً: متفورمین ۵۰۰ — Enter برای ثبت"
                                                  Tags="{Binding CurrentMedications, Mode=OneWay}"
                                                  TagBackground="#1E88E5"
                                                  Margin="0,14,0,0" />
                        <TextBlock Text="این موارد هنگام ویزیت و نسخه‌نویسی به‌صورت هشدار برجسته نمایش داده می‌شوند"
                                   FontSize="11" Opacity="0.55" TextWrapping="Wrap" Margin="0,16,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ تب ۴: تماس اضطراری ═══ -->
            <TabItem Header="👨‍👩‍👧 تماس اضطراری">
                <StackPanel Margin="4,14" MaxWidth="460" HorizontalAlignment="Center">
                    <TextBox materialDesign:HintAssist.Hint="نام تماس اضطراری"
                             Text="{Binding EmergencyContactName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox materialDesign:HintAssist.Hint="تلفن تماس اضطراری"
                             Text="{Binding EmergencyContactPhone, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" Margin="0,14,0,0" />
                    <TextBox materialDesign:HintAssist.Hint="نسبت با بیمار"
                             Text="{Binding EmergencyContactRelation, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,14,0,0" />
                </StackPanel>
            </TabItem>

            <!-- ═══ تب ۵: اسناد ═══ -->
            <TabItem Header="📎 اسناد">
                <StackPanel Margin="4,14" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:EmptyState IconKind="FileUpload"
                                         Message="آپلود عکس پروفایل و اسناد پزشکی (pdf/jpg/png تا ۱۰ مگابایت) در گام U15 متصل می‌شود" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- خطا -->
        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                   FontSize="12" TextWrapping="Wrap"
                   VerticalAlignment="Bottom" Margin="4,0,4,8"
                   Visibility="{Binding ErrorMessage.Length, Converter={StaticResource NullToVisibility}}" />

        <!-- نوار انتظار -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3"
                     VerticalAlignment="Bottom"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <!-- دکمه‌های پایین فرم — طبق مشخصات: انصراف | ذخیره | ذخیره و نوبت -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button Content="← انصراف"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    MinWidth="110" Margin="0,0,10,0" />
            <Button Content="✅ ذخیره (Ctrl+S)"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#2E7D32" BorderBrush="#2E7D32"
                    MinWidth="150" Margin="0,0,10,0"
                    IsDefault="True" />
            <Button Content="💾 ذخیره و نوبت"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    MinWidth="130" />
        </StackPanel>
    </Grid>
</Window>
