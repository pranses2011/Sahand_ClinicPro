<Window x:Class="Sahand.ClinicPro.Desktop.Views.ThemedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="پیام سامانه"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="440"
        FlowDirection="RightToLeft"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextOptions.TextFormattingMode="Ideal">
    <!-- ═══════════════════════════════════════════════════════════
         دیالوگ پیام فارسی راست‌چین تابع تم — چرخه بیست‌ویکم
         (گزارش پانزدهم مالک): «تمامی کادرهای تأیید و پیام که از کادر
         پیش‌فرض ویندوز استفاده می‌شوند را عوض کن و با یک کنترل شخصی‌سازی‌شدهٔ
         زیبا و فارسی و راست‌چین RTL آیکون‌دار تابع تم استفاده کن».
         ظاهر: پوشش نیمه‌تیرهٔ کل صفحه (Dim) + کارت مرکزی با گوشهٔ گرد تم؛
         آیکون بزرگ رنگی مطابق نوع پیام + عنوان + متن + دکمه‌های فارسی.
         ═══════════════════════════════════════════════════════════ -->
    <Grid>
        <!-- پوشش تیرهٔ پس‌زمینه — تمرکز روی پیام -->
        <Border Background="#66000000" MouseLeftButtonDown="OnDimClick" />

        <!-- کارت پیام -->
        <Border x:Name="DialogCard"
                Background="{DynamicResource MaterialDesign.Brush.Background}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                BorderThickness="1"
                CornerRadius="{DynamicResource App.CardRadius}"
                Margin="28"
                VerticalAlignment="Center"
                Padding="22,18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.35" Color="#000000" />
            </Border.Effect>
            <StackPanel>
                <!-- آیکون بزرگ — رنگ/نوع از کد ست می‌شود -->
                <Border x:Name="IconCircle"
                        Width="58" Height="58"
                        CornerRadius="29"
                        HorizontalAlignment="Right"
                        Margin="0,2,0,12">
                    <materialDesign:PackIcon x:Name="IconGlyph"
                                             Width="30" Height="30"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Foreground="White" />
                </Border>

                <!-- عنوان -->
                <TextBlock x:Name="TitleText"
                           FontSize="16" FontWeight="Bold"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap" />

                <!-- متن پیام -->
                <TextBlock x:Name="MessageText"
                           FontSize="13"
                           LineHeight="24"
                           Opacity="0.85"
                           TextWrapping="Wrap"
                           Margin="0,0,0,18" />

                <!-- دکمه‌ها — از کد مطابق نوع پر می‌شوند -->
                <StackPanel x:Name="ButtonsPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
