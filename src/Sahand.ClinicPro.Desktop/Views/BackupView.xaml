<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1000"
             FlowDirection="RightToLeft">
    <!-- ═══ پشتیبان‌گیری و بازیابی — گام U15 طبق فرم ۲۹ ═══ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <materialDesign:PackIcon Kind="DatabaseSync" Width="26" Height="26"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
            <TextBlock Text="پشتیبان‌گیری و بازیابی" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="4">
            <StackPanel Margin="4,4" MaxWidth="1200" HorizontalAlignment="Stretch">

                <!-- ─── وضعیت پشتیبان ─── -->
                <materialDesign:Card Padding="18" Margin="2,4" UniformCornerRadius="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="آخرین پشتیبان کامل" FontSize="11" Opacity="0.65" />
                            <TextBlock Text="{Binding LastFullText}" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="آخرین پشتیبان Log" FontSize="11" Opacity="0.65" />
                            <TextBlock Text="{Binding LastLogText}" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                        <!-- ═══ چرخه ۲۴ — انتخاب فرمت پشتیبان (گزارش هفدهم مالک):
                             «فرمت رو خودمون انتخاب بکنیم» — ZIP فشرده یا BAK خام ═══ -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <ComboBox ItemsSource="{Binding BackupFormats}"
                                      SelectedIndex="{Binding BackupFormatIndex}"
                                      MinWidth="170"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="فرمت پشتیبان"
                                      ToolTip="بازیابی هر دو فرمت را خودکار تشخیص می‌دهد" />
                            <Button Command="{Binding RunBackupCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="BackupRestore" Width="15" Height="15" VerticalAlignment="Center" />
                                    <TextBlock Text="💾 پشتیبان‌گیری فوری" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- ─── تاریخچه پشتیبان‌ها ─── -->
                <TextBlock Text="تاریخچه پشتیبان‌ها" FontSize="14.5" FontWeight="Bold" Margin="2,14,2,8" />
                <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedBackup}"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          HeadersVisibility="Column" FontSize="12" MaxHeight="220"
                          AlternatingRowBackground="#F7FAFD">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="تاریخ" Binding="{Binding DateText, Converter={StaticResource PersianDigits}}" Width="140" />
                        <DataGridTextColumn Header="نوع" Binding="{Binding TypeText, Converter={StaticResource PersianDigits}}" Width="90" />
                        <DataGridTemplateColumn Header="وضعیت" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="9,2" HorizontalAlignment="Center"
                                            Background="{Binding StatusColor}">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="White" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="سایز" Binding="{Binding SizeText, Converter={StaticResource PersianDigits}}" Width="90" FontFamily="Consolas" />
                        <DataGridTextColumn Header="مسیر" Binding="{Binding FilePath, TargetNullValue=—, Converter={StaticResource PersianDigits}}" Width="*" FontFamily="Consolas" FontSize="10.5" />
                        <DataGridTextColumn Header="حالت" Binding="{Binding IsAutomatic, Converter={StaticResource PersianDigits}}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- ═══ جزئیات پشتیبان انتخاب‌شده — چرخه بیست‌ویکم (گزارش پانزدهم مالک):
                     «با کلیک روی بکاپ‌ها جزئیات‌شان را هم نشان بده» — با انتخاب هر ردیف
                     جدول بالا، این کارت جزئیات کامل (زمان پایان، محل ذخیره، فایل ابری و
                     پیام خطا در صورت ناموفقی) را نشان می‌دهد ═══ -->
                <Border Background="#F5F9FF" BorderBrush="#CFE2F5" BorderThickness="1"
                        CornerRadius="10" Padding="12,10" Margin="2,10,2,4"
                        Visibility="{Binding SelectedBackup, Converter={StaticResource NullToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18"
                                                     Foreground="#1565C0" VerticalAlignment="Center" />
                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontWeight="Bold"
                                       FontSize="13">
                                <Run Text="جزئیات پشتیبان — " /><Run Text="{Binding SelectedBackup.DateText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="نوع: " Opacity="0.65" FontSize="11.5" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedBackup.TypeText, Mode=OneWay}" FontSize="11.5" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="حالت: " Opacity="0.65" FontSize="11.5" />
                            <TextBlock Grid.Row="0" Grid.Column="4" FontSize="11.5"
                                       Text="{Binding SelectedBackup.IsAutomatic, Mode=OneWay, Converter={StaticResource BoolToText}}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="پایان: " Opacity="0.65" FontSize="11.5" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedBackup.CompletedText, Mode=OneWay}" FontSize="11.5" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="محل ذخیره: " Opacity="0.65" FontSize="11.5" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding SelectedBackup.StorageText, Mode=OneWay}" FontSize="11.5" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="فایل: " Opacity="0.65" FontSize="11.5" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,4,0,0"
                                       Text="{Binding SelectedBackup.FilePath, Mode=OneWay, TargetNullValue=—}"
                                       FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                        </Grid>
                        <!-- فایل ابری — فقط پشتیبان‌های ابری -->
                        <TextBlock Margin="0,6,0,0" FontSize="11.5" Opacity="0.8"
                                   Text="{Binding SelectedBackup.CloudFileName, Mode=OneWay, TargetNullValue=''}"
                                   Visibility="{Binding SelectedBackup.CloudFileName, Converter={StaticResource NullToVisibility}}" />
                        <!-- پیام خطا — فقط پشتیبان‌های ناموفق -->
                        <Border Background="#FFEBEE" CornerRadius="8" Padding="9,6" Margin="0,8,0,0"
                                Visibility="{Binding SelectedBackup.ErrorMessage, Converter={StaticResource NullToVisibility}}">
                            <TextBlock FontSize="11.5" Foreground="#C62828" TextWrapping="Wrap"
                                       Text="{Binding SelectedBackup.ErrorMessage, Mode=OneWay}" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- دکمه بازیابی از انتخابی — چرخه بیست‌وسوم: بازیابی اکنون واقعی است
                     (سرور ZIP را استخراج و RESTORE DATABASE اجرا می‌کند) -->
                <Button Command="{Binding RestoreCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                        HorizontalAlignment="Left" Margin="2,10,0,4">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Restore" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="🔄 بازیابی از پشتیبان انتخاب‌شده" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding RestoreStatus}" FontSize="11.5" Foreground="#1565C0" Margin="2,4,0,0"
                           Visibility="{Binding RestoreStatus, Converter={StaticResource StringToVisibility}}"
                           TextWrapping="Wrap" />

                <!-- ─── فهرست فایل‌های پشتیبان برای انتخاب دستی بازیابی — چرخه بیست‌وسوم
                     (گزارش شانزدهم مالک: «امکان انتخاب دستی فایل پشتیبان برای بازیابی») ─── -->
                <Border CornerRadius="10" Padding="12,9" Margin="2,12,2,4" Background="#F1F8E9"
                        BorderBrush="#C5E1A5" BorderThickness="1">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Command="{Binding RestoreSelectedFileCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Padding="10,4" FontSize="12">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileRestore" Width="15" Height="15" VerticalAlignment="Center" />
                                    <TextBlock Text="بازیابی فایل انتخاب‌شده" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <!-- ═══ چرخهٔ بیست‌وششم (گزارش هجدهم مالک): «امکان انتخاب فایل
                                 پشتیبانی که در لیست نیست وجود نداره — از هارد یا فلش» —
                                 بارگذاری فایل خارجی و بازیابی مستقل از فهرست برنامه ═══ -->
                            <Button DockPanel.Dock="Left" Command="{Binding RestoreFromExternalFileCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Padding="10,4"
                                    FontSize="12" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Usb" Width="15" Height="15" VerticalAlignment="Center" />
                                    <TextBlock Text="بازیابی از هارد / فلش…" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="📂 فایل‌های پشتیبان پوشهٔ ذخیره (ZIP/BAK — نام شمسی) — برای بازیابی یا حذف، یکی را انتخاب کنید:"
                                       FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"
                                       Margin="0,0,12,0" TextWrapping="Wrap" MaxWidth="420" />
                            <!-- چرخه ۲۴ — حذف دستی فایل پشتیبان قدیمی (گزارش هفدهم مالک) -->
                            <Button Command="{Binding DeleteBackupFileCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Foreground="#C62828" DockPanel.Dock="Right" Margin="0,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock Text="🗑 حذف فایل انتخاب‌شده" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <DataGrid ItemsSource="{Binding BackupFiles}"
                                  SelectedItem="{Binding SelectedBackupFile}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  HeadersVisibility="Column" FontSize="11.5" MaxHeight="190"
                                  Margin="0,9,0,0" AlternatingRowBackground="#F7FAFD">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="نام فایل" Binding="{Binding FileName, Converter={StaticResource PersianDigits}}" Width="*" />
                                <DataGridTextColumn Header="نوع" Binding="{Binding Kind}" Width="Auto" MinWidth="90" />
                                <DataGridTextColumn Header="حجم" Binding="{Binding SizeText, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="105" />
                                <DataGridTextColumn Header="تاریخ فایل" Binding="{Binding DateShamsi}" Width="Auto" MinWidth="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ─── پشتیبان ابری — چرخه سیزدهم (درخواست ۷-۳) ─── -->
                <materialDesign:Card Padding="18" Margin="2,14,2,4" UniformCornerRadius="14"
                                     Background="{DynamicResource MaterialDesign.Brush.Background}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <materialDesign:PackIcon Kind="CloudUpload" Width="22" Height="22" DockPanel.Dock="Right"
                                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
                            <TextBlock Text="☁ پشتیبان ابری" FontSize="14.5" FontWeight="Bold" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                            <Border DockPanel.Dock="Left" CornerRadius="10" Padding="10,3" Background="{Binding CloudStatusColor}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding CloudStatusBadge}" FontSize="11" Foreground="White" />
                            </Border>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="آخرین بارگذاری ابری" FontSize="11" Opacity="0.65" />
                                <TextBlock Text="{Binding CloudLastUploadText}" FontSize="12.5" FontWeight="SemiBold" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="نسخه‌های ابری" FontSize="11" Opacity="0.65" />
                                <TextBlock Text="{Binding CloudVersionsText}" FontSize="12.5" FontWeight="SemiBold" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="حجم کل ابری" FontSize="11" Opacity="0.65" />
                                <TextBlock Text="{Binding CloudTotalSizeText}" FontSize="12.5" FontWeight="SemiBold" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal">
                                <Button Command="{Binding CloudTestCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plug" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="تست اتصال" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="11.5" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding CloudUploadCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CloudUpload" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="بارگذاری آخرین نسخه" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="11.5" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding CloudMessage}" FontSize="11.5" Foreground="#1565C0" Margin="0,8,0,0"
                                   Visibility="{Binding CloudMessage, Converter={StaticResource StringToVisibility}}"
                                   TextWrapping="Wrap" />
                        <Button Command="{Binding CloudVerifyCommand}" Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalAlignment="Left" Margin="0,6,0,0" FontSize="11.5"
                                Visibility="{Binding CanVerifyCloud, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="🧪 تست رمزگشایی نسخه ابری انتخاب‌شده (بدون بازیابی)" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- ═══ فعال‌سازی و تنظیم پشتیبان ابری — چرخه بیستم (گزارش چهاردهم مالک):
                             «جایی برای فعال و تنظیم کردن پشتیبان ابری نیست» ═══ -->
                        <Expander Header="⚙️ فعال‌سازی و تنظیم پشتیبان ابری" FontSize="12.5" FontWeight="SemiBold"
                                  Margin="0,10,0,0" IsExpanded="False">
                            <Border Padding="12,10" CornerRadius="10" Background="#F7FAFD">
                                <StackPanel MaxWidth="640" HorizontalAlignment="Stretch">
                                    <TextBlock Text="ارائه‌دهندهٔ مقصد ابری:" FontSize="11.5" Margin="2,4,2,4" />
                                    <ComboBox ItemsSource="{Binding CloudProviderOptions}"
                                              SelectedIndex="{Binding CloudProviderIndex}"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                                    <!-- فیلدهای S3 — فقط وقتی ارائه‌دهندهٔ S3 انتخاب شده -->
                                    <StackPanel Visibility="{Binding CloudProviderIndex, Converter={StaticResource SectionToVisibility}, ConverterParameter=1}" Margin="0,8,0,0">
                                        <TextBlock Text="نشانی نقطهٔ اتصال (Endpoint) — مثل s3.ir-thr-at1.arvanstorage.ir" FontSize="11" Margin="2,6,2,3" />
                                        <TextBox Text="{Binding CloudEndpoint, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="11.5" />
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="نام سطل (Bucket)" FontSize="11" Margin="2,4,2,3" />
                                                <TextBox Text="{Binding CloudBucket, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="11.5" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="ناحیه (Region)" FontSize="11" Margin="2,4,2,3" />
                                                <TextBox Text="{Binding CloudRegion, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="11.5" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="پیشوند کلیدها در سطل (Prefix)" FontSize="11" Margin="2,8,2,3" />
                                        <TextBox Text="{Binding CloudPrefix, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="11.5" />
                                    </StackPanel>

                                    <!-- پوشهٔ محلی — فقط وقتی ارائه‌دهندهٔ local انتخاب شده -->
                                    <StackPanel Visibility="{Binding CloudProviderIndex, Converter={StaticResource SectionToVisibility}, ConverterParameter=2}" Margin="0,8,0,0">
                                        <TextBlock Text="پوشهٔ مقصد (روی سرور — مثل D:\CloudBackups یا مسیر شبکه)" FontSize="11" Margin="2,4,2,3" />
                                        <TextBox Text="{Binding CloudLocalFolder, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="11.5" />
                                    </StackPanel>

                                    <!-- کلیدهای دسترسی — خالی یعنی حفظ مقدار قبلی -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="کلید دسترسی (Access Key)" FontSize="11" Margin="2,4,2,3" />
                                            <TextBox Text="{Binding CloudAccessKey, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="11.5" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="کلید رمزی (Secret Key)" FontSize="11" Margin="2,4,2,3" />
                                            <TextBox Text="{Binding CloudSecretKey, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="11.5" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock FontSize="10" Opacity="0.6" Margin="2,4,0,0" TextWrapping="Wrap"
                                               Text="{Binding CloudHasStoredKeys, Converter={StaticResource BoolToText}, ConverterParameter=YesNo, Mode=OneWay}" />
                                    <TextBlock Text="«بله» یعنی کلیدها از قبل ذخیره‌اند — کادرهای خالی مقدار قبلی را حفظ می‌کنند." FontSize="10" Opacity="0.55" Margin="2,2,0,6" TextWrapping="Wrap" />

                                    <TextBlock Text="کلید رمزنگاری AES-256 فایل‌ها (اختیاری — برای رمزنگاری نسخه‌های ابری)" FontSize="11" Margin="2,4,2,3" />
                                    <TextBox Text="{Binding CloudEncryptionKey, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="11.5" />

                                    <CheckBox Content="بارگذاری خودکار به ابر پس از هر پشتیبان موفق" IsChecked="{Binding CloudAutoUpload}" Margin="2,10,2,6" />

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                        <Button Command="{Binding SaveCloudConfigCommand}" Style="{StaticResource MaterialDesignRaisedButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14" VerticalAlignment="Center" />
                                                <TextBlock Text="ذخیرهٔ تنظیمات ابری" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding CloudTestCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="8,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Plug" Width="14" Height="14" VerticalAlignment="Center" />
                                                <TextBlock Text="تست اتصال" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </materialDesign:Card>

                <!-- ─── تنظیمات بکاپ خودکار ─── -->
                <Expander Header="⚙️ تنظیمات بکاپ خودکار" FontSize="14" FontWeight="SemiBold" Margin="2,14,2,0">
                    <Border Padding="12,8" CornerRadius="10" Background="#F7FAFD">
                        <StackPanel MaxWidth="620" HorizontalAlignment="Stretch">
                            <!-- چرخه بیست‌وسوم: ساعت پشتیبان کامل روزانه از انتخابگر ساعت
                                 (قابل «همهٔ فیلدهای ساعت از کنترل انتخابگر ساعت») -->
                            <CheckBox Content="پشتیبان کامل روزانه در ساعت:" IsChecked="{Binding DailyFullEnabled}" Margin="2,6" />
                            <controls:TimePicker TimeText="{Binding DailyFullTime, Mode=TwoWay}"
                                                 HorizontalAlignment="Left" Margin="26,2,0,8" />
                            <CheckBox Content="بکاپ Differential هر (ساعت):" IsChecked="{Binding DiffEnabled}" Margin="2,6" />
                            <TextBox Text="{Binding DiffHours}" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Width="110" HorizontalAlignment="Left" Margin="26,2,0,8" FontFamily="Consolas" />
                            <CheckBox Content="بکاپ Transaction Log هر (ساعت):" IsChecked="{Binding LogEnabled}" Margin="2,6" />
                            <TextBox Text="{Binding LogHours}" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Width="110" HorizontalAlignment="Left" Margin="26,2,0,8" FontFamily="Consolas" />

                            <TextBlock Text="مسیر ذخیره محلی:" FontSize="12" Margin="2,10,0,4" />
                            <TextBox Text="{Binding BackupPath}" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontFamily="Consolas" FontSize="11.5" />

                            <Grid Margin="2,12,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="نگهداری کامل (روز)" FontSize="11" Opacity="0.7" />
                                    <TextBox Text="{Binding KeepFullDays}" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="نگهداری Diff (روز)" FontSize="11" Opacity="0.7" />
                                    <TextBox Text="{Binding KeepDiffDays}" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="نگهداری Log (ساعت)" FontSize="11" Opacity="0.7" />
                                    <TextBox Text="{Binding KeepLogHours}" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontFamily="Consolas" />
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="رمزنگاری فایل بکاپ (AES-256)" IsChecked="{Binding EncryptBackup}" Margin="2,12,2,6" />
                            <CheckBox Content="ارسال نوتیفیکیشن در صورت خطا" IsChecked="{Binding NotifyOnError}" Margin="2,6" />

                            <Button Command="{Binding SaveAutoSettingsCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                    HorizontalAlignment="Left" Margin="0,12,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" Width="15" Height="15" VerticalAlignment="Center" />
                                    <TextBlock Text="💾 ذخیره تنظیمات" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
