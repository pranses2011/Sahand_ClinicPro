<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.BranchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             FlowDirection="RightToLeft"
             FontFamily="Vazirmatn, Segoe UI, Tahoma">
    <!-- ═══ مدیریت شعبه‌ها — گام U17 چندشعبه‌ای ═══ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <materialDesign:PackIcon Kind="HomeGroup" Width="26" Height="26"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
            <TextBlock Text="مدیریت شعبه‌ها" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- فرم ثبت سریع -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBox materialDesign:HintAssist.Hint="نام شعبه جدید"
                     Text="{Binding NewBranchName, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="220" Margin="0,0,8,6" />
            <TextBox materialDesign:HintAssist.Hint="شهر"
                     Text="{Binding NewBranchCity, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="150" Margin="0,0,8,6" />
            <Button Command="{Binding AddBranchCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,6">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                    <TextBlock Text="افزودن شعبه" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding LoadCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,6">
                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" />
            </Button>
        </WrapPanel>

        <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <DataGrid Grid.Row="3" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  HeadersVisibility="Column" FontSize="12" AlternatingRowBackground="#F7FAFD">
            <DataGrid.Columns>
                <DataGridTextColumn Header="نام شعبه" Binding="{Binding Name}" Width="200" FontWeight="SemiBold" />
                <DataGridTextColumn Header="کد" Binding="{Binding Code, TargetNullValue=—}" Width="100" FontFamily="Consolas" />
                <DataGridTextColumn Header="شهر" Binding="{Binding City, TargetNullValue=—}" Width="120" />
                <DataGridTextColumn Header="استان" Binding="{Binding Province, TargetNullValue=—}" Width="120" />
                <DataGridTextColumn Header="تلفن" Binding="{Binding Phone, TargetNullValue=—}" Width="130" FontFamily="Consolas" />
                <DataGridTextColumn Header="اصلی" Binding="{Binding MainText}" Width="90" />
                <DataGridTemplateColumn Header="عملیات" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                        Command="{Binding DataContext.SetMainCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" ToolTip="تعیین به‌عنوان شعبه اصلی" Margin="2,0">
                                    <materialDesign:PackIcon Kind="StarOutline" Width="15" Height="15" />
                                </Button>
                                <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                        Command="{Binding DataContext.DeleteBranchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" ToolTip="حذف شعبه" Foreground="#C62828" Margin="2,0">
                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="15" Height="15" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
