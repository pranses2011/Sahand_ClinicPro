<Window x:Class="Sahand.ClinicPro.Desktop.Views.JournalEntryDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="جزئیات سند حسابداری"
        Height="600" Width="860"
        MinHeight="460" MinWidth="700"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}">
    <!-- ═══════════════════════════════════════════════════════════
         جزئیات کامل یک سند حسابداری — چرخهٔ چهل‌وهفتم (گزارش مالک):
         «در صفحه حسابداری و تب دفتر روزنامه، با دابل کلیک بر روی یک سند،
         جزئیات کاملش رو بهمون نشون بده» — سربرگ سند (شماره/تاریخ/وضعیت/
         شرح) + همهٔ سطرها (کد و عنوان حساب، شرح سطر، بدهکار، بستانکار) +
         پانوشت جمع‌ها. بارگذاری با GET accounting/entries/{id} در خود
         کدِ پشت انجام می‌شود (پنجرهٔ گفت‌وگویی بی‌واسطه — هم‌الگوی
         PrescriptionDetailWindow).
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ سربرگ سند ═══ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Border DockPanel.Dock="Right" Width="44" Height="44" CornerRadius="12"
                    Background="#EDF3FA" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="FileDocumentOutline" Width="23" Height="23"
                                         Foreground="#1565C0"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock FontSize="16" FontWeight="Bold">
                    <Run Text="سند " />
                    <!-- ═══ چرخهٔ ۶۷ (گزارش مالک: کرش XamlParseException با دابل‌کلیک روی سند) ═══
                         بایندینگ Run.Text پیش‌فرض TwoWay است؛ EntryNumberText ست‌کنندهٔ private
                         دارد (فقط‌خواندنی از دید بایندینگ) ⇒ InvalidOperationException هنگام
                         InitializeComponent. Mode=OneWay صریح — هم‌الگوی TotalDebit/TotalCredit
                         پایین همین فایل که از چرخهٔ ۴۷ درست‌اند. -->
                    <Run Text="{Binding EntryNumberText, Mode=OneWay}" FontFamily="{DynamicResource App.CodeFont}" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding DateText}" FontSize="11.5" Opacity="0.7" VerticalAlignment="Center" />
                    <Border CornerRadius="9" Padding="8,2" Margin="10,0,0,0"
                            Background="{Binding StatusColor}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" FontSize="10.5" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- ═══ شرح سند ═══ -->
        <Border Grid.Row="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,10"
                Background="#F5F7FB" BorderBrush="#E0E0E0" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="TextSubject" Width="15" Height="15"
                                         Foreground="#1565C0" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Description}" FontSize="12.5"
                           TextWrapping="Wrap" VerticalAlignment="Center"  Foreground="#1F2937"/>
            </StackPanel>
        </Border>

        <!-- ═══ سطرهای سند ═══ -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Lines}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column"
                  FontSize="12"
                  materialDesign:DataGridAssist.CellPadding="8,6">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ردیف" Binding="{Binding LineNo, Converter={StaticResource PersianDigits}}" Width="Auto" FontFamily="{DynamicResource App.CodeFont}" />
                <DataGridTextColumn Header="کد حساب" Binding="{Binding AccountCode, TargetNullValue=—, Converter={StaticResource PersianDigits}}" Width="Auto" FontFamily="{DynamicResource App.CodeFont}" />
                <DataGridTextColumn Header="حساب" Binding="{Binding AccountName, Converter={StaticResource PersianDigits}}" Width="2*" />
                <DataGridTextColumn Header="شرح سطر" Binding="{Binding Description, TargetNullValue=—, Converter={StaticResource PersianDigits}}" Width="1.6*" />
                <DataGridTextColumn Header="بدهکار" Binding="{Binding Debit, Mode=OneWay, Converter={StaticResource CurrencyRial}}" Width="Auto" FontFamily="{DynamicResource App.CodeFont}" />
                <DataGridTextColumn Header="بستانکار" Binding="{Binding Credit, Mode=OneWay, Converter={StaticResource CurrencyRial}}" Width="Auto" FontFamily="{DynamicResource App.CodeFont}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- ═══ پانوشت جمع‌ها + بستن ═══ -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="10" Padding="12,7" Margin="0,0,8,0"
                        Background="#FFF8E1" BorderBrush="#F0E0A0" BorderThickness="1">
                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="#1F2937">
                        <Run Text="جمع بدهکار: " />
                        <Run Text="{Binding TotalDebit, Mode=OneWay, Converter={StaticResource CurrencyRial}}"
                             FontFamily="{DynamicResource App.CodeFont}" />
                    </TextBlock>
                </Border>
                <Border CornerRadius="10" Padding="12,7"
                        Background="#E8F5E9" BorderBrush="#B7DFC0" BorderThickness="1">
                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="#1F2937">
                        <Run Text="جمع بستانکار: " />
                        <Run Text="{Binding TotalCredit, Mode=OneWay, Converter={StaticResource CurrencyRial}}"
                             FontFamily="{DynamicResource App.CodeFont}" />
                    </TextBlock>
                </Border>
            </StackPanel>
            <Button Grid.Column="1" Click="OnCloseClick"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    MinWidth="110" MinHeight="40" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CloseCircleOutline" Width="15" Height="15" VerticalAlignment="Center" />
                    <TextBlock Text="بستن" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
