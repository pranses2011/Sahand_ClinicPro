<Window x:Class="Sahand.ClinicPro.Desktop.Views.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:behaviors="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        Title="ثبت پرداخت"
        Width="480"
        SizeToContent="Height" MinHeight="480" MaxHeight="680"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!-- ═══ چرخهٔ ۷۰ (گزارش مالک — هم‌الگوی فرم پرداخت پذیرش) ═══
         ارتفاع ثابت حذف و SizeToContent=Height نشست تا پیام خطا و نوار
         مشغولیت، دکمه‌های ثبت/انصراف را از لبهٔ پایین بیرون نزند. -->
    <!-- ═══════════════════════════════════════════════════════════
         فرم ثبت پرداخت — گام V5
         ═══════════════════════════════════════════════════════════ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28">
        <TextBlock Text="ثبت پرداخت فاکتور" Style="{StaticResource SectionTitle}" />

        <TextBlock FontSize="13" Opacity="0.8" Margin="0,0,0,12">
            <Run Text="مبلغ باقیمانده فاکتور: " />
            <Run Text="{Binding RemainingAmount, Mode=OneWay, Converter={StaticResource CurrencyRial}}" FontWeight="Bold" />
            <!-- چرخهٔ بیست‌وهفتم: واحد پول پویا از تنظیمات (ریال/تومان) — حذف هاردکد -->
            <Run Text=" " /><Run Text="{DynamicResource App.CurrencyLabel}" />
        </TextBlock>

        <StackPanel IsEnabled="{Binding CanEditPayment}">
        <!-- چرخه بیستم: کادر مبلغ با جداکنندهٔ زندهٔ ۳ رقمی — چرخهٔ بیست‌وهفتم: واحد پول پویا (پیشوند + بدون هاردکد) -->
        <TextBox behaviors:MoneyInput.IsEnabled="True"
                 behaviors:MoneyInput.NumericValue="{Binding Amount, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MoneyRial}}"
                 materialDesign:TextFieldAssist.PrefixText="{DynamicResource App.CurrencyLabel}"
                 Margin="0,0,0,12">
            <materialDesign:HintAssist.Hint>
                <TextBlock><Run Text="مبلغ پرداخت *" /></TextBlock>
            </materialDesign:HintAssist.Hint>
        </TextBox>

        <ComboBox materialDesign:HintAssist.Hint="روش پرداخت"
                  SelectedIndex="{Binding MethodIndex}"
                  Margin="0,0,0,12">
            <ComboBoxItem Content="نقدی" />
            <ComboBoxItem Content="کارتخوان" />
            <ComboBoxItem Content="آنلاین" />
            <ComboBoxItem Content="چک" />
            <ComboBoxItem Content="حساب به حساب" />
        </ComboBox>

        <TextBox materialDesign:HintAssist.Hint="شماره پیگیری / مرجع"
                 Text="{Binding ReferenceNumber, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,12" />

        <TextBox materialDesign:HintAssist.Hint="چهار رقم آخر کارت"
                 Text="{Binding CardNumber, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="4"
                 Margin="0,0,0,16" />

        </StackPanel>

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />

        <UniformGrid Columns="2">
            <Button Command="{Binding SaveCommand}" IsEnabled="{Binding CanEditPayment}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="ثبت پرداخت" Height="42" Margin="4" />
            <Button Command="{Binding CancelCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="انصراف" Height="42" Margin="4" />
        </UniformGrid>

        <Button Command="{Binding RetryPaymentCommand}" IsEnabled="{Binding CanRetryPayment}"
                Visibility="{Binding IsPaymentOutcomeUnknown, Converter={StaticResource BoolToVis}}"
                Style="{StaticResource MaterialDesignOutlinedButton}" Content="ارسال دوباره همان درخواست" Height="42" Margin="4" />
        <TextBlock Visibility="{Binding IsPaymentOutcomeUnknown, Converter={StaticResource BoolToVis}}"
                   Text="ارسال دوباره ممکن است در صورت ثبت‌نشدن درخواست قبلی، پرداخت را ثبت کند؛ ابتدا دریافت وجه و سوابق را بررسی کنید. بازیابی فقط روی همین رایانه و حساب ویندوز است."
                   TextWrapping="Wrap" Foreground="#B00020" Margin="4" />

        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
    </StackPanel>
    </ScrollViewer>
</Window>