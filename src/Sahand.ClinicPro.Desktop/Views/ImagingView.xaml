<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.ImagingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1080"
             FlowDirection="RightToLeft">
    <!-- ═══ تصویربرداری — چرخهٔ چهل‌وسوم (گزارش مالک): «دندانپزشکی و چشم پزشکی و
         تصویربرداری و فزیوتراپی در یک صفحه و تب‌های جداگانه هستند. برای هر
         کدوم یک صفحه مستقل طراحی بکن تا با همدیگه تداخلی نداشته باشن» —
         محتوای این تب از پاراکلینیکِ سابقِ تب‌دار جدا شد و اکنون صفحهٔ
         اختصاصی مستقل خودش است؛ تمام منطق و اتصال‌ها بدون تغییر منتقل شدند. ═══ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <materialDesign:PackIcon Kind="CameraBurst" Width="26" Height="26"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
            <TextBlock Text="تصویربرداری" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- محتوای صفحه — عیناً از تب پاراکلینیک سابق (اتصال‌ها بدون تغییر) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                            <StackPanel MaxWidth="680" HorizontalAlignment="Center">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding ImagingPatientSearch, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="🔍 بیمار (کد ملی / موبایل)">
                                        <!-- چرخه بیست‌وسوم: Enter = دکمهٔ جستجو -->
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SearchImagingPatientCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="1" Command="{Binding SearchImagingPatientCommand}" Margin="8,0,0,0"
                                            Style="{StaticResource MaterialDesignRaisedButton}">
                                        <materialDesign:PackIcon Kind="Magnify" Width="14" Height="14" />
                                    </Button>
                                </Grid>
                                <Border Background="#E3F2FD" CornerRadius="8" Padding="10,5" Margin="0,0,0,10"
                                        Visibility="{Binding ImagingPatient, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock Text="{Binding ImagingPatient.FullName, Mode=OneWay}" FontWeight="SemiBold"  Foreground="#1F2937"/>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="نوع تصویربرداری" FontSize="10.5" Opacity="0.6" />
                                        <ComboBox ItemsSource="{Binding ImagingTypes}" SelectedIndex="{Binding ImagingTypeIndex}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="ناحیه بدن" FontSize="10.5" Opacity="0.6" />
                                        <ComboBox ItemsSource="{Binding BodyRegions}" SelectedItem="{Binding ImagingRegion}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="اطلاعات بالینی" FontSize="10.5" Opacity="0.6" Margin="2,10,2,2" />
                                <TextBox Text="{Binding ImagingClinicalInfo, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                         TextWrapping="Wrap" Height="66" />

                                <CheckBox Content="فوری" IsChecked="{Binding ImagingUrgent}" Margin="2,8,0,0" FontWeight="SemiBold" />

                                <Button Command="{Binding SaveImagingOrderCommand}" Margin="0,14,0,0" HorizontalAlignment="Left"
                                        Style="{StaticResource MaterialDesignRaisedButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Camera" Width="15" Height="15" VerticalAlignment="Center" />
                                        <TextBlock Text="✅ ثبت درخواست تصویربرداری" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>

                                <!-- ═══ بخش فایل‌های DICOM — گام R4 ═══ -->
                                <Separator Margin="0,16,0,12" />
                                <TextBlock Text="🖼 فایل‌های تصویر و DICOM" FontWeight="Bold" FontSize="13.5"
                                           Margin="2,0,0,6" />

                                <WrapPanel Margin="0,0,0,8">
                                    <Button Command="{Binding LoadImagingOrdersCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}" Content="🔄 درخواست‌های امروز" />
                                    <Button Command="{Binding UploadImagingFileCommand}" Margin="8,0,0,0"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Content="⬆ بارگذاری فایل" IsEnabled="{Binding HasSelectedImagingOrder}" />
                                    <Button Command="{Binding OpenDicomViewerCommand}" Margin="8,0,0,0"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Content="🩻 نمایش DICOM" />
                                </WrapPanel>

                                <TextBlock Text="درخواست تصویربرداری (انتخاب برای اتصال فایل)" FontSize="10.5" Opacity="0.6" Margin="2,2,2,3" />
                                <ComboBox ItemsSource="{Binding ImagingOrders}" SelectedItem="{Binding SelectedImagingOrder}"
                                          DisplayMemberPath="Display" MaxDropDownHeight="260" Margin="0,0,0,8" />

                                <DataGrid ItemsSource="{Binding ImagingFiles}" SelectedItem="{Binding SelectedImagingFile}"
                                          AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220"
                                          Style="{StaticResource App.TableDataGrid}"
                                          HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="نام فایل" Binding="{Binding FileName, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                                        <DataGridTextColumn Header="نوع" Binding="{Binding KindText, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                                        <DataGridTextColumn Header="حجم" Binding="{Binding SizeText, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                                        <DataGridTemplateColumn Header="عملیات" Width="Auto" MinWidth="70" MaxWidth="420">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <!-- چرخهٔ ۷۹: کلید عملیاتی آیکونی (هم‌الگوی لیست بیماران) -->
                                                    <Button Command="{Binding DataContext.DeleteImagingFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource App.RowIconButton}" Foreground="#C62828"
                                                            ToolTip="حذف فایل تصویر" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="15" Height="15" VerticalAlignment="Center"/>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </ScrollViewer>
    </Grid>
</UserControl>
