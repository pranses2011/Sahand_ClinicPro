<UserControl xmlns:shortcuts="clr-namespace:Sahand.ClinicPro.Desktop.Services" x:Class="Sahand.ClinicPro.Desktop.Views.ConsumablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="680" d:DesignWidth="1120"
             FlowDirection="RightToLeft">
    <!-- ═══════════════════════════════════════════════════════════
         صفحهٔ لوازم مصرفی درمانگاه — چرخهٔ چهل‌ویکم (گزارش مالک):
         «احتمال داره یک درمانگاه ماژول داروخانه رو نداشته باشه و اونموقع
         نمیتونه لوازم مصرفی رو تعریف و استفاده بکنه» — نقطهٔ مدیریتیِ مستقلِ
         مصرفی‌ها: تعریف قلم + ورود کالا + پایش موجودی/کمبود/انقضا؛ همه روی
         اندپوینت‌های api/v1/consumables خارج از گیت ماژول لایسنس داروخانه.
         چیدمان: سربرگ + دکمه‌های مدیریتی (Admin/Manager) + چیپ‌های خلاصه +
         نوار پالایش + جدول بچ‌ها.
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ سربرگ + دکمه‌های مدیریتی ═══ -->
        <!-- ═══ چرخهٔ ۴۵ (گزارش مالک: «ظاهر صفحات… لوازم مصرفی… رو خیلی حرفه ای تر
             و زیباتر بکن») — سربرگ گرادیانی برند با دکمه‌های مدیریتیِ روی خودش؛
             هم‌الگوی سایر صفحات بازطراحی‌شده: نشان شیشه‌ای + عنوان/زیرعنوان +
             دکمه‌های مدیریت در گوشهٔ چپ فیزیکی (RTL) ═══ -->
        <Border Grid.Row="0" CornerRadius="14" Padding="16,10" Margin="0,0,0,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#00838F" Offset="0" />
                    <GradientStop Color="#004D55" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.16" Color="#00352C" />
            </Border.Effect>
            <DockPanel>
                <!-- دکمه‌های مدیریتی — گوشهٔ چپ فیزیکی (RTL)؛ فقط Admin/Manager -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
                    <Button Command="{Binding AddItemCommand}" Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="White" MinHeight="36" MinWidth="122" Margin="0,0,6,0"
                            ToolTip="ساخت قلم مصرفی جدید — سرنگ/سرم/گاز استریل و…">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlusBox" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="قلم مصرفی جدید" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button shortcuts:SaveShortcut.Number="1" Command="{Binding StockInCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                            Foreground="White" Background="#F57C00" BorderBrush="#F57C00"
                            MinHeight="36" Margin="0,0,6,0"
                            ToolTip="ثبت خرید — تک‌ردیفی یا دسته‌جمعی (چرخهٔ ۴۵)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PackageDown" Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="ورود کالا (Ctrl+Shift+1)" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding LoadCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="White" MinHeight="36" MinWidth="42"
                            ToolTip="بارگذاری مجدد فهرست بچ‌ها از سرور">
                        <materialDesign:PackIcon Kind="Refresh" Width="15" Height="15" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="22" VerticalAlignment="Center" Margin="0,0,12,0"
                            Background="#33FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1">
                        <materialDesign:PackIcon Kind="Syringe" Width="22" Height="22"
                                                 Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="لوازم مصرفی درمانگاه" FontSize="17" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="مستقل از ماژول داروخانه — تعریف قلم، خرید و مصرف در پذیرش"
                                   FontSize="10.5" Foreground="#C5E8EC" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ راهنمای صفحه ═══ -->
        <TextBlock Grid.Row="1" FontSize="12" Opacity="0.65" Margin="2,0,0,8" TextWrapping="Wrap"
                   Text="سرنگ، سرم، گاز استریل و اقلام مشابه — هنگام پذیرش خدمتی مصرف می‌شوند و هزینه‌شان خودکار به فاکتور بیمار می‌نشیند. این صفحه مستقل از ماژول داروخانه است و به لایسنس Pharmacy نیازی ندارد." />

        <!-- ═══ چرخهٔ ۴۶ (گزارش مالک: چیدمان حرفه‌ای) — چهار کارت آماری «وضعیت در یک نگاه» ═══
             چیپ‌های تختِ پیشین به کارت‌های هم‌قدِ زبان طراحی مشترک ارتقا یافتند:
             نشان آیکونی رنگی + عدد درشت فونت کد + زیرعنوان ریز — کاربر انباردار
             پیش از اسکرول جدول، سلامت انبار را می‌فهمد. اعداد از کل داده‌اند
             (مستقل از جستجو) تا پالایش، معنا را جابه‌جا نکند. -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,10">
            <!-- کارت ۱: شمار اقلام تعریف‌شده (بچ‌ها به قلم تجمیع شده) -->
            <Border Style="{StaticResource App.StatCard}" Margin="0,0,6,0"
                    ToolTip="شمار اقلام مصرفی تعریف‌شده (بچ‌ها به قلم تجمیع شده‌اند)">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource App.StatIcon}"
                            Background="#E3F2FD" BorderBrush="#BBDEFB" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="Syringe" Width="21" Height="21"
                                                 Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource App.StatValue}"
                                   Text="{Binding ItemsCount, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                        <TextBlock Style="{StaticResource App.StatLabel}" Text="قلم تعریف‌شده" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- کارت ۲: بچ‌های زیر نقطه سفارش — رنگ هشدار کهربایی -->
            <Border Style="{StaticResource App.StatCard}" Margin="6,0,6,0"
                    ToolTip="بچ‌های زیر نقطه سفارش — پیش از اتمام، ورود کالا ثبت کنید">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource App.StatIcon}"
                            Background="#FFF3E0" BorderBrush="#FFE0B2" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="PackageDown" Width="21" Height="21"
                                                 Foreground="#E65100" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource App.StatValue}" Foreground="#BF360C"
                                   Text="{Binding LowStockCount, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                        <TextBlock Style="{StaticResource App.StatLabel}" Text="کمبود موجودی" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- کارت ۳: انقضای ۹۰ روز آینده — صورتی هشدار -->
            <Border Style="{StaticResource App.StatCard}" Margin="6,0,6,0"
                    ToolTip="بچ‌هایی که در ۹۰ روز آینده منقضی می‌شوند">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource App.StatIcon}"
                            Background="#FCE4EC" BorderBrush="#F8BBD0" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="ClockAlertOutline" Width="21" Height="21"
                                                 Foreground="#AD1457" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource App.StatValue}" Foreground="#880E4F"
                                   Text="{Binding ExpiringCount, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                        <TextBlock Style="{StaticResource App.StatLabel}" Text="نزدیک انقضا" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- کارت ۴: ارزش ریالی کل انبار مصرفی — سبز مالی -->
            <Border Style="{StaticResource App.StatCard}" Margin="6,0,0,0"
                    ToolTip="جمع ارزش فروش کل موجودی مصرفی (موجودی × قیمت فروش هر بچ)">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource App.StatIcon}"
                            Background="#E8F5E9" BorderBrush="#C8E6C9" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="CashMultiple" Width="21" Height="21"
                                                 Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <!-- ارقام بلند فونت کد از ۱۵px می‌کاهد تا در عرض کارت جا شود -->
                        <TextBlock Style="{StaticResource App.StatValue}" FontSize="15" Foreground="#1B5E20"
                                   Text="{Binding TotalValueText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource App.StatLabel}" Text="ارزش کل انبار" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>

        <ProgressBar Grid.Row="3" IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!-- ═══ جدول بچ‌ها + نوار پالایش ═══ -->
        <Border Grid.Row="4" CornerRadius="12" Padding="10"
                Background="{DynamicResource MaterialDesign.Brush.Background}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- نوار پالایش: جستجو + سوییچ کمبود -->
                <DockPanel Grid.Row="0" Margin="2,0,2,8">
                    <TextBox DockPanel.Dock="Right" Width="260" Margin="12,0,0,0" FontSize="12.5"
                             VerticalAlignment="Center"
                             materialDesign:HintAssist.Hint="جستجوی قلم یا شماره بچ"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                    <CheckBox DockPanel.Dock="Left" Content="فقط بچ‌های کمبود"
                              IsChecked="{Binding LowStockOnly}"
                              FontSize="12.5" VerticalAlignment="Center"
                              HorizontalAlignment="Left"
                              ToolTip="موجودیِ زیر نقطه سفارش — از سرور با پارامتر lowStock" />
                </DockPanel>

                <!-- خطای درون‌صفحه‌ای — چرخهٔ ۳۸ (شکست هرگز خاموش نیست) -->
                <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="#C62828"
                           FontSize="12" TextWrapping="Wrap" Margin="2,0,2,6"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />

                <!-- جدول بچ‌ها — استایل مشترک App.DataGrid چرخهٔ ۴۶؛ VisibleBatches
                     شامل پالایش زندهٔ جستجوست -->
                <DataGrid Grid.Row="2" ItemsSource="{Binding VisibleBatches}"
                          Style="{StaticResource App.DataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="قلم مصرفی" Binding="{Binding Name, Converter={StaticResource PersianDigits}}"
                                            Width="Auto" MinWidth="170" FontWeight="SemiBold" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                        <DataGridTextColumn Header="تعداد بچ" Binding="{Binding BatchCount, Converter={StaticResource PersianDigits}}"
                                            Width="Auto" FontFamily="{DynamicResource App.CodeFont}" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                        <DataGridTextColumn Header="موجودی" Binding="{Binding Quantity, Converter={StaticResource PersianDigits}}"
                                            Width="Auto" FontFamily="{DynamicResource App.CodeFont}" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                        <DataGridTextColumn Header="نقطه سفارش" Binding="{Binding ReorderLevel, Converter={StaticResource PersianDigits}}"
                                            Width="Auto" FontFamily="{DynamicResource App.CodeFont}" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                        <DataGridTextColumn Header="قیمت فروش" Binding="{Binding SellPrice, Converter={StaticResource CurrencyRial}}"
                                            Width="Auto" FontFamily="{DynamicResource App.CodeFont}" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                        <DataGridTextColumn Header="قیمت خرید" Binding="{Binding PurchasePrice, Converter={StaticResource CurrencyRial}}"
                                            Width="Auto" FontFamily="{DynamicResource App.CodeFont}" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                        <DataGridTextColumn Header="انقضا" Binding="{Binding ExpiryShamsi, TargetNullValue=—, Converter={StaticResource PersianDigits}}"
                                            Width="Auto" FontFamily="{DynamicResource App.CodeFont}" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                        <DataGridTemplateColumn Header="وضعیت" Width="Auto" MaxWidth="420">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- رنگ وضعیت با تریگر — مبدل اختصاصی لازم نیست (الگوی اتاق‌ها) -->
                                    <Border CornerRadius="10" Padding="10,2.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E8F5E9" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                        <Setter Property="Background" Value="#FFEBEE" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                                                        <Setter Property="Background" Value="#FFF3E0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText, Converter={StaticResource PersianDigits}}" FontSize="11.5" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
