<Window x:Class="Sahand.ClinicPro.Desktop.Views.PrescriptionDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="جزئیات نسخه"
        Height="560" Width="720"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!-- ═══════════════════════════════════════════════════════════
         جزئیات نسخه — گام V4
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Header}" Style="{StaticResource SectionTitle}" />

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  materialDesign:DataGridAssist.CellPadding="8,6">
            <DataGrid.Columns>
                <DataGridTextColumn Header="دارو" Binding="{Binding MedicationName}" Width="2*" />
                <DataGridTextColumn Header="دوز" Binding="{Binding Dosage}" Width="*" />
                <DataGridTextColumn Header="تکرار" Binding="{Binding Frequency}" Width="*" />
                <DataGridTextColumn Header="مدت" Binding="{Binding Duration}" Width="90" />
                <DataGridTextColumn Header="تعداد" Binding="{Binding Quantity}" Width="70" />
                <DataGridTextColumn Header="دستور مصرف" Binding="{Binding Instructions}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                       FontSize="12" Margin="0,0,0,8" />
            <Button Click="OnCloseClick"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="بستن" Height="40" />
        </StackPanel>
    </Grid>
</Window>