<Window x:Class="Sahand.ClinicPro.Desktop.Views.PrescriptionDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="جزئیات نسخه"
        Height="560" Width="720"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!-- ═══════════════════════════════════════════════════════════
         جزئیات نسخه — گام V4
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Header}" Style="{StaticResource SectionTitle}" />

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                 
                  materialDesign:DataGridAssist.CellPadding="8,6">
            <DataGrid.Columns>
                <DataGridTextColumn Header="دارو" Binding="{Binding MedicationName, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Header="دوز" Binding="{Binding Dosage, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Header="تکرار" Binding="{Binding Frequency, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Header="مدت" Binding="{Binding Duration, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Header="تعداد" Binding="{Binding Quantity, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Header="دستور مصرف" Binding="{Binding Instructions, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                       FontSize="12" Margin="0,0,0,8" />
            <!-- چرخه بیست‌وسوم (گزارش شانزدهم مالک): «در صفحه جزئیات نسخه، دکمه
                 چاپ مجدد هم باشد» — دکمهٔ چاپ مجدد کنار بستن؛ سند نسخه از همان
                 داده‌های بارگذاری‌شدهٔ جزئیات ساخته و پیش‌نمایش چاپ (با دکمهٔ
                 ارسال به پرینتر) باز می‌شود -->
            <UniformGrid Columns="2">
                <Button Click="OnReprintClick"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Height="40" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Printer" Width="17" Height="17" VerticalAlignment="Center" />
                        <TextBlock Text="🖨️ چاپ مجدد" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="OnCloseClick"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Content="بستن" Height="40" Margin="4,0,0,0" />
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>