<Window x:Class="Sahand.ClinicPro.Desktop.Views.VisitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding FormTitle}"
        Height="780" Width="920"
        WindowStartupLocation="CenterOwner"
        FontFamily="Vazirmatn, Segoe UI, Tahoma">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!-- ═══════════════════════════════════════════════════════════
         ویرایشگر ویزیت SOAP — گام V3
         بخش ذهنی/عینی/ارزیابی/برنامه + تشخیص ICD-10
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- سربرگ و بیمار -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding FormTitle}"
                       Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding PatientHeader}"
                       VerticalAlignment="Center" HorizontalAlignment="Left"
                       FontSize="13" Opacity="0.8" Margin="12,0,0,0" />
        </DockPanel>

        <!-- پزشک و نوع — فقط ویزیت جدید -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <ComboBox materialDesign:HintAssist.Hint="پزشک *"
                      ItemsSource="{Binding Doctors}"
                      DisplayMemberPath="Name"
                      SelectedIndex="{Binding DoctorIndex}"
                      IsEnabled="{Binding IsNewMode}"
                      Width="240" Margin="0,0,12,0" />
            <ComboBox materialDesign:HintAssist.Hint="نوع ویزیت"
                      SelectedIndex="{Binding TypeIndex}"
                      Width="140" Margin="0,0,12,0">
                <ComboBoxItem Content="اولیه" />
                <ComboBoxItem Content="پیگیری" />
                <ComboBoxItem Content="اورژانسی" />
            </ComboBox>
        </StackPanel>

        <!-- بدنه SOAP -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- شکایت اصلی -->
                <TextBox Grid.Row="0" Grid.ColumnSpan="2"
                         materialDesign:HintAssist.Hint="شکایت اصلی بیمار"
                         Text="{Binding ChiefComplaint, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10" />

                <!-- ذهنی S -->
                <TextBox Grid.Row="1" Grid.Column="0"
                         materialDesign:HintAssist.Hint="S — ذهنی: شرح حال بیمار"
                         Text="{Binding SoapSubjective, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap" AcceptsReturn="True" Height="110"
                         Margin="0,0,6,10" />

                <!-- عینی O -->
                <TextBox Grid.Row="1" Grid.Column="1"
                         materialDesign:HintAssist.Hint="O — عینی: یافته‌های معاینه"
                         Text="{Binding SoapObjective, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap" AcceptsReturn="True" Height="110"
                         Margin="6,0,0,10" />

                <!-- ارزیابی A -->
                <TextBox Grid.Row="2" Grid.Column="0"
                         materialDesign:HintAssist.Hint="A — ارزیابی: تشخیص تفاضلی و نهایی"
                         Text="{Binding SoapAssessment, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap" AcceptsReturn="True" Height="110"
                         Margin="0,0,6,10" />

                <!-- برنامه P -->
                <TextBox Grid.Row="2" Grid.Column="1"
                         materialDesign:HintAssist.Hint="P — برنامه: دارو و اقدام درمانی"
                         Text="{Binding SoapPlan, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap" AcceptsReturn="True" Height="110"
                         Margin="6,0,0,10" />

                <!-- سابقه پزشکی + معاینه فیزیکی -->
                <TextBox Grid.Row="3" Grid.Column="0"
                         materialDesign:HintAssist.Hint="سابقه پزشکی گذشته و حساسیت دارویی"
                         Text="{Binding PastMedicalHistory, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap" AcceptsReturn="True" Height="90"
                         Margin="0,0,6,0" />
                <TextBox Grid.Row="3" Grid.Column="1"
                         materialDesign:HintAssist.Hint="معاینه فیزیکی (شرح کامل)"
                         Text="{Binding PhysicalExamination, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap" AcceptsReturn="True" Height="90"
                         Margin="6,0,0,0" />
            </Grid>
        </ScrollViewer>

        <!-- تشخیص و پاورقی -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- جستجوی تشخیص ICD-10 -->
            <StackPanel Grid.Column="0" Orientation="Vertical">
                <TextBlock Text="تشخیص اصلی (ICD-10) — برای تکمیل ویزیت الزامی"
                           FontSize="12" Opacity="0.8" Margin="0,0,0,4" />
                <DockPanel>
                    <Button DockPanel.Dock="Left"
                            Command="{Binding SearchDiagnosisCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Content="جستجو" Margin="0,0,8,0" />
                    <ComboBox materialDesign:HintAssist.Hint="کد یا شرح تشخیص (مثال J06)"
                              Text="{Binding DiagnosisSearchTerm, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding DiagnosisResults}"
                              SelectedItem="{Binding SelectedDiagnosis}"
                              IsEditable="True"
                              HorizontalAlignment="Stretch" />
                </DockPanel>
                <TextBlock Text="{Binding SelectedDiagnosis.Code, StringFormat='انتخاب فعلی: {0}'}"
                           FontSize="11" Opacity="0.7" Margin="0,4,0,0" />
            </StackPanel>

            <!-- دکمه‌ها -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Command="{Binding SaveDraftCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Content="ذخیره پیش‌نویس" Height="40" Margin="8,0,0,0" />
                <Button Command="{Binding CompleteVisitCommand}"
                        Style="{StaticResource MaterialDesignFilledButton}"
                        Content="تکمیل ویزیت" Height="40" Margin="8,0,0,0" />
            </StackPanel>

            <TextBlock Grid.Column="2"
                       Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                       FontSize="12" VerticalAlignment="Bottom"
                       Margin="12,0,0,0" />
        </Grid>

        <!-- خطا و پیشرفت -->
        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource MaterialDesign.Brush.Error}"
                   FontSize="12" TextWrapping="Wrap"
                   VerticalAlignment="Top" Margin="0,-14,0,0"
                   HorizontalAlignment="Center" />
        <ProgressBar Grid.Row="3" IsIndeterminate="True" Height="4"
                     VerticalAlignment="Top" Margin="0,-22,0,0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
    </Grid>
</Window>