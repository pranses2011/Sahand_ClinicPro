<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="720"
             FlowDirection="RightToLeft">
    <!-- ═══ مرکز اعلان‌ها — گام U14: ۵ نوع + خوانده‌شده ═══ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <materialDesign:PackIcon Kind="BellOutline" Width="26" Height="26"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
            <TextBlock Text="مرکز اعلان‌ها" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CountText}" FontSize="12" Opacity="0.65" Margin="14,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Command="{Binding LoadCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0">
                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" />
            </Button>
            <Button Command="{Binding MarkAllReadCommand}" Style="{StaticResource MaterialDesignOutlinedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CheckAll" Width="14" Height="14" VerticalAlignment="Center" />
                    <TextBlock Text="علامت‌گذاری همه خوانده‌شده" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!-- فهرست اعلان‌ها — کارت به کارت با نوار رنگی نوع -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Notifications}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="2,4" Padding="12,10" CornerRadius="10"
                                Background="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                                Opacity="{Binding RowOpacity, Mode=OneWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- نوار رنگی نوع -->
                                <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{Binding TypeColor}"
                                        Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TypeText}" FontSize="11" Foreground="{Binding TypeColor}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Message, TargetNullValue=''}" FontSize="11.5" Opacity="0.75"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock FontSize="10" Opacity="0.5" Margin="0,3,0,0" FontFamily="{DynamicResource App.CodeFont}">
                                        <TextBlock.Text>
                                            <Binding Path="CreatedAt" Converter="{StaticResource ShamsiDateTime}" />
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconForegroundButton}"
                                        Command="{Binding DataContext.MarkReadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" ToolTip="علامت خوانده‌شده"
                                        Visibility="{Binding IsRead, Converter={StaticResource InverseBoolToVisibility}}">
                                    <materialDesign:PackIcon Kind="EmailOpenOutline" Width="16" Height="16" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
