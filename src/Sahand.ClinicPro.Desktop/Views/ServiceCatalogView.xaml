<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.ServiceCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:behaviors="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1180"
             FlowDirection="RightToLeft">
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- سربرگ مدیریت خدمات -->
        <Border Grid.Row="0" CornerRadius="14" Padding="18,13" Margin="0,0,0,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#174A7E" Offset="0" />
                    <GradientStop Color="#147D83" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="13" Background="#26FFFFFF">
                        <materialDesign:PackIcon Kind="ClipboardList" Width="23" Height="23"
                                                 Foreground="White" HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="مدیریت خدمات" FontSize="19" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="ثبت و نگهداری فهرست خدمات، تعرفه و هزینهٔ تمام‌شده"
                                   FontSize="11.5" Foreground="#D8F3F1" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding NewServiceCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="White" Foreground="#174A7E" Padding="12,7"
                            Margin="0,0,8,0" Content="خدمت جدید" />
                    <Button Command="{Binding LoadCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="White" BorderBrush="#A8DADC" Padding="12,7">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="17" Height="17"
                                                     Foreground="White" VerticalAlignment="Center" />
                            <TextBlock Text="تازه‌سازی" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- خلاصهٔ وضعیت -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
            <Border Style="{StaticResource App.StatCard}" Margin="0,0,8,0" Padding="12,9">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ClipboardCheck" Width="20" Height="20"
                                             Foreground="#2E7D32" VerticalAlignment="Center" />
                    <TextBlock Text="خدمات فعال" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ActiveCount}" FontWeight="Bold" FontSize="17"
                               Foreground="#2E7D32" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource App.StatCard}" Margin="4,0" Padding="12,9">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArchiveOutline" Width="20" Height="20"
                                             Foreground="#757575" VerticalAlignment="Center" />
                    <TextBlock Text="خدمات غیرفعال" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding InactiveCount}" FontWeight="Bold" FontSize="17"
                               Foreground="#757575" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource App.StatCard}" Margin="8,0,0,0" Padding="12,9">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CashMultiple" Width="20" Height="20"
                                             Foreground="#1565C0" VerticalAlignment="Center" />
                    <TextBlock Text="هزینهٔ تمام‌شده برای محاسبهٔ سود ثبت می‌شود"
                               Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- فرم ثبت/ویرایش -->
        <Border Grid.Row="2" Style="{StaticResource App.StatCard}" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <materialDesign:PackIcon Kind="ClipboardEditOutline"
                                             Width="19" Height="19" Foreground="#1565C0"
                                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SaveButtonText}" FontWeight="Bold" FontSize="14"
                               Margin="7,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Margin="0,0,8,0"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="نام خدمت (الزامی)"
                             Text="{Binding ServiceName, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" />
                    <TextBox Grid.Column="1" Margin="4,0,8,0"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="کد خدمت"
                             Text="{Binding ServiceCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" />
                    <TextBox Grid.Column="2" Margin="4,0,8,0"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             behaviors:MoneyInput.IsEnabled="True"
                             behaviors:MoneyInput.NumericValue="{Binding Price, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MoneyRial}}"
                             materialDesign:TextFieldAssist.PrefixText="{DynamicResource App.CurrencyLabel}">
                        <materialDesign:HintAssist.Hint>
                            <TextBlock><Run Text="قیمت فروش (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock>
                        </materialDesign:HintAssist.Hint>
                    </TextBox>
                    <TextBox Grid.Column="3" Margin="4,0,8,0"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             behaviors:MoneyInput.IsEnabled="True"
                             behaviors:MoneyInput.NumericValue="{Binding DefaultCost, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MoneyRial}}"
                             materialDesign:TextFieldAssist.PrefixText="{DynamicResource App.CurrencyLabel}">
                        <materialDesign:HintAssist.Hint>
                            <TextBlock><Run Text="هزینهٔ تمام‌شده (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock>
                        </materialDesign:HintAssist.Hint>
                    </TextBox>
                    <CheckBox Grid.Column="4" Content="فعال" IsChecked="{Binding IsActive}"
                              VerticalAlignment="Center" Margin="8,0,8,0" />
                </Grid>
                <Grid Grid.Row="2" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding SaveServiceCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Content="{Binding SaveButtonText}" Padding="16,7" Margin="4,0" />
                        <Button Command="{Binding ResetFormCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Content="انصراف / فرم تازه" Padding="12,7" Margin="4,0"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- جستجو و فهرست -->
        <Border Grid.Row="3" Style="{StaticResource App.StatCard}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,9">
                    <CheckBox DockPanel.Dock="Left" Content="نمایش غیرفعال‌ها"
                              IsChecked="{Binding ShowInactive}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBox Width="280" HorizontalAlignment="Left"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="جستجو بر اساس نام یا کد"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="نتیجه: " Foreground="#607D8B" />
                        <TextBlock Text="{Binding ResultCount, Mode=OneWay}" Foreground="#607D8B" />
                    </StackPanel>
                </DockPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Style="{StaticResource App.TableDataGrid}"
                          HeadersVisibility="Column" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="کد خدمت" Binding="{Binding ServiceCode, TargetNullValue=—}"
                                            Width="Auto" MinWidth="100" MaxWidth="300"
                                            ElementStyle="{StaticResource App.TableCellTextBlock}" />
                        <DataGridTextColumn Header="نام خدمت" Binding="{Binding ServiceName}"
                                            Width="Auto" MinWidth="180" MaxWidth="420"
                                            ElementStyle="{StaticResource App.TableCellTextBlock}" />
                        <DataGridTextColumn Binding="{Binding Price, Converter={StaticResource CurrencyRial}}"
                                            Width="Auto" MinWidth="130" MaxWidth="300"
                                            ElementStyle="{StaticResource App.TableCellTextBlock}">
                            <DataGridTextColumn.Header>
                                <TextBlock><Run Text="قیمت فروش (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding DefaultCost, Converter={StaticResource CurrencyRial}}"
                                            Width="Auto" MinWidth="140" MaxWidth="300"
                                            ElementStyle="{StaticResource App.TableCellTextBlock}">
                            <DataGridTextColumn.Header>
                                <TextBlock><Run Text="هزینه تمام‌شده (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="وضعیت" Width="Auto" MinWidth="95" MaxWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusColor}" CornerRadius="9"
                                            Padding="9,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" Foreground="White"
                                                   VerticalAlignment="Center" FontSize="10.5" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="عملیات" Width="Auto" MinWidth="110" MaxWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Button Style="{StaticResource App.RowIconButton}" ToolTip="ویرایش خدمت"
                                                Command="{Binding DataContext.EditServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Foreground="#1565C0" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Pencil" Width="17" Height="17" VerticalAlignment="Center"/>
                                        </Button>
                                        <Button Style="{StaticResource App.RowIconButton}" ToolTip="حذف نرم / غیرفعال‌سازی"
                                                Command="{Binding DataContext.DeleteServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Foreground="#C62828"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="17" Height="17" VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
