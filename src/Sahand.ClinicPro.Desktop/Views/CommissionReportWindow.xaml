<Window x:Class="Sahand.ClinicPro.Desktop.Views.CommissionReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:charts="clr-namespace:Sahand.ClinicPro.Desktop.Controls.Charts"
        Title="گزارش تفصیلی سود و حقوق درصدی پرسنل"
        Height="780" Width="1180"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>
    <!-- ═══════════════════════════════════════════════════════════
         پنجره گزارش تفصیلی سود و حقوق درصدی — چرخه دهم
         خلاصه هر پرسنل + جزئیات اقلام + خروجی اکسل دو برگ
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2.2*" />
        </Grid.RowDefinitions>

        <!-- سربرگ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <materialDesign:PackIcon Kind="ChartBoxOutline" Width="26" Height="26"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
            <TextBlock Text="گزارش تفصیلی سود و حقوق درصدی پرسنل" FontSize="19" FontWeight="Bold"
                       Margin="10,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ClinicName}" FontSize="13" Opacity="0.7"
                       Margin="16,4,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- نوار فیلتر و دکمه‌ها -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="دوره:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0" />
            <ComboBox SelectedValue="{Binding SelectedYear}" SelectedValuePath="Content" MinWidth="90" Margin="0,0,8,0">
                <ComboBoxItem Content="1401" /><ComboBoxItem Content="1402" /><ComboBoxItem Content="1403" />
                <ComboBoxItem Content="1404" /><ComboBoxItem Content="1405" />
            </ComboBox>
            <ComboBox SelectedIndex="{Binding SelectedMonthIndex}" MinWidth="105" Margin="0,0,14,0">
                <ComboBoxItem Content="فروردین" /><ComboBoxItem Content="اردیبهشت" /><ComboBoxItem Content="خرداد" />
                <ComboBoxItem Content="تیر" /><ComboBoxItem Content="مرداد" /><ComboBoxItem Content="شهریور" />
                <ComboBoxItem Content="مهر" /><ComboBoxItem Content="آبان" /><ComboBoxItem Content="آذر" />
                <ComboBoxItem Content="دی" /><ComboBoxItem Content="بهمن" /><ComboBoxItem Content="اسفند" />
            </ComboBox>
            <TextBlock Text="پرسنل:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding Employees}"
                      DisplayMemberPath="FullName"
                      SelectedIndex="{Binding SelectedEmployeeIndex}"
                      MinWidth="200" Margin="0,0,14,0" />
            <Button Command="{Binding LoadCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="🔄 نمایش گزارش" Margin="0,0,8,0" />
            <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="📊 خروجی اکسل" />
        </WrapPanel>

        <!-- کارت‌های آماری -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,10">
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock FontSize="11.5" Opacity="0.65"><Run Text="جمع سود خدمات دوره (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock>
                    <TextBlock Text="{Binding TotalProfit, StringFormat='#,0'}" FontSize="21" FontWeight="Bold" Foreground="#1E88E5" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock FontSize="11.5" Opacity="0.65"><Run Text="جمع حقوق درصدی (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock>
                    <TextBlock Text="{Binding TotalCommission, StringFormat='#,0'}" FontSize="21" FontWeight="Bold" Foreground="#8E24AA" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="تعداد اقلام منتسب‌شده" FontSize="11.5" Opacity="0.65" />
                    <TextBlock Text="{Binding ServiceCount}" FontSize="21" FontWeight="Bold" Foreground="#FB8C00" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="پرسنل گزارش" FontSize="11.5" Opacity="0.65" />
                    <TextBlock Text="{Binding EmployeeCount}" FontSize="21" FontWeight="Bold" Foreground="#43A047" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="3"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="#D32F2F" FontSize="12"
                   Margin="8,28,0,0" />

        <!-- ردیف خلاصه: جدول پرسنل (۲fr) + نمودار دونات سهم (۱fr) — چرخه یازدهم -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- جدول خلاصه پرسنل -->
            <DataGrid Grid.Column="0" ItemsSource="{Binding SummaryRows}"
                      SelectedItem="{Binding SelectedSummaryRow}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      Style="{StaticResource App.TableDataGrid}"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="کد پرسنلی" Binding="{Binding PersonnelCode, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                    <DataGridTextColumn Header="نام و نام خانوادگی" Binding="{Binding FullName, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                    <DataGridTextColumn Header="بخش" Binding="{Binding DepartmentName, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                    <DataGridTextColumn Header="سمت" Binding="{Binding PositionName, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                    <DataGridTextColumn Header="پزشک متصل" Binding="{Binding DoctorNames, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                    <DataGridTextColumn Header="اقلام" Binding="{Binding ServiceCount, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                    <DataGridTextColumn Binding="{Binding TotalRevenueText, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}"><DataGridTextColumn.Header><TextBlock><Run Text="جمع فروش (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding TotalCostText, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}"><DataGridTextColumn.Header><TextBlock><Run Text="جمع هزینه (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding TotalProfitText, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}"><DataGridTextColumn.Header><TextBlock><Run Text="سود خدمات (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Header="درصد" Binding="{Binding CommissionPercentText, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420"  ElementStyle="{StaticResource App.TableCellTextBlock}" />
                    <DataGridTextColumn Binding="{Binding ServiceCommissionText, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420"><DataGridTextColumn.Header><TextBlock><Run Text="حقوق درصدی (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock></DataGridTextColumn.Header>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource App.TableCellTextBlock}">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="#8E24AA" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="وضعیت فیش" Binding="{Binding SalaryStatusText, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- کارت دونات سهم پرسنل از حقوق درصدی — ماهیت سهم از کل → دونات -->
            <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="0" Padding="10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="سهم پرسنل از حقوق درصدی دوره" FontSize="12" FontWeight="Bold"
                               Foreground="#8E24AA" Margin="2,0,0,6" />
                    <charts:DoughnutChart Grid.Row="1"
                                          Points="{Binding CommissionChartPoints}"
                                          CenterText="{Binding CommissionChartCenter}"
                                          CenterSubtext="برشمرده بر اساس واحد پول برنامه — ۱۰ نفر برتر"
                                          RingSize="140" />
                </Grid>
            </Border>
        </Grid>

        <!-- عنوان جزئیات -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,6">
            <materialDesign:PackIcon Kind="ReceiptTextOutline" Width="18" Height="18"
                                     Foreground="#16355E" VerticalAlignment="Center" />
            <TextBlock FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0">
                <Run Text="جزئیات اقلام" />
                <Run Text="{Binding PeriodText, Mode=OneWay}" Foreground="#5B7290" />
            </TextBlock>
            <Button Command="{Binding ShowAllDetailsCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Content="نمایش همه پرسنل" FontSize="11.5" Margin="12,0,0,0" Padding="8,2" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="#2E7D32" FontSize="12"
                       Margin="16,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- جدول جزئیات اقلام -->
        <DataGrid Grid.Row="5" ItemsSource="{Binding DetailRows}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  Style="{StaticResource App.TableDataGrid}"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="پرسنل" Binding="{Binding EmployeeName, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Header="شماره فاکتور" Binding="{Binding InvoiceNumber, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Header="تاریخ" Binding="{Binding InvoiceDateShamsi, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Header="بیمار" Binding="{Binding PatientName, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Header="خدمت" Binding="{Binding ServiceName, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Header="تعداد" Binding="{Binding Quantity, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Header="قیمت واحد" Binding="{Binding UnitPriceText, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Header="هزینه واحد" Binding="{Binding UnitCostText, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Binding="{Binding TotalPriceText, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}"><DataGridTextColumn.Header><TextBlock><Run Text="مبلغ قلم (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock></DataGridTextColumn.Header></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding ProfitText, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420"><DataGridTextColumn.Header><TextBlock><Run Text="سود قلم (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock></DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource App.TableCellTextBlock}">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="#1E88E5" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="نحوه انتساب" Binding="{Binding Attribution, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
