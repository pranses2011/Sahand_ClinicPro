<Window x:Class="Sahand.ClinicPro.Desktop.Views.RoomsManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="مدیریت اتاق‌های معاینه"
        Width="560" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}">
    <!-- ═══════════════════════════════════════════════════════════
         پنجرهٔ مدیریت اتاق‌های معاینه — چرخه بیست‌ویکم (گزارش پانزدهم مالک):
         «در تعریف پزشک فیلد اتاق برای انتخاب هست ولی جایی برای تعریف
         اتاق و اسم اتاق نیست» — از تب برنامهٔ کاری پزشک باز می‌شود.
         چیدمان: جدول اتاق‌ها (راست) + فرم افزودن/ویرایش (پایین)
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- سربرگ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <materialDesign:PackIcon Kind="Door"
                                     Width="22" Height="22"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                     VerticalAlignment="Center" />
            <TextBlock Text="مدیریت اتاق‌های معاینه"
                       FontSize="16" FontWeight="Bold"
                       Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- جدول اتاق‌ها -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Rooms}"
                  SelectedItem="{Binding SelectedRoom}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  FontSize="12"
                  AlternatingRowBackground="#F7FAFD">
            <DataGrid.Columns>
                <DataGridTextColumn Header="شماره" Binding="{Binding RoomNumber}"
                                    Width="Auto" MinWidth="60" FontFamily="Consolas" />
                <DataGridTextColumn Header="نام اتاق" Binding="{Binding DisplayName}"
                                    Width="*" MinWidth="140" />
                <DataGridTextColumn Header="طبقه" Binding="{Binding Floor, TargetNullValue=—}"
                                    Width="Auto" MinWidth="50" />
                <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}"
                                    Width="Auto" MinWidth="65" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- خطای فرم -->
        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage, Mode=OneWay}"
                   Foreground="#C62828" FontSize="11.5" Margin="2,8,2,2"
                   Visibility="{Binding ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />

        <!-- فرم افزودن/ویرایش -->
        <Border Grid.Row="3"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                BorderThickness="1" CornerRadius="8"
                Padding="12,10" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="12" />
                            <!-- ارقام ورودی طبقه -->
                    </Grid.ColumnDefinitions>
                    <TextBox materialDesign:HintAssist.Hint="شماره اتاق *"
                             Text="{Binding RoomNumber, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Column="0" FontFamily="Consolas" />
                    <TextBox materialDesign:HintAssist.Hint="نام اتاق (مثلاً: اتاق معاینه ۳)"
                             Text="{Binding RoomName, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Column="1" Margin="8,0,0,0" />
                    <TextBox materialDesign:HintAssist.Hint="طبقه"
                             Text="{Binding Floor, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                             Grid.Column="2" Margin="8,0,0,0" FontFamily="Consolas" />
                </Grid>

                <!-- دکمه‌های عملیات — انتخاب ردیف = ویرایش؛ بدون انتخاب = افزودن -->
                <StackPanel Grid.Row="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button Command="{Binding AddCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            ToolTip="ثبت اتاق جدید با مقادیر فرم بالا" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="افزودن اتاق" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding UpdateCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            ToolTip="ذخیرهٔ تغییرات روی اتاق انتخاب‌شدهٔ جدول" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="ذخیرهٔ ویرایش" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeactivateCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="#C62828"
                            ToolTip="غیرفعال‌سازی اتاق انتخاب‌شده (حذف نرم)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteOutline" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="غیرفعال‌سازی" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
