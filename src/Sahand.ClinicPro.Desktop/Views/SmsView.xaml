<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.SmsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1080"
             FlowDirection="RightToLeft">
    <!-- ═══ مدیریت پیامک — گام U14 طبق فرم ۲۶: ۵ تب ═══ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <materialDesign:PackIcon Kind="MessageTextOutline" Width="26" Height="26"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
            <TextBlock Text="مدیریت پیامک" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <TabControl Grid.Row="2" SelectedIndex="{Binding TabIndex}" Style="{StaticResource MaterialDesignTabControl}">

            <!-- ─── تب ۱: ارسال پیامک ─── -->
            <TabItem Header="📤 ارسال">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <StackPanel Margin="8,12" MaxWidth="720" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton Content="ارسال تکی" IsChecked="{Binding IsBulk, Converter={StaticResource InvertBool}, Mode=OneWay}"
                                         GroupName="SendType" Margin="0,0,16,0" />
                            <RadioButton Content="ارسال دسته‌ای" IsChecked="{Binding IsBulk}" GroupName="SendType" />
                        </StackPanel>

                        <!-- ارسال تکی -->
                        <TextBox materialDesign:HintAssist.Hint="شماره گیرنده — مثال ۰۹۱۲۱۲۳۴۵۶۷"
                                 Text="{Binding Recipient, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"
                                 Visibility="{Binding IsBulk, Converter={StaticResource InverseBoolToVisibility}}" />

                        <!-- ارسال دسته‌ای — انتخاب مخاطبان -->
                        <ComboBox materialDesign:HintAssist.Hint="مخاطبان"
                                  ItemsSource="{Binding AudienceOptions}"
                                  SelectedItem="{Binding AudienceType}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,10"
                                  Visibility="{Binding IsBulk, Converter={StaticResource BoolToVisibility}}" />

                        <!-- متن پیامک + شمارنده -->
                        <TextBlock Text="متن پیامک:" FontSize="12.5" FontWeight="SemiBold" Margin="2,0,0,4" />
                        <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="130" MaxLength="1000"
                                 VerticalContentAlignment="Top" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding CharCountText, Mode=OneWay}" FontSize="11" Opacity="0.7"
                                   FontFamily="Consolas" Margin="2,0,0,4" HorizontalAlignment="Left" />
                        <TextBlock Text="متغیرها: {نام بیمار} {نام پزشک} {تاریخ} {ساعت} {کد پیگیری}"
                                   FontSize="10.5" Opacity="0.55" Margin="2,0,0,10" />

                        <!-- تمپلیت‌ها -->
                        <TextBlock Text="اعمال از تمپلیت:" FontSize="12" Margin="2,0,0,4" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,6,0" />
                            <Button Grid.Column="1" Command="{Binding ApplyTemplateCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Content="اعمال" />
                        </Grid>

                        <!-- دکمه ارسال -->
                        <Button Command="{Binding SendSingleCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                Visibility="{Binding IsBulk, Converter={StaticResource InverseBoolToVisibility}}"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Send" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="📤 ارسال پیامک" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SendBulkCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                Visibility="{Binding IsBulk, Converter={StaticResource BoolToVisibility}}"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CommentMultiple" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="📤 ارسال دسته‌ای" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─── تب ۲: تاریخچه ─── -->
            <TabItem Header="📋 تاریخچه">
                <Grid Margin="4,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox materialDesign:HintAssist.Hint="وضعیت"
                                  ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" Width="150" Margin="0,0,8,0" />
                        <Button Command="{Binding LoadHistoryCommand}" Style="{StaticResource MaterialDesignOutlinedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="اعمال فیلتر" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding History}" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" FontSize="12" AlternatingRowBackground="#F7FAFD">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="گیرنده" Binding="{Binding Recipient}" Width="120" FontFamily="Consolas" />
                            <DataGridTextColumn Header="متن" Binding="{Binding Message, TargetNullValue=—}" Width="*" />
                            <DataGridTemplateColumn Header="وضعیت" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="9,2" HorizontalAlignment="Center"
                                                Background="{Binding StatusColor}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="White" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ارسال" Width="150">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="SentAt" Converter="{StaticResource ShamsiDateTime}" TargetNullValue="—" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="هزینه (ریال)" Width="110">
                                <DataGridTextColumn.Binding><Binding Path="Cost" StringFormat="{}{0:N0}" /></DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="عملیات" Width="Auto" MinWidth="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource App.RowIconButton}"
                                                Command="{Binding DataContext.ResendCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" ToolTip="بازارسال">
                                            <materialDesign:PackIcon Kind="Refresh" Width="15" Height="15" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ─── تب ۳: تمپلیت‌ها ─── -->
            <TabItem Header="📝 تمپلیت‌ها">
                <DataGrid ItemsSource="{Binding Templates}" AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" HeadersVisibility="Column" FontSize="12" AlternatingRowBackground="#F7FAFD">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="نام تمپلیت" Binding="{Binding Name}" Width="170" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="190" FontFamily="Consolas" />
                        <DataGridTextColumn Header="محتوا" Binding="{Binding Content}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- ─── تب ۴: پنل‌ها ─── -->
            <TabItem Header="⚙️ پنل‌ها">
                <Grid Margin="4,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Command="{Binding LoadProvidersCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" />
                        </Button>
                        <Button Command="{Binding TestProviderCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="LinkVariant" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="تست اتصال" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveProviderCommand}" Style="{StaticResource MaterialDesignOutlinedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="ذخیره پنل" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" FontSize="12" AlternatingRowBackground="#F7FAFD">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="نام پنل" Binding="{Binding Name}" Width="150" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="130" FontFamily="Consolas" />
                            <DataGridTextColumn Header="شماره ارسال" Binding="{Binding SenderNumber, TargetNullValue=—}" Width="120" FontFamily="Consolas" />
                            <DataGridTextColumn Header="موجودی (ریال)" Width="120">
                                <DataGridTextColumn.Binding><Binding Path="Balance" StringFormat="{}{0:N0}" /></DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="اولویت" Binding="{Binding Priority}" Width="70" />
                            <DataGridTextColumn Header="پیش‌فرض" Binding="{Binding IsDefault}" Width="80" />
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding ActiveText}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="کلید API به‌صورت رمزنگاری‌شده نگهداری می‌شود — برای تغییر، از ویرایش پنل با کلید جدید استفاده کنید"
                               FontSize="10.5" Opacity="0.6" Margin="2,8,0,0" />
                </Grid>
            </TabItem>

            <!-- ─── تب ۵: آمار ─── -->
            <TabItem Header="📊 آمار">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <StackPanel Margin="8,12">
                        <Button Command="{Binding LoadStatsCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                HorizontalAlignment="Left" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChartBar" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="بازخوانی آمار ۳۰ روز" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- کارت‌های آماری — طبق فرم ۲۶ -->
                        <UniformGrid Columns="5" Margin="0,0,0,16">
                            <Border CornerRadius="12" Padding="14" Margin="5" Background="#E3F2FD">
                                <StackPanel>
                                    <TextBlock Text="📤 ارسال‌شده" FontSize="11" Opacity="0.7" />
                                    <TextBlock Text="{Binding SentText}" FontSize="20" FontWeight="Bold" FontFamily="Consolas" />
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="12" Padding="14" Margin="5" Background="#E8F5E9">
                                <StackPanel>
                                    <TextBlock Text="✅ تحویل‌شده" FontSize="11" Opacity="0.7" />
                                    <TextBlock Text="{Binding DeliveredText}" FontSize="20" FontWeight="Bold" FontFamily="Consolas" />
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="12" Padding="14" Margin="5" Background="#FFEBEE">
                                <StackPanel>
                                    <TextBlock Text="❌ خطا" FontSize="11" Opacity="0.7" />
                                    <TextBlock Text="{Binding FailedText}" FontSize="20" FontWeight="Bold" FontFamily="Consolas" />
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="12" Padding="14" Margin="5" Background="#FFF8E1">
                                <StackPanel>
                                    <TextBlock Text="💰 هزینه ماه" FontSize="11" Opacity="0.7" />
                                    <TextBlock Text="{Binding MonthCostText}" FontSize="14" FontWeight="Bold" FontFamily="Consolas" />
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="12" Padding="14" Margin="5" Background="#F3E5F5">
                                <StackPanel>
                                    <TextBlock Text="📈 نرخ موفقیت" FontSize="11" Opacity="0.7" />
                                    <TextBlock Text="{Binding SuccessRateText}" FontSize="20" FontWeight="Bold" FontFamily="Consolas" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- نمودار ستونی روزانه — ساده با ستون‌های WPF -->
                        <TextBlock Text="ارسال روزانه (۳۰ روز اخیر)" FontSize="13" FontWeight="SemiBold" Margin="2,4,0,8" />
                        <ItemsControl ItemsSource="{Binding DailyPoints}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Height="70" VerticalAlignment="Bottom">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" VerticalAlignment="Bottom"
                                                        Height="{Binding BarHeight}"
                                                        MinHeight="2"
                                                        CornerRadius="3,3,0,0" Background="#1E88E5" />
                                                <TextBlock Grid.Row="1" Text="{Binding Count}" FontSize="9"
                                                           HorizontalAlignment="Center" FontFamily="Consolas" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding Date}" FontSize="8" Opacity="0.6"
                                                   HorizontalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
