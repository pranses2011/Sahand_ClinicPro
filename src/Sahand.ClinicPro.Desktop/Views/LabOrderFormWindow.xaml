<Window x:Class="Sahand.ClinicPro.Desktop.Views.LabOrderFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="درخواست آزمایش"
        Height="680" Width="680"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!-- ═══════════════════════════════════════════════════════════
         فرم درخواست آزمایش — گام V6
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- سربرگ — طراحی نسخهٔ ۳ (تأیید مالک) -->
        <Border CornerRadius="12" Padding="14,10" Margin="0,0,0,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#6A1B9A" Offset="0" />
                    <GradientStop Color="#311B92" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="🧪 درخواست آزمایش جدید" FontSize="16" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="بیمار ← پزشک و اولویت ← انتخاب آزمایش‌ها" FontSize="10.5" Foreground="#E1BEE7" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!-- بیمار و پزشک -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBox materialDesign:HintAssist.Hint="جستجوی بیمار *"
                         Text="{Binding PatientSearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,6">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchPatientCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <ListBox ItemsSource="{Binding PatientResults}"
                         SelectedItem="{Binding SelectedPatient}"
                         Height="96"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                                <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.75" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="10,0">
                <ComboBox materialDesign:HintAssist.Hint="پزشک *"
                          ItemsSource="{Binding Doctors}"
                          DisplayMemberPath="Name"
                          SelectedIndex="{Binding DoctorIndex}"
                          Margin="0,0,0,6" />
                <ComboBox materialDesign:HintAssist.Hint="اولویت"
                          SelectedIndex="{Binding PriorityIndex}"
                          Margin="0,0,0,6">
                    <ComboBoxItem Content="اورژانسی" />
                    <ComboBoxItem Content="فوری" />
                    <ComboBoxItem Content="عادی" />
                </ComboBox>
                <TextBox materialDesign:HintAssist.Hint="اطلاعات بالینی و شرح حال"
                         Text="{Binding ClinicalInfo, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap" Height="64" />
            </StackPanel>
        </Grid>

        <!-- فیلتر تست -->
        <TextBox Grid.Row="2"
                 materialDesign:HintAssist.Hint="فیلتر نام آزمایش"
                 Text="{Binding TestSearchTerm, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,8" />

        <!-- فهرست تست‌ها -->
        <ListBox Grid.Row="3"
                 ItemsSource="{Binding Tests}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected}">
                        <StackPanel>
                            <TextBlock>
                            <!-- Mode=OneWay — چرخهٔ ۶۷: Run.Text پیش‌فرض TwoWay است؛
                                 برای پراپرتی‌های init-only رکوردها هم یک‌طرفه باید باشد -->
                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text=" — " />
                            <Run Text="{Binding Category, Mode=OneWay}" FontSize="11" />
                            </TextBlock>
                            <!-- ═══ چرخهٔ ۷۹ — بازهٔ مرجع و واحد زیر نام هر آزمایش ═══
                                 گزارش مالک: «بازه‌های مرجع موقع ثبت درخواست هم دیده
                                 بشن» — متن از موتور تفسیر سرور (عددی برای کمی؛
                                 برچسب شفاف برای کیفی) -->
                            <TextBlock FontSize="10.5" Opacity="0.72" Margin="0,1,0,0">
                                <Run Text="حد طبیعی: " />
                                <Run Text="{Binding RangeText, Mode=OneWay, TargetNullValue=—}"
                                     FontFamily="{DynamicResource App.CodeFont}" />
                            </TextBlock>
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- پاورقی -->
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <!-- خلاصهٔ زندهٔ انتخاب — طراحی نسخهٔ ۳ -->
            <Border CornerRadius="10" Padding="11,7" Background="#F3E5F5" BorderBrush="#CE93D8" BorderThickness="1" Margin="0,0,0,9">
                <TextBlock Text="{Binding SelectedSummaryText, Converter={StaticResource PersianDigits}}"
                           FontSize="11.5" TextWrapping="Wrap" LineHeight="19" />
            </Border>
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
            <UniformGrid Columns="2">
                <Button Command="{Binding SaveCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Content="ثبت درخواست" Height="42" Margin="4" />
                <Button Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Content="انصراف" Height="42" Margin="4" />
            </UniformGrid>
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,14,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Grid>
</Window>