<Window x:Class="Sahand.ClinicPro.Desktop.Views.LabOrderFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="درخواست آزمایش"
        Height="680" Width="680"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!-- ═══════════════════════════════════════════════════════════
         فرم درخواست آزمایش — گام V6
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="درخواست آزمایش جدید" Style="{StaticResource SectionTitle}" />

        <!-- بیمار و پزشک -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBox materialDesign:HintAssist.Hint="جستجوی بیمار *"
                         Text="{Binding PatientSearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,6">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchPatientCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <ListBox ItemsSource="{Binding PatientResults}"
                         SelectedItem="{Binding SelectedPatient}"
                         Height="96"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                                <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.75" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="10,0">
                <ComboBox materialDesign:HintAssist.Hint="پزشک *"
                          ItemsSource="{Binding Doctors}"
                          DisplayMemberPath="Name"
                          SelectedIndex="{Binding DoctorIndex}"
                          Margin="0,0,0,6" />
                <ComboBox materialDesign:HintAssist.Hint="اولویت"
                          SelectedIndex="{Binding PriorityIndex}"
                          Margin="0,0,0,6">
                    <ComboBoxItem Content="اورژانسی" />
                    <ComboBoxItem Content="فوری" />
                    <ComboBoxItem Content="عادی" />
                </ComboBox>
                <TextBox materialDesign:HintAssist.Hint="اطلاعات بالینی و شرح حال"
                         Text="{Binding ClinicalInfo, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap" Height="64" />
            </StackPanel>
        </Grid>

        <!-- فیلتر تست -->
        <TextBox Grid.Row="2"
                 materialDesign:HintAssist.Hint="فیلتر نام آزمایش"
                 Text="{Binding TestSearchTerm, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,8" />

        <!-- فهرست تست‌ها -->
        <ListBox Grid.Row="3"
                 ItemsSource="{Binding Tests}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected}">
                        <TextBlock>
                            <Run Text="{Binding Name}" FontWeight="Bold" />
                            <Run Text=" — " />
                            <Run Text="{Binding Category, Mode=OneWay}" FontSize="11" />
                        </TextBlock>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- پاورقی -->
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
            <UniformGrid Columns="2">
                <Button Command="{Binding SaveCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Content="ثبت درخواست" Height="42" Margin="4" />
                <Button Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Content="انصراف" Height="42" Margin="4" />
            </UniformGrid>
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,14,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Grid>
</Window>