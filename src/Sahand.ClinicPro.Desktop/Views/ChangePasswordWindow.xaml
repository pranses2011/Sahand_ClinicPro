<Window x:Class="Sahand.ClinicPro.Desktop.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="تغییر رمز عبور الزامی"
        Height="560" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"

        MouseLeftButtonDown="OnDragWindow"
        FlowDirection="RightToLeft">
    <!-- ═══════════════════════════════════════════════════════════
         پنجره تغییر رمز عبور الزامی — چرخه چهاردهم (گزارش پنجم مالک)
         قدم ۷ راهنمای SQL: بعد از ورود اولِ admin (MustChangePassword=true)
         برنامه «بلافاصله و دورزدنی‌ناپذیر» تغییر رمز می‌خواهد — بستن پنجره
         بدون تغییر = خروج از برنامه و پاک‌شدن توکن (لاگین دوباره لازم است)
         کادرها چپ‌به‌راست و وسط‌چین‌اند تا رمز لاتین وارونه دیده نشود
         (همان رفع صفحه ورود) و آیکون چشم بیرون از کادر است
         ═══════════════════════════════════════════════════════════ -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <!-- پس‌زمینه گرادیان آبی-سبز — هماهنگ با پنجره ورود -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0D47A1" Offset="0" />
                <GradientStop Color="#1565C0" Offset="0.5" />
                <GradientStop Color="#00897B" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- دکمه بستن — بدون تغییر رمز، خروج از برنامه -->
        <Button x:Name="CloseButton"
                Style="{StaticResource MaterialDesignIconForegroundButton}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="8" Width="34" Height="30"
                Foreground="White"
                ToolTip="خروج از برنامه (بدون تغییر رمز، ورود دوباره لازم است)"
                Click="OnCloseClick">
            <materialDesign:PackIcon Kind="Close" />
        </Button>

        <!-- کارت مرکزی -->
        <Border MaxWidth="380"
                Background="{DynamicResource MaterialDesign.Brush.Background}"
                CornerRadius="20" Padding="28"
                VerticalAlignment="Center" Margin="36,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.35" />
            </Border.Effect>

            <StackPanel>
                <!-- آیکون قفل -->
                <Border Width="64" Height="64" CornerRadius="32"
                        Background="#E3F2FD"
                        HorizontalAlignment="Center" Margin="0,2,0,10">
                    <materialDesign:PackIcon Kind="LockReset"
                                             Width="34" Height="34"
                                             Foreground="#1565C0"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                </Border>

                <!-- عنوان و توضیح -->
                <TextBlock Text="تغییر رمز عبور الزامی"
                           FontSize="18" FontWeight="Black"
                           HorizontalAlignment="Center"
                           Foreground="#1565C0" />
                <TextBlock Text="حساب شما با رمز پیش‌فرض فعال شده است؛ برای ادامه باید رمز تازه‌ای انتخاب کنید."
                           FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Margin="0,4,0,16" />

                <!-- رمز فعلی + چشم بیرون از کادر — گزارش هفتم مالک: چشم برای هر سه کادر؛
                     کاربر همان لحظه در صفحه ورود تایپش کرده و اینجا می‌تواند ببیندش -->
                <Grid FlowDirection="LeftToRight" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <!-- چرخه هفدهم (گزارش یازدهم مالک): بایندینگ PasswordBoxAssist حذف شد
                             (همان ریشهٔ وارونگی رمز پنجرهٔ ورود — بازنویتن برنامه‌ای Password
                             و پرش مکان‌نما)؛ همگام‌سازی با رویداد PasswordChanged در کد پشت است -->
                        <PasswordBox x:Name="CurrentPasswordBox"
                                     materialDesign:HintAssist.Hint="🔒 رمز عبور فعلی"
                                     MaxLength="100"
                                     FontSize="14"
                                     FlowDirection="LeftToRight"
                                     Visibility="Visible" />
                        <TextBox x:Name="CurrentPasswordRevealBox"
                                 materialDesign:HintAssist.Hint="🔒 رمز عبور فعلی"
                                 Text="{Binding CurrentPassword, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14"
                                 FlowDirection="LeftToRight"
                                 TextAlignment="Center"
                                 Visibility="Collapsed"
                                 IsReadOnly="False" />
                    </Grid>
                    <ToggleButton Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                  Tag="Current"
                                  Margin="6,0,0,0"
                                  Width="32" Height="26"
                                  VerticalAlignment="Center"
                                  ToolTip="نمایش رمز فعلی"
                                  Checked="OnEyeToggled"
                                  Unchecked="OnEyeToggled">
                        <materialDesign:PackIcon Kind="EyeOutline" Width="18" Height="18" />
                    </ToggleButton>
                </Grid>

                <!-- رمز جدید + چشم بیرون از کادر -->
                <Grid FlowDirection="LeftToRight" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <PasswordBox x:Name="NewPasswordBox"
                                     materialDesign:HintAssist.Hint="🔒 رمز عبور جدید (حداقل ۸ کاراکتر)"
                                     MaxLength="100"
                                     FontSize="14"
                                     FlowDirection="LeftToRight"
                                     Visibility="Visible" />
                        <TextBox x:Name="NewPasswordRevealBox"
                                 materialDesign:HintAssist.Hint="🔒 رمز عبور جدید (حداقل ۸ کاراکتر)"
                                 Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14"
                                 FlowDirection="LeftToRight"
                                 TextAlignment="Center"
                                 Visibility="Collapsed"
                                 IsReadOnly="False" />
                    </Grid>
                    <ToggleButton Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                  Tag="New"
                                  Margin="6,0,0,0"
                                  Width="32" Height="26"
                                  VerticalAlignment="Center"
                                  ToolTip="نمایش رمز جدید"
                                  Checked="OnEyeToggled"
                                  Unchecked="OnEyeToggled">
                        <materialDesign:PackIcon Kind="EyeOutline" Width="18" Height="18" />
                    </ToggleButton>
                </Grid>

                <!-- تکرار رمز جدید + چشم بیرون از کادر -->
                <Grid FlowDirection="LeftToRight" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <PasswordBox x:Name="ConfirmPasswordBox"
                                     materialDesign:HintAssist.Hint="🔒 تکرار رمز عبور جدید"
                                     MaxLength="100"
                                     FontSize="14"
                                     FlowDirection="LeftToRight"
                                     Visibility="Visible" />
                        <TextBox x:Name="ConfirmPasswordRevealBox"
                                 materialDesign:HintAssist.Hint="🔒 تکرار رمز عبور جدید"
                                 Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14"
                                 FlowDirection="LeftToRight"
                                 TextAlignment="Center"
                                 Visibility="Collapsed"
                                 IsReadOnly="False" />
                    </Grid>
                    <ToggleButton Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                  Tag="Confirm"
                                  Margin="6,0,0,0"
                                  Width="32" Height="26"
                                  VerticalAlignment="Center"
                                  ToolTip="نمایش تکرار رمز"
                                  Checked="OnEyeToggled"
                                  Unchecked="OnEyeToggled">
                        <materialDesign:PackIcon Kind="EyeOutline" Width="18" Height="18" />
                    </ToggleButton>
                </Grid>

                <!-- نکته سیاست رمز -->
                <TextBlock Text="ترکیبی از حرف بزرگ و کوچک، عدد و علامت — و متفاوت با رمزهای قبلی"
                           FontSize="10.5" Opacity="0.6" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Margin="0,2,0,0" />

                <!-- پیام خطا -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                           FontSize="12" TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                <!-- دکمه ثبت — تمام عرض -->
                <Button Command="{Binding ChangePasswordCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Height="44" Margin="0,14,0,0"
                        FontSize="15" FontWeight="Bold"
                        IsDefault="True"
                        Content="✔ ثبت رمز و ورود" />

                <!-- نوار انتظار -->
                <ProgressBar IsIndeterminate="True"
                             Height="4" Margin="0,12,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
