<Window xmlns:shortcuts="clr-namespace:Sahand.ClinicPro.Desktop.Services" x:Class="Sahand.ClinicPro.Desktop.Views.PharmacyItemFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="قلم جدید انبار"
        Height="620" Width="520"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!-- ═══════════════════════════════════════════════════════════
         فرم قلم جدید انبار — چرخهٔ سی‌ونه‌م (گزارش مالک):
         «خرید و انبار و قیمت‌های این لوازم هم باید باشه» — ساخت دارو یا
         لوازم مصرفی (سرنگ/سرم/گاز استریل و…)؛ پس از ساخت قلم، موجودی
         اولیه از فرم «ورود کالا» با بچ/تعداد/قیمت ثبت می‌شود.
         ═══ چرخهٔ چهل‌وسوم (گزارش مالک): «چون اقلام مصرفی دیگه از داروخانه
         مستقل شده، در افزودن قلم جدید… نباید نوع قلم وجود داشته باشه» —
         کمبوی نوع حذف شد؛ نوع از بافت فراخواننده می‌آید (مصرفی‌ها از صفحهٔ
         خودشان، داروها از داروخانه) و عنوان/راهنمای فرم بافت‌دار شدند.
         ═══════════════════════════════════════════════════════════ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding FormHint}"
                       FontSize="11.5" Opacity="0.7" Margin="0,0,0,14" TextWrapping="Wrap" />

            <!-- نام فارسی -->
            <TextBox materialDesign:HintAssist.Hint="نام فارسی قلم * (مثلاً: سرنگ ۵ سی‌سی / گاز استریل)"
                     Text="{Binding NameFa, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12" />

            <!-- نام ژنریک — خودکار و کامل از فارسی پر می‌شود؛ ویرایش دستی محترم است -->
            <TextBox materialDesign:HintAssist.Hint="نام ژنریک/انگلیسی * (خودکار از نام فارسی — قابل ویرایش)"
                     Text="{Binding GenericName, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12" />

            <!-- فرم و اندازه — دو ستونه -->
            <UniformGrid Columns="2" Margin="0,0,0,12">
                <TextBox materialDesign:HintAssist.Hint="فرم/جنس (اختیاری — مثلاً: ست تزریقی)"
                         Text="{Binding Form, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                         Margin="0,0,6,0" />
                <TextBox materialDesign:HintAssist.Hint="اندازه/غلظت (اختیاری — مثلاً: ۵cc)"
                         Text="{Binding Strength, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                         Margin="6,0,0,0" />
            </UniformGrid>

            <!-- سازنده و بارکد — دو ستونه -->
            <UniformGrid Columns="2" Margin="0,0,0,16">
                <TextBox materialDesign:HintAssist.Hint="شرکت سازنده (اختیاری)"
                         Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                         Margin="0,0,6,0" />
                <TextBox materialDesign:HintAssist.Hint="بارکد (اختیاری)"
                         Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                         Margin="6,0,0,0" FontFamily="{DynamicResource App.CodeFont}" />
            </UniformGrid>

            <!-- خطای فرم -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />

            <!-- دکمه‌ها — ضدفشردگی چرخهٔ ۳۹: Padding سخاوانه + سقف عرض -->
            <UniformGrid Columns="2">
                <Button shortcuts:SaveShortcut.Number="1" Command="{Binding SaveCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#00838F" BorderBrush="#00838F"
                        Content="ثبت قلم (Ctrl+Shift+1)" Height="44" Margin="4" MinWidth="120" />
                <Button Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Content="انصراف" Height="44" Margin="4" MinWidth="120" />
            </UniformGrid>

            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </ScrollViewer>
</Window>
