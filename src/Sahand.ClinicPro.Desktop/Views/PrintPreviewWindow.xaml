<Window x:Class="Sahand.ClinicPro.Desktop.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="پیش‌نمایش چاپ"
        Height="760" Width="920"
        MinHeight="520" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}">
    <!-- ═══════════════════════════════════════════════════════════
         پنجرهٔ عمومی «پیش‌نمایش چاپ» — چرخهٔ ۶۷ (گزارش مالک):
         «در تنظیمات چاپ گزینه‌ای باشه برای پیش‌نمایش چاپ تا با فعال کردنش،
         تمامی چاپ‌ها قبل از ارسال به پرینتر پیش‌نمایش نشون بدن و در صورت
         نیاز چاپشون کنیم». این پنجره از دروازهٔ PrintFlow برای همهٔ چاپ‌های
         عمومی برنامه (قبض نوبت/رسید شیفت/کارت بیمار/فیش حقوقی/نتیجهٔ
         آزمایش) باز می‌شود: نمایشگر صفحهٔ سند + زوم فارسی + دکمهٔ چاپ.
         چاپ از این پنجره به «چاپگر مقصدِ تنظیمات» می‌رود (بدون دیالوگ
         ویندوز) تا تجربه یکدست بماند.
         ═══════════════════════════════════════════════════════════ -->
    <DockPanel>
        <!-- ═══ نوار ابزار — عنوان + زوم + چاپ + بستن ═══ -->
        <Border DockPanel.Dock="Top" Padding="16,10,16,8"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="PrinterEye" Width="20" Height="20"
                                             Foreground="#1565C0" VerticalAlignment="Center" />
                    <TextBlock x:Name="HeaderTitle" Text="پیش‌نمایش چاپ"
                               FontSize="15" FontWeight="Bold" Margin="9,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- زوم — دکمه‌های فارسی با درصد زنده -->
                    <Button x:Name="ZoomOut" Click="OnZoomOut"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Width="38" Height="38" Padding="0" ToolTip="کوچک‌نمایی"
                            Content="−" FontSize="16" FontWeight="Bold" Margin="0,0,6,0" />
                    <TextBlock x:Name="ZoomLabel" Text="۱۰۰٪"
                               FontSize="12" FontWeight="SemiBold" MinWidth="48"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{DynamicResource App.CodeFont}" />
                    <Button x:Name="ZoomIn" Click="OnZoomIn"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Width="38" Height="38" Padding="0" ToolTip="بزرگ‌نمایی"
                            Content="+" FontSize="16" FontWeight="Bold" Margin="0,0,14,0" />
                    <!-- چاپ — ارسال به چاپگر مقصدِ تنظیمات -->
                    <Button x:Name="PrintButton" Click="OnPrintClick"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            MinWidth="112" Height="40"
                            ToolTip="ارسال به چاپگر">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Width="17" Height="17" VerticalAlignment="Center" />
                            <TextBlock Text="چاپ" Margin="7,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnCloseClick"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            MinWidth="96" Height="40" Margin="8,0,0,0"
                            ToolTip="بستن بدون چاپ">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CloseCircleOutline" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="بستن" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ بوم پیش‌نمایش — پس‌زمینهٔ خاکستری روشن مثل همهٔ پیش‌نمایش‌ها ═══ -->
        <Border Background="#E9EDF3" Padding="18">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <FlowDocumentPageViewer x:Name="DocViewer"
                                        MinZoom="40" MaxZoom="320"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
