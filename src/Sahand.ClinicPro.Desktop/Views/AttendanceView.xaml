<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1180"
             FlowDirection="RightToLeft">
    <!-- ═══ ماژول حضور و غیاب — تابلو امروز + دستگاه‌ها + شیفت‌ها + اصلاحیه‌ها + گزارش ═══ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- عنوان -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <materialDesign:PackIcon Kind="Fingerprint" Width="26" Height="26"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
            <TextBlock Text="حضور و غیاب پرسنل" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding BoardDate, StringFormat='— {0}'}" FontSize="13" Opacity="0.7"
                       VerticalAlignment="Center" Margin="14,3,0,0" />
        </StackPanel>

        <!-- پیام خطا -->
        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="#D32F2F" FontSize="12"
                   Margin="0,0,0,6" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />

        <!-- نوار زبانه‌ها با رنگ اصلی تم؛ مقدار PrimaryLight معتبرِ enum است
             (مقدار قبلی «Primary» در ColorZoneMode وجود نداشت و باعث XamlParseException می‌شد) -->
        <TabControl Grid.Row="2" Style="{StaticResource MaterialDesignTabControl}"
                    materialDesign:ColorZoneAssist.Mode="PrimaryLight">
            <!-- ═══════════ تب ۱: تابلوی امروز ═══════════ -->
            <TabItem Header="📋 تابلوی امروز">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- کارت‌های آماری -->
                    <UniformGrid Grid.Row="0" Columns="6" Margin="0,0,0,10">
                        <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="8"
                                Padding="12,10" Margin="0,0,6,0" BorderThickness="1" BorderBrush="{DynamicResource MaterialDesignDivider}">
                            <StackPanel>
                                <TextBlock Text="کل پرسنل" FontSize="11" Opacity="0.65" />
                                <TextBlock Text="{Binding TotalStaff}" FontSize="21" FontWeight="Bold" Foreground="#546E7A" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="8"
                                Padding="12,10" Margin="0,0,6,0" BorderThickness="1" BorderBrush="{DynamicResource MaterialDesignDivider}">
                            <StackPanel>
                                <TextBlock Text="حاضر" FontSize="11" Opacity="0.65" />
                                <TextBlock Text="{Binding PresentCount}" FontSize="21" FontWeight="Bold" Foreground="#43A047" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="8"
                                Padding="12,10" Margin="0,0,6,0" BorderThickness="1" BorderBrush="{DynamicResource MaterialDesignDivider}">
                            <StackPanel>
                                <TextBlock Text="تأخیر" FontSize="11" Opacity="0.65" />
                                <TextBlock Text="{Binding LateCount}" FontSize="21" FontWeight="Bold" Foreground="#FB8C00" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="8"
                                Padding="12,10" Margin="0,0,6,0" BorderThickness="1" BorderBrush="{DynamicResource MaterialDesignDivider}">
                            <StackPanel>
                                <TextBlock Text="غایب" FontSize="11" Opacity="0.65" />
                                <TextBlock Text="{Binding AbsentCount}" FontSize="21" FontWeight="Bold" Foreground="#D32F2F" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="8"
                                Padding="12,10" Margin="0,0,6,0" BorderThickness="1" BorderBrush="{DynamicResource MaterialDesignDivider}">
                            <StackPanel>
                                <TextBlock Text="مرخصی" FontSize="11" Opacity="0.65" />
                                <TextBlock Text="{Binding LeaveCount}" FontSize="21" FontWeight="Bold" Foreground="#1E88E5" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="8"
                                Padding="12,10" BorderThickness="1" BorderBrush="{DynamicResource MaterialDesignDivider}">
                            <StackPanel>
                                <TextBlock Text="مأموریت" FontSize="11" Opacity="0.65" />
                                <TextBlock Text="{Binding MissionCount}" FontSize="21" FontWeight="Bold" Foreground="#8E24AA" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- جدول پرسنل -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding BoardRows}" IsReadOnly="True"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              Style="{StaticResource MaterialDesignDataGrid}"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="پرسنل" Binding="{Binding FullName, Converter={StaticResource PersianDigits}}" Width="2*" />
                            <DataGridTextColumn Header="کد پرسنلی" Binding="{Binding PersonnelCode, Converter={StaticResource PersianDigits}}" Width="*" />
                            <DataGridTextColumn Header="بخش" Binding="{Binding Department, Converter={StaticResource PersianDigits}}" Width="1.4*" />
                            <DataGridTextColumn Header="شیفت" Binding="{Binding Shift, Converter={StaticResource PersianDigits}}" Width="*" />
                            <DataGridTextColumn Header="ورود" Binding="{Binding CheckIn, Converter={StaticResource PersianDigits}}" Width="0.7*" />
                            <DataGridTextColumn Header="خروج" Binding="{Binding CheckOut, Converter={StaticResource PersianDigits}}" Width="0.7*" />
                            <DataGridTextColumn Header="تأخیر" Binding="{Binding Late, Converter={StaticResource PersianDigits}}" Width="0.9*" />
                            <DataGridTemplateColumn Header="وضعیت" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusHex}" CornerRadius="10"
                                                Padding="10,3" HorizontalAlignment="Center" Margin="0,4">
                                            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11.5" FontWeight="Bold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridCheckBoxColumn Header="دستی؟" Binding="{Binding Edited}" Width="0.6*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ═══════════ تب ۲: دستگاه‌ها ═══════════ -->
            <TabItem Header="🔌 دستگاه‌ها">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                              IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                              Style="{StaticResource MaterialDesignDataGrid}"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" MinHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="نام دستگاه" Binding="{Binding Name, Converter={StaticResource PersianDigits}}" Width="1.6*" />
                            <DataGridTextColumn Header="برند" Binding="{Binding Brand, Converter={StaticResource PersianDigits}}" Width="*" />
                            <DataGridTextColumn Header="نشانی" Binding="{Binding EndPoint, Converter={StaticResource PersianDigits}}" Width="1.2*" />
                            <DataGridTextColumn Header="محل" Binding="{Binding Location, Converter={StaticResource PersianDigits}}" Width="1.4*" />
                            <DataGridTemplateColumn Header="وضعیت" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusHex}" CornerRadius="10"
                                                Padding="10,3" HorizontalAlignment="Center" Margin="0,4">
                                            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11.5" FontWeight="Bold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="آخرین سینک" Binding="{Binding LastSync, Converter={StaticResource PersianDigits}}" Width="1.5*" />
                            <DataGridTextColumn Header="کاربران" Binding="{Binding MappedUsers, Converter={StaticResource PersianDigits}}" Width="0.7*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- نوار عملیات + نگاشت‌ها -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- فرم دستگاه -->
                        <Border Grid.Column="0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                CornerRadius="8" Padding="12" Margin="0,0,6,0"
                                BorderThickness="1" BorderBrush="{DynamicResource MaterialDesignDivider}">
                            <StackPanel>
                                <TextBlock Text="{Binding DeviceFormTitle}"
                                           FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <TextBox materialDesign:HintAssist.Hint="نام دستگاه" Text="{Binding FormName}"
                                             Width="160" Margin="0,0,8,8" />
                                    <ComboBox materialDesign:HintAssist.Hint="برند" SelectedIndex="{Binding FormBrandIndex}"
                                              ItemsSource="{Binding Brands}" Width="130" Margin="0,0,8,8" />
                                    <TextBox materialDesign:HintAssist.Hint="IP" Text="{Binding FormIp}"
                                             Width="120" Margin="0,0,8,8" />
                                    <TextBox materialDesign:HintAssist.Hint="پورت" Text="{Binding FormPort}"
                                             Width="70" Margin="0,0,8,8" />
                                    <TextBox materialDesign:HintAssist.Hint="محل نصب" Text="{Binding FormLocation}"
                                             Width="150" Margin="0,0,8,8" />
                                    <TextBox materialDesign:HintAssist.Hint="سینک (دقیقه)" Text="{Binding FormInterval}"
                                             Width="90" Margin="0,0,8,8" />
                                    <TextBox materialDesign:HintAssist.Hint="کلید ارتباطی" Text="{Binding FormCommKey}"
                                             Width="120" Margin="0,0,8,8" />
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding SaveDeviceCommand}" Content="💾 ذخیره"
                                            Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0" />
                                    <Button Command="{Binding ResetDeviceFormCommand}" Content="پاک‌کردن فرم"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,14,0" />
                                    <Button Command="{Binding TestDeviceCommand}" Content="📡 آزمون اتصال"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
                                    <Button Command="{Binding SyncDeviceCommand}" Content="🔄 همگام‌سازی"
                                            Style="{StaticResource MaterialDesignRaisedButton}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- نگاشت کاربران -->
                        <Border Grid.Column="1" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                CornerRadius="8" Padding="12" Margin="6,0,0,0"
                                BorderThickness="1" BorderBrush="{DynamicResource MaterialDesignDivider}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"
                                           Text="نگاشت کاربران دستگاه (شناسه روی دستگاه ← پرسنل)" />
                                <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                                    <TextBox materialDesign:HintAssist.Hint="شناسه روی دستگاه" Text="{Binding MapEnrollNumber}"
                                             Width="130" Margin="0,0,8,8" />
                                    <TextBox materialDesign:HintAssist.Hint="شناسه پرسنل" Text="{Binding MapEmployeeId}"
                                             Width="100" Margin="0,0,8,8" />
                                    <Button Command="{Binding SaveMappingCommand}" Content="➕ ثبت نگاشت"
                                            Style="{StaticResource MaterialDesignRaisedButton}" VerticalAlignment="Center" />
                                </WrapPanel>
                                <DataGrid Grid.Row="2" ItemsSource="{Binding Mappings}" IsReadOnly="True"
                                          AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="140"
                                          Style="{StaticResource MaterialDesignDataGrid}" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="شناسه دستگاه" Binding="{Binding EnrollNumber, Converter={StaticResource PersianDigits}}" Width="*" />
                                        <DataGridTextColumn Header="پرسنل" Binding="{Binding EmployeeName, Converter={StaticResource PersianDigits}}" Width="2*" />
                                        <DataGridTextColumn Header="کد پرسنلی" Binding="{Binding PersonnelCode, Converter={StaticResource PersianDigits}}" Width="*" />
                                        <DataGridTemplateColumn Header="" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="🗑" Command="{Binding DataContext.DeleteMappingCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═══════════ تب ۳: شیفت‌ها — بازسازی کامل چرخهٔ ۴۴ ═══════════
                 گزارش مالک: «تعریف شیفت ها و تخصیص به پرسنل پیاده سازی نشده.
                 بصورت حرفه ای و کامل و زیبا پیاده سازی بکن».
                 چیدمان: کارت‌های رنگی شیفت‌ها (ویرایش/حذف) + جدول تخصیص‌های فعال
                 (پایان تخصیص) + دو فرم حرفه‌ای با انتخابگر ساعت عقربه‌ای، انتخابگر
                 تاریخ شمسی، کمبوی جستجویی پرسنل/شیفت، پالت رنگ و چیپ روزهای هفته.
                 قوانین مالک: انتخابگر ساعت/تاریخ (۵) + دیالوگ فارسی (۴) + لیبل
                 شناور همهٔ فیلدها (چرخهٔ ۴۳ — استایل ضمنی خودکار). -->
            <TabItem Header="⏰ شیفت‌ها">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2.2*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- سربرگ تب: خلاصه + نوسازی -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Left" Command="{Binding LoadShiftsCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="بازخوانی" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="تعریف الگوهای زمانی کار و تخصیص آن‌ها به پرسنل — مبنای محاسبهٔ تأخیر، کارکرد و اضافه‌کاری"
                                   FontSize="11.5" Opacity="0.65" VerticalAlignment="Center" Margin="10,0,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <!-- بدنه دو ستونه: کارت‌های شیفت (راست) + تخصیص‌های فعال (چپ) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="330" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1.35*" MinWidth="420" />
                        </Grid.ColumnDefinitions>

                        <!-- ─── ستون راست: شیفت‌های تعریف‌شده — کارت‌های رنگی ─── -->
                        <Border Grid.Column="0" CornerRadius="12" Padding="10"
                                Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="🧭 شیفت‌های تعریف‌شده" FontWeight="Bold" FontSize="13" Margin="4,0,0,8" />
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Shifts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="3,4" Padding="10,8" CornerRadius="10"
                                                        Background="{DynamicResource MaterialDesign.Brush.Background}"
                                                        BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                                                        BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <!-- لبهٔ رنگی راستِ کارت = رنگ تقویمی شیفت -->
                                                            <Setter Property="BorderBrush" Value="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />
                                                            <Setter Property="BorderThickness" Value="0,0,3.5,0" />
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#F4F9FF" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- نام + نوع -->
                                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                                            <Border CornerRadius="8" Padding="7,1.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                    Background="{Binding ColorHex, Converter={StaticResource HexBrush}, ConverterParameter=tint}"
                                                                    BorderBrush="{Binding ColorHex, Converter={StaticResource HexToBrush}}" BorderThickness="1">
                                                                <TextBlock Text="{Binding Kind}" FontSize="9.5" FontWeight="SemiBold"
                                                                           Foreground="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <!-- دکمه‌های ویرایش/حذف -->
                                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                                            <Button Command="{Binding DataContext.EditShiftCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource App.RowIconButton}" Padding="4"
                                                                    ToolTip="ویرایش این شیفت">
                                                                <materialDesign:PackIcon Kind="PencilOutline" Width="14" Height="14" />
                                                            </Button>
                                                            <Button Command="{Binding DataContext.DeleteShiftCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource App.RowIconButton}" Padding="4"
                                                                    Foreground="#C62828" ToolTip="حذف این شیفت">
                                                                <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14" />
                                                            </Button>
                                                        </StackPanel>
                                                        <!-- بازهٔ ساعتی + تحمل + شمار تخصیص -->
                                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,5,0,0">
                                                            <materialDesign:PackIcon Kind="ClockOutline" Width="13" Height="13" Opacity="0.6" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding TimeRange, Converter={StaticResource PersianDigits}}"
                                                                       FontSize="11" Margin="5,0,10,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Grace, Converter={StaticResource PersianDigits}}"
                                                                       FontSize="10" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                            <Border CornerRadius="8" Padding="7,1.5" VerticalAlignment="Center"
                                                                    Background="#EDF3FA" BorderBrush="#D3E2F0" BorderThickness="1">
                                                                <TextBlock FontSize="9.5">
                                                                    <Run Text="{Binding Assigned, Converter={StaticResource PersianDigits}}" />
                                                                    <Run Text="پرسنل" />
                                                                </TextBlock>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- ─── ستون چپ: تخصیص‌های فعال ─── -->
                        <Border Grid.Column="2" CornerRadius="12" Padding="10"
                                Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="👥 تخصیص‌های فعال شیفت‌ها" FontWeight="Bold" FontSize="13" Margin="4,0,0,8" />
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Assignments}" IsReadOnly="True"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          Style="{StaticResource MaterialDesignDataGrid}" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="پرسنل" Binding="{Binding EmployeeName, Converter={StaticResource PersianDigits}}" Width="1.5*" />
                                        <DataGridTextColumn Header="کد پرسنلی" Binding="{Binding PersonnelCode, TargetNullValue=—, Converter={StaticResource PersianDigits}}" Width="0.9*" FontFamily="{DynamicResource App.CodeFont}" />
                                        <DataGridTemplateColumn Header="شیفت" Width="1.1*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                 Fill="{Binding ShiftColor, Converter={StaticResource HexToBrush}}" />
                                                        <TextBlock Text="{Binding ShiftName, Converter={StaticResource PersianDigits}}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="بازه" Binding="{Binding Range, Converter={StaticResource PersianDigits}}" Width="1.4*" />
                                        <DataGridTextColumn Header="تکرار" Binding="{Binding Recurrence, Converter={StaticResource PersianDigits}}" Width="0.8*" />
                                        <DataGridTextColumn Header="روزها" Binding="{Binding WeekDays, TargetNullValue=—, Converter={StaticResource PersianDigits}}" Width="1*" />
                                        <DataGridTemplateColumn Header="عملیات" Width="Auto" MinWidth="92">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.EndAssignmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource App.RowIconButton}" Padding="6,3"
                                                            Foreground="#C62828" ToolTip="پایان این تخصیص از امروز">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="StopCircleOutline" Width="13" Height="13" VerticalAlignment="Center" />
                                                            <TextBlock Text="پایان" FontSize="10.5" Margin="4,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ─── دو فرم پایینی: تعریف/ویرایش شیفت + تخصیص ─── -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="330" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1.35*" MinWidth="420" />
                        </Grid.ColumnDefinitions>

                        <!-- فرم ۱: ثبت/ویرایش شیفت -->
                        <Border Grid.Column="0" CornerRadius="12" Padding="12"
                                Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                                BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <materialDesign:PackIcon DockPanel.Dock="Right" Kind="ClockPlusOutline" Width="17" Height="17"
                                                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ShiftFormTitle}" FontWeight="Bold" FontSize="13"
                                               Margin="2,0,8,0" VerticalAlignment="Center" />
                                </DockPanel>
                                <WrapPanel>
                                    <!-- نام شیفت — عنوان شناور خودکار (استایل سراسری چرخهٔ ۴۳) -->
                                    <TextBox materialDesign:HintAssist.Hint="نام شیفت (مثلاً صبح اداری)"
                                             Text="{Binding ShiftName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Width="200" Margin="0,0,8,8" />
                                    <!-- ساعت شروع/پایان — انتخابگر عقربه‌ای (قانون ۵ مالک) -->
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Text="شروع" FontSize="10" Opacity="0.6" Margin="2,0,0,2" />
                                        <controls:TimePicker TimeText="{Binding ShiftStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Text="پایان" FontSize="10" Opacity="0.6" Margin="2,0,0,2" />
                                        <controls:TimePicker TimeText="{Binding ShiftEnd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <ToggleButton IsChecked="{Binding ShiftIsNight}" Margin="0,4,10,6" VerticalAlignment="Center"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  ToolTip="شیفت عبورکننده از نیمه‌شب — پایان کوچک‌تر از شروع یعنی فردا">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="WeatherNight" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Text="شیفت شبانه" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                </WrapPanel>
                                <WrapPanel>
                                    <TextBox materialDesign:HintAssist.Hint="تحمل تأخیر (دقیقه)" Text="{Binding ShiftLateGrace, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="118" Margin="0,0,6,8" />
                                    <TextBox materialDesign:HintAssist.Hint="تحمل تعجیل (دقیقه)" Text="{Binding ShiftEarlyGrace, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="118" Margin="0,0,6,8" />
                                    <TextBox materialDesign:HintAssist.Hint="استراحت کسرشونده (دقیقه)" Text="{Binding ShiftBreak, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="150" Margin="0,0,6,8" />
                                    <TextBox materialDesign:HintAssist.Hint="اضافه‌کاری پس از (دقیقه)" Text="{Binding ShiftOvertimeAfter, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="150" Margin="0,0,6,8" />
                                </WrapPanel>
                                <!-- پالت رنگ تقویمی — ListBox بدون قلم: آیتم همان رشتهٔ هگز است و
                                     SelectedItem دوسویه مستقیماً به ShiftColor بسته می‌شود؛ کلیک روی
                                     نقطهٔ رنگی = انتخاب همان رنگ (بدون نیاز به مبدل مقایسه) -->
                                <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                                    <TextBlock Text="رنگ تقویم:" FontSize="10.5" Opacity="0.65" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ListBox ItemsSource="{Binding ShiftColorPalette, Mode=OneWay}"
                                             SelectedItem="{Binding ShiftColor, Mode=TwoWay}"
                                             Background="Transparent" BorderThickness="0"
                                             Focusable="False" Cursor="Hand"
                                             ToolTip="رنگ نمایش شیفت در تقویم و کارت‌ها">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Dot" Width="22" Height="22" CornerRadius="11" Margin="0,0,7,0"
                                                        Background="{Binding Converter={StaticResource HexToBrush}}"
                                                        BorderThickness="2" BorderBrush="Transparent" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                        <Setter TargetName="Dot" Property="BorderBrush" Value="#37474F" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                                        <Setter TargetName="Dot" Property="Opacity" Value="0.8" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding SaveShiftCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentSave" Width="15" Height="15" VerticalAlignment="Center" />
                                            <!-- متن دکمه با حالت فرم هم‌قدم می‌شود: ثبت یا به‌روزرسانی -->
                                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="به‌روزرسانی شیفت" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EditingShiftId}" Value="{x:Null}">
                                                                <Setter Property="Text" Value="ثبت شیفت جدید" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding CancelShiftEditCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Visibility="{Binding EditingShiftId, Converter={StaticResource NullToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CloseCircleOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Text="انصراف ویرایش" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- فرم ۲: تخصیص شیفت به پرسنل -->
                        <Border Grid.Column="2" CornerRadius="12" Padding="12"
                                Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                                BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <materialDesign:PackIcon DockPanel.Dock="Right" Kind="AccountPlusOutline" Width="17" Height="17"
                                                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
                                    <TextBlock Text="تخصیص شیفت به پرسنل" FontWeight="Bold" FontSize="13"
                                               Margin="2,0,8,0" VerticalAlignment="Center" />
                                </DockPanel>
                                <WrapPanel>
                                    <!-- پرسنل — کمبوی جستجویی (تایپ = پالایش شامل؛ استایل چرخهٔ ۴۳) -->
                                    <ComboBox materialDesign:HintAssist.Hint="جستجوی پرسنل (نام / کد پرسنلی)"
                                              ItemsSource="{Binding Employees}"
                                              SelectedItem="{Binding SelectedAssignEmployee}"
                                              DisplayMemberPath="DisplayName"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              Width="270" Margin="0,0,8,8"
                                              ToolTip="با تایپ بخشی از نام یا کد پرسنلی، فهرست پالایش می‌شود" />
                                    <!-- شیفت — کمبوی جستجویی -->
                                    <ComboBox materialDesign:HintAssist.Hint="شیفت"
                                              ItemsSource="{Binding ShiftOptions}"
                                              SelectedItem="{Binding SelectedAssignShift}"
                                              DisplayMemberPath="DisplayName"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              Width="190" Margin="0,0,8,8" />
                                    <!-- بازهٔ اعتبار — انتخابگر تاریخ شمسی (قانون ۵) -->
                                    <StackPanel Margin="0,0,8,6">
                                        <TextBlock Text="اعتبار از" FontSize="10" Opacity="0.6" Margin="2,0,0,2" />
                                        <controls:PersianDatePicker DateShamsiText="{Binding AssignFromDate, Mode=TwoWay}"
                                                                    Placeholder="تاریخ شروع *" Width="150" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,6">
                                        <TextBlock Text="تا (اختیاری)" FontSize="10" Opacity="0.6" Margin="2,0,0,2" />
                                        <controls:PersianDatePicker DateShamsiText="{Binding AssignToDate, Mode=TwoWay}"
                                                                    Placeholder="بی‌پایان" Width="150" />
                                    </StackPanel>
                                </WrapPanel>
                                <WrapPanel>
                                    <!-- الگوی تکرار -->
                                    <ComboBox materialDesign:HintAssist.Hint="الگوی تکرار"
                                              ItemsSource="{Binding RecurrenceOptions}"
                                              SelectedIndex="{Binding AssignRecurrenceIndex}"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              Width="225" Margin="0,0,8,8" />
                                    <TextBox materialDesign:HintAssist.Hint="اولویت در تعارض (عدد بزرگ‌تر برنده)"
                                             Text="{Binding AssignPriority, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="185" Margin="0,0,8,8" />
                                    <TextBox materialDesign:HintAssist.Hint="یادداشت (اختیاری)"
                                             Text="{Binding AssignNotes, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="240" Margin="0,0,0,8" />
                                </WrapPanel>
                                <!-- چیپ‌های روز هفته — فقط در حالت هفتگی/سفارشی -->
                                <StackPanel Orientation="Horizontal" Margin="2,0,0,8"
                                            Visibility="{Binding ShowWeekDays, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="روزهای فعال:" FontSize="10.5" Opacity="0.65" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <!-- دکمه‌های تاگل روز — بیت‌ها: شنبه=۱ … جمعه=۶۴ -->
                                    <ToggleButton Content="شنبه" IsChecked="{Binding WeekSat}" Margin="0,0,5,0" Style="{StaticResource MaterialDesignFlatToggleButton}" FontSize="10.5" Padding="9,3" />
                                    <ToggleButton Content="یکشنبه" IsChecked="{Binding WeekSun}" Margin="0,0,5,0" Style="{StaticResource MaterialDesignFlatToggleButton}" FontSize="10.5" Padding="9,3" />
                                    <ToggleButton Content="دوشنبه" IsChecked="{Binding WeekMon}" Margin="0,0,5,0" Style="{StaticResource MaterialDesignFlatToggleButton}" FontSize="10.5" Padding="9,3" />
                                    <ToggleButton Content="سه‌شنبه" IsChecked="{Binding WeekTue}" Margin="0,0,5,0" Style="{StaticResource MaterialDesignFlatToggleButton}" FontSize="10.5" Padding="9,3" />
                                    <ToggleButton Content="چهارشنبه" IsChecked="{Binding WeekWed}" Margin="0,0,5,0" Style="{StaticResource MaterialDesignFlatToggleButton}" FontSize="10.5" Padding="9,3" />
                                    <ToggleButton Content="پنجشنبه" IsChecked="{Binding WeekThu}" Margin="0,0,5,0" Style="{StaticResource MaterialDesignFlatToggleButton}" FontSize="10.5" Padding="9,3" />
                                    <ToggleButton Content="جمعه" IsChecked="{Binding WeekFri}" Style="{StaticResource MaterialDesignFlatToggleButton}" FontSize="10.5" Padding="9,3" />
                                </StackPanel>
                                <Button Command="{Binding AssignShiftCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="LinkPlus" Width="15" Height="15" VerticalAlignment="Center" />
                                        <TextBlock Text="ثبت تخصیص" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═══════════ تب ۴: اصلاحیه‌ها ═══════════ -->
            <TabItem Header="📝 اصلاح کارت">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                        <CheckBox Content="فقط درخواست‌های در انتظار" IsChecked="{Binding OnlyPending}" />
                    </WrapPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Corrections}" IsReadOnly="True"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              Style="{StaticResource MaterialDesignDataGrid}" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="پرسنل" Binding="{Binding EmployeeName, Converter={StaticResource PersianDigits}}" Width="1.6*" />
                            <DataGridTextColumn Header="تاریخ" Binding="{Binding Date, Converter={StaticResource PersianDigits}}" Width="*" />
                            <DataGridTextColumn Header="فیلد" Binding="{Binding Field, Converter={StaticResource PersianDigits}}" Width="0.7*" />
                            <DataGridTextColumn Header="تغییر" Binding="{Binding Change, Converter={StaticResource PersianDigits}}" Width="*" />
                            <DataGridTextColumn Header="دلیل" Binding="{Binding Reason, Converter={StaticResource PersianDigits}}" Width="2*" />
                            <DataGridTemplateColumn Header="وضعیت" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusHex}" CornerRadius="10"
                                                Padding="10,3" HorizontalAlignment="Center" Margin="0,4">
                                            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11.5" FontWeight="Bold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="اقدام" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding Pending, Converter={StaticResource BoolToVisibility}}">
                                            <Button Content="✅" ToolTip="تأیید و اعمال"
                                                    Command="{Binding DataContext.ApproveCorrectionCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignFlatButton}" />
                                            <Button Content="❌" ToolTip="رد"
                                                    Command="{Binding DataContext.RejectCorrectionCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignFlatButton}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ═══════════ تب ۵: گزارش ماهانه ═══════════ -->
            <TabItem Header="📊 گزارش ماهانه">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="دوره:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0" />
                        <ComboBox SelectedValue="{Binding SelectedYear}" SelectedValuePath="Content" MinWidth="90" Margin="0,0,8,0">
                            <ComboBoxItem Content="1401" /><ComboBoxItem Content="1402" /><ComboBoxItem Content="1403" />
                            <ComboBoxItem Content="1404" /><ComboBoxItem Content="1405" />
                        </ComboBox>
                        <ComboBox SelectedIndex="{Binding SelectedMonthIndex}" MinWidth="105" Margin="0,0,14,0">
                            <ComboBoxItem Content="فروردین" /><ComboBoxItem Content="اردیبهشت" /><ComboBoxItem Content="خرداد" />
                            <ComboBoxItem Content="تیر" /><ComboBoxItem Content="مرداد" /><ComboBoxItem Content="شهریور" />
                            <ComboBoxItem Content="مهر" /><ComboBoxItem Content="آبان" /><ComboBoxItem Content="آذر" />
                            <ComboBoxItem Content="دی" /><ComboBoxItem Content="بهمن" /><ComboBoxItem Content="اسفند" />
                        </ComboBox>
                        <Button Command="{Binding LoadMonthlyCommand}" Content="📊 بارگذاری"
                                Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,14,0" />
                        <TextBlock VerticalAlignment="Center" Margin="0,0,6,0">
                            <Run Text="جمع کارکرد: " /><Run Text="{Binding TotalWorked, Mode=OneWay}" FontWeight="Bold" Foreground="#1E88E5" />
                            <Run Text=" ساعت | جمع اضافه‌کاری: " /><Run Text="{Binding TotalOvertime, Mode=OneWay}" FontWeight="Bold" Foreground="#43A047" />
                            <Run Text=" ساعت" />
                        </TextBlock>
                    </WrapPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding MonthlyRows}" IsReadOnly="True"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              Style="{StaticResource MaterialDesignDataGrid}" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="پرسنل" Binding="{Binding FullName, Converter={StaticResource PersianDigits}}" Width="1.8*" />
                            <DataGridTextColumn Header="کد پرسنلی" Binding="{Binding PersonnelCode, Converter={StaticResource PersianDigits}}" Width="*" />
                            <DataGridTextColumn Header="بخش" Binding="{Binding Department, Converter={StaticResource PersianDigits}}" Width="1.3*" />
                            <DataGridTextColumn Header="روز حاضر" Binding="{Binding Present, Converter={StaticResource PersianDigits}}" Width="0.8*" />
                            <DataGridTextColumn Header="تأخیرها" Binding="{Binding LateCount, Converter={StaticResource PersianDigits}}" Width="0.7*" />
                            <DataGridTextColumn Header="مجموع تأخیر" Binding="{Binding LateTotal, Converter={StaticResource PersianDigits}}" Width="*" />
                            <DataGridTextColumn Header="کارکرد (ساعت)" Binding="{Binding Worked, Converter={StaticResource PersianDigits}}" Width="*" />
                            <DataGridTextColumn Header="اضافه‌کاری (ساعت)" Binding="{Binding Overtime, Converter={StaticResource PersianDigits}}" Width="*" />
                            <DataGridTextColumn Header="غیبت" Binding="{Binding Absent, Converter={StaticResource PersianDigits}}" Width="0.6*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
