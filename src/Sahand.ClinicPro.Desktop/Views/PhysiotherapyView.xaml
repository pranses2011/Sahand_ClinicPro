<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.PhysiotherapyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="774" d:DesignWidth="1030"
             FlowDirection="RightToLeft">
    <!-- فیزیوتراپی — بازطراحی کامل بر اساس docs/design/approved/physiotherapy.html
         نقشهٔ بدن همچنان توسط کدپشت روی BodyMapHost ساخته میشود (عملکرد حفظ شد). -->
    <Grid Background="{StaticResource Ds.PageBackground}" Margin="14,11,14,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><!-- سربرگ -->
            <RowDefinition Height="Auto" /><!-- کارتها -->
            <RowDefinition Height="Auto" /><!-- تبها -->
            <RowDefinition Height="Auto" /><!-- نوار ابزار -->
            <RowDefinition Height="Auto" /><!-- سه پنل -->
            <RowDefinition Height="Auto" /><!-- نمودار روند -->
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" /><!-- پانوشت -->
        </Grid.RowDefinitions>

        <!-- ══ سربرگ ══ -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="#0D9488" Margin="0,0,9,0">
                <TextBlock Text="✚" FontSize="17" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="دورهٔ درمان فیزیوتراپی" Style="{StaticResource Ds.PageTitle}" />
                <TextBlock Text="نقشهٔ بدن، ثبت جلسات، درد و روند بهبود — پروتکل ۱۲ جلسهای" Style="{StaticResource Ds.Muted}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="جلسهٔ جدید" Style="{StaticResource Ds.FlatPrimary}" Height="32" Padding="14,0" Margin="0,0,7,0" />
                <Button Content="چاپ گزارش ارجاع" Style="{StaticResource Ds.OutlineButton}" Height="32" Padding="13,0" />
            </StackPanel>
        </Grid>

        <!-- ══ پنج کارت آماری ══ -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource Ds.StatCard}" Background="#F4FBF4" BorderBrush="#81C784">
                <StackPanel><TextBlock Text="{Binding Kpis.V1}" Style="{StaticResource Ds.StatNumber}" Foreground="#2E7D32" />
                    <TextBlock Text="جلسات امروز" Style="{StaticResource Ds.StatLabel}" /></StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource Ds.StatCard}" Background="#FFF5F5" BorderBrush="#E57373">
                <StackPanel><TextBlock Text="{Binding Kpis.V2}" Style="{StaticResource Ds.StatNumber}" Foreground="#C62828" />
                    <TextBlock Text="پرچم قرمز" Style="{StaticResource Ds.StatLabel}" /></StackPanel>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource Ds.StatCard}" Background="#FDF7FF" BorderBrush="#BA68C8">
                <StackPanel><TextBlock Text="{Binding Kpis.V3}" Style="{StaticResource Ds.StatNumber}" Foreground="#6A1B9A" />
                    <TextBlock Text="بیماران فعال" Style="{StaticResource Ds.StatLabel}" /></StackPanel>
            </Button>
            <Button Grid.Column="6" Style="{StaticResource Ds.StatCard}" Background="#FFFAF3" BorderBrush="#FFB74D">
                <StackPanel><TextBlock Text="{Binding Kpis.V4}" Style="{StaticResource Ds.StatNumber}" Foreground="#E65100" />
                    <TextBlock Text="جلسات باقیمانده" Style="{StaticResource Ds.StatLabel}" /></StackPanel>
            </Button>
            <Button Grid.Column="8" Style="{StaticResource Ds.StatCard}" Background="#F5FAFF" BorderBrush="#64B5F6">
                <StackPanel><TextBlock Text="{Binding Kpis.V5}" Style="{StaticResource Ds.StatNumber}" Foreground="#1565C0" />
                    <TextBlock Text="میانگین بهبود" Style="{StaticResource Ds.StatLabel}" /></StackPanel>
            </Button>
        </Grid>

        <!-- ══ تبها ══ -->
        <Border Grid.Row="2" Style="{StaticResource Ds.TabBar}" Padding="0,2,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border BorderBrush="#1565C0" BorderThickness="0,0,0,2" Margin="0,0,4,0">
                    <TextBlock Text="جلسهٔ درمان" Style="{StaticResource Ds.TabItemActiveText}" />
                </Border>
                <TextBlock Text="نقشهٔ بدن" Style="{StaticResource Ds.TabItemText}" />
                <TextBlock Text="ارزیابی و اهداف" Style="{StaticResource Ds.TabItemText}" />
                <TextBlock Text="روند پیشرفت" Style="{StaticResource Ds.TabItemText}" />
            </StackPanel>
        </Border>

        <!-- ══ نوار ابزار ══ -->
        <Border Grid.Row="3" Style="{StaticResource Ds.Toolbar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" /><ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource Ds.CompactText}"
                         Text="{Binding PhysioPatientSearch, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Content="جستجو ⌕" Style="{StaticResource Ds.FlatPrimary}" Height="30"
                        Padding="13,0" Margin="7,0,0,0" />
                <Border Grid.Column="2" Background="#EDF5FF" BorderBrush="#BBDBFB" BorderThickness="1"
                        CornerRadius="7" Height="30" Margin="7,0,0,0" Padding="8,0">
                    <TextBlock Text="{Binding PhysioPatient.FullName, FallbackValue='مریم کریمی — کد ۰۰۱۲۳۴'}"
                               FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <TextBlock Text="{Binding ActiveProtocolName, FallbackValue='پروتکل: کمردرد مزمن — جلسهٔ ۵ از ۱۲'}"
                               Style="{StaticResource Ds.Muted}" VerticalAlignment="Center" Margin="0,0,8,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="300" />
                    <Button Content="شروع جلسه" Style="{StaticResource Ds.FlatPrimary}" Height="30" Padding="13,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ ردیف اصلی: نقشهٔ بدن / ثبت جلسه / پرچمها ══ -->
        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" /><ColumnDefinition Width="8" />
                <ColumnDefinition Width="1.15*" /><ColumnDefinition Width="8" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- نقشهٔ بدن (همان هاست کدپشت) -->
            <Border Grid.Column="0" Style="{StaticResource Ds.Panel}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="نقشهٔ بدن — محل درد 📍" Style="{StaticResource Ds.PanelTitle}" />
                    <Viewbox Grid.Row="1" MaxHeight="185" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid x:Name="BodyMapHost" Width="1408" Height="768" />
                    </Viewbox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <Border Style="{StaticResource Ds.Tag}" Background="#FDECEA" BorderBrush="#F5C6C2">
                            <TextBlock Text="شدید" FontSize="9.5" Foreground="#C62828" /></Border>
                        <Border Style="{StaticResource Ds.Tag}" Background="#FFF3E0" BorderBrush="#FFCC80" Margin="4,0,0,0">
                            <TextBlock Text="متوسط" FontSize="9.5" Foreground="#E65100" /></Border>
                        <Border Style="{StaticResource Ds.Tag}" Background="#E8F5E9" BorderBrush="#A5D6A7" Margin="4,0,0,0">
                            <TextBlock Text="بدون درد" FontSize="9.5" Foreground="#2E7D32" /></Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- فرم ثبت جلسه -->
            <Border Grid.Column="2" Style="{StaticResource Ds.Panel}">
                <StackPanel>
                    <TextBlock Text="ثبت جلسهٔ پنجم 📝" Style="{StaticResource Ds.PanelTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><TextBlock Text="تاریخ جلسه" Style="{StaticResource Ds.FieldLabel}" />
                            <Border Style="{StaticResource Ds.FieldValue}"><TextBlock Text="۱۴۰۵/۰۸/۰۵" FontSize="10.5" HorizontalAlignment="Center" /></Border></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="مدت جلسه" Style="{StaticResource Ds.FieldLabel}" />
                            <Border Style="{StaticResource Ds.FieldValue}"><TextBlock Text="۴۵ دقیقه" FontSize="10.5" HorizontalAlignment="Center" /></Border></StackPanel>
                    </Grid>
                    <TextBlock Text="تعداد جلسه" Style="{StaticResource Ds.FieldLabel}" />
                    <Border Style="{StaticResource Ds.FieldValue}"><TextBlock Text="۴" FontSize="10.5" HorizontalAlignment="Center" /></Border>
                    <TextBlock Text="تکنیکهای درمانی" Style="{StaticResource Ds.FieldLabel}" />
                    <WrapPanel Margin="0,2,0,4">
                        <Button Content="اولتراسوند" Style="{StaticResource Ds.ChipActive}" Margin="0,0,3,3" Padding="8,0" Height="24" />
                        <Button Content="TENS" Style="{StaticResource Ds.ChipActive}" Margin="0,0,3,3" Padding="8,0" Height="24" />
                        <Button Content="تمرینات درمانی" Style="{StaticResource Ds.ChipActive}" Margin="0,0,3,3" Padding="8,0" Height="24" />
                        <Button Content="ماساژ" Style="{StaticResource Ds.Chip}" Margin="0,0,3,3" Padding="8,0" Height="24" />
                        <Button Content="لیزر درمانی" Style="{StaticResource Ds.Chip}" Margin="0,0,3,3" Padding="8,0" Height="24" />
                        <Button Content="هیدروتراپی" Style="{StaticResource Ds.Chip}" Margin="0,0,3,3" Padding="8,0" Height="24" />
                    </WrapPanel>
                    <TextBlock Text="یادداشت بالینی" Style="{StaticResource Ds.FieldLabel}" />
                    <Border Style="{StaticResource Ds.FieldValue}" Height="38" VerticalAlignment="Top">
                        <TextBlock Text="{Binding PhysioNotes, FallbackValue='بهبود قابل توجه در خمشدن به جلو؛ ادامهٔ تمرینات ثباتدهندهٔ مرکزی.'}"
                                   FontSize="9.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Border>
                    <Button Content="ذخیرهٔ جلسه" Style="{StaticResource Ds.FlatPrimary}" Height="32" Margin="0,7,0,0" />
                </StackPanel>
            </Border>

            <!-- پرچمهای قرمز -->
            <Border Grid.Column="4" Style="{StaticResource Ds.Panel}">
                <StackPanel>
                    <TextBlock Text="غربالگری پرچمهای قرمز 🚩" Style="{StaticResource Ds.PanelTitle}" />
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Ds.Tag}" Background="#E8F5E9" BorderBrush="#A5D6A7">
                            <TextBlock Text="حذف" Style="{StaticResource Ds.TagText}" /></Border>
                        <TextBlock Grid.Column="1" Text="کاهش وزن بیعلت" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Ds.Tag}" Background="#E8F5E9" BorderBrush="#A5D6A7">
                            <TextBlock Text="حذف" Style="{StaticResource Ds.TagText}" /></Border>
                        <TextBlock Grid.Column="1" Text="تب / عفونت" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Ds.Tag}" Background="#FDECEA" BorderBrush="#F5C6C2">
                            <TextBlock Text="بله — بررسی" FontSize="9.5" Foreground="#C62828" /></Border>
                        <TextBlock Grid.Column="1" Text="بیاختیاری ادرار" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Ds.Tag}" Background="#E8F5E9" BorderBrush="#A5D6A7">
                            <TextBlock Text="حذف" Style="{StaticResource Ds.TagText}" /></Border>
                        <TextBlock Grid.Column="1" Text="سابقهٔ سرطان" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Ds.Tag}" Background="#E8F5E9" BorderBrush="#A5D6A7">
                            <TextBlock Text="حذف" Style="{StaticResource Ds.TagText}" /></Border>
                        <TextBlock Grid.Column="1" Text="ترومای اخیر" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="7" Padding="8,5" Margin="0,6,0,0">
                        <TextBlock Text="⚠️ وجود پرچم قرمز — ارجاع به پزشک متخصص پیشنهاد میشود."
                                   FontSize="9.5" Foreground="#B45309" TextWrapping="Wrap" />
                    </Border>
                    <Button Content="چاپ گزارش ارجاع" Style="{StaticResource Ds.OutlineButton}" Margin="0,7,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ نمودار روند ══ -->
        <Border Grid.Row="5" Style="{StaticResource Ds.Panel}">
            <StackPanel>
                <TextBlock Text="روند درد و دامنهٔ حرکت (۵ جلسهٔ اخیر) 📈" Style="{StaticResource Ds.PanelTitle}" />
                <Grid Height="72">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Bottom"><Border Height="62" Background="#43A047" CornerRadius="4,4,0,0" Margin="12,0" /></StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom"><Border Height="55" Background="#43A047" CornerRadius="4,4,0,0" Margin="12,0" /></StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom"><Border Height="47" Background="#43A047" CornerRadius="4,4,0,0" Margin="12,0" /></StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Bottom"><Border Height="36" Background="#43A047" CornerRadius="4,4,0,0" Margin="12,0" /></StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom"><Border Height="26" Background="#43A047" CornerRadius="4,4,0,0" Margin="12,0" /></StackPanel>
                </Grid>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="جلسهٔ ۱" Style="{StaticResource Ds.Muted}" HorizontalAlignment="Center" FontSize="9" />
                    <TextBlock Grid.Column="1" Text="جلسهٔ ۲" Style="{StaticResource Ds.Muted}" HorizontalAlignment="Center" FontSize="9" />
                    <TextBlock Grid.Column="2" Text="جلسهٔ ۳" Style="{StaticResource Ds.Muted}" HorizontalAlignment="Center" FontSize="9" />
                    <TextBlock Grid.Column="3" Text="جلسهٔ ۴" Style="{StaticResource Ds.Muted}" HorizontalAlignment="Center" FontSize="9" />
                    <TextBlock Grid.Column="4" Text="جلسهٔ ۵" Style="{StaticResource Ds.Muted}" HorizontalAlignment="Center" FontSize="9" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="7" Text="سهند کلینیکپرو — دورهٔ درمان فیزیوتراپی · نقشهٔ بدن و روند بهبود · نسخهٔ ۲٫۲۸٫۲۸"
                   Style="{StaticResource Ds.Muted}" HorizontalAlignment="Center" Margin="0,5,0,0" />
    </Grid>
</UserControl>
