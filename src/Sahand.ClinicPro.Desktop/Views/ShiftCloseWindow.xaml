<Window x:Class="Sahand.ClinicPro.Desktop.Views.ShiftCloseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:behaviors="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        Title="🌙 بستن شیفت صندوق و تحویل"
        Width="1220" Height="820" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft">
    <!-- ═══ بستن شیفت — چرخهٔ ۱۳ (درخواست ۲-۲): شمارش فیزیکی ↔ سیستم + رسید + تاریخچه
         ═══ چرخهٔ ۴۳ (گزارش مالک): «صفجه کمی کوچیکه و دکمه بستن شیفت در پایین صفحه
         دیده نمیشه» — پنجره بزرگ‌تر شد (۱۲۲۰×۸۲۰ + حداقل‌ها)، ستون شمارش داخل
         اسکرول قرار گرفت و «دکمهٔ بستن شیفت» بیرون از اسکرول و همیشه نمایان
         (ردیف پین‌شدهٔ انتهای ستون). مبالغ هم هم‌واحد با تنظیمات (ریال/تومان)
         شدند و ورودی‌های شمارش MoneyInput گرفتند. ═══ -->
    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- سربرگ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <materialDesign:PackIcon Kind="CashLock" Width="26" Height="26"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                     VerticalAlignment="Center" />
            <TextBlock Text="🌙 بستن شیفت صندوق و تحویل" FontSize="18" FontWeight="Bold"
                       Margin="10,0,0,0" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Left" Command="{Binding LoadCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" HorizontalAlignment="Left" Margin="0,0,8,0">
                <materialDesign:PackIcon Kind="Refresh" Width="15" Height="15" />
            </Button>
        </DockPanel>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,10"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!-- بدنه دو ستونه -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1.35*" />
            </Grid.ColumnDefinitions>

            <!-- ستون ۱: جدول مغایرت‌گیری — اسکرول‌شونده با دکمهٔ پین‌شده -->
            <Border Grid.Column="0" CornerRadius="12" Padding="0" Margin="0,0,10,0"
                    Background="{DynamicResource MaterialDesign.Brush.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- بخش اسکرول‌شونده — همهٔ محتوا در دسترس، دکمه هرگز زیر تیغهٔ صفحه پنهان نمی‌شود -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="16,14,16,6">
                        <StackPanel>
                            <TextBlock Text="💵 مغایرت‌گیری پایان شیفت — سیستم در برابر شمارش" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                            <TextBlock FontSize="11" Opacity="0.65" Margin="0,0,0,10" TextWrapping="Wrap"
                                       Text="ستون «مبلغ سیستم» از فروش‌های ثبت‌شدهٔ امروز می‌آید؛ شمارش فیزیکی را بنویسید تا مغایرت همان لحظه محاسبه شود. همهٔ مبالغ با واحد پول انتخابیِ شما نمایش داده می‌شوند." />

                            <!-- سربرگ جدول سه‌ستونه -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="Auto" MinWidth="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="11" Opacity="0.6" FontWeight="SemiBold"><Run Text="مبلغ سیستم (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock>
                                <TextBlock Grid.Column="1" Text="شمارش شما" Opacity="0.6" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="مغایرت زنده" Opacity="0.6" FontSize="11" FontWeight="SemiBold" />
                            </Grid>
                            <Separator Margin="0,0,0,8" />

                            <!-- ردیف ۱: نقد — سیستم | ورودی | مغایرت -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="Auto" MinWidth="120" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#ECEFF1" CornerRadius="8" Padding="10,7" VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="💵 نقدی — فروش ثبت‌شده" FontSize="10.5" Opacity="0.7" />
                                        <TextBlock Text="{Binding SystemCashDisplay, Mode=OneWay}" FontSize="15" FontWeight="Bold" FontFamily="{DynamicResource App.CodeFont}" />
                                    </StackPanel>
                                </Border>
                                <!-- چرخهٔ ۴۳ — ورودی مبلغ با جداکنندهٔ زندهٔ ۳رققی و هم‌واحدی نمایش/ورود -->
                                <TextBox Grid.Column="1" behaviors:MoneyInput.IsEnabled="True"
                                         behaviors:MoneyInput.NumericValue="{Binding CountedCash, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MoneyRial}}"
                                         FontSize="14" FontFamily="{DynamicResource App.CodeFont}"
                                         materialDesign:HintAssist.Hint="وجه نقد شمرده‌شده" Margin="8,0,0,0" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="#E8F5E9" CornerRadius="8" Padding="9,6" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LiveCashDiffDisplay, Mode=OneWay}" FontSize="13" FontWeight="Bold"
                                               FontFamily="{DynamicResource App.CodeFont}" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>

                            <!-- ردیف ۲: کارتخوان -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="Auto" MinWidth="120" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#ECEFF1" CornerRadius="8" Padding="10,7" VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="💳 کارتخوان — از گزارش دستگاه" FontSize="10.5" Opacity="0.7" />
                                        <TextBlock Text="{Binding SystemCardDisplay, Mode=OneWay}" FontSize="15" FontWeight="Bold" FontFamily="{DynamicResource App.CodeFont}" />
                                    </StackPanel>
                                </Border>
                                <TextBox Grid.Column="1" behaviors:MoneyInput.IsEnabled="True"
                                         behaviors:MoneyInput.NumericValue="{Binding CountedCard, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MoneyRial}}"
                                         FontSize="14" FontFamily="{DynamicResource App.CodeFont}"
                                         materialDesign:HintAssist.Hint="مبلغ تراکنش‌های کارتخوان" Margin="8,0,0,0" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="#E8F5E9" CornerRadius="8" Padding="9,6" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LiveCardDiffDisplay, Mode=OneWay}" FontSize="13" FontWeight="Bold"
                                               FontFamily="{DynamicResource App.CodeFont}" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>

                            <!-- ردیف ۳: آنلاین — فقط نمایش سیستم (شمارش فیزیکی ندارد؛ از درگاه می‌آید) -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="Auto" MinWidth="120" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#ECEFF1" CornerRadius="8" Padding="10,7" VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="🌐 آنلاین — درگاه اینترنتی" FontSize="10.5" Opacity="0.7" />
                                        <TextBlock Text="{Binding SystemOnlineDisplay, Mode=OneWay}" FontSize="15" FontWeight="Bold" FontFamily="{DynamicResource App.CodeFont}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Column="1" Text="بدون شمارش فیزیکی — از درگاه" FontSize="11" Opacity="0.55"
                                           VerticalAlignment="Center" Margin="8,0,0,0" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="—" FontSize="13" Opacity="0.5" HorizontalAlignment="Center" />
                            </Grid>

                            <!-- جمع خالص: سیستم در برابر شمارش -->
                            <Border Background="#E3F2FD" CornerRadius="10" Padding="12,9" Margin="0,2,0,12"
                                    BorderBrush="#90CAF9" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="Auto" MinWidth="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="جمع خالص سیستم (نقد + کارت + آنلاین)" FontSize="10.5" Opacity="0.75" />
                                        <TextBlock Text="{Binding SystemNetDisplay, Mode=OneWay}" FontSize="16" FontWeight="Bold" FontFamily="{DynamicResource App.CodeFont}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="جمع شمارش (نقد + کارت)" FontSize="10.5" Opacity="0.75" />
                                        <TextBlock FontSize="16" FontWeight="Bold" FontFamily="{DynamicResource App.CodeFont}">
                                            <Run Text="{Binding CountedCash, Mode=OneWay, Converter={StaticResource CurrencyRial}}" /><Run Text=" + " /><Run Text="{Binding CountedCard, Mode=OneWay, Converter={StaticResource CurrencyRial}}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <!-- مغایرت خالص زنده — رنگ پویا از ویومدل (سبز/قرمز/کهربایی) -->
                                    <Border Grid.Column="2" CornerRadius="8" Padding="9,7" Margin="8,0,0,0" VerticalAlignment="Center"
                                            Background="#F5F7FB">
                                        <TextBlock Text="{Binding LiveNetDiffDisplay, Mode=OneWay}" FontSize="13.5" FontWeight="Bold"
                                                   FontFamily="{DynamicResource App.CodeFont}" HorizontalAlignment="Center"
                                                   Foreground="{Binding LiveDiffColor, Mode=OneWay}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- پیام وضعیت مغایرت زنده -->
                            <TextBlock Text="{Binding LiveDiffState, Mode=OneWay}" FontSize="12.5" FontWeight="Bold"
                                       Foreground="{Binding LiveDiffColor, Mode=OneWay}" Margin="2,0,2,12" TextWrapping="Wrap" />

                            <!-- تحویل‌گیرنده و یادداشت -->
                            <TextBlock Text="تحویل به (صندوقدار شیفت بعد)" FontSize="11.5" Opacity="0.7" Margin="0,0,0,4" />
                            <ComboBox SelectedIndex="{Binding HandoverToIndex}" FontSize="12.5" Margin="0,0,0,10"
                                      ItemsSource="{Binding Users}" DisplayMemberPath="DisplayName"
                                      materialDesign:HintAssist.Hint="تحویل‌گیرنده" />

                            <TextBlock Text="یادداشت تحویل (اختیاری)" FontSize="11.5" Opacity="0.7" Margin="0,0,0,4" />
                            <TextBox Text="{Binding HandoverNote, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinLines="2" MaxLength="400" Margin="0,0,0,6"
                                     materialDesign:HintAssist.Hint="مثلاً: قفل صندوق تحویل شد؛ برگشت‌ها در کشوی پایین" />

                            <!-- وضعیت اختلاف آخرین رسید -->
                            <Border Background="#F5F7FB" CornerRadius="10" Padding="11,9" Margin="0,4,0,4"
                                    Visibility="{Binding ReceiptText, Converter={StaticResource NullToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="🧾 خلاصهٔ آخرین رسید" FontSize="12" FontWeight="Bold" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding DifferenceState}" Foreground="{Binding DifferenceColor, Mode=OneWay}"
                                               FontSize="13.5" FontWeight="Bold" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding ReceiptText}" FontSize="11" LineHeight="21" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- دکمهٔ بستن شیفت — پین‌شده و همیشه نمایان (بیرون از اسکرول؛ گزارش مالک چرخهٔ ۴۳) -->
                    <Border Grid.Row="1" Padding="16,10,16,12"
                            BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                            BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                        <Button Command="{Binding CloseShiftCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Stretch"
                                FontSize="14" Height="48" MinWidth="260"
                                Background="#00838F" BorderBrush="#00838F">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="LockCheck" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="🔒 بستن شیفت و صدور رسید تحویل" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <!-- ستون ۲: تاریخچه -->
            <Border Grid.Column="1" CornerRadius="12" Padding="12"
                    Background="{DynamicResource MaterialDesign.Brush.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="📚 تاریخچه شیفت‌های بسته‌شده" FontWeight="Bold"
                               FontSize="14" Margin="2,0,2,8" />
                    <!-- ═══ چرخهٔ ۴۳ (گزارش مالک: «در لیست تاریخچه، قانون عرض ستونها که
                         باید محتوا و عنوان ستون کامل دیده بشه اعمال نشده») ═══
                         ستون‌ها Auto + حداقل عرض سخاوتمندانه تا عنوان و محتوای کامل
                         هر ستون (مبالغ هزارگان و نام بستن‌دهنده) بدون بریدگی دیده
                         شوند؛ ستون وضعیت باقی عرض را می‌گیرد. ═══ -->
                    <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              FontSize="11.5" FlowDirection="RightToLeft"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رسید" Binding="{Binding ReceiptNumber, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="80" FontFamily="{DynamicResource App.CodeFont}" />
                            <DataGridTextColumn Header="صندوق" Binding="{Binding RegisterName, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="100" />
                            <DataGridTextColumn Header="زمان بستن" Binding="{Binding ClosedText, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="130" />
                            <DataGridTextColumn Header="بستن‌دهنده" Binding="{Binding ClosedByName, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="115" />
                            <DataGridTextColumn Header="نقد" Binding="{Binding TotalCash, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="110" FontFamily="{DynamicResource App.CodeFont}" />
                            <DataGridTextColumn Header="کارت" Binding="{Binding TotalCard, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="110" FontFamily="{DynamicResource App.CodeFont}" />
                            <DataGridTextColumn Header="آنلاین" Binding="{Binding TotalOnline, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="100" FontFamily="{DynamicResource App.CodeFont}" />
                            <DataGridTextColumn Header="اختلاف" Binding="{Binding Difference, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="100" FontFamily="{DynamicResource App.CodeFont}" />
                            <DataGridTextColumn Header="وضعیت اختلاف" Binding="{Binding DifferenceState, Converter={StaticResource PersianDigits}}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- پانوشت -->
        <TextBlock Grid.Row="3" Text="راهنما: پیش از بستن شیفت همه تراکنش‌های شیفت را ثبت کنید — پس از بستن، پیش‌نمایش رسید برای چاپ باز می‌شود و برای صندوقدار بعد قابل تحویل است."
                   FontSize="10.5" Opacity="0.55" Margin="2,10,0,0" />
    </Grid>
</Window>
