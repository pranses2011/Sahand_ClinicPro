<Window x:Class="Sahand.ClinicPro.Desktop.Views.ShiftCloseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="🌙 بستن شیفت صندوق و تحویل"
        Width="980" Height="720"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="pack://application:,,,/Assets/Fonts/#Vazirmatn">
    <!-- ═══ بستن شیفت — چرخه ۱۳ (درخواست ۲-۲): شمارش فیزیکی ↔ سیستم + رسید + تاریخچه ═══ -->
    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- سربرگ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <materialDesign:PackIcon Kind="CashLock" Width="26" Height="26"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                     VerticalAlignment="Center" />
            <TextBlock Text="🌙 بستن شیفت صندوق و تحویل" FontSize="18" FontWeight="Bold"
                       Margin="10,0,0,0" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Left" Command="{Binding LoadCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" HorizontalAlignment="Left" Margin="0,0,8,0">
                <materialDesign:PackIcon Kind="Refresh" Width="15" Height="15" />
            </Button>
        </DockPanel>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,10"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!-- بدنه دو ستونه -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <!-- ستون ۱: فرم شمارش -->
            <Border Grid.Column="0" CornerRadius="12" Padding="16" Margin="0,0,10,0"
                    Background="{DynamicResource MaterialDesign.Brush.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="💵 شمارش فیزیکی پایان شیفت" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />

                    <TextBlock Text="وجه نقد شمرده‌شده (ریال)" FontSize="11.5" Opacity="0.7" Margin="0,0,0,4" />
                    <TextBox Text="{Binding CountedCash, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" FontFamily="Consolas"
                             materialDesign:HintAssist.Hint="مثلاً ۴۵۰٬۰۰۰" Margin="0,0,0,12" />

                    <TextBlock Text="مبلغ تراکنش‌های کارتخوان (ریال)" FontSize="11.5" Opacity="0.7" Margin="0,0,0,4" />
                    <TextBox Text="{Binding CountedCard, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" FontFamily="Consolas"
                             materialDesign:HintAssist.Hint="از گزارش کارتخوان" Margin="0,0,0,12" />

                    <TextBlock Text="تحویل به (صندوقدار شیفت بعد)" FontSize="11.5" Opacity="0.7" Margin="0,0,0,4" />
                    <ComboBox SelectedIndex="{Binding HandoverToIndex}" FontSize="12.5" Margin="0,0,0,12"
                              ItemsSource="{Binding Users}" DisplayMemberPath="DisplayName" />

                    <TextBlock Text="یادداشت تحویل (اختیاری)" FontSize="11.5" Opacity="0.7" Margin="0,0,0,4" />
                    <TextBox Text="{Binding HandoverNote, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="12"
                             AcceptsReturn="True" TextWrapping="Wrap" MinLines="2" MaxLength="400" Margin="0,0,0,16" />

                    <Button Command="{Binding CloseShiftCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Stretch"
                            FontSize="13.5" Height="44">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="LockCheck" Width="17" Height="17" VerticalAlignment="Center" />
                            <TextBlock Text="🔒 بستن شیفت و صدور رسید تحویل" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- وضعیت اختلاف آخرین رسید -->
                    <Border Background="#F5F7FB" CornerRadius="10" Padding="11,9" Margin="0,14,0,0"
                            Visibility="{Binding ReceiptText, Converter={StaticResource NullToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding DifferenceState}" Foreground="{Binding DifferenceColor, Mode=OneWay}"
                                       FontSize="13.5" FontWeight="Bold" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding ReceiptText}" FontSize="11" LineHeight="21" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ستون ۲: تاریخچه -->
            <Border Grid.Column="1" CornerRadius="12" Padding="12"
                    Background="{DynamicResource MaterialDesign.Brush.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="📚 تاریخچه شیفت‌های بسته‌شده" FontWeight="Bold"
                               FontSize="14" Margin="2,0,2,8" />
                    <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              FlowDirection="RightToLeft">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رسید" Binding="{Binding ReceiptNumber}" Width="80" FontFamily="Consolas" />
                            <DataGridTextColumn Header="صندوق" Binding="{Binding RegisterName}" Width="85" />
                            <DataGridTextColumn Header="زمان بستن" Binding="{Binding ClosedText}" Width="120" />
                            <DataGridTextColumn Header="بستن‌دهنده" Binding="{Binding ClosedByName}" Width="100" />
                            <DataGridTextColumn Header="نقد" Binding="{Binding TotalCash}" Width="90" />
                            <DataGridTextColumn Header="کارت" Binding="{Binding TotalCard}" Width="90" />
                            <DataGridTextColumn Header="آنلاین" Binding="{Binding TotalOnline}" Width="85" />
                            <DataGridTextColumn Header="اختلاف" Binding="{Binding Difference}" Width="85" />
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding DifferenceState}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- پانوشت -->
        <TextBlock Grid.Row="3" Text="راهنما: پیش از بستن شیفت همه تراکنش‌های شیفت را ثبت کنید — رسید تحویل با اختلاف‌سنجی برای صندوقدار بعد صادر می‌شود."
                   FontSize="10.5" Opacity="0.55" Margin="2,10,0,0" />
    </Grid>
</Window>
