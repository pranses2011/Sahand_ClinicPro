<Window x:Class="Sahand.ClinicPro.Desktop.Views.ShiftCloseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="🌙 بستن شیفت صندوق و تحویل"
        Width="1060" Height="740"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft">
    <!-- ═══ بستن شیفت — چرخه ۱۳ (درخواست ۲-۲): شمارش فیزیکی ↔ سیستم + رسید + تاریخچه ═══ -->
    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- سربرگ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <materialDesign:PackIcon Kind="CashLock" Width="26" Height="26"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                     VerticalAlignment="Center" />
            <TextBlock Text="🌙 بستن شیفت صندوق و تحویل" FontSize="18" FontWeight="Bold"
                       Margin="10,0,0,0" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Left" Command="{Binding LoadCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" HorizontalAlignment="Left" Margin="0,0,8,0">
                <materialDesign:PackIcon Kind="Refresh" Width="15" Height="15" />
            </Button>
        </DockPanel>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,10"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!-- بدنه دو ستونه -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <!-- ═══ چرخهٔ سی‌ونه‌م (گزارش مالک) ═══ «فقط کادرهایی هستن که خودمون
             بنویسیم در حالی که باید مبالغ رو بیاره و ما هم شمارش رو بنویسیم
             تا مغایرت رو نشون بده و بعد ثبت بکنه» — ستون شمارش به جدول
             مقایسه‌ای بازطراحی شد: مبلغ سیستم (ثبت‌شدهٔ امروز) کنار ورودی
             شمارش و مغایرت زندهٔ رنگ‌بندی‌شده؛ رقم نهایی معتبر همچنان از
             رسید سرور پس از بستن صادر می‌شود. -->
        <!-- ستون ۱: جدول مغایرت‌گیری سیستم ↔ شمارش -->
        <Border Grid.Column="0" CornerRadius="12" Padding="16" Margin="0,0,10,0"
                Background="{DynamicResource MaterialDesign.Brush.Background}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="💵 مغایرت‌گیری پایان شیفت — سیستم در برابر شمارش" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                <TextBlock FontSize="11" Opacity="0.65" Margin="0,0,0,10" TextWrapping="Wrap"
                           Text="ستون «مبلغ سیستم» از فروش‌های ثبت‌شدهٔ امروز می‌آید؛ شمارش فیزیکی را بنویسید تا مغایرت همان لحظه محاسبه شود." />

                <!-- سربرگ جدول سه‌ستونه -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="Auto" MinWidth="118" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="11" Opacity="0.6" FontWeight="SemiBold"><Run Text="مبلغ سیستم (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock>
                    <TextBlock Grid.Column="1" Text="شمارش شما" Opacity="0.6" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="مغایرت زنده" Opacity="0.6" FontSize="11" FontWeight="SemiBold" />
                </Grid>
                <Separator Margin="0,0,0,8" />

                <!-- ردیف ۱: نقد — سیستم | ورودی | مغایرت -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="Auto" MinWidth="118" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#ECEFF1" CornerRadius="8" Padding="10,7" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="💵 نقدی — فروش ثبت‌شده" FontSize="10.5" Opacity="0.7" />
                            <TextBlock Text="{Binding SystemCashDisplay, Mode=OneWay}" FontSize="15" FontWeight="Bold" FontFamily="{DynamicResource App.CodeFont}" />
                        </StackPanel>
                    </Border>
                    <TextBox Grid.Column="1" Text="{Binding CountedCash, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" FontFamily="{DynamicResource App.CodeFont}"
                             materialDesign:HintAssist.Hint="وجه نقد شمرده‌شده" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Border Grid.Column="2" Background="#E8F5E9" CornerRadius="8" Padding="9,6" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LiveCashDiffDisplay, Mode=OneWay}" FontSize="13" FontWeight="Bold"
                                   FontFamily="{DynamicResource App.CodeFont}" HorizontalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- ردیف ۲: کارتخوان -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="Auto" MinWidth="118" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#ECEFF1" CornerRadius="8" Padding="10,7" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="💳 کارتخوان — از گزارش دستگاه" FontSize="10.5" Opacity="0.7" />
                            <TextBlock Text="{Binding SystemCardDisplay, Mode=OneWay}" FontSize="15" FontWeight="Bold" FontFamily="{DynamicResource App.CodeFont}" />
                        </StackPanel>
                    </Border>
                    <TextBox Grid.Column="1" Text="{Binding CountedCard, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" FontFamily="{DynamicResource App.CodeFont}"
                             materialDesign:HintAssist.Hint="مبلغ تراکنش‌های کارتخوان" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Border Grid.Column="2" Background="#E8F5E9" CornerRadius="8" Padding="9,6" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LiveCardDiffDisplay, Mode=OneWay}" FontSize="13" FontWeight="Bold"
                                   FontFamily="{DynamicResource App.CodeFont}" HorizontalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- ردیف ۳: آنلاین — فقط نمایش سیستم (شمارش فیزیکی ندارد؛ از درگاه می‌آید) -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="Auto" MinWidth="118" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#ECEFF1" CornerRadius="8" Padding="10,7" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="🌐 آنلاین — درگاه اینترنتی" FontSize="10.5" Opacity="0.7" />
                            <TextBlock Text="{Binding SystemOnlineDisplay, Mode=OneWay}" FontSize="15" FontWeight="Bold" FontFamily="{DynamicResource App.CodeFont}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="1" Text="بدون شمارش فیزیکی — از درگاه" FontSize="11" Opacity="0.55"
                               VerticalAlignment="Center" Margin="8,0,0,0" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="—" FontSize="13" Opacity="0.5" HorizontalAlignment="Center" />
                </Grid>

                <!-- جمع خالص: سیستم در برابر شمارش -->
                <Border Background="#E3F2FD" CornerRadius="10" Padding="12,9" Margin="0,2,0,12"
                        BorderBrush="#90CAF9" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="Auto" MinWidth="118" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="جمع خالص سیستم (نقد + کارت + آنلاین)" FontSize="10.5" Opacity="0.75" />
                            <TextBlock Text="{Binding SystemNetDisplay, Mode=OneWay}" FontSize="16" FontWeight="Bold" FontFamily="{DynamicResource App.CodeFont}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="جمع شمارش (نقد + کارت)" FontSize="10.5" Opacity="0.75" />
                            <TextBlock FontSize="16" FontWeight="Bold" FontFamily="{DynamicResource App.CodeFont}">
                                <Run Text="{Binding CountedCash, Mode=OneWay, StringFormat=\{0:N0\}}" /><Run Text=" + " /><Run Text="{Binding CountedCard, Mode=OneWay, StringFormat=\{0:N0\}}" />
                            </TextBlock>
                        </StackPanel>
                        <!-- مغایرت خالص زنده — رنگ پویا از ویومدل (سبز/قرمز/کهربایی) -->
                        <Border Grid.Column="2" CornerRadius="8" Padding="9,7" Margin="8,0,0,0" VerticalAlignment="Center"
                                Background="#F5F7FB">
                            <TextBlock Text="{Binding LiveNetDiffDisplay, Mode=OneWay}" FontSize="13.5" FontWeight="Bold"
                                       FontFamily="{DynamicResource App.CodeFont}" HorizontalAlignment="Center"
                                       Foreground="{Binding LiveDiffColor, Mode=OneWay}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- پیام وضعیت مغایرت زنده -->
                <TextBlock Text="{Binding LiveDiffState, Mode=OneWay}" FontSize="12.5" FontWeight="Bold"
                           Foreground="{Binding LiveDiffColor, Mode=OneWay}" Margin="2,0,2,12" TextWrapping="Wrap" />

                <!-- تحویل‌گیرنده و یادداشت -->
                <TextBlock Text="تحویل به (صندوقدار شیفت بعد)" FontSize="11.5" Opacity="0.7" Margin="0,0,0,4" />
                <ComboBox SelectedIndex="{Binding HandoverToIndex}" FontSize="12.5" Margin="0,0,0,10"
                          ItemsSource="{Binding Users}" DisplayMemberPath="DisplayName" />

                <TextBlock Text="یادداشت تحویل (اختیاری)" FontSize="11.5" Opacity="0.7" Margin="0,0,0,4" />
                <TextBox Text="{Binding HandoverNote, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="12"
                         AcceptsReturn="True" TextWrapping="Wrap" MinLines="2" MaxLength="400" Margin="0,0,0,14" />

                <Button Command="{Binding CloseShiftCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Stretch"
                        FontSize="13.5" Height="46" MinWidth="240">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="LockCheck" Width="17" Height="17" VerticalAlignment="Center" />
                        <TextBlock Text="🔒 بستن شیفت و صدور رسید تحویل" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- وضعیت اختلاف آخرین رسید -->
                <Border Background="#F5F7FB" CornerRadius="10" Padding="11,9" Margin="0,14,0,0"
                        Visibility="{Binding ReceiptText, Converter={StaticResource NullToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding DifferenceState}" Foreground="{Binding DifferenceColor, Mode=OneWay}"
                                   FontSize="13.5" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding ReceiptText}" FontSize="11" LineHeight="21" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

            <!-- ستون ۲: تاریخچه -->
            <Border Grid.Column="1" CornerRadius="12" Padding="12"
                    Background="{DynamicResource MaterialDesign.Brush.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="📚 تاریخچه شیفت‌های بسته‌شده" FontWeight="Bold"
                               FontSize="14" Margin="2,0,2,8" />
                    <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              FlowDirection="RightToLeft">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رسید" Binding="{Binding ReceiptNumber, Converter={StaticResource PersianDigits}}" Width="80" FontFamily="{DynamicResource App.CodeFont}" />
                            <DataGridTextColumn Header="صندوق" Binding="{Binding RegisterName, Converter={StaticResource PersianDigits}}" Width="85" />
                            <DataGridTextColumn Header="زمان بستن" Binding="{Binding ClosedText, Converter={StaticResource PersianDigits}}" Width="120" />
                            <DataGridTextColumn Header="بستن‌دهنده" Binding="{Binding ClosedByName, Converter={StaticResource PersianDigits}}" Width="100" />
                            <DataGridTextColumn Header="نقد" Binding="{Binding TotalCash, Converter={StaticResource PersianDigits}}" Width="90" />
                            <DataGridTextColumn Header="کارت" Binding="{Binding TotalCard, Converter={StaticResource PersianDigits}}" Width="90" />
                            <DataGridTextColumn Header="آنلاین" Binding="{Binding TotalOnline, Converter={StaticResource PersianDigits}}" Width="85" />
                            <DataGridTextColumn Header="اختلاف" Binding="{Binding Difference, Converter={StaticResource PersianDigits}}" Width="85" />
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding DifferenceState, Converter={StaticResource PersianDigits}}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- پانوشت -->
        <TextBlock Grid.Row="3" Text="راهنما: پیش از بستن شیفت همه تراکنش‌های شیفت را ثبت کنید — رسید تحویل با اختلاف‌سنجی برای صندوقدار بعد صادر می‌شود."
                   FontSize="10.5" Opacity="0.55" Margin="2,10,0,0" />
    </Grid>
</Window>
