<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.LabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1080"
             FlowDirection="RightToLeft">
    <!-- ═══ آزمایشگاه — گام U10 طبق فرم ۱۷: ۵ تب ═══ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ سربرگ گرادیانی — چرخهٔ ۴۸ (گزارش مالک: «ظاهر و چیدمان تمامی صفحات
             خیلی حرفه‌ای‌تر و زیباتر بکن») — هم‌الگوی صفحات بازطراحی‌شدهٔ چرخهٔ ۴۵-۴۷:
             نشان شیشه‌ای + عنوان/زیرعنوان + دکمه‌های اقدام در گوشهٔ چپ فیزیکی (RTL) ═══ -->
        <Border Grid.Row="0" CornerRadius="14" Padding="16,10" Margin="0,0,0,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#6A1B9A" Offset="0" />
                    <GradientStop Color="#311B92" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.16" Color="#1A0033" />
            </Border.Effect>
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button Command="{Binding NewOrderCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                            Foreground="White" Background="#7E57C2" BorderBrush="#7E57C2"
                            MinHeight="36" Margin="0,0,6,0" VerticalAlignment="Center"
                            ToolTip="ثبت درخواست آزمایش جدید برای بیمار">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="درخواست آزمایش" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding LoadCommand}" Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="White" MinHeight="36" MinWidth="42" VerticalAlignment="Center"
                            ToolTip="بارگذاری مجدد فهرست درخواست‌ها از سرور">
                        <materialDesign:PackIcon Kind="Refresh" Width="15" Height="15" />
                    </Button>
                    <!-- ═══ چرخهٔ ۷۹ — دکمهٔ مستقل «مدیریت بازه‌های مرجع» ═══
                         گزارش مالک: «فرمی هم برای اصلاح بازه‌ها نیست» — فرم ویرایش
                         (کاتالوگ تست‌ها) موجود بود ولی در تب پنجم پنهان بود؛ این
                         دکمهٔ همیشه‌دیدنی مستقیماً همان تب را باز می‌کند. -->
                    <Button Click="OnOpenCatalogClick" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="White" BorderBrush="#80FFFFFF" BorderThickness="1.2"
                            MinHeight="36" Margin="6,0,0,0" VerticalAlignment="Center"
                            ToolTip="مشاهده و اصلاح بازهٔ مرجع و حدود بحرانی هر آزمایش">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TuneVertical" Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="مدیریت بازه‌های مرجع" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="22" VerticalAlignment="Center" Margin="0,0,12,0"
                            Background="#33FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1">
                        <materialDesign:PackIcon Kind="TestTube" Width="22" Height="22"
                                                 Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="آزمایشگاه" FontSize="17" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="درخواست‌ها، ثبت نتیجه قلم‌به‌قلم و کاتالوگ تست‌ها"
                                   FontSize="10.5" Foreground="#E1BEE7" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <TabControl x:Name="MainTabs" Grid.Row="2" Style="{StaticResource MaterialDesignTabControl}"
                    SelectionChanged="OnTabChanged">
            <!-- ═══ چرخهٔ ۶۷ (گزارش مالک: «بعد از ثبت نتیجه هم از لیست پاک نشه و
                 قابل مشاهده باشه») — تب نخست از «سفارش‌شده» به «همهٔ درخواست‌ها»
                 تغییر کرد: پیشتر درخواستی که نتیجه‌اش ثبت می‌شد از تب پیش‌فرض
                 (وضعیت ۱) حذف می‌شد و کاربر فکر می‌کرد رکورد پاک شده است؛
                 اکنون نمای پیش‌فرض همهٔ وضعیت‌ها را نشان می‌دهد و ثبت نتیجه
                 فقط «وضعیت» ردیف را عوض می‌کند، نه حذفش را. ═══ -->
            <TabItem Header="📋 همهٔ درخواست‌ها" Tag="0" />
            <TabItem Header="🧪 در حال انجام" Tag="3" />
            <TabItem Header="✅ نتایج آماده" Tag="4" />
            <TabItem Header="🕐 سفارش‌شده‌ها" Tag="1" />

            <!-- ═══ تب ۵: کاتالوگ تست‌ها — بازطراحی چرخهٔ ۷۲ ═══
                 گزارش مالک: «بازه‌های مرجع و حدود بحرانی هر آزمایش رو بطور کامل
                 و دقیق تکمیل کن… در صورت نیاز بتونم اصلاحشون بکنم» — ستون‌های
                 بازهٔ مرد/زن/کودک + حدود بحرانی (قرمز) + جستجو + دکمهٔ ویرایش
                 هر ردیف که فرم LabTestEditWindow را باز می‌کند. -->
            <TabItem Header="📖 کاتالوگ تست‌ها" Tag="-1">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- نوار جستجو + نشان خلاصه -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Border DockPanel.Dock="Left" CornerRadius="9" Padding="9,3" Background="#E8F5E9"
                                BorderBrush="#A5D6A7" BorderThickness="1" VerticalAlignment="Center"
                                ToolTip="شمار آزمایش‌ها / آزمایش‌های دارای بازهٔ ساخت‌یافته / آزمایش‌های دارای حد بحرانی">
                            <TextBlock Text="{Binding CatalogSummaryText, Converter={StaticResource PersianDigits}}"
                                       FontSize="11" Foreground="#1B5E20" />
                        </Border>
                        <TextBox materialDesign:HintAssist.Hint="🔍 جستجوی آزمایش (نام فارسی / انگلیسی / کد)"
                                 Text="{Binding CatalogSearch, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Width="290" VerticalAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCatalogCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>

                    <!-- جدول کاتالوگ کامل — با بازه‌ها و حدود بحرانی -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding TestCatalog}"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.IsDeferredScrollingEnabled="True"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" FontSize="11.5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="نام آزمایش" Binding="{Binding Name, Converter={StaticResource PersianDigits}}" Width="Auto" FontWeight="Bold" />
                            <DataGridTextColumn Header="کد" Binding="{Binding TestCode, TargetNullValue=—, Converter={StaticResource PersianDigits}}" Width="Auto"
                                                FontFamily="{DynamicResource App.CodeFont}" />
                            <DataGridTextColumn Header="دسته" Binding="{Binding Category, TargetNullValue=—, Converter={StaticResource PersianDigits}}" Width="Auto" />
                            <DataGridTextColumn Header="بازهٔ مردان" Binding="{Binding RangeMaleText, TargetNullValue=—, Converter={StaticResource PersianDigits}}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#1565C0" />
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="بازهٔ زنان" Binding="{Binding RangeFemaleText, TargetNullValue=—, Converter={StaticResource PersianDigits}}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#C2185B" />
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="بازهٔ کودک" Binding="{Binding RangeChildText, TargetNullValue=—, Converter={StaticResource PersianDigits}}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#E65100" />
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- حدود بحرانی — رنگ از CriticalBrush (قرمز = ثبت‌شده) -->
                            <DataGridTemplateColumn Header="حدود بحرانی" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CriticalText, Converter={StaticResource PersianDigits}}"
                                                   Foreground="{Binding CriticalBrush, Converter={StaticResource HexToBrush}}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" FontFamily="{DynamicResource App.CodeFont}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="واحد" Binding="{Binding Unit, TargetNullValue=—, Converter={StaticResource PersianDigits}}" Width="Auto" />
                            <DataGridTextColumn Width="Auto">
                                <DataGridTextColumn.Header>
                                    <TextBlock>
                                        <Run Text="قیمت (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" />
                                    </TextBlock>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Price" StringFormat="{}{0:N0}" />
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{DynamicResource App.CodeFont}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- دکمهٔ ویرایش — بازکردن فرم بازه‌ها (مالک)؛ چرخهٔ ۷۹: آیکونی
                                 هم‌الگوی لیست بیماران (درخواست مالک: کلیدهای عملیاتی آیکونی) -->
                            <DataGridTemplateColumn Header="عملیات" Width="Auto" MinWidth="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.EditTestCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource App.RowIconButton}"
                                                Cursor="Hand" Focusable="False"
                                                ToolTip="ویرایش بازه‌های مرجع و حدود بحرانی این آزمایش">
                                            <materialDesign:PackIcon Kind="Pencil" Width="15" Height="15" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- جدول درخواست‌ها — زیر تب‌های وضعیت -->
        <!-- چرخهٔ ۶۳ (P-08): مجازی‌سازی صریح + پیمایش تعویقی — فقط ردیف‌های دیدنی رندر می‌شوند؛ در فهرست‌های چند‌هزار ردیفی تفاوت چندثانیه‌ای -->
    <DataGrid Grid.Row="2" x:Name="OrdersGrid"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.IsDeferredScrollingEnabled="True"
                  ItemsSource="{Binding Orders}"
                  SelectedItem="{Binding SelectedOrder}"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  HeadersVisibility="Column" FontSize="12"
                  MouseDoubleClick="OnOrderDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="شماره درخواست" Binding="{Binding Number, TargetNullValue=—, Converter={StaticResource PersianDigits}}" Width="Auto" FontFamily="{DynamicResource App.CodeFont}" />
                <DataGridTextColumn Header="بیمار" Binding="{Binding PatientName, Converter={StaticResource PersianDigits}}" Width="Auto" FontWeight="SemiBold" />
                <DataGridTextColumn Header="پزشک" Binding="{Binding DoctorName, Converter={StaticResource PersianDigits}}" Width="Auto" />
                <DataGridTextColumn Header="تعداد تست" Binding="{Binding ItemsCount, Converter={StaticResource PersianDigits}}" Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="تاریخ" Binding="{Binding Date, Converter={StaticResource PersianDigits}}" Width="Auto" />
                <DataGridTemplateColumn Header="وضعیت" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="9,2" HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#ECEFF1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusText}" Value="سفارش‌شده">
                                                <Setter Property="Background" Value="#FFF3E0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusText}" Value="نمونه‌گیری‌شده">
                                                <Setter Property="Background" Value="#E1BEE7" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusText}" Value="در جریان">
                                                <Setter Property="Background" Value="#BBDEFB" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusText}" Value="نتیجه آماده">
                                                <Setter Property="Background" Value="#C8E6C9" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusText}" FontSize="11" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="عملیات" Width="Auto" MinWidth="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <!-- ═══ چرخهٔ ۶۷ — ثبت/مشاهدهٔ نتیجه (یک پنجره برای هر دو کار)؛
                                     چرخهٔ ۷۹: آیکونی هم‌الگوی لیست بیماران ═══ -->
                                <Button Command="{Binding DataContext.RecordResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource App.RowIconButton}" Margin="0,0,6,0"
                                        ToolTip="ثبت / مشاهدهٔ نتیجه">
                                    <materialDesign:PackIcon Kind="ClipboardEditOutline" Width="15" Height="15" />
                                </Button>
                                <!-- ═══ چرخهٔ ۶۷ (گزارش مالک: «امکان چاپ هم داشته باشه») ═══
                                     چاپ برگهٔ نتیجه — برای درخواست‌های نتیجه‌دار نمایش داده می‌شود؛
                                     سند فارسی از دروازهٔ PrintFlow می‌گذرد (پیش‌نمایش اختیاری طبق تنظیمات) -->
                                <Button Command="{Binding DataContext.PrintResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding CanPrint, Converter={StaticResource BoolToVisibility}}"
                                        Style="{StaticResource App.RowIconButton}" Margin="0,0,6,0"
                                        ToolTip="چاپ برگهٔ نتیجه">
                                    <materialDesign:PackIcon Kind="Printer" Width="15" Height="15" />
                                </Button>
                                <!-- ═══ چرخهٔ ۶۹ (فاز ۳ / F-02) — برچسب نمونه ═══
                                     برای هر قلم این درخواست، برچسب کوچک با QR یکتای
                                     «درخواست + قلم» + بیمار + نام آزمایش چاپ می‌شود تا
                                     روی ظرف نمونه بچسبد؛ اسکن آن، جابه‌جایی نمونه را صفر می‌کند. -->
                                <Button Command="{Binding DataContext.PrintSpecimenLabelsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource App.RowIconButton}"
                                        ToolTip="چاپ برچسب QR برای ظرف نمونه‌های این درخواست">
                                    <materialDesign:PackIcon Kind="Barcode" Width="15" Height="15" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
