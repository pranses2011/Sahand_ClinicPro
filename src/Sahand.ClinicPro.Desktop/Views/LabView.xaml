<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.LabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="Vazirmatn, Segoe UI, Tahoma">
    <!-- ═══════════════════════════════════════════════════════════
         آزمایشگاه — گام V6
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding RecordResultCommand}"
                        IsEnabled="{Binding SelectedOrder, Converter={StaticResource NotNullToBool}}"
                        Style="{StaticResource MaterialDesignFilledButton}"
                        Content="ثبت نتیجه" Margin="0,0,8,0" />
                <Button Command="{Binding NewOrderCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Content="درخواست جدید" />
            </StackPanel>
            <TextBlock Text="آزمایشگاه"
                       Style="{StaticResource SectionTitle}"
                       VerticalAlignment="Center" />
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <ComboBox materialDesign:HintAssist.Hint="وضعیت"
                      ItemsSource="{Binding StatusLabels}"
                      SelectedIndex="{Binding StatusFilterIndex}"
                      Width="170" Margin="0,0,12,0" />
            <Button Command="{Binding LoadCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="بازخوانی" Margin="0,0,8,0" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.Error}"
                       FontSize="12" VerticalAlignment="Center" />
        </StackPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Orders}"
                  SelectedItem="{Binding SelectedOrder}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  materialDesign:DataGridAssist.CellPadding="8,6">
            <DataGrid.Columns>
                <DataGridTextColumn Header="شماره" Binding="{Binding Number}" Width="110" />
                <DataGridTextColumn Header="بیمار" Binding="{Binding PatientName}" Width="*" />
                <DataGridTextColumn Header="پزشک" Binding="{Binding DoctorName}" Width="*" />
                <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="100" />
                <DataGridTextColumn Header="تعداد اقلام" Binding="{Binding ItemsCount}" Width="100" />
                <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="120" />
            </DataGrid.Columns>
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick"
                              Command="{Binding RecordResultCommand}" />
            </DataGrid.InputBindings>
        </DataGrid>
    </Grid>
</UserControl>