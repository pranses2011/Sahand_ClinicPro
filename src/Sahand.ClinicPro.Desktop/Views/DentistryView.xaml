<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.DentistryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="774" d:DesignWidth="1030"
             FlowDirection="RightToLeft">
    <!-- ═══════════════════════════════════════════════════════════════
         دندانپزشکی — بازطراحی کامل بر اساس طرح تأییدشدهٔ مالک
         (docs/design/approved/dentistry.html + dentistry-design.png).

         همان زبان تصویری صفحهای تصویربرداری: سربرگ، پنج کارت آماری تمامعرض،
         تبهای زیرخطدار، نوار ابزار، چارت FDI در پنل راست و «دندان انتخابی /
         طرح درمان» در پنل چپ. همهٔ اتصالها و فرمانهای واقعی ViewModel حفظ
         شدهاند؛ فقط چیدمان و رنگها از نو نوشته شد.
         ═══════════════════════════════════════════════════════════════ -->
    <UserControl.Resources>
        <!-- جعبهٔ دندان ۳۴×۴۲ — همان اندازهای که در رندر HTML طرح دیده میشود -->
        <DataTemplate x:Key="Ds.ToothBox">
            <Button Width="34" Height="42" Margin="0,0,3,3" Cursor="Hand"
                    Command="{Binding DataContext.SelectToothCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" ToolTip="{Binding ToolTip}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{Binding Color}" BorderBrush="#C9D6E4"
                                BorderThickness="1.3" CornerRadius="6">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="Num" Text="{Binding NumberFa}" FontSize="10.5"
                                           FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" />
                                <TextBlock x:Name="Type" Text="{Binding TypeShort}" FontSize="6.5"
                                           HorizontalAlignment="Center" Foreground="#F0F4F8" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Condition}" Value="0">
                                <Setter TargetName="Num" Property="Foreground" Value="#22364F" />
                                <Setter TargetName="Type" Property="Foreground" Value="#6B7C93" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#1565C0" />
                                <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource Ds.PageBackground}" Margin="14,11,14,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ ردیف ۱: سربرگ ══ -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="#1565C0"
                    VerticalAlignment="Center" Margin="0,0,9,0">
                <TextBlock Text="🦷" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="پروندهٔ دندانپزشکی" Style="{StaticResource Ds.PageTitle}" />
                <TextBlock Text="چارت دندان، طرح درمان و پیگیری پرونده — یکپارچه"
                           Style="{StaticResource Ds.Muted}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="پروندهٔ جدید" Style="{StaticResource Ds.FlatPrimary}" Height="32"
                        Padding="14,0" Margin="0,0,7,0" Command="{Binding ClearDentalPatientCommand}" />
                <Button Content="چاپ چارت" Style="{StaticResource Ds.OutlineButton}" Height="32"
                        Padding="13,0" Command="{Binding SaveDentalChartCommand}" />
            </StackPanel>
        </Grid>

        <!-- ══ ردیف ۲: پنج کارت آماری ══ -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource Ds.StatCard}" Background="#F4FBF4" BorderBrush="#81C784">
                <StackPanel>
                    <TextBlock Text="{Binding Kpis.V1}" Style="{StaticResource Ds.StatNumber}" Foreground="#2E7D32" />
                    <TextBlock Text="بیماران دارای پرونده" Style="{StaticResource Ds.StatLabel}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource Ds.StatCard}" Background="#FFF5F5" BorderBrush="#E57373">
                <StackPanel>
                    <TextBlock Text="{Binding Kpis.V2}" Style="{StaticResource Ds.StatNumber}" Foreground="#C62828" />
                    <TextBlock Text="دندان نیازمند درمان" Style="{StaticResource Ds.StatLabel}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource Ds.StatCard}" Background="#FDF7FF" BorderBrush="#BA68C8">
                <StackPanel>
                    <TextBlock Text="{Binding Kpis.V3}" Style="{StaticResource Ds.StatNumber}" Foreground="#6A1B9A" />
                    <TextBlock Text="طرح درمان فعال" Style="{StaticResource Ds.StatLabel}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="6" Style="{StaticResource Ds.StatCard}" Background="#FFFAF3" BorderBrush="#FFB74D">
                <StackPanel>
                    <TextBlock Text="{Binding Kpis.V4}" Style="{StaticResource Ds.StatNumber}" Foreground="#E65100" />
                    <TextBlock Text="جلسات امروز" Style="{StaticResource Ds.StatLabel}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="8" Style="{StaticResource Ds.StatCard}" Background="#F5FAFF" BorderBrush="#64B5F6">
                <StackPanel>
                    <TextBlock Text="{Binding Kpis.V5}" Style="{StaticResource Ds.StatNumber}" Foreground="#1565C0" />
                    <TextBlock Text="درآمد ماه (ریال)" Style="{StaticResource Ds.StatLabel}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ══ ردیف ۳: تبها ══ -->
        <Border Grid.Row="2" Style="{StaticResource Ds.TabBar}" Padding="0,2,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border BorderBrush="#1565C0" BorderThickness="0,0,0,2" Margin="0,0,4,0">
                    <TextBlock Text="چارت دندان" Style="{StaticResource Ds.TabItemActiveText}" />
                </Border>
                <TextBlock Text="طرح درمان" Style="{StaticResource Ds.TabItemText}" />
                <TextBlock Text="پرتونگاری" Style="{StaticResource Ds.TabItemText}" />
                <TextBlock Text="نسخه و رضایتنامه" Style="{StaticResource Ds.TabItemText}" />
            </StackPanel>
        </Border>

        <!-- ══ ردیف ۴: نوار ابزار ══ -->
        <Border Grid.Row="3" Style="{StaticResource Ds.Toolbar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource Ds.CompactText}"
                         Text="{Binding DentalPatientSearch, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchDentalPatientCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1" Content="جستجو ⌕" Style="{StaticResource Ds.FlatPrimary}" Height="30"
                        Padding="13,0" Margin="7,0,0,0" Command="{Binding SearchDentalPatientCommand}" />
                <Border Grid.Column="2" Background="#EDF5FF" BorderBrush="#BBDBFB" BorderThickness="1"
                        CornerRadius="7" Height="30" Margin="7,0,0,0" Padding="8,0">
                    <TextBlock Text="{Binding DentalPatient.FullName, FallbackValue='زهرا محمدی — کد ۰۰۱۲۳۴'}"
                               FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Border>
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <TextBlock Text="آخرین ویزیت: ۱۴۰۵/۰۸/۰۳" Style="{StaticResource Ds.Muted}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="تازهمسازی" Style="{StaticResource Ds.OutlineButton}" Padding="10,0"
                            Command="{Binding SaveDentalChartCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ ردیف ۵: محتوا ══ -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- ستون راست: راهنما + چارت FDI -->
            <Border Grid.Column="0" Style="{StaticResource Ds.Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="همه" Style="{StaticResource Ds.ChipActive}" />
                        <Button Content="نیازمند درمان" Style="{StaticResource Ds.Chip}" />
                        <TextBlock Text="راهنما:" Style="{StaticResource Ds.Muted}" VerticalAlignment="Center" Margin="8,0,4,0" />
                        <Border Style="{StaticResource Ds.Tag}" Background="#FDECEA" BorderBrush="#F5C6C2">
                            <TextBlock Text="پوسیدگی" FontSize="9.5" Foreground="#C62828" />
                        </Border>
                        <Border Style="{StaticResource Ds.Tag}" Background="#FFF8E1" BorderBrush="#FFE082" Margin="4,0,0,0">
                            <TextBlock Text="ترمیمشده" FontSize="9.5" Foreground="#B26A00" />
                        </Border>
                        <Border Style="{StaticResource Ds.Tag}" Background="#E8F5E9" BorderBrush="#A5D6A7" Margin="4,0,0,0">
                            <TextBlock Text="درمانشده" FontSize="9.5" Foreground="#2E7D32" />
                        </Border>
                        <Border Style="{StaticResource Ds.Tag}" Background="#E3F2FD" BorderBrush="#90CAF9" Margin="4,0,0,0">
                            <TextBlock Text="روکش" FontSize="9.5" Foreground="#1565C0" />
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="FDI — چارت دندان — شمارهگذاری استاندارد"
                               Style="{StaticResource Ds.Muted}" HorizontalAlignment="Left" Margin="0,0,0,4" />
                    <Grid Grid.Row="2" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="فک بالا — راست" Style="{StaticResource Ds.Muted}" HorizontalAlignment="Center" Margin="0,0,0,3" />
                            <ItemsControl ItemsSource="{Binding UpperTeeth}" ItemTemplate="{StaticResource Ds.ToothBox}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Width="296" ItemWidth="37" ItemHeight="45" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                        <Border Grid.Column="1" Width="1" Background="#D9E2EC" Margin="4,18,4,4" />
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="فک پایین — چپ" Style="{StaticResource Ds.Muted}" HorizontalAlignment="Center" Margin="0,0,0,3" />
                            <ItemsControl ItemsSource="{Binding LowerTeeth}" ItemTemplate="{StaticResource Ds.ToothBox}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Width="296" ItemWidth="37" ItemHeight="45" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ستون چپ: دندان انتخابی + طرح درمان -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Ds.Panel}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedTooth.NumberFa, StringFormat='دندان انتخابی: {0} 🔍', FallbackValue='دندان انتخابی: ۱۶ 🔍'}"
                                   Style="{StaticResource Ds.PanelTitle}" />
                        <!-- جنس و وضعیت کنار هم — همان فشردگی طرح تأییدی -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="جنس دندان" Style="{StaticResource Ds.FieldLabel}" />
                                <Border Style="{StaticResource Ds.FieldValue}">
                                    <TextBlock Text="{Binding SelectedTooth.AnatomyText, FallbackValue='آسیاب بزرگ اول · ریشه ۳ · کانال ۴'}"
                                               FontSize="9.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="وضعیت" Style="{StaticResource Ds.FieldLabel}" />
                                <Border Style="{StaticResource Ds.FieldValue}">
                                    <TextBlock Text="{Binding SelectedTooth.ConditionText, FallbackValue='پوسیدگی'}"
                                               FontSize="10" VerticalAlignment="Center" Foreground="#C62828" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,5,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="سطح درگیر:" Style="{StaticResource Ds.FieldLabel}"
                                       VerticalAlignment="Center" Margin="0,0,5,0" />
                            <WrapPanel Grid.Column="1">
                                <Button Content="M" Style="{StaticResource Ds.Chip}" Margin="0,0,3,0" Padding="7,0" Height="23" />
                                <Button Content="O" Style="{StaticResource Ds.ChipActive}" Margin="0,0,3,0" Padding="7,0" Height="23" />
                                <Button Content="D" Style="{StaticResource Ds.Chip}" Margin="0,0,3,0" Padding="7,0" Height="23" />
                                <Button Content="B" Style="{StaticResource Ds.Chip}" Margin="0,0,3,0" Padding="7,0" Height="23" />
                                <Button Content="L" Style="{StaticResource Ds.Chip}" Margin="0,0,3,0" Padding="7,0" Height="23" />
                            </WrapPanel>
                        </Grid>
                        <TextBlock Text="انتخاب خدمت از کاتالوگ" Style="{StaticResource Ds.FieldLabel}" />
                        <ComboBox Style="{StaticResource Ds.CompactCombo}" Height="32"
                                  ItemsSource="{Binding CatalogItems}" DisplayMemberPath="Display"
                                  SelectedItem="{Binding SelectedCatalogItem}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="ثبت وضعیت" Style="{StaticResource Ds.OutlineButton}"
                                    Padding="12,0" Margin="0,0,6,0" Command="{Binding SaveDentalChartCommand}" />
                            <Button Content="+ افزودن به طرح درمان" Style="{StaticResource Ds.FlatPrimary}"
                                    Height="30" FontSize="11" Padding="12,0" Command="{Binding AddDentalPlanCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Ds.Panel}">
                    <StackPanel>
                        <TextBlock Text="طرح درمان 📋" Style="{StaticResource Ds.PanelTitle}" />
                        <DataGrid ItemsSource="{Binding DentalPlan}" Style="{StaticResource Ds.TableDataGrid}"
                                  MaxHeight="170" RowHeight="30"
                                  ColumnHeaderStyle="{StaticResource Ds.TableColumnHeader}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="دندان" Binding="{Binding Tooth}" Width="52"
                                                    ElementStyle="{StaticResource Ds.TableCellText}" />
                                <DataGridTextColumn Header="خدمت" Binding="{Binding Procedure}" Width="*"
                                                    ElementStyle="{StaticResource Ds.TableCellText}" />
                                <DataGridTextColumn Header="سطح" Binding="{Binding Surface}" Width="46"
                                                    ElementStyle="{StaticResource Ds.TableCellText}" />
                                <DataGridTextColumn Header="هزینه" Binding="{Binding Price}" Width="70"
                                                    ElementStyle="{StaticResource Ds.TableCellText}" />
                                <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="62"
                                                    ElementStyle="{StaticResource Ds.TableCellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Margin="0,7,0,7">
                            <TextBlock Text="جمع کل طرح درمان" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding PlanTotalText}" FontWeight="Bold" Foreground="#1565C0" />
                                <TextBlock Text=" ریال" Style="{StaticResource Ds.Muted}" />
                            </StackPanel>
                        </Grid>
                        <Button Content="ثبت و چاپ طرح درمان" Style="{StaticResource Ds.FlatPrimary}"
                                Height="34" Command="{Binding SaveDentalChartCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ══ ردیف ۶: پانوشت ══ -->
        <TextBlock Grid.Row="5" Text="سهند کلینیکپرو — پروندهٔ دندانپزشکی · چارت FDI · نسخهٔ ۲٫۲۸٫۲۸"
                   Style="{StaticResource Ds.Muted}" HorizontalAlignment="Center" Margin="0,5,0,0" />
    </Grid>
</UserControl>
