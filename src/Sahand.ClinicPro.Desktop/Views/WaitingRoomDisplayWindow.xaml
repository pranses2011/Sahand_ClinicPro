<Window x:Class="Sahand.ClinicPro.Desktop.Views.WaitingRoomDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نمایشگر سالن انتظار"
        WindowStyle="None"
        WindowState="Maximized"
        Background="#0D1B2A"
        FlowDirection="RightToLeft"
        Cursor="None"
        KeyDown="Window_KeyDown">
    <!-- ═══════════════════════════════════════════════════════════════
         نمایشگر سالن انتظار — چرخهٔ ۶۹ (فاز ۳ / F-14 نقشه راه ai-review)
         «حالت کیوسک سالن انتظار» — پنجرهٔ تمام‌صفحهٔ تیره برای نصب روی
         نمایشگر سالن: ساعت و تاریخ شمسی درشت + بیماران «در حال ویزیت»
         و نوبت‌های پیش‌رو (تازه‌سازی هر ۳۰ ثانیه + با هر رویداد بلادرنگ صف).
         خروج با کلید Escape (مخفی از دید عمومی — دکمه ندارد).
         ═══════════════════════════════════════════════════════════════ -->
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- سربرگ: نام درمانگاه + تاریخ و ساعت شمسی درشت -->
        <DockPanel Grid.Row="0">
            <StackPanel>
                <TextBlock x:Name="ClockText" Text="۰۰:۰۰"
                           FontSize="86" FontWeight="Bold" Foreground="#E3F2FD"
                           FontFamily="{DynamicResource App.CodeFont}" />
                <TextBlock x:Name="DateText" Text="—"
                           FontSize="26" Foreground="#90CAF9" Margin="0,4,0,0" />
            </StackPanel>
            <TextBlock x:Name="ClinicNameText" Text="درمانگاه سهند"
                       FontSize="34" FontWeight="Bold" Foreground="#FFFFFF"
                       HorizontalAlignment="Left" VerticalAlignment="Center" />
        </DockPanel>

        <!-- جداکنندهٔ رنگی -->
        <Border Grid.Row="1" Height="4" CornerRadius="2" Margin="0,16,0,20"
                Background="#1565C0" />

        <!-- میانه: در حال ویزیت + نوبت‌های پیش‌رو -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ستون راست: در حال ویزیت — بزرگ و خوانا از فاصله -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="در حال ویزیت" FontSize="24" FontWeight="Bold"
                           Foreground="#4FC3F7" Margin="0,0,0,14" />
                <ItemsControl x:Name="InProgressList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#13293D" CornerRadius="14" Padding="20,14"
                                    Margin="0,0,0,12" BorderBrush="#1B4965" BorderThickness="1">
                                <DockPanel>
                                    <Border Width="56" Height="56" CornerRadius="28"
                                            Background="#1565C0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding QueueNumber}" FontSize="24" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{DynamicResource App.CodeFont}" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                                        <TextBlock Text="{Binding PatientName}" FontSize="28" FontWeight="Bold"
                                                   Foreground="#FFFFFF" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="17" Foreground="#B0BEC5"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="InProgressEmpty" Text="در این لحظه ویزیتی در جریان نیست"
                           FontSize="19" Foreground="#546E7A" Margin="6,10,0,0"
                           Visibility="Collapsed" />
            </StackPanel>

            <!-- ستون چپ: نوبت‌های پیش‌رو -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="نوبت‌های پیش‌رو" FontSize="21" FontWeight="Bold"
                           Foreground="#81C784" Margin="0,0,0,12" />
                <ItemsControl x:Name="UpcomingList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0F2417" CornerRadius="10" Padding="14,10"
                                    Margin="0,0,0,8" BorderBrush="#1B5E20" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock Text="{Binding Time}" FontSize="18" FontWeight="Bold"
                                               Foreground="#A5D6A7" VerticalAlignment="Center"
                                               FontFamily="{DynamicResource App.CodeFont}" />
                                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding PatientName}" FontSize="17"
                                                   Foreground="#E8F5E9" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12.5"
                                                   Foreground="#81C784" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="UpcomingEmpty" Text="نوبت دیگری برای امروز ثبت نشده است"
                           FontSize="16" Foreground="#546E7A" Margin="6,8,0,0"
                           Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- پانویس: راهنمای بیماران -->
        <TextBlock Grid.Row="3" Text="لطفاً در سالن انتظار حضور داشته باشید و با فراخوانی شمارهٔ نوبت به اتاق موردنظر مراجعه کنید"
                   FontSize="15" Foreground="#78909C" HorizontalAlignment="Center" Margin="0,14,0,0" />
    </Grid>
</Window>
