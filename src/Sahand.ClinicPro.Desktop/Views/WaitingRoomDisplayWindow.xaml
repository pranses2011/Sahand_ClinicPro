<Window x:Class="Sahand.ClinicPro.Desktop.Views.WaitingRoomDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        Title="نمایشگر سالن انتظار"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        Background="#0A1626"
        FlowDirection="RightToLeft"
        Cursor="None"
        KeyDown="Window_KeyDown"
        MouseRightButtonDown="Window_RightClick">
    <!-- ═══════════════════════════════════════════════════════════════
         نمایشگر سالن انتظار — چرخهٔ ۷۴ + بازآرایی چرخهٔ ۷۵ (گزارش مالک)
         «قسمت بالای صفحه رو سه ستون بکن و ساعت آنالوگ و دیجیتال و تاریخ رو
         در سمت راست و تبلیغات رو در سمت چپ و نام درمانگاه و اعلان زیرش در
         وسط باشه و قسمت پایین صفحه برای صفها باشه»:
           • نوار بالا (سه ستون):
               - راست بصری: ساعت آنالوگ (با خطوط ساعت/دقیقه — چرخهٔ ۷۵) +
                 دیجیتال کوچک + تاریخ بلند — همه قابل خاموش‌کردن از تنظیمات
               - میانه: نام واقعی درمانگاه از سرور لایسنس + اعلان قابل‌تنظیم
               - چپ بصری: تبلیغ نرم‌افزار — فقط تصویر + نام محصول (سایر اقلام
                 تبلیغ از تنظیمات انتخابی‌اند — چرخهٔ ۷۵)
           • ناحیهٔ پایین: کارت‌های صف‌ها — چیدمان «ستونی» با تعداد ستونِ
             قابل‌تنظیم و امکان نشستن دو بخش در یک ستون (چرخهٔ ۷۵)
         تازه‌سازی: هر ۱۵ ثانیه + هر رویداد بلادرنگ صف + هر بار focus.
         خروج: Escape — تنظیمات: راست‌کلیک (مخفی از مراجع).
         ═══════════════════════════════════════════════════════════════ -->
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <!-- نوار بالا — هویت/ساعت/تبلیغ -->
            <RowDefinition Height="Auto" />
            <!-- ناحیهٔ صف‌ها — کل باقی صفحه -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════ نوار بالا — سه ستون (راست: ساعت / میانه: درمانگاه / چپ: تبلیغ) ═══════════ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- راست بصری (RTL): پشتهٔ ساعت آنالوگ/دیجیتال/تاریخ -->
                <ColumnDefinition Width="Auto" />
                <!-- میانه: نام درمانگاه + اعلان -->
                <ColumnDefinition Width="*" />
                <!-- چپ بصری: تبلیغ نرم‌افزار -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ─── راست: ساعت + تاریخ (عمودی وسط‌چین) ─── -->
            <StackPanel Grid.Column="0" Width="250" VerticalAlignment="Center" Margin="0,0,16,0">
                <controls:AnalogClock Width="215" Height="215"
                                      HorizontalAlignment="Center"
                                      Visibility="{Binding ShowAnalogClock, Mode=OneWay}" />
                <TextBlock x:Name="DigitalClockText" Text="--:--:--"
                           HorizontalAlignment="Center" Margin="0,12,0,0"
                           FontSize="23" FontWeight="SemiBold" Foreground="#BBDEFB"
                           FontFamily="{DynamicResource App.CodeFont}"
                           Visibility="{Binding ShowDigitalClock, Mode=OneWay}" />
                <TextBlock x:Name="LongDateText" Text="—"
                           HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"
                           FontSize="15.5" Foreground="#8FBFE8"
                           Visibility="{Binding ShowLongDate, Mode=OneWay}" />
            </StackPanel>

            <!-- ─── میانه: نام درمانگاه (از سرور لایسنس) + اعلان قابل‌تنظیم ─── -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                <TextBlock x:Name="ClinicNameText" Text="درمانگاه"
                           FontSize="44" FontWeight="Black" Foreground="#FFFFFF"
                           HorizontalAlignment="Center" TextWrapping="Wrap" />
                <Border Height="4" CornerRadius="2" Width="240" Margin="0,12,0,0"
                        Background="#2C5F9E" HorizontalAlignment="Center" />
                <!-- اعلان زیر نام درمانگاه — متن از تنظیمات نمایشگر قابل تغییر است
                     (گزارش مالک چرخهٔ ۷۵: «نوشته اعلان زیر نام درمانگاه هم از
                     تنظیمات قابل تغییر باشه»)؛ خالی = پیش‌فرض مؤدبانه -->
                <TextBlock x:Name="AnnouncementText"
                           Text="لطفاً در سالن انتظار حضور داشته باشید و با فراخوانی شمارهٔ نوبت به اتاق مربوط مراجعه کنید"
                           FontSize="15.5" Foreground="#7FA8CC" HorizontalAlignment="Center"
                           Margin="0,14,0,0" TextWrapping="Wrap" MaxWidth="640"
                           TextAlignment="Center" />
            </StackPanel>

            <!-- ─── چپ: تبلیغ نرم‌افزار — فقط تصویر + نام محصول (چرخهٔ ۷۵) ───
                 «در تبلیغات فقط تصویر و نام نرم افزار کفایت میکنه و بقیه موارد
                 رو در تنظیمات برای نشون دادن بزار که انتخابی باشه» — زیرنویس
                 «سامانهٔ جامع اطلاعاتی»، خط جداکننده، فهرست ویژگی‌ها و نسخه
                 همه سوییچ‌های انتخابی تنظیمات‌اند. -->
            <Border Grid.Column="2" Width="230" VerticalAlignment="Stretch"
                    Margin="16,0,0,0" Padding="20,22" CornerRadius="20"
                    Background="#0E2036" BorderBrush="#1E3A5C" BorderThickness="1.2">
                <StackPanel VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/Logo/ClinicPro-512.png"
                           Width="132" Height="132" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="AdSubtitleText" Text="سامانهٔ جامع اطلاعاتی"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#E3F2FD" HorizontalAlignment="Center"
                               Margin="0,14,0,0"
                               Visibility="{Binding ShowAdSubtitle, Mode=OneWay}" />
                    <TextBlock Text="درمانگاه سهند" FontSize="22" FontWeight="Black"
                               Foreground="#7FC4FF" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <Border x:Name="AdDivider" Height="3" CornerRadius="2" Width="86" Margin="0,12,0,0"
                            Background="#2C5F9E" HorizontalAlignment="Center"
                            Visibility="{Binding ShowAdSubtitle, Mode=OneWay}" />
                    <!-- فهرست ویژگی‌ها — انتخابی از تنظیمات -->
                    <StackPanel x:Name="AdFeaturesPanel" Margin="0,14,0,0"
                                Visibility="{Binding ShowAdFeatures, Mode=OneWay}">
                        <TextBlock Text="✓ پروندهٔ الکترونیک بیمار" FontSize="12.5" Foreground="#9DB8CF" Margin="0,0,0,8" />
                        <TextBlock Text="✓ نوبت‌دهی و پذیرش هوشمند" FontSize="12.5" Foreground="#9DB8CF" Margin="0,0,0,8" />
                        <TextBlock Text="✓ نسخه‌نویسی الکترونیک" FontSize="12.5" Foreground="#9DB8CF" Margin="0,0,0,8" />
                        <TextBlock Text="✓ آزمایشگاه و پاراکلینیک" FontSize="12.5" Foreground="#9DB8CF" Margin="0,0,0,8" />
                        <TextBlock Text="✓ حسابداری و بیمه" FontSize="12.5" Foreground="#9DB8CF" Margin="0,0,0,8" />
                    </StackPanel>
                    <TextBlock x:Name="AdVersionText" Text="" FontSize="10.5" Foreground="#54718C"
                               HorizontalAlignment="Center" Margin="0,14,0,0"
                               Visibility="{Binding ShowAdVersion, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════ ناحیهٔ پایین — کارت‌های صف‌ها (چیدمان ستونی — چرخهٔ ۷۵) ═══════════
             «مواردی که نمایشگر اضافه میشن رو … بصورت ستونی قرار بگیرن نه سطری و
             بشه در یک ستون ۲ مورد هم قرار داد (تعداد ستون‌ها هم از تنظیماتش
             قابل تنظیم باشه)» — پنل ستون‌ها در کد پشت ساخته می‌شود: تعداد ستون
             پیکربندی + بخش‌ها ستون‌به‌ستون (هر ستون تا دو بخش؛ سرریز به ستون
             بعدی) و هر کارت با ارتفاع برابر سهمش از ستون بالا می‌رود. -->
        <Grid x:Name="ColumnsHost" Grid.Row="1" Margin="0,22,0,0" />
    </Grid>
</Window>
