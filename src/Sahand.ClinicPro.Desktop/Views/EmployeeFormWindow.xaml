<Window x:Class="Sahand.ClinicPro.Desktop.Views.EmployeeFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:behaviors="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        Title="ثبت پرسنل"
        Height="640" Width="840"
        MinHeight="560" MinWidth="640"
        FlowDirection="RightToLeft"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!-- ═══════════════════════════════════════════════════════════
         فرم ثبت پرسنل — گام V8 + اطلاعات حقوقی چرخه نهم
         + کارت عکس پروفایل (چرخه هجدهم — گزارش دوازدهم مالک)
         ═══════════════════════════════════════════════════════════ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">

            <!-- ─── کارت عکس پروفایل — چرخه هجدهم ─── -->
            <Border Background="#F5F9FF" BorderBrush="#CFE2F5" BorderThickness="1"
                    CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <!-- پیش‌نمایش دایره‌ای یا جای‌نگهدار -->
                        <Border Width="86" Height="86" CornerRadius="43"
                                Background="#E3F2FD" BorderBrush="#90CAF9"
                                BorderThickness="2" Cursor="Hand"
                                ToolTip="با کلیک، عکس را بزرگ ببینید">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick"
                                              Command="{Binding ViewPhotoCommand}" />
                            </Border.InputBindings>
                            <Grid>
                                <materialDesign:PackIcon Kind="AccountCircle"
                                                         Width="44" Height="44"
                                                         Foreground="#64B5F6"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Visibility="{Binding HasPendingPhoto, Converter={StaticResource InverseBoolToVisibility}}" />
                                <Image Source="{Binding PhotoPreview}"
                                       Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="🖼 عکس پرسنل" FontSize="13.5" FontWeight="Bold"
                                       Foreground="#16355E" />
                            <TextBlock Text="عکس JPG/PNG تا ۵ مگابایت؛ همراه ثبت، در پوشهٔ Photos/Employees برنامه ذخیره و مسیرش در دیتابیس ثبت می‌شود."
                                       FontSize="10.5" Foreground="#5B7290" TextWrapping="Wrap"
                                       Margin="0,4,0,8" MaxWidth="260" />
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding PickPhotoCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Content="انتخاب عکس" FontSize="12" Padding="14,6" />
                                <Button Command="{Binding ClearPhotoCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="حذف" FontSize="11.5" Foreground="#C62828"
                                        Padding="10,6" Margin="8,0,0,0"
                                        Visibility="{Binding HasPendingPhoto, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="ثبت پرسنل جدید" Style="{StaticResource SectionTitle}" />

        <!-- چرخه بیست‌ویکم (گزارش پانزدهم مالک): «صفحهٔ ثبت پرسنل را به جای
             اسکرول کردن کمی بزرگ‌تر کن» — پنجره عریض‌تر شد و فیلدهای هویتی
             دوستونه چیده شدند تا همهٔ محتوا بدون اسکرول در دید باشد -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ردیف ۱: نام (راست) + نام خانوادگی (چپ) -->
            <TextBox Grid.Row="0" Grid.Column="0" materialDesign:HintAssist.Hint="نام *"
                     Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Grid.Row="0" Grid.Column="2" materialDesign:HintAssist.Hint="نام خانوادگی *"
                     Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />

            <!-- ردیف ۲: کد ملی (راست) + موبایل (چپ) — کد ملی با اعتبارسنجی زنده (چرخه بیستم) -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                <TextBox materialDesign:HintAssist.Hint="کد ملی *"
                         Text="{Binding NationalCode, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="10" />
                <TextBlock Text="{Binding NationalCodeValidationText, Mode=OneWay}"
                           Foreground="{Binding NationalCodeValidationColor, Mode=OneWay}"
                           FontSize="10.5" Margin="2,3,2,0"
                           Visibility="{Binding NationalCodeValidationText, Converter={StaticResource StringToVisibility}}" />
            </StackPanel>
            <TextBox Grid.Row="1" Grid.Column="2" Margin="0,12,0,0"
                     materialDesign:HintAssist.Hint="موبایل *"
                     Text="{Binding Mobile, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="11" />

            <!-- ردیف ۳: نوع استخدام (راست، نصف عرض) -->
            <ComboBox Grid.Row="2" Grid.Column="0" Margin="0,12,0,0"
                      materialDesign:HintAssist.Hint="نوع استخدام"
                      SelectedIndex="{Binding EmploymentTypeIndex}">
                <ComboBoxItem Content="تمام‌وقت" />
                <ComboBoxItem Content="پاره‌وقت" />
                <ComboBoxItem Content="قراردادی" />
                <ComboBoxItem Content="کارآموز" />
            </ComboBox>
        </Grid>

        <!-- ═══ اطلاعات حقوقی — چرخه نهم + چیدمان دوستونهٔ چرخه بیست‌ویکم ═══ -->
        <Border Background="#F5F9FF" BorderBrush="#CFE2F5" BorderThickness="1"
                CornerRadius="8" Padding="12,10" Margin="0,14,0,4">
            <StackPanel>
                <TextBlock Text="📄 اطلاعات حقوقی" FontSize="13" FontWeight="Bold"
                           Foreground="#16355E" Margin="0,0,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- چرخه بیست‌ویکم: جداکنندهٔ زندهٔ ۳ رقمی هنگام تایپ (گزارش پانزدهم مالک) -->
                    <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="حقوق پایه (ریال) — ماهانه"
                             behaviors:MoneyInput.IsEnabled="True"
                             behaviors:MoneyInput.NumericValue="{Binding BaseSalary, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MoneyRial}}"
                             materialDesign:TextFieldAssist.PrefixText="﷼" />
                    <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="درصد از سود خدمات (٪)"
                             Text="{Binding CommissionPercent, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:TextFieldAssist.SuffixText="٪" />
                </Grid>
                <TextBlock Text="ℹ️ حقوق درصدی از «سود» خدمت محاسبه می‌شود (مبلغ خدمت منهای هزینه آن)؛ نه از کل فروش. صفر = فقط حقوق پایه."
                           FontSize="10.5" TextWrapping="Wrap" Foreground="#5B7290" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />

        <UniformGrid Columns="2">
            <Button Command="{Binding SaveCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="ثبت" Height="42" Margin="4" />
            <Button Command="{Binding CancelCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="انصراف" Height="42" Margin="4" />
        </UniformGrid>

        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </ScrollViewer>
</Window>