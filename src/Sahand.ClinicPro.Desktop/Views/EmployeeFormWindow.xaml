<Window x:Class="Sahand.ClinicPro.Desktop.Views.EmployeeFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="ثبت پرسنل"
        Height="600" Width="460"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!-- ═══════════════════════════════════════════════════════════
         فرم ثبت پرسنل — گام V8 + اطلاعات حقوقی چرخه نهم
         + کارت عکس پروفایل (چرخه هجدهم — گزارش دوازدهم مالک)
         ═══════════════════════════════════════════════════════════ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">

            <!-- ─── کارت عکس پروفایل — چرخه هجدهم ─── -->
            <Border Background="#F5F9FF" BorderBrush="#CFE2F5" BorderThickness="1"
                    CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <!-- پیش‌نمایش دایره‌ای یا جای‌نگهدار -->
                        <Border Width="86" Height="86" CornerRadius="43"
                                Background="#E3F2FD" BorderBrush="#90CAF9"
                                BorderThickness="2" Cursor="Hand"
                                ToolTip="با کلیک، عکس را بزرگ ببینید">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick"
                                              Command="{Binding ViewPhotoCommand}" />
                            </Border.InputBindings>
                            <Grid>
                                <materialDesign:PackIcon Kind="AccountCircle"
                                                         Width="44" Height="44"
                                                         Foreground="#64B5F6"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Visibility="{Binding HasPendingPhoto, Converter={StaticResource InverseBoolToVisibility}}" />
                                <Image Source="{Binding PhotoPreview}"
                                       Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="🖼 عکس پرسنل" FontSize="13.5" FontWeight="Bold"
                                       Foreground="#16355E" />
                            <TextBlock Text="عکس JPG/PNG تا ۵ مگابایت؛ همراه ثبت، در پوشهٔ Photos/Employees برنامه ذخیره و مسیرش در دیتابیس ثبت می‌شود."
                                       FontSize="10.5" Foreground="#5B7290" TextWrapping="Wrap"
                                       Margin="0,4,0,8" MaxWidth="260" />
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding PickPhotoCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Content="انتخاب عکس" FontSize="12" Padding="14,6" />
                                <Button Command="{Binding ClearPhotoCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="حذف" FontSize="11.5" Foreground="#C62828"
                                        Padding="10,6" Margin="8,0,0,0"
                                        Visibility="{Binding HasPendingPhoto, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="ثبت پرسنل جدید" Style="{StaticResource SectionTitle}" />

        <TextBox materialDesign:HintAssist.Hint="نام *"
                 Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,12" />
        <TextBox materialDesign:HintAssist.Hint="نام خانوادگی *"
                 Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,12" />
        <!-- کد ملی با اعتبارسنجی زنده — چرخه بیستم (گزارش چهاردهم مالک):
             هنگام تایپ، زیر فیلد با متن رنگی بازخورد داده می‌شود -->
        <TextBox materialDesign:HintAssist.Hint="کد ملی *"
                 Text="{Binding NationalCode, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="10" Margin="0,0,0,2" />
        <TextBlock Text="{Binding NationalCodeValidationText, Mode=OneWay}"
                   Foreground="{Binding NationalCodeValidationColor, Mode=OneWay}"
                   FontSize="10.5" Margin="2,3,2,10"
                   Visibility="{Binding NationalCodeValidationText, Converter={StaticResource StringToVisibility}}" />
        <TextBox materialDesign:HintAssist.Hint="موبایل *"
                 Text="{Binding Mobile, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="11" Margin="0,0,0,12" />

        <ComboBox materialDesign:HintAssist.Hint="نوع استخدام"
                  SelectedIndex="{Binding EmploymentTypeIndex}"
                  Margin="0,0,0,14">
            <ComboBoxItem Content="تمام‌وقت" />
            <ComboBoxItem Content="پاره‌وقت" />
            <ComboBoxItem Content="قراردادی" />
            <ComboBoxItem Content="کارآموز" />
        </ComboBox>

        <!-- ═══ اطلاعات حقوقی — چرخه نهم: حقوق پایه + درصد از سود خدمات ═══ -->
        <Border Background="#F5F9FF" BorderBrush="#CFE2F5" BorderThickness="1"
                CornerRadius="8" Padding="12,10" Margin="0,0,0,4">
            <StackPanel>
                <TextBlock Text="📄 اطلاعات حقوقی" FontSize="13" FontWeight="Bold"
                           Foreground="#16355E" Margin="0,0,0,10" />
                <TextBox materialDesign:HintAssist.Hint="حقوق پایه (ریال) — ماهانه"
                         Text="{Binding BaseSalary, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:TextFieldAssist.PrefixText="﷼"
                         Margin="0,0,0,12" />
                <TextBox materialDesign:HintAssist.Hint="درصد حقوق از سود خدمات (٪) — فقط از سود خدمات انجامی خود این پرسنل"
                         Text="{Binding CommissionPercent, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:TextFieldAssist.SuffixText="٪"
                         Margin="0,0,0,8" />
                <TextBlock Text="ℹ️ حقوق درصدی از «سود» خدمت محاسبه می‌شود (مبلغ خدمت منهای هزینه آن)؛ نه از کل فروش. صفر = فقط حقوق پایه."
                           FontSize="10.5" TextWrapping="Wrap" Foreground="#5B7290" />
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />

        <UniformGrid Columns="2">
            <Button Command="{Binding SaveCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="ثبت" Height="42" Margin="4" />
            <Button Command="{Binding CancelCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="انصراف" Height="42" Margin="4" />
        </UniformGrid>

        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </ScrollViewer>
</Window>