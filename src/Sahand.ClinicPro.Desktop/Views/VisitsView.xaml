<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.VisitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1080"
             FlowDirection="RightToLeft">
    <!-- ═══ صف ویزیت — گام U6 طبق پرامپت UI بخش ۲ (فرم ۱۳) ═══
         کارت‌های آماری + بیمار فعلی + صف انتظار + ویزیت‌شده‌ها + فراخوان -->
    <UserControl.InputBindings>
        <KeyBinding Key="Space" Command="{Binding CallNextCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ چرخهٔ ۴۵ (گزارش مالک: «ظاهر صفحات… ویزیت و معاینه… رو خیلی حرفه ای
             تر و زیباتر بکن») — سربرگ گرادیانی برند + فیلتر پزشک و نوسازی روی
             خود سربرگ؛ نشان شیشه‌ای + عنوان/زیرعنوان با راهنمای کلید Space ═══ -->
        <Border Grid.Row="0" CornerRadius="14" Padding="16,10" Margin="0,0,0,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#00695C" Offset="0" />
                    <GradientStop Color="#1B5E20" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.16" Color="#1B4D3E" />
            </Border.Effect>
            <DockPanel>
                <!-- فیلتر پزشک + نوسازی — گوشهٔ چپ فیزیکی (RTL) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Doctors}"
                              SelectedIndex="{Binding DoctorFilterIndex}"
                              DisplayMemberPath="Name"
                              materialDesign:HintAssist.Hint="همهٔ پزشکان"
                              MinWidth="170" VerticalAlignment="Center" />
                    <Button Command="{Binding LoadCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="White" MinWidth="42" MinHeight="36" Margin="6,0,0,0"
                            VerticalAlignment="Center" ToolTip="بارگذاری مجدد">
                        <materialDesign:PackIcon Kind="Refresh" Width="15" Height="15" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="23" VerticalAlignment="Center" Margin="0,0,12,0"
                            Background="#33FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1">
                        <materialDesign:PackIcon Kind="Stethoscope" Width="24" Height="24"
                                                 Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="صف ویزیت پزشک" FontSize="18" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="میانبر فراخوان بیمار بعدی: کلید Space — صف هر ۳۰ ثانیه خودکار تازه می‌شود"
                                   FontSize="10.5" Foreground="#CDE8DC" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ چرخهٔ ۴۶ (گزارش مالک: چیدمان حرفه‌ای) — چهار کارت آماری هم‌الگو با
             زبان طراحی مشترک برنامه؛ ایموجی در برچسب‌ها بود — رندر ناهماهنگ ویندوز؛
             آیکون‌های وکتوری PackIcon با پس‌زمینهٔ ملایم، همیشه یکدست‌اند ═══ -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">
            <!-- کارت ۱: ویزیت‌های تکمیل‌شدهٔ امروز — سبز موفقیت -->
            <Border Style="{StaticResource App.StatCard}" Margin="0,0,6,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource App.StatIcon}"
                            Background="#E8F5E9" BorderBrush="#C8E6C9" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="CheckCircle" Width="21" Height="21"
                                                 Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource App.StatValue}"
                                   Text="{Binding VisitedCount, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                        <TextBlock Style="{StaticResource App.StatLabel}" Text="ویزیت‌شدهٔ امروز" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- کارت ۲: ویزیت‌های در جریان — آبی فعال -->
            <Border Style="{StaticResource App.StatCard}" Margin="6,0,6,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource App.StatIcon}"
                            Background="#E3F2FD" BorderBrush="#BBDEFB" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="PlayCircle" Width="21" Height="21"
                                                 Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource App.StatValue}"
                                   Text="{Binding InProgressCount, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                        <TextBlock Style="{StaticResource App.StatLabel}" Text="در حال ویزیت" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- کارت ۳: بیماران در صف انتظار — کهربایی -->
            <Border Style="{StaticResource App.StatCard}" Margin="6,0,6,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource App.StatIcon}"
                            Background="#FFF8E1" BorderBrush="#FFE082" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="QueueFirstInLastOut" Width="21" Height="21"
                                                 Foreground="#F57F17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource App.StatValue}" Foreground="#E65100"
                                   Text="{Binding WaitingCount, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                        <TextBlock Style="{StaticResource App.StatLabel}" Text="در صف انتظار" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- کارت ۴: میانگین مدت هر ویزیت — بنفش؛ متن (دقیقه) است نه عدد -->
            <Border Style="{StaticResource App.StatCard}" Margin="6,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource App.StatIcon}"
                            Background="#F3E5F5" BorderBrush="#E1BEE7" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="ClockFast" Width="21" Height="21"
                                                 Foreground="#6A1B9A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource App.StatValue}"
                                   Text="{Binding AverageDisplay, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource App.StatLabel}" Text="میانگین مدت هر ویزیت" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>

        <!-- بیمار فعلی -->
        <Border Grid.Row="2" CornerRadius="12" Padding="14,10" Margin="0,0,0,10" Background="#E3F2FD"
                Visibility="{Binding CurrentPatient, Converter={StaticResource NullToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- نشان شمارهٔ نوبت — عدد درشت روی دایرهٔ آبی (چرخهٔ ۴۶: به‌جای
                         ایموجی، عدد واقعی صف بیمار فعلی) -->
                    <Border Width="44" Height="44" CornerRadius="22" Background="#1565C0">
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- چرخهٔ ۷۴: شماره صف با ارقام فارسی -->
                            <TextBlock Text="{Binding CurrentPatient.QueueNumber, Mode=OneWay, Converter={StaticResource PersianDigits}}"
                                       FontWeight="Bold" Foreground="White" />
                        </Viewbox>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="Bold" Foreground="#1F2937">
                            <Run Text="{Binding CurrentPatient.PatientName, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <!-- چرخهٔ ۷۴: ساعت و موبایل با ارقام فارسی -->
                            <TextBlock FontSize="11.5" Opacity="0.75" Foreground="#1F2937">
                                <Run Text="ساعت: " /><Run Text="{Binding CurrentPatient.AppointmentTime, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                            </TextBlock>
                            <TextBlock FontSize="11.5" Opacity="0.75" Margin="14,0,0,0" Foreground="#1F2937">
                                <Run Text="نوع: " /><Run Text="{Binding CurrentPatient.VisitTypeText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="11.5" Opacity="0.75" Margin="14,0,0,0" Foreground="#1F2937">
                                <Run Text="موبایل: " /><Run Text="{Binding CurrentPatient.Mobile, Mode=OneWay, Converter={StaticResource PersianDigits}}" FontFamily="{DynamicResource App.CodeFont}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <Border Background="#FFEBEE" CornerRadius="8" Padding="8,2" Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding CurrentPatient.Allergies, Converter={StaticResource NullToVisibility}}">
                        <TextBlock FontSize="10.5" Foreground="#C62828">
                            <Run Text="" /><Run Text="{Binding CurrentPatient.Allergies, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding OpenCurrentVisitCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}" FontSize="13">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderEditOutline" Width="16" Height="16" VerticalAlignment="Center"  Foreground="#1F2937"/>
                        <TextBlock Text="باز کردن فرم ویزیت" Margin="8,0,0,0"  Foreground="#1F2937"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- دو ستون: صف + ویزیت‌شده‌ها -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- صف انتظار -->
            <Border Grid.Column="0" CornerRadius="12" Padding="12"
                    Background="{DynamicResource MaterialDesign.Brush.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                    BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="بیماران در صف انتظار" FontWeight="Bold" FontSize="13.5" Margin="2,0,2,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Waiting}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="10,8" Margin="0,0,0,6" Background="#FFF8E1"
                                            ToolTip="{Binding Allergies, Mode=OneWay, TargetNullValue='بدون آلرژی'}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#F9A825"
                                                    VerticalAlignment="Center">
                                                <!-- چرخهٔ ۷۴: شماره صف با ارقام فارسی -->
                                                <TextBlock Text="{Binding QueueNumber, Mode=OneWay, Converter={StaticResource PersianDigits}}" FontWeight="Bold"
                                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" FontSize="13"  Foreground="#1F2937"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <!-- چرخهٔ ۷۴: ساعت نوبت با ارقام فارسی -->
                                                    <TextBlock FontSize="11" Opacity="0.7" Foreground="#1F2937">
                                                        <Run Text="ساعت نوبت: " /><Run Text="{Binding AppointmentTime, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Opacity="0.7" Margin="12,0,0,0" Foreground="#1F2937">
                                                        <Run Text="نوع: " /><Run Text="{Binding VisitTypeText, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Foreground="#E65100" Margin="12,0,0,0">
                                                        <Run Text="انتظار: " /><Run Text="{Binding WaitingText, Mode=OneWay}" FontWeight="SemiBold" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- چرخهٔ ۴۷: دیوار کف ارتفاع دکمهٔ ردیفی فراخوان (هم‌الگوی دکمهٔ اصلی) -->
                                            <Button Grid.Column="2" Command="{Binding DataContext.CallNextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="11" Padding="10,6"
                                                    MinWidth="92" MinHeight="34">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="BellRing" Width="13" Height="13" VerticalAlignment="Center"  Foreground="#1F2937"/>
                                                    <TextBlock Text="فراخوان" Margin="6,0,0,0"
                                                               TextWrapping="Wrap" VerticalAlignment="Center"  Foreground="#1F2937"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <controls:EmptyState Message="صف خالی است" IconKind="QueueFirstInLastOut"
                                         Visibility="{Binding Waiting.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" />
                </DockPanel>
            </Border>

            <!-- ویزیت‌شده‌ها -->
            <Border Grid.Column="2" CornerRadius="12" Padding="12"
                    Background="{DynamicResource MaterialDesign.Brush.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                    BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ویزیت‌شده‌های امروز" FontWeight="Bold" FontSize="13.5" Margin="2,0,2,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Done}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="10,7" Margin="0,0,0,6" Background="#E8F5E9">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CheckCircle" Width="15" Height="15" Foreground="#2E7D32" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" FontSize="12.5" Margin="8,0,0,0"  Foreground="#1F2937"/>
                                            </StackPanel>
                                            <TextBlock FontSize="11" Opacity="0.75" Margin="0,3,0,0" FontFamily="{DynamicResource App.CodeFont}" Foreground="#1F2937">
                                                <!-- چرخهٔ ۷۴: بازهٔ زمانی با ارقام فارسی -->
                                                <Run Text="{Binding TimeRange, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                                            </TextBlock>
                                            <TextBlock FontSize="11" Opacity="0.75" Margin="0,2,0,0" Foreground="#1F2937">
                                                <Run Text="تشخیص: " /><Run Text="{Binding DiagnosisText, Mode=OneWay, TargetNullValue=—}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <controls:EmptyState Message="هنوز ویزیتی تکمیل نشده" IconKind="ClipboardCheckOutline"
                                         Visibility="{Binding Done.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- دکمه فراخوان -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
            <!-- ═══ چرخهٔ ۴۷ (گزارش مالک) ═══
                 «در صفحه ویزیت و معاینه، دکمه فراخوانی بیمار بعدی له شده و
                 نوشته خوانده نمیشود. همانند دکمه های پذیرش که درستشون کردی
                 ولی اینو فراموش کردی» — همان نسخهٔ مقاومِ دکمه‌های پذیرش
                 (ReceptionsView چرخهٔ پیشین): دیوار کف ارتفاع ۴۶px + کمینهٔ
                 عرض + شکستن متن تا در پنجره‌های تنگ، متن هرگز له/بریده نشود. -->
            <Button Command="{Binding CallNextCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#1565C0" BorderBrush="#1565C0"
                    FontSize="13" Padding="20,12" MinWidth="230" MinHeight="46">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="BellRing" Width="17" Height="17" VerticalAlignment="Center" />
                    <TextBlock Text="فراخوانی بیمار بعدی (Space)" Margin="10,0,0,0"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <ProgressBar IsIndeterminate="True" Width="24" Height="18" Margin="12,0,0,0"
                         Visibility="{Binding IsCalling, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Grid>
</UserControl>
