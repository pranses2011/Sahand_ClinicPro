<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.VisitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="Vazirmatn, Segoe UI, Tahoma">
    <!-- ═══════════════════════════════════════════════════════════
         ویزیت و معاینه — گام V3
         جستجوی بیمار + تاریخچه ویزیت + شروع ویزیت جدید
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- سربرگ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right"
                    Command="{Binding NewVisitCommand}"
                    IsEnabled="{Binding SelectedPatient, Converter={StaticResource NotNullToBool}}"
                    Style="{StaticResource MaterialDesignFilledButton}"
                    Content="شروع ویزیت جدید" />
            <TextBlock Text="ویزیت و معاینه"
                       Style="{StaticResource SectionTitle}"
                       VerticalAlignment="Center" />
        </DockPanel>

        <!-- جستجوی بیمار -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>
            <TextBox materialDesign:HintAssist.Hint="جستجوی بیمار: نام یا کد ملی یا موبایل"
                     Text="{Binding PatientSearchTerm, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchPatientCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <ListBox Grid.Column="1"
                     ItemsSource="{Binding PatientResults}"
                     SelectedItem="{Binding SelectedPatient}"
                     Height="110"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.75" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- عملیات -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Command="{Binding OpenVisitCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Content="ادامه ثبت ویزیت انتخاب‌شده" Margin="0,0,8,0" />
            <Button Command="{Binding LoadVisitsCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Content="بازخوانی" Margin="0,0,8,0" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.Error}"
                       FontSize="12" VerticalAlignment="Center" />
        </StackPanel>

        <!-- جدول ویزیت‌ها -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Visits}"
                  SelectedItem="{Binding SelectedVisit}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  materialDesign:DataGridAssist.CellPadding="8,6">
            <DataGrid.Columns>
                <DataGridTextColumn Header="کد ویزیت" Binding="{Binding Code}" Width="110" />
                <DataGridTextColumn Header="بیمار" Binding="{Binding PatientName}" Width="*" />
                <DataGridTextColumn Header="پزشک" Binding="{Binding DoctorName}" Width="*" />
                <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="100" />
                <DataGridTextColumn Header="شکایت اصلی" Binding="{Binding ChiefComplaint}" Width="2*" />
                <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="100" />
            </DataGrid.Columns>
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick"
                              Command="{Binding OpenVisitCommand}" />
            </DataGrid.InputBindings>
        </DataGrid>
    </Grid>
</UserControl>