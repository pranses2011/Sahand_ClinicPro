<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.ReceptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1080"
             FlowDirection="RightToLeft">
    <!-- ═══ پذیرش بیمار — گام U5 طبق پرامپت UI بخش ۲ (فرم ۱۰) ═══ -->
    <UserControl.Resources>
        <Style x:Key="FieldCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="Margin" Value="2,6,2,3" />
        </Style>
        <!-- سبک‌های نوار گام (WizCircle/WizNum/WizLabel/WizLink) در چرخهٔ ۷۶ به
             App.xaml منتقل شدند (App.Wizard*) تا صفحهٔ نوبت‌دهی هم از همان‌ها
             استفاده کند — کلیدهای قدیمی برای سازگاری به نسخهٔ سراسری نگاشت می‌شوند -->
    </UserControl.Resources>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ چرخهٔ ۴۴ (گزارش مالک: «ظاهر صفحه پذیرش رو خیلی حرفه ای تر و
             زیباتر بکن») — سربرگ گرادیانی برند؛ هم‌الگوی صفحات بروزرساشده:
             نشان شیشه‌ای + عنوان/زیرعنوان + چیپ راهنمای جریان در گوشهٔ چپ فیزیکی ═══ -->
        <Border Grid.Row="0" CornerRadius="14" Padding="16,12" Margin="0,0,0,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1E88E5" Offset="0" />
                    <GradientStop Color="#0D47A1" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.18" Color="#1E3A5F" />
            </Border.Effect>
            <DockPanel>
                <!-- چیپ جریان کار — گوشهٔ چپ فیزیکی (RTL) -->
                <Border DockPanel.Dock="Left" CornerRadius="9" Padding="10,3" VerticalAlignment="Center"
                        Background="#26FFFFFF" BorderBrush="#59FFFFFF" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeftBold" Width="12" Height="12" Foreground="White" VerticalAlignment="Center" />
                        <TextBlock Text="بیمار ← خدمت ← بیمه و ثبت" Foreground="White" FontSize="10.5"
                                   FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="23" VerticalAlignment="Center" Margin="0,0,12,0"
                            Background="#33FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1">
                        <materialDesign:PackIcon Kind="ClipboardAccount" Width="24" Height="24"
                                                 Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="پذیرش بیمار" FontSize="18" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="جستجوی هوشمند بیمار + استعلام بیمه + محاسبه خودکار هزینه + صف زنده"
                                   FontSize="11" Foreground="#D9E7F5" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- ═══ کارت‌های آماری — چرخهٔ ۴۶: هم‌الگو با زبان طراحی مشترک برنامه
                     (App.StatCard)؛ ایموجی‌های برچسب حذف شدند — رندر ناهماهنگ در ویندوز ═══ -->
                <UniformGrid Columns="4" Margin="0,0,0,12">
                    <!-- کارت ۱: بیماران در انتظار پذیرش — کهربایی فعال -->
                    <Border Style="{StaticResource App.StatCard}" Margin="0,0,6,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource App.StatIcon}"
                                    Background="#FFF3E0" BorderBrush="#FFE0B2" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="AccountClock" Width="21" Height="21"
                                                         Foreground="#E65100" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource App.StatValue}"
                                           Text="{Binding WaitingCount, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                                <TextBlock Style="{StaticResource App.StatLabel}" Text="در انتظار پذیرش" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- کارت ۲: پذیرش‌های ثبت‌شدهٔ امروز — سبز موفقیت -->
                    <Border Style="{StaticResource App.StatCard}" Margin="6,0,6,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource App.StatIcon}"
                                    Background="#E8F5E9" BorderBrush="#C8E6C9" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="AccountCheck" Width="21" Height="21"
                                                         Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource App.StatValue}"
                                           Text="{Binding ReceivedCount, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                                <TextBlock Style="{StaticResource App.StatLabel}" Text="پذیرش‌شدهٔ امروز" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- کارت ۳: بیماران در صف فعلی — آبی جریان -->
                    <Border Style="{StaticResource App.StatCard}" Margin="6,0,6,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource App.StatIcon}"
                                    Background="#E3F2FD" BorderBrush="#BBDEFB" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="QueueFirstInLastOut" Width="21" Height="21"
                                                         Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource App.StatValue}"
                                           Text="{Binding InQueue, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                                <TextBlock Style="{StaticResource App.StatLabel}" Text="در صف فعلی" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- کارت ۴: درآمد پذیرش امروز — فیروزه‌ای مالی؛ واحد پول پویا از تنظیمات -->
                    <Border Style="{StaticResource App.StatCard}" Margin="6,0,0,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource App.StatIcon}"
                                    Background="#E0F2F1" BorderBrush="#B2DFDB" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="CashMultiple" Width="21" Height="21"
                                                         Foreground="#00695C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource App.StatValue}" FontSize="15" Foreground="#00695C"
                                           Text="{Binding TodayRevenueDisplay, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource App.StatLabel}">
                                    <Run Text="درآمد پذیرش (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </UniformGrid>

                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,10"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                <!-- ═══ فرم پذیرش جدید ═══ -->
                <Border CornerRadius="12" Padding="14" Margin="0,0,0,12"
                        Background="{DynamicResource MaterialDesign.Brush.Background}"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                        BorderThickness="1">
                    <StackPanel>
                        <!-- سربرگ فرم — چرخهٔ ۴۴: به‌جای جداکنندهٔ متنی «═══»،
                             سربرگ ساختاریافته با نشان رنگی و خط زیرین -->
                        <DockPanel Margin="0,0,0,10">
                            <Border DockPanel.Dock="Right" Width="30" Height="30" CornerRadius="15"
                                    Background="#E3F2FD" VerticalAlignment="Center" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="ClipboardPlusOutline" Width="16" Height="16"
                                                         Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="فرم پذیرش جدید" FontWeight="Bold" FontSize="14" />
                                <Border Height="2.5" CornerRadius="1.2" Width="52" HorizontalAlignment="Right"
                                        Background="{DynamicResource MaterialDesign.Brush.Primary}" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <!-- ═══ چرخهٔ ۷۶ — نوار گام‌های ویزارد پذیرش ═══
                             گزارش مالک چرخهٔ ۷۴: «ورود اطلاعات و ثبت به‌صورت مرحله‌ای (Wizard)».
                             سه گام با دایرهٔ شماره و برچسب؛ وضعیت از WizardStep:
                             جاری = آبی برند، انجام‌شده = سبز، آینده = کم‌رنگ. خط اتصال
                             میان گام‌ها پس از گذر سبز می‌شود -->
                        <Grid Margin="0,6,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- گام ۱ — بیمار (راست)؛ همیشه جاری یا انجام‌شده است -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource App.WizardCircle}">
                                            <Setter Property="Background" Value="#2E7D32" />
                                            <Setter Property="BorderBrush" Value="#1B5E20" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WizardStep}" Value="0">
                                                    <Setter Property="Background" Value="#1565C0" />
                                                    <Setter Property="BorderBrush" Value="#0D47A1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="۱" Style="{StaticResource App.WizardNumber}" Foreground="White" />
                                </Border>
                                <TextBlock Text="انتخاب بیمار">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource App.WizardLabel}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WizardStep}" Value="0">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Setter Property="Foreground" Value="#1565C0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- اتصال گام ۱ → ۲ -->
                            <Border Grid.Column="1">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource App.WizardLink}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WizardStep}" Value="1">
                                                <Setter Property="Background" Value="#2E7D32" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding WizardStep}" Value="2">
                                                <Setter Property="Background" Value="#2E7D32" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- گام ۲ — خدمت -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource App.WizardCircle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WizardStep}" Value="1">
                                                    <Setter Property="Background" Value="#1565C0" />
                                                    <Setter Property="BorderBrush" Value="#0D47A1" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding WizardStep}" Value="2">
                                                    <Setter Property="Background" Value="#2E7D32" />
                                                    <Setter Property="BorderBrush" Value="#1B5E20" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="۲">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource App.WizardNumber}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WizardStep}" Value="1">
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding WizardStep}" Value="2">
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="نوع خدمت / پزشک">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource App.WizardLabel}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WizardStep}" Value="1">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Setter Property="Foreground" Value="#1565C0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- اتصال گام ۲ → ۳ -->
                            <Border Grid.Column="3">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource App.WizardLink}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WizardStep}" Value="2">
                                                <Setter Property="Background" Value="#2E7D32" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- گام ۳ — ثبت (چپ) -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource App.WizardCircle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WizardStep}" Value="2">
                                                    <Setter Property="Background" Value="#1565C0" />
                                                    <Setter Property="BorderBrush" Value="#0D47A1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="۳">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource App.WizardNumber}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WizardStep}" Value="2">
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="بیمه، هزینه و ثبت">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource App.WizardLabel}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WizardStep}" Value="2">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Setter Property="Foreground" Value="#1565C0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!-- ═══ گام ۰ — بیمار: جستجوی هوشمند + نتایج + کارت پرونده ═══ -->
                        <StackPanel Visibility="{Binding WizardStep, Converter={StaticResource SectionToVisibility}, ConverterParameter=0}">

                        <!-- جستجوی هوشمند — چرخه بیست‌وسوم: برچسب و راهنما برای جستجوی
                             نام/نام‌خانوادگی و تطبیق جزئی (پیش‌تر فقط کد ملی کامل جواب می‌داد) -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="نام / کد ملی / موبایل / کد پیگیری (APT-…):"
                                       VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12.5" />
                            <TextBox Grid.Column="1" Text="{Binding SmartSearch, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="مثلاً «علی رضایی» یا ۰۰۱۲۳ یا ۰۹۱۲ یا APT-1024">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SmartSearchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2" Command="{Binding SmartSearchCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Magnify" Width="15" Height="15" VerticalAlignment="Center" />
                                    <TextBlock Text="جستجو" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- فهرست نتایج جستجو — چرخه بیست‌وسوم (گزارش شانزدهم مالک):
                             «وقتی قسمتی از کد ملی یا نام رو بزنیم جستجو موارد رو بیاره تا انتخاب بکنیم» —
                             چندنتیجه فهرست می‌شود و با کلیک، همان بیمار انتخاب می‌گردد؛
                             با انتخاب بیمار فهرست مخفی می‌شود (منبع پاک نمی‌شود تا انتخاب باطل نگردد) -->
                        <ListBox ItemsSource="{Binding PatientResults}"
                                 SelectedItem="{Binding SelectedSearchResult}"
                                 Visibility="{Binding ShowSearchResults, Converter={StaticResource BoolToVisibility}}"
                                 MaxHeight="170" Margin="0,2,0,8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Grid.Column="0" Kind="Account" Width="16" Height="16"
                                                                 Foreground="#1565C0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding NationalCode, Mode=OneWay}" FontFamily="{DynamicResource App.CodeFont}"
                                                       Opacity="0.72" Margin="14,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Mobile, Mode=OneWay}" FontFamily="{DynamicResource App.CodeFont}"
                                                       Opacity="0.72" Margin="14,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="#E8F5E9" CornerRadius="8" Padding="8,1"
                                                VerticalAlignment="Center">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                                                <Run Text="" /><Run Text="{Binding InsuranceName, Mode=OneWay, TargetNullValue=آزاد}" />
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- کارت بیمار -->
                        <Border CornerRadius="10" Padding="12,8" Margin="0,4,0,10" Background="#E3F2FD"
                                Visibility="{Binding FoundPatient, Converter={StaticResource NullToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Account" Width="18" Height="18" Foreground="#1565C0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding FoundPatient.FullName, Mode=OneWay}" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                        <TextBlock Margin="18,0,0,0" VerticalAlignment="Center" Opacity="0.75" FontFamily="{DynamicResource App.CodeFont}"
                                                   Text="{Binding FoundPatient.NationalCode, Mode=OneWay}"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                        <TextBlock Margin="18,0,0,0" VerticalAlignment="Center" Opacity="0.75" FontFamily="{DynamicResource App.CodeFont}"
                                                   Text="{Binding FoundPatient.Mobile, Mode=OneWay}"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                        <Border Background="#E8F5E9" CornerRadius="8" Padding="8,1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                                                <Run Text="" /><Run Text="{Binding FoundPatient.InsuranceName, Mode=OneWay, TargetNullValue=آزاد}" />
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                    <Border Background="#FFEBEE" CornerRadius="8" Padding="8,2" Margin="0,6,0,0"
                                            HorizontalAlignment="Left"
                                            Visibility="{Binding FoundPatient.Allergies, Converter={StaticResource NullToVisibility}}">
                                        <TextBlock FontSize="11" Foreground="#C62828">
                                            <Run Text="آلرژی: " /><Run Text="{Binding FoundPatient.Allergies, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="{Binding FoundAppointmentInfo, Mode=OneWay}" FontSize="11.5"
                                               Foreground="#1565C0" Margin="0,6,0,0"
                                               Visibility="{Binding FoundAppointmentInfo, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        </StackPanel><!-- پایان گام ۰ — بیمار -->

                        <!-- ═══ گام ۱ — خدمت: نوع پذیرش + پزشک/خدمت + انجام‌دهنده/اتاق + لوازم مصرفی ═══ -->
                        <StackPanel Visibility="{Binding WizardStep, Converter={StaticResource SectionToVisibility}, ConverterParameter=1}">

                        <!-- حالت پذیرش + پزشک/خدمت — چرخه ۲۴ -->
                        <StackPanel>
                                <!-- ═══ چرخه ۲۴ (گزارش هفدهم مالک) — «پذیرش فقط پزشک دارد؛
                                     بیمار آمپول/سرم/پانسمان/آزمایش/عکس چه شود؟» — انتخابگر
                                     نوع پذیرش: ویزیت پزشک یا خدمت درمانی از تعرفه‌ها ═══ -->
                                <TextBlock Text=" نوع پذیرش" Style="{StaticResource FieldCaption}" />
                                <ComboBox ItemsSource="{Binding ReceptionModes}"
                                          SelectedIndex="{Binding ReceptionModeIndex}"
                                          FontSize="12" />

                                <!-- حالت ویزیت پزشک: پزشک + نوع ویزیت -->
                                <StackPanel Visibility="{Binding ReceptionModeIndex, Converter={StaticResource SectionToVisibility}, ConverterParameter=0}">
                                    <TextBlock Text="پزشک" Style="{StaticResource FieldCaption}" />
                                    <ComboBox ItemsSource="{Binding Doctors}"
                                              SelectedItem="{Binding SelectedDoctor}"
                                              DisplayMemberPath="Name" />
                                    <TextBlock Text="نوع ویزیت" Style="{StaticResource FieldCaption}" />
                                    <ComboBox SelectedIndex="{Binding VisitTypeIndex}">
                                        <ComboBoxItem Content="اولیه" />
                                        <ComboBoxItem Content="پیگیری" />
                                        <ComboBoxItem Content="اورژانس" />
                                        <ComboBoxItem Content="مشاوره" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- حالت خدمت درمانی: خدمت از تعرفه‌ها + انجام‌دهندهٔ اختیاری + اتاق -->
                                <StackPanel Visibility="{Binding ReceptionModeIndex, Converter={StaticResource SectionToVisibility}, ConverterParameter=1}">
                                    <TextBlock Text="خدمت درمانی (تزریقات/پانسمان/آزمایش/تصویربرداری/…)" Style="{StaticResource FieldCaption}" TextWrapping="Wrap" />
                                    <ComboBox ItemsSource="{Binding Services}"
                                              SelectedItem="{Binding SelectedService}"
                                              DisplayMemberPath="Name" />
                                    <TextBlock Text="انجام‌دهنده (اختیاری — از پرسنل)" Style="{StaticResource FieldCaption}" />
                                    <ComboBox ItemsSource="{Binding Performers}"
                                              SelectedItem="{Binding SelectedPerformer}"
                                              DisplayMemberPath="FullName" />
                                    <!-- ═══ چرخهٔ سی‌ونه‌م (گزارش مالک) ═══ «اتاق معاینه برای پزشک
                                         در برنامهٔ کاری پزشک مشخص می‌شود ولی برای خدمات درمانی نمی‌شود
                                         معین کرد» — انتخابگر اتاقِ محل انجام خدمت از اتاق‌های فعال؛
                                         نام اتاق پس از ثبت در ستون «اتاق» صف پذیرش امروز می‌نشیند -->
                                    <TextBlock Text="اتاق انجام خدمت (اختیاری — از اتاق‌های درمانگاه)" Style="{StaticResource FieldCaption}" />
                                    <!-- ═══ چرخهٔ ۸۲ — ریشهٔ «نام اتاق‌ها نمایش داده نمی‌شود
                                         ولی به تعداد اتاق‌ها آیتم خالی می‌آید» ═══
                                         RoomOption در ReceptionsViewModel فقط Id و
                                         DisplayName دارد (بدون Name). DisplayMemberPath="Name"
                                         یعنی هیچ ستونی برای نمایش پیدا نمی‌شود؛ WPF برای هر
                                         آیتم یک ردیف خالی می‌کشد ⇒ دقیقاً همان چیزی که مالک
                                         دید. مسیر درست: DisplayName (همان قرارداد فرم پزشک). -->
                                    <ComboBox ItemsSource="{Binding Rooms}"
                                              SelectedItem="{Binding SelectedRoom}"
                                              DisplayMemberPath="DisplayName" />
                                </StackPanel>

                            </StackPanel>

                        <!-- ═══ چرخهٔ سی‌ونه‌م (گزارش مالک) — لوازم مصرفی درمانگاه ═══
                             «سرنگ و سرم و گاز استریل و مواردی از این قبیل رو وقتی بیمار
                             با خودش نمیاره، باید از لوازم خود درمانگاه استفاده بکنیم و
                             در پذیرش برای اونها هم هزینه به هزینه‌های بیمار اضافه بشه» —
                             فقط در حالت خدمت درمانی نمایان؛ اقلام دارای موجودی از انبار
                             می‌آیند، جمع هزینه بی‌درنگ به «قابل پرداخت بیمار» می‌چسبد و
                             هنگام ثبت، موجودی FEFO کم می‌شود و به فاکتور می‌نشیند. -->
                        <Border CornerRadius="10" Padding="14,10" Margin="0,12,0,0"
                                Background="#E0F7FA" BorderBrush="#4DD0E1" BorderThickness="1"
                                Visibility="{Binding ReceptionModeIndex, Converter={StaticResource SectionToVisibility}, ConverterParameter=1}">
                            <StackPanel>
                                <TextBlock Text="لوازم مصرفی درمانگاه — برای مواردی که بیمار خودش همراه ندارد"
                                           FontSize="12.5" FontWeight="Bold" Margin="0,0,0,8"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>

                                <!-- ردیف افزودن: قلم + تعداد + دکمه -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding ConsumableOptions}"
                                              SelectedItem="{Binding SelectedConsumable}"
                                              DisplayMemberPath="Display"
                                              materialDesign:HintAssist.Hint="انتخاب قلم مصرفی (نام — موجودی · قیمت)"
                                              FontSize="12" />
                                    <TextBox Grid.Column="1" Text="{Binding ConsumableQty, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="تعداد"
                                             Margin="8,0,0,0" FontFamily="{DynamicResource App.CodeFont}"
                                             HorizontalContentAlignment="Center" />
                                    <Button Grid.Column="2" Command="{Binding AddConsumableCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Margin="8,0,0,0" MinWidth="90" MinHeight="38" Padding="14,8"
                                            ToolTip="افزودن قلم مصرفی به فهرست مصرف این پذیرش">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Width="15" Height="15" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                            <TextBlock Text="افزودن" Margin="6,0,0,0" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- راهنمای نبود قلم مصرفی در انبار — چرخهٔ ۴۱: صفحهٔ مستقل
                                     مصرفی‌ها (گروه «پذیرش و درمان» منوی کناری) جای ماژول داروخانه را گرفت -->
                                <TextBlock FontSize="11" Foreground="#006064" Opacity="0.85" Margin="2,8,2,0"
                                           Text="هیچ قلم مصرفی‌ای موجودی ندارد — نخست از صفحهٔ «لوازم مصرفی» منوی کناری (قلم مصرفی جدید + ورود کالا) سرنگ/سرم/گاز و… را ثبت کنید."
                                           TextWrapping="Wrap"
                                           Visibility="{Binding ConsumableOptions, Converter={StaticResource EmptyListToVisibility}}" />

                                <!-- ردیف‌های مصرف انتخاب‌شده -->
                                <ItemsControl ItemsSource="{Binding Consumables}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="8" Padding="9,5"
                                                    Margin="0,0,0,5" BorderBrush="#80DEEA" BorderThickness="1"
                                                    Opacity="0.97">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="95" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="Syringe" Width="15" Height="15" Foreground="#00838F" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Option.Name}" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                                    </StackPanel>
                                                    <!-- تعداد — قابل ویرایش؛ جمع همان لحظه تازه می‌شود -->
                                                    <TextBox Grid.Column="1" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                             FontFamily="{DynamicResource App.CodeFont}" FontSize="12.5"
                                                             materialDesign:HintAssist.Hint="تعداد"
                                                             MinWidth="60" Margin="8,0,0,0" HorizontalContentAlignment="Center"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding LineTotal, Mode=OneWay, Converter={StaticResource CurrencyRial}}"
                                                               FontFamily="{DynamicResource App.CodeFont}" FontSize="12.5" FontWeight="Bold"
                                                               Foreground="#006064" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    <Button Grid.Column="3" Command="{Binding DataContext.RemoveConsumableCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignFlatButton}"
                                                            Foreground="#C62828" Padding="6,2" Margin="8,0,0,0"
                                                            ToolTip="حذف این قلم از فهرست مصرف">
                                                        <materialDesign:PackIcon Kind="Close" Width="14" Height="14"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- جمع مصرفی‌ها — فقط وقتی ردیفی هست -->
                                <Border Background="#B2EBF2" CornerRadius="8" Padding="10,5" Margin="0,6,0,0"
                                        Visibility="{Binding HasConsumables, Converter={StaticResource BoolToVisibility}}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="جمع لوازم مصرفی (۱۰۰٪ بر عهدهٔ بیمار — بدون سهم بیمه):"
                                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                        <TextBlock Text="{Binding ConsumablesTotalDisplay, Mode=OneWay}"
                                                   FontFamily="{DynamicResource App.CodeFont}" FontSize="14.5" FontWeight="Bold"
                                                   Foreground="#006064" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        </StackPanel><!-- پایان گام ۱ — خدمت -->

                        <!-- ═══ گام ۲ — بیمه، هزینه و ثبت ═══ -->
                        <StackPanel Visibility="{Binding WizardStep, Converter={StaticResource SectionToVisibility}, ConverterParameter=2}">

                        <!-- بیمه + ارجاع + یادداشت — دو ستون (چرخهٔ ۷۶: از فرم قدیمی به گام ثبت منتقل شد) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- ستون راست: بیمه و استعلام — بدون تغییر رفتار، فقط جابه‌جایی به گام ثبت -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="نوع بیمه" Style="{StaticResource FieldCaption}" />
                                <ComboBox ItemsSource="{Binding InsuranceCompanies}"
                                          SelectedIndex="{Binding InsuranceIndex}"
                                          DisplayMemberPath="DisplayName" />
                                <TextBlock Text="شماره بیمه" Style="{StaticResource FieldCaption}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding InsuranceNumber, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Command="{Binding VerifyInsuranceCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="8,0,0,0"
                                            ToolTip="استعلام برخط از سامانه بیمه">
                                        <StackPanel Orientation="Horizontal">
                                            <ProgressBar Width="16" Height="16" IsIndeterminate="True"
                                                         Visibility="{Binding IsInquiring, Converter={StaticResource BoolToVisibility}}" />
                                            <materialDesign:PackIcon Kind="LinkVariant" Width="14" Height="14"
                                                                     VerticalAlignment="Center"
                                                                     Visibility="{Binding IsInquiring, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                                            <TextBlock Text="استعلام" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- نتیجه استعلام -->
                                <Border CornerRadius="8" Padding="10,6" Margin="0,8,0,0"
                                        Visibility="{Binding Inquiry, Converter={StaticResource NullToVisibility}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFEBEE" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Inquiry.IsEligible}" Value="True">
                                                    <Setter Property="Background" Value="#E8F5E9" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" FontSize="12">
                                            <Run Text="{Binding Inquiry.IsEligible, Mode=OneWay, Converter={StaticResource BoolToText}}" />
                                            <Run Text=" — " /><Run Text="{Binding Inquiry.Message, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Opacity="0.8" Margin="0,3,0,0"
                                                   Visibility="{Binding Inquiry.ApprovalCode, Converter={StaticResource NullToVisibility}}">
                                            <Run Text="کد تأیید: " /><Run Text="{Binding Inquiry.ApprovalCode, Mode=OneWay}" FontFamily="{DynamicResource App.CodeFont}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ستون چپ: ارجاع + یادداشت -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="کد ارجاع (اختیاری)" Style="{StaticResource FieldCaption}" />
                                <TextBox Text="{Binding ReferralCode, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="یادداشت پذیرش" Style="{StaticResource FieldCaption}" />
                                <TextBox Text="{Binding ReceptionNotes, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" Height="56" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <!-- ═══ محاسبه هزینه ═══ -->
                        <!-- چرخهٔ سی‌ودوم (گزارش مالک): «برای بیمهٔ آزاد هم سهم بیمه و سهم
                             بیمار می‌اندازد که اشتباه است» — در حالت «آزاد (بدون بیمه)»
                             ستون سهم بیمه پنهان و ستون سهم بیمار پهن‌تر و برجسته می‌شود؛
                             کل تعرفه بر عهدهٔ بیمار است و نمایش دو سهم گمراه‌کننده است. -->
                        <Border CornerRadius="10" Padding="14,10" Margin="0,12,0,0" Background="#FFF8E1"
                                BorderBrush="#FFE082" BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontSize="11" Opacity="0.7" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"><Run Text="حق ویزیت (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock>
                                        <TextBlock Text="{Binding FeeDisplay, Mode=OneWay}" FontSize="15" FontWeight="Bold" FontFamily="{DynamicResource App.CodeFont}"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Visibility="{Binding HasInsurance, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock FontSize="11" Opacity="0.7" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                                            <Run Text="سهم بیمه (" /><Run Text="{Binding CoveragePercent, Mode=OneWay}" /><Run Text="٪)" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding InsuranceShareDisplay, Mode=OneWay}" FontSize="15" FontWeight="Bold" FontFamily="{DynamicResource App.CodeFont}" Foreground="#2E7D32" />
                                    </StackPanel>
                                    <!-- ستون سهم بیمار — جایگاه آن از استایل تعیین می‌شود
                                         (مقدار محلی Grid.Column عمداً حذف شده تا تریگرِ
                                         حالت آزاد بتواند آن را به ستون میانی ببرد) -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Grid.Column" Value="2" />
                                                <Style.Triggers>
                                                    <!-- آزاد: سهم بیمار جای ستون سهم بیمه را هم می‌گیرد -->
                                                    <DataTrigger Binding="{Binding HasInsurance}" Value="False">
                                                        <Setter Property="Grid.Column" Value="1" />
                                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock FontSize="11" Opacity="0.7"
                                                   ToolTip="سهم بیمار از خدمت + هزینهٔ لوازم مصرفی درمانگاه (۱۰۰٪ بر عهدهٔ بیمار — چرخهٔ ۳۹)" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                                            <Run Text="قابل پرداخت بیمار (خدمت + لوازم) (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" />
                                        </TextBlock>
                                        <!-- چرخهٔ ۳۹ — مبلغ نهایی = سهم بیمار خدمت + جمع لوازم مصرفی؛
                                             بدون مصرفی همان سهم بیمار خدمت است -->
                                        <TextBlock Text="{Binding PayableByPatientDisplay, Mode=OneWay}" FontSize="18" FontWeight="Bold"
                                                   FontFamily="{DynamicResource App.CodeFont}" Foreground="#C62828" />
                                    </StackPanel>
                                </Grid>
                                <!-- راهنمای حالت آزاد — بدون بیمه هیچ سهمی روی بیمه نیست -->
                                <TextBlock Text="🆓 پذیرش آزاد (بدون بیمه) — کل مبلغ تعرفه توسط بیمار پرداخت می‌شود"
                                           FontSize="10.5" Foreground="#C62828" Opacity="0.85" Margin="0,6,0,0"
                                           Visibility="{Binding HasInsurance, Converter={StaticResource InverseBoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <!-- ═══ دکمه‌های زنجیره‌ای — چرخهٔ سی‌ونه‌م (گزارش مالک) ═══
                             «دکمه‌های پذیرش و فاکتور و پذیرش و پرداخت نقدی له شده‌اند
                             و متن روی دکمه‌ها ناقص دیده می‌شود» — سه‌لایهٔ ضدفشردگی:
                             ۱) Padding سخاوانه (۲۰×۱۲) تا متن هرگز به لبهٔ دکمه نچسبد
                             ۲) MinWidth/MinHeight صریح — دکمه حتی در تنگ‌ترین فضا از
                                محتوای خود عریض‌تر/مرتفع‌تر می‌ماند (له‌شدن یعنی عرضِ
                                کمتر از محتوا؛ سقف صریح این حالت را قطعی می‌کند)
                             ۳) TextWrapping روی متن — اگر به هر دلیل (پنجرهٔ باریک،
                                فونت درشت‌شده از تنظیمات، DPI خاص) فضای افقی کم بیاید
                                متن به دو خط می‌شکند و دکمه بلندتر می‌شود؛ دیگر هرگز
                                بریده/ناقص نمایش داده نمی‌شود -->
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Left">
                            <Button Command="{Binding ReceptionAndInvoiceCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    FontSize="13" Padding="20,12" MinWidth="195" MinHeight="46"
                                    Margin="0,0,10,0"
                                    ToolTip="ثبت پذیرش + صدور فاکتور — بدون ثبت پرداخت">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="17" Height="17" VerticalAlignment="Center" />
                                    <TextBlock Text="پذیرش و فاکتور" Margin="8,0,0,0"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ReceptionAndPayCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="#2E7D32" BorderBrush="#2E7D32"
                                    FontSize="13" Padding="20,12" MinWidth="215" MinHeight="46"
                                    ToolTip="ثبت پذیرش + صدور فاکتور + پنجرهٔ انتخاب روش پرداخت (نقدی/کارتخوان)">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CashCheck" Width="17" Height="17" VerticalAlignment="Center" />
                                    <TextBlock Text="پذیرش و پرداخت" Margin="8,0,0,0"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        </StackPanel><!-- پایان گام ۲ — ثبت -->

                        <!-- ═══ ناوبری ویزارد — چرخهٔ ۷۶ ═══
                             «مرحلهٔ بعد» در سمت چپ (جهت پیشرفت در چیدمان راست‌به‌چپ)
                             و در گام آخر مخفی؛ «مرحلهٔ قبل» در سمت راست و در گام نخست مخفی -->
                        <DockPanel Margin="0,16,0,0" LastChildFill="False">
                            <Button DockPanel.Dock="Left" Command="{Binding NextStepCommand}"
                                    FontSize="13" Padding="22,10" MinWidth="170" MinHeight="44">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WizardStep}" Value="2">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="مرحلهٔ بعد" VerticalAlignment="Center" />
                                    <materialDesign:PackIcon Kind="ArrowLeftBold" Width="16" Height="16"
                                                             VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button DockPanel.Dock="Right" Command="{Binding BackStepCommand}"
                                    FontSize="13" Padding="18,10" MinWidth="140" MinHeight="44">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WizardStep}" Value="1">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding WizardStep}" Value="2">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ArrowRightBold" Width="16" Height="16"
                                                             VerticalAlignment="Center" />
                                    <TextBlock Text="مرحلهٔ قبل" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ صف پذیرش امروز ═══ -->
                <Border CornerRadius="12" Padding="14"
                        Background="{DynamicResource MaterialDesign.Brush.Background}"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                        BorderThickness="1">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="═══ صف پذیرش امروز ═══" FontWeight="Bold" FontSize="14" />
                            <Button DockPanel.Dock="Left" Command="{Binding LoadCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock Text="بارگذاری" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                        <!-- چرخهٔ ۶۳ (P-08): مجازی‌سازی صریح + پیمایش تعویقی — فقط ردیف‌های دیدنی رندر می‌شوند؛ در فهرست‌های چند‌هزار ردیفی تفاوت چندثانیه‌ای -->
    <DataGrid ItemsSource="{Binding Receptions}"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.IsDeferredScrollingEnabled="True"
                                  LoadingRow="OnQueueRowLoading"
                                  SelectedItem="{Binding SelectedReception}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  HeadersVisibility="Column" FontSize="12" MinHeight="150">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="شماره" Binding="{Binding Number, TargetNullValue=—, Converter={StaticResource PersianDigits}}" Width="Auto" FontFamily="{DynamicResource App.CodeFont}" MaxWidth="420"  ElementStyle="{StaticResource App.TableCellTextBlock}" />
                                <DataGridTemplateColumn Header="بیمار" Width="Auto" SortMemberPath="PatientName" MaxWidth="420">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Account" Width="14" Height="14" Opacity="0.5" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="پزشک" Binding="{Binding DoctorName, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                                <DataGridTextColumn Header="ساعت پذیرش" Binding="{Binding Time, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                                <DataGridTextColumn Header="بیمه" Binding="{Binding InsuranceName, TargetNullValue=آزاد, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                                <!-- چرخهٔ ۳۹ — اتاق محل انجام خدمت (پذیرش خدمتی) -->
                                <DataGridTextColumn Header="اتاق" Binding="{Binding RoomName, TargetNullValue=—, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                                <DataGridTemplateColumn Header="وضعیت" Width="Auto" SortMemberPath="StatusId" MaxWidth="420">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="9,2" HorizontalAlignment="Center"
                                                    Background="{Binding StatusColor}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="انتظار" Binding="{Binding WaitingText, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                                <!-- ═══ چرخه سی‌ویکم (گزارش مالک): «هیچ مبلغی در هیچ‌کجای برنامه
                                     نمایش داده نمیشود» — دو ستون مالی برای هر پذیرش روز:
                                     جمع فاکتور + پرداخت‌شده (مبدل ریالی با ارقام فارسی) و
                                     برچسب وضعیت مالی (تسویه/پرداخت‌نشده/بدون فاکتور) ═══ -->
                                <DataGridTextColumn Binding="{Binding InvoiceTotal, Converter={StaticResource CurrencyRial}}" Width="Auto" MaxWidth="420">
                                    <DataGridTextColumn.Header>
                                        <TextBlock><Run Text="مبلغ فاکتور (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock>
                                    </DataGridTextColumn.Header>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource App.TableCellTextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="FontFamily" Value="{DynamicResource App.CodeFont}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding PaidAmount, Converter={StaticResource CurrencyRial}}" Width="Auto" MaxWidth="420">
                                    <DataGridTextColumn.Header>
                                        <TextBlock><Run Text="پرداخت‌شده (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock>
                                    </DataGridTextColumn.Header>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource App.TableCellTextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="FontFamily" Value="{DynamicResource App.CodeFont}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="وضعیت مالی" Width="Auto" SortMemberPath="FinancialText" MaxWidth="420">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#ECEFF1" />
                                                        <Style.Triggers>
                                                            <!-- تسویه → سبز؛ پرداخت‌نشده → قرمزروشن -->
                                                            <DataTrigger Binding="{Binding FinancialText}" Value="تسویه">
                                                                <Setter Property="Background" Value="#E8F5E9" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FinancialText}" Value="پرداخت‌نشده">
                                                                <Setter Property="Background" Value="#FFEBEE" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding FinancialText}" FontSize="11" VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
