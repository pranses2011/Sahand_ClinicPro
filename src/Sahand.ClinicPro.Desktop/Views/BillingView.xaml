<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1080"
             FlowDirection="RightToLeft">
    <!-- ═══ مالی و صندوق — گام U8 طبق پرامپت UI بخش ۳ (فرم ۱۴ و ۱۵) ═══ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="CashMultiple" Width="26" Height="26"
                                         Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                         VerticalAlignment="Center" />
                <TextBlock Text="💰 صندوق و صدور فاکتور" FontSize="20" FontWeight="Bold"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Command="{Binding NewInvoiceCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="صدور فاکتور" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RecordPaymentCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CashPlus" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="ثبت پرداخت" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
                <!-- بستن شیفت — چرخه ۱۳ (درخواست ۲-۲) -->
                <Button Command="{Binding CloseShiftCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"
                        Background="#37474F" BorderBrush="#37474F" ToolTip="شمارش فیزیکی + اختلاف‌سنجی + رسید تحویل شیفت">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CashLock" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="🌙 بستن شیفت" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding LoadCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}">
                    <materialDesign:PackIcon Kind="Refresh" Width="15" Height="15" />
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- کارت‌های صندوق -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,10">
            <controls:StatCard IconKind="ReceiptTextOutline" Margin="0,0,8,0"
                               Value="{Binding InvoiceCount, Mode=OneWay}"
                               Label="🧾 فاکتورهای امروز" AccentBrush="#5C6BC0" />
            <controls:StatCard IconKind="Cash" Margin="0,0,8,0"
                               Value="{Binding CashTotalDisplay, Mode=OneWay}"
                               Label="💵 نقدی (ریال)" AccentBrush="#2E7D32" />
            <controls:StatCard IconKind="CreditCard" Margin="0,0,8,0"
                               Value="{Binding CardTotalDisplay, Mode=OneWay}"
                               Label="💳 کارت‌خوان" AccentBrush="#1565C0" />
            <controls:StatCard IconKind="Bank" Margin="0,0,8,0"
                               Value="{Binding NetTotalDisplay, Mode=OneWay}"
                               Label="📊 مجموع امروز" AccentBrush="#00838F" />
            <controls:StatCard IconKind="ChartLine"
                               Value="🟢 باز"
                               Label="وضعیت صندوق" AccentBrush="#F9A825" />
        </UniformGrid>

        <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="3" Margin="0,0,0,10"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!-- دو ستون: فاکتورها + تراکنش‌ها -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- فاکتورهای اخیر -->
            <Border Grid.Column="0" CornerRadius="12" Padding="10"
                    Background="{DynamicResource MaterialDesign.Brush.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="🧾 فاکتورهای اخیر" FontWeight="Bold" FontSize="14" Margin="2,0,2,8" />
                    <DataGrid ItemsSource="{Binding Invoices}"
                              SelectedItem="{Binding SelectedInvoice}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" FontSize="12" AlternatingRowBackground="#F7FAFD">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="شماره" Binding="{Binding InvoiceNumber}" Width="80" FontFamily="Consolas" />
                            <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi, TargetNullValue=—}" Width="85" />
                            <DataGridTextColumn Header="بیمار" Binding="{Binding PatientName}" Width="*" />
                            <DataGridTextColumn Header="مبلغ (ریال)" Binding="{Binding Total, StringFormat='{}{0:N0}'}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas" />
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="پرداخت (ریال)" Binding="{Binding Paid, StringFormat='{}{0:N0}'}" Width="105">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas" />
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="وضعیت" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Center"
                                                Background="{Binding PaymentStatusColor}">
                                            <TextBlock Text="{Binding PaymentStatusText}" FontSize="10.5" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- تراکنش‌های امروز -->
            <Border Grid.Column="2" CornerRadius="12" Padding="10"
                    Background="{DynamicResource MaterialDesign.Brush.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="💵 تراکنش‌های امروز" FontWeight="Bold" FontSize="14" Margin="2,0,2,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Transactions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="9,7" Margin="0,0,0,5" Background="#FAFAFA"
                                            BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" FontSize="12" />
                                                    <TextBlock Text="{Binding MethodText}" FontSize="10.5" Opacity="0.7" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock FontSize="10.5" Opacity="0.6" Margin="0,2,0,0">
                                                    <Run Text="ساعت " /><Run Text="{Binding Time, Mode=OneWay}" FontFamily="Consolas" />
                                                    <Run Text=" — فاکتور " /><Run Text="{Binding InvoiceId, Mode=OneWay, TargetNullValue=—}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat='{}{0:N0}'}"
                                                       FontFamily="Consolas" FontWeight="Bold" Foreground="#2E7D32"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
