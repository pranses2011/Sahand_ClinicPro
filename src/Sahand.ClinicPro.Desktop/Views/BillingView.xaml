<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="Vazirmatn, Segoe UI, Tahoma">
    <!-- ═══════════════════════════════════════════════════════════
         مالی و صندوق — گام V5
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- سربرگ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding NewInvoiceCommand}"
                        Style="{StaticResource MaterialDesignFilledButton}"
                        Content="صدور فاکتور" Margin="0,0,8,0" />
                <Button Command="{Binding RecordPaymentCommand}"
                        IsEnabled="{Binding SelectedInvoice, Converter={StaticResource NotNullToBool}}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Content="ثبت پرداخت" />
            </StackPanel>
            <TextBlock Text="مالی و صندوق"
                       Style="{StaticResource SectionTitle}"
                       VerticalAlignment="Center" />
        </DockPanel>

        <!-- فیلترها -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBox materialDesign:HintAssist.Hint="جستجو: شماره فاکتور یا نام بیمار"
                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                     Width="250" Margin="0,0,12,0">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <ComboBox materialDesign:HintAssist.Hint="وضعیت پرداخت"
                      ItemsSource="{Binding PaymentLabels}"
                      SelectedIndex="{Binding PaymentFilterIndex}"
                      Width="160" Margin="0,0,12,0" />
            <Button Command="{Binding LoadCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="بازخوانی" Margin="0,0,8,0" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.Error}"
                       FontSize="12" VerticalAlignment="Center" />
        </StackPanel>

        <!-- جدول -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Invoices}"
                  SelectedItem="{Binding SelectedInvoice}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  materialDesign:DataGridAssist.CellPadding="8,6">
            <DataGrid.Columns>
                <DataGridTextColumn Header="شماره فاکتور" Binding="{Binding Number}" Width="120" />
                <DataGridTextColumn Header="بیمار" Binding="{Binding PatientName}" Width="*" />
                <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="100" />
                <DataGridTextColumn Header="مبلغ کل (ریال)" Binding="{Binding TotalAmount, StringFormat=N0}" Width="140" />
                <DataGridTextColumn Header="پرداخت‌شده" Binding="{Binding PaidAmount, StringFormat=N0}" Width="130" />
                <DataGridTextColumn Header="مانده" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="120" />
                <DataGridTextColumn Header="پرداخت" Binding="{Binding PaymentText}" Width="110" />
                <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="110" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- صفحه‌بندی -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right"
                    Command="{Binding NextPageCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Content="صفحه بعد" />
            <Button DockPanel.Dock="Right"
                    Command="{Binding PrevPageCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Content="صفحه قبل"
                    Margin="0,0,8,0" />
            <TextBlock VerticalAlignment="Center" FontSize="13" Opacity="0.8">
                <Run Text="صفحه " />
                <Run Text="{Binding PageNumber, Mode=OneWay}" />
                <Run Text=" از " />
                <Run Text="{Binding TotalPages, Mode=OneWay}" />
                <Run Text=" — جمع: " />
                <Run Text="{Binding TotalCount, Mode=OneWay}" />
                <Run Text=" فاکتور" />
            </TextBlock>
        </DockPanel>
    </Grid>
</UserControl>