<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.SepasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100"
             FlowDirection="RightToLeft"
             FontFamily="Vazirmatn, Segoe UI, Tahoma">
    <!-- ═══ سامانه سپاس — گام U18 طبق فرم بخش ۵: ۵ تب ═══ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <materialDesign:PackIcon Kind="BankTransfer" Width="26" Height="26"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
            <TextBlock Text="یکپارچه‌سازی سامانه سپاس" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <TabControl Grid.Row="2" SelectedIndex="{Binding TabIndex}" Style="{StaticResource MaterialDesignTabControl}">

            <!-- ─── تب ۱: وضعیت ─── -->
            <TabItem Header="📊 وضعیت">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <StackPanel Margin="8,12">
                        <Button Command="{Binding LoadStatsCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                HorizontalAlignment="Left" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="بازخوانی وضعیت" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <UniformGrid Columns="5">
                            <Border CornerRadius="12" Padding="14" Margin="5" Background="#E3F2FD">
                                <StackPanel>
                                    <TextBlock Text="کل تراکنش‌ها" FontSize="11" Opacity="0.7" />
                                    <TextBlock Text="{Binding TotalText}" FontSize="20" FontWeight="Bold" FontFamily="Consolas" />
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="12" Padding="14" Margin="5" Background="#E8F5E9">
                                <StackPanel>
                                    <TextBlock Text="✅ همگام‌شده" FontSize="11" Opacity="0.7" />
                                    <TextBlock Text="{Binding SyncedText}" FontSize="20" FontWeight="Bold" FontFamily="Consolas" />
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="12" Padding="14" Margin="5" Background="#FFF8E1">
                                <StackPanel>
                                    <TextBlock Text="⏳ در انتظار" FontSize="11" Opacity="0.7" />
                                    <TextBlock Text="{Binding PendingText}" FontSize="20" FontWeight="Bold" FontFamily="Consolas" />
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="12" Padding="14" Margin="5" Background="#FFEBEE">
                                <StackPanel>
                                    <TextBlock Text="❌ ناموفق" FontSize="11" Opacity="0.7" />
                                    <TextBlock Text="{Binding FailedText}" FontSize="20" FontWeight="Bold" FontFamily="Consolas" />
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="12" Padding="14" Margin="5" Background="#F3E5F5">
                                <StackPanel>
                                    <TextBlock Text="📤 امروز" FontSize="11" Opacity="0.7" />
                                    <TextBlock Text="{Binding TodayText}" FontSize="20" FontWeight="Bold" FontFamily="Consolas" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Text="{Binding LastSyncText, StringFormat='آخرین همگام‌سازی: {0}'}"
                                   FontSize="12" Opacity="0.75" Margin="4,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─── تب ۲: تراکنش‌ها ─── -->
            <TabItem Header="🔄 تراکنش‌ها">
                <Grid Margin="4,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Command="{Binding LoadTransactionsCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" />
                        </Button>
                        <Button Command="{Binding RetryCommand}" Style="{StaticResource MaterialDesignOutlinedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Restore" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="بازارسال انتخابی" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Transactions}" SelectedItem="{Binding SelectedTransaction}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" FontSize="12" AlternatingRowBackground="#F7FAFD">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="بیمار" Binding="{Binding Patient}" Width="170" />
                            <DataGridTextColumn Header="نوع" Binding="{Binding TypeText}" Width="110" />
                            <DataGridTextColumn Header="شناسه ارجاع" Binding="{Binding ReferenceId, TargetNullValue=—}" Width="130" FontFamily="Consolas" />
                            <DataGridTemplateColumn Header="وضعیت" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="9,2" HorizontalAlignment="Center"
                                                Background="{Binding StatusColor}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="White" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="تلاش مجدد" Binding="{Binding RetryCount}" Width="80" />
                            <DataGridTextColumn Header="ارسال" Width="150">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="SentAt" Converter="{StaticResource ShamsiDateTime}" TargetNullValue="—" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="خطا" Binding="{Binding Error, TargetNullValue=—}" Width="*" FontSize="10.5" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ─── تب ۳: دریافتی‌ها ─── -->
            <TabItem Header="💰 دریافتی‌ها">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="CashCheck" Width="56" Height="56" Opacity="0.4" HorizontalAlignment="Center" />
                    <TextBlock Text="دریافتی‌های سپاس پس از فعال‌سازی قرارداد رسمی نمایش داده می‌شود"
                               FontSize="13" Opacity="0.7" Margin="0,10,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="این تب به سامانه مالی بیمه سلامت متصل می‌شود"
                               FontSize="11.5" Opacity="0.55" Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </TabItem>

            <!-- ─── تب ۴: تنظیمات ─── -->
            <TabItem Header="⚙️ تنظیمات">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                    <materialDesign:PackIcon Kind="CogOutline" Width="48" Height="48" Opacity="0.4" HorizontalAlignment="Center" />
                    <TextBlock Text="تنظیمات اتصال سپاس در «تنظیمات → سامانه‌های دولتی» انجام می‌شود"
                               FontSize="13" Opacity="0.7" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                </StackPanel>
            </TabItem>

            <!-- ─── تب ۵: لاگ API ─── -->
            <TabItem Header="📋 لاگ API">
                <Grid Margin="4,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Command="{Binding LoadApiLogsCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                            HorizontalAlignment="Left" Margin="0,0,0,8">
                        <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" />
                    </Button>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ApiLogs}" SelectedItem="{Binding SelectedApiLog}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" FontSize="12" AlternatingRowBackground="#F7FAFD">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="سرویس" Binding="{Binding Service, TargetNullValue=—}" Width="110" />
                            <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint, TargetNullValue=—}" Width="*" FontFamily="Consolas" FontSize="10.5" />
                            <DataGridTextColumn Header="متد" Binding="{Binding Method, TargetNullValue=—}" Width="60" FontFamily="Consolas" />
                            <DataGridTextColumn Header="کد" Binding="{Binding StatusCode, TargetNullValue=—}" Width="60" FontFamily="Consolas" />
                            <DataGridTextColumn Header="مدت (ms)" Binding="{Binding DurationMs, TargetNullValue=—}" Width="80" FontFamily="Consolas" />
                            <DataGridTextColumn Header="زمان" Width="150">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="CalledAt" Converter="{StaticResource ShamsiDateTime}" TargetNullValue="—" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="نتیجه" Binding="{Binding IsSuccess}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="جزئیات فراخوانی انتخاب‌شده:" FontSize="12.5" FontWeight="SemiBold" Margin="2,10,0,6" />
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="10" Padding="10,8" Background="#F7FAFD" BorderBrush="#DCE7F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Request" FontSize="11.5" FontWeight="SemiBold" Foreground="#1565C0" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding SelectedApiLog.Request, TargetNullValue='—'}"
                                           FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" CornerRadius="10" Padding="10,8" Background="#F7FAFD" BorderBrush="#DCE7F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Response" FontSize="11.5" FontWeight="SemiBold" Foreground="#2E7D32" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding SelectedApiLog.Response, TargetNullValue='—'}"
                                           FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
