<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.SurveyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
             xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="660" d:DesignWidth="1120"
             FlowDirection="RightToLeft">
    <!-- ═══ نظرسنجی بیماران — گام V2 چرخه هفتم (فرم ۳۴): دو تب ═══ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- سربرگ -->
        <Border Grid.Row="0" Background="White" BorderBrush="#D3E2F0" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Border Width="38" Height="38" CornerRadius="9" Background="#E8F2FD" Margin="0,0,10,0">
                    <materialDesign:PackIcon Kind="CommentQuoteOutline" Width="23" Height="23" Foreground="#176AC2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="نظرسنجی بیماران" Foreground="#173657" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="مدیریت نظرسنجی‌ها و مشاهدهٔ نتایج ثبت‌شده" Foreground="#617992" FontSize="11" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <TabControl Grid.Row="2" SelectedIndex="{Binding TabIndex}" Style="{StaticResource MaterialDesignTabControl}">

            <!-- ═══════════ تب ۱: لیست نظرسنجی‌ها ═══════════ -->
            <TabItem Header="📋 لیست نظرسنجی‌ها">
                <Grid Margin="4,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- نوار دکمه‌ها -->
                    <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="➕ نظرسنجی جدید" Command="{Binding OpenCreateFormCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,4" />
                        <Button Content="✏️ ویرایش" Command="{Binding OpenEditFormCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,4" />
                        <Button Content="⏯ فعال/غیرفعال" Command="{Binding ToggleActiveCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,4" />
                        <Button Content="📤 ارسال لینک به ویزیت‌های امروز" Command="{Binding SendLinksCommand}"
                                ToolTip="نیازمند سرویس عمومی پاسخ‌گویی خارجی و تنظیم Surveys:PublicBaseUrl؛ ابتدا کارکرد لینک را بررسی کنید"
                                Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,4"
                                Background="#FB8C00" BorderBrush="#FB8C00" />
                        <Button Content="ثبت پاسخ ناشناس" Command="{Binding OpenResponseFormCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,4" />
                        <Button Content="🔄 بارگذاری مجدد" Command="{Binding LoadSurveysCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,4" />
                    </WrapPanel>

                    <!-- فرم ایجاد/ویرایش با سازنده پویا سوالات -->
                    <Border Grid.Row="1" CornerRadius="12" BorderBrush="#90CAF9" BorderThickness="1.2"
                            Background="#F5FAFF" Padding="14" Margin="0,0,0,10"
                            Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon Kind="PlaylistEdit" Width="20" Height="20" Foreground="#1565C0" VerticalAlignment="Center" />
                                <TextBlock FontSize="14.5" FontWeight="Bold" Foreground="#1565C0" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="ایجاد نظرسنجی جدید" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Text" Value="ویرایش نظرسنجی" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- عنوان -->
                            <TextBox materialDesign:HintAssist.Hint="عنوان نظرسنجی — مثال: نظرسنجی رضایت اردیبهشت"
                                     Text="{Binding FormTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10" />

                            <!-- توضیح و نوع -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="توضیح (اختیاری)"
                                         Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                                <ComboBox Grid.Column="2" materialDesign:HintAssist.Hint="نوع نظرسنجی"
                                          ItemsSource="{Binding TypeOptions}"
                                          SelectedItem="{Binding FormType}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                            </Grid>

                            <TextBlock Text="پاسخ‌های سؤال‌ها در فرم داخلی ثبت می‌شوند؛ پاسخ‌گویی از لینک عمومی به سرویس مستقل نیاز دارد."
                                       TextWrapping="Wrap" Foreground="#8C5814" FontSize="11" Margin="2,0,2,8" />
                            <!-- سازنده پویا سوالات -->
                            <TextBlock Text="سوالات نظرسنجی (سازنده پویا):" FontSize="12.5" FontWeight="SemiBold" Margin="2,0,0,6"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                            <ItemsControl ItemsSource="{Binding Questions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Background="{DynamicResource MaterialDesign.Brush.Card.Background}" BorderBrush="#E3F2FD"
                                                BorderThickness="1" Padding="8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.1*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="1.4*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="متن سوال"
                                                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="12" />
                                                <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:SurveyQuestionItem.TypeOptions}"
                                                          SelectedItem="{Binding QuestionType}"
                                                          materialDesign:HintAssist.Hint="نوع" FontSize="12"
                                                          Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                                                <TextBox Grid.Column="4" materialDesign:HintAssist.Hint="گزینه‌ها با | جدا شود"
                                                         Text="{Binding Choices, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="12">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding QuestionType}" Value="چندگزینه‌ای">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <Button Grid.Column="6" Command="{Binding DataContext.RemoveQuestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignIconButton}" ToolTip="حذف سوال" Foreground="#C62828">
                                                    <materialDesign:PackIcon Kind="CloseCircleOutline" Width="22" Height="22" Foreground="#C62828" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <WrapPanel Orientation="Horizontal" Margin="0,4,0,12">
                                <Button Content="➕ افزودن سوال" Command="{Binding AddQuestionCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="#1565C0" />
                            </WrapPanel>

                            <!-- ذخیره/لغو -->
                            <WrapPanel Orientation="Horizontal">
                                <Button Content="💾 ذخیره نظرسنجی" Command="{Binding SaveFormCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0" />
                                <Button Content="لغو" Command="{Binding CancelFormCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                            </WrapPanel>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- ورود پاسخ توسط پرسنل؛ هیچ بیمار یا پزشکی به‌صورت خودکار نسبت داده نمی‌شود. -->
                    <Border Grid.Row="2" CornerRadius="10" BorderBrush="#D3E2F0" BorderThickness="1" Background="White" Padding="12" Margin="0,0,0,10"
                            Visibility="{Binding IsResponseFormOpen, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" FontSize="14"><Run Text="ثبت پاسخ ناشناس: " /><Run Text="{Binding ResponseSurveyTitle}" /></TextBlock>
                                <TextBlock Text="این پاسخ به بیمار یا پزشک مشخصی متصل نمی‌شود." FontSize="11" Foreground="#617992" Margin="0,4,0,8" />
                                <ItemsControl ItemsSource="{Binding ResponseAnswers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Answer}" Margin="0,4,0,0">
                                                    <ComboBox.Style>
                                                        <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding TypeKey}" Value="text"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </ComboBox.Style>
                                                </ComboBox>
                                                <TextBox Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" Margin="0,4,0,0">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding TypeKey}" Value="text"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="امتیاز کلی (اختیاری)" FontSize="11" Margin="0,4,0,2" />
                                <ComboBox ItemsSource="{Binding ResponseRatingOptions}" SelectedIndex="{Binding ResponseRatingIndex}" MaxWidth="220" HorizontalAlignment="Right" />
                                <TextBox Text="{Binding ResponseComment, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" Margin="0,8,0,8" materialDesign:HintAssist.Hint="نظر آزاد (اختیاری)" />
                                <WrapPanel>
                                    <Button Content="ثبت پاسخ" Command="{Binding SubmitSurveyResponseCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0" />
                                    <Button Content="انصراف" Command="{Binding CancelResponseFormCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- جدول نظرسنجی‌ها -->
                    <DataGrid Grid.Row="3" ItemsSource="{Binding Surveys}"
                              SelectedItem="{Binding SelectedSurvey}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Style="{StaticResource App.TableDataGrid}"
                              HeadersVisibility="Column"
                              FontSize="12.5" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="عنوان" Binding="{Binding Title, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="نوع" Binding="{Binding TypeText, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding ActiveText, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="پاسخ‌ها" Binding="{Binding ResponseCount, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="میانگین امتیاز" Binding="{Binding AverageText, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ═══════════ تب ۲: نتایج و آمار ═══════════ -->
            <TabItem Header="📊 نتایج و آمار">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12">
                    <StackPanel>

                        <!-- انتخابگر نظرسنجی + بارگذاری -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.4*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" materialDesign:HintAssist.Hint="انتخاب نظرسنجی"
                                      ItemsSource="{Binding Surveys}"
                                      SelectedItem="{Binding ResultsSurvey}"
                                      DisplayMemberPath="Title"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                            <Button Grid.Column="2" Content="🔄 بارگذاری نتایج" Command="{Binding LoadResultsCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" />
                        </Grid>

                        <TextBlock Text="{Binding ResultsMessage}" Foreground="#617992" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                                     Visibility="{Binding IsResultsLoading, Converter={StaticResource BoolToVisibility}}" />
                        <!-- کارت‌های خلاصه -->
                        <UniformGrid Columns="3" Rows="1" Margin="0,0,0,14">
                            <controls:StatCard IconKind="CommentMultipleOutline"
                                               Value="{Binding TotalResponsesText, Mode=OneWay}"
                                               Label="کل پاسخ‌های ثبت‌شده"
                                               CompareText="از ابتدای راه‌اندازی نظرسنجی"
                                               AccentBrush="#1E88E5" />
                            <controls:StatCard IconKind="StarCircleOutline"
                                               Value="{Binding AverageText, Mode=OneWay}"
                                               Label="میانگین امتیاز کل"
                                               CompareText="بر پایه ستاره‌های ۱ تا ۵"
                                               AccentBrush="#FB8C00" />
                            <controls:StatCard IconKind="ClockFast"
                                               Value="{Binding Last30Text, Mode=OneWay}"
                                               Label="پاسخ ۳۰ روز اخیر"
                                               CompareText="روند مشارکت اخیر بیماران"
                                               AccentBrush="#43A047" />
                        </UniformGrid>

                        <!-- توزیع ستاره‌ها -->
                        <Border CornerRadius="12" BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="StarOutline" Width="20" Height="20" Foreground="#FB8C00" VerticalAlignment="Center" />
                                    <TextBlock Text="توزیع امتیازها" FontSize="14" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Stars}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding StarText}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <ProgressBar Grid.Column="1" Height="16" BorderThickness="0" Background="#F5F5F5"
                                                             Value="{Binding BarHeight, Mode=OneWay}" Maximum="100" MinWidth="2" />
                                                <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="12" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="34" TextAlignment="Left" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- میانگین امتیاز پزشکان -->
                        <Border CornerRadius="12" BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="Doctor" Width="20" Height="20" Foreground="#1565C0" VerticalAlignment="Center" />
                                    <TextBlock Text="میانگین امتیاز به تفکیک پزشک" FontSize="14" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding DoctorRatings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.6*" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="0.7*" />
                                                    <ColumnDefinition Width="0.9*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DoctorName}" FontSize="12.5" VerticalAlignment="Center" />
                                                <ProgressBar Grid.Column="1" Height="14" BorderThickness="0" Background="#F5F5F5"
                                                             Value="{Binding BarHeight, Mode=OneWay}" Maximum="100" MinWidth="2" />
                                                <TextBlock Grid.Column="2" Text="{Binding ResponseCount}" FontSize="11.5" Opacity="0.7"
                                                           VerticalAlignment="Center" TextAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding AverageText}" FontSize="12.5" FontWeight="Bold"
                                                           Foreground="#2E7D32" VerticalAlignment="Center" TextAlignment="Left" Margin="8,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="برای هر پزشک: نام | نوار مقایسه‌ای | تعداد پاسخ | میانگین"
                                           FontSize="10.5" Opacity="0.55" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="12" BorderBrush="#D3E2F0" BorderThickness="1" Background="White" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="پاسخ‌های سؤال‌به‌سؤال (۲۰ مورد اخیر)" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding AnswerHistory}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" BorderBrush="#D3E2F0" BorderThickness="1" Padding="10" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SubmittedShamsi}" Foreground="#617992" FontSize="11" />
                                                    <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- نظرات آزاد اخیر -->
                        <Border CornerRadius="12" BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="CommentTextOutline" Width="20" Height="20" Foreground="#00897B" VerticalAlignment="Center" />
                                    <TextBlock Text="نظرات آزاد بیماران (۲۰ مورد اخیر)" FontSize="14" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Comments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Background="{DynamicResource MaterialDesign.Brush.Background}" BorderBrush="#EEEEEE"
                                                    BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="AccountCircleOutline" Width="16" Height="16" Opacity="0.6" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                                            <TextBlock Text="{Binding PatientName}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                                            <TextBlock Text="{Binding RatingText}" FontSize="10.5" Margin="10,1,0,0" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding SubmittedShamsi}" FontSize="10.5" Opacity="0.6" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Text="{Binding Comment}" FontSize="12.5" TextWrapping="Wrap"
                                                               Margin="0,6,0,0" LineHeight="22"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
