<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.SurveyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="774" d:DesignWidth="1030"
             FlowDirection="RightToLeft">
    <!-- نظرسنجی بیماران — بازطراحی کامل بر اساس survey.html و survey-results.html.
         دو نمای «فهرست نظرسنجیها» و «نتایج و آمار» با TabIndex ویومدل جابهجا میشوند. -->
    <UserControl.Resources>
        <Style x:Key="Ds.ShowOnList" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TabIndex}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Ds.ShowOnResults" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TabIndex}" Value="1"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Ds.TabActiveOnList" TargetType="Border">
            <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TabIndex}" Value="0"><Setter Property="BorderBrush" Value="#1565C0" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- استایل مستقل (بدون BasedOn) — در غیراینصورت تریگر TabIndex=0
             از استایل پایه بهارث میرسید و تب دوم در هر دو نما آبی میماند. -->
        <Style x:Key="Ds.TabActiveOnResults" TargetType="Border">
            <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TabIndex}" Value="1"><Setter Property="BorderBrush" Value="#1565C0" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- قالب سطرهای توزیع ستارگان و پزشکان — دادهها از همان ViewModel واقعی -->
        <DataTemplate x:Key="Ds.StarRow">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="66" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StarText}" FontSize="10.5" Foreground="#D97706" VerticalAlignment="Center" />
                <Border Grid.Column="1" Background="#E8EEF5" CornerRadius="5" Height="10" Margin="0,0,7,0">
                    <Border Background="#0D9488" CornerRadius="5" HorizontalAlignment="Left"
                            Width="{Binding BarHeight}" MinWidth="8" />
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat='{}{0} پاسخ'}" Style="{StaticResource Ds.Muted}"
                           FontSize="9.5" VerticalAlignment="Center" HorizontalAlignment="Left" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="Ds.DoctorRow">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="#E3F0FB" VerticalAlignment="Center">
                    <TextBlock Text="👨‍⚕️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="7,0,7,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DoctorName}" FontSize="10.5" FontWeight="Bold" />
                    <Border Background="#E8EEF5" CornerRadius="5" Height="9" Margin="0,3,0,0">
                        <Border Background="#1565C0" CornerRadius="5" HorizontalAlignment="Left"
                                Width="{Binding BarHeight}" MinWidth="8" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Border Style="{StaticResource Ds.Tag}" Background="#E3F0FB" BorderBrush="#BBDBFB">
                        <TextBlock Text="{Binding AverageText}" FontSize="10" Foreground="#1565C0" FontWeight="Bold" /></Border>
                    <TextBlock Text="{Binding ResponseCount, StringFormat='{}{0} پاسخ'}" Style="{StaticResource Ds.Muted}"
                               FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="Ds.CommentRow">
            <Border Background="#F8FBFE" BorderBrush="#D9E2EC" BorderThickness="1" CornerRadius="8"
                    Padding="9,7" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="{Binding Comment}" FontSize="10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PatientName, StringFormat='{}{0} · نظر ثبتشده'}" Style="{StaticResource Ds.Muted}"
                               FontSize="9" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource Ds.PageBackground}" Margin="14,11,14,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ سربرگ ══ -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="#1565C0" Margin="0,0,9,0">
                <TextBlock Text="📝" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="نظرسنجی بیماران" Style="{StaticResource Ds.PageTitle}" />
                <TextBlock Text="ساخت نظرسنجی، تحلیل پاسخها و بایدهای پزشکان — یکپارچه" Style="{StaticResource Ds.Muted}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="+ نظرسنجی جدید" Style="{StaticResource Ds.FlatPrimary}" Height="32" Padding="12,0" Margin="0,0,6,0" />
                <Button Content="ویژهشهای امروز" Style="{StaticResource Ds.FlatGhost}" Height="32" Padding="11,0" Margin="0,0,6,0" />
                <Button Content="ویرایش ✎" Style="{StaticResource Ds.FlatGhost}" Height="32" Padding="11,0" Margin="0,0,6,0" />
                <Button Content="فعال/غیرفعال ⏻" Style="{StaticResource Ds.FlatGhost}" Height="32" Padding="11,0" Margin="0,0,6,0" />
                <Button Content="📊 نتایج" Style="{StaticResource Ds.FlatGhost}" Height="32" Padding="11,0" />
            </StackPanel>
        </Grid>

        <!-- ══ پنج کارت آماری ══ -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource Ds.StatCard}" Background="#F4FBF4" BorderBrush="#81C784">
                <StackPanel><TextBlock Text="{Binding Kpis.V1}" Style="{StaticResource Ds.StatNumber}" Foreground="#2E7D32" />
                    <TextBlock Text="نرخ پاسخگویی" Style="{StaticResource Ds.StatLabel}" /></StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource Ds.StatCard}" Background="#FFFAF3" BorderBrush="#FFB74D">
                <StackPanel><TextBlock Text="{Binding Kpis.V2}" Style="{StaticResource Ds.StatNumber}" Foreground="#E65100" />
                    <TextBlock Text="میانگین امتیاز" Style="{StaticResource Ds.StatLabel}" /></StackPanel>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource Ds.StatCard}" Background="#F5FAFF" BorderBrush="#64B5F6">
                <StackPanel><TextBlock Text="{Binding Kpis.V3}" Style="{StaticResource Ds.StatNumber}" Foreground="#1565C0" />
                    <TextBlock Text="پاسخ این ماه" Style="{StaticResource Ds.StatLabel}" /></StackPanel>
            </Button>
            <Button Grid.Column="6" Style="{StaticResource Ds.StatCard}" Background="#FDF7FF" BorderBrush="#BA68C8">
                <StackPanel><TextBlock Text="{Binding Kpis.V4}" Style="{StaticResource Ds.StatNumber}" Foreground="#6A1B9A" />
                    <TextBlock Text="نظرسنجیهای فعال" Style="{StaticResource Ds.StatLabel}" /></StackPanel>
            </Button>
            <Button Grid.Column="8" Style="{StaticResource Ds.StatCard}" Background="#FFF5F5" BorderBrush="#E57373">
                <StackPanel><TextBlock Text="{Binding Kpis.V5}" Style="{StaticResource Ds.StatNumber}" Foreground="#C62828" />
                    <TextBlock Text="نظرات اخیر" Style="{StaticResource Ds.StatLabel}" /></StackPanel>
            </Button>
        </Grid>

        <!-- ══ تبها ══ -->
        <Border Grid.Row="2" Style="{StaticResource Ds.TabBar}" Padding="0,2,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border Style="{StaticResource Ds.TabActiveOnList}">
                    <TextBlock Text="فهرست نظرسنجیها" Style="{StaticResource Ds.TabItemText}" />
                </Border>
                <Border Style="{StaticResource Ds.TabActiveOnResults}">
                    <TextBlock Text="نتایج و آمار" Style="{StaticResource Ds.TabItemText}" />
                </Border>
                <TextBlock Text="سازندهٔ سوالات" Style="{StaticResource Ds.TabItemText}" />
            </StackPanel>
        </Border>

        <!-- ══ نوار ابزار ══ -->
        <Border Grid.Row="3" Style="{StaticResource Ds.Toolbar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource Ds.CompactText}" />
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button Content="همه" Style="{StaticResource Ds.ChipActive}" />
                    <Button Content="فعال" Style="{StaticResource Ds.Chip}" />
                    <Button Content="پایان یافته" Style="{StaticResource Ds.Chip}" />
                    <Button Content="پیشنویس" Style="{StaticResource Ds.Chip}" />
                </WrapPanel>
                <Button Grid.Column="2" Content="تازهمسازی" Style="{StaticResource Ds.OutlineButton}" Padding="11,0" />
            </Grid>
        </Border>

        <!-- ══ نمای ۱: فهرست نظرسنجیها ══ -->
        <Grid Grid.Row="4" Style="{StaticResource Ds.ShowOnList}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Ds.Panel}">
                    <StackPanel>
                        <TextBlock Text="فهرست نظرسنجیها 📋" Style="{StaticResource Ds.PanelTitle}" />
                        <DataGrid ItemsSource="{Binding Surveys}" Style="{StaticResource Ds.TableDataGrid}"
                                  ColumnHeaderStyle="{StaticResource Ds.TableColumnHeader}" RowHeight="30" MaxHeight="150">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="عنوان" Binding="{Binding Title}" Width="1.3*"
                                                    ElementStyle="{StaticResource Ds.TableCellText}" />
                                <DataGridTextColumn Header="توضیح" Binding="{Binding Description}" Width="1.5*"
                                                    ElementStyle="{StaticResource Ds.TableCellText}" />
                                <DataGridTextColumn Header="سوالات" Binding="{Binding TypeText}" Width="*"
                                                    ElementStyle="{StaticResource Ds.TableCellText}" />
                                <DataGridTextColumn Header="پاسخها" Binding="{Binding ResponseCount}" Width="60"
                                                    ElementStyle="{StaticResource Ds.TableCellText}" />
                                <DataGridTextColumn Header="میانگین" Binding="{Binding AverageText}" Width="62"
                                                    ElementStyle="{StaticResource Ds.TableCellText}" />
                                <DataGridTextColumn Header="وضعیت" Binding="{Binding ActiveText}" Width="62"
                                                    ElementStyle="{StaticResource Ds.TableCellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="۴ نظرسنجی · ۲ فعال · ۱ پایانیافته · ۱ پیشنویس" Style="{StaticResource Ds.Muted}"
                                   HorizontalAlignment="Left" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Ds.Panel}">
                    <StackPanel>
                        <TextBlock Text="توزیع امتیازها ⭐" Style="{StaticResource Ds.PanelTitle}" />
                        <ItemsControl ItemsSource="{Binding Stars}" ItemTemplate="{StaticResource Ds.StarRow}" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Ds.Panel}">
                    <StackPanel>
                        <TextBlock Text="میانگین امتیاز به تفکیک پزشک 👨‍⚕️" Style="{StaticResource Ds.PanelTitle}" />
                        <ItemsControl ItemsSource="{Binding DoctorRatings}" ItemTemplate="{StaticResource Ds.DoctorRow}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Ds.Panel}">
                    <StackPanel>
                        <TextBlock Text="نظرات آزاد اخیر 💬" Style="{StaticResource Ds.PanelTitle}" />
                        <ItemsControl ItemsSource="{Binding Comments}" ItemTemplate="{StaticResource Ds.CommentRow}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ══ نمای ۲: نتایج و آمار ══ -->
        <Grid Grid.Row="4" Style="{StaticResource Ds.ShowOnResults}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Ds.Panel}">
                    <StackPanel>
                        <TextBlock Text="توزیع امتیازها ⭐" Style="{StaticResource Ds.PanelTitle}" />
                        <ItemsControl ItemsSource="{Binding Stars}" ItemTemplate="{StaticResource Ds.StarRow}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Ds.Panel}">
                    <StackPanel>
                        <TextBlock Text="میانگین پزشکان 👨‍⚕️" Style="{StaticResource Ds.PanelTitle}" />
                        <ItemsControl ItemsSource="{Binding DoctorRatings}" ItemTemplate="{StaticResource Ds.DoctorRow}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Ds.Panel}">
                    <StackPanel>
                        <TextBlock Text="روند رضایت 📈" Style="{StaticResource Ds.PanelTitle}" />
                        <Grid Height="90">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom"><Border Height="38" Background="#93C5FD" CornerRadius="4,4,0,0" Margin="6,0" /></StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom"><Border Height="46" Background="#60A5FA" CornerRadius="4,4,0,0" Margin="6,0" /></StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom"><Border Height="52" Background="#3B82F6" CornerRadius="4,4,0,0" Margin="6,0" /></StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Bottom"><Border Height="60" Background="#2563EB" CornerRadius="4,4,0,0" Margin="6,0" /></StackPanel>
                            <StackPanel Grid.Column="4" VerticalAlignment="Bottom"><Border Height="68" Background="#1D4ED8" CornerRadius="4,4,0,0" Margin="6,0" /></StackPanel>
                            <StackPanel Grid.Column="5" VerticalAlignment="Bottom"><Border Height="78" Background="#0D9488" CornerRadius="4,4,0,0" Margin="6,0" /></StackPanel>
                        </Grid>
                        <TextBlock Text="فروردین ← شهریور ← مهر" Style="{StaticResource Ds.Muted}" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="9" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Ds.Panel}">
                <StackPanel>
                    <TextBlock Text="نظرات آزاد اخیر 💬" Style="{StaticResource Ds.PanelTitle}" />
                    <ItemsControl ItemsSource="{Binding Comments}" ItemTemplate="{StaticResource Ds.CommentRow}" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="5" Text="سهند کلینیکپرو — نظرسنجی بیماران · تحلیل پاسخها و رضایت · نسخهٔ ۲٫۲۸٫۲۸"
                   Style="{StaticResource Ds.Muted}" HorizontalAlignment="Center" Margin="0,5,0,0" />
    </Grid>
</UserControl>
