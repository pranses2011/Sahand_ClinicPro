<Window x:Class="Sahand.ClinicPro.Desktop.Views.AppointmentFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        Title="ثبت نوبت جدید"
        Height="640" Width="560"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!-- ═══════════════════════════════════════════════════════════
         فرم ثبت نوبت — گام V1
         جستجوی بیمار + پزشک + تاریخ/ساعت + نوع نوبت
         ═══════════════════════════════════════════════════════════ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="ثبت نوبت جدید" Style="{StaticResource SectionTitle}" />

            <!-- جستجوی بیمار -->
            <TextBox materialDesign:HintAssist.Hint="جستجوی بیمار: نام یا کد ملی یا موبایل *"
                     Text="{Binding PatientSearchTerm, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,8">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchPatientCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <!-- کارت بیمار انتخاب‌شده — چرخه بیستم (گزارش چهاردهم مالک):
                 وقتی فرم با بیمار از پیش انتخاب‌شده (از صفحهٔ بیماران) باز می‌شود،
                 مشخصاتش بدون نیاز به جستجو دیده می‌شود -->
            <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1"
                    CornerRadius="8" Padding="10,6" Margin="0,0,0,8"
                    Visibility="{Binding SelectedPatient, Converter={StaticResource NullToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AccountCheck" Width="16" Height="16"
                                             Foreground="#2E7D32" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedPatient.DisplayName, Mode=OneWay}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="8,0,0,0"  Foreground="#1F2937"/>
                    <TextBlock Text="{Binding SelectedPatient.Detail, Mode=OneWay}" FontSize="11"
                               Opacity="0.75" VerticalAlignment="Center" Margin="14,0,0,0"  Foreground="#1F2937"/>
                </StackPanel>
            </Border>
            <ListBox ItemsSource="{Binding PatientResults}"
                     SelectedItem="{Binding SelectedPatient}"
                     Height="130" Margin="0,0,0,12"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.75" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- پزشک -->
            <ComboBox materialDesign:HintAssist.Hint="پزشک *"
                      ItemsSource="{Binding Doctors}"
                      DisplayMemberPath="Name"
                      SelectedIndex="{Binding DoctorIndex}"
                      Margin="0,0,0,12" />

            <!-- تاریخ و ساعت — چرخه بیست‌وسوم (گزارش شانزدهم مالک): همهٔ فیلدهای تاریخ
                 باید از انتخابگر تاریخ شمسی و همهٔ فیلدهای ساعت از انتخابگر ساعت
                 استفاده کنند؛ پیش‌تر این دو فیلد TextBox تایپ دستی بودند -->
            <UniformGrid Columns="2" Margin="0,0,0,12">
                <controls:JalaliDatePicker DateShamsiText="{Binding DateShamsi, Mode=TwoWay}"
                                            Placeholder="تاریخ نوبت *"
                                            Margin="0,0,6,0" />
                <controls:TimePicker TimeText="{Binding Time, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalAlignment="Left" Margin="6,0,0,0" />
            </UniformGrid>

            <!-- نوع نوبت + اولویت — چرخهٔ ۷۹: انتخابگر اولویت (عادی/بالا/اورژانس)
                 به فرم کلاسیک هم اضافه شد؛ پیش‌تر فقط ویزارد نوبت‌دهی اولویت می‌فرستاد
                 و نوبت‌های این فرم همیشه «عادی» ثبت می‌شدند (گزارش مالک) -->
            <UniformGrid Columns="2" Margin="0,0,0,12">
                <ComboBox materialDesign:HintAssist.Hint="نوع نوبت"
                          SelectedIndex="{Binding TypeIndex}"
                          Margin="0,0,6,0">
                    <ComboBoxItem Content="اولیه" />
                    <ComboBoxItem Content="پیگیری" />
                    <ComboBoxItem Content="اورژانسی" />
                </ComboBox>
                <ComboBox materialDesign:HintAssist.Hint="اولویت"
                          ItemsSource="{Binding Priorities}"
                          SelectedIndex="{Binding PriorityIndex}"
                          Margin="6,0,0,0" />
            </UniformGrid>

            <CheckBox Content="نخستین مراجعه بیمار"
                      IsChecked="{Binding IsFirstVisit}"
                      Margin="0,0,0,12" />

            <TextBox materialDesign:HintAssist.Hint="یادداشت"
                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" AcceptsReturn="False"
                     Margin="0,0,0,16" />

            <!-- پیام خطا -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />

            <!-- دکمه‌ها -->
            <UniformGrid Columns="2">
                <Button Command="{Binding SaveCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Content="ثبت نوبت" Height="42" Margin="4" />
                <Button Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Content="انصراف" Height="42" Margin="4" />
            </UniformGrid>

            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </ScrollViewer>
</Window>