<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.AppointmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1080"
             FlowDirection="RightToLeft">
    <!-- ═══ نوبت‌دهی دو-تبی — گام U4 طبق پرامپت UI بخش ۲ (فرم ۸ و ۹) ═══ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ چرخهٔ ۴۴ (گزارش مالک: «ظاهر صفحه نوبت دهی رو خیلی حرفه ای تر و
             زیباتر بکن») — سربرگ گرادیانی برند؛ هم‌الگوی صفحهٔ پذیرش: نشان
             شیشه‌ای + عنوان/زیرعنوان + چیپ راهنمای جریان در گوشهٔ چپ فیزیکی ═══ -->
        <Border Grid.Row="0" CornerRadius="14" Padding="16,12" Margin="0,0,0,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#00897B" Offset="0" />
                    <GradientStop Color="#004D40" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.18" Color="#00352C" />
            </Border.Effect>
            <DockPanel>
                <!-- چیپ جریان کار — گوشهٔ چپ فیزیکی (RTL) -->
                <Border DockPanel.Dock="Left" CornerRadius="9" Padding="10,3" VerticalAlignment="Center"
                        Background="#26FFFFFF" BorderBrush="#59FFFFFF" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CalendarPlus" Width="12" Height="12" Foreground="White" VerticalAlignment="Center" />
                        <TextBlock Text="بیمار و پزشک ← زمان ← تأیید و ثبت" Foreground="White" FontSize="10.5"
                                   FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="23" VerticalAlignment="Center" Margin="0,0,12,0"
                            Background="#33FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1">
                        <materialDesign:PackIcon Kind="CalendarClock" Width="24" Height="24"
                                                 Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="نوبت‌دهی و تقویم" FontSize="18" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="رزرو نوبت با تقویم شمسی و اسلات‌های آزاد + مدیریت فهرست نوبت‌ها"
                                   FontSize="11" Foreground="#D9F2EE" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ چرخهٔ ۴۶ (گزارش مالک: چیدمان حرفه‌ای) — ردیف کارت آماری «وضعیت در
             یک نگاه» پیش از تب‌ها؛ هر عدد از مجموعه‌های زندهٔ صفحه می‌آید و با
             بارگذاری/پالایش خودکار تازه می‌شود (ObservableCollection هنگام
             افزودن/پاک‌سازی رویداد Count صادر می‌کند) ═══ -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">
            <!-- کارت ۱: نوبت‌های ثبت‌شدهٔ امروز -->
            <Border Style="{StaticResource App.StatCard}" Margin="0,0,6,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource App.StatIcon}"
                            Background="#E0F2F1" BorderBrush="#B2DFDB" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="CalendarCheck" Width="21" Height="21"
                                                 Foreground="#00695C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource App.StatValue}"
                                   Text="{Binding TodayAppointments.Count, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                        <TextBlock Style="{StaticResource App.StatLabel}" Text="نوبت‌های امروز" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- کارت ۲: درخواست‌های لیست انتظار (بدون زمان مشخص) -->
            <Border Style="{StaticResource App.StatCard}" Margin="6,0,6,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource App.StatIcon}"
                            Background="#FFF3E0" BorderBrush="#FFE0B2" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="AccountClock" Width="21" Height="21"
                                                 Foreground="#E65100" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource App.StatValue}" Foreground="#E65100"
                                   Text="{Binding Waitlist.Count, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                        <TextBlock Style="{StaticResource App.StatLabel}" Text="در لیست انتظار" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- کارت ۳: ظرفیت آزاد روز انتخاب‌شده در تقویم رزرو -->
            <Border Style="{StaticResource App.StatCard}" Margin="6,0,6,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource App.StatIcon}"
                            Background="#E8F5E9" BorderBrush="#C8E6C9" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="ClockPlusOutline" Width="21" Height="21"
                                                 Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource App.StatValue}"
                                   Text="{Binding Slots.Count, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                        <TextBlock Style="{StaticResource App.StatLabel}" Text="اسلات آزاد روز انتخابی" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- کارت ۴: نتیجهٔ فیلتر فعلی تب فهرست نوبت‌ها -->
            <Border Style="{StaticResource App.StatCard}" Margin="6,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource App.StatIcon}"
                            Background="#F3E5F5" BorderBrush="#E1BEE7" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="FormatListBulleted" Width="21" Height="21"
                                                 Foreground="#7B1FA2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource App.StatValue}"
                                   Text="{Binding Rows.Count, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                        <TextBlock Style="{StaticResource App.StatLabel}" Text="نتیجهٔ فهرست نوبت‌ها" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>

        <TabControl Grid.Row="2" Style="{StaticResource MaterialDesignTabControl}">
            <!-- ═══════════ تب ۱: رزرو نوبت ═══════════ -->
            <TabItem Header="رزرو نوبت جدید">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="4,8">
                        <Grid.RowDefinitions>
                            <!-- ═══ چرخهٔ ۷۶ — فرم مرحله‌ای: نوار گام + سه گام + ناوبری ═══ -->
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- ═══ چرخهٔ ۷۶ — نوار گام‌های ویزارد نوبت‌دهی ═══
                             گزارش مالک چرخهٔ ۷۴: «ورود اطلاعات و ثبت به‌صورت مرحله‌ای (Wizard)».
                             سه گام با دایرهٔ شماره و برچسب؛ وضعیت از WizardStep:
                             جاری = فیروزه‌ای برند، انجام‌شده = سبز، آینده = کم‌رنگ -->
                        <Grid Grid.Row="0" Margin="0,2,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- گام ۱ — بیمار و پزشک (راست)؛ همیشه جاری یا انجام‌شده است -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource App.WizardCircle}">
                                            <Setter Property="Background" Value="#2E7D32" />
                                            <Setter Property="BorderBrush" Value="#1B5E20" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WizardStep}" Value="0">
                                                    <Setter Property="Background" Value="#00897B" />
                                                    <Setter Property="BorderBrush" Value="#004D40" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="۱" Style="{StaticResource App.WizardNumber}" Foreground="White" />
                                </Border>
                                <TextBlock Text="بیمار و پزشک">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource App.WizardLabel}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WizardStep}" Value="0">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Setter Property="Foreground" Value="#00897B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- اتصال گام ۱ → ۲ -->
                            <Border Grid.Column="1">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource App.WizardLink}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WizardStep}" Value="1">
                                                <Setter Property="Background" Value="#2E7D32" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding WizardStep}" Value="2">
                                                <Setter Property="Background" Value="#2E7D32" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- گام ۲ — زمان نوبت -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource App.WizardCircle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WizardStep}" Value="1">
                                                    <Setter Property="Background" Value="#00897B" />
                                                    <Setter Property="BorderBrush" Value="#004D40" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding WizardStep}" Value="2">
                                                    <Setter Property="Background" Value="#2E7D32" />
                                                    <Setter Property="BorderBrush" Value="#1B5E20" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="۲">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource App.WizardNumber}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WizardStep}" Value="1">
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding WizardStep}" Value="2">
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="زمان نوبت (تقویم و ساعت)">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource App.WizardLabel}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WizardStep}" Value="1">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Setter Property="Foreground" Value="#00897B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- اتصال گام ۲ → ۳ -->
                            <Border Grid.Column="3">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource App.WizardLink}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WizardStep}" Value="2">
                                                <Setter Property="Background" Value="#2E7D32" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- گام ۳ — تأیید و ثبت (چپ) -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource App.WizardCircle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WizardStep}" Value="2">
                                                    <Setter Property="Background" Value="#00897B" />
                                                    <Setter Property="BorderBrush" Value="#004D40" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="۳">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource App.WizardNumber}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WizardStep}" Value="2">
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="تأیید و ثبت">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource App.WizardLabel}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WizardStep}" Value="2">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Setter Property="Foreground" Value="#00897B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!-- ═══ گام ۰ — بیمار و پزشک: جستجو + کارت پرونده ═══ -->
                        <StackPanel Grid.Row="1" Visibility="{Binding WizardStep, Converter={StaticResource SectionToVisibility}, ConverterParameter=0}">

                        <!-- جستجوی بیمار + پزشک -->
                        <Border CornerRadius="10" Padding="12,10" Margin="0,0,0,10"
                                Background="{DynamicResource MaterialDesign.Brush.Background}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="جستجوی بیمار (کد ملی / نام / موبایل)" FontSize="12" Opacity="0.7" Margin="2,0,2,4" />
                                    <TextBox Text="{Binding PatientSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="حداقل ۲ کاراکتر تایپ کنید…" />
                                    <!-- نتایج جستجو -->
                                    <ListBox ItemsSource="{Binding PatientSearchResults}"
                                             Visibility="{Binding PatientSearchResults.Count, Converter={StaticResource NullToVisibility}}"
                                             MaxHeight="140" Margin="0,6,0,0" BorderThickness="1">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SelectPatientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        HorizontalContentAlignment="Right">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Account" Width="16" Height="16" Opacity="0.6" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                                        <!-- چرخهٔ ۷۴: کد ملی با ارقام فارسی -->
                                                        <TextBlock Text="{Binding NationalCode, Converter={StaticResource PersianDigits}}" Opacity="0.6" FontFamily="{DynamicResource App.CodeFont}" Margin="12,0,0,0" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="پزشک" FontSize="12" Opacity="0.7" Margin="2,0,2,4" />
                                    <ComboBox ItemsSource="{Binding Doctors}"
                                              SelectedItem="{Binding SelectedDoctor}"
                                              DisplayMemberPath="Name" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- کارت بیمار انتخاب‌شده -->
                        <Border CornerRadius="10" Padding="12,8" Margin="0,0,0,10"
                                Background="#E3F2FD"
                                Visibility="{Binding SelectedPatient, Converter={StaticResource NullToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountCheck" Width="20" Height="20"
                                                         Foreground="#1565C0" VerticalAlignment="Center" />
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                                    <Run Text="{Binding SelectedPatient.FullName, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.75" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                                    <!-- چرخهٔ ۷۴: کد ملی با ارقام فارسی -->
                                    <Run Text="کد ملی: " /><Run Text="{Binding SelectedPatient.NationalCode, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                                </TextBlock>
                                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Opacity="0.75" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                                    <Run Text="بیمه: " /><Run Text="{Binding SelectedPatient.InsuranceName, Mode=OneWay, TargetNullValue=آزاد}" />
                                </TextBlock>
                                <Border Background="#FFEBEE" CornerRadius="8" Padding="8,2" Margin="16,0,0,0"
                                        Visibility="{Binding SelectedPatient.Allergies, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock FontSize="11" Foreground="#C62828">
                                        <Run Text="آلرژی: " /><Run Text="{Binding SelectedPatient.Allergies, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        </StackPanel><!-- پایان گام ۰ — بیمار و پزشک -->

                        <!-- ═══ گام ۱ — زمان: تقویم شمسی + اسلات‌های آزاد ═══ -->
                        <StackPanel Grid.Row="2" Visibility="{Binding WizardStep, Converter={StaticResource SectionToVisibility}, ConverterParameter=1}">

                        <!-- تقویم + اسلات‌ها — چرخه بیست‌ویکم: اسلات‌ها ستون راست را
                             کامل می‌گیرند و خلاصه به ردیف پایین منتقل شد -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- ستون تقویم — چرخهٔ ۷۴: سربرگ ماه/سال بیرونی حذف شد
                                 گزارش مالک: «چند تا تاریخ و عدد بصورت انگلیسی هستند» — عنوان
                                 «۷ / ۱۴۰۴» با ارقام لاتین بود؛ خود کنترل تقویم سربرگ فارسی
                                 (نام ماه + سال با ارقام فارسی) و فلش‌های ماه قبل/بعد و ناوبری
                                 ماه/سال داخلی دارد؛ دو ردیف دکمهٔ تکراری هم حذف شد و ناوبری
                                 داخلی تقویم با TwoWay بودن DisplayMonth/Year مستقیم VM را
                                 همگام می‌کند (بارگذاری نشانگرها با OnDisplayMonthChanged) -->
                            <Border Grid.Column="0" CornerRadius="10" Padding="10" Margin="0,0,10,0"
                                    Background="{DynamicResource MaterialDesign.Brush.Background}">
                                <StackPanel>
                                <controls:PersianCalendarControl Grid.Row="1"
                                    x:Name="Calendar"
                                    SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                    DisplayMonth="{Binding DisplayMonth, Mode=TwoWay}"
                                    DisplayYear="{Binding DisplayYear, Mode=TwoWay}"
                                    MarkedDates="{Binding MarkedDates, Mode=OneWay}"
                                    DisabledDates="{Binding DisabledDates, Mode=OneWay}"
                                    DayStats="{Binding DayStats, Mode=OneWay}"
                                    MonthStats="{Binding MonthStats, Mode=OneWay}"
                                    DateSelected="OnCalendarDateSelected" />
                                <TextBlock Text="{Binding CalendarInfo}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="#0F766E" TextWrapping="Wrap" Margin="2,8,2,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CalendarInfo}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding CalendarStatus}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="#B45309" TextWrapping="Wrap" Margin="2,8,2,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CalendarStatus}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                                </Border>

                            <!-- ستون اسلات‌ها — طرح تأییدشدهٔ مالک: کاشی‌های فشردهٔ گروه‌بندی‌شده
                                 (صبح/ظهر/عصر) با روبان مورب گوشه، هاشور رزرو/استراحت، آمار روز
                                 و نوار جزئیات بیمار (هاور موقت / کلیک = سنجاق)؛ بدون حق ویزیت -->
                            <Border Grid.Column="1" CornerRadius="10" Padding="12,10"
                                    Background="{DynamicResource MaterialDesign.Brush.Background}">
                                <Border.Resources>
                                    <!-- هاشور ۴۵ درجه برای اسلات‌های غیرآزاد -->
                                    <DrawingBrush x:Key="BookedHatch" TileMode="Tile" Viewport="0,0,7,7" ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing>
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="#33BE123C" Thickness="1.6" />
                                                </GeometryDrawing.Pen>
                                                <GeometryDrawing.Geometry>
                                                    <PathGeometry Figures="M0,7 L7,0" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                    <!-- هاشور خاکستری اسلات‌های گذشته (درخواست مالک) -->
                                    <DrawingBrush x:Key="PastHatch" TileMode="Tile" Viewport="0,0,7,7" ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing>
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="#4D94A3B8" Thickness="1.6" />
                                                </GeometryDrawing.Pen>
                                                <GeometryDrawing.Geometry>
                                                    <PathGeometry Figures="M0,7 L7,0" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                    <DrawingBrush x:Key="BreakHatch" TileMode="Tile" Viewport="0,0,7,7" ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing>
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="#40B45309" Thickness="1.6" />
                                                </GeometryDrawing.Pen>
                                                <GeometryDrawing.Geometry>
                                                    <PathGeometry Figures="M0,7 L7,0" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                    <!-- چیپ فیلتر -->
                                    <Style x:Key="SlotFilterChip" TargetType="Button">
                                        <Setter Property="Padding" Value="10,3" />
                                        <Setter Property="Margin" Value="0,0,5,0" />
                                        <Setter Property="FontSize" Value="10.5" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Background" Value="#ECEFF1" />
                                        <Setter Property="Foreground" Value="#37474F" />
                                        <Setter Property="BorderBrush" Value="#B0BEC5" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Border.Resources>
                                <StackPanel>
                                    <!-- سربرگ: عنوان + آمار روز + نوار پرشدن -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                            <Run Text="⏰ ساعت‌های " /><Run Text="{Binding SelectedDateShamsi, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                                        </TextBlock>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock FontSize="10.5" Foreground="#047857" FontWeight="Bold" Margin="8,0,0,0">
                                                <Run Text="آزاد " /><Run Text="{Binding FreeCount, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                                            </TextBlock>
                                            <TextBlock FontSize="10.5" Foreground="#BE123C" FontWeight="Bold" Margin="8,0,0,0">
                                                <Run Text="رزرو " /><Run Text="{Binding BookedCount, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                                            </TextBlock>
                                            <TextBlock FontSize="10.5" Foreground="#B45309" FontWeight="Bold" Margin="8,0,0,0">
                                                <Run Text="استراحت " /><Run Text="{Binding BreakCount, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="پرشدن روز" FontSize="9.5" Foreground="#78909C" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" Height="6" Margin="7,0" Minimum="0" Maximum="100"
                                                     Value="{Binding OccupancyPercent, Mode=OneWay}" Foreground="#F59E0B" Background="#ECEFF1" />
                                        <TextBlock Grid.Column="2" FontSize="9.5" Foreground="#78909C" VerticalAlignment="Center">
                                            <Run Text="{Binding OccupancyPercent, Mode=OneWay, Converter={StaticResource PersianDigits}}" /><Run Text="٪" />
                                        </TextBlock>
                                    </Grid>
                                    <!-- چیپ‌های فیلتر (بدون فیلتر استراحت — طبق طرح تأییدشده) -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                        <Button Content="همه" Command="{Binding SetSlotFilterCommand}" CommandParameter="all">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SlotFilterChip}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SlotFilter}" Value="all">
                                                            <Setter Property="Background" Value="#0F766E" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#0F766E" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="فقط آزادها" Command="{Binding SetSlotFilterCommand}" CommandParameter="free">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SlotFilterChip}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SlotFilter}" Value="free">
                                                            <Setter Property="Background" Value="#047857" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#047857" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="رزروشده‌ها" Command="{Binding SetSlotFilterCommand}" CommandParameter="booked">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SlotFilterChip}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SlotFilter}" Value="booked">
                                                            <Setter Property="Background" Value="#BE123C" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#BE123C" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding SlotGroups}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,8">
                                                            <!-- سرخط گروه صبح/ظهر/عصر -->
                                                            <Grid Margin="1,2,1,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="12" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11.5" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center" />
                                                                <Border Grid.Column="2" CornerRadius="7" Background="#ECEFF1" Padding="6,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Count, Converter={StaticResource PersianDigits}}" FontSize="9.5" Foreground="#546E7A" FontWeight="Bold" />
                                                                </Border>
                                                                <Border Grid.Column="3" Height="1" Background="#E0E7EB" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding Items}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <!-- کاشی فشردهٔ اسلات — قاب بیرونی بدون برش تا قاب
                                                                             متحرک سنجاق بتواند دور کارت (بیرون آن) بنشیند؛
                                                                             FlowDirection چپ‌به‌راست یعنی جای فیزیکی عناصر
                                                                             دقیقاً همانِ طرح است: روبان در گوشهٔ چپ (گزارش مالک:
                                                                             روبان سمت راست افتاده بود) -->
                                                                        <Grid Width="98" MinHeight="54" FlowDirection="LeftToRight">
                                                                        <Border x:Name="TileRoot" Width="92" MinHeight="48" Margin="3" CornerRadius="11"
                                                                                BorderThickness="1.5" Cursor="Hand" ClipToBounds="True"
                                                                                MouseEnter="OnSlotMouseEnter" MouseLeave="OnSlotMouseLeave"
                                                                                MouseLeftButtonUp="OnSlotMouseUp"
                                                                                ToolTip="{Binding PatientName, StringFormat='رزرو: {0}', TargetNullValue='برای رزرو کلیک کنید'}">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Background" Value="#E8F7EE" />
                                                                                    <Setter Property="BorderBrush" Value="#047857" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsBooked}" Value="True">
                                                                                            <Setter Property="Background" Value="#FDECEC" />
                                                                                            <Setter Property="BorderBrush" Value="#E7A6B4" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding IsBreak}" Value="True">
                                                                                            <Setter Property="Background" Value="#FEF3C7" />
                                                                                            <Setter Property="BorderBrush" Value="#D9A441" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                                                            <Setter Property="Background" Value="#F1F5F9" />
                                                                                            <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                                                            <Setter Property="Opacity" Value="0.75" />
                                                                                            <Setter Property="Cursor" Value="Arrow" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                            <Setter Property="Background" Value="#1565C0" />
                                                                                            <Setter Property="BorderBrush" Value="#0D47A1" />
                                                                                            <Setter Property="BorderThickness" Value="2.2" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <Grid>
                                                                                <!-- هاشور -->
                                                                                <Border Background="{StaticResource BookedHatch}" CornerRadius="11">
                                                                                    <Border.Style>
                                                                                        <Style TargetType="Border">
                                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsBooked}" Value="True">
                                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Border.Style>
                                                                                </Border>
                                                                                <Border Background="{StaticResource PastHatch}" CornerRadius="11">
                                                                                    <Border.Style>
                                                                                        <Style TargetType="Border">
                                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Border.Style>
                                                                                </Border>
                                                                                <Border Background="{StaticResource BreakHatch}" CornerRadius="11">
                                                                                    <Border.Style>
                                                                                        <Style TargetType="Border">
                                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsBreak}" Value="True">
                                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Border.Style>
                                                                                </Border>
                                                                                <!-- متن کاشی -->
                                                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,7,2,5">
                                                                                    <TextBlock Text="{Binding Time, Converter={StaticResource PersianDigits}}"
                                                                                               FontFamily="{DynamicResource App.CodeFont}" FontSize="14" FontWeight="Bold"
                                                                                               HorizontalAlignment="Center">
                                                                                        <TextBlock.Style>
                                                                                            <Style TargetType="TextBlock">
                                                                                                <Setter Property="Foreground" Value="#065F46" />
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding IsBooked}" Value="True">
                                                                                                        <Setter Property="Foreground" Value="#9F1239" />
                                                                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                                                    </DataTrigger>
                                                                                                    <DataTrigger Binding="{Binding IsBreak}" Value="True">
                                                                                                        <Setter Property="Foreground" Value="#92400E" />
                                                                                                    </DataTrigger>
                                                                                                    <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                                                                    </DataTrigger>
                                                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                                        <Setter Property="Foreground" Value="White" />
                                                                                                        <Setter Property="TextDecorations" Value="None" />
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </TextBlock.Style>
                                                                                    </TextBlock>
                                                                                    <TextBlock Text="{Binding SubText, Converter={StaticResource PersianDigits}}" FontSize="9"
                                                                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="84">
                                                                                        <TextBlock.Style>
                                                                                            <Style TargetType="TextBlock">
                                                                                                <Setter Property="Foreground" Value="#2F7D5B" />
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding IsBooked}" Value="True">
                                                                                                        <Setter Property="Foreground" Value="#9F1239" />
                                                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                                                    </DataTrigger>
                                                                                                    <DataTrigger Binding="{Binding IsBreak}" Value="True">
                                                                                                        <Setter Property="Foreground" Value="#92400E" />
                                                                                                    </DataTrigger>
                                                                                                    <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                                                                    </DataTrigger>
                                                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                                        <Setter Property="Foreground" Value="#DCEEFF" />
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </TextBlock.Style>
                                                                                    </TextBlock>
                                                                                </StackPanel>
                                                                                <!-- روبان مورب ۴۵ درجه در گوشهٔ کاشی -->
                                                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Width="86"
                                                                                        Margin="-30,11,0,0" Padding="0,1.5" CornerRadius="0"
                                                                                        RenderTransformOrigin="0.5,0.5">
                                                                                    <Border.RenderTransform>
                                                                                        <RotateTransform Angle="-45" />
                                                                                    </Border.RenderTransform>
                                                                                    <Border.Style>
                                                                                        <Style TargetType="Border">
                                                                                            <Setter Property="Background" Value="#047857" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsBooked}" Value="True">
                                                                                                    <Setter Property="Background" Value="#BE123C" />
                                                                                                </DataTrigger>
                                                                                                <DataTrigger Binding="{Binding IsBreak}" Value="True">
                                                                                                    <Setter Property="Background" Value="#B45309" />
                                                                                                </DataTrigger>
                                                                                                <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                                                                    <Setter Property="Background" Value="#94A3B8" />
                                                                                                </DataTrigger>
                                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                                    <Setter Property="Background" Value="#FACC15" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Border.Style>
                                                                                    <TextBlock Text="{Binding RibbonText}" FontSize="7.8" FontWeight="Bold"
                                                                                               HorizontalAlignment="Center" TextAlignment="Center">
                                                                                        <TextBlock.Style>
                                                                                            <Style TargetType="TextBlock">
                                                                                                <Setter Property="Foreground" Value="White" />
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                                        <Setter Property="Foreground" Value="#3F3003" />
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </TextBlock.Style>
                                                                                    </TextBlock>
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                        <!-- قاب متحرک اسلات سنجاق‌شده — دورِ کارت و بیرون
                                                                             مرز آن (گزارش مالک: انیمیشن داخل کارت می‌افتاد)؛
                                                                             گرادیان خانوادهٔ قرمز روی قاب می‌چرخد -->
                                                                        <Border CornerRadius="14" BorderThickness="2.8" IsHitTestVisible="False"
                                                                                Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}">
                                                                            <Border.BorderBrush>
                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                                    <GradientStop Color="#881337" Offset="0" />
                                                                                    <GradientStop Color="#F43F5E" Offset="0.5" />
                                                                                    <GradientStop Color="#FDA4AF" Offset="1" />
                                                                                </LinearGradientBrush>
                                                                            </Border.BorderBrush>
                                                                            <Border.Effect>
                                                                                <DropShadowEffect BlurRadius="9" ShadowDepth="0" Opacity="0.55" Color="#F43F5E" />
                                                                            </Border.Effect>
                                                                            <Border.Triggers>
                                                                                <EventTrigger RoutedEvent="Border.Loaded">
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard RepeatBehavior="Forever">
                                                                                            <PointAnimation Storyboard.TargetProperty="(Border.BorderBrush).(LinearGradientBrush.StartPoint)"
                                                                                                            From="0,0" To="1,1" Duration="0:0:2.8" AutoReverse="True" />
                                                                                            <PointAnimation Storyboard.TargetProperty="(Border.BorderBrush).(LinearGradientBrush.EndPoint)"
                                                                                                            From="1,1" To="0,0" Duration="0:0:2.8" AutoReverse="True" />
                                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.7" To="1" Duration="0:0:1.4" AutoReverse="True" />
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </EventTrigger>
                                                                            </Border.Triggers>
                                                                        </Border>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- راهنمای فیلتر خالی -->
                                            <Border BorderBrush="#B0BEC5" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="2,4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FilteredCount}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="در این فیلتر ساعتی نیست — فیلتر «همه» را بزنید." FontSize="10.5" Foreground="#78909C" HorizontalAlignment="Center" />
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- نوار جزئیات بیمار: هاور = موقت، کلیک = سنجاق؛ خروج موس برمی‌گردد به سنجاق‌شده -->
                                    <Border CornerRadius="9" Padding="10,7" Margin="0,8,0,0" BorderThickness="1.2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FAFAFA" />
                                                <Setter Property="BorderBrush" Value="#CFD8DC" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DetailSlot, Converter={StaticResource NullToVisibility}}" Value="Visible">
                                                        <Setter Property="Background" Value="#FFF5F6" />
                                                        <Setter Property="BorderBrush" Value="#F3B7C4" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <TextBlock FontSize="10.5" Foreground="#90A4AE" VerticalAlignment="Center"
                                                       Text="👤 برای دیدن جزئیات بیمار، موس را روی ساعت رزروشده نگه دارید — با کلیک، جزئیات سنجاق می‌شود."
                                                       Visibility="{Binding DetailSlot, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" />
                                            <Grid Visibility="{Binding DetailSlot, Converter={StaticResource NullToVisibility}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Margin="0,0,9,0"
                                                        Background="#FCE7F3" BorderBrush="#F9A8D4" BorderThickness="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DetailSlot.GenderIcon}" FontSize="17"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DetailSlot.PatientName}" FontSize="12" FontWeight="Bold" Foreground="#7F1D2D" />
                                                        <TextBlock FontSize="10.5" Foreground="#9F1239" Margin="7,0,0,0" VerticalAlignment="Center">
                                                            <Run Text="🕐 " /><Run Text="{Binding DetailSlot.Time, Converter={StaticResource PersianDigits}}" />
                                                            <Run Text=" • " /><Run Text="{Binding DetailSlot.RoomName, TargetNullValue='—'}" />
                                                        </TextBlock>
                                                        <Border CornerRadius="7" Background="#BE123C" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding DetailSlot.IsPinned, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="📌 سنجاق شده" FontSize="9" Foreground="White" FontWeight="Bold" />
                                                        </Border>
                                                    </StackPanel>
                                                    <!-- جزئیات در یک ردیف پخش‌شده در تمام عرض -->
                                                    <Grid Margin="0,5,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" FontSize="10.5" Foreground="#57122A" HorizontalAlignment="Left">
                                                            <Run Text="🎂 " /><Run Text="{Binding DetailSlot.PatientAge, Converter={StaticResource PersianDigits}, TargetNullValue='—'}" /><Run Text=" ساله" />
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="1" FontSize="10.5" Foreground="#57122A" HorizontalAlignment="Center">
                                                            <Run Text="🛡️ " /><Run Text="{Binding DetailSlot.PatientInsurance, TargetNullValue='—'}" />
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="2" FontSize="10.5" Foreground="#57122A" HorizontalAlignment="Center">
                                                            <Run Text="🆔 " /><Run Text="{Binding DetailSlot.PatientNationalCode, Converter={StaticResource PersianDigits}, TargetNullValue='—'}" />
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="3" FontSize="10.5" Foreground="#57122A" HorizontalAlignment="Right" FontWeight="Bold">
                                                            <Run Text="📱 " /><Run Text="{Binding DetailSlot.PatientPhone, Converter={StaticResource PersianDigits}, TargetNullValue='—'}" />
                                                        </TextBlock>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- راهنمای رنگ — چیپ‌ها عین رنگ کاشی‌ها -->
                                    <WrapPanel Margin="2,10,2,0">
                                        <WrapPanel.Resources>
                                            <Style x:Key="LegendChip" TargetType="Border">
                                                <Setter Property="Width" Value="16" />
                                                <Setter Property="Height" Value="16" />
                                                <Setter Property="CornerRadius" Value="4" />
                                                <Setter Property="BorderThickness" Value="1.4" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Margin" Value="0,0,5,0" />
                                            </Style>
                                            <Style x:Key="LegendLabel" TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="11" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Margin" Value="0,0,12,2" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Style>
                                        </WrapPanel.Resources>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2" ToolTip="اسلات فعال برای رزرو نوبت">
                                            <Border Style="{StaticResource LegendChip}" Background="#E8F7EE" BorderBrush="#047857" />
                                            <TextBlock Style="{StaticResource LegendLabel}" Text="آزاد" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2" ToolTip="زمان استراحت پزشک">
                                            <Border Style="{StaticResource LegendChip}" Background="#FEF3C7" BorderBrush="#B45309" />
                                            <TextBlock Style="{StaticResource LegendLabel}" Text="استراحت" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2" ToolTip="اسلاتی که انتخاب کرده‌اید">
                                            <Border Style="{StaticResource LegendChip}" Background="#1565C0" BorderBrush="#0D47A1" BorderThickness="2" />
                                            <TextBlock Style="{StaticResource LegendLabel}" Text="انتخاب شما" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2" ToolTip="قبلاً رزرو شده — جزئیات با هاور/کلیک در نوار پایین">
                                            <Border Style="{StaticResource LegendChip}" Background="#FDECEC" BorderBrush="#BE123C" />
                                            <TextBlock Style="{StaticResource LegendLabel}" Text="رزرو شده" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2" ToolTip="ساعتش گذشته و قابل رزرو نیست">
                                            <Border Style="{StaticResource LegendChip}" Background="#F1F5F9" BorderBrush="#94A3B8" />
                                            <TextBlock Style="{StaticResource LegendLabel}" Text="گذشته" />
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        </StackPanel><!-- پایان گام ۱ — زمان -->

                        <!-- ═══ گام ۲ — تأیید و ثبت: خلاصه + نوع/اولویت/یادداشت + دکمه ═══ -->
                        <StackPanel Grid.Row="3" Visibility="{Binding WizardStep, Converter={StaticResource SectionToVisibility}, ConverterParameter=2}">

                        <!-- ═══ خلاصه و ثبت — چرخه بیست‌ویکم: تمام‌عرض در ردیف مستقل ═══ -->
                        <Border CornerRadius="10" Padding="12,10" Margin="0,0,0,0"
                                Background="#E8F5E9">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- خلاصه انتخاب -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="تاریخ" FontSize="10" Opacity="0.6"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                        <TextBlock Text="{Binding SelectedDateShamsi, Mode=OneWay, Converter={StaticResource PersianDigits}}" FontWeight="Bold"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                        <TextBlock Text="⏰ ساعت" FontSize="10" Opacity="0.6"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                        <TextBlock Text="{Binding SelectedSlot.Time, Mode=OneWay, TargetNullValue=—, Converter={StaticResource PersianDigits}}" FontWeight="Bold"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                        <TextBlock Text="اتاق" FontSize="10" Opacity="0.6"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                        <TextBlock Text="{Binding SelectedRoom, Mode=OneWay, TargetNullValue=—}" FontWeight="Bold"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Left">
                                        <TextBlock FontSize="10" Opacity="0.6" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"><Run Text="تخمین هزینه (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock>
                                        <TextBlock Text="{Binding EstimatedFee, Mode=OneWay, Converter={StaticResource CurrencyRial}}" FontWeight="Bold" FontFamily="{DynamicResource App.CodeFont}"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- نوع و اولویت و یادداشت -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.4*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="نوع ویزیت" FontSize="11" Opacity="0.7"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                        <ComboBox ItemsSource="{Binding VisitTypes}" SelectedIndex="{Binding SelectedTypeIndex}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="اولویت" FontSize="11" Opacity="0.7"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                        <ComboBox ItemsSource="{Binding Priorities}" SelectedIndex="{Binding SelectedPriorityIndex}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="یادداشت" FontSize="11" Opacity="0.7"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <!-- دکمه ثبت -->
                                <Button Grid.Row="2" Command="{Binding BookCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#2E7D32" BorderBrush="#2E7D32"
                                        Height="42" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CheckCircle" Width="18" Height="18" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                        <TextBlock Text="تایید و ثبت نوبت" Margin="10,0,0,0" FontSize="14" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        </StackPanel><!-- پایان گام ۲ — تأیید و ثبت -->

                        <!-- ═══ ناوبری ویزارد — چرخهٔ ۷۶ ═══
                             «مرحلهٔ بعد» در سمت چپ (جهت پیشرفت در چیدمان راست‌به‌چپ)
                             و در گام آخر مخفی؛ «مرحلهٔ قبل» در سمت راست و در گام نخست مخفی -->
                        <DockPanel Grid.Row="4" Margin="0,14,0,0" LastChildFill="False">
                            <Button DockPanel.Dock="Left" Command="{Binding NextStepCommand}"
                                    FontSize="13" Padding="22,10" MinWidth="170" MinHeight="44">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WizardStep}" Value="2">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="مرحلهٔ بعد" VerticalAlignment="Center" />
                                    <materialDesign:PackIcon Kind="ArrowLeftBold" Width="16" Height="16"
                                                             VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button DockPanel.Dock="Right" Command="{Binding BackStepCommand}"
                                    FontSize="13" Padding="18,10" MinWidth="140" MinHeight="44">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WizardStep}" Value="1">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding WizardStep}" Value="2">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ArrowRightBold" Width="16" Height="16"
                                                             VerticalAlignment="Center" />
                                    <TextBlock Text="مرحلهٔ قبل" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════ تب ۲: فهرست نوبت‌ها ═══════════ -->
            <TabItem Header="فهرست نوبت‌ها">
                <Grid Margin="4,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- فیلترها — چرخه بیست‌ویکم: از/تا تاریخ با انتخابگر تاریخ شمسی
                         (گزارش پانزدهم مالک: «در فهرست نوبت‌ها فیلتر از تاریخ تا تاریخ رو
                         با کنترل انتخابگر تاریخ بزار») -->
                    <Border Grid.Row="0" CornerRadius="10" Padding="10,8" Margin="0,0,0,10"
                            Background="{DynamicResource MaterialDesign.Brush.Background}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="از تاریخ" FontSize="10" Opacity="0.6" Margin="2,0,2,2" />
                                <!-- چرخهٔ ۷۹: عرض ۱۷۵ — تاریخ کامل «۱۴۰۴/۰۴/۳۱» بدون بریدگی دیده می‌شود
                                     (گزارش مالک: «انتخابگر تاریخ تاریخ را بصورت کامل نشان نمی‌دهد») -->
                                <controls:JalaliDatePicker Width="175"
                                                            DateShamsiText="{Binding FromDateShamsi, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="تا تاریخ" FontSize="10" Opacity="0.6" Margin="2,0,2,2" />
                                <controls:JalaliDatePicker Width="175"
                                                            DateShamsiText="{Binding ToDateShamsi, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="جستجو (نام/کدملی/موبایل/کد)" FontSize="10" Opacity="0.6" />
                                <!-- چرخه بیست‌وسوم: Enter = دکمهٔ جستجو -->
                                <TextBox Text="{Binding ListSearch, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SearchListCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="پزشک" FontSize="10" Opacity="0.6" />
                                <ComboBox ItemsSource="{Binding Doctors}" SelectedIndex="{Binding DoctorFilterIndex}" DisplayMemberPath="Name" MinWidth="120" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Margin="0,0,8,0">
                                <TextBlock Text="وضعیت" FontSize="10" Opacity="0.6" />
                                <ComboBox SelectedIndex="{Binding StatusFilterIndex}" MinWidth="100">
                                    <ComboBoxItem Content="همه" />
                                    <ComboBoxItem Content="رزرو شده" />
                                    <ComboBoxItem Content="تأیید شده" />
                                    <ComboBoxItem Content="حاضر" />
                                    <ComboBoxItem Content="در حال ویزیت" />
                                    <ComboBoxItem Content="تکمیل شده" />
                                    <ComboBoxItem Content="لغو شده" />
                                    <ComboBoxItem Content="عدم مراجعه" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="5" Margin="0,0,8,0">
                                <TextBlock Text="نوع" FontSize="10" Opacity="0.6" />
                                <ComboBox SelectedIndex="{Binding TypeFilterIndex}" MinWidth="90">
                                    <ComboBoxItem Content="همه" />
                                    <ComboBoxItem Content="اولیه" />
                                    <ComboBoxItem Content="پیگیری" />
                                    <ComboBoxItem Content="اورژانس" />
                                    <ComboBoxItem Content="مشاوره" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="6" Margin="0,0,8,0">
                                <TextBlock Text="منبع" FontSize="10" Opacity="0.6" />
                                <ComboBox SelectedIndex="{Binding SourceFilterIndex}" MinWidth="85">
                                    <ComboBoxItem Content="همه" />
                                    <ComboBoxItem Content="حضوری" />
                                    <ComboBoxItem Content="تلفنی" />
                                    <ComboBoxItem Content="آنلاین" />
                                </ComboBox>
                            </StackPanel>
                            <Button Grid.Column="7" Command="{Binding SearchListCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Magnify" Width="15" Height="15" VerticalAlignment="Center" />
                                    <TextBlock Text="جستجو" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ═══ چرخهٔ ۷۴ — راهنمای مرتب‌سازی چندگانه + جدول ═══
                         گزارش مالک: «بتونم مرتب سازی چندگانه هم انجام بدم (مثلاً وقتی روی
                         عنوان ستون تاریخ میزنم مرتب می‌شود ولی نمی‌توانم همزمان بر اساس
                         ساعت و وضعیت هم مرتب کنم)». الگو: کلیک = مرتب‌سازی تک‌ستونه
                         (صعودی → نزولی → حذف)؛ Shift+کلیک = افزودن ستون به مرتب‌سازی
                         ترکیبی (اولویت از راست به چپ). پیکان‌های هدر ستون‌ها فعال می‌مانند
                         و مرتب‌سازی پس از هر جستجوی جدید هم حفظ می‌شود. -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Command="{Binding SendRemindersCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MessageText" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="ارسال SMS یادآوری (نوبت‌های فردا)" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding BatchCancelCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#C62828">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CloseCircleOutline" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="لغو دسته‌ای انتخاب‌شده‌ها" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Border Background="#E3F2FD" CornerRadius="8" Padding="8,3" Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="SortVariant" Width="13" Height="13" Foreground="#1565C0"
                                                         VerticalAlignment="Center" />
                                <TextBlock FontSize="10.5" Foreground="#1565C0" Margin="5,0,0,0" VerticalAlignment="Center"
                                           Text="مرتب‌سازی چندگانه: هنگام کلیک روی عنوان ستون، Shift را نگه دارید تا آن ستون به مرتب‌سازی اضافه شود؛ کلیک ساده = مرتب‌سازی تک‌ستونه" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- جدول ۱۲ ستونه -->
                    <DataGrid Grid.Row="2"
                              x:Name="AppointmentsGrid"
                              ItemsSource="{Binding Rows}"
                              SelectedItem="{Binding SelectedRow}"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                             
                              MinRowHeight="30"
                              FontSize="12">
                        <DataGrid.Columns>
                            <!-- ═══ چرخهٔ ۷۹ — قانون عرض ستون از «عنوان و محتوای سلول» ═══
                                 گزارش مالک: «عناوین بعضی ستون‌ها مشخص نیست» — عرض‌های پیکسلی ثابت
                                 جمعشون ۱۱۱۱px بود (بیشتر از فضای موجود) و هدرها بی‌سروصدا
                                 بریده می‌شدند؛ الگوی مرجع لیست بیماران اعمال شد:
                                 Width=Auto + سقف ۴۲۰ + پیچش چندخطی تا عنوان/محتوا بریده نشود -->
                            <DataGridCheckBoxColumn Header="" Width="Auto" MinWidth="36"
                                Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" MaxWidth="420" />
                            <DataGridTextColumn Header="کد پیگیری" Width="Auto" MinWidth="100"
                                Binding="{Binding Code, TargetNullValue=—, Converter={StaticResource PersianDigits}}" FontFamily="{DynamicResource App.CodeFont}" MaxWidth="420"  ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="تاریخ" Width="Auto" MinWidth="98" Binding="{Binding DateShamsi, Converter={StaticResource PersianDigits}}" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="ساعت" Width="Auto" MinWidth="62" Binding="{Binding Time, Converter={StaticResource PersianDigits}}" FontFamily="{DynamicResource App.CodeFont}" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTemplateColumn Header="بیمار" Width="Auto" MinWidth="140" SortMemberPath="PatientName" MaxWidth="420">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Account" Width="14" Height="14" Opacity="0.5" VerticalAlignment="Center" />
                                            <StackPanel Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding PatientMobile, TargetNullValue='', Converter={StaticResource PersianDigits}}" FontSize="10" Opacity="0.55" FontFamily="{DynamicResource App.CodeFont}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="پزشک" Width="Auto" MinWidth="110" Binding="{Binding DoctorName, Converter={StaticResource PersianDigits}}" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="تخصص" Width="Auto" MinWidth="90" Binding="{Binding SpecialtyName, TargetNullValue=—, Converter={StaticResource PersianDigits}}" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="نوع" Width="Auto" MinWidth="70" Binding="{Binding TypeText, Converter={StaticResource PersianDigits}}" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <!-- ═══ چرخهٔ ۷۵ — ستون اولویت با رنگ خودش ═══
                                 گزارش مالک: «اولویت در لیست نیست؛ اولویت رو هم با رنگ
                                 خودش در لیست نشون بده» — قرمز اورژانس / نارنجی فوری /
                                 خاکستری معمولی؛ هم‌الگوی بج وضعیت -->
                            <DataGridTemplateColumn Header="اولویت" Width="Auto" MinWidth="82" SortMemberPath="PriorityText" MaxWidth="420">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Center"
                                                Background="{Binding PriorityColor, Converter={StaticResource HexToBrush}}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PriorityText, Converter={StaticResource PersianDigits}}"
                                                       FontSize="10.5" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="وضعیت" Width="Auto" MinWidth="95" SortMemberPath="Status" MaxWidth="420">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="9,2" HorizontalAlignment="Center"
                                                Background="{Binding StatusColor}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="منبع" Width="Auto" MinWidth="70" Binding="{Binding SourceText, Converter={StaticResource PersianDigits}}" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTemplateColumn Header="عملیات" Width="Auto" MinWidth="130" MaxWidth="420">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Command="{Binding DataContext.ConfirmArrivalCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource App.RowIconButton}"
                                                    ToolTip="تأیید حضور" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="AccountCheck" Width="15" Height="15" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.CancelOneCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource App.RowIconButton}"
                                                    ToolTip="لغو نوبت" Foreground="#C62828" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="CloseCircleOutline" Width="15" Height="15" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <controls:PaginationBar Grid.Row="3"
                                            PageNumber="{Binding PageNumber, Mode=TwoWay}"
                                            TotalPages="{Binding TotalPages, Mode=OneWay}"
                                            TotalCount="{Binding TotalCount, Mode=OneWay}"
                                            PageSize="{Binding PageSize, Mode=TwoWay}"
                                            PageChangedCommand="{Binding PageChangedCommand}" />
                </Grid>
            </TabItem>

            <!-- ═══ تب لیست انتظار — چرخه ۱۳ (درخواست ۳-۴) ═══ -->
            <TabItem Header="لیست انتظار">
                <Grid Margin="4,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- فرم افزودن به لیست انتظار -->
                    <Border Grid.Row="0" CornerRadius="10" Padding="12,10" Margin="0,0,0,10"
                            Background="{DynamicResource MaterialDesign.Brush.Background}" BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="افزودن بیمار به لیست انتظار" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                            <WrapPanel>
                                <TextBox Text="{Binding WaitlistPatientSearch, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="جستجوی بیمار (نام/کد ملی/موبایل)"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Width="240" FontSize="12" Margin="0,0,8,6">
                                    <!-- چرخه بیست‌وسوم: Enter = دکمهٔ جستجو -->
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding WaitlistPatientSearchCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Command="{Binding WaitlistPatientSearchCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                        FontSize="11" Margin="0,0,8,6" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Magnify" Width="14" Height="14"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                </Button>
                                <TextBlock Text="{Binding WaitlistPatient.FullName, Mode=OneWay, TargetNullValue='— بیماری انتخاب نشده —'}"
                                           FontWeight="SemiBold" Foreground="#1565C0" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,10,6" />
                                <ComboBox SelectedIndex="{Binding WaitlistDoctorIndex}" Width="190" FontSize="11.5" Margin="0,0,8,6"
                                          ItemsSource="{Binding Doctors}" DisplayMemberPath="Name"
                                          materialDesign:HintAssist.Hint="پزشک دلخواه (خالی = هر پزشک)" />
                                <!-- چرخه بیست‌وسوم: جایگزینی DatePicker میلادی ویندوز با
                                     انتخابگر تاریخ شمسی (قابل «همهٔ فیلدهای تاریخ»)؛
                                     چرخهٔ ۷۹: عرض ۱۷۵ برای نمایش کامل تاریخ بدون بریدگی -->
                                <controls:JalaliDatePicker SelectedDate="{Binding WaitlistFromDate}"
                                                            Placeholder="از تاریخ" Width="175" Margin="0,0,8,6" />
                                <controls:JalaliDatePicker SelectedDate="{Binding WaitlistToDate}"
                                                            Placeholder="تا تاریخ" Width="175" Margin="0,0,8,6" />
                                <ComboBox SelectedIndex="{Binding WaitlistTimeIndex}" Width="105" FontSize="11.5" Margin="0,0,8,6" materialDesign:HintAssist.Hint="ساعت پیشنهادی">
                                    <ComboBoxItem Content="هر ساعت" />
                                    <ComboBoxItem Content="صبح" />
                                    <ComboBoxItem Content="عصر" />
                                    <ComboBoxItem Content="شب" />
                                </ComboBox>
                                <!-- چرخهٔ ۷۹: واژگان یکدست «عادی/بالا/اورژانس» (پیش‌تر معمولی/فوری بود
                                     و با ستون اولویت فهرست‌ها یکسان نبود) -->
                                <ComboBox SelectedIndex="{Binding WaitlistPriorityIndex}" Width="105" FontSize="11.5" Margin="0,0,8,6" materialDesign:HintAssist.Hint="اولویت">
                                    <ComboBoxItem Content="عادی" />
                                    <ComboBoxItem Content="بالا" />
                                    <ComboBoxItem Content="اورژانس" />
                                </ComboBox>
                                <Button Command="{Binding AddToWaitlistCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                        FontSize="11.5" Margin="0,0,8,6" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="13" Height="13" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                        <TextBlock Text="ثبت در لیست" Margin="6,0,0,0" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding LoadWaitlistCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                        FontSize="11" Margin="0,0,0,6" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Refresh" Width="13" Height="13"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                </Button>
                            </WrapPanel>
                            <TextBox Text="{Binding WaitlistNotes, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="یادداشت (اختیاری)"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Width="440" FontSize="11.5" HorizontalAlignment="Left" />
                            <!-- نتایج جستجو -->
                            <ListBox ItemsSource="{Binding WaitlistPatientResults}" Visibility="{Binding WaitlistPatientResults.Count, Converter={StaticResource NullToVisibility}}"
                                     MaxHeight="130" Margin="0,8,0,0" FontSize="11.5" BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectWaitlistPatientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}"
                                                HorizontalContentAlignment="Right" FontSize="11.5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                                <TextBlock Text="{Binding NationalCode, Converter={StaticResource PersianDigits}}" Opacity="0.55" Margin="12,0,0,0" FontFamily="{DynamicResource App.CodeFont}"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                                <TextBlock Text="{Binding Mobile, Converter={StaticResource PersianDigits}}" Opacity="0.55" Margin="12,0,0,0"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- جدول لیست انتظار -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Waitlist}" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                              FlowDirection="RightToLeft">
                        <DataGrid.Columns>
                            <!-- ═══ چرخهٔ ۷۹ — قانون عرض ستون از «عنوان و محتوای سلول» (الگوی لیست بیماران) ═══ -->
                            <DataGridTextColumn Header="بیمار" Binding="{Binding PatientName, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="130" FontWeight="SemiBold" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="موبایل" Binding="{Binding PatientMobile, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="105" FontFamily="{DynamicResource App.CodeFont}" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="پزشک/تخصص" Binding="{Binding DoctorName, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="110" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="بازه دلخواه" Binding="{Binding PreferredText, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="190" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="اولویت" Binding="{Binding PriorityText, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="80" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="105" MaxWidth="420">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource App.TableCellTextBlock}">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="زمان پیامک" Binding="{Binding NotifiedText, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="110" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="یادداشت" Binding="{Binding Notes, TargetNullValue=—, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="130" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <!-- چرخهٔ ۷۹: کلید عملیاتی آیکونی (هم‌الگوی لیست بیماران و فهرست
                                 نوبت‌ها — درخواست مالک: «تمامی کلیدهای عملیاتی لیست‌ها آیکونی باشند») -->
                            <DataGridTemplateColumn Header="عملیات" Width="Auto" MinWidth="70" MaxWidth="420">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.CancelWaitlistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource App.RowIconButton}"
                                                Foreground="#C62828" ToolTip="حذف از لیست انتظار" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="15" Height="15" VerticalAlignment="Center"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
