<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.LicenseStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="680" d:DesignWidth="860"
             FlowDirection="RightToLeft"
             FontFamily="pack://application:,,,/Assets/Fonts/#Vazirmatn">
    <!-- ═══ وضعیت لایسنس — گام U19 طبق فرم ۳۱ ═══
         چرخه هجدهم (گزارش دوازدهم مالک):
         + فیلد «سرور لایسنس» پیش‌فرض/قابل‌ویرایش (license/settings)
         + دکمهٔ دریافت فایل درخواست آفلاین (.req)
         + چیپس ماژول‌ها با نام ماژول + رنگ سبز در حالت فعال
         + کارت پشتیبانی همیشه با محتوا (پیش‌فرض/پنل/ذخیره‌شده) -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <materialDesign:PackIcon Kind="KeyChain" Width="26" Height="26"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
            <TextBlock Text="وضعیت لایسنس" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
            <Button Command="{Binding LoadCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="14,0,0,0"
                    ToolTip="بررسی آنلاین">
                <materialDesign:PackIcon Kind="CloudSearch" Width="14" Height="14" />
            </Button>
        </StackPanel>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="2">
            <!-- چرخه ۱۹ (گزارش سیزدهم مالک): در RTL مقدار Right یعنی سمت چپِ بصری —
                      ستون به کل عرض صفحه گسترش می‌یابد (Stretch) تا محتوا تمام‌صفحه دیده شود -->
            <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Margin="4,4">

                <!-- ─── سرور لایسنس — چرخه هجدهم: پیش‌فرض رسمی + قابل ویرایش ─── -->
                <TextBlock Text="سرور لایسنس" FontSize="14" FontWeight="Bold" Margin="4,0,2,8" />
                <materialDesign:Card Padding="18" Margin="2,4" UniformCornerRadius="14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     materialDesign:HintAssist.Hint="نشانی سرور لایسنس — مثلاً https://clinic-license.ea-fixer.ir"
                                     Text="{Binding PortalUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12.5"
                                     Margin="0,0,8,0" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Command="{Binding SavePortalUrlCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    VerticalAlignment="Center" Content="💾 ذخیره سرور" />
                        </Grid>
                        <TextBlock Text="نشانی ریشه کافی است — به‌صورت خودکار به api.php کامل می‌شود؛ این نشانی برای فعال‌سازی و تپ‌قلب روزانه به‌کار می‌رود."
                                   FontSize="10.5" Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding PortalSaveMessage}" FontSize="11.5" Margin="0,6,0,0"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}" TextWrapping="Wrap" />
                    </StackPanel>
                </materialDesign:Card>

                <!-- ─── اطلاعات لایسنس ─── -->
                <TextBlock Text="اطلاعات لایسنس" FontSize="14" FontWeight="Bold" Margin="4,18,2,8" />
                <materialDesign:Card Padding="18" Margin="2,4" UniformCornerRadius="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding LicenseKeyText}" FontSize="15" FontWeight="Bold" FontFamily="Consolas" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="انقضا: " FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ExpiryText}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding RemainingText}" FontSize="12" Foreground="#1565C0" Margin="16,0,0,0"
                                           VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="12" Padding="16,8" Background="{Binding StatusColor}">
                            <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="Bold" Foreground="White" />
                        </Border>
                    </Grid>
                </materialDesign:Card>

                <!-- ─── ماژول‌ها — چیپس با نام + رنگ وضعیت (چرخه هجدهم) ─── -->
                <TextBlock Text="ماژول‌ها" FontSize="14" FontWeight="Bold" Margin="4,18,2,8" />
                <ItemsControl ItemsSource="{Binding Modules}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="12,6" Margin="3"
                                    Background="{Binding ChipBackground}"
                                    BorderBrush="{Binding ChipBorder}"
                                    BorderThickness="1.2"
                                    ToolTip="{Binding Title}">
                                <TextBlock Text="{Binding DisplayText}" FontSize="11.5"
                                           Foreground="{Binding ChipForeground}" FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ─── فعال‌سازی ─── -->
                <TextBlock Text="فعال‌سازی لایسنس" FontSize="14" FontWeight="Bold" Margin="4,18,2,8" />
                <materialDesign:Card Padding="18" Margin="2,4" UniformCornerRadius="14">
                    <StackPanel>
                        <TextBlock Text="🔑 فعال‌سازی آنلاین" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="کلید لایسنس — SCPRO-XXXXX-XXXXX-XXXXX"
                                     Text="{Binding ActivationKey, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" FontFamily="Consolas"
                                     Margin="0,0,8,0" />
                            <Button Grid.Column="1" Command="{Binding ActivateOnlineCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Content="🔑 فعال‌سازی آنلاین" />
                        </Grid>

                        <Separator Margin="0,16,0,12" />

                        <TextBlock Text="📁 فعال‌سازی آفلاین" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="مرحله ۱: فایل درخواست (.req) این دستگاه را بگیرید و برای فروشنده بفرستید."
                                   FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Button Command="{Binding DownloadRequestFileCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                HorizontalAlignment="Left" Content="📥 دریافت فایل درخواست (.req)" Margin="0,0,0,12" />
                        <TextBlock Text="مرحله ۲: فایل لایسنس (.lic) که فروشنده برمی‌گرداند را بارگذاری کنید."
                                   FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Button Command="{Binding ActivateOfflineCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                HorizontalAlignment="Left" Content="📤 بارگذاری فایل لایسنس (.lic)" />
                    </StackPanel>
                </materialDesign:Card>

                <!-- ─── کارت پشتیبانی — چرخه هجدهم: همیشه محتوا دارد؛ پس از تماس با سرور تازه می‌شود ─── -->
                <TextBlock Text="پشتیبانی محصول" FontSize="14" FontWeight="Bold" Margin="4,18,2,8" />
                <materialDesign:Card Padding="18" Margin="2,4" UniformCornerRadius="14"
                                     Visibility="{Binding HasSupport, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <materialDesign:PackIcon Kind="Headset" Width="22" Height="22" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SupportName}" FontSize="14.5" FontWeight="Bold" />
                                <TextBlock Text="{Binding SupportCompany}" FontSize="12" Opacity="0.75" />
                            </StackPanel>
                        </StackPanel>
                        <UniformGrid Columns="2" Margin="0,2">
                            <StackPanel Margin="0,4,8,4">
                                <TextBlock Text="📞 تلفن" FontSize="10.5" Opacity="0.6" />
                                <TextBlock Text="{Binding SupportPhone}" FontSize="12.5" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Right" />
                            </StackPanel>
                            <StackPanel Margin="8,4,0,4">
                                <TextBlock Text="📱 موبایل" FontSize="10.5" Opacity="0.6" />
                                <TextBlock Text="{Binding SupportMobile}" FontSize="12.5" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Right" />
                            </StackPanel>
                            <StackPanel Margin="0,4,8,4">
                                <TextBlock Text="✉️ ایمیل" FontSize="10.5" Opacity="0.6" />
                                <TextBlock Text="{Binding SupportEmail}" FontSize="12.5" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Right" />
                            </StackPanel>
                            <StackPanel Margin="8,4,0,4">
                                <TextBlock Text="🌐 وب‌سایت" FontSize="10.5" Opacity="0.6" />
                                <TextBlock Text="{Binding SupportWebsite}" FontSize="12.5" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Right" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="این اطلاعات با هر تماس موفق با سرور لایسنس (فعال‌سازی/تپ‌قلب) خودکار تازه می‌شود."
                                   FontSize="10" Opacity="0.55" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </materialDesign:Card>
                <!-- پشتیبان یافت نشد — فقط در حالت هیچ داده‌ای (بسیار نادر) -->
                <materialDesign:Card Padding="14" Margin="2,4" UniformCornerRadius="14"
                                     Visibility="{Binding HasSupport, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="پس از فعال‌سازی لایسنس، اطلاعات تماس پشتیبانی به‌طور خودکار از سرور دریافت و اینجا نمایش داده می‌شود."
                               FontSize="11.5" Opacity="0.75" TextWrapping="Wrap" />
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
