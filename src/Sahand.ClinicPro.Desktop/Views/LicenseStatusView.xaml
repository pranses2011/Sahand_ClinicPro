<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.LicenseStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="680" d:DesignWidth="860"
             FlowDirection="RightToLeft"
             FontFamily="Vazirmatn, Segoe UI, Tahoma">
    <!-- ═══ وضعیت لایسنس — گام U19 طبق فرم ۳۱ ═══ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <materialDesign:PackIcon Kind="KeyChain" Width="26" Height="26"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
            <TextBlock Text="وضعیت لایسنس" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
            <Button Command="{Binding LoadCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="14,0,0,0"
                    ToolTip="بررسی آنلاین">
                <materialDesign:PackIcon Kind="CloudSearch" Width="14" Height="14" />
            </Button>
        </StackPanel>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="2">
            <StackPanel MaxWidth="760" HorizontalAlignment="Right" Margin="4,4">

                <!-- ─── اطلاعات لایسنس ─── -->
                <materialDesign:Card Padding="18" Margin="2,4" UniformCornerRadius="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding LicenseKeyText}" FontSize="15" FontWeight="Bold" FontFamily="Consolas" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="انقضا: " FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ExpiryText}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding RemainingText}" FontSize="12" Foreground="#1565C0" Margin="16,0,0,0"
                                           VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="12" Padding="16,8" Background="{Binding StatusColor}">
                            <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="Bold" Foreground="White" />
                        </Border>
                    </Grid>
                </materialDesign:Card>

                <!-- ─── ماژول‌های فعال ─── -->
                <TextBlock Text="ماژول‌های فعال" FontSize="14" FontWeight="Bold" Margin="4,16,2,8" />
                <ItemsControl ItemsSource="{Binding Modules}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="12,6" Margin="3" Background="#F7FAFD"
                                    BorderBrush="#DCE7F0" BorderThickness="1">
                                <TextBlock Text="{Binding StatusText}" FontSize="11.5" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ─── فعال‌سازی ─── -->
                <TextBlock Text="فعال‌سازی لایسنس" FontSize="14" FontWeight="Bold" Margin="4,18,2,8" />
                <materialDesign:Card Padding="18" Margin="2,4" UniformCornerRadius="14">
                    <StackPanel>
                        <TextBlock Text="🔑 فعال‌سازی آنلاین" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="کلید لایسنس — SCPRO-XXXXX-XXXXX-XXXXX"
                                     Text="{Binding ActivationKey, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" FontFamily="Consolas"
                                     Margin="0,0,8,0" />
                            <Button Grid.Column="1" Command="{Binding ActivateOnlineCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Content="🔑 فعال‌سازی آنلاین" />
                        </Grid>

                        <Separator Margin="0,16,0,12" />

                        <TextBlock Text="📁 فعال‌سازی آفلاین" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="مرحله ۱ و ۲: فایل درخواست (.req) را از پورتال لایسنس دریافت و برای فروشنده ارسال کنید"
                                   FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Button Command="{Binding ActivateOfflineCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                HorizontalAlignment="Left" Content="📤 بارگذاری فایل لایسنس (.lic)" />
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
