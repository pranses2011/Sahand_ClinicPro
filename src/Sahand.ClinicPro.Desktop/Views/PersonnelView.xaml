<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.PersonnelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1080"
             FlowDirection="RightToLeft">
    <!-- ═══════════════════════════════════════════════════════════
         صفحهٔ مستقل مدیریت پرسنل — چرخه بیست‌وسوم (گزارش شانزدهم مالک):
         «در منوی کناری، گزینه پرسنل صفحه تنظیمات و مدیریت سامانه را باز می‌کند
         و پرسنل در تب پرسنل در این صفحه باز می‌شود که اشتباه است و پرسنل باید
         یک صفحه جدا باشد و این صفحه هم گزینه جداگانه باشد».
         پیش‌تر قالب نمایش PersonnelViewModel همان AdminView بود (تنظیمات با
         زبانه‌ها)؛ اکنون این نمای اختصاصی و مستقل ساخته شد و زبانهٔ پرسنل از
         صفحهٔ تنظیمات حذف گردید.
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- سربرگ صفحه -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <materialDesign:PackIcon Kind="AccountTie" Width="26" Height="26"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
            <TextBlock Text="مدیریت پرسنل" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="ثبت، ویرایش حقوقی و عکس پرسن درمانگاه" FontSize="12" Opacity="0.65"
                       Margin="14,4,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- نوار وضعیت/خطا -->
        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage, Mode=OneWay}" Foreground="#C62828"
                   FontSize="12" TextWrapping="Wrap" Margin="2,0,0,8"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />

        <!-- نوار ابزار -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,0,0,8"
                    HorizontalAlignment="Left">
            <Button Command="{Binding NewEmployeeCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AccountPlus" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="پرسنل جدید" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding LoadEmployeesCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="بازخوانی" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- فهرست پرسن -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Employees}"
                  SelectedItem="{Binding SelectedEmployee}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                 
                  FontSize="12">
            <DataGrid.Columns>
                <!-- ─── عکس: نمایش/تعویض/حذف — چرخه هجدهم / چرخهٔ سی‌وهفتم:
                     بندانگشتی دایره‌ایِ قابل‌کلیک به‌جای آیکون «نمایش بزرگ» ─── -->
                <DataGridTemplateColumn Header="عکس" Width="Auto" MinWidth="160" MaxWidth="420">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- ═══ چرخهٔ سی‌وهفتم (گزارش مالک) ═══ «در لیست پرسنل
                                     تصویرشان به‌صورت بندانگشتی قابل‌کلیک برای بزرگ‌نمایی
                                     نمایش داده شود» — کلیک روی بندانگشتی همان دستور نمایشِ
                                     بزرگ را اجرا می‌کند (دانلود عکس کامل + نمایشگر تمام‌صفحه).
                                     تا رسیدن بندانگشتی یا در نبود عکس، آدمک خاکستری دیده
                                     می‌شود؛ ImageBrush با منبع تهی هیچ نمی‌کشد و آدمک
                                     نمایان می‌ماند — بدون نیاز به مبدل وارون. برش دایره‌ای
                                     واقعی با ImageBrush روی Ellipse انجام می‌شود. -->
                                <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                        ToolTip="نمایش بزرگ عکس"
                                        Command="{Binding DataContext.ViewPhotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Padding="0" Margin="0,0,8,0" Cursor="Hand">
                                    <Grid Width="34" Height="34">
                                        <!-- زمینهٔ روشن + حلقهٔ دور بندانگشتی -->
                                        <Ellipse Width="34" Height="34" Fill="#ECEFF1" Stroke="#B0BEC5" StrokeThickness="1" />
                                        <!-- جای‌نگهدار آدمک — زیر لایهٔ عکس -->
                                        <materialDesign:PackIcon Kind="Account" Width="20" Height="20"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 Foreground="#90A4AE" />
                                        <!-- بندانگشتی عکس — لایهٔ رویی؛ با پر شدن Photo آدمک را می‌پوشاند -->
                                        <Ellipse Width="34" Height="34">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                        ToolTip="انتخاب / تعویض عکس"
                                        Command="{Binding DataContext.ChangePhotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Foreground="#2E7D32" Padding="4,2">
                                    <materialDesign:PackIcon Kind="ImagePlus" Width="18" Height="18" />
                                </Button>
                                <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                        ToolTip="حذف عکس"
                                        Command="{Binding DataContext.DeletePhotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Foreground="#C62828" Padding="4,2"
                                        Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVisibility}}">
                                    <materialDesign:PackIcon Kind="ImageRemove" Width="18" Height="18" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="کد پرسنلی" Binding="{Binding PersonnelCode, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="100" MaxWidth="420"  ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Header="نام کامل" Binding="{Binding FullName, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="170" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Header="سمت" Binding="{Binding PositionName, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="120" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Header="دپارتمان" Binding="{Binding DepartmentName, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="120" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Header="موبایل" Binding="{Binding Mobile, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="110" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Header="نوع" Binding="{Binding TypeText, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="90" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <!-- حقوق پایه — مبدل مبلغ (واحد پول + ارقام فارسی + جداکننده) به‌جای StringFormat -->
                <DataGridTextColumn Header="حقوق پایه" Binding="{Binding BaseSalary, Converter={StaticResource CurrencyRial}}" Width="Auto" MinWidth="120" MaxWidth="420">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource App.TableCellTextBlock}">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="درصد از سود (٪)" Binding="{Binding CommissionPercent, StringFormat='{}{0:0.##}'}" Width="Auto" MinWidth="105" MaxWidth="420">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource App.TableCellTextBlock}">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="Foreground" Value="#8E24AA" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!-- ═══ کلیدهای عملیاتی کامل — چرخهٔ بیست‌وششم (گزارش هجدهم مالک):
                     «امکان ویرایش پرسنل وجود ندارد و کلیدهای عملیاتی ناقص‌اند» —
                     ویرایش کامل (فرم ثبت در حالت ویرایش) + ویرایش حقوقی + حذف نرم
                     چرخهٔ بیست‌ونهم: کلید «مشخصات کاربری» — حسابِ ورودِ متصل ═══ -->
                <DataGridTemplateColumn Header="عملیات" Width="Auto" MinWidth="264" MaxWidth="420">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource App.RowIconButton}"
                                        ToolTip="ویرایش کامل اطلاعات پرسنل"
                                        Command="{Binding DataContext.EditEmployeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Foreground="#1565C0">
                                    <materialDesign:PackIcon Kind="AccountEdit" Width="18" Height="18" />
                                </Button>
                                <!-- اصلاح چرخهٔ سی‌ویکم: آکولاد باز جاافتاده در StaticResource باعث
                                     XamlParseException (رشته به‌جای Style) و کرش کل صفحهٔ پرسنل می‌شد -->
                                <Button Style="{StaticResource App.RowIconButton}"
                                        ToolTip="ویرایش اطلاعات حقوقی — حقوق پایه و درصد از سود"
                                        Command="{Binding DataContext.EditSalaryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Foreground="#2E7D32">
                                    <materialDesign:PackIcon Kind="CurrencyUsd" Width="18" Height="18" />
                                </Button>
                                <!-- مشخصات کاربری — چرخهٔ بیست‌ونهم (گزارش هجدهم مالک):
                                     حسابِ ورودِ متصل به همین پرسنل را ویرایش یا می‌سازد -->
                                <Button Style="{StaticResource App.RowIconButton}"
                                        ToolTip="مشخصات کاربری — ویرایش حساب ورودِ متصل یا ساخت حساب جدید"
                                        Command="{Binding DataContext.ManageAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Foreground="#00695C">
                                    <materialDesign:PackIcon Kind="AccountKey" Width="18" Height="18" />
                                </Button>
                                <Button Style="{StaticResource App.RowIconButton}"
                                        ToolTip="حذف پرسنل (حذف نرم — سابقه‌ها سالم می‌مانند)"
                                        Command="{Binding DataContext.DeleteEmployeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Foreground="#C62828">
                                    <materialDesign:PackIcon Kind="AccountRemove" Width="18" Height="18" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
