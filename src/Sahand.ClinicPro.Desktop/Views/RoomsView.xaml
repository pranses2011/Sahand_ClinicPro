<UserControl xmlns:shortcuts="clr-namespace:Sahand.ClinicPro.Desktop.Services" x:Class="Sahand.ClinicPro.Desktop.Views.RoomsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1080"
             FlowDirection="RightToLeft">
    <!-- ═══════════════════════════════════════════════════════════
         صفحهٔ مدیریت اتاق‌های درمانگاه — چرخهٔ سی‌ونه‌م (گزارش مالک):
         «مدیریت اتاق ها رو در منوی کناری هم قرار بده» — همان منطق پنجرهٔ
         فرم پزشک (RoomsManagerViewModel) این‌بار به‌صورت صفحهٔ اصلی از منوی
         «مدیریت سامانه»؛ چیدمان: سربرگ + چیپ‌های آمار + جدول اتاق‌ها +
         کارت فرم افزودن/ویرایش
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- سربرگ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Door"
                                         Width="26" Height="26"
                                         Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                         VerticalAlignment="Center" />
                <TextBlock Text="مدیریت اتاق‌های درمانگاه" FontSize="20" FontWeight="Bold"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <!-- دکمهٔ نوسازی — سمت مقابل عنوان -->
            <Button DockPanel.Dock="Left" Command="{Binding LoadCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,12,0"
                    ToolTip="بارگذاری مجدد فهرست اتاق‌ها از سرور">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Width="15" Height="15" VerticalAlignment="Center" />
                    <TextBlock Text="نوسازی" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>

        <!-- راهنما + چیپ‌های آمار -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="{Binding HintText, Mode=OneWay}" FontSize="12" Opacity="0.65"
                       Margin="2,0,0,8" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal">
                <Border Background="#E8F5E9" CornerRadius="10" Padding="14,6" Margin="0,0,8,0"
                        ToolTip="اتاق‌های فعال — قابل انتخاب در برنامهٔ کاری پزشک و پذیرش خدمتی">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DoorOpen" Width="15" Height="15" Foreground="#2E7D32" VerticalAlignment="Center" />
                        <TextBlock Margin="7,0,0,0" FontSize="12.5" Foreground="#1B5E20" VerticalAlignment="Center">
                            <Run Text="اتاق فعال: " /><Run Text="{Binding ActiveCount, Mode=OneWay, Converter={StaticResource PersianDigits}}" FontWeight="Bold" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Background="#FFEBEE" CornerRadius="10" Padding="14,6" Margin="0,0,8,0"
                        ToolTip="اتاق‌های غیرفعال‌شده (حذف نرم) — تاریخچهٔ پذیرش‌هایشان حفظ می‌شود">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DoorClosed" Width="15" Height="15" Foreground="#C62828" VerticalAlignment="Center" />
                        <TextBlock Margin="7,0,0,0" FontSize="12.5" Foreground="#B71C1C" VerticalAlignment="Center">
                            <Run Text="غیرفعال: " /><Run Text="{Binding InactiveCount, Mode=OneWay, Converter={StaticResource PersianDigits}}" FontWeight="Bold" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,4,0,8"
                     VerticalAlignment="Bottom"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!-- جدول اتاق‌ها -->
        <Border Grid.Row="2" CornerRadius="12" Padding="10"
                Background="{DynamicResource MaterialDesign.Brush.Background}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                BorderThickness="1">
            <DataGrid ItemsSource="{Binding Rooms}"
                      SelectedItem="{Binding SelectedRoom}"
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      HeadersVisibility="Column" FontSize="12.5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="شماره" Binding="{Binding RoomNumber, Converter={StaticResource PersianDigits}}"
                                        Width="Auto" FontFamily="{DynamicResource App.CodeFont}" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                    <DataGridTextColumn Header="نام اتاق" Binding="{Binding DisplayName, Converter={StaticResource PersianDigits}}"
                                        Width="Auto" MinWidth="180" FontWeight="SemiBold" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                    <DataGridTextColumn Header="طبقه" Binding="{Binding Floor, TargetNullValue=—, Converter={StaticResource PersianDigits}}"
                                        Width="Auto" FontFamily="{DynamicResource App.CodeFont}" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                    <DataGridTemplateColumn Header="وضعیت" Width="Auto" SortMemberPath="IsActive" MaxWidth="420">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- رنگ وضعیت با تریگر — مبدل اختصاصی لازم نیست -->
                                <Border CornerRadius="10" Padding="10,2.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFEBEE" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="#E8F5E9" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusText, Converter={StaticResource PersianDigits}}" FontSize="11.5" VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- کارت فرم افزودن/ویرایش -->
        <Border Grid.Row="3" CornerRadius="12" Padding="14,12" Margin="0,10,0,0"
                Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                BorderThickness="1">
            <StackPanel>
                <!-- عنوان فرم: بدون انتخاب = افزودن؛ با انتخاب = ویرایش (تریگر، نه مبدل) -->
                <TextBlock FontSize="12.5" FontWeight="Bold" Margin="2,0,2,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="🚪 ویرایش اتاق انتخاب‌شده — مقادیر فرم را تغییر دهید و ذخیره کنید" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRoom}" Value="{x:Null}">
                                    <Setter Property="Text" Value="🚪 افزودن اتاق جدید" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- شماره اتاق -->
                    <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="شماره اتاق *"
                             Text="{Binding RoomNumber, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{DynamicResource App.CodeFont}" />

                    <!-- نام اتاق -->
                    <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="نام اتاق (مثلاً: اتاق تزریقات ۱)"
                             Text="{Binding RoomName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="8,0,0,0" />

                    <!-- طبقه -->
                    <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="طبقه"
                             Text="{Binding Floor, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                             Margin="8,0,0,0" FontFamily="{DynamicResource App.CodeFont}" />

                    <!-- دکمه‌های عملیات — انتخاب ردیف = ویرایش؛ بدون انتخاب = افزودن -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button Command="{Binding AddCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                MinWidth="105" MinHeight="40" Padding="14,8" Margin="0,0,8,0"
                                ToolTip="ثبت اتاق جدید با مقادیر فرم بالا">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="افزودن اتاق" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button shortcuts:SaveShortcut.Number="1" Command="{Binding UpdateCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                MinWidth="105" MinHeight="40" Padding="14,8" Margin="0,0,8,0"
                                ToolTip="ذخیرهٔ تغییرات روی اتاق انتخاب‌شدهٔ جدول">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="ذخیرهٔ ویرایش (Ctrl+Shift+1)" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeactivateCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#C62828" MinWidth="105" MinHeight="40" Padding="14,8"
                                ToolTip="غیرفعال‌سازی اتاق انتخاب‌شده (حذف نرم — تاریخچه حفظ می‌شود)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteOutline" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="غیرفعال‌سازی" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- خطای فرم -->
                <TextBlock Text="{Binding ErrorMessage, Mode=OneWay}"
                           Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                           FontSize="11.5" Margin="2,8,2,0" TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
