<Window x:Class="Sahand.ClinicPro.Desktop.Views.DoctorFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:behaviors="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        xmlns:controls="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        Title="{Binding FormTitle, Mode=OneWay}"
        Width="900" Height="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"

        TextOptions.TextFormattingMode="Ideal"
        WindowChrome.IsHitTestVisibleInChrome="False">
    <!-- ═══ فرم ثبت/ویرایش پزشک — گام U3 طبق پرامپت UI بخش ۱ (فرم ۷) ═══
         ۵ تب: پایه / تنظیم ویزیت / امضا و مهر / برنامه کاری / غیبت‌ها -->
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignCaptionTextBlock}">
            <Setter Property="Margin" Value="2,8,2,4" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style x:Key="TimeBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
            <Setter Property="materialDesign:HintAssist.Hint" Value="HH:mm" />
            <Setter Property="materialDesign:TextFieldAssist.RippleOnFocusEnabled" Value="False" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource App.CodeFont}" />
            <Setter Property="MaxLength" Value="5" />
            <Setter Property="MinWidth" Value="62" />
        </Style>
    </Window.Resources>

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- هدر -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <materialDesign:PackIcon Kind="Doctor" Width="24" Height="24"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                     VerticalAlignment="Center" />
            <TextBlock Text="{Binding FormTitle, Mode=OneWay}"
                       FontSize="18" FontWeight="Bold"
                       Margin="10,0,0,0" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Left" Command="{Binding CancelCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    HorizontalAlignment="Left" Padding="10,4">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Close" Width="14" Height="14" VerticalAlignment="Center" />
                    <TextBlock Text="بستن" Margin="6,0,0,0" />
                </StackPanel>
            </Button>
        </DockPanel>

        <!-- تب‌ها -->
        <TabControl x:Name="FormTabs" Grid.Row="1"
                    materialDesign:ColorZoneAssist.Mode="PrimaryLight"
                    Style="{StaticResource MaterialDesignTabControl}">
            <TabItem Header="👤 اطلاعات پایه">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="پرسنل مرتبط" />
                            <ComboBox ItemsSource="{Binding Employees}"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding EmployeeId}"
                                      DisplayMemberPath="FullName"
                                      materialDesign:HintAssist.Hint="انتخاب از پرسنل درمانگاه" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="مرتبه علمی" />
                            <ComboBox ItemsSource="{Binding AcademicRanks}"
                                      SelectedItem="{Binding AcademicRank}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="شماره پروانه نظام پزشکی * (یکتا)" />
                            <TextBox Text="{Binding MedicalLicenseNo, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="مثلاً ۱۲۳۴۵" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="کد نظام پزشکی (الزامی و یکتا)" />
                            <TextBox Text="{Binding NezamPezeshkiCode, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="تخصص *" />
                            <ComboBox ItemsSource="{Binding Specialties}"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SpecialtyId}"
                                      DisplayMemberPath="Name" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="فوق‌تخصص (اختیاری)" />
                            <ComboBox ItemsSource="{Binding SubSpecialties}"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SubSpecialtyId}"
                                      DisplayMemberPath="Name"
                                      IsEnabled="{Binding SpecialtyId, Converter={StaticResource NullToBool}}" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="بیوگرافی" />
                            <TextBox Text="{Binding Biography, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Height="92"
                                     VerticalScrollBarVisibility="Auto"
                                     materialDesign:HintAssist.Hint="سوابق تحصیلی و حرفه‌ای — در پرونده الکترونیک بیمار نمایش داده می‌شود" />
                        </StackPanel>

                        <!-- ─── کارت عکس پزشک — چرخه هجدهم (گزارش دوازدهم):
                             عکس روی پرسنل مرتبط ذخیره می‌شود؛ با کلیک بزرگ می‌شود ─── -->
                        <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                Background="#F5F9FF" BorderBrush="#CFE2F5" BorderThickness="1"
                                CornerRadius="10" Padding="12,10" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="82" Height="82" CornerRadius="41"
                                        Background="#E3F2FD" BorderBrush="#90CAF9"
                                        BorderThickness="2" Cursor="Hand"
                                        ToolTip="با کلیک، عکس را بزرگ ببینید">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick"
                                                      Command="{Binding ViewPhotoCommand}" />
                                    </Border.InputBindings>
                                    <Grid>
                                        <materialDesign:PackIcon Kind="AccountCircle"
                                                                 Width="40" Height="40"
                                                                 Foreground="#64B5F6"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Visibility="{Binding HasPhoto, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <Image Source="{Binding PhotoPreview}"
                                               Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="🖼 عکس پزشک" FontSize="13" FontWeight="Bold"
                                               Foreground="#16355E" />
                                    <TextBlock Text="عکس JPG/PNG تا ۵ مگابایت — روی پرسنلِ مرتبط ذخیره می‌شود؛ اگر «پرسنل مرتبط» عوض شود عکس همان پرسنل نمایش می‌یابد."
                                               FontSize="10.5" Foreground="#5B7290" TextWrapping="Wrap"
                                               Margin="0,3,0,6" MaxWidth="480" />
                                    <Button Command="{Binding ChangePhotoCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Content="انتخاب / تعویض عکس" FontSize="12"
                                            Padding="14,6" HorizontalAlignment="Left" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="⚙️ تنظیمات ویزیت">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}"><Run Text="حق ویزیت (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock>
                            <!-- چرخه ۲۴: جداکنندهٔ زندهٔ ۳ رقمی هنگام تایپ — پیش‌تر این کادر
                                 اصلاً رفتار MoneyInput را نداشت (گزارش هفدهم مالک) -->
                            <TextBox behaviors:MoneyInput.IsEnabled="True"
                                     behaviors:MoneyInput.NumericValue="{Binding ConsultationFeeText, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MoneyRial}}"
                                     FontSize="18"
                                     TextAlignment="Center"
                                     materialDesign:HintAssist.Hint="با جداکننده هزارگان" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="مدت هر ویزیت (دقیقه)" />
                            <ComboBox ItemsSource="{Binding VisitDurations}"
                                      SelectedItem="{Binding VisitDuration}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="حداکثر بیمار در هر شیفت" />
                            <TextBox Text="{Binding MaxPatientsPerShift, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="درصد سهم پزشک (۰ تا ۱۰۰)" />
                            <TextBox Text="{Binding DoctorPercentage, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,16,0,0">
                            <ToggleButton IsChecked="{Binding AcceptsNewPatients}"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          ToolTip="پذیرش بیمار جدید" />
                            <TextBlock Text="پذیرش بیمار جدید" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="0,16,0,0">
                            <ToggleButton IsChecked="{Binding OnlineBookingEnabled}"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          ToolTip="نوبت‌دهی آنلاین" />
                            <TextBlock Text="نوبت‌دهی آنلاین فعال" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="✍️ امضا و مهر">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="8">
                        <TextBlock Text="تصویر امضا" FontWeight="Bold" FontSize="13" />
                        <TextBlock Text="PNG شفاف — ۳۰۰×۱۰۰ پیکسل" FontSize="11" Opacity="0.6" Margin="2,4,2,10" />
                        <Border Height="120" CornerRadius="8"
                                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                                BorderThickness="1,1,1,1" Background="#FAFAFA"
                                HorizontalAlignment="Center" Padding="10">
                            <Image Source="{Binding SignatureImageBase64, Converter={StaticResource Base64ToImage}}"
                                   Stretch="Uniform" StretchDirection="DownOnly"
                                   MaxWidth="300" MaxHeight="100" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Center">
                            <Button Command="{Binding PickSignatureCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Upload" Width="15" Height="15" VerticalAlignment="Center" />
                                    <TextBlock Text="انتخاب تصویر امضا" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8">
                        <TextBlock Text="تصویر مهر" FontWeight="Bold" FontSize="13" />
                        <TextBlock Text="PNG — ۱۵۰×۱۵۰ پیکسل" FontSize="11" Opacity="0.6" Margin="2,4,2,10" />
                        <Border Height="120" CornerRadius="8"
                                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                                BorderThickness="1" Background="#FAFAFA"
                                HorizontalAlignment="Center" Padding="10">
                            <Image Source="{Binding StampImageBase64, Converter={StaticResource Base64ToImage}}"
                                   Stretch="Uniform" StretchDirection="DownOnly"
                                   MaxWidth="150" MaxHeight="150" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Center">
                            <Button Command="{Binding PickStampCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Upload" Width="15" Height="15" VerticalAlignment="Center" />
                                    <TextBlock Text="انتخاب تصویر مهر" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="📅 برنامه کاری">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- نوار بالای تب: دکمهٔ مدیریت اتاق‌ها — چرخه بیست‌ویکم (گزارش پانزدهم مالک):
                         «فیلد اتاق برای انتخاب هست ولی جایی برای تعریف اتاق و اسم اتاق نیست» -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="برنامه کاری هفتگی — شیفت هر روز هفته با اتاق و ظرفیت"
                                   FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Command="{Binding ManageRoomsCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                ToolTip="افزودن، تغییر نام و غیرفعال‌سازی اتاق‌های معاینه"
                                Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Door" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="مدیریت اتاق‌ها" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- ═══ چرخهٔ ۴۷ (گزارش مالک) ═══
                         «عنوان ستون ها و محتوای سلول ها رو وسط چین بکن» —
                         سبک محلی روی همین گرید: سرستون‌ها و محتوای سلول‌ها
                         (متن/چک‌باکس/انتخابگر) وسط‌چین؛ انتخابگرهای ساعت با
                         تراز کششیِ خودشان می‌مانند (Stretch صریح بر تراز محتوا
                         غلبه می‌کند) تا ستون‌های زمان مانند قبل تمام‌عرض باشند. -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ScheduleRows}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              FontSize="12"
                              SelectedItem="{Binding SelectedScheduleRow, Mode=TwoWay}">
                        <DataGrid.Resources>
                            <!-- سرستون وسط‌چین — بر سبک ضمنی سراسری سوار می‌شود -->
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource App.TableDataGridColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                            </Style>
                        </DataGrid.Resources>
                        <!-- سلول وسط‌چین — سبک ضمنی App (کشش محتوا) برای همین گرید بازنویسی می‌شود -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource App.TableDataGridCell}">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="روز" Width="Auto" MaxWidth="420">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding DayName}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- چرخه بیست‌وسوم (گزارش شانزدهم مالک): ستون‌های ساعت ۸۲px بودند و
                                 کنترل ساعت را می‌بریدند («ساعت‌ها کامل دیده نمیشن») → ۱۰۸px؛
                                 چرخه بیست‌ویکم: ستون‌ها از تایپ دستی به کنترل انتخابگر ساعت تبدیل شدند -->
                            <!-- چرخهٔ بیست‌وهشتم: ستون‌های ساعت ۱۲۶px با زوم فونت بزرگ/تم روشن می‌بریدند
                                     («ساعت‌ها هنوز کامل دیده نمی‌شوند» — مهم) → ۱۵۶px + کشش افقی کنترل -->
                            <!-- ═══ چرخهٔ سی‌وسوم (گزارش نوزدهم مالک — مهم) ═══
                                 «به‌جای بیشتر کردن عرض کنترل زمان، عرض سلول را زیاد کرده‌ای؛
                                 اندازهٔ کنترل ثابت مانده و زمان ناقص دیده می‌شود»:
                                 عرض صریح ۱۵۰px روی خود کنترل (نه اتکا به تراز سلول) —
                                 کنترل همیشه تمام‌عرضِ سلول ۱۵۶px را می‌پوشاند و متنِ
                                 مرکزچینِ انتخابگر در هر حالت کامل دیده می‌شود. -->
                            <!-- ═══ چرخهٔ چهل‌وچهارم (گزارش مالک) — ستون‌های باریک بدون اسکرول افقی ═══
                                 «عرض ستون های شروع و پایان و استراحت رو کمتر بکن تا
                                 زیباتر دیده بشن و نیازی به اسکرول افقی فرم نباشه»:
                                 حالتِ بستهٔ انتخابگر ساعت فشرده شد (Padding و آیکون
                                 کوچک‌تر در خود کنترل) و عرض صریح ۱۵۰px از کنترل‌ها
                                 حذف شد تا با عرض طبیعی محتوا رشد کند؛ ستون‌های زمان
                                 ۱۵۶→۱۰۶ و مجموع ستون‌ها ≈ ۷۰۰px — در پنجرهٔ ۹۰۰px
                                 بدون اسکرول افقی جا می‌شوند. تاریخچهٔ چرخه‌های ۲۳/۲۱/
                                 ۲۸/۳۳ برای ثبت رشد قبلی عرض‌ها حفظ شد. -->
                            <DataGridTemplateColumn Header="شروع" Width="Auto" SortMemberPath="StartTime" MaxWidth="420">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:TimePicker TimeText="{Binding StartTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             HorizontalAlignment="Stretch"
                                                             VerticalAlignment="Center" Margin="2,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="پایان" Width="Auto" SortMemberPath="EndTime" MaxWidth="420">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:TimePicker TimeText="{Binding EndTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             HorizontalAlignment="Stretch"
                                                             VerticalAlignment="Center" Margin="2,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="استراحت از" Width="Auto" SortMemberPath="BreakStart" MaxWidth="420">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:TimePicker TimeText="{Binding BreakStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             HorizontalAlignment="Stretch"
                                                             VerticalAlignment="Center" Margin="2,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="استراحت تا" Width="Auto" SortMemberPath="BreakEnd" MaxWidth="420">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:TimePicker TimeText="{Binding BreakEnd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             HorizontalAlignment="Stretch"
                                                             VerticalAlignment="Center" Margin="2,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="اتاق" Width="Auto" MaxWidth="420">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.Rooms, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding RoomId, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="DisplayName"
                                                  FontSize="11" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- ═══ چرخهٔ ۴۷ (گزارش مالک) ═══
                                 «در فیلد ظرفیت هر مقداری که مینویسم اعمال نمیشه
                                 و با ترک سلول، مقدار پاک میشه» — ریشه: مبدل
                                 PersianDigits در مسیر برگشت (ConvertBack) همیشه
                                 Binding.DoNothing برمی‌گرداند و مقدار هرگز به
                                 منبع نمی‌رسید؛ مبدل در چرخهٔ ۴۷ دوسویه شد و
                                 ارقام فارسی/لاتین هر دو پذیرفته می‌شوند. -->
                            <DataGridTextColumn Header="ظرفیت" Width="Auto"
                                Binding="{Binding MaxPatients, UpdateSourceTrigger=PropertyChanged, TargetNullValue='', Converter={StaticResource PersianDigits}}" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,10,0,0">
                        <Button Command="{Binding SaveScheduleCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="ذخیره فقط برنامه کاری" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="ساعت‌ها با کلیک از انتخابگر انتخاب می‌شوند — استراحت اختیاری است و با دکمهٔ «پاک کردن» حذف می‌شود"
                                   FontSize="11" Opacity="0.55" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="🏖️ غیبت‌ها و مرخصی">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- فرم ثبت غیبت جدید -->
                    <Border Grid.Row="0" CornerRadius="10" Padding="10,8" Margin="0,0,0,10"
                            Background="{DynamicResource MaterialDesign.Brush.Background}"
                            BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="ثبت غیبت جدید" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="تاریخ (شمسی)" FontSize="11" Opacity="0.7" />
                                    <TextBox Text="{Binding NewAbsenceDateShamsi, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="۱۴۰۴/۰۴/۰۳" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="از ساعت (اختیاری)" FontSize="11" Opacity="0.7" />
                                    <TextBox Text="{Binding NewAbsenceFromTime, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="خالی = کل روز" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="تا ساعت" FontSize="11" Opacity="0.7" />
                                    <TextBox Text="{Binding NewAbsenceToTime, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="نوع غیبت" FontSize="11" Opacity="0.7" />
                                    <ComboBox ItemsSource="{Binding AbsenceTypes}"
                                              SelectedIndex="{Binding NewAbsenceTypeIndex}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewAbsenceReason, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="دلیل غیبت (اختیاری)" Margin="0,0,8,0" />
                                <Button Grid.Column="1" Command="{Binding AddAbsenceCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="ثبت غیبت" Margin="7,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- فهرست غیبت‌ها -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Absences}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="از ساعت" Binding="{Binding FromTime, TargetNullValue=—, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="تا ساعت" Binding="{Binding ToTime, TargetNullValue=—, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="نوع" Binding="{Binding AbsenceTypeName, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="دلیل" Binding="{Binding Reason, TargetNullValue=—, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTemplateColumn Header="نوبت‌های درگیر" Width="Auto" MaxWidth="420">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Center"
                                                Background="#FFF3E0" Visibility="{Binding BookedAppointments, Converter={StaticResource ZeroToCollapsed}}">
                                            <TextBlock FontSize="11" Foreground="#E65100"
                                                       Text="{Binding BookedAppointments}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="عملیات" Width="Auto" MinWidth="70" MaxWidth="420">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.DeleteAbsenceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource App.RowIconButton}"
                                                ToolTip="حذف غیبت" Foreground="#C62828">
                                            <materialDesign:PackIcon Kind="Delete" Width="15" Height="15" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" FontSize="11" Opacity="0.55" Margin="2,8,0,0"
                               Text="هنگام ثبت غیبت، نوبت‌های رزروشده در آن بازه بررسی و در صورت وجود هشدار داده می‌شود" />
                </Grid>
            </TabItem>
        </TabControl>

        <!-- خطای فرم -->
        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}"
                   Foreground="#C62828" FontSize="12" Margin="0,6,0,0"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" />

        <!-- نوار پایین -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Left">
            <Button Command="{Binding SaveCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Width="170" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentSaveCheck" Width="17" Height="17" VerticalAlignment="Center" />
                    <TextBlock Text="ذخیره پزشک و برنامه" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <ProgressBar IsIndeterminate="True" Width="26" Height="18" Margin="10,0,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Grid>
</Window>
