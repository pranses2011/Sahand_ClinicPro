<Window xmlns:shortcuts="clr-namespace:Sahand.ClinicPro.Desktop.Services" x:Class="Sahand.ClinicPro.Desktop.Views.VisualTemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="طراحی بصری قالب" Width="1050" Height="700" MinWidth="780" MinHeight="520"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner" Background="#EEF3F9">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="طراحی بصری قالب چاپ" FontSize="22" FontWeight="Bold" Foreground="#173657"/>
            <TextBlock Text="ردیف‌های متن و اطلاعات سند را اضافه و مرتب کنید؛ برای مشاهده نمونه واقعی از پیش‌نمایش صفحه قالب استفاده کنید." Margin="0,5,0,0" Foreground="#536C82" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="10" Padding="14" BorderBrush="#D8E3EE" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="چیدمان برگه" FontSize="15" FontWeight="Bold" Foreground="#173657" Margin="0,0,0,10"/>
                    <ListBox x:Name="RowsList" ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent"
                             AllowDrop="True" Drop="OnRowDrop" DragOver="OnRowDragOver"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FBFF" BorderBrush="#DCE7F1" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="⋮⋮" FontSize="19" Foreground="#7994AB" Cursor="SizeAll" VerticalAlignment="Center"
                                                   ToolTip="این دستگیره را بکشید و روی ردیف مقصد رها کنید" MouseMove="OnRowGripMouseMove" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="متن یا برچسب" FontSize="11" Foreground="#5D748B"/>
                                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Visibility="{Binding IsVariable, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="اطلاعات سند" FontSize="11" Foreground="#5D748B"/>
                                            <ComboBox ItemsSource="{Binding DataContext.Variables, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Key, Mode=TwoWay}"
                                                      Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#D8E3EE" BorderThickness="1" CornerRadius="10" Padding="14">
                <StackPanel>
                    <TextBlock Text="ابزار طراحی" FontSize="15" FontWeight="Bold" Foreground="#173657" Margin="0,0,0,12"/>
                    <Button Content="＋ افزودن متن" Click="OnAddText" Margin="0,0,0,8" Padding="12,8"/>
                    <Button Content="＋ افزودن اطلاعات سند" Click="OnAddVariable" Margin="0,0,0,8" Padding="12,8"/>
                    <TextBlock Text="مرتب‌سازی: دستگیره کنار هر ردیف را بکشید." TextWrapping="Wrap" Foreground="#5D748B" FontSize="11" Margin="0,0,0,6"/>
                    <Separator Margin="0,5,0,10"/>
                    <Button Content="↑ انتقال ردیف به بالا" Click="OnMoveUp" Margin="0,0,0,8" Padding="12,8"/>
                    <Button Content="↓ انتقال ردیف به پایین" Click="OnMoveDown" Margin="0,0,0,8" Padding="12,8"/>
                    <Button Content="حذف ردیف انتخاب‌شده" Click="OnRemove" Margin="0,0,0,14" Padding="12,8"/>
                    <TextBlock Text="اطلاعات سند هنگام چاپ از داده واقعی جایگزین می‌شوند. تغییرات تا تأیید و سپس ذخیره در صفحه اصلی ثبت نمی‌شوند." TextWrapping="Wrap" Foreground="#5D748B" FontSize="11"/>
                </StackPanel>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
            <Button shortcuts:SaveShortcut.Number="1" Content="اعمال به قالب (Ctrl+Shift+1)" Click="OnApply" Padding="18,8" Margin="0,0,8,0" Background="#1565C0" Foreground="White"/>
            <Button Content="انصراف" Click="OnCancel" Padding="18,8"/>
        </StackPanel>
    </Grid>
</Window>
