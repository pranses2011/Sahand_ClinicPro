<Window x:Class="Sahand.ClinicPro.Desktop.Views.NavMenuEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="شخصی‌سازی منوی کناری"
        Width="760" Height="680"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft">
    <!-- ═══════════════════════════════════════════════════════════════
         ادیتور منوی کناری — چرخهٔ ۷۶ (بازطراحی رویکرد)
         گزارش مالک چرخهٔ ۷۵: «شخصی‌سازی منوهای کناری — نوع فعلی خوب نیست
         و سخت است؛ رویکرد را عوض کن». ویرایشگر درگ‌ومحورِ چرخهٔ ۷۴ حذف شد و
         به الگوی «همه‌چیز با یک کلیک» بازطراحی شد:
           • نوار بالا: انتخاب صفحه از کشو + «افزودن به انتها» + «گروه جدید»؛
           • هر ردیف ساختار دکمه‌های خودش را دارد: ➕ (فقط گروه‌ها — افزودن
             صفحهٔ انتخاب‌شدهٔ کشو به همان گروه)، ▲/▼ جابه‌جایی، ✕ حذف؛
           • هیچ عمل کشیدن‌ورهاکردنی باقی نمانده — همه‌چیز قابل کشف و کلیک.
         ساختار JSON و قرارداد سرور (PUT users/me/nav-layout) بدون تغییر است.
         ═══════════════════════════════════════════════════════════════ -->
    <Window.Resources>
        <!-- دکمهٔ کوچک ردیفی — همهٔ ردیف‌ها هم‌قد و هم‌شکل -->
        <Style x:Key="RowIconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- سربرگ -->
        <StackPanel Grid.Row="0" Margin="2,0,2,10">
            <TextBlock Text="شخصی‌سازی منوی کناری" FontSize="16" FontWeight="Bold" />
            <TextBlock Text="ابتدا صفحهٔ مورد نظر را از نوار بالا انتخاب کنید، سپس با دکمهٔ ➕ هر گروه آن را به زیرمنو بیفزایید یا «افزودن به انتها» را بزنید. جابه‌جایی با ▲/▼ و حذف با ✕. تنظیمات به‌ازای هر کاربر در دیتابیس ذخیره می‌شود."
                       FontSize="11" Opacity="0.65" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ═══ نوار افزودن — انتخاب صفحه + افزودن به انتها + گروه جدید ═══ -->
        <Border Grid.Row="1" CornerRadius="12" Padding="10" Margin="0,0,0,10"
                Background="{DynamicResource MaterialDesign.Brush.Background}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="صفحهٔ مورد نظر:" FontSize="11" Opacity="0.65" Margin="2,0,2,3" />
                    <ComboBox x:Name="PageCombo" DisplayMemberPath="Title" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="AddToEndButton" Click="OnAddPageToEnd" FontSize="11.5"
                            Style="{StaticResource MaterialDesignRaisedButton}" Padding="12,8" MinHeight="38">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="افزودن به انتها" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AddGroupButton" Click="OnAddGroup" FontSize="11.5" Margin="8,0,0,0"
                            Style="{StaticResource MaterialDesignOutlinedButton}" Padding="12,8" MinHeight="38">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderPlus" Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="گروه جدید" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Grid.Column="2" />
            </Grid>
        </Border>

        <!-- ═══ ساختار منوی من — ردیف‌ها با دکمه‌های خودشان ═══ -->
        <Border Grid.Row="2" CornerRadius="12" Padding="10"
                Background="{DynamicResource MaterialDesign.Brush.Background}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="ساختار منوی من" FontWeight="Bold" FontSize="12.5" Margin="2,0,2,8" />
                <ListBox x:Name="StructureList" BorderThickness="0"
                         SelectionMode="Single" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="6,4" Margin="0,2"
                                    Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="{Binding Indent}">
                                        <!-- گروه: آیکون پوشهٔ طلایی + عنوان؛ فرزند: آیکون صفحهٔ آبی -->
                                        <materialDesign:PackIcon Kind="{Binding Icon}" Width="16" Height="16"
                                                                 Foreground="{Binding IconBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   FontWeight="{Binding TitleWeight}" />
                                        <!-- چیپ نوع + شمار فرزندان گروه -->
                                        <Border Background="#E3F2FD" CornerRadius="8" Padding="7,1"
                                                Margin="10,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding ChildrenLabel, Mode=OneWay}" FontSize="10" Foreground="#1565C0" />
                                        </Border>
                                    </StackPanel>
                                    <!-- دکمه‌های ردیف — بدون هیچ درگی -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <!-- ➕ فقط روی گروه‌ها — صفحهٔ منتخب نوار بالا را به همین گروه می‌افزاید -->
                                        <Button Style="{StaticResource RowIconButton}"
                                                Click="OnRowAddToGroup" CommandParameter="{Binding}"
                                                Foreground="#2E7D32"
                                                Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="افزودن صفحهٔ انتخاب‌شدهٔ نوار بالا به این گروه">
                                            <materialDesign:PackIcon Kind="PlusCircleOutline" Width="17" Height="17" />
                                        </Button>
                                        <Button Style="{StaticResource RowIconButton}"
                                                Click="OnRowMoveUp" CommandParameter="{Binding}"
                                                ToolTip="جابه‌جایی به بالا">
                                            <materialDesign:PackIcon Kind="ChevronUp" Width="17" Height="17" />
                                        </Button>
                                        <Button Style="{StaticResource RowIconButton}"
                                                Click="OnRowMoveDown" CommandParameter="{Binding}"
                                                ToolTip="جابه‌جایی به پایین">
                                            <materialDesign:PackIcon Kind="ChevronDown" Width="17" Height="17" />
                                        </Button>
                                        <Button Style="{StaticResource RowIconButton}"
                                                Click="OnRowRemove" CommandParameter="{Binding}"
                                                Foreground="#C62828"
                                                ToolTip="حذف (گروه با همهٔ زیرمنوهایش حذف می‌شود)">
                                            <materialDesign:PackIcon Kind="CloseCircleOutline" Width="17" Height="17" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- دکمه‌های پایانی -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="2,14,2,0">
            <Button x:Name="SaveButton" Click="OnSave" Style="{StaticResource MaterialDesignRaisedButton}"
                    FontSize="12.5" MinWidth="150">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="ذخیره و اعمال منو" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <Button x:Name="ResetButton" Click="OnReset" Style="{StaticResource MaterialDesignOutlinedButton}"
                    FontSize="12" Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Restore" Width="15" Height="15" VerticalAlignment="Center" />
                    <TextBlock Text="بازگشت به منوی پیش‌فرض" Margin="6,0,0,0" />
                </StackPanel>
            </Button>
            <Button x:Name="CancelButton" Click="OnCancel" Style="{StaticResource MaterialDesignFlatButton}"
                    FontSize="12" Margin="10,0,0,0" Content="انصراف" />
        </StackPanel>
    </Grid>
</Window>
