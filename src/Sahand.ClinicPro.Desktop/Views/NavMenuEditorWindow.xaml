<Window x:Class="Sahand.ClinicPro.Desktop.Views.NavMenuEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:Sahand.ClinicPro.Desktop.Helpers"
        Title="شخصی‌سازی منوی کناری"
        Width="940" Height="680"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft">
    <!-- ═══════════════════════════════════════════════════════════════
         ادیتور منوی کناری — چرخهٔ ۷۴ (گزارش مالک)
         «امکانی رو طراحی و پیاده سازی بکن که بتونم منوهای کناری رو به سلیقه
         خودم مرتب بکنم و حتی بتونم منوی اصلی بسازم که صفه های مورد نظرم رو
         در زیر منوی اون قرار بدم و همچنین دکمه برگشت به تنظیمات پیشفرض هم
         داشته باشه و این تنظیمات به ازای هر کاربر باشه و در دیتابیس ذخیره بشه».
         چیدمان: ستون راست «صفحات در دسترس» (قابل کشیدن) + ستون چپ «ساختار
         منوی من» (ردیف‌های مسطح: گروه‌ها و فرزندان تورفته — جابه‌جایی با درگ
         یا دکمه‌های پیکان) + افزودن گروه دلخواه + حذف + پیش‌فرض + ذخیره.
         ═══════════════════════════════════════════════════════════════ -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- سربرگ -->
        <StackPanel Grid.Row="0" Margin="2,0,2,10">
            <TextBlock Text="شخصی‌سازی منوی کناری" FontSize="16" FontWeight="Bold" />
            <TextBlock Text="صفحات را از فهرست راست بکشید و در ساختار منو رها کنید؛ ردیف‌ها را با درگ یا پیکان‌ها جابه‌جا کنید. تنظیمات به‌ازای هر کاربر در دیتابیس ذخیره می‌شود."
                       FontSize="11" Opacity="0.65" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- دو ستون اصلی -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══ ستون راست: صفحات در دسترس ═══ -->
            <Border Grid.Column="0" CornerRadius="12" Padding="10" Margin="0,0,6,0"
                    Background="{DynamicResource MaterialDesign.Brush.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="صفحات در دسترس (قابل کشیدن)"
                               FontWeight="Bold" FontSize="12.5" Margin="2,0,2,8" />
                    <ListBox x:Name="AvailableList" BorderThickness="0"
                             SelectionMode="Single"
                             PreviewMouseMove="OnAvailableDrag"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,3" Cursor="Hand">
                                    <materialDesign:PackIcon Kind="{Binding Icon}" Width="16" Height="16"
                                                             Foreground="#1565C0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" Margin="8,0,0,0"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Group}" FontSize="9.5" Opacity="0.5"
                                               Margin="10,1,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ═══ ستون چپ: ساختار منوی من ═══ -->
            <Border Grid.Column="1" CornerRadius="12" Padding="10" Margin="6,0,0,0"
                    Background="{DynamicResource MaterialDesign.Brush.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1"
                    AllowDrop="True" Drop="OnStructureDrop" DragOver="OnStructureDragOver">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="2,0,2,8">
                        <TextBlock Text="ساختار منوی من" FontWeight="Bold" FontSize="12.5" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button x:Name="AddGroupButton" Click="OnAddGroup" FontSize="11"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderPlus" Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock Text="گروه جدید" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RemoveRowButton" Click="OnRemoveRow" FontSize="11" Margin="6,0,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Padding="10,4"
                                    Foreground="#C62828">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock Text="حذف انتخابی" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="MoveUpButton" Click="OnMoveRowUp" Width="36" Padding="0" Margin="6,0,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" ToolTip="جابه‌جایی به بالا">
                                <materialDesign:PackIcon Kind="ChevronUp" Width="15" Height="15" />
                            </Button>
                            <Button x:Name="MoveDownButton" Click="OnMoveRowDown" Width="36" Padding="0" Margin="3,0,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" ToolTip="جابه‌جایی به پایین">
                                <materialDesign:PackIcon Kind="ChevronDown" Width="15" Height="15" />
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                    <ListBox x:Name="StructureList" BorderThickness="0"
                             SelectionMode="Single" SelectionChanged="OnStructureSelectionChanged"
                             PreviewMouseMove="OnStructureDrag"
                             Drop="OnStructureDrop" DragOver="OnStructureDragOver" AllowDrop="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" Cursor="Hand">
                                    <!-- گروه: آیکون پوشه طلایی + عنوان؛ فرزند: آیکون صفحه + عنوان -->
                                    <materialDesign:PackIcon Kind="{Binding Icon}" Width="15" Height="15"
                                                             Foreground="{Binding IconBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" Margin="8,0,0,0" VerticalAlignment="Center"
                                               FontWeight="{Binding TitleWeight}" />
                                    <TextBlock Text="{Binding KindLabel}" FontSize="9" Opacity="0.5"
                                               Margin="10,1,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- دکمه‌های پایانی -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,14,2,0">
            <Button x:Name="SaveButton" Click="OnSave" Style="{StaticResource MaterialDesignRaisedButton}"
                    FontSize="12.5" MinWidth="150">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="ذخیره و اعمال منو" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <Button x:Name="ResetButton" Click="OnReset" Style="{StaticResource MaterialDesignOutlinedButton}"
                    FontSize="12" Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Restore" Width="15" Height="15" VerticalAlignment="Center" />
                    <TextBlock Text="بازگشت به منوی پیش‌فرض" Margin="6,0,0,0" />
                </StackPanel>
            </Button>
            <Button x:Name="CancelButton" Click="OnCancel" Style="{StaticResource MaterialDesignFlatButton}"
                    FontSize="12" Margin="10,0,0,0" Content="انصراف" />
        </StackPanel>
    </Grid>
</Window>
