<Window x:Class="Sahand.ClinicPro.Desktop.Views.ReceptionFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="ثبت پذیرش"
        Height="660" Width="560"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!-- ═══════════════════════════════════════════════════════════
         فرم ثبت پذیرش — گام V2
         جستجوی بیمار + پزشک + بیمه + پیوند نوبت اختیاری
         ═══════════════════════════════════════════════════════════ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="ثبت پذیرش بیمار" Style="{StaticResource SectionTitle}" />

            <!-- گام‌های کلیک‌پذیر پذیرش (طرح تأییدشده) -->
            <UniformGrid Columns="3" Margin="0,10,0,6">
                <Button Command="{Binding GoToStepCommand}" CommandParameter="0" Margin="2" Content="۱ · بیمار" />
                <Button Command="{Binding GoToStepCommand}" CommandParameter="1" Margin="2" Content="۲ · پزشک و بیمه" />
                <Button Command="{Binding GoToStepCommand}" CommandParameter="2" Margin="2" Content="۳ · جزئیات و ثبت" />
            </UniformGrid>
            <!-- بخش‌های اختیاری — فقط با تیک بالای فرم نشان داده می‌شوند -->
            <WrapPanel Margin="0,2,0,12">
                <CheckBox IsChecked="{Binding ShowAppointmentSection}" Content="نوبت مرتبط" Margin="0,0,14,0" />
                <CheckBox IsChecked="{Binding ShowReferralSection}" Content="کد معرفی‌نامه بیمه" Margin="0,0,14,0" />
                <CheckBox IsChecked="{Binding ShowNotesSection}" Content="یادداشت" />
            </WrapPanel>

            <!-- جستجوی بیمار -->
            <TextBox materialDesign:HintAssist.Hint="جستجوی بیمار: نام یا کد ملی یا موبایل *"
                     Text="{Binding PatientSearchTerm, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,8">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchPatientCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <ListBox ItemsSource="{Binding PatientResults}"
                     SelectedItem="{Binding SelectedPatient}"
                     Height="130" Margin="0,0,0,12"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.75" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- پزشک و بیمه -->
            <ComboBox materialDesign:HintAssist.Hint="پزشک *"
                      ItemsSource="{Binding Doctors}"
                      DisplayMemberPath="Name"
                      SelectedIndex="{Binding DoctorIndex}"
                      Margin="0,0,0,12" />
            <ComboBox materialDesign:HintAssist.Hint="بیمه"
                      ItemsSource="{Binding InsuranceCompanies}"
                      DisplayMemberPath="DisplayName"
                      SelectedIndex="{Binding InsuranceIndex}"
                      Margin="0,0,0,12" />

            <TextBox materialDesign:HintAssist.Hint="شناسه نوبت مرتبط (اختیاری — برای پذیرش نوبتی)"
                     Text="{Binding AppointmentId, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding ShowAppointmentSection, Converter={StaticResource BoolToVis}}"
                     Margin="0,0,0,12" />
            <TextBox materialDesign:HintAssist.Hint="کد معرفی‌نامه بیمه (اختیاری)"
                     Text="{Binding ReferralCode, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding ShowReferralSection, Converter={StaticResource BoolToVis}}"
                     Margin="0,0,0,12" />
            <TextBox materialDesign:HintAssist.Hint="یادداشت"
                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" AcceptsReturn="False"
                     Visibility="{Binding ShowNotesSection, Converter={StaticResource BoolToVis}}"
                     Margin="0,0,0,16" />

            <!-- پیام خطا -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />

            <!-- دکمه‌ها -->
            <UniformGrid Columns="2">
                <Button Command="{Binding SaveCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Content="ثبت پذیرش" Height="42" Margin="4" />
                <Button Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Content="انصراف" Height="42" Margin="4" />
            </UniformGrid>

            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </ScrollViewer>
</Window>