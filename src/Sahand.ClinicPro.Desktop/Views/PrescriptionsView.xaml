<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.PrescriptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!-- ═══════════════════════════════════════════════════════════
         نسخه‌نویسی — گام V4
         فهرست صفحه‌بندی‌شده + فیلتر وضعیت + جستجو
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ سربرگ گرادیانی — چرخهٔ ۴۸ (هم‌الگوی چرخهٔ ۴۵-۴۷؛ گزارش مالک:
             «ظاهر و چیدمان تمامی صفحات خیلی حرفه‌ای‌تر و زیباتر بکن») ═══ -->
        <Border Grid.Row="0" CornerRadius="14" Padding="16,10" Margin="0,0,0,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#00695C" Offset="0" />
                    <GradientStop Color="#004D40" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.16" Color="#00291F" />
            </Border.Effect>
            <DockPanel>
                <Button DockPanel.Dock="Left"
                        Command="{Binding NewPrescriptionCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Foreground="White" Background="#26A69A" BorderBrush="#26A69A"
                        MinHeight="36" MinWidth="140" VerticalAlignment="Center"
                        ToolTip="فرم نسخه‌نویسی با تداخل‌سنجی خودکار داروها و پایش حساسیت بیمار">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Prescription" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="صدور نسخهٔ جدید" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="22" VerticalAlignment="Center" Margin="0,0,12,0"
                            Background="#33FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1">
                        <materialDesign:PackIcon Kind="Prescription" Width="22" Height="22"
                                                 Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="نسخه‌نویسی" FontSize="17" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="صدور نسخه با تداخل‌سنجی خودکار داروها و پایش حساسیت بیمار"
                                   FontSize="10.5" Foreground="#B2DFDB" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- فیلترها -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBox materialDesign:HintAssist.Hint="جستجو: کد نسخه یا نام بیمار"
                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                     Width="240" Margin="0,0,12,0">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <ComboBox materialDesign:HintAssist.Hint="وضعیت"
                      ItemsSource="{Binding StatusLabels}"
                      SelectedIndex="{Binding StatusFilterIndex}"
                      Width="150" Margin="0,0,12,0" />
            <Button Command="{Binding ViewDetailsCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="مشاهده جزئیات" Margin="0,0,8,0" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                       FontSize="12" VerticalAlignment="Center" />
        </StackPanel>

        <!-- جدول -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Prescriptions}"
                  SelectedItem="{Binding SelectedPrescription}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                 
                  materialDesign:DataGridAssist.CellPadding="8,6">
            <DataGrid.Columns>
                <DataGridTextColumn Header="کد نسخه" Binding="{Binding Code, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Header="بیمار" Binding="{Binding PatientName, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Header="پزشک" Binding="{Binding DoctorName, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Header="تاریخ" Binding="{Binding Date, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Header="نوع" Binding="{Binding TypeText, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Header="رسانه" Binding="{Binding MediaText, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
            </DataGrid.Columns>
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick"
                              Command="{Binding ViewDetailsCommand}" />
            </DataGrid.InputBindings>
        </DataGrid>

        <!-- صفحه‌بندی -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right"
                    Command="{Binding NextPageCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Content="صفحه بعد" />
            <Button DockPanel.Dock="Right"
                    Command="{Binding PrevPageCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Content="صفحه قبل"
                    Margin="0,0,8,0" />
            <TextBlock VerticalAlignment="Center" FontSize="13" Opacity="0.8">
                <Run Text="صفحه " />
                <Run Text="{Binding PageNumber, Mode=OneWay}" />
                <Run Text=" از " />
                <Run Text="{Binding TotalPages, Mode=OneWay}" />
                <Run Text=" — جمع: " />
                <Run Text="{Binding TotalCount, Mode=OneWay}" />
                <Run Text=" نسخه" />
            </TextBlock>
        </DockPanel>
    </Grid>
</UserControl>