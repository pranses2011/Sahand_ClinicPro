<Window x:Class="Sahand.ClinicPro.Desktop.Views.PatientDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        mc:Ignorable="d"
        Title="پرونده بیمار"
        Height="680" Width="860"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}">
    <!-- ═══════════════════════════════════════════════════════════
         پرونده بیمار — گام U2 طبق پرامپت UI بخش ۱ (فرم ۵):
         کارت سربرگ + هشدار آلرژی/مزمن/دارو + تب‌های سوابق + اقدامات سریع
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- پیام خطای بارگذاری — چرخه بیست‌وسوم: پیش‌تر شکست endpoint بی‌صدا بود و
             پنجره خالی باز می‌ماند؛ اکنون علت بالای پنجره دیده می‌شود -->
        <Border Grid.Row="0" Background="#FFF3E0" CornerRadius="10" Padding="12,7" Margin="0,0,0,10"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="AlertCircle" Foreground="#E65100"
                                         Width="17" Height="17" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage, Mode=OneWay}" Foreground="#E65100"
                           FontSize="12" TextWrapping="Wrap" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ═══ کارت سربرگ: عکس + مشخصات خلاصه ═══ -->
        <materialDesign:Card Grid.Row="1" UniformCornerRadius="14" Padding="18" Margin="0,0,0,10">
            <DockPanel>
                <!-- چپ: دکمه‌های چاپ و ویرایش -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Top">
                    <!-- چرخهٔ ۳۸ (گزارش مالک: «هیچ دکمه چاپی کار نمی‌کند»): دکمهٔ مردهٔ
                         چاپ کارت به فرمان واقعی وصل شد — کارت شناسایی بیمار با سند
                         جریان فارسی به چاپگر می‌رود -->
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="OnPrintCardClick"
                            ToolTip="چاپ کارت بیمار" Margin="0,0,8,0" Padding="8,6">
                        <materialDesign:PackIcon Kind="Printer" Width="16" Height="16" />
                    </Button>
                </StackPanel>

                <!-- راست: عکس پروفایل -->
                <Border DockPanel.Dock="Right"
                        Width="72" Height="72" CornerRadius="36"
                        Background="#E3F2FD" VerticalAlignment="Center" Margin="14,0,0,0">
                    <materialDesign:PackIcon Kind="Account"
                                             Width="40" Height="40"
                                             Foreground="#1565C0"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                </Border>

                <!-- میانه: مشخصات -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding FullName}"
                                   FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                CornerRadius="8" Padding="8,1" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding MedicalRecordNo}"
                                       Foreground="White" FontSize="11"
                                       FontFamily="{DynamicResource App.CodeFont}" />
                        </Border>

                        <!-- ═══ برچسب‌های بیمار — چرخهٔ ۶۹ (فاز ۳ / F-18) ═══
                             چیپ‌های رنگی کنار نام: VIP طلایی / مزمن نارنجی / بقیه بنفش؛
                             دکمهٔ + حالت ویرایش را باز می‌کند (متن CSV + پیشنهادهای آماده). -->
                        <ItemsControl ItemsSource="{Binding Tags}" Margin="10,0,0,0"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="9" Padding="8,2" Margin="0,0,5,0"
                                            Background="#FFF8E1" BorderBrush="#F9A825" BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="#E65100" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Command="{Binding ToggleTagEditingCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}" Padding="4,0"
                                Width="26" Height="26" VerticalAlignment="Center"
                                ToolTip="ویرایش برچسب‌های بیمار (VIP/مزمن/…)">
                            <materialDesign:PackIcon Kind="TagPlus" Width="15" Height="15" Foreground="#F57F17" />
                        </Button>
                        <!-- ویرایش برچسب‌ها — CSV + پیشنهادها (چرخهٔ ۷۳: BoolToVis بی‌تعریف بود و پنجره
                             هنگام باز شدن با XamlParseException می‌افتاد — کلید استاندارد App.xaml) -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsEditingTags, Converter={StaticResource BoolToVisibility}}"
                                    VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBox Text="{Binding TagsEditText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="220" FontSize="11.5" Padding="6,4"
                                     materialDesign:HintAssist.Hint="مثال: VIP، دیابت" />
                            <ItemsControl ItemsSource="{Binding TagSuggestions}" Margin="6,0,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.AddTagSuggestionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                FontSize="10" Padding="6,2" Margin="0,0,3,0" Content="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Command="{Binding SaveTagsCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" FontSize="10.5"
                                    Padding="8,4" Margin="6,0,0,0" Content="ذخیره" />
                        </StackPanel>
                    </StackPanel>

                    <UniformGrid Columns="4" Margin="0,10,0,0" TextBlock.FontSize="11">
                        <StackPanel>
                            <TextBlock Text="کد ملی" Opacity="0.55" />
                            <TextBlock Text="{Binding NationalCode}" FontFamily="{DynamicResource App.CodeFont}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="موبایل" Opacity="0.55" />
                            <TextBlock Text="{Binding Mobile}" FontFamily="{DynamicResource App.CodeFont}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="سن" Opacity="0.55" />
                            <TextBlock Text="{Binding AgeText}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="جنسیت" Opacity="0.55" />
                            <TextBlock Text="{Binding GenderText}" />
                        </StackPanel>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="بیمه" Opacity="0.55" />
                            <TextBlock Text="{Binding InsuranceName}" />
                        </StackPanel>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="شماره بیمه" Opacity="0.55" />
                            <TextBlock Text="{Binding InsuranceNumber}" FontFamily="{DynamicResource App.CodeFont}" />
                        </StackPanel>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="گروه خون" Opacity="0.55" />
                            <TextBlock Text="{Binding BloodType}" />
                        </StackPanel>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="شهر" Opacity="0.55" />
                            <TextBlock Text="{Binding City}" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </DockPanel>
        </materialDesign:Card>

        <!-- ═══ نوار نتایج غیرعادی پاراکلینیک — چرخه ۱۳ (درخواست ۱-۴) ═══ -->
        <Expander Grid.Row="2" Margin="0,0,0,10" IsExpanded="False"
                  Visibility="{Binding AbnormalCount, Converter={StaticResource NullToVisibility}}">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FlaskOutline" Foreground="#E65100" Width="17" Height="17" VerticalAlignment="Center" />
                    <TextBlock FontWeight="Bold" FontSize="12.5" Margin="7,0,0,0" VerticalAlignment="Center"
                               Foreground="#E65100">
                        <Run Text="🧪 نتایج غیرعادی پاراکلینیک: " /><Run Text="{Binding AbnormalSummaryText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Expander.Header>
            <Border Background="#FFF3E0" CornerRadius="10" Padding="10,8" Margin="0,2,0,0">
                <ItemsControl ItemsSource="{Binding AbnormalResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding FlagColor, Mode=OneWay}" CornerRadius="8"
                                    Padding="10,6" Margin="0,0,0,5" BorderBrush="#00000022" BorderThickness="0.8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Kind, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="11.5" Foreground="#B71C1C" FontWeight="SemiBold" Margin="10,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Range, Mode=OneWay}" FontSize="10.5" Opacity="0.7" Margin="0,0,10,0" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding DateShamsi}" FontSize="10.5" Opacity="0.6" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Expander>

        <!-- ═══ هشدارهای برجسته پزشکی — ردیف ۳ (پیش‌تر با اکسپندر پاراکلینیک در
             همان ردیف همپوشان بود و در حالت باز، روی هم می‌افتادند — چرخه بیست‌وسوم) ═══ -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <!-- آلرژی — قرمز -->
            <Border Background="#FFEBEE" CornerRadius="10" Padding="12,8"
                    Visibility="{Binding Allergies.Count, Converter={StaticResource NullToVisibility}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Alert" Foreground="#C62828"
                                                 Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="آلرژی‌ها" Foreground="#C62828"
                                   FontWeight="Bold" FontSize="12" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Allergies}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#C62828" CornerRadius="11"
                                        Padding="10,2" Margin="0,0,6,4">
                                    <TextBlock Text="{Binding}" Foreground="White" FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- مزمن — نارنجی -->
            <Border Background="#FFF3E0" CornerRadius="10" Padding="12,8" Margin="0,6,0,0"
                    Visibility="{Binding ChronicDiseases.Count, Converter={StaticResource NullToVisibility}}">
                <StackPanel>
                    <TextBlock Text="🏥 بیماری‌های مزمن" Foreground="#E65100"
                               FontWeight="Bold" FontSize="12" />
                    <ItemsControl ItemsSource="{Binding ChronicDiseases}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FB8C00" CornerRadius="11"
                                        Padding="10,2" Margin="0,0,6,4">
                                    <TextBlock Text="{Binding}" Foreground="White" FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- داروهای فعلی — آبی -->
            <Border Background="#E3F2FD" CornerRadius="10" Padding="12,8" Margin="0,6,0,0"
                    Visibility="{Binding CurrentMedications.Count, Converter={StaticResource NullToVisibility}}">
                <StackPanel>
                    <TextBlock Text="💊 داروهای در حال مصرف" Foreground="#0D47A1"
                               FontWeight="Bold" FontSize="12" />
                    <ItemsControl ItemsSource="{Binding CurrentMedications}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E88E5" CornerRadius="11"
                                        Padding="10,2" Margin="0,0,6,4">
                                    <TextBlock Text="{Binding}" Foreground="White" FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ═══ یادداشت‌های سریع — چرخهٔ ۶۹ (فاز ۳ / F-17) ═══
                 «ثبت خلاصهٔ مهم بدون ساخت ویزیت کامل (تماس تلفنی، توصیهٔ تلفنی،
                 یادآور پیگیری)» — جعبهٔ یک‌خطی + دکمهٔ ثبت؛ فهرست جدیدترین اول. -->
            <Border Background="#F3E5F5" CornerRadius="10" Padding="12,8" Margin="0,6,0,0">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="📝 یادداشت سریع" Foreground="#4A148C"
                                   FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                        <ProgressBar IsIndeterminate="True" Height="3" Width="60" Margin="8,0,0,0"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding IsSavingNote, Converter={StaticResource BoolToVisibility}}" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <Button Command="{Binding AddQuickNoteCommand}" DockPanel.Dock="Left"
                                Style="{StaticResource MaterialDesignRaisedButton}" FontSize="11"
                                Padding="10,4" Content="ثبت" Margin="6,0,0,0" />
                        <TextBox Text="{Binding QuickNoteText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11.5" Padding="6,5"
                                 materialDesign:HintAssist.Hint="مثال: تماس تلفنی — قند ناشتا بهتر شد، پیگیری هفتهٔ بعد" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding QuickNotes}" Margin="0,6,0,0"
                                  MaxHeight="130">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="8" Padding="8,4"
                                        Margin="0,0,0,4" BorderBrush="#E1BEE7" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock Text="{Binding DateShamsi}" FontSize="9.5"
                                                   Foreground="#7B1FA2" Opacity="0.8" VerticalAlignment="Top"
                                                   FontFamily="{DynamicResource App.CodeFont}" DockPanel.Dock="Left" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Text}" FontSize="11.5"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ═══ تب‌های سوابق ═══ -->
        <TabControl Grid.Row="4" Background="Transparent">
            <!-- سوابق ویزیت -->
            <!-- دابل‌کلیک روی هر ردیف ویزیت = گشودن فرم کامل ویزیت (چرخهٔ ۴۸؛ گزارش مالک) -->
            <TabItem Header="📋 سوابق ویزیت" ToolTip="دابل‌کلیک: جزئیات کامل ویزیت">
                <DataGrid ItemsSource="{Binding Visits}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" FontSize="12"
                          HeadersVisibility="Column">
                    <!-- چرخهٔ ۴۸ — دابل‌کلیک: فرم کامل ویزیت (شرح حال/SOAP/حیاتی/تشخیص/ارجاع‌ها) -->
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                                      Command="{Binding OpenVisitDetailsCommand}"
                                      CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi, Converter={StaticResource PersianDigits}}" Width="110" />
                        <DataGridTextColumn Header="پزشک" Binding="{Binding DoctorName, Converter={StaticResource PersianDigits}}" Width="160" />
                        <DataGridTextColumn Header="شکایت / تشخیص" Binding="{Binding Diagnosis, Converter={StaticResource PersianDigits}}" Width="*" />
                        <DataGridTextColumn Header="وضعیت" Binding="{Binding Status, Converter={StaticResource PersianDigits}}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- نسخه‌ها -->
            <TabItem Header="💊 نسخه‌ها" ToolTip="دابل‌کلیک: جزئیات کامل نسخه">
                <DataGrid ItemsSource="{Binding Prescriptions}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" FontSize="12"
                          HeadersVisibility="Column">
                    <!-- چرخهٔ ۴۸ — دابل‌کلیک: پنجرهٔ کامل اقلام نسخه -->
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                                      Command="{Binding OpenPrescriptionDetailsCommand}"
                                      CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi, Converter={StaticResource PersianDigits}}" Width="110" />
                        <DataGridTextColumn Header="پزشک" Binding="{Binding DoctorName, Converter={StaticResource PersianDigits}}" Width="160" />
                        <DataGridTextColumn Header="کد نسخه" Binding="{Binding Code, Converter={StaticResource PersianDigits}}" Width="120" />
                        <DataGridTextColumn Header="وضعیت" Binding="{Binding Status, Converter={StaticResource PersianDigits}}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- آزمایش‌ها — چرخه بیست‌وسوم: اتصال واقعی به درخواست‌های آزمایش بیمار
                 (پیش‌تر EmptyState «در گام U10 متصل می‌شود» بود — تب خالی) -->
            <TabItem Header="🧪 آزمایش‌ها" ToolTip="دابل‌کلیک: نتایج قلم‌به‌قلم آزمایش">
                <DataGrid ItemsSource="{Binding Labs}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" FontSize="12"
                          HeadersVisibility="Column">
                    <!-- چرخهٔ ۴۸ — دابل‌کلیک: پنجرهٔ نتایج آزمایش -->
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                                      Command="{Binding OpenLabDetailsCommand}"
                                      CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="شماره درخواست" Binding="{Binding OrderNumber, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="110" />
                        <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="105" />
                        <DataGridTextColumn Header="پزشک" Binding="{Binding DoctorName, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="140" />
                        <DataGridTextColumn Header="تعداد اقلام" Binding="{Binding ItemsCount, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="80" />
                        <DataGridTextColumn Header="وضعیت" Binding="{Binding Status, Converter={StaticResource PersianDigits}}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- فاکتورها — چرخه بیست‌وسوم: اتصال واقعی به فاکتورهای بیمار
                 (پیش‌تر EmptyState «در گام U8 متصل می‌شود» بود — تب خالی) -->
            <TabItem Header="💰 فاکتورها">
                <DataGrid ItemsSource="{Binding Invoices}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" FontSize="12"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="شماره فاکتور" Binding="{Binding InvoiceNumber, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="110" />
                        <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="105" />
                        <DataGridTextColumn Header="مبلغ کل" Binding="{Binding TotalAmount, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="120" />
                        <DataGridTextColumn Header="پرداخت‌شده" Binding="{Binding PaidAmount, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="120" />
                        <DataGridTextColumn Header="وضعیت" Binding="{Binding Status, Converter={StaticResource PersianDigits}}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- نوبت‌ها — چرخه بیست‌وسوم: اتصال واقعی به نوبت‌های بیمار
                 (پیش‌تر EmptyState «در گام U4 متصل می‌شود» بود — تب خالی) -->
            <TabItem Header="📅 نوبت‌ها">
                <DataGrid ItemsSource="{Binding Appointments}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" FontSize="12"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="105" />
                        <DataGridTextColumn Header="ساعت" Binding="{Binding Time, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="70" />
                        <DataGridTextColumn Header="پزشک" Binding="{Binding DoctorName, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="140" />
                        <DataGridTextColumn Header="تخصص" Binding="{Binding Specialty, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="110" />
                        <DataGridTextColumn Header="وضعیت" Binding="{Binding Status, Converter={StaticResource PersianDigits}}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- اسناد — چرخه بیست‌وسوم: سوابق آرشیوی بیمار از سرور
                 (پیش‌تر EmptyState «در گام U15 متصل می‌شود» بود — تب خالی) -->
            <!-- ═══ چهار تب اختصاصی پاراکلینیک — چرخهٔ ۴۸ (گزارش مالک: «در فرم پرونده
                 بیمار برای همشون تب جداگانه بزار») + دابل‌کلیک برای جزئیات کامل ═══ -->
            <TabItem Header="🩻 تصویربرداری" ToolTip="سوابق تصویربرداری بیمار — دابل‌کلیک: جزئیات">
                <DataGrid ItemsSource="{Binding ImagingHistory}" Style="{StaticResource App.DataGrid}">
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                                      Command="{Binding OpenParaDetailsCommand}"
                                      CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="105" />
                        <DataGridTextColumn Header="نوع" Binding="{Binding Title, Converter={StaticResource PersianDigits}}" Width="*" />
                        <DataGridTextColumn Header="وضعیت" Binding="{Binding Subtitle, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="🦷 دندانپزشکی" ToolTip="طرح‌های درمان دندان — دابل‌کلیک: چارت کامل و ردیف‌های طرح">
                <DataGrid ItemsSource="{Binding DentalHistory}" Style="{StaticResource App.DataGrid}">
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                                      Command="{Binding OpenParaDetailsCommand}"
                                      CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="105" />
                        <DataGridTextColumn Header="طرح درمان" Binding="{Binding Title, Converter={StaticResource PersianDigits}}" Width="*" />
                        <DataGridTextColumn Header="هزینه و وضعیت" Binding="{Binding Subtitle, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="160" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="👁️ چشم‌پزشکی" ToolTip="معاینه‌های چشم — دابل‌کلیک: جزئیات کامل عینک‌سنجی">
                <DataGrid ItemsSource="{Binding EyeHistory}" Style="{StaticResource App.DataGrid}">
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                                      Command="{Binding OpenParaDetailsCommand}"
                                      CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="105" />
                        <DataGridTextColumn Header="معاینه" Binding="{Binding Title, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="150" />
                        <DataGridTextColumn Header="خلاصه (IOP/VA/یافته‌ها)" Binding="{Binding Subtitle, Converter={StaticResource PersianDigits}}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="🏃 فیزیوتراپی" ToolTip="جلسات و ارجاع‌های فیزیوتراپی — دابل‌کلیک: جزئیات">
                <DataGrid ItemsSource="{Binding PhysioHistory}" Style="{StaticResource App.DataGrid}">
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                                      Command="{Binding OpenParaDetailsCommand}"
                                      CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="105" />
                        <DataGridTextColumn Header="جلسه" Binding="{Binding Title, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="110" />
                        <DataGridTextColumn Header="تکنیک‌ها/شرح" Binding="{Binding Subtitle, Converter={StaticResource PersianDigits}}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="📎 اسناد">
                <DataGrid ItemsSource="{Binding Documents}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" FontSize="12"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="نوع" Binding="{Binding SourceTable, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="100" />
                        <DataGridTextColumn Header="عنوان" Binding="{Binding Title, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="160" />
                        <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi, Converter={StaticResource PersianDigits}}" Width="Auto" MinWidth="105" />
                        <DataGridTextColumn Header="خلاصه" Binding="{Binding Summary, Converter={StaticResource PersianDigits}}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- ═══ خط زمان — چرخه ۱۳ (درخواست ۱-۵) ═══ -->
            <TabItem Header="🕐 خط زمان">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- نوار فیلترها -->
                    <Border Grid.Row="0" Background="{DynamicResource MaterialDesign.Brush.Background}" CornerRadius="10" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Text="نمایش:" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                <CheckBox Content="📋 ویزیت" IsChecked="{Binding TlVisits}" FontSize="11" Margin="0,0,10,4" />
                                <CheckBox Content="🧪 آزمایش" IsChecked="{Binding TlLabs}" FontSize="11" Margin="0,0,10,4" />
                                <CheckBox Content="🩻 تصویر" IsChecked="{Binding TlImaging}" FontSize="11" Margin="0,0,10,4" />
                                <CheckBox Content="💊 نسخه" IsChecked="{Binding TlPrescriptions}" FontSize="11" Margin="0,0,10,4" />
                                <CheckBox Content="🛎 پذیرش" IsChecked="{Binding TlReceptions}" FontSize="11" Margin="0,0,10,4" />
                                <CheckBox Content="🧾 فاکتور" IsChecked="{Binding TlInvoices}" FontSize="11" Margin="0,0,10,4" />
                                <CheckBox Content="💳 پرداخت" IsChecked="{Binding TlPayments}" FontSize="11" Margin="0,0,10,4" />
                                <!-- چرخهٔ ۴۸ — انواع پاراکلینیک تازه در فیلتر خط زمان -->
                                <CheckBox Content="🦷 دندان" IsChecked="{Binding TlDental}" FontSize="11" Margin="0,0,10,4" />
                                <CheckBox Content="👁️ چشم" IsChecked="{Binding TlEye}" FontSize="11" Margin="0,0,10,4" />
                                <CheckBox Content="🏃 فیزیو" IsChecked="{Binding TlPhysio}" FontSize="11" Margin="0,0,10,4" />
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="سال شمسی:" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                <ComboBox controls:ComboBoxSearch.IsEnabled="False" ItemsSource="{Binding TimelineYears}"
                                          SelectedItem="{Binding TimelineYearFilter}"
                                          MinWidth="110" FontSize="11.5" VerticalAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding}" Value="0">
                                                                <Setter Property="Text" Value="همه سال‌ها" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- خط زمان عمودی -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <!-- ═══ چرخهٔ ۶۷ (گزارش مالک: کرش «Items collection must be empty
                             before using ItemsSource» هنگام گشودن پروندهٔ بیمار) ═══
                             ریشه: صفات مجازی‌سازی چرخهٔ ۶۳ به‌صورت «متن یتیم» بیرون تگ
                             شروع ItemsControl مانده بودند — XAML متن داخل ItemsControl را
                             «آیتم» می‌شمارد ⇒ دو آیتم رشته‌ای در Items نشست و با فعال‌شدن
                             بایندینگ ItemsSource استثنا می‌داد. اکنون صفات داخل خود تگ
                             نشسته‌اند و پنل مجازی‌سازی هم صریح شد (ItemsControl پیش‌فرض
                             مجازی‌سازی ندارد — همان نکتهٔ چرخهٔ ۶۳، این‌بار درست). -->
                        <ItemsControl ItemsSource="{Binding Timeline}" Margin="4,4,4,10"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- ستون تاریخ -->
                                        <Border Grid.Column="0" Width="118" Margin="0,0,10,0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                                CornerRadius="8" Padding="6,4" BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DateShamsi}" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding TimeShamsi, Mode=OneWay}" FontSize="9.5" Opacity="0.55"
                                                           HorizontalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- کارت رویداد -->
                                        <Border Grid.Column="1" Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="9"
                                                Padding="11,7" BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,9,0"
                                                         Fill="{Binding DotColor, Mode=OneWay}"
                                                         Stroke="#FFFFFF" StrokeThickness="2" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding KindLabel, Mode=OneWay}" FontSize="10" FontWeight="Bold"
                                                                   Foreground="#5B708C" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                                   Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Subtitle, Mode=OneWay}" FontSize="10.5" Opacity="0.65"
                                                               Margin="0,2,0,0" TextWrapping="Wrap"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
