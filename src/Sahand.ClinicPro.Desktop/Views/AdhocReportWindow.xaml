<Window xmlns:shortcuts="clr-namespace:Sahand.ClinicPro.Desktop.Services" x:Class="Sahand.ClinicPro.Desktop.Views.AdhocReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:charts="clr-namespace:Sahand.ClinicPro.Desktop.Controls.Charts"
        mc:Ignorable="d"
        Title="گزارش‌ساز رایگانه — سهند کلینیک‌پرو"
        Height="780" Width="1180" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" WindowState="Maximized"

        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        d:DesignHeight="760" d:DesignWidth="1150">
    <!-- ═══ گزارش‌ساز رایگانه (کوئری‌ساز گرافیکی) — چرخه سیزدهم (درخواست ۴-۳) ═══ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- سربرگ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <materialDesign:PackIcon Kind="ChartBoxOutline" Width="28" Height="28" DockPanel.Dock="Right"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
            <TextBlock Text="گزارش‌ساز رایگانه" FontSize="20" FontWeight="Bold" Margin="10,0,8,0"
                       VerticalAlignment="Center" />
            <TextBlock Text="کوئری‌ساز گرافیکی سه‌گامی بدون نیاز به SQL — از لیست سفید موجودیت‌ها گزارش دلخواه بسازید"
                       FontSize="11.5" Opacity="0.65" VerticalAlignment="Center" Margin="4,4,0,0" TextWrapping="Wrap" />
            <Button DockPanel.Dock="Left" Command="{Binding RunCommand}" Style="{StaticResource MaterialDesignRaisedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Play" Width="15" Height="15" VerticalAlignment="Center" />
                    <TextBlock Text="اجرای گزارش" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,10"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!-- بدنه: ستون تنظیمات (راست) + نتایج (چپ) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="470" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══ ستون راست: سه گام ساخت گزارش ═══ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                <StackPanel>
                    <!-- گام ۱: موجودیت و ستون‌ها -->
                    <materialDesign:Card UniformCornerRadius="12" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Border Background="{DynamicResource MaterialDesign.Brush.Primary}" CornerRadius="10"
                                        Width="24" Height="24" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <TextBlock Text="۱" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="موجودیت و ستون‌ها" FontSize="14" FontWeight="Bold" Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <ComboBox ItemsSource="{Binding Entities}" SelectedItem="{Binding SelectedEntity}"
                                      materialDesign:HintAssist.Hint="موجودیت داده" FontSize="12.5" Margin="0,0,0,8" />
                            <ListBox ItemsSource="{Binding Fields}" Background="Transparent" BorderThickness="0"
                                     MaxHeight="240" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2,3" FontSize="12">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Type}" FontSize="9.5" Opacity="0.45"
                                                           Margin="6,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource App.CodeFont}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- گام ۲: فیلترها -->
                    <materialDesign:Card UniformCornerRadius="12" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Border Background="{DynamicResource MaterialDesign.Brush.Primary}" CornerRadius="10"
                                        Width="24" Height="24" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <TextBlock Text="۲" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="فیلترها (اختیاری)" FontSize="14" FontWeight="Bold" Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Left" Command="{Binding AddFilterCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Padding="8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock Text="افزودن" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Filters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                                                CornerRadius="8" Padding="8,6" Margin="0,0,0,6">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox Grid.Column="0" ItemsSource="{Binding DataContext.FilterableFields, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedItem="{Binding Field}" DisplayMemberPath="Title"
                                                              materialDesign:HintAssist.Hint="فیلد" FontSize="11.5" />
                                                    <Button Grid.Column="1" Command="{Binding DataContext.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Padding="6,2"
                                                            VerticalAlignment="Center" Margin="4,0,0,0" ToolTip="حذف فیلتر">
                                                        <materialDesign:PackIcon Kind="Close" Width="13" Height="13" Foreground="#E53935" />
                                                    </Button>
                                                </Grid>
                                                <ComboBox ItemsSource="{Binding DataContext.Operators, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedValuePath="Key" DisplayMemberPath="Value"
                                                          SelectedValue="{Binding Op, Mode=TwoWay}"
                                                          materialDesign:HintAssist.Hint="عملگر" FontSize="11.5" Margin="0,6,0,0" />
                                                <!-- ورودی مقدار — بر اساس نوع فیلد: شمارشی/متن/تاریخ -->
                                                <ComboBox ItemsSource="{Binding Field.Options}" SelectedItem="{Binding Value1, Mode=TwoWay}"
                                                          Visibility="{Binding Field.Options, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}"
                                                          materialDesign:HintAssist.Hint="مقدار" FontSize="11.5" Margin="0,6,0,0"
                                                          IsEditable="True" />
                                                <TextBox Text="{Binding Value1, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                         materialDesign:HintAssist.Hint="مقدار (متن/عدد/تاریخ ۱۴۰۴-۰۱-۰۱)" FontSize="11.5" Margin="0,6,0,0" />
                                                <TextBox Text="{Binding Value2, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                         materialDesign:HintAssist.Hint="مقدار دوم"
                                                         Visibility="{Binding NeedsSecondValue, Converter={StaticResource BoolToVisibility}}"
                                                         FontSize="11.5" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="فیلدهای محاسبه‌شده (نام بیمار/پزشک) قابل فیلتر نیستند" FontSize="10"
                                       Opacity="0.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- گام ۳: گروه‌بندی و تجمیع -->
                    <materialDesign:Card UniformCornerRadius="12" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Border Background="{DynamicResource MaterialDesign.Brush.Primary}" CornerRadius="10"
                                        Width="24" Height="24" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <TextBlock Text="۳" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="گروه‌بندی و تجمیع (اختیاری)" FontSize="14" FontWeight="Bold" Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding GroupByField}" DisplayMemberPath="Title"
                                      materialDesign:HintAssist.Hint="گروه‌بندی بر اساس" FontSize="12" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding AggregateOptions}" SelectedItem="{Binding Aggregate}"
                                          materialDesign:HintAssist.Hint="تجمیع" FontSize="12" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding NumericFields}" SelectedItem="{Binding AggregateField}"
                                          DisplayMemberPath="Title" materialDesign:HintAssist.Hint="فیلد عددی" FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- پارامترها و ذخیره -->
                    <materialDesign:Card UniformCornerRadius="12" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="پارامترها و ذخیره" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="سقف ردیف: " VerticalAlignment="Center" FontSize="12" />
                                <TextBox Grid.Column="1" Text="{Binding Limit, UpdateSourceTrigger=PropertyChanged}" FontSize="12"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding ChartOptions}" SelectedItem="{Binding ChartType}"
                                          materialDesign:HintAssist.Hint="نوع نمودار" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding ReportName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="نام گزارش برای ذخیره" FontSize="12" />
                                <Button shortcuts:SaveShortcut.Number="1" Grid.Column="2" Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignOutlinedButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="ذخیره (Ctrl+Shift+1)" Margin="5,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Text="گزارش‌های ذخیره‌شده" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding SavedReports}" SelectedItem="{Binding SelectedSavedReport}"
                                          DisplayMemberPath="ReportName" materialDesign:HintAssist.Hint="انتخاب برای اجرای مجدد" FontSize="12" />
                                <Button Grid.Column="1" Command="{Binding RunSavedCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="4,0,0,0" ToolTip="اجرای مجدد" Padding="8,6">
                                    <materialDesign:PackIcon Kind="PlayCircleOutline" Width="15" Height="15" />
                                </Button>
                                <Button Grid.Column="2" Command="{Binding DeleteSavedCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="4,0,0,0" ToolTip="حذف تعریف" Padding="8,6">
                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="15" Height="15" Foreground="#E53935" />
                                </Button>
                                <Button Grid.Column="3" Command="{Binding ExportCsvCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="4,0,0,0" ToolTip="خروجی CSV از نتایج فعلی" Padding="8,6">
                                    <materialDesign:PackIcon Kind="FileDelimited" Width="15" Height="15" Foreground="#43A047" />
                                </Button>
                                <Button Grid.Column="4" Command="{Binding ExportPdfCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="4,0,0,0" ToolTip="خروجی PDF با سربرگ درمانگاه" Padding="8,6">
                                    <materialDesign:PackIcon Kind="FilePdfBox" Width="15" Height="15" Foreground="#E53935" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ ستون چپ: نتایج ═══ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- پیام خطای اعتبارسنجی -->
                <Border Grid.Row="0" Padding="14,10" CornerRadius="10" Background="#FFEBEE" Margin="2,0,2,10"
                        Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="{Binding UnavailableMessage}" FontSize="12.5" Foreground="#C62828" TextWrapping="Wrap" />
                </Border>

                <!-- کارت‌های خلاصه -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding SummaryCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="12,8" Margin="3" Background="#E3F2FD" MinWidth="130">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontSize="10.5" Opacity="0.7"  Foreground="#1F2937"/>
                                    <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="Bold" FontFamily="{DynamicResource App.CodeFont}"  Foreground="#1F2937"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- جدول و نمودار -->
                <Grid Grid.Row="2" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <materialDesign:Card Grid.Row="0" UniformCornerRadius="12" Padding="14" Margin="2,8,2,8"
                                        Visibility="{Binding HasChart, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <materialDesign:PackIcon Kind="ChartBoxOutline" Width="18" Height="18"
                                                         Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ChartTitle}" FontSize="13.5" FontWeight="Bold" Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <Grid Grid.Row="1" Height="210">
                                <charts:ColumnChart Points="{Binding ChartPoints}" ValueFormat="N0" Visibility="Collapsed">
                                    <charts:ColumnChart.Style>
                                        <Style TargetType="charts:ColumnChart">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ChartKind}" Value="column">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </charts:ColumnChart.Style>
                                </charts:ColumnChart>
                                <charts:DoughnutChart Points="{Binding ChartPoints}" CenterText="{Binding ChartCenterText}"
                                                      CenterSubtext="{Binding ChartUnit}" RingSize="155" Visibility="Collapsed">
                                    <charts:DoughnutChart.Style>
                                        <Style TargetType="charts:DoughnutChart">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ChartKind}" Value="doughnut">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </charts:DoughnutChart.Style>
                                </charts:DoughnutChart>
                                <charts:HorizontalBarChart Points="{Binding ChartPoints}" BarMaxWidth="420" Visibility="Collapsed">
                                    <charts:HorizontalBarChart.Style>
                                        <Style TargetType="charts:HorizontalBarChart">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ChartKind}" Value="hbar">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </charts:HorizontalBarChart.Style>
                                </charts:HorizontalBarChart>
                            </Grid>
                        </Grid>
                    </materialDesign:Card>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" FontSize="12" AlternatingRowBackground="{DynamicResource App.ZebraRowBrush}"
                              x:Name="ResultsGrid" />
                </Grid>

                <!-- حالت خالی -->
                <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasResult, Converter={StaticResource InverseBoolToVisibility}}">
                    <materialDesign:PackIcon Kind="ChartBoxPlusOutline" Width="64" Height="64" Opacity="0.25" HorizontalAlignment="Center" />
                    <TextBlock Text="از ستون راست گزارش خود را بسازید و «اجرای گزارش» را بزنید" FontSize="13" Opacity="0.55"
                               HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
