<Window x:Class="Sahand.ClinicPro.Desktop.Views.QuickSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="جستجوی سریع"
        Height="480" Width="640"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        SizeToContent="Height"
        MaxHeight="640"
        Focusable="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         پنجرهٔ جستجوی یکپارچه — چرخهٔ ۶۹ (فاز ۳ / F-06 نقشه راه ai-review)
         «جستجوی یکپارچه Ctrl+K (بیمار/نوبت/نسخه)» — باز شدن با Ctrl+K از
         هر جای برنامه؛ تایپ زنده با مکث؛ نتایج گروه‌بندی‌شده با آیکون حوزه؛
         ↑↓ جابه‌جایی · Enter اجرا · Esc بستن.
         ═══════════════════════════════════════════════════════════════ -->
    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="0" Background="White">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- جعبهٔ جستجو — فوکوس خودکار -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <materialDesign:PackIcon Kind="Magnify" Width="24" Height="24"
                                         Foreground="#00897B" VerticalAlignment="Center"
                                         Margin="0,0,10,0" />
                <TextBox x:Name="SearchBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="16" Padding="6,8"
                         VerticalContentAlignment="Center"
                         KeyDown="SearchBox_KeyDown"
                         materialDesign:HintAssist.Hint="نام بیمار، کد ملی، موبایل، شمارهٔ نوبت یا نسخه…" />
                <ProgressBar IsIndeterminate="True" Height="3" DockPanel.Dock="Bottom"
                             Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" />
            </DockPanel>

            <!-- نتایج -->
            <ListBox Grid.Row="2"
                     x:Name="ResultsList"
                     ItemsSource="{Binding Results}"
                     SelectedItem="{Binding SelectedResult}"
                     Background="Transparent" BorderThickness="0"
                     KeyDown="ResultsList_KeyDown"
                     MouseDoubleClick="ResultsList_MouseDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold"
                                           Foreground="#00897B" Margin="4,8,4,3" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,3" Cursor="Hand">
                            <Border Width="34" Height="34" CornerRadius="17" Background="#E0F2F1"
                                    VerticalAlignment="Center" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="{Binding IconKind}" Width="18" Height="18"
                                                         Foreground="#00897B"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="#1F2937" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#6B7280"
                                           FontFamily="{DynamicResource App.CodeFont}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- حالت خالی -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}">
                <materialDesign:PackIcon Kind="FileSearchOutline" Width="44" Height="44"
                                         Foreground="#B0BEC5" HorizontalAlignment="Center" />
                <TextBlock Text="نتیجه‌ای یافت نشد" FontSize="13" Foreground="#78909C"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>

            <!-- راهنمای کلیدها -->
            <Border Grid.Row="3" CornerRadius="8" Background="#F5F7FB" Padding="10,5"
                    Margin="0,10,0,0" BorderBrush="#E0E0E0" BorderThickness="1">
                <TextBlock Text="{Binding HintText}" FontSize="11" Foreground="#607D8B"
                           HorizontalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</Window>
