<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.ReportBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="660" d:DesignWidth="1140"
             FlowDirection="RightToLeft"
             FontFamily="Vazirmatn, Segoe UI, Tahoma">
    <!-- ═══ گزارش‌ساز — گام U16 طبق فرم ۲۷: سایدبار دسته‌ها + محتوا ═══ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <materialDesign:PackIcon Kind="FileChart" Width="26" Height="26"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
            <TextBlock Text="گزارش‌ساز" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!-- گرید: سایدبار ۲۳۰px + کاتالوگ ۲۴۰px + محتوا -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══ ستون راست: دسته‌ها ═══ -->
            <Border Grid.Column="0" CornerRadius="10" Margin="0,0,8,0"
                    Background="{DynamicResource MaterialDesign.Brush.Background.Variant}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" materialDesign:HintAssist.Hint="🔍 جستجوی گزارش"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="2,0,2,8" FontSize="12" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,7">
                                    <TextBlock Text="{Binding Icon}" FontSize="15" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Count}" FontSize="11" Opacity="0.55" Margin="8,0,0,0"
                                               VerticalAlignment="Center" FontFamily="Consolas" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ═══ ستون میانه: کاتالوگ گزارش‌های دسته ═══ -->
            <Border Grid.Column="1" CornerRadius="10" Margin="0,0,8,0"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Background.Variant}" BorderThickness="1" Padding="6">
                <ListBox ItemsSource="{Binding SelectedCategory.Reports}" SelectedItem="{Binding SelectedReport}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,6">
                                <TextBlock Text="📄" FontSize="12" />
                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Description}" FontSize="10" Opacity="0.6" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- ═══ ستون چپ: پارامترها + نتایج ═══ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- مشخصات گزارش -->
                <StackPanel Grid.Row="0" Margin="2,2,2,10">
                    <TextBlock Text="{Binding ReportTitle}" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                    <TextBlock Text="{Binding ReportDescription}" FontSize="11.5" Opacity="0.7" Margin="0,3,0,0" />
                </StackPanel>

                <!-- پارامترها — گام P1: پویا بر اساس گزارش انتخاب‌شده -->
                <StackPanel Grid.Row="1" Margin="2,0,2,10"
                            Visibility="{Binding IsReportAvailable, Converter={StaticResource BoolToVisibility}}">
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,6"
                                    Visibility="{Binding HasDateRange, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="از: " VerticalAlignment="Center" FontSize="12" />
                            <DatePicker SelectedDate="{Binding FromDate}" Width="120" FontSize="12" />
                            <TextBlock Text=" تا: " VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0" />
                            <DatePicker SelectedDate="{Binding ToDate}" Width="120" FontSize="12" />
                        </StackPanel>
                        <!-- تعداد ماه — گزارش انقضا / بدون مراجعه -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,6"
                                    Visibility="{Binding HasMonthsParam, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="ماه: " VerticalAlignment="Center" FontSize="12" />
                            <TextBox Text="{Binding Months, UpdateSourceTrigger=PropertyChanged}" Width="56" FontSize="12"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="۶" />
                        </StackPanel>
                        <!-- کد ICD — گزارش بیماری مزمن -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,6"
                                    Visibility="{Binding HasIcdParam, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="کد ICD: " VerticalAlignment="Center" FontSize="12" />
                            <TextBox Text="{Binding IcdCode, UpdateSourceTrigger=PropertyChanged}" Width="90" FontSize="12"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="مثلاً E11" />
                        </StackPanel>
                        <!-- حداقل مبلغ — لیست بدهکاران -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,6"
                                    Visibility="{Binding HasMinAmountParam, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="حداقل مبلغ: " VerticalAlignment="Center" FontSize="12" />
                            <TextBox Text="{Binding MinAmount, UpdateSourceTrigger=PropertyChanged}" Width="110" FontSize="12"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="ریال" />
                        </StackPanel>
                        <!-- سقف نتایج -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,6"
                                    Visibility="{Binding HasTopParam, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="تعداد: " VerticalAlignment="Center" FontSize="12" />
                            <TextBox Text="{Binding TopCount, UpdateSourceTrigger=PropertyChanged}" Width="56" FontSize="12"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="۲۰" />
                        </StackPanel>
                        <Button Command="{Binding ExecuteCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Play" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="اجرای گزارش" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExcel" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="Excel" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,6" ToolTip="چاپ مستقیم نتایج">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="چاپ" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <!-- انتخابگر بیمار — گزارش صورت‌حساب بیمار -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                Visibility="{Binding HasPatientParam, Converter={StaticResource BoolToVisibility}}">
                        <materialDesign:PackIcon Kind="AccountSearch" Width="18" Height="18" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                        <TextBlock Text="بیمار: " VerticalAlignment="Center" FontSize="12" Margin="6,0,6,0" />
                        <TextBox Text="{Binding PatientSearchTerm, UpdateSourceTrigger=PropertyChanged}" Width="220" FontSize="12"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="نام / کد ملی / موبایل / شماره پرونده" />
                        <Button Command="{Binding SearchPatientsCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="6,0,0,0">
                            <materialDesign:PackIcon Kind="Magnify" Width="14" Height="14" />
                        </Button>
                        <ComboBox ItemsSource="{Binding PatientResults}" SelectedItem="{Binding SelectedPatient}"
                                  Width="300" Margin="10,0,0,0" FontSize="12" materialDesign:HintAssist.Hint="بیمار یافت‌شده">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                        <TextBlock Text="{Binding MedicalRecordNo}" FontFamily="Consolas" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding FirstName}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding LastName}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding NationalCode}" FontFamily="Consolas" FontSize="11" Opacity="0.55" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <!-- پیام گزارش در دسترس نیست -->
                <Border Grid.Row="2" Padding="14,10" CornerRadius="10" Background="#FFF8E1" Margin="2,0,2,10"
                        Visibility="{Binding IsReportAvailable, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="{Binding UnavailableMessage, TargetNullValue='این گزارش هنوز داده واقعی ندارد'}"
                               FontSize="12" Foreground="#E65100" TextWrapping="Wrap" />
                </Border>

                <!-- نتایج -->
                <Grid Grid.Row="3" Visibility="{Binding IsReportAvailable, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- کارت‌های خلاصه -->
                    <ItemsControl Grid.Row="0" ItemsSource="{Binding SummaryCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="12,8" Margin="3" Background="#E3F2FD" MinWidth="130">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="10.5" Opacity="0.7" />
                                        <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="Bold" FontFamily="Consolas" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- جدول نتایج — ستون‌های داینامیک -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" FontSize="12" AlternatingRowBackground="#F7FAFD"
                              x:Name="ResultsGrid" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
