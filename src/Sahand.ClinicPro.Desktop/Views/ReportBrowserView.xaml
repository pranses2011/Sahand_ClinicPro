<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.ReportBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:charts="clr-namespace:Sahand.ClinicPro.Desktop.Controls.Charts"
             xmlns:controls="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1180"
             FlowDirection="RightToLeft">
    <!-- ═══════════════════════════════════════════════════════════
         گزارش‌ساز — بازطراحی تب‌بندی‌شدهٔ چرخهٔ ۷0 (گزارش مالک):
         «گزینه‌ها به‌جای اینکه در کنار صفحه باشند، به‌صورت تب‌بندی‌شده
         باشند تا ظاهر زیبا داشته باشد» — جایگزینی چیدمان سه‌ستونهٔ
         (دسته‌ها | کاتالوگ | نتایج) با:
           ردیف ۱: نوار ابزار (جستجو + فیلتر نوع + گزارش‌ساز رایگانه)
           ردیف ۲: تب‌های دسته (۹ دسته با آیکون و نشان شمار)
                    و درون هر تب، کارت‌های افقی گزارش‌های همان دسته
           ردیف ۳: پنل پارامترها + نتایج (خلاصه‌های فارسی + نمودار + جدول)
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
        </Grid.LayoutTransform>

        <!-- ═══ ردیف ۱: نوار ابزار ═══ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Border Width="40" Height="40" CornerRadius="11" Background="#E8F5E9" VerticalAlignment="Center" Margin="0,0,10,0">
                    <materialDesign:PackIcon Kind="FileChart" Width="21" Height="21" Foreground="#2E7D32"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="گزارش‌ساز" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
                <Button Command="{Binding OpenAdhocBuilderCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="14,0,0,0" FontSize="12"
                        ToolTip="کوئری‌ساز گرافیکی سه‌گامی — بدون نیاز به SQL گزارش دلخواه بسازید">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ChartBoxOutline" Width="14" Height="14" VerticalAlignment="Center" />
                        <TextBlock Text="گزارش‌ساز رایگانه" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBox materialDesign:HintAssist.Hint="🔍 جستجوی گزارش…"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="220" FontSize="12" />
                <ComboBox controls:ComboBoxSearch.IsEnabled="False" materialDesign:HintAssist.Hint="نوع"
                          ItemsSource="{Binding ReportTypeFilters}"
                          SelectedIndex="{Binding TypeFilterIndex}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          FontSize="12" Margin="8,0,0,0" MinWidth="150"
                          ToolTip="جدولی‌ها خروجی چاپ/اکسل/PDF دارند؛ نموداری‌ها خروجی تصویری" />
            </StackPanel>
        </DockPanel>

        <ProgressBar Grid.Row="0" Grid.Column="0" IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                     VerticalAlignment="Bottom"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!-- ═══ ردیف ۲: تب‌های دسته + کارت‌های گزارش همان دسته ═══ -->
        <TabControl Grid.Row="1"
                    ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding SelectedCategory}"
                    materialDesign:ColorZoneAssist.Mode="PrimaryLight"
                    MinHeight="190" MaxHeight="250">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2,0">
                        <TextBlock Text="{Binding Icon}" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Title}" FontSize="12.5" Margin="7,0,0,0" VerticalAlignment="Center" />
                        <Border CornerRadius="9" Background="#E3F2FD" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Count}" FontSize="10.5" Foreground="#1565C0"
                                       FontFamily="{DynamicResource App.CodeFont}" />
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <!-- کارت‌های افقی گزارش‌های این دسته — انتخاب = اجرای پارامترها پایین -->
                    <ListBox ItemsSource="{Binding Reports}"
                             SelectedItem="{Binding DataContext.SelectedReport, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Background="Transparent" BorderThickness="0" Padding="4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="215" Margin="4,5" Padding="11,9" CornerRadius="10"
                                        Background="{DynamicResource MaterialDesign.Brush.Card.Background}" BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1.2"
                                        Cursor="Hand">
                    <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="📄" FontSize="13" DockPanel.Dock="Right"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="10" Opacity="0.62"
                                               TextWrapping="Wrap" Margin="0,3,0,0"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <!-- ═══ ردیف ۳: پنل اجرا + نتایج ═══ -->
        <ScrollViewer Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- عنوان و توضیح گزارش انتخاب‌شده -->
                <Border Grid.Row="0" CornerRadius="10" Background="#F5F9FD" BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                        BorderThickness="1" Padding="14,10" Margin="0,0,0,10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Top">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#E3F2FD" VerticalAlignment="Center" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="PlayCircleOutline" Width="19" Height="19" Foreground="#1565C0"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding ReportTitle}" FontSize="16.5" FontWeight="Bold"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <TextBlock Text="{Binding ReportDescription}" FontSize="11.5" Opacity="0.72" Margin="0,3,0,0" TextWrapping="Wrap"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- پارامترها + دکمه‌های اجرا/خروجی -->
                <Border Grid.Row="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,10"
                        Background="{DynamicResource MaterialDesign.Brush.Card.Background}" BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1.2"
                        Visibility="{Binding IsReportAvailable, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <WrapPanel>
                            <!-- ═══ چرخهٔ ۷۲ — عرض فیلدهای تاریخ: پیش‌تر Width=125 ثابت بود و
                                 تاریخ کامل «۱۴۰۴/۰۷/۲۰» در DPI/زوم‌های مختلف بریده می‌شد؛
                                 اکنون MinWidth=165 + عرض کشسان ⇒ تاریخ کامل همیشه خوانده می‌شود ═══ -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,8"
                                        Visibility="{Binding HasDateRange, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="از: " VerticalAlignment="Center" FontSize="12"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                <controls:JalaliDatePicker SelectedDate="{Binding FromDate}" MinWidth="165" />
                                <TextBlock Text=" تا: " VerticalAlignment="Center" FontSize="12" Margin="10,0,0,0"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                <controls:JalaliDatePicker SelectedDate="{Binding ToDate}" MinWidth="165" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,8"
                                        Visibility="{Binding HasMonthsParam, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="ماه: " VerticalAlignment="Center" FontSize="12"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                <TextBox Text="{Binding Months, UpdateSourceTrigger=PropertyChanged}" Width="56" FontSize="12"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="۶" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,8"
                                        Visibility="{Binding HasIcdParam, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="کد ICD: " VerticalAlignment="Center" FontSize="12"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                <TextBox Text="{Binding IcdCode, UpdateSourceTrigger=PropertyChanged}" Width="90" FontSize="12"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="مثلاً E11" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,8"
                                        Visibility="{Binding HasMinAmountParam, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="حداقل مبلغ: " VerticalAlignment="Center" FontSize="12"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                <TextBox Text="{Binding MinAmount, UpdateSourceTrigger=PropertyChanged}" Width="110" FontSize="12"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="{DynamicResource App.CurrencyLabel}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,8"
                                        Visibility="{Binding HasTopParam, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="تعداد: " VerticalAlignment="Center" FontSize="12"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                <TextBox Text="{Binding TopCount, UpdateSourceTrigger=PropertyChanged}" Width="56" FontSize="12"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="۲۰" />
                            </StackPanel>
                            <Button Command="{Binding ExecuteCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Play" Width="14" Height="14" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                    <TextBlock Text="اجرای گزارش" Margin="6,0,0,0" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileExcel" Width="14" Height="14" VerticalAlignment="Center" Foreground="#2E7D32" />
                                    <TextBlock Text="اکسل" Margin="6,0,0,0" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ExportPdfCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,8"
                                    ToolTip="PDF صفحه‌آرایی‌شده با سربرگ رسمی درمانگاه و محل امضا">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilePdfBox" Width="14" Height="14" VerticalAlignment="Center" Foreground="#E53935" />
                                    <TextBlock Text="PDF" Margin="6,0,0,0" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ExportImageCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,8"
                                    ToolTip="ذخیرهٔ تصویر نتایج (خلاصه‌ها + نمودار + جدول) — فرمت PNG/JPEG/BMP/GIF/TIFF هنگام ذخیره انتخاب می‌شود">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileImage" Width="14" Height="14" VerticalAlignment="Center" Foreground="#00897B" />
                                    <TextBlock Text="تصویر" Margin="6,0,0,0" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding PrintReportCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,8"
                                    ToolTip="چاپ مستقیم نتایج با سربرگ و تاریخ شمسی">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Printer" Width="14" Height="14" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                    <TextBlock Text="چاپ" Margin="6,0,0,0" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <!-- انتخابگر بیمار — گزارش صورت‌حساب بیمار -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                    Visibility="{Binding HasPatientParam, Converter={StaticResource BoolToVisibility}}">
                            <materialDesign:PackIcon Kind="AccountSearch" Width="18" Height="18" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <TextBlock Text="بیمار: " VerticalAlignment="Center" FontSize="12" Margin="6,0,6,0"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                            <TextBox Text="{Binding PatientSearchTerm, UpdateSourceTrigger=PropertyChanged}" Width="220" FontSize="12"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="نام / کد ملی / موبایل / شماره پرونده">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchPatientsCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Command="{Binding SearchPatientsCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="6,0,0,0">
                                <materialDesign:PackIcon Kind="Magnify" Width="14" Height="14"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                            </Button>
                            <ComboBox controls:ComboBoxSearch.IsEnabled="False" ItemsSource="{Binding PatientResults}" SelectedItem="{Binding SelectedPatient}"
                                      Width="300" Margin="10,0,0,0" FontSize="12" materialDesign:HintAssist.Hint="بیمار یافت‌شده">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                            <TextBlock Text="{Binding MedicalRecordNo}" FontFamily="{DynamicResource App.CodeFont}" FontSize="11" Opacity="0.7" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                            <TextBlock Text="{Binding FirstName}" Margin="8,0,0,0" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                            <TextBlock Text="{Binding LastName}" Margin="4,0,0,0" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                            <TextBlock Text="{Binding NationalCode}" FontFamily="{DynamicResource App.CodeFont}" FontSize="11" Opacity="0.55" Margin="8,0,0,0" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- پیام گزارش در دسترس نیست -->
                <Border Grid.Row="2" Padding="14,10" CornerRadius="10" Background="#FFF8E1" Margin="0,0,0,10"
                        Visibility="{Binding IsReportAvailable, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="{Binding UnavailableMessage, TargetNullValue='این گزارش هنوز داده واقعی ندارد'}"
                               FontSize="12" Foreground="#E65100" TextWrapping="Wrap" />
                </Border>

                <!-- پیام شکست اجرا -->
                <Border Grid.Row="2" Padding="14,10" CornerRadius="10" Background="#FDECEA" Margin="0,0,0,10"
                        Visibility="{Binding ResultNotice, Converter={StaticResource StringToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertCircle" Width="18" Height="18"
                                                 Foreground="#C62828" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <StackPanel>
                            <TextBlock Text="اجرای گزارش ناموفق بود" FontSize="12.5" FontWeight="Bold" Foreground="#C62828" />
                            <TextBlock Text="{Binding ResultNotice}" FontSize="12" Foreground="#8E2A20" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ نتایج ═══ -->
                <Grid Grid.Row="3" Visibility="{Binding IsReportAvailable, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="220" />
                    </Grid.RowDefinitions>

                    <!-- کارت‌های خلاصه — برچسب فارسی از کاتالوگ چرخهٔ ۷۰ -->
                    <ItemsControl Grid.Row="0" ItemsSource="{Binding SummaryCards}" Margin="0,2,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="13,9" Margin="3" Background="#E3F2FD" MinWidth="135">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="10.5" Opacity="0.72"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                        <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="Bold"
                                                   FontFamily="{DynamicResource App.CodeFont}" Foreground="#0D47A1" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- کارت نمودار -->
                    <materialDesign:Card Grid.Row="1" UniformCornerRadius="12" Padding="14" Margin="2,2,2,8"
                                         Visibility="{Binding HasChart, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <materialDesign:PackIcon Kind="ChartAreasplineVariant" Width="18" Height="18"
                                                         Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ChartTitle}" FontSize="13.5" FontWeight="Bold"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ChartUnit, StringFormat=({0})}" FontSize="10" Opacity="0.5"
                                           VerticalAlignment="Bottom" Margin="6,0,0,2" />
                            </DockPanel>

                            <Grid Grid.Row="1" Height="230">
                                <charts:AreaChart x:Name="AreaHost" Points="{Binding ChartPoints}" ValueFormat="N0">
                                    <charts:AreaChart.Style>
                                        <Style TargetType="charts:AreaChart">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ChartKind}" Value="area">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </charts:AreaChart.Style>
                                </charts:AreaChart>

                                <charts:ColumnChart x:Name="ColumnHost" Points="{Binding ChartPoints}" ValueFormat="N0">
                                    <charts:ColumnChart.Style>
                                        <Style TargetType="charts:ColumnChart">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ChartKind}" Value="column">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </charts:ColumnChart.Style>
                                </charts:ColumnChart>

                                <charts:DoughnutChart x:Name="DoughnutHost" Points="{Binding ChartPoints}"
                                                      CenterText="{Binding ChartCenterText}"
                                                      CenterSubtext="{Binding ChartUnit}"
                                                      RingSize="170">
                                    <charts:DoughnutChart.Style>
                                        <Style TargetType="charts:DoughnutChart">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ChartKind}" Value="doughnut">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </charts:DoughnutChart.Style>
                                </charts:DoughnutChart>

                                <charts:HorizontalBarChart x:Name="HBarHost" Points="{Binding ChartPoints}"
                                                           BarMaxWidth="480">
                                    <charts:HorizontalBarChart.Style>
                                        <Style TargetType="charts:HorizontalBarChart">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ChartKind}" Value="hbar">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </charts:HorizontalBarChart.Style>
                                </charts:HorizontalBarChart>
                            </Grid>
                        </Grid>
                    </materialDesign:Card>

                    <!-- جدول نتایج — ستون‌های داینامیک از کد پشت -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" FontSize="12"
                              MinHeight="180" MaxHeight="330"
                              x:Name="ResultsGrid" />
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
