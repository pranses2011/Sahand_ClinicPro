<UserControl xmlns:shortcuts="clr-namespace:Sahand.ClinicPro.Desktop.Services" x:Class="Sahand.ClinicPro.Desktop.Views.ComplementaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Sahand.ClinicPro.Desktop.ViewModels"
             xmlns:views="clr-namespace:Sahand.ClinicPro.Desktop.Views"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100"
             FlowDirection="RightToLeft">
    <!-- ═══ فرم‌های تکمیلی — گام U19: قالب چاپ + نظرسنجی + همگام‌سازی ═══ -->
    <!-- ═══════════════════════════════════════════════════════════════
         لایهبندی «نمای تأییدشده / نمای کامل» — قالب چاپ و طب مکمل
         لایهٔ نخست همان طرحی است که مالک تأیید کرد (فایل PrintTemplateDesignView.xaml)؛
         لایهٔ دوم همان محتوای کامل و قدیمی این صفحه است تا هیچ تب، فرم یا
         تنظیماتی از بین نرود. کلید کوچک «تغییر نما» پایین صفحه جابهجا میکند.
         پیشفرض = نمای تأییدشده؛ حالت اسکرینشات هم همان را میگیرد.
         ═══════════════════════════════════════════════════════════════ -->
    <Grid>
        <ToggleButton x:Name="DsModeToggle" IsChecked="False" Style="{StaticResource App.PlainToggleButton}" Panel.ZIndex="10"
                      HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,1"
                      Padding="2,0" FontSize="8" Opacity="0.55" Cursor="Hand"
                      Focusable="False" FocusVisualStyle="{x:Null}"
                      Foreground="#8A9AAE" Content="طرح نمایشی (غیرعملیاتی) ↗">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                               FontSize="8" Background="Transparent" />
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
        <Grid Visibility="{Binding IsChecked, ElementName=DsModeToggle, Converter={StaticResource BoolToVisibility}}">
            <views:PrintTemplateDesignView />
        </Grid>
    <Grid Margin="16,12" Visibility="{Binding IsChecked, ElementName=DsModeToggle, Converter={StaticResource InverseBoolToVisibility}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <materialDesign:PackIcon Kind="TuneVertical" Width="26" Height="26"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
            <TextBlock Text="فرم‌های تکمیلی" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <TabControl Grid.Row="2" SelectedIndex="{Binding TabIndex}" Style="{StaticResource MaterialDesignTabControl}">

            <!-- ─── تب ۱: طراح قالب‌های چاپ — چرخه ۱۳ (درخواست ۱-۶) ─── -->
            <TabItem Header="🖨️ طراح قالب چاپ">
                <DockPanel Margin="4,8">
                    <Border DockPanel.Dock="Top" CornerRadius="12" Padding="17,12" Margin="0,0,0,12">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#173B61" Offset="0"/><GradientStop Color="#087B83" Offset="1"/></LinearGradientBrush></Border.Background>
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Content="باز کردن طراح بصری" Click="OnVisualTemplateEditor"
                                    IsEnabled="{Binding SelectedTemplate.IsHtmlTemplate}" Padding="13,6" />
                            <StackPanel>
                                <TextBlock Text="مرکز طراحی قالب چاپ" FontSize="17" FontWeight="Bold" Foreground="White" />
                                <TextBlock Text="انتخاب سند، طراحی و پیش‌نمایش پیش از ذخیره" Foreground="#D3EDF1" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Margin="0,0,10,0" Background="#F6FAFD" BorderBrush="#D8E7F0" BorderThickness="1" CornerRadius="12" />
                    <Border Grid.Column="1" Margin="0,0,10,0" Background="#F8FBFD" BorderBrush="#D8E7F0" BorderThickness="1" CornerRadius="12" />

                    <!-- ستون ۱: فیلتر موجودیت + فهرست قالب‌ها + ساخت جدید -->
                    <Grid Grid.Column="0" Margin="12,12,20,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- ═══ چرخهٔ سی‌وپنجم (گزارش مالک) — فیلتر موجودیت ═══
                             «باید فقط طرح‌های مربوط به موجودیتی که از لیست انتخاب
                             می‌کنیم نمایش داده شود» — انتخابگر موجودیت بالای فهرست؛
                             فهرست پایین فقط قالب‌های همان موجودیت را نشان می‌دهد.
                             آیتم‌ها در کد-پشت از TemplateFilterOptions پر می‌شوند
                             (DisplayMemberPath=fa: نام فارسی هر نوع) -->
                        <TextBlock Grid.Row="0" Text="نمایش قالب‌های:"
                                   FontSize="11" FontWeight="SemiBold" Margin="2,0,0,4" />
                        <!-- ═══ چرخهٔ سی‌وهفتم (ریشهٔ «گزینه‌های سفید بدون متن») ═══
                             DisplayMemberPath فقط به «Property» بایند می‌شود؛
                             ValueTuple فیلد عمومی دارد (Item1/Item2) نه Property —
                             مسیر "Item2" همیشه تهی برمی‌گرداند و همهٔ گزینه‌ها
                             سفید/خالی می‌شدند. گزینه‌ها حالا رکورد
                             TemplateTypeOption با Property واقعی «Fa» هستند. -->
                        <ComboBox x:Name="TemplateFilterCombo" Grid.Row="1"
                                  SelectedIndex="{Binding TemplateFilterIndex}"
                                  DisplayMemberPath="Fa"
                                  FontSize="11.5" Margin="0,0,0,8" />
                        <ListBox Grid.Row="2" ItemsSource="{Binding VisibleTemplates}" SelectedItem="{Binding SelectedTemplate}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,7" Width="230">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" FontSize="15" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding BadgeText, Mode=OneWay}" FontSize="9.5" Foreground="#F9A825"
                                                       FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding TypeFa}" FontSize="10" Opacity="0.55" Margin="23,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- ردیف ۳: ساخت قالب جدید (با نوع منتخب) + بارگذاری مجدد فهرست -->
                        <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                            <ComboBox x:Name="TypeCombo" SelectedIndex="{Binding NewTypeIndex}" MinWidth="150" FontSize="11.5" Margin="0,0,6,4"
                                      DisplayMemberPath="Fa" materialDesign:HintAssist.Hint="نوع قالب"/>
                            <Button Command="{Binding NewTemplateCommand}" Style="{StaticResource MaterialDesignRaisedButton}" FontSize="11" Margin="0,0,4,4">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="13" Height="13" VerticalAlignment="Center" />
                                    <TextBlock Text="قالب جدید" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding LoadTemplatesCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="11" Margin="0,0,4,4"
                                    ToolTip="بارگذاری مجدد فهرست از سرور">
                                <materialDesign:PackIcon Kind="Refresh" Width="13" Height="13" />
                            </Button>
                        </WrapPanel>
                        <!-- طرح‌های آمادهٔ همین سند — چند طرح برای انتخاب (بازطراحی تأییدشده) -->
                        <StackPanel Grid.Row="4" Margin="0,6,0,0">
                            <TextBlock Text="🎨 طرح‌های آمادهٔ این سند — با کلیک ساخته می‌شود:" FontSize="10.5" FontWeight="SemiBold" Opacity="0.75" Margin="2,0,0,4" />
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding VisiblePresets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.AddPresetTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" HorizontalContentAlignment="Stretch"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Margin="0,0,0,4" Padding="8,5" FontSize="11">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Width="12" Height="12" CornerRadius="3"
                                                        Background="{Binding Accent}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                        <!-- ردیف ۵: عملیات روی قالب انتخابی -->
                        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Command="{Binding DuplicateTemplateCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="10.5" Margin="0,0,5,0"
                                    ToolTip="کپی قالب انتخابی به‌عنوان نسخه جدید">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentCopy" Width="13" Height="13" />
                                    <TextBlock Text="کپی" Margin="5,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SetDefaultTemplateCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="10.5" Margin="0,0,5,0"
                                    ToolTip="استفاده این قالب به‌عنوان پیش‌فرض چاپ این نوع سند">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="StarOutline" Width="13" Height="13" />
                                    <TextBlock Text="پیش‌فرض" Margin="5,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding DeleteTemplateCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="10.5"
                                    Foreground="#C62828" ToolTip="حذف قالب انتخابی">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="13" Height="13" />
                                    <TextBlock Text="حذف" Margin="5,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ستون ۲: ویرایشگر قالب -->
                    <Grid Grid.Column="1" Margin="12,12,22,12" IsEnabled="{Binding IsTemplateReady}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- تنظیمات قالب -->
                        <WrapPanel Grid.Row="0" Margin="0,0,0,7">
                            <TextBox Text="{Binding SelectedTemplate.Title, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="نام قالب"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="220" FontSize="12" Margin="0,0,7,5" />
                            <!-- ═══ چرخه ۲۴ (گزارش هفدهم مالک) — «فقط ۳ اندازه کاغذ
                                 هست و کاغذهای فیش پرینترهای حرارتی را نمی‌شود انتخاب
                                 کرد؛ اندازه‌های زیاد و حتی سفارشی باشد» — فهرست کامل
                                 اندازه‌ها + حالت سفارشی (قابل تایپ مثل Custom:100x180
                                 میلی‌متر عرض×ارتفاع)؛ ویرایش‌پذیر است. -->
                            <ComboBox IsEditable="True" StaysOpenOnEdit="True"
                                      IsEnabled="{Binding SelectedTemplate.IsHtmlTemplate}"
                                      SelectedValuePath="Tag" SelectedValue="{Binding SelectedTemplate.PaperSize, Mode=TwoWay}"
                                      Text="{Binding SelectedTemplate.PaperSize, Mode=TwoWay}"
                                      FontSize="11.5" Width="112" Margin="0,0,7,5"
                                      ToolTip="اندازه‌های استاندارد + فیش حرارتی؛ برای سفارشی عبارت Custom:عرضxارتفاع (میلی‌متر) تایپ کنید" materialDesign:HintAssist.Hint="اندازهٔ کاغذ">
                                <ComboBoxItem Tag="A4" Content="کاغذ A4" />
                                <ComboBoxItem Tag="A5" Content="کاغذ A5" />
                                <ComboBoxItem Tag="A6" Content="کاغذ A6" />
                                <ComboBoxItem Tag="A3" Content="کاغذ A3" />
                                <ComboBoxItem Tag="B5" Content="کاغذ B5" />
                                <ComboBoxItem Tag="Letter" Content="Letter" />
                                <ComboBoxItem Tag="Legal" Content="Legal" />
                                <ComboBoxItem Tag="Thermal80" Content="فیش حرارتی ۸۰ میلی‌متر" />
                                <ComboBoxItem Tag="Thermal58" Content="فیش حرارتی ۵۸ میلی‌متر" />
                                <ComboBoxItem Tag="Custom:100x180" Content="سفارشی ۱۰۰×۱۸۰ میلی‌متر" />
                                <ComboBoxItem Tag="Custom:210x100" Content="سفارشی ۲۱۰×۱۰۰ میلی‌متر" />
                            </ComboBox>
                            <TextBox Text="{Binding SelectedTemplate.AccentColor, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding SelectedTemplate.IsHtmlTemplate}"
                                     materialDesign:HintAssist.Hint="رنگ (#16355E)"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="110" FontSize="11" FontFamily="{DynamicResource App.CodeFont}" Margin="0,0,7,5" />
                            <TextBox Text="{Binding SelectedTemplate.FontSize, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding SelectedTemplate.IsHtmlTemplate}"
                                     materialDesign:HintAssist.Hint="فونت"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="62" FontSize="11" Margin="0,0,7,5" />
                            <CheckBox Content="لوگو" IsEnabled="{Binding SelectedTemplate.IsHtmlTemplate}" IsChecked="{Binding SelectedTemplate.ShowLogo}" FontSize="11" Margin="0,0,7,4" VerticalAlignment="Center" />
                            <CheckBox Content="فعال" IsChecked="{Binding SelectedTemplate.IsActive}" FontSize="11" Margin="0,0,7,4" VerticalAlignment="Center" />
                            <CheckBox Content="پیش‌فرض" IsChecked="{Binding SelectedTemplate.IsDefault}" FontSize="11" Margin="0,0,0,4" VerticalAlignment="Center" />
                        </WrapPanel>

                        <!-- عنوان ویرایشگر -->
                        <DockPanel Grid.Row="1" Margin="2,0,0,5">
                            <Button DockPanel.Dock="Left" Content="طراحی بصری قالب" Click="OnVisualTemplateEditor"
                                    IsEnabled="{Binding SelectedTemplate.IsHtmlTemplate}" Padding="12,5" />
                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="#49647F" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="قالب را بصری طراحی کنید؛ قبض اصلی با موتور داخلی چاپ می‌شود." />
                        </DockPanel>

                        <!-- بدنه -->
                        <Expander Grid.Row="2" Header="ویرایش پیشرفته (HTML)" VerticalAlignment="Top">
                            <TextBox IsReadOnly="{Binding SelectedTemplate.IsOriginalReceipt}" Text="{Binding SelectedTemplate.Body, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" MinHeight="130"
                                     AcceptsReturn="True" TextWrapping="Wrap" FontFamily="{DynamicResource App.CodeFont}" FontSize="12"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" materialDesign:HintAssist.Hint="متن قالب چاپ"/>
                        </Expander>

                        <!-- پالت متغیرها -->
                        <TextBlock Grid.Row="3" Text="🧩 متغیرها — با کلیک به انتهای قالب اضافه می‌شود:"
                                   FontSize="10.5" Opacity="0.6" Margin="2,7,0,3" />
                        <ItemsControl Grid.Row="4" ItemsSource="{Binding ActiveVariables}" IsEnabled="{Binding SelectedTemplate.IsHtmlTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- ═══ چرخه ۲۴ — رفع «دکمه‌های متغیرها نامفهوم و بدون
                                         متن/آیکون هستند»: برچسب فارسی + تولتیپِ توکن خام ═══ -->
                                    <Button Command="{Binding DataContext.InsertVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding Key, StringFormat='افزودن {{{{{0}}}}} به انتهای قالب'}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            FontSize="11" Margin="0,0,5,4" Padding="9,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" FontSize="12.5" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Label}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Group}" FontSize="9" Opacity="0.55" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel Grid.Row="5" Margin="0,8,0,0">
                            <Button shortcuts:SaveShortcut.Number="1" Command="{Binding SaveTemplateCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                    Content="ذخیره قالب (Ctrl+Shift+1)" Margin="0,0,8,0" FontSize="12" />
                            <Button Command="{Binding DiscardTemplateChangesCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Content="انصراف از تغییرات" FontSize="11" />
                        </WrapPanel>
                    </Grid>

                    <!-- ستون ۳: پیش‌نمایش زنده -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Command="{Binding PreviewTemplateCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Stretch"
                                FontSize="12" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Eye" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="👁 پیش‌نمایش زنده با داده نمونه" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Grid.Row="1" CornerRadius="10" BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1" Background="{DynamicResource MaterialDesign.Brush.Background}" ClipToBounds="True">
                            <WebBrowser x:Name="PreviewBrowser" Visibility="Collapsed" />
                        </Border>
                        <StackPanel x:Name="PreviewPlaceholder" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <materialDesign:PackIcon Kind="FileFindOutline" Width="44" Height="44" HorizontalAlignment="Center"
                                                     Foreground="#B0BEC5" />
                            <TextBlock Text="پیش‌نمایش اینجا نمایش داده می‌شود" FontSize="11.5" Foreground="#90A4AE"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <TextBlock Text="دکمه بالا را بزنید" FontSize="10" Foreground="#B0BEC5"
                                       HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
                </DockPanel>
            </TabItem>

            <!-- ─── تب ۲: نظرسنجی ─── -->
            <TabItem Header="📝 نظرسنجی">
                <Grid Margin="4,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- فرم ثبت سریع -->
                    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBox materialDesign:HintAssist.Hint="عنوان نظرسنجی جدید"
                                 Text="{Binding NewSurveyTitle, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="280" Margin="0,0,8,6" />
                        <TextBox materialDesign:HintAssist.Hint="توضیح (اختیاری)"
                                 Text="{Binding NewSurveyDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="240" Margin="0,0,8,6" />
                        <Button shortcuts:SaveShortcut.Number="3" Command="{Binding AddSurveyCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="ثبت نظرسنجی (Ctrl+Shift+3)" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding LoadSurveysCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,6">
                            <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" />
                        </Button>
                    </WrapPanel>

                    <!-- ═══ چرخهٔ بیست‌وهفتم (گزارش هجدهم مالک) — قالب‌های آمادهٔ نظرسنجی ═══
                         «قالب‌های پیش‌فرض نظرسنجی» — چهار نظرسنجی حرفه‌ای با یک کلیک -->
                    <Border Grid.Row="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,10"
                            Background="#F1F8E9" BorderBrush="#AED581" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📋 قالب‌های آمادهٔ نظرسنجی — با یک کلیک ثبت می‌شود" FontSize="12" FontWeight="Bold"
                                       Foreground="#33691E" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding SurveyTemplates}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.AddSurveyFromTemplateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="11.5"
                                                Padding="10,5" Margin="0,0,6,4" ToolTip="{Binding Description}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" FontSize="14" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                                <TextBlock Text="{Binding Title}" Margin="7,0,0,0" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ═══ طراح سوالات نظرسنجی — چرخهٔ بیست‌وهشتم (گزارش هجدهم مالک) ═══
                         «نظرسنجی‌ها طراحی نمی‌شوند و فقط به لیست اضافه می‌شوند» —
                         سازندهٔ پویای سوالات (متن + نوع + گزینه‌ها) با بارگذاری
                         سوالات موجود نظرسنجی؛ با کلید سطری ✏️ هر ردیف باز می‌شود -->
                    <Border Grid.Row="2" CornerRadius="10" BorderBrush="#90CAF9" BorderThickness="1.2"
                            Background="#F5FAFF" Padding="14" Margin="0,0,0,10"
                            Visibility="{Binding IsSurveyDesignerOpen, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon Kind="PlaylistEdit" Width="20" Height="20" Foreground="#1565C0" VerticalAlignment="Center" />
                                <TextBlock Text="طراحی سوالات نظرسنجی — سوالات موجود بارگذاری و ویرایش می‌شوند" FontSize="14"
                                           FontWeight="Bold" Foreground="#1565C0" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="عنوان نظرسنجی"
                                         Text="{Binding DesignerTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                                <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="توضیح (اختیاری)"
                                         Text="{Binding DesignerDescription, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="210">
                                <ItemsControl ItemsSource="{Binding DesignerQuestions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Background="{DynamicResource MaterialDesign.Brush.Card.Background}" BorderBrush="#E3F2FD"
                                                    BorderThickness="1" Padding="8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2.1*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="1.4*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="متن سوال"
                                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="12" />
                                                    <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:SurveyQuestionItem.TypeOptions}"
                                                              SelectedItem="{Binding QuestionType}"
                                                              materialDesign:HintAssist.Hint="نوع" FontSize="12"
                                                              Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                                                    <TextBox Grid.Column="4" materialDesign:HintAssist.Hint="گزینه‌ها با | جدا شود"
                                                             Text="{Binding Choices, UpdateSourceTrigger=PropertyChanged}" FontSize="12">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding QuestionType}" Value="چندگزینه‌ای">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                    <Button Grid.Column="6" Command="{Binding DataContext.RemoveDesignerQuestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignIconButton}" ToolTip="حذف سوال">
                                                        <materialDesign:PackIcon Kind="CloseCircleOutline" Width="20" Height="20" Foreground="#C62828" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="➕ افزودن سوال" Command="{Binding AddDesignerQuestionCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="#1565C0" Margin="0,0,8,4" />
                                <Button shortcuts:SaveShortcut.Number="2" Command="{Binding SaveSurveyDesignerCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSave" Width="15" Height="15" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                        <TextBlock Text="💾 ذخیرهٔ نظرسنجی (Ctrl+Shift+2)" Margin="7,0,0,0" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="بستن طراح" Command="{Binding CancelSurveyDesignerCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,0,4" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding Surveys}" SelectedItem="{Binding SelectedSurvey}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="عنوان" Binding="{Binding Title, Converter={StaticResource PersianDigits}}" Width="Auto" FontWeight="SemiBold" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="توضیح" Binding="{Binding Description, TargetNullValue=—, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTextColumn Header="پاسخ‌ها" Binding="{Binding ResponseCount, Converter={StaticResource PersianDigits}}" Width="Auto" FontFamily="{DynamicResource App.CodeFont}" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTemplateColumn Header="میانگین امتیاز" Width="Auto" MaxWidth="420">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RatingText}" Foreground="{Binding RatingColor}"
                                                   FontWeight="SemiBold" FontFamily="{DynamicResource App.CodeFont}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding ActiveText, Converter={StaticResource PersianDigits}}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                            <DataGridTemplateColumn Header="عملیات" Width="Auto" MinWidth="210" MaxWidth="420">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- ✏️ طراح سوالات — بارگذاری سوالات موجود و ویرایش (چرخهٔ ۲۸) -->
                                            <Button Style="{StaticResource App.RowIconButton}"
                                                    Command="{Binding DataContext.OpenSurveyDesignerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" ToolTip="طراحی/ویرایش سوالات" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="PlaylistEdit" Width="15" Height="15" Foreground="#1565C0" VerticalAlignment="Center"/>
                                            </Button>
                                            <!-- 📊 نتایج — دیالوگ خلاصه + توزیع ستاره (چرخهٔ ۲۸) -->
                                            <Button Style="{StaticResource App.RowIconButton}"
                                                    Command="{Binding DataContext.ShowSurveyResultsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" ToolTip="نتایج و آمار" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="ChartBar" Width="15" Height="15" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                            </Button>
                                            <!-- ⏯ فعال/غیرفعال -->
                                            <Button Style="{StaticResource App.RowIconButton}"
                                                    Command="{Binding DataContext.ToggleSurveyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" ToolTip="فعال/غیرفعال" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="ToggleSwitch" Width="15" Height="15" Foreground="#F9A825" VerticalAlignment="Center"/>
                                            </Button>
                                            <!-- 🗑 حذف نرم با تأییدیهٔ فارسی (چرخهٔ ۲۸) -->
                                            <Button Style="{StaticResource App.RowIconButton}"
                                                    Command="{Binding DataContext.DeleteSurveyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" ToolTip="حذف نظرسنجی" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="DeleteOutline" Width="15" Height="15" Foreground="#C62828" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="4" Text="ارسال: پس از تکمیل ویزیت، لینک نظرسنجی با پیامک برای بیمار ارسال می‌شود"
                               FontSize="10.5" Opacity="0.6" Margin="2,8,0,0" />
                </Grid>
            </TabItem>

            <!-- ─── تب ۳: همگام‌سازی داده ─── -->
            <TabItem Header="🔄 همگام‌سازی داده">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                    <materialDesign:PackIcon Kind="SyncCircle" Width="64" Height="64" Opacity="0.35"
                                             HorizontalAlignment="Center" />
                    <TextBlock Text="همگام‌سازی داده بین شعبه‌ها" FontSize="17" FontWeight="Bold"
                               Margin="0,14,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="ایجاد نقطه همگام‌سازی (Snapshot) برای انتقال داده بین شعبه‌ها — زمان‌بندی خودکار در تنظیمات بکاپ"
                               FontSize="12" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,8,0,0" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0" HorizontalAlignment="Center">
                        <Button Command="{Binding SyncNowCommand}" Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Sync" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="🔄 همگام‌سازی دستی" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Center">
                        <TextBlock Text="وضعیت: " FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SyncStatusText}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="آخرین اجرا: " FontSize="12" Opacity="0.7" Margin="20,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LastSyncText}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
    </Grid>
</UserControl>
