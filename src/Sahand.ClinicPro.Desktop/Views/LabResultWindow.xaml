<Window x:Class="Sahand.ClinicPro.Desktop.Views.LabResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="ثبت نتیجه آزمایش"
        Height="640" Width="940"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!-- ═══════════════════════════════════════════════════════════
         ثبت نتیجه آزمایش — گام V6 · بازطراحی چرخهٔ ۶۹ (گزارش مالک + F-28):
         ۱) دابل‌کلیک روی هر آزمایش = فرم اختصاصی همان آزمایش
            (LabTestResultEntryWindow) با حد طبیعی مخصوص بیمار.
         ۲) ستون «حد طبیعی این بیمار» از موتور تفسیر سرور (سن/جنسیت).
         ۳) رنگ ردیف از فلگ تفسیر: سبز=طبیعی، کهربایی=L/H، قرمز=LL/HH.
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Header}" Style="{StaticResource SectionTitle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <!-- ═══ چرخهٔ ۶۹: مسیر اصلی ثبت = دابل‌کلیک؛ دکمهٔ قدیمی برای عادت‌های قبلی می‌ماند ═══ -->
            <Button Command="{Binding OpenItemEntryCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,12,0"
                    ToolTip="یا روی سطر آزمایش دابل‌کلیک کنید">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Pencil" Width="15" Height="15" VerticalAlignment="Center" />
                    <TextBlock Text="ثبت نتیجه در فرم اختصاصی" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <!-- ═══ چرخهٔ ۶۷ (گزارش مالک: «امکان چاپ هم داشته باشه») ═══
                 چاپ برگهٔ نتیجهٔ همین درخواست — سند فارسی از LabResultPrinter
                 ساخته می‌شود و از دروازهٔ PrintFlow می‌گذرد (پیش‌نمایش اختیاری).
                 فقط وقتی نمایان است که دست‌کم یک قلم نتیجه داشته باشد. -->
            <Button Command="{Binding PrintSheetCommand}"
                    Visibility="{Binding HasAnyResult, Converter={StaticResource BoolToVis}}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Printer" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="چاپ برگهٔ نتیجه" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <!-- راهنمای جریان جدید — چرخهٔ ۶۹ -->
            <Border CornerRadius="9" Padding="8,3" Background="#E0F2F1" BorderBrush="#00897B"
                    BorderThickness="1" VerticalAlignment="Center">
                <TextBlock FontSize="10.5" Foreground="#00695C">
                    <Run Text="💡 دابل‌کلیک روی هر آزمایش = فرم ثبت اختصاصی همان آزمایش" />
                </TextBlock>
            </Border>
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                       FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                       FontSize="12" VerticalAlignment="Center" />
        </StackPanel>

        <DataGrid Grid.Row="2"
                  x:Name="ItemsGrid"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  IsReadOnly="True"
                  MouseDoubleClick="ItemsGrid_MouseDoubleClick"
                  materialDesign:DataGridAssist.CellPadding="6,4">
            <!-- ═══ رنگ ردیف از فلگ تفسیر — چرخهٔ ۶۹ (گزارش مالک: «رنگ ردیف
                 آزمایش از نتیجهٔ آزمایش مشخص بشه») ═══ -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="Background" Value="#FFFFFF" />
                    <Style.Triggers>
                        <!-- غیرطبیعی — کهربایی بسیار روشن -->
                        <DataTrigger Binding="{Binding AbnormalFlag}" Value="H">
                            <Setter Property="Background" Value="#FFF8E1" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding AbnormalFlag}" Value="L">
                            <Setter Property="Background" Value="#FFF8E1" />
                        </DataTrigger>
                        <!-- بحرانی — قرمز بسیار روشن -->
                        <DataTrigger Binding="{Binding AbnormalFlag}" Value="HH">
                            <Setter Property="Background" Value="#FFF5F5" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding AbnormalFlag}" Value="LL">
                            <Setter Property="Background" Value="#FFF5F5" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="آزمایش" Binding="{Binding TestName, Converter={StaticResource PersianDigits}}" Width="2*" IsReadOnly="True" />
                <DataGridTextColumn Header="واحد" Binding="{Binding Unit, Converter={StaticResource PersianDigits}}" Width="80" IsReadOnly="True" />
                <!-- ═══ چرخهٔ ۶۹ (F-28): حد طبیعی «مخصوص همین بیمار» — از موتور تفسیر سرور ═══ -->
                <DataGridTextColumn Header="حد طبیعی این بیمار" Binding="{Binding PatientRangeText, Converter={StaticResource PersianDigits}}" Width="140" IsReadOnly="True" />
                <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText, Converter={StaticResource PersianDigits}}" Width="95" IsReadOnly="True" />
                <!-- بج تفسیر رنگی — سبز/نارنجی/قرمز (چرخهٔ ۶۹) -->
                <DataGridTemplateColumn Header="تفسیر" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="7,2" HorizontalAlignment="Center"
                                    Background="{Binding FlagBrush, Converter={StaticResource HexToBrush}}"
                                    Visibility="{Binding FlagText, Converter={StaticResource NullToVisibility}}">
                                <TextBlock Text="{Binding FlagText}" FontSize="10.5" Foreground="White" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="نتیجه متنی" Binding="{Binding Result, Converter={StaticResource PersianDigits}}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="نتیجه عددی" Binding="{Binding ResultNumeric, Converter={StaticResource PersianDigits}}" Width="105" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Command="{Binding CloseCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="بستن" Height="40" MinWidth="110" />
            <ProgressBar IsIndeterminate="True" Height="4" Width="160" Margin="14,0,0,0"
                         VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Grid>
</Window>
