<Window x:Class="Sahand.ClinicPro.Desktop.Views.LabResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="ثبت نتیجه آزمایش"
        Height="620" Width="860"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!-- ═══════════════════════════════════════════════════════════
         ثبت نتیجه آزمایش — گام V6
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Header}" Style="{StaticResource SectionTitle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Command="{Binding SaveItemCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="ثبت نتیجه قلم انتخاب‌شده" Margin="0,0,12,0" />
            <!-- ═══ چرخهٔ ۶۷ (گزارش مالک: «امکان چاپ هم داشته باشه») ═══
                 چاپ برگهٔ نتیجهٔ همین درخواست — سند فارسی از LabResultPrinter
                 ساخته می‌شود و از دروازهٔ PrintFlow می‌گذرد (پیش‌نمایش اختیاری).
                 فقط وقتی نمایان است که دست‌کم یک قلم نتیجه داشته باشد. -->
            <Button Command="{Binding PrintSheetCommand}"
                    Visibility="{Binding HasAnyResult, Converter={StaticResource BoolToVis}}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Printer" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="چاپ برگهٔ نتیجه" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                       FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                       FontSize="12" VerticalAlignment="Center" />
        </StackPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  materialDesign:DataGridAssist.CellPadding="6,4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="آزمایش" Binding="{Binding TestName, Converter={StaticResource PersianDigits}}" Width="2*" IsReadOnly="True" />
                <DataGridTextColumn Header="واحد" Binding="{Binding Unit, Converter={StaticResource PersianDigits}}" Width="80" IsReadOnly="True" />
                <DataGridTextColumn Header="بازه طبیعی" Binding="{Binding NormalRange, Converter={StaticResource PersianDigits}}" Width="110" IsReadOnly="True" />
                <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText, Converter={StaticResource PersianDigits}}" Width="100" IsReadOnly="True" />
                <DataGridTextColumn Header="نتیجه متنی" Binding="{Binding Result, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource PersianDigits}}" Width="*" />
                <DataGridTextColumn Header="نتیجه عددی" Binding="{Binding ResultNumeric, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource PersianDigits}}" Width="110" />
                <DataGridTextColumn Header="توضیح" Binding="{Binding Comment, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource PersianDigits}}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Command="{Binding CloseCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="بستن" Height="40" MinWidth="110" />
            <ProgressBar IsIndeterminate="True" Height="4" Width="160" Margin="14,0,0,0"
                         VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Grid>
</Window>