<Window x:Class="Sahand.ClinicPro.Desktop.Views.LabResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="ثبت نتیجه آزمایش"
        Height="640" Width="940"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!-- ═══════════════════════════════════════════════════════════
         ثبت نتیجه آزمایش — گام V6 · بازطراحی چرخهٔ ۶۹ (گزارش مالک + F-28):
         ۱) دابل‌کلیک روی هر آزمایش = فرم اختصاصی همان آزمایش
            (LabTestResultEntryWindow) با حد طبیعی مخصوص بیمار.
         ۲) ستون «حد طبیعی این بیمار» از موتور تفسیر سرور (سن/جنسیت).
         ۳) رنگ ردیف از فلگ تفسیر: سبز=طبیعی، کهربایی=L/H، قرمز=LL/HH.
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Header}" Style="{StaticResource SectionTitle}" />

        <!-- کارت زمینهٔ بیمار + خلاصهٔ اقلام — طراحی نسخهٔ ۳ (تأیید مالک) -->
        <Border CornerRadius="11" Padding="12,8" Margin="0,0,0,10"
                Background="{DynamicResource MaterialDesign.Brush.Background}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1">
            <DockPanel>
                <Border DockPanel.Dock="Left" CornerRadius="9" Padding="9,3" Background="#E8F5E9"
                        BorderBrush="#A5D6A7" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding ItemsSummaryText, Converter={StaticResource PersianDigits}}"
                               FontSize="11" Foreground="#1B5E20" />
                </Border>
                <TextBlock FontSize="12" VerticalAlignment="Center">
                    <Run Text="بیمار: " /><Run Text="{Binding PatientContext}" FontWeight="SemiBold" />
                    <Run Text=" · " /><Run Text="{Binding PatientAgeText}" />
                    <Run Text=" · درخواست " /><Run Text="{Binding OrderNumberText}" FontFamily="{DynamicResource App.CodeFont}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <!-- ═══ چرخهٔ ۶۹: مسیر اصلی ثبت = دابل‌کلیک؛ دکمهٔ قدیمی برای عادت‌های قبلی می‌ماند ═══ -->
            <Button Command="{Binding OpenItemEntryCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,12,0"
                    ToolTip="یا روی سطر آزمایش دابل‌کلیک کنید">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Pencil" Width="15" Height="15" VerticalAlignment="Center" />
                    <TextBlock Text="ثبت نتیجه در فرم اختصاصی" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <!-- ═══ چرخهٔ ۶۷ (گزارش مالک: «امکان چاپ هم داشته باشه») ═══
                 چاپ برگهٔ نتیجهٔ همین درخواست — سند فارسی از LabResultPrinter
                 ساخته می‌شود و از دروازهٔ PrintFlow می‌گذرد (پیش‌نمایش اختیاری).
                 فقط وقتی نمایان است که دست‌کم یک قلم نتیجه داشته باشد. -->
            <Button Command="{Binding PrintSheetCommand}"
                    Visibility="{Binding HasAnyResult, Converter={StaticResource BoolToVis}}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Printer" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="چاپ برگهٔ نتیجه" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <!-- چاپ برچسب QR ظرف‌های نمونه — درخواست مالک: در کلیدهای عملیاتی باشد -->
            <Button Command="{Binding PrintSpecimenLabelsCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,12,0"
                    ToolTip="برای هر قلم، برچسب QR یکتا روی ظرف نمونه چاپ می‌شود">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Qrcode" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="چاپ QR ظرف‌های نمونه" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <!-- راهنمای جریان جدید — چرخهٔ ۶۹ -->
            <Border CornerRadius="9" Padding="8,3" Background="#E0F2F1" BorderBrush="#00897B"
                    BorderThickness="1" VerticalAlignment="Center">
                <TextBlock FontSize="10.5" Foreground="#00695C">
                    <Run Text="💡 دابل‌کلیک روی هر آزمایش = فرم ثبت اختصاصی همان آزمایش" />
                </TextBlock>
            </Border>
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                       FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                       FontSize="12" VerticalAlignment="Center" />
        </StackPanel>

        <DataGrid Grid.Row="2"
                  x:Name="ItemsGrid"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                 
                  IsReadOnly="True"
                  MouseDoubleClick="ItemsGrid_MouseDoubleClick"
                  materialDesign:DataGridAssist.CellPadding="6,4">
            <!-- ═══ رنگ ردیف از فلگ تفسیر — چرخهٔ ۶۹ (گزارش مالک: «رنگ ردیف
                 آزمایش از نتیجهٔ آزمایش مشخص بشه») ═══ -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource App.TableDataGridRow}">
                    <!-- ═══ چرخهٔ ۷۸ (بندهای ۸/۹ مالک) ═══
                         پس‌زمینهٔ پایهٔ سخت‌کد «سفید» حذف شد: هم گوره‌خری سراسری را
                         می‌کشت و هم در تم تیره جدول را سفیدِ ناهماهنگ می‌کرد؛
                         رنگ‌های وضعیت بالینی هم نیمه‌شفاف شدند تا روی هر دو تم
                         خوانا و هماهنگ باشند. -->
                    <Style.Triggers>
                        <!-- غیرطبیعی — کهربایی نیمه‌شفاف -->
                        <DataTrigger Binding="{Binding AbnormalFlag}" Value="H">
                            <Setter Property="Background" Value="#33FFB300" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding AbnormalFlag}" Value="L">
                            <Setter Property="Background" Value="#33FFB300" />
                        </DataTrigger>
                        <!-- بحرانی — قرمز نیمه‌شفاف -->
                        <DataTrigger Binding="{Binding AbnormalFlag}" Value="HH">
                            <Setter Property="Background" Value="#45E53935" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding AbnormalFlag}" Value="LL">
                            <Setter Property="Background" Value="#45E53935" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="آزمایش" Binding="{Binding TestName, Converter={StaticResource PersianDigits}}" Width="Auto" IsReadOnly="True" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Header="واحد" Binding="{Binding Unit, Converter={StaticResource PersianDigits}}" Width="Auto" IsReadOnly="True" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <!-- ═══ چرخهٔ ۶۹ (F-28): حد طبیعی «مخصوص همین بیمار» — از موتور تفسیر سرور ═══ -->
                <DataGridTextColumn Header="حد طبیعی این بیمار" Binding="{Binding PatientRangeText, Converter={StaticResource PersianDigits}}" Width="Auto" IsReadOnly="True" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText, Converter={StaticResource PersianDigits}}" Width="Auto" IsReadOnly="True" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <!-- بج تفسیر رنگی — سبز/نارنجی/قرمز (چرخهٔ ۶۹) -->
                <DataGridTemplateColumn Header="تفسیر" Width="Auto" MaxWidth="420">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="7,2" HorizontalAlignment="Center"
                                    Background="{Binding FlagBrush, Converter={StaticResource HexToBrush}}"
                                    Visibility="{Binding FlagText, Converter={StaticResource NullToVisibility}}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FlagText}" FontSize="10.5" Foreground="White" VerticalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="نتیجه متنی" Binding="{Binding Result, Converter={StaticResource PersianDigits}}" Width="Auto" IsReadOnly="True" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
                <DataGridTextColumn Header="نتیجه عددی" Binding="{Binding ResultNumeric, Converter={StaticResource PersianDigits}}" Width="Auto" IsReadOnly="True" MaxWidth="420" ElementStyle="{StaticResource App.TableCellTextBlock}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Command="{Binding CloseCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="بستن" Height="40" MinWidth="110" />
            <ProgressBar IsIndeterminate="True" Height="4" Width="160" Margin="14,0,0,0"
                         VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Grid>
</Window>
