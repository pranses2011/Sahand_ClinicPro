<Window x:Class="Sahand.ClinicPro.Desktop.Views.FreeTemplateSampleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="پیش‌نمایش نمونه — فاقد اعتبار" Width="860" Height="720" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" Background="#EEF1F6">
    <DockPanel Margin="14">
        <Border DockPanel.Dock="Top" Background="#FFF4E8" BorderBrush="#E8B77C" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <TextBlock Text="پیش‌نویس ذخیره‌نشده با دادهٔ نمونه و فاقد اعتبار است. نمایش مرورگر جایگزین کنترل داده واقعی، صفحه‌بندی و چاپ آزمایشی نیست." TextWrapping="Wrap" Foreground="#8A4225" FontWeight="SemiBold"/>
        </Border>
        <Button DockPanel.Dock="Bottom" Content="بستن" Click="Close_Click" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="20,6"/>
        <Border Background="White" BorderBrush="#DCE4ED" BorderThickness="1" CornerRadius="8" ClipToBounds="True"><WebBrowser x:Name="Browser"/></Border>
    </DockPanel>
</Window>
