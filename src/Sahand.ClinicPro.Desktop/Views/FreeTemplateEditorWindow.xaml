<Window x:Class="Sahand.ClinicPro.Desktop.Views.FreeTemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="طراح آزاد قالب چاپ" Width="1300" Height="820" MinWidth="950" MinHeight="620"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" Background="#EDF3F8">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Background="#173B61" CornerRadius="10" Padding="15" Margin="0,0,0,12">
            <StackPanel><TextBlock Text="طراح آزاد قالب چاپ" Foreground="White" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="عناصر را به بوم بکشید؛ پیش‌نمایش سرور و چاپ واقعی را پس از اعمال بررسی کنید." Foreground="#D3EDF1" Margin="0,3,0,0"/></StackPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button Content="اعمال به قالب" Click="Apply_Click" Padding="16,8" Margin="0,0,8,0" Background="#1565C0" Foreground="White"/>
            <Button Content="انصراف" Click="Cancel_Click" Padding="16,8"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="255"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#D8E5EF" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock Text="ابزارها" FontWeight="Bold" FontSize="15" Foreground="#173657" Margin="0,0,0,10"/>
                    <Button Content="＋ متن" Tag="text" Click="Add_Click" PreviewMouseLeftButtonDown="ToolDown" PreviewMouseMove="ToolMove" Margin="0,0,0,8"/>
                    <Button Content="＋ اطلاعات سند / جدول" Tag="variable" Click="Add_Click" PreviewMouseLeftButtonDown="ToolDown" PreviewMouseMove="ToolMove" Margin="0,0,0,8"/>
                    <Button Content="＋ کادر" Tag="rectangle" Click="Add_Click" PreviewMouseLeftButtonDown="ToolDown" PreviewMouseMove="ToolMove" Margin="0,0,0,8"/>
                    <Button Content="＋ خط" Tag="line" Click="Add_Click" PreviewMouseLeftButtonDown="ToolDown" PreviewMouseMove="ToolMove" Margin="0,0,0,8"/>
                    <Separator Margin="0,8"/>
                    <TextBlock Text="کاغذ سند" FontWeight="SemiBold"/>
                    <ComboBox x:Name="PaperBox" IsEditable="True" Margin="0,6,0,12"><ComboBoxItem Content="A4"/><ComboBoxItem Content="A5"/><ComboBoxItem Content="A6"/><ComboBoxItem Content="Thermal80"/><ComboBoxItem Content="Thermal58"/></ComboBox>
                    <TextBlock Text="جهت کاغذ" FontWeight="SemiBold"/>
                    <ComboBox x:Name="OrientationBox" SelectedIndex="0" Margin="0,6,0,12"><ComboBoxItem Content="عمودی"/><ComboBoxItem Content="افقی"/></ComboBox>
                    <TextBlock Text="عرض و ارتفاع بوم بدنه (پیکسل)" TextWrapping="Wrap" FontSize="11"/>
                    <TextBox x:Name="CanvasWidthBox" Margin="0,5,0,4" ToolTip="عرض بوم"/>
                    <TextBox x:Name="CanvasHeightBox" Margin="0,0,0,5" ToolTip="ارتفاع بوم"/>
                    <TextBlock Text="حاشیه داخلی یکسان برگه (پیکسل؛ خالی = پیش‌فرض)" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"/>
                    <TextBox x:Name="SheetPaddingBox" Margin="0,4,0,5" ToolTip="۰ تا ۱۰۰ پیکسل؛ مستقل از حاشیه چاپگر"/>
                    <Button Content="اعمال ابعاد و حاشیه" Click="ResizeCanvas_Click"/>
                    <TextBlock Text="حاشیه داخلی با حاشیه فیزیکی چاپگر متفاوت است. اندازه، سربرگ، داده‌های بلند و صفحه‌بندی را در پیش‌نمایش و چاپ آزمایشی بررسی کنید." TextWrapping="Wrap" FontSize="11" Foreground="#536C82" Margin="0,14,0,0"/>
                </StackPanel></ScrollViewer>
            </Border>
            <Border Grid.Column="1" Background="#DAE4ED" CornerRadius="10" Padding="12" Margin="0,0,10,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Canvas x:Name="PageCanvas" Background="White" FlowDirection="LeftToRight" AllowDrop="True" Drop="Canvas_Drop" DragOver="Canvas_DragOver"/>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#D8E5EF" BorderThickness="1" CornerRadius="10" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock Text="ویژگی عنصر انتخاب‌شده" FontWeight="Bold" FontSize="14" Foreground="#173657" Margin="0,0,0,10"/>
                    <TextBlock Text="متن یا برچسب"/><TextBox x:Name="TextBoxValue" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="55" Margin="0,4,0,8"/>
                    <TextBlock Text="متغیر سند"/><ComboBox x:Name="VariableBox" DisplayMemberPath="Label" SelectedValuePath="Key" Margin="0,4,0,8"/>
                    <TextBlock Text="مکان X / Y و اندازه عرض / ارتفاع (پیکسل)" TextWrapping="Wrap" FontSize="11"/>
                    <UniformGrid Columns="2" Margin="0,4,0,8"><TextBox x:Name="XBox" ToolTip="X"/><TextBox x:Name="YBox" ToolTip="Y"/><TextBox x:Name="WidthBox" ToolTip="عرض"/><TextBox x:Name="HeightBox" ToolTip="ارتفاع"/></UniformGrid>
                    <TextBlock Text="اندازه فونت و رنگ #RRGGBB" FontSize="11"/><UniformGrid Columns="2" Margin="0,4,0,8"><TextBox x:Name="FontBox"/><TextBox x:Name="ColorBox"/></UniformGrid>
                    <Button Content="اعمال ویژگی‌ها" Click="Update_Click" Margin="0,0,0,8"/>
                    <Button Content="حذف عنصر" Click="Remove_Click"/>
                    <TextBlock Text="برای جابه‌جایی، عنصر را با ماوس بکشید. اندازه را از ویژگی‌ها تنظیم کنید." TextWrapping="Wrap" Foreground="#536C82" FontSize="11" Margin="0,12,0,0"/>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
