<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.GuidedTourWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/xaml/themes"
             FlowDirection="RightToLeft">
    <!-- ═══════════════════════════════════════════════════════════
         تور هدایت‌شده اولین اجرا — چرخه سیزدهم (درخواست ۸-۶)
         پس‌زمینه تیره شفاف با سوراخ روشن دور کنترل هدف + حباب راهنما

         ═══ چرخهٔ سی‌وهشتم (گزارش مالک — ریشه‌یابی RTL) ═══
         «هایلایت‌های تور آموزشی اولین ورود درست نیست و فکر کنم به خاطر
         RTL بودن فرم باشه» — تشخیص مالک دقیق بود: پیشتر این تور یک
         «پنجرهٔ همپوشان» جدا بود و برای یافتن مختصات کنترل هدف باید از
         PointToScreen بین دو پنجره استفاده می‌شد؛ در پنجره‌های WPF با
         FlowDirection=RightToLeft مختصات X از سوی ویندوز آینه می‌شود
         (رفتار شناخته‌شدهٔ پنجره‌های RTL) و در نتیجه سوراخ هایلایت به‌صورت
         آینه‌ای در جای اشتباه می‌افتاد.
         رفع قطعی با تغییر معماری: تور دیگر پنجرهٔ جدا نیست؛ به‌صورت
         «کنترل کاربر» در لایهٔ همپوشان درون خود پنجرهٔ اصلی می‌نشیند
         (لایهٔ TourLayer در MainWindow). اندازه‌گیری هدف با TranslatePoint
         در «همان درخت بصری» انجام می‌شود — یعنی مبدأ اندازه‌گیری و مبدأ
         ترسیم ماسک یکسان‌اند و هر آینه‌شوندگی (RTL)، مقیاس DPI یا جابه‌جایی
         پنجره به‌طور خودکار بر هر دو یکسان اثر می‌گذارد؛ خطای مختصات به
         کلی منتفی است.
         نام کلاس/فایل عمداً «GuidedTourWindow» ماند تا بستهٔ آپدیت فقط
         همین دو فایل را جایگزین کند و فایل زائد روی ایستگاه نمانَد.
         ═══════════════════════════════════════════════════════════ -->
    <Grid>
        <!-- ماسک تیره با سوراخ هایلایت — هندسه در کد پشت به‌روزرسانی می‌شود؛
             Fill غیرتهی است تا کلیک‌های روی ناحیهٔ تیره به رابط زیرین نرسد -->
        <Path x:Name="MaskPath" Fill="#B3000000" IsHitTestVisible="True" />

        <!-- حباب راهنما — همیشه روی ماسک -->
        <Border x:Name="Bubble" Background="White" CornerRadius="14" Padding="20,16"
                Width="430" VerticalAlignment="Top" HorizontalAlignment="Center"
                Effect="{DynamicResource MaterialDesignShadowDepth3}"
                BorderBrush="#E3F2FD" BorderThickness="1.5">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <materialDesign:PackIcon Kind="School" Width="26" Height="26" DockPanel.Dock="Right"
                                             Foreground="#1565C0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StepTitle" Text="خوش آمدید" FontSize="17" FontWeight="Bold"
                               Foreground="#1565C0" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StepCounter" Text="۱ از ۸" FontSize="11" Opacity="0.55"
                               VerticalAlignment="Center" DockPanel.Dock="Left" />
                </DockPanel>
                <TextBlock x:Name="StepMessage" Text="" FontSize="13" LineHeight="24" TextWrapping="Wrap"
                           Foreground="#37474F" />
                <ProgressBar x:Name="TourProgress" Height="4" Margin="0,14,0,10"
                             Background="#ECEFF1" Foreground="#1565C0" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SkipButton" Grid.Column="0" Click="OnSkip"
                            Style="{StaticResource MaterialDesignFlatButton}" Content="رد شدن از تور"
                            FontSize="11.5" Foreground="#E53935" />
                    <Button x:Name="BackButton" Grid.Column="2" Click="OnBack" Margin="0,0,8,0"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Content="قبلی" FontSize="12" Visibility="Collapsed" />
                    <Button x:Name="NextButton" Grid.Column="2" Click="OnNext"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Content="بعدی ▶" FontSize="12.5" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
