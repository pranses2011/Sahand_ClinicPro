<Window xmlns:shortcuts="clr-namespace:Sahand.ClinicPro.Desktop.Services" x:Class="Sahand.ClinicPro.Desktop.Views.UserFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding FormTitle}"
        Height="640" Width="760" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}">
    <!-- ═══ فرم ثبت/ویرایش کاربر — گام U13 طبق فرم ۲۴ (۲ تب) ═══ -->
    <Grid Margin="20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Style="{StaticResource MaterialDesignTabControl}">
            <!-- ─── تب ۱: اطلاعات کاربری ─── -->
            <TabItem Header="👤 اطلاعات کاربری">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <StackPanel Margin="8,12">
                        <TextBox materialDesign:HintAssist.Hint="نام کاربری * (حداقل ۳ کاراکتر انگلیسی)"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                 LostFocus="Username_OnLostFocus"
                                 IsEnabled="{Binding IsEdit, Converter={StaticResource InvertBool}}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding UsernameError}" Foreground="#C62828" FontSize="11"
                                   Margin="4,0,0,6" Visibility="{Binding UsernameError, Converter={StaticResource StringToVisibility}}" />

                        <!-- ═══ چرخه بیست‌وچهارم (گزارش هفدهم مالک) — «فیلد نام کامل
                             در ثبت/ویرایش کاربر وجود ندارد» — نام کامل کاربر اینجا
                             وارد و به پرسنل (Employee) متصل می‌شود تا در لیست کاربران
                             و لاگ عملیات با نام واقعی دیده شود ═══ -->
                        <TextBox materialDesign:HintAssist.Hint="نام کامل * (مثال: رضا محمدی)"
                                 Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" />

                        <TextBox materialDesign:HintAssist.Hint="ایمیل"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" />

                        <!-- رمز عبور + سنجه قدرت ۵ سطحی -->
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                     materialDesign:HintAssist.Hint="رمز عبور *"
                                     PasswordChanged="PasswordBox_OnPasswordChanged" Margin="0,0,0,4" />
                        <PasswordBox x:Name="ConfirmBox" Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                     materialDesign:HintAssist.Hint="تکرار رمز عبور *"
                                     PasswordChanged="ConfirmBox_OnPasswordChanged" Margin="0,0,0,8" />

                        <!-- سنجه قدرت رمز — نوار رنگی + متن فارسی -->
                        <Grid Margin="2,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0" Height="6"
                                         Maximum="100" Value="{Binding StrengthPercent, Mode=OneWay}"
                                         Foreground="{Binding StrengthColor, Mode=OneWay}" />
                            <TextBlock Grid.Column="1" Text="{Binding StrengthText, Mode=OneWay}"
                                       FontSize="11.5" FontWeight="SemiBold" Margin="10,0,0,0"
                                       Foreground="{Binding StrengthColor, Mode=OneWay}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding PasswordPolicyHint}" FontSize="10.5" Opacity="0.6" Margin="2,0,0,12" />

                        <TextBox materialDesign:HintAssist.Hint="موبایل"
                                 Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,14" />

                        <CheckBox Content="کاربر باید در اولین ورود رمز را تغییر دهد"
                                  IsChecked="{Binding MustChangePassword}" Margin="2,2,0,6" />
                        <CheckBox Content="فعال‌سازی احراز هویت دومرحله‌ای (2FA)"
                                  IsChecked="{Binding TwoFactorEnabled}" Margin="2,2,0,6" />
                        <CheckBox Content="حساب فعال است"
                                  IsChecked="{Binding IsActive}" Margin="2,2,0,6" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─── تب ۲: نقش‌ها و دسترسی‌ها ─── -->
            <TabItem Header="🔖 نقش‌ها و دسترسی‌ها">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <StackPanel Margin="8,12">
                        <TextBlock Text="نقش‌های کاربر (چندانتخابی):" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Roles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- ═══ اصلاح چرخهٔ سی‌ویکم (گزارش مالک): «تب نقش‌ها نقش کاربر
                                         را نشان نمی‌دهد و ذخیره نمی‌شود» — چک‌باکس فاقد بایندینگ
                                         IsChecked بود؛ هم نمایش نقش‌های فعلی کاربر (OneWay از سرور)
                                         و هم ذخیرهٔ انتخاب‌ها (TwoWay به RoleCheckItem.IsChecked که
                                         در SaveAsync به roleIds ارسال می‌شود) اکنون کار می‌کند ═══ -->
                                    <CheckBox Margin="6,3" IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                        <CheckBox.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description, TargetNullValue=''}" FontSize="10.5" Opacity="0.6" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </CheckBox.Content>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Separator Margin="0,14,0,10" />
                        <TextBlock Text="برای دسترسی‌های سفارشی (Override) ماتریس کامل در صفحه «نقش‌ها» تعریف می‌شود"
                                   FontSize="11.5" Opacity="0.65" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- پیام خطا + دکمه‌های پایین -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" FontSize="12"
                       Margin="2,0,0,8" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button shortcuts:SaveShortcut.Number="1" Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSaveCheck" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="ذخیره کاربر (Ctrl+Shift+1)" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CancelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}">
                    <TextBlock Text="انصراف" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
