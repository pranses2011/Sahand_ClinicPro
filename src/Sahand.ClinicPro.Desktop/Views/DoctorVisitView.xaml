<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.DoctorVisitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1080"
             FlowDirection="RightToLeft">
    <!-- ═══ میزکار پزشک — چرخهٔ بیست‌وهفتم (گزارش هجدهم مالک) ═══
         «صفحهٔ ویزیت پزشک وجود ندارد» — این میزکار شخصیِ پزشکِ واردشده است:
         خودکار-شناسایی از حساب کاربر (users/me → DoctorId)، صف/فراخوان/آمارِ
         فقط همان پزشک؛ در نبود اتصال، انتخابگر دستی + بنر راهنما -->
    <UserControl.InputBindings>
        <KeyBinding Key="Space" Command="{Binding CallNextCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- سربرگ + سلام شخصی -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Doctor"
                                         Width="26" Height="26"
                                         Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                         VerticalAlignment="Center" />
                <TextBlock Text="میزکار پزشک" FontSize="20" FontWeight="Bold"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
                <TextBlock FontSize="14" Opacity="0.75" Margin="14,3,0,0" VerticalAlignment="Center"
                           Text="{Binding CurrentUserName, Mode=OneWay, TargetNullValue='—'}" />
                <!-- انتخابگر پزشک — فقط وقتی حساب به پزشکی متصل نیست -->
                <ComboBox ItemsSource="{Binding Doctors}"
                          SelectedIndex="{Binding DoctorIndex}"
                          DisplayMemberPath="Name"
                          materialDesign:HintAssist.Hint="پزشک میزکار"
                          MinWidth="180" Margin="16,0,0,0" VerticalAlignment="Center"
                          Visibility="{Binding IsLinkedToDoctor, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                <Button Command="{Binding LoadCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="8,0,0,0"
                        VerticalAlignment="Center" ToolTip="بارگذاری مجدد">
                    <materialDesign:PackIcon Kind="Refresh" Width="15" Height="15" />
                </Button>
            </StackPanel>
            <TextBlock Text="این صفحه فقط صف و آمار شماست — فراخوان بیمار بعدی با کلید Space؛ هر ۳۰ ثانیه خودکار تازه می‌شود"
                       FontSize="12" Opacity="0.65" Margin="2,4,0,0" />
        </StackPanel>

        <!-- بنر راهنما — حساب به پزشک متصل نیست -->
        <Border Grid.Row="1" Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1"
                CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
                Visibility="{Binding IsLinkedToDoctor, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="LinkOff" Width="18" Height="18"
                                         Foreground="#E65100" VerticalAlignment="Center" />
                <TextBlock Text="حساب کاربری شما به پروندهٔ پزشکی متصل نیست — از فهرست بالا پزشک موردنظر را انتخاب کنید. برای اتصال دائمی، در فرم کاربر «نام کامل» پزشک را وارد کنید تا پرسنل و پروندهٔ پزشک به حساب متصل شود."
                           FontSize="11.5" Foreground="#795548" TextWrapping="Wrap"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- کارت‌های آماری شخصی -->
        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,10">
            <controls:StatCard IconKind="CheckCircle" Margin="0,0,8,0"
                               Value="{Binding VisitedCount, Mode=OneWay}"
                               Label="✅ ویزیت‌شدهٔ امروزِ شما" AccentBrush="#2E7D32" />
            <controls:StatCard IconKind="QueueFirstInLastOut" Margin="0,0,8,0"
                               Value="{Binding WaitingCount, Mode=OneWay}"
                               Label="🟡 در صفِ شما" AccentBrush="#F9A825" />
            <controls:StatCard IconKind="ClockFast"
                               Value="{Binding AverageDisplay, Mode=OneWay}"
                               Label="میانگین مدت ویزیت شما" AccentBrush="#6A1B9A" />
        </UniformGrid>

        <!-- بیمار فعلی -->
        <Border Grid.Row="3" CornerRadius="12" Padding="14,10" Margin="0,0,0,10" Background="#E3F2FD"
                Visibility="{Binding CurrentPatient, Converter={StaticResource NullToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="22" Background="#1565C0">
                        <TextBlock Text="🩺" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="Bold">
                            <Run Text="{Binding CurrentPatient.PatientName, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock FontSize="11.5" Opacity="0.75">
                                <Run Text="ساعت: " /><Run Text="{Binding CurrentPatient.AppointmentTime, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="11.5" Opacity="0.75" Margin="14,0,0,0">
                                <Run Text="نوع: " /><Run Text="{Binding CurrentPatient.VisitTypeText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="11.5" Opacity="0.75" Margin="14,0,0,0">
                                <Run Text="موبایل: " /><Run Text="{Binding CurrentPatient.Mobile, Mode=OneWay}" FontFamily="{DynamicResource App.CodeFont}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <Border Background="#FFEBEE" CornerRadius="8" Padding="8,2" Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding CurrentPatient.Allergies, Converter={StaticResource NullToVisibility}}">
                        <TextBlock FontSize="10.5" Foreground="#C62828">
                            <Run Text="⚠️ " /><Run Text="{Binding CurrentPatient.Allergies, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding OpenCurrentVisitCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}" FontSize="13">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderEditOutline" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="🩺 باز کردن فرم ویزیت" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- دو ستون: صف شخصی + ویزیت‌شده‌ها -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- صف انتظار شخصی -->
            <Border Grid.Column="0" CornerRadius="12" Padding="12"
                    Background="{DynamicResource MaterialDesign.Brush.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                    BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="🟡 بیماران در صفِ شما" FontWeight="Bold" FontSize="14" Margin="2,0,2,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Waiting}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="10,8" Margin="0,0,0,6" Background="#FFF8E1"
                                            ToolTip="{Binding Allergies, Mode=OneWay, TargetNullValue='بدون آلرژی'}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#F9A825"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding QueueNumber, Mode=OneWay}" FontWeight="Bold"
                                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" FontSize="13" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="11" Opacity="0.7">
                                                        <Run Text="⏰ " /><Run Text="{Binding AppointmentTime, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Opacity="0.7" Margin="12,0,0,0">
                                                        <Run Text="نوع: " /><Run Text="{Binding VisitTypeText, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Foreground="#E65100" Margin="12,0,0,0">
                                                        <Run Text="انتظار: " /><Run Text="{Binding WaitingText, Mode=OneWay}" FontWeight="SemiBold" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="2" Command="{Binding DataContext.CallNextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="11" Padding="8,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="BellRing" Width="13" Height="13" VerticalAlignment="Center" />
                                                    <TextBlock Text="فراخوان" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <controls:EmptyState Message="صف شما خالی است" IconKind="QueueFirstInLastOut"
                                         Visibility="{Binding Waiting.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" />
                </DockPanel>
            </Border>

            <!-- ویزیت‌شده‌های امروز -->
            <Border Grid.Column="2" CornerRadius="12" Padding="12"
                    Background="{DynamicResource MaterialDesign.Brush.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                    BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="✅ ویزیت‌شده‌های امروزِ شما" FontWeight="Bold" FontSize="14" Margin="2,0,2,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Done}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="10,7" Margin="0,0,0,6" Background="#E8F5E9">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CheckCircle" Width="15" Height="15" Foreground="#2E7D32" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" FontSize="12.5" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock FontSize="11" Opacity="0.75" Margin="0,3,0,0" FontFamily="{DynamicResource App.CodeFont}">
                                                <Run Text="{Binding TimeRange, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock FontSize="11" Opacity="0.75" Margin="0,2,0,0">
                                                <Run Text="تشخیص: " /><Run Text="{Binding DiagnosisText, Mode=OneWay, TargetNullValue=—}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <controls:EmptyState Message="هنوز ویزیتی تکمیل نشده" IconKind="ClipboardCheckOutline"
                                         Visibility="{Binding Done.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- دکمه فراخوان -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Command="{Binding CallNextCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#2E7D32" BorderBrush="#2E7D32"
                    FontSize="14" Padding="20,10">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="BellRing" Width="18" Height="18" VerticalAlignment="Center" />
                    <TextBlock Text="🔔 فراخوانی بیمار بعدی (Space)" Margin="10,0,0,0" />
                </StackPanel>
            </Button>
            <ProgressBar IsIndeterminate="True" Width="24" Height="18" Margin="12,0,0,0"
                         Visibility="{Binding IsCalling, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Grid>
</UserControl>
