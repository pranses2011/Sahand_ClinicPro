<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.DoctorVisitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1080"
             FlowDirection="RightToLeft">
    <!-- ═══ میزکار پزشک — چرخهٔ بیست‌وهفتم (گزارش هجدهم مالک) ═══
         «صفحهٔ ویزیت پزشک وجود ندارد» — این میزکار شخصیِ پزشکِ واردشده است:
         خودکار-شناسایی از حساب کاربر (users/me → DoctorId)، صف/فراخوان/آمارِ
         فقط همان پزشک؛ در نبود اتصال، انتخابگر دستی + بنر راهنما -->
    <UserControl.InputBindings>
        <KeyBinding Key="Space" Command="{Binding CallNextCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- سربرگ + سلام شخصی -->
        <!-- ═══ چرخهٔ ۴۵ (گزارش مالک: «ظاهر صفحات… میز کار پزشک رو خیلی حرفه ای
             تر و زیباتر بکن») — سربرگ گرادیانی برند با چیپ نام کاربر + انتخابگر
             پزشک (برای حساب‌های بدون اتصال) روی خود سربرگ ═══ -->
        <Border Grid.Row="0" CornerRadius="14" Padding="16,10" Margin="0,0,0,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1565C0" Offset="0" />
                    <GradientStop Color="#0D2C54" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.16" Color="#0A1E3C" />
            </Border.Effect>
            <DockPanel>
                <!-- انتخابگر پزشک (حساب بدون اتصال) + نوسازی — گوشهٔ چپ فیزیکی (RTL) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Visibility="{Binding IsLinkedToDoctor, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                    <ComboBox ItemsSource="{Binding Doctors}"
                              SelectedIndex="{Binding DoctorIndex}"
                              DisplayMemberPath="Name"
                              materialDesign:HintAssist.Hint="پزشک میزکار"
                              MinWidth="170" VerticalAlignment="Center" />
                    <Button Command="{Binding LoadCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="White" MinWidth="42" MinHeight="36" Margin="6,0,0,0"
                            VerticalAlignment="Center" ToolTip="بارگذاری مجدد">
                        <materialDesign:PackIcon Kind="Refresh" Width="15" Height="15" />
                    </Button>
                </StackPanel>
                <!-- نوسازی برای حساب‌های متصل -->
                <Button DockPanel.Dock="Left" Command="{Binding LoadCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="White" MinWidth="42" MinHeight="36" Margin="0,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="بارگذاری مجدد"
                        Visibility="{Binding IsLinkedToDoctor, Converter={StaticResource BoolToVisibility}}">
                    <materialDesign:PackIcon Kind="Refresh" Width="15" Height="15" />
                </Button>

                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="23" VerticalAlignment="Center" Margin="0,0,12,0"
                            Background="#33FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1">
                        <materialDesign:PackIcon Kind="Doctor" Width="24" Height="24"
                                                 Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="میزکار پزشک" FontSize="18" FontWeight="Bold" Foreground="White" />
                            <!-- چیپ نام کاربر — هم‌خانوادهٔ سربرگ‌های جدید -->
                            <Border CornerRadius="9" Padding="9,2.5" Margin="10,1,0,0" VerticalAlignment="Center"
                                    Background="#26FFFFFF" BorderBrush="#59FFFFFF" BorderThickness="1">
                                <TextBlock Text="{Binding CurrentUserName, Mode=OneWay, TargetNullValue='—'}"
                                           Foreground="White" FontSize="10.5" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="این صفحه فقط صف و آمار شماست — فراخوان بیمار بعدی با کلید Space؛ هر ۳۰ ثانیه خودکار تازه می‌شود"
                                   FontSize="10.5" Foreground="#C9DDF5" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- بنر راهنما — حساب به پزشک متصل نیست -->
        <Border Grid.Row="1" Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1"
                CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
                Visibility="{Binding IsLinkedToDoctor, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="LinkOff" Width="18" Height="18"
                                         Foreground="#E65100" VerticalAlignment="Center" />
                <TextBlock Text="حساب کاربری شما به پروندهٔ پزشکی متصل نیست — از فهرست بالا پزشک موردنظر را انتخاب کنید. برای اتصال دائمی، در فرم کاربر «نام کامل» پزشک را وارد کنید تا پرسنل و پروندهٔ پزشک به حساب متصل شود."
                           FontSize="11.5" Foreground="#795548" TextWrapping="Wrap"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ═══ چرخهٔ ۴۶ (گزارش مالک: چیدمان حرفه‌ای) — کارت‌های آماری شخصی هم‌الگو
             با زبان طراحی مشترک؛ ایموجی‌های برچسب حذف شدند (رندر ناهماهنگ ویندوز) ═══ -->
        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,10">
            <!-- کارت ۱: ویزیت‌های تکمیل‌شدهٔ امروزِ همین پزشک -->
            <Border Style="{StaticResource App.StatCard}" Margin="0,0,6,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource App.StatIcon}"
                            Background="#E8F5E9" BorderBrush="#C8E6C9" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="CheckCircle" Width="21" Height="21"
                                                 Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource App.StatValue}"
                                   Text="{Binding VisitedCount, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                        <TextBlock Style="{StaticResource App.StatLabel}" Text="ویزیت‌شدهٔ امروز شما" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- کارت ۲: صف انتظار اختصاصی همین پزشک -->
            <Border Style="{StaticResource App.StatCard}" Margin="6,0,6,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource App.StatIcon}"
                            Background="#FFF8E1" BorderBrush="#FFE082" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="QueueFirstInLastOut" Width="21" Height="21"
                                                 Foreground="#F57F17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource App.StatValue}" Foreground="#E65100"
                                   Text="{Binding WaitingCount, Mode=OneWay, Converter={StaticResource PersianDigits}}" />
                        <TextBlock Style="{StaticResource App.StatLabel}" Text="در صف شما" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- کارت ۳: میانگین زمانی که هر بیمار نزد این پزشک وقت می‌گذراند -->
            <Border Style="{StaticResource App.StatCard}" Margin="6,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource App.StatIcon}"
                            Background="#F3E5F5" BorderBrush="#E1BEE7" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="ClockFast" Width="21" Height="21"
                                                 Foreground="#6A1B9A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource App.StatValue}"
                                   Text="{Binding AverageDisplay, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource App.StatLabel}" Text="میانگین مدت ویزیت شما" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>

        <!-- بیمار فعلی -->
        <Border Grid.Row="3" CornerRadius="12" Padding="14,10" Margin="0,0,0,10" Background="#E3F2FD"
                Visibility="{Binding CurrentPatient, Converter={StaticResource NullToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- نشان شمارهٔ نوبت — عدد درشت روی دایرهٔ آبی (چرخهٔ ۴۶: به‌جای
                         ایموجی، عدد واقعی صف بیمار فعلی) -->
                    <Border Width="44" Height="44" CornerRadius="22" Background="#1565C0">
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentPatient.QueueNumber, Mode=OneWay}"
                                       FontWeight="Bold" Foreground="White" />
                        </Viewbox>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="Bold">
                            <Run Text="{Binding CurrentPatient.PatientName, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock FontSize="11.5" Opacity="0.75">
                                <Run Text="ساعت: " /><Run Text="{Binding CurrentPatient.AppointmentTime, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="11.5" Opacity="0.75" Margin="14,0,0,0">
                                <Run Text="نوع: " /><Run Text="{Binding CurrentPatient.VisitTypeText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="11.5" Opacity="0.75" Margin="14,0,0,0">
                                <Run Text="موبایل: " /><Run Text="{Binding CurrentPatient.Mobile, Mode=OneWay}" FontFamily="{DynamicResource App.CodeFont}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <Border Background="#FFEBEE" CornerRadius="8" Padding="8,2" Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding CurrentPatient.Allergies, Converter={StaticResource NullToVisibility}}">
                        <TextBlock FontSize="10.5" Foreground="#C62828">
                            <Run Text="" /><Run Text="{Binding CurrentPatient.Allergies, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding OpenCurrentVisitCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}" FontSize="13">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderEditOutline" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="باز کردن فرم ویزیت" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- دو ستون: صف شخصی + ویزیت‌شده‌ها -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- صف انتظار شخصی -->
            <Border Grid.Column="0" CornerRadius="12" Padding="12"
                    Background="{DynamicResource MaterialDesign.Brush.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                    BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="بیماران در صف شما" FontWeight="Bold" FontSize="13.5" Margin="2,0,2,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Waiting}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="10,8" Margin="0,0,0,6" Background="#FFF8E1"
                                            ToolTip="{Binding Allergies, Mode=OneWay, TargetNullValue='بدون آلرژی'}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#F9A825"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding QueueNumber, Mode=OneWay}" FontWeight="Bold"
                                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" FontSize="13" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="11" Opacity="0.7">
                                                        <Run Text="ساعت نوبت: " /><Run Text="{Binding AppointmentTime, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Opacity="0.7" Margin="12,0,0,0">
                                                        <Run Text="نوع: " /><Run Text="{Binding VisitTypeText, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Foreground="#E65100" Margin="12,0,0,0">
                                                        <Run Text="انتظار: " /><Run Text="{Binding WaitingText, Mode=OneWay}" FontWeight="SemiBold" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="2" Command="{Binding DataContext.CallNextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="11" Padding="8,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="BellRing" Width="13" Height="13" VerticalAlignment="Center" />
                                                    <TextBlock Text="فراخوان" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <controls:EmptyState Message="صف شما خالی است" IconKind="QueueFirstInLastOut"
                                         Visibility="{Binding Waiting.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" />
                </DockPanel>
            </Border>

            <!-- ویزیت‌شده‌های امروز -->
            <Border Grid.Column="2" CornerRadius="12" Padding="12"
                    Background="{DynamicResource MaterialDesign.Brush.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                    BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ویزیت‌شده‌های امروز شما" FontWeight="Bold" FontSize="13.5" Margin="2,0,2,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Done}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="10,7" Margin="0,0,0,6" Background="#E8F5E9">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CheckCircle" Width="15" Height="15" Foreground="#2E7D32" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" FontSize="12.5" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock FontSize="11" Opacity="0.75" Margin="0,3,0,0" FontFamily="{DynamicResource App.CodeFont}">
                                                <Run Text="{Binding TimeRange, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock FontSize="11" Opacity="0.75" Margin="0,2,0,0">
                                                <Run Text="تشخیص: " /><Run Text="{Binding DiagnosisText, Mode=OneWay, TargetNullValue=—}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <controls:EmptyState Message="هنوز ویزیتی تکمیل نشده" IconKind="ClipboardCheckOutline"
                                         Visibility="{Binding Done.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- دکمه فراخوان -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
            <!-- ═══ چرخهٔ ۴۷ (گزارش مالک — قانون هم‌کلاسی‌ها) ═══ همان اصلاح
                 دکمهٔ فراخوانِ صفحهٔ ویزیت و معاینه: دیوار کف ارتفاع ۴۶px +
                 کمینهٔ عرض + شکستن متن تا در پنجره‌های تنگ له/بریده نشود. -->
            <Button Command="{Binding CallNextCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#2E7D32" BorderBrush="#2E7D32"
                    FontSize="13" Padding="20,12" MinWidth="230" MinHeight="46">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="BellRing" Width="17" Height="17" VerticalAlignment="Center" />
                    <TextBlock Text="فراخوانی بیمار بعدی (Space)" Margin="10,0,0,0"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <ProgressBar IsIndeterminate="True" Width="24" Height="18" Margin="12,0,0,0"
                         Visibility="{Binding IsCalling, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Grid>
</UserControl>
