<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.StocktakingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             FlowDirection="RightToLeft">
    <!-- ═══ انبارگردانی داروخانه — گام P2: دو پنل جلسات + اقلام ═══ -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- سربرگ + شروع جلسه -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="26" Height="26"
                                         Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
                <TextBlock Text="انبارگردانی داروخانه" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="شمارش ادواری موجودی + اعمال مغایرت با تراکنش اصلاح" FontSize="11.5" Opacity="0.6"
                           Margin="14,4,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox Text="{Binding NewSessionNotes, UpdateSourceTrigger=PropertyChanged}" Width="240" FontSize="12"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="یادداشت جلسه جدید (اختیاری)" VerticalAlignment="Center" />
                <Button Command="{Binding StartSessionCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PlayCircleOutline" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="شروع انبارگردانی" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding LoadSessionsCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="8,0,0,0" ToolTip="بازآوری فهرست">
                    <materialDesign:PackIcon Kind="Refresh" Width="15" Height="15" />
                </Button>
            </StackPanel>
        </Grid>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!-- سربرگ جلسه جاری + اقدامات -->
        <Border Grid.Row="2" CornerRadius="10" Padding="12,8" Margin="0,0,0,10"
                Background="{DynamicResource MaterialDesign.Brush.Separator.Background}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SessionHeader}" FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center" />
                        <Ellipse Width="10" Height="10" Margin="10,0,0,0" VerticalAlignment="Center" Fill="{Binding SessionStatusColor}" />
                    </StackPanel>
                    <TextBlock Text="{Binding SummaryText}" FontSize="11.5" Opacity="0.75" Margin="0,3,0,0" FontFamily="Consolas" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding FinalizeSessionCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="6,0,0,0"
                            Visibility="{Binding IsInProgress, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="قفل شمارش‌ها و انتقال به وضعیت در انتظار تأیید">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckAll" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="تکمیل جلسه" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ApproveSessionCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="6,0,0,0"
                            Background="#43A047" BorderBrush="#43A047"
                            Visibility="{Binding IsAwaitingApproval, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="اعمال مغایرت‌ها به موجودی + ثبت تراکنش اصلاح">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClipboardCheck" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="تأیید و اعمال مغایرت" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CancelSessionCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="6,0,0,0"
                            Visibility="{Binding IsInProgress, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CloseCircleOutline" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="لغو جلسه" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- بدنه دو پنلی -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- فهرست جلسات -->
            <Border Grid.Column="0" CornerRadius="10" Margin="0,0,8,0" Padding="6"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="🗂 جلسات انبارگردانی" FontSize="13" FontWeight="SemiBold" Margin="6,4,4,8" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="2,4" Padding="10,8" CornerRadius="8"
                                        Background="{DynamicResource MaterialDesign.Brush.Separator.Background}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Number}" FontSize="12.5" FontWeight="SemiBold" FontFamily="Consolas" />
                                            <Border Grid.Column="1" CornerRadius="9" Padding="8,2" Background="{Binding StatusColor}">
                                                <TextBlock Text="{Binding Status}" FontSize="9.5" Foreground="White" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <materialDesign:PackIcon Kind="Calendar" Width="12" Height="12" Opacity="0.6" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Date}" FontSize="10.5" Opacity="0.7" Margin="4,0,0,0" />
                                            <materialDesign:PackIcon Kind="Counter" Width="12" Height="12" Opacity="0.6" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Progress}" FontSize="10.5" Opacity="0.7" Margin="4,0,0,0" FontFamily="Consolas" />
                                            <materialDesign:PackIcon Kind="CompareHorizontal" Width="12" Height="12" Opacity="0.6" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Diffs}" FontSize="10.5" Opacity="0.7" Margin="4,0,0,0" FontFamily="Consolas" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- اقلام جلسه + فرم شمارش -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- فرم ورود شمارش -->
                <Border Grid.Row="0" CornerRadius="10" Padding="10,8" Margin="0,0,0,8"
                        Background="#E8F5E9" Visibility="{Binding IsInProgress, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PencilBoxOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="#2E7D32" />
                        <TextBlock Text="قلم انتخاب‌شده:" FontSize="12" VerticalAlignment="Center" Margin="8,0,6,0" />
                        <TextBlock Text="{Binding SelectedItem.Medication, TargetNullValue='—'}" FontSize="12.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" MinWidth="150" />
                        <TextBlock Text="موجودی سیستم:" FontSize="11" Opacity="0.7" VerticalAlignment="Center" Margin="16,0,6,0" />
                        <TextBlock Text="{Binding SelectedItem.SystemQty, TargetNullValue='—'}" FontSize="12" FontFamily="Consolas" VerticalAlignment="Center" />
                        <TextBlock Text="شمارش من:" FontSize="12" VerticalAlignment="Center" Margin="16,0,6,0" />
                        <TextBox Text="{Binding CountInput, UpdateSourceTrigger=PropertyChanged}" Width="90" FontSize="12"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="عدد" />
                        <TextBox Text="{Binding CountNote, UpdateSourceTrigger=PropertyChanged}" Width="180" FontSize="12" Margin="8,0,0,0"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="یادداشت (اختیاری)" />
                        <Button Command="{Binding SaveCountCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="8,0,0,0">
                            <materialDesign:PackIcon Kind="ContentSaveCheckOutline" Width="15" Height="15" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- جستجوی قلم + جدول اقلام -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" Text="{Binding ItemFilter, UpdateSourceTrigger=PropertyChanged}" FontSize="12"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8"
                             materialDesign:HintAssist.Hint="🔍 جستجوی دارو یا بچ در اقلام جلسه" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" FontSize="12" AlternatingRowBackground="#F6FBF7"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DiffColor}" Value="#E53935">
                                        <Setter Property="Background" Value="#FFEBEE" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DiffColor}" Value="#1E88E5">
                                        <Setter Property="Background" Value="#E3F2FD" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="دارو" Binding="{Binding Medication, Converter={StaticResource PersianDigits}}" Width="*" />
                            <DataGridTextColumn Header="بچ" Binding="{Binding Batch, Converter={StaticResource PersianDigits}}" Width="110" />
                            <DataGridTextColumn Header="موجودی سیستم" Binding="{Binding SystemQty, Converter={StaticResource PersianDigits}}" Width="100" />
                            <DataGridTextColumn Header="شمارش واقعی" Binding="{Binding CountedQty, Converter={StaticResource PersianDigits}}" Width="100" />
                            <DataGridTextColumn Header="مغایرت" Binding="{Binding DiffText, Converter={StaticResource PersianDigits}}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding Notes, Converter={StaticResource PersianDigits}}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
