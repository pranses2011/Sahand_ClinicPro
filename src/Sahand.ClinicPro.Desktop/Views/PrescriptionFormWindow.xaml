<Window xmlns:shortcuts="clr-namespace:Sahand.ClinicPro.Desktop.Services" x:Class="Sahand.ClinicPro.Desktop.Views.PrescriptionFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding FormTitle, Mode=OneWay}"
        Width="1060" Height="760"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft">
    <!-- ═══ نسخه‌نویسی — گام U7 طبق پرامپت UI بخش ۲ (فرم ۱۲) ═══ -->
    <Window.Resources>
        <Style x:Key="FieldCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Margin" Value="1,4,1,2" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="{Binding FormTitle, Mode=OneWay}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Left" Command="{Binding CloseCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" HorizontalAlignment="Left" Margin="12,0,0,0">
                <TextBlock Text="بستن" />
            </Button>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- ═══ بیمار و پزشک ═══ -->
                <Border CornerRadius="12" Padding="12,10" Margin="0,0,0,10"
                        Background="{DynamicResource MaterialDesign.Brush.Background}"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="🔍 بیمار (کد ملی / موبایل)" Style="{StaticResource FieldCaption}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding PatientSearch, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SearchPatientCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="1" Command="{Binding SearchPatientCommand}" Margin="8,0,0,0"
                                        Style="{StaticResource MaterialDesignRaisedButton}">
                                    <materialDesign:PackIcon Kind="Magnify" Width="15" Height="15" />
                                </Button>
                            </Grid>
                            <Border Background="#E3F2FD" CornerRadius="8" Padding="10,5" Margin="0,6,0,0"
                                    Visibility="{Binding Patient, Converter={StaticResource NullToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountCheck" Width="15" Height="15" Foreground="#1565C0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Patient.FullName, Mode=OneWay}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                    <TextBlock Text="{Binding Patient.InsuranceName, Mode=OneWay, TargetNullValue=آزاد}"
                                               FontSize="11" Opacity="0.7" Margin="14,0,0,0" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                    <Border Background="#FFEBEE" CornerRadius="7" Padding="7,1" Margin="10,0,0,0"
                                            Visibility="{Binding Patient.Allergies, Converter={StaticResource NullToVisibility}}">
                                        <TextBlock FontSize="10.5" Foreground="#C62828">
                                            <Run Text="⚠️ " /><Run Text="{Binding Patient.Allergies, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="👨‍⚕️ پزشک معالج" Style="{StaticResource FieldCaption}" />
                            <ComboBox ItemsSource="{Binding Doctors}"
                                      SelectedIndex="{Binding DoctorIndex}"
                                      DisplayMemberPath="Name" />
                            <TextBlock Text="نوع نسخه" Style="{StaticResource FieldCaption}" />
                            <ComboBox SelectedIndex="{Binding TypeIndex}">
                                <ComboBoxItem Content="📄 داخلی" />
                                <ComboBoxItem Content="💻 سلامت (الکترونیک)" />
                                <ComboBoxItem Content="💻 تأمین اجتماعی" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="📋 انتخاب از تمپلیت" Style="{StaticResource FieldCaption}" />
                            <ComboBox ItemsSource="{Binding Templates}"
                                      SelectedIndex="{Binding TemplateIndex}"
                                      DisplayMemberPath="Name" />
                            <Button Command="{Binding LoadTemplateCommand}" Margin="0,6,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="11">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DownloadOutline" Width="13" Height="13" VerticalAlignment="Center" />
                                    <TextBlock Text="بارگذاری تمپلیت" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══ جستجوی دارو ═══ -->
                <Border CornerRadius="12" Padding="12,10" Margin="0,0,0,10"
                        Background="{DynamicResource MaterialDesign.Brush.Background}"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1">
                    <StackPanel>
                        <!-- چرخه بیستم (گزارش چهاردهم مالک): دکمهٔ بروزرسانی فهرست داروها —
                             داروهای تازهٔ کاتالوگ مرجع به دیتابیس سرور افزوده می‌شوند -->
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Left" Command="{Binding UpdateMedicationsCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="11"
                                    ToolTip="داروهای جدید کاتالوگ مرجع را به فهرست جستجو می‌افزاید">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DatabaseRefresh" Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock Text="بروزرسانی فهرست داروها" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="فهرست داروها با دکمهٔ کنار بروزرسانی می‌شود؛ داروهای جدید پس از بروزرسانی در جستجو ظاهر می‌شوند."
                                       FontSize="10" Opacity="0.55" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Margin="10,0,0,0" />
                        </DockPanel>
                        <TextBlock Text="🔍 جستجوی دارو (نام ژنریک / تجاری / بارکد / IRC)" Style="{StaticResource FieldCaption}" />
                        <TextBox Text="{Binding MedicationSearch, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="حداقل ۲ کاراکتر — نتایج با تأخیر ۳۰۰ میلی‌ثانیه ظاهر می‌شوند" />
                        <ListBox ItemsSource="{Binding MedicationResults}" MaxHeight="170" Margin="0,6,0,0"
                                 Visibility="{Binding MedicationResults.Count, Converter={StaticResource NullToVisibility}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.AddMedicationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}" HorizontalContentAlignment="Right">
                                        <Grid Width="820">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Kind="Pill" Width="16" Height="16" Foreground="#00897B" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding NameFa}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding NameEn}" FontSize="11" Opacity="0.6" Margin="14,0,0,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Form, Mode=OneWay, FallbackValue=''}" FontSize="11" Opacity="0.6" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Strength, Mode=OneWay, FallbackValue=''}" FontSize="11" Opacity="0.6" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <TextBlock Text="{Binding IrcCode, Mode=OneWay, FallbackValue=''}" FontSize="10" Opacity="0.55" FontFamily="{DynamicResource App.CodeFont}" VerticalAlignment="Center" />
                                                <Border Background="#E0F2F1" CornerRadius="7" Padding="7,1" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Country, Mode=OneWay}" FontSize="10" Foreground="#00695C" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- ═══ اقلام نسخه ═══ -->
                <TextBlock FontSize="14" FontWeight="Bold" Margin="2,0,0,6">
                    <Run Text="💊 اقلام نسخه (" /><Run Text="{Binding Items.Count, Mode=OneWay}" /><Run Text=" قلم)" />
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Padding="12,10" Margin="0,0,0,8"
                                    Background="{DynamicResource MaterialDesign.Brush.Background}"
                                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}" BorderThickness="1">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Pill" Width="18" Height="18" Foreground="#00897B" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Margin="9,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Subtitle, Mode=OneWay, FallbackValue=''}" FontSize="11" Opacity="0.6" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconForegroundButton}" Foreground="#C62828"
                                                ToolTip="حذف دارو از نسخه" Padding="5">
                                            <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" />
                                        </Button>
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="دوز" Style="{StaticResource FieldCaption}" />
                                            <ComboBox ItemsSource="{Binding DataContext.Dosages, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding Dosage}" IsEditable="True" FontSize="11.5" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                            <TextBlock Text="تعداد مصرف" Style="{StaticResource FieldCaption}" />
                                            <ComboBox ItemsSource="{Binding DataContext.Frequencies, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding Frequency}" IsEditable="True" FontSize="11.5" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                            <TextBlock Text="مدت" Style="{StaticResource FieldCaption}" />
                                            <ComboBox ItemsSource="{Binding DataContext.Durations, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding Duration}" IsEditable="True" FontSize="11.5" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Margin="0,0,6,0">
                                            <TextBlock Text="مسیر" Style="{StaticResource FieldCaption}" />
                                            <ComboBox ItemsSource="{Binding DataContext.Routes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding Route}" FontSize="11.5" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Margin="0,0,6,0" Width="92">
                                            <TextBlock Text="تعداد کل" Style="{StaticResource FieldCaption}" />
                                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" FontSize="12" FontFamily="{DynamicResource App.CodeFont}" TextAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="5">
                                            <TextBlock Text="واحد" Style="{StaticResource FieldCaption}" />
                                            <ComboBox ItemsSource="{Binding DataContext.Units, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding Unit}" FontSize="11.5" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.4*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding Instructions, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="دستور مصرف — مثلاً: بعد از غذا با آب زیاد" FontSize="11.5" Margin="0,0,8,0" />
                                        <CheckBox Grid.Column="1" Content="در صورت نیاز (SOS)" IsChecked="{Binding IsSos}" VerticalAlignment="Center" FontSize="11.5" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ═══ پنل خطر تشخیصی جامع — چرخه ۱۳ (۷ بُعد ایمنی بالینی) ═══ -->
                <Border CornerRadius="12" Padding="12,10" Margin="0,6,0,10" BorderThickness="1.5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#E8F5E9" />
                            <Setter Property="BorderBrush" Value="#A5D6A7" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSevereInteraction}" Value="True">
                                    <Setter Property="Background" Value="#FFEBEE" />
                                    <Setter Property="BorderBrush" Value="#EF9A9A" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasAllergyConflict}" Value="True">
                                    <Setter Property="Background" Value="#FCE4EC" />
                                    <Setter Property="BorderBrush" Value="#B71C1C" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="13.5" FontWeight="Bold">
                                <Run Text="⚗️ بررسی خطر تشخیصی — تداخل، حساسیت، بارداری، سن، دوز" />
                            </TextBlock>
                            <!-- چرخه بیستم (گزارش چهاردهم مالک): بروزرسانی کش محلی تداخل‌ها —
                                 کل کاتالوگ سرور در %AppData% ذخیره می‌شود تا بررسی‌ها حتی
                                 بی‌اتصال از پایگاه داخلی انجام شوند -->
                            <Button Grid.Column="1" Command="{Binding UpdateInteractionsCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="11"
                                    Margin="0,0,10,0"
                                    ToolTip="کاتالوگ کامل تداخل‌ها را از سرور می‌گیرد و در برنامه ذخیره می‌کند — تداخل‌های جدید اضافه می‌شوند">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Sync" Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock Text="بروزرسانی تداخل‌ها" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <!-- چک‌باکس‌های وضعیت مادر — چرخه ۱۳ -->
                            <CheckBox Grid.Column="2" Content="🤰 باردار" IsChecked="{Binding IsPregnant}" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,10,0" />
                            <CheckBox Grid.Column="3" Content="🍼 شیرده" IsChecked="{Binding IsBreastfeeding}" FontSize="11.5" FontWeight="SemiBold" />
                        </Grid>
                        <!-- وضعیت کش تداخل محلی — چرخه بیستم -->
                        <TextBlock Text="{Binding InteractionCacheText, Mode=OneWay}" FontSize="10" Opacity="0.6"
                                   Margin="0,0,0,4" TextWrapping="Wrap" />

                        <!-- بدون تداخل -->
                        <TextBlock Text="✅ هیچ خطر بالینی شناسایی نشد"
                                   Foreground="#2E7D32" FontWeight="SemiBold"
                                   Visibility="{Binding NoInteractions, Converter={StaticResource BoolToVisibility}}" />

                        <!-- هشدار آلرژی — قرمز تیره -->
                        <Border Background="#B71C1C" CornerRadius="8" Padding="10,6" Margin="0,0,0,6"
                                Visibility="{Binding HasAllergyConflict, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Foreground="White" FontWeight="Bold" FontSize="12.5" TextWrapping="Wrap">
                                <Run Text="🚨 هشدار حساسیت: این نسخه شامل دارویی است که بیمار به آن حساسیت دارد! حذف دارو یا تأیید صریح با مسئولیت پزشک الزامی است." />
                            </TextBlock>
                        </Border>

                        <!-- هشدار بارداری — چرخه ۱۳ -->
                        <Border Background="#8E24AA" CornerRadius="8" Padding="10,6" Margin="0,0,0,6"
                                Visibility="{Binding HasPregnancyRisk, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Foreground="White" FontWeight="Bold" FontSize="12.5" TextWrapping="Wrap">
                                <Run Text="🤰 هشدار بارداری: داروی رده D/X در نسخه است — تأیید پزشک با اطلاع کامل بیمار الزامی است." />
                            </TextBlock>
                        </Border>

                        <!-- فهرست خطرها -->
                        <ItemsControl ItemsSource="{Binding Interactions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="10,6" Margin="0,0,0,5"
                                            Background="{Binding SeverityColor, Mode=OneWay}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding KindIcon, Mode=OneWay}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="Bold" FontSize="12.5" />
                                                <Border Grid.Column="2" Background="#FFFFFF55" CornerRadius="7" Padding="7,2" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding KindLabel, Mode=OneWay}" FontSize="10" FontWeight="SemiBold"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                                </Border>
                                                <Border Grid.Column="3" Background="#FFFFFF88" CornerRadius="7" Padding="8,2" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding SeverityText}" FontSize="11" FontWeight="SemiBold"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock FontSize="11" Opacity="0.85" Margin="0,3,0,0" TextWrapping="Wrap">
                                                <Run Text="مکانیزم: " FontWeight="SemiBold" /><Run Text="{Binding Mechanism, Mode=OneWay, TargetNullValue=—}" />
                                            </TextBlock>
                                            <TextBlock FontSize="11" Opacity="0.85" Margin="0,2,0,0" TextWrapping="Wrap">
                                                <Run Text="توصیه: " FontWeight="SemiBold" /><Run Text="{Binding Recommendation, Mode=OneWay, TargetNullValue=—}" Foreground="#1B5E20" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ═══ کادر دلیل تأیید پزشک — فقط با منع مطلق ظاهر می‌شود (چرخه ۱۳) ═══ -->
                <Border Background="#FFF8E1" CornerRadius="10" Padding="10,8" Margin="0,0,0,10" BorderBrush="#FFB300" BorderThickness="1.2"
                        Visibility="{Binding HasAbsoluteBlock, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,4"
                                   Text="🩺 دلیل تأیید پزشک برای ادامه با وجود منع مصرف (الزامی — در پرونده ثبت می‌شود):" />
                        <TextBox Text="{Binding OverrideReason, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="مثلاً: سابقه مصرف بدون عارضه و نبود جایگزین در دسترس"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 FontSize="12" TextWrapping="Wrap" MinLines="2" MaxLength="400" />
                    </StackPanel>
                </Border>

                <!-- ═══ کد رهگیری الکترونیک ═══ -->
                <Border Background="#E3F2FD" CornerRadius="12" Padding="14,10" Margin="0,0,0,10"
                        Visibility="{Binding ElectronicTrackingCode, Converter={StaticResource NullToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckDecagram" Width="26" Height="26" Foreground="#1565C0" VerticalAlignment="Center" />
                        <TextBlock Text="کد رهگیری نسخه الکترونیک:" FontWeight="Bold" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                        <TextBlock Text="{Binding ElectronicTrackingCode, Mode=OneWay}" FontSize="19" FontWeight="Bold"
                                   FontFamily="{DynamicResource App.CodeFont}" Foreground="#0D47A1" VerticalAlignment="Center" Margin="10,0,0,0" />
                        <Button Command="{Binding CopyTrackingCodeCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Margin="14,0,0,0" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentCopy" Width="13" Height="13"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                <TextBlock Text="کپی" Margin="6,0,0,0"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SendTrackingSmsCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Margin="8,0,0,0" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MessageText" Width="13" Height="13"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                <TextBlock Text="📱 ارسال SMS به بیمار" Margin="6,0,0,0"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ═══ توضیحات و تمپلیت جدید ═══ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="📝 توضیحات پزشک" Style="{StaticResource FieldCaption}" />
                        <TextBox Text="{Binding DoctorNotes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="58"
                                 materialDesign:HintAssist.Hint="مثلاً: رعایت رژیم غذایی کم‌نمک و پیاده‌روی روزانه ۳۰ دقیقه" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="💾 ذخیره به‌عنوان تمپلیت" Style="{StaticResource FieldCaption}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewTemplateName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="نام تمپلیت — مثلاً نسخه دیابت" Margin="0,0,8,0" />
                            <Button shortcuts:SaveShortcut.Number="1" Grid.Column="1" Command="{Binding SaveAsTemplateCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}">
                                <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ContentSavePlus" Width="15" Height="15" /><TextBlock Text=" (Ctrl+Shift+1)" VerticalAlignment="Center" /></StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ نوار پایین ═══ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button shortcuts:SaveShortcut.Number="2" Command="{Binding SaveCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="13" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="💾 ذخیره (Ctrl+Shift+2)" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <Button shortcuts:SaveShortcut.Number="3" Command="{Binding SubmitElectronicCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}" Background="#1565C0" BorderBrush="#1565C0"
                    FontSize="13" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="16" Height="16" IsIndeterminate="True"
                                 Visibility="{Binding IsSubmitting, Converter={StaticResource BoolToVisibility}}" />
                    <materialDesign:PackIcon Kind="CloudUpload" Width="16" Height="16" VerticalAlignment="Center"
                                             Visibility="{Binding IsSubmitting, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                    <TextBlock Text="✅ ارسال به سامانه بیمه (Ctrl+Shift+3)" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <Button Command="{Binding PrintCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="13" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Printer" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="🖨️ چاپ" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <ProgressBar IsIndeterminate="True" Width="22" Height="16" Margin="8,0,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />
        </StackPanel>
    </Grid>
</Window>
