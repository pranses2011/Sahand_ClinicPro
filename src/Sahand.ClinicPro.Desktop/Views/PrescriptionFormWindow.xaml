<Window x:Class="Sahand.ClinicPro.Desktop.Views.PrescriptionFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="صدور نسخه"
        Height="760" Width="860"
        WindowStartupLocation="CenterOwner"
        FontFamily="Vazirmatn, Segoe UI, Tahoma">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!-- ═══════════════════════════════════════════════════════════
         فرم صدور نسخه — گام V4
         بیمار + پزشک + اقلام دارویی قابل ویرایش
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="صدور نسخه جدید" Style="{StaticResource SectionTitle}" />

        <!-- بیمار و پزشک -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBox materialDesign:HintAssist.Hint="جستجوی بیمار: نام یا کد ملی *"
                         Text="{Binding PatientSearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,6">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchPatientCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <ListBox ItemsSource="{Binding PatientResults}"
                         SelectedItem="{Binding SelectedPatient}"
                         Height="96"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                                <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.75" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="10,0">
                <ComboBox materialDesign:HintAssist.Hint="پزشک *"
                          ItemsSource="{Binding Doctors}"
                          DisplayMemberPath="Name"
                          SelectedIndex="{Binding DoctorIndex}"
                          Margin="0,0,0,6" />
                <TextBox materialDesign:HintAssist.Hint="شناسه ویزیت مرتبط (اختیاری)"
                         Text="{Binding VisitId, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,6" />
                <ComboBox materialDesign:HintAssist.Hint="نوع نسخه"
                          SelectedIndex="{Binding TypeIndex}"
                          Margin="0,0,0,6">
                    <ComboBoxItem Content="دارویی" />
                    <ComboBoxItem Content="پاراکلینیکی" />
                    <ComboBoxItem Content="ترکیبی" />
                </ComboBox>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="نسخه الکترونیک"
                              IsChecked="{Binding IsElectronic}"
                              Margin="0,0,14,0" />
                    <CheckBox Content="داروی مخدر"
                              IsChecked="{Binding IsNarcotic}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="نسخه‌های الکترونیک پس از صدور به سامانه بیمه ارسال می‌شوند"
                           TextWrapping="Wrap" FontSize="11" Opacity="0.7" />
            </StackPanel>
        </Grid>

        <!-- جستجوی دارو -->
        <DockPanel Grid.Row="2" Margin="0,0,0,10">
            <Button DockPanel.Dock="Left"
                    Command="{Binding AddMedicationCommand}"
                    IsEnabled="{Binding SelectedMedication, Converter={StaticResource NotNullToBool}}"
                    Style="{StaticResource MaterialDesignFilledButton}"
                    Content="افزودن دارو" Margin="0,0,10,0" />
            <Button DockPanel.Dock="Right"
                    Command="{Binding RemoveItemCommand}"
                    IsEnabled="{Binding SelectedItem, Converter={StaticResource NotNullToBool}}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="حذف قلم" Margin="10,0,0,0" />
            <ComboBox materialDesign:HintAssist.Hint="جستجوی دارو: نام ژنریک یا برند"
                      Text="{Binding MedicationSearchTerm, UpdateSourceTrigger=PropertyChanged}"
                      ItemsSource="{Binding MedicationResults}"
                      SelectedItem="{Binding SelectedMedication}"
                      IsEditable="True" />
        </DockPanel>

        <!-- اقلام نسخه -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  materialDesign:DataGridAssist.CellPadding="6,4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="دارو" Binding="{Binding MedicationName}" Width="2*" IsReadOnly="True" />
                <DataGridTextColumn Header="دوز" Binding="{Binding Dosage, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                <DataGridTextColumn Header="تکرار" Binding="{Binding Frequency, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                <DataGridTextColumn Header="مدت" Binding="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                <DataGridTextColumn Header="تعداد" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                <DataGridTextColumn Header="واحد" Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                <DataGridTextColumn Header="دستور مصرف" Binding="{Binding Instructions, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                <DataGridCheckBoxColumn Header="SOS" Binding="{Binding IsSos, UpdateSourceTrigger=PropertyChanged}" Width="50" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- پاورقی -->
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.Error}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
            <UniformGrid Columns="2">
                <Button Command="{Binding SaveCommand}"
                        Style="{StaticResource MaterialDesignFilledButton}"
                        Content="صدور نسخه" Height="42" Margin="4" />
                <Button Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Content="انصراف" Height="42" Margin="4" />
            </UniformGrid>
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,14,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Grid>
</Window>