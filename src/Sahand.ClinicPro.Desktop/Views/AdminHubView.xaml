<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.AdminHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sahand.ClinicPro.Desktop.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!-- مرکز یکپارچهٔ مدیریت سامانه — بازطراحی تأییدشده: یک آیتم منو،
         ده تب؛ هر تب همان صفحهٔ قبلی با همان ویومدل خودش است -->
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,0,10">
            <TextBlock Text="مدیریت سامانه" FontSize="19" FontWeight="Bold" />
            <TextBlock Text="همهٔ تنظیمات و ابزارهای مدیریتی درمانگاه در یک جا — هر بخش در تب خودش"
                       FontSize="11.5" Opacity="0.65" Margin="0,3,0,0" />
        </StackPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}"
                    materialDesign:ColorZoneAssist.Mode="PrimaryLight">
            <TabItem Header="⚙️ تنظیمات درمانگاه">
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
            <TabItem Header="🖨️ چاپ و قالب‌ها">
                <views:ComplementaryView DataContext="{Binding Complementary}" />
            </TabItem>
            <TabItem Header="👥 کاربران">
                <views:UsersView DataContext="{Binding Users}" />
            </TabItem>
            <TabItem Header="🛡️ نقش‌ها و دسترسی">
                <views:RolePermissionView DataContext="{Binding Roles}" />
            </TabItem>
            <TabItem Header="🧾 خدمات و تعرفه">
                <views:ServiceCatalogView DataContext="{Binding ServiceCatalog}" />
            </TabItem>
            <TabItem Header="🚪 اتاق‌ها">
                <views:RoomsView DataContext="{Binding Rooms}" />
            </TabItem>
            <TabItem Header="🏢 شعبه‌ها">
                <views:BranchesView DataContext="{Binding Branches}" />
            </TabItem>
            <TabItem Header="💾 پشتیبان‌گیری و آرشیو">
                <views:AdminView DataContext="{Binding Admin}" />
            </TabItem>
            <TabItem Header="📜 لاگ عملیات">
                <views:AuditLogView DataContext="{Binding Audit}" />
            </TabItem>
            <TabItem Header="🔑 لایسنس">
                <views:LicenseStatusView DataContext="{Binding License}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
