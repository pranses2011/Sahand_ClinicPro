<Window x:Class="Sahand.ClinicPro.Desktop.Views.ShiftReceiptPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="پیش‌نمایش رسید بستن شیفت"
        Width="460" Height="760" MinWidth="420" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        ShowInTaskbar="False">
    <!-- ═══════════════════════════════════════════════════════════
         پیش‌نمایش رسید بستن شیفت — چرخهٔ چهل‌وسوم (گزارش مالک):
         «با بستن شیفت، میگه که رسید ثبت شد ولی پیشنمایش رسید رو نشون
         نمیده تا چاپ بکنیم» — پس از هر بستنِ موفق شیفت، همین پنجره با
         چیدمان «رسید کاغذی» (همان سند چاپی) باز می‌شود: سربرگ درمانگاه،
         مبالغ سیستم، شمارش فیزیکی و اختلاف‌ها با واحد پول نمایشی؛ دکمهٔ
         چاپ همان سند را به چاپگر رسید می‌فرستد.
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- سربرگ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <materialDesign:PackIcon Kind="ReceiptTextOutline" Width="24" Height="24"
                                     Foreground="#F57C00" VerticalAlignment="Center" />
            <TextBlock Text="پیش‌نمایش رسید تحویل صندوق" FontSize="16" FontWeight="Bold"
                       Margin="10,0,0,0" VerticalAlignment="Center" />
        </DockPanel>

        <!-- بدنهٔ رسید — ظاهر کاغذی -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="#FFFFFF" CornerRadius="10" Padding="18,14"
                    BorderBrush="#E4E9F0" BorderThickness="1" MaxWidth="400"
                    HorizontalAlignment="Center" Width="396">
                <StackPanel>
                    <!-- سربرگ درمانگاه -->
                    <TextBlock Text="{Binding ClinicName}" FontSize="15" FontWeight="Bold"
                               HorizontalAlignment="Center"  Foreground="#1F2937"/>
                    <TextBlock Text="رسید بستن شیفت و تحویل صندوق" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,3,0,2" Opacity="0.75"  Foreground="#1F2937"/>
                    <TextBlock Text="{Binding HeaderLine}" FontSize="10.5" Opacity="0.65"
                               HorizontalAlignment="Center" Margin="0,0,0,4"  Foreground="#1F2937"/>
                    <Rectangle Height="1" Fill="#D9E2EC" Margin="0,4,0,8" />

                    <!-- مبالغ سیستم -->
                    <TextBlock Text="▌ مبالغ سیستم (ثبت‌شده)" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,5"  Foreground="#1F2937"/>
                    <ItemsControl ItemsSource="{Binding SystemLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="11"  Foreground="#1F2937"/>
                                    <TextBlock Text="{Binding Value}" Grid.Column="1" FontSize="11"
                                               FontWeight="SemiBold" HorizontalAlignment="Left"
                                               FontFamily="{DynamicResource App.CodeFont}"  Foreground="#1F2937"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Rectangle Height="1" Fill="#D9E2EC" Margin="0,8" />

                    <!-- شمارش فیزیکی -->
                    <TextBlock Text="▌ شمارش فیزیکی" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,5"  Foreground="#1F2937"/>
                    <ItemsControl ItemsSource="{Binding CountedLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="11"  Foreground="#1F2937"/>
                                    <TextBlock Text="{Binding Value}" Grid.Column="1" FontSize="11"
                                               FontWeight="SemiBold" HorizontalAlignment="Left"
                                               FontFamily="{DynamicResource App.CodeFont}"  Foreground="#1F2937"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Rectangle Height="1" Fill="#D9E2EC" Margin="0,8" />

                    <!-- اختلاف‌ها -->
                    <TextBlock Text="▌ اختلاف‌سنجی" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,5"  Foreground="#1F2937"/>
                    <ItemsControl ItemsSource="{Binding DifferenceLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="11"  Foreground="#1F2937"/>
                                    <TextBlock Text="{Binding Value}" Grid.Column="1" FontSize="11"
                                               FontWeight="SemiBold" HorizontalAlignment="Left"
                                               FontFamily="{DynamicResource App.CodeFont}"  Foreground="#1F2937"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Background="#F5F7FB" CornerRadius="8" Padding="10,7" Margin="0,6,0,0">
                        <TextBlock Text="{Binding DifferenceState}" FontSize="12.5" FontWeight="Bold"
                                   HorizontalAlignment="Center" Foreground="{Binding DifferenceColor}" />
                    </Border>

                    <TextBlock Text="{Binding FooterLine}" FontSize="10.5" Opacity="0.7" Margin="2,10,2,0"
                               TextWrapping="Wrap"  Foreground="#1F2937"/>

                    <Rectangle Height="1" Fill="#D9E2EC" Margin="0,10,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="امضای تحویل‌گیرنده" FontSize="10" Opacity="0.65" HorizontalAlignment="Center"  Foreground="#1F2937"/>
                            <Rectangle Height="30" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="امضای تحویل‌دهنده" FontSize="10" Opacity="0.65" HorizontalAlignment="Center"  Foreground="#1F2937"/>
                            <Rectangle Height="30" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- پانوشت — چاپ و بستن (همیشه نمایان؛ بیرون از اسکرول) -->
        <UniformGrid Grid.Row="2" Columns="2" Margin="0,12,0,0">
            <Button Click="OnPrintClicked"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#00838F" BorderBrush="#00838F"
                    Height="44" Margin="4" MinWidth="140">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="Printer" Width="17" Height="17" VerticalAlignment="Center" />
                    <TextBlock Text="چاپ رسید" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Click="OnCloseClicked"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="بستن" Height="44" Margin="4" MinWidth="120" />
        </UniformGrid>
    </Grid>
</Window>
