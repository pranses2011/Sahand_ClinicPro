<Window x:Class="Sahand.ClinicPro.Desktop.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:Sahand.ClinicPro.Desktop.Helpers"
        Title="درباره نرم‌افزار"
        Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        UseLayoutRounding="True">

    <!-- ═══════════════════════════════════════════════════════════
         چرخهٔ ۷۸ (بند ۳ مالک): «در فرم درباره نرم‌افزار از تصویر برنامه
         استفاده بکن و مانند صفحه Splash زمینه شفاف داشته باشه».
         طراحیِ دقیقاً هم‌خانوادهٔ SplashWindow:
           • پنجرهٔ بدون قاب (WindowStyle=None) با AllowsTransparency —
             پشتِ لوگو کاملاً شفاف است و فرم مثل اسپلش «معمولی و مثل فرم»
             دیده نمی‌شود؛
           • لوگوی بزرگ برنامه (ClinicPro-512.png — همان تصویر اسپلش) بدون
             هیچ ظرف و جلوهٔ بصری روی زمینهٔ شفاف شناور است (زوم نرم ورود)؛
           • همهٔ نوشته‌ها و کارت‌ها داخل «شیشهٔ نیلی نیمه‌مات» گوشه‌گرد با
             حاشیهٔ آبی‌روشن — همان زبان بصری کادر زیرنویس اسپلش؛
           • کارت‌های داخلی (اطلاعات درمانگاه / پشتیبانی) شیشهٔ تیره‌ترِ
             درونِ شیشه — سلسله‌مراتب بصری خوانا؛
           • جابه‌جایی پنجره با درگ روی سربرگ؛ دکمهٔ بستن دایره‌ای شیشه‌ای؛
           • نشان بیلد (چرخهٔ ۶۷): اگر بستهٔ آپدیت تازه نشده باشد با یک
             نگاه مشخص است — «آپدیت اعمال نشده».
         ═══════════════════════════════════════════════════════════ -->

    <Grid Margin="18">
        <!-- سایهٔ نرم پنجرهٔ شفاف — بدون فاصلهٔ حاشیه بریده می‌شود -->
        <Border x:Name="GlassCard" Grid.Row="0" CornerRadius="22"
                Background="#D9132B50"
                BorderBrush="#5C8CB4E3" BorderThickness="1"
                MouseLeftButtonDown="OnGlassMouseDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.4" Color="#0A1E3C" />
            </Border.Effect>
            <Border.Resources>
                <!-- قلم روشن پیش‌فرض برای همهٔ متن‌های روی شیشهٔ تیره -->
                <SolidColorBrush x:Key="GlassText" Color="#EAF3FE" />
                <SolidColorBrush x:Key="GlassTextDim" Color="#B9CDE8" />
            </Border.Resources>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ═══ سربرگ: لوگوی شناور + نام + نسخه (پشتِ لوگو شفافِ کامل) ═══ -->
                <StackPanel Grid.Row="0" MouseLeftButtonDown="OnGlassMouseDown">
                    <!-- لوگوی بزرگ برنامه — همان تصویر اسپلش، بدون هیچ ظرف پس‌زمینه -->
                    <Image x:Name="LogoImage"
                           Source="/Assets/Logo/ClinicPro-512.png"
                           Width="170" Height="170"
                           Margin="0,-46,0,2"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="LogoScale" ScaleX="0.85" ScaleY="0.85" />
                        </Image.RenderTransform>
                        <Image.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- محوشدن ورود + بزرگ‌نمایی نرم — همان حس اسپلش -->
                                        <DoubleAnimation Storyboard.TargetName="LogoImage"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.5">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="LogoScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         From="0.85" To="1" Duration="0:0:0.55">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.3" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="LogoScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         From="0.85" To="1" Duration="0:0:0.55">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.3" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Image.Triggers>
                    </Image>

                    <!-- نام محصول و شرح کوتاه -->
                    <TextBlock Text="سامانه جامع مدیریت درمانگاه سهند"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="ClinicPro — نرم‌افزار یکپارچهٔ پذیرش، پروندهٔ الکترونیک، آزمایشگاه، داروخانه و حسابداری"
                               FontSize="11.5" Foreground="{StaticResource GlassTextDim}"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               Margin="28,4,28,0" />

                    <!-- نشان نسخه + بیلد — بیلدِ تازه نشده = آپدیت اعمال نشده (چرخهٔ ۶۷) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Border Background="#331E4E85" CornerRadius="11" Padding="13,4"
                                BorderBrush="#8CB4E3" BorderThickness="1">
                            <TextBlock Text="{x:Static helpers:AppInfo.VersionText}"
                                       Foreground="{StaticResource GlassText}"
                                       FontSize="12" FontWeight="SemiBold" />
                        </Border>
                        <Border Background="#26FFFFFF" CornerRadius="11" Padding="12,4" Margin="8,0,0,0">
                            <TextBlock Foreground="{StaticResource GlassTextDim}" FontSize="11">
                                <Run Text="بیلد: " />
                                <Run Text="{x:Static helpers:AppInfo.BuildStamp}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ═══ بدنه: کارت درمانگاه + کارت پشتیبانی — شیشهٔ تیره درون شیشه ═══ -->
                <StackPanel Grid.Row="1" Margin="24,18,24,0">

                    <!-- کارت اطلاعات درمانگاه — نام از سرور لایسنس -->
                    <Border Background="#400C1C33" CornerRadius="14" Padding="16,12"
                            BorderBrush="#268CB4E3" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="HospitalBuilding"
                                                         Width="17" Height="17"
                                                         Foreground="#8CB4E3"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="اطلاعات درمانگاه"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource GlassText}"
                                           Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                    <TextBlock Text="نام درمانگاه (از سرور لایسنس)" FontSize="10.5"
                                               Foreground="{StaticResource GlassTextDim}" Opacity="0.8" />
                                    <TextBlock x:Name="ClinicNameText" Text="در حال دریافت…"
                                               FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{StaticResource GlassText}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                                    <TextBlock Text="شماره لایسنس" FontSize="10.5"
                                               Foreground="{StaticResource GlassTextDim}" Opacity="0.8" />
                                    <TextBlock x:Name="LicenseKeyText" Text="—"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource GlassText}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="وضعیت لایسنس" FontSize="10.5"
                                               Foreground="{StaticResource GlassTextDim}" Opacity="0.8" />
                                    <TextBlock x:Name="LicenseStatusText" Text="در حال بررسی…"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource GlassText}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="تاریخ انقضای لایسنس" FontSize="10.5"
                                               Foreground="{StaticResource GlassTextDim}" Opacity="0.8" />
                                    <TextBlock x:Name="LicenseExpiryText" Text="—"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource GlassText}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- کارت پشتیبانی — کاملاً پویا از سرور لایسنس (license/support) -->
                    <Border Background="#400C1C33" CornerRadius="14" Padding="16,12"
                            BorderBrush="#268CB4E3" BorderThickness="1" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FaceAgent"
                                                         Width="17" Height="17"
                                                         Foreground="#7EE0B4"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="پشتیبانی"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource GlassText}"
                                           Margin="7,0,0,0" VerticalAlignment="Center" />
                                <!-- منبع اطلاعات: ذخیره‌شده | پنل | پیش‌فرض -->
                                <Border x:Name="SupportSourceBadge" Background="#33FFFFFF" CornerRadius="8"
                                        Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="SupportSourceText" FontSize="10"
                                               Foreground="{StaticResource GlassTextDim}" />
                                </Border>
                            </StackPanel>

                            <!-- ردیف‌های تماس — هر مقدار فقط وقتی هست دیده می‌شود -->
                            <StackPanel x:Name="SupportRows" Margin="0,10,0,0" />

                            <!-- هیچ اطلاعاتی از پنل نیامده — پیام روشن به‌جای جدول خالی -->
                            <TextBlock x:Name="SupportEmptyText"
                                       Text="اطلاعات پشتیبانی هنوز از سرور لایسنس دریافت نشده — با اولین اتصال به پنل به‌روزرسانی می‌شود"
                                       FontSize="11.5" Foreground="{StaticResource GlassTextDim}"
                                       TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- پانویس فناوری -->
                    <TextBlock x:Name="TechInfoText"
                               FontSize="10.5" Foreground="{StaticResource GlassTextDim}" Opacity="0.75"
                               TextWrapping="Wrap" Margin="2,12,2,0"
                               Text="ساخته‌شده با چارچوب .NET 8 و فناوری WPF · پایگاه‌دادهٔ SQL Server" />

                    <!-- دکمه‌ها — شیشه‌ای روشن هماهنگ با تم اسپلش -->
                    <Grid Margin="0,12,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- کپی اطلاعات — دکمهٔ شفاف با حاشیهٔ آبی‌روشن -->
                        <Button x:Name="CopyInfoButton" Click="OnCopyInfoClick"
                                HorizontalAlignment="Left" FontSize="12"
                                Background="#26FFFFFF" BorderBrush="#668CB4E3" BorderThickness="1"
                                Foreground="{StaticResource GlassText}"
                                Cursor="Hand" Content="کپی اطلاعات برای پشتیبانی">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CopyBd" Background="#26FFFFFF" CornerRadius="10"
                                            BorderBrush="#668CB4E3" BorderThickness="1" Padding="16,8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CopyBd" Property="Background" Value="#3DFFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- بستن — دکمهٔ پررنگ آبی روشن -->
                        <Button Grid.Column="1" Click="OnCloseClick"
                                FontSize="12" MinWidth="96" Cursor="Hand" Content="بستن">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CloseBd" CornerRadius="10" Padding="18,8">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#4FA3E3" Offset="0" />
                                                <GradientStop Color="#8FD4FF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          TextElement.Foreground="#0D2540"
                                                          TextElement.FontWeight="SemiBold" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CloseBd" Property="Opacity" Value="0.88" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- دکمهٔ بستن دایره‌ای شیشه‌ای — گوشهٔ بالا-چپ (RTL) -->
                <Button VerticalAlignment="Top" HorizontalAlignment="Left"
                        Margin="10,10,0,0" Click="OnCloseClick"
                        Width="30" Height="30" Cursor="Hand"
                        ToolTip="بستن">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="XBd" Background="#26FFFFFF" CornerRadius="15">
                                <TextBlock Text="✕" FontSize="12" Foreground="{StaticResource GlassText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="XBd" Property="Background" Value="#59C62828" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
