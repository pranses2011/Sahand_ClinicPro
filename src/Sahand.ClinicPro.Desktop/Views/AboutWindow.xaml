<Window x:Class="Sahand.ClinicPro.Desktop.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:Sahand.ClinicPro.Desktop.Helpers"
        Title="درباره نرم‌افزار"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        WindowStyle="SingleBorderWindow"
        UseLayoutRounding="True">

    <!-- ═══ چرخهٔ ۷۵ — فرم «درباره نرم‌افزار» (درخواست مالک) ═══
         «در یک نقطه از برنامه فرم زیبا و شکیل درباره نرم‌افزار رو تعبیه بکن و
         داخلش اطلاعات پشتیبانی بصورت پویا هم باشه» — طراحی:
           • سربرگ گرادیانی آبیِ برند با نشان برنامه، نام کامل محصول و نشان نسخه؛
           • نشان بیلد (تاریخ ساخت EXE ایستگاه — چرخهٔ ۶۷): اگر پس از نصب بستهٔ
             آپدیت تازه نشده باشد، «آپدیت اعمال نشده» با یک نگاه مشخص است؛
           • کارت «اطلاعات درمانگاه»: نام درمانگاه از سرور لایسنس (همگام‌شده در
             تنظیمات ClinicInfo)، شماره لایسنس و وضعیت اعتبار؛
           • کارت «پشتیبانی» کاملاً پویا (license/support): نام/شرکت/تلفن/موبایل/
             ایمیل/وب‌سایت — هر مقدار فقط وقتی پنل لایسنس مقدار داده نمایش
             می‌یابد؛ تلفن/موبایل/ایمیل/وب‌سایت کلیک‌پذیرند (tel:/mailto:/سایت)؛
           • پانویس فناوری: نسخهٔ چارچوب، سلامت اتصال و دکمهٔ «کپی اطلاعات». -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ سربرگ گرادیانی — هویت بصری محصول ═══ -->
        <Border Grid.Row="0" CornerRadius="0,0,18,18" Padding="28,24,28,20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0D47A1" Offset="0" />
                    <GradientStop Color="#1565C0" Offset="0.55" />
                    <GradientStop Color="#1E88E5" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <!-- نشان برنامه — دایرهٔ سفید با قلب پزشکی -->
                    <Border Width="56" Height="56" CornerRadius="16"
                            Background="#FFFFFF" Opacity="0.95"
                            VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="HeartPulse"
                                                 Width="32" Height="32"
                                                 Foreground="#1565C0"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="سامانه جامع مدیریت درمانگاه سهند"
                                   FontSize="19" FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock Text="ClinicPro — نرم‌افزار یکپارچهٔ پذیرش، پروندهٔ الکترونیک، آزمایشگاه، داروخانه و حسابداری"
                                   FontSize="11.5" Foreground="#DDE9FA"
                                   Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <!-- نشان نسخه + بیلد — بیلدِ تازه نشده = آپدیت اعمال نشده (چرخهٔ ۶۷) -->
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Border Background="#33FFFFFF" CornerRadius="9" Padding="10,4">
                        <TextBlock Text="{x:Static helpers:AppInfo.VersionText}"
                                   Foreground="White" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <Border Background="#26FFFFFF" CornerRadius="9" Padding="10,4" Margin="8,0,0,0">
                        <TextBlock Foreground="#EAF2FC" FontSize="11">
                            <Run Text="بیلد: " />
                            <Run Text="{x:Static helpers:AppInfo.BuildStamp}" />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ بدنه — کارت درمانگاه + کارت پشتیبانی ═══ -->
        <StackPanel Grid.Row="1" Margin="24,18,24,4">

            <!-- کارت اطلاعات درمانگاه — نام از سرور لایسنس -->
            <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                    BorderThickness="1" CornerRadius="12" Padding="16,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="HospitalBuilding"
                                                 Width="17" Height="17"
                                                 Foreground="#1565C0"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="اطلاعات درمانگاه"
                                   FontSize="13" FontWeight="Bold"
                                   Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="نام درمانگاه (از سرور لایسنس)" FontSize="10.5" Opacity="0.62" />
                            <TextBlock x:Name="ClinicNameText" Text="در حال دریافت…"
                                       FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="شماره لایسنس" FontSize="10.5" Opacity="0.62" />
                            <TextBlock x:Name="LicenseKeyText" Text="—"
                                       FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="وضعیت لایسنس" FontSize="10.5" Opacity="0.62" />
                            <TextBlock x:Name="LicenseStatusText" Text="در حال بررسی…"
                                       FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="تاریخ انقضای لایسنس" FontSize="10.5" Opacity="0.62" />
                            <TextBlock x:Name="LicenseExpiryText" Text="—"
                                       FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- کارت پشتیبانی — کاملاً پویا از سرور لایسنس (license/support) -->
            <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                    BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,12,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FaceAgent"
                                                 Width="17" Height="17"
                                                 Foreground="#059669"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="پشتیبانی"
                                   FontSize="13" FontWeight="Bold"
                                   Margin="7,0,0,0" VerticalAlignment="Center" />
                        <!-- منبع اطلاعات: ذخیره‌شده | پنل | پیش‌فرض -->
                        <Border x:Name="SupportSourceBadge" Background="#E8F1FD" CornerRadius="8"
                                Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <TextBlock x:Name="SupportSourceText" FontSize="10"
                                       Foreground="#1565C0" />
                        </Border>
                    </StackPanel>

                    <!-- ردیف‌های تماس — هر مقدار فقط وقتی هست دیده می‌شود -->
                    <StackPanel x:Name="SupportRows" Margin="0,10,0,0" />

                    <!-- هیچ اطلاعاتی از پنل نیامده — پیام روشن به‌جای جدول خالی -->
                    <TextBlock x:Name="SupportEmptyText"
                               Text="اطلاعات پشتیبانی هنوز از سرور لایسنس دریافت نشده — با اولین اتصال به پنل به‌روزرسانی می‌شود"
                               FontSize="11.5" Opacity="0.7" TextWrapping="Wrap"
                               Margin="0,8,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ═══ پانویس — فناوری + دکمه‌ها ═══ -->
        <Border Grid.Row="2" Padding="24,10,24,16">
            <StackPanel>
                <TextBlock x:Name="TechInfoText"
                           FontSize="10.5" Opacity="0.6" TextWrapping="Wrap"
                           Text="ساخته‌شده با چارچوب .NET 8 و فناوری WPF · پایگاه‌دادهٔ SQL Server" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CopyInfoButton"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Content="کپی اطلاعات برای پشتیبانی"
                            Click="OnCopyInfoClick"
                            HorizontalAlignment="Left"
                            FontSize="12" />
                    <Button Grid.Column="1"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Content="بستن"
                            Click="OnCloseClick"
                            FontSize="12" MinWidth="90" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
