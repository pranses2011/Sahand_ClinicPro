<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FlowDirection="RightToLeft">
    <!-- ═══════════════════════════════════════════════════════════
         گزارش‌ها — بازطراحی کامل چرخهٔ ۷۰ (گزارش مالک):
         «تمامی صفحات را با چیدمان زیبا و حرفه‌ای دوباره طراحی بکن» +
         «برای همه چیز صفر می‌نویسند و کارت نمودار را خالی نشان می‌دهند».
         ساختار: سربرگ با چیپ‌های بازه ← بنر شکست با علت فارسی (ماژول
         لایسنس/شبکه) ← کارت‌های آماری آیکون‌دار («—» در شکست، نه ۰) ←
         تب‌بندی گزارش درآمد/عملکرد با نمودار ستونی و جدول.
         ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ سربرگ — عنوان + چیپ‌های بازه + تلاش دوباره ═══ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Border Width="42" Height="42" CornerRadius="12" Background="#E3F2FD"
                        VerticalAlignment="Center" Margin="0,0,10,0">
                    <materialDesign:PackIcon Kind="ChartAreasplineVariant" Width="22" Height="22"
                                             Foreground="#1565C0"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="گزارش‌های مالی و عملکردی" FontSize="19" FontWeight="Bold" />
                    <TextBlock Text="درآمد، وصولی و عملکرد پزشکان در بازهٔ انتخابی" FontSize="11.5" Opacity="0.65" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <!-- چیپ‌های بازه — سگمنت با سه گزینه
                     (چرخهٔ ۷۳: کلید MaterialDesignFlatRadioButton در پکیج MaterialDesignThemes 5.3.2
                      وجود ندارد — صفحهٔ گزارش‌ها هنگام باز شدن با XamlParseException می‌افتاد؛
                      کلید صحیح مطابق مانیفست scripts/materialdesign-keys-5.3.2.txt) -->
                <Border CornerRadius="22" Background="#F1F5F9" Padding="4" Margin="0,0,10,0">
                    <UniformGrid Columns="3">
                        <RadioButton Content="۷ روز" GroupName="range" IsChecked="{Binding IsWeekRange, Mode=TwoWay}"
                                     Style="{StaticResource MaterialDesignRadioButton}" FontSize="12" />
                        <RadioButton Content="۳۰ روز" GroupName="range" IsChecked="{Binding IsMonthRange, Mode=TwoWay}"
                                     Style="{StaticResource MaterialDesignRadioButton}" FontSize="12" />
                        <RadioButton Content="۹۰ روز" GroupName="range" IsChecked="{Binding IsQuarterRange, Mode=TwoWay}"
                                     Style="{StaticResource MaterialDesignRadioButton}" FontSize="12" />
                    </UniformGrid>
                </Border>
                <Button Command="{Binding LoadCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                        ToolTip="بارگذاری مجدد — پس از رفع مشکل، بدون بازکردن صفحه دوباره">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="تلاش دوباره" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- ═══ بنر شکست بارگذاری — چرخهٔ ۷0 ═══
             ریشهٔ «همه‌چیز صفر»: شکست (معمولاً ماژول Reports در لایسنس فعال
             نیست → ۴۰۳) پیش‌تر بی‌صدا بود و کارت‌ها ۰ می‌زدند. اکنون علتِ
             فارسیِ همان پاسخ سرور، بالا می‌آید و می‌ماند. -->
        <Border Grid.Row="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12"
                Background="#FDECEA" BorderBrush="#F5C6C0" BorderThickness="1"
                Visibility="{Binding LoadFailed, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <materialDesign:PackIcon DockPanel.Dock="Right" Kind="LockAlert" Width="22" Height="22"
                                         Foreground="#C62828" VerticalAlignment="Top" Margin="0,1,0,0" />
                <StackPanel>
                    <TextBlock Text="گزارش‌ها در دسترس نیست" FontSize="13" FontWeight="Bold" Foreground="#C62828" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#8E2A20" TextWrapping="Wrap"
                               LineHeight="21" />
                    <TextBlock FontSize="11" Foreground="#8E2A20" Opacity="0.85" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="اگر پیام «ماژول Reports در لایسنس فعال نیست» را می‌بینید، از پنل لایسنس (پشتیبانی) فعال‌سازی ماژول گزارش‌ها را درخواست کنید. در حالت شبکهٔ قطع، اتصال سرور را بررسی و «تلاش دوباره» را بزنید." />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ کارت‌های آماری — آیکون‌دار با رنگ تأکیدی؛ «—» در شکست ═══ -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,14">
            <Border CornerRadius="12" Padding="14,10" Margin="0,0,8,0" Background="#FFFFFF"
                    BorderBrush="#DCE7F0" BorderThickness="1.2">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Width="34" Height="34" CornerRadius="10" Background="#E8F5E9"
                            VerticalAlignment="Top" Margin="0,0,0,0">
                        <materialDesign:PackIcon Kind="CashMultiple" Width="19" Height="19" Foreground="#2E7D32"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock FontSize="11" Opacity="0.7"><Run Text="جمع درآمد (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock>
                        <TextBlock Text="{Binding TotalRevenueDisplay}" FontSize="17" FontWeight="Bold" Foreground="#1B5E20"
                                   FontFamily="{DynamicResource App.CodeFont}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border CornerRadius="12" Padding="14,10" Margin="0,0,8,0" Background="#FFFFFF"
                    BorderBrush="#DCE7F0" BorderThickness="1.2">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Width="34" Height="34" CornerRadius="10" Background="#E3F2FD" VerticalAlignment="Top">
                        <materialDesign:PackIcon Kind="CreditCardCheckOutline" Width="19" Height="19" Foreground="#1565C0"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock FontSize="11" Opacity="0.7"><Run Text="وصول‌شده (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock>
                        <TextBlock Text="{Binding TotalPaidDisplay}" FontSize="17" FontWeight="Bold" Foreground="#0D47A1"
                                   FontFamily="{DynamicResource App.CodeFont}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border CornerRadius="12" Padding="14,10" Margin="0,0,8,0" Background="#FFFFFF"
                    BorderBrush="#DCE7F0" BorderThickness="1.2">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Width="34" Height="34" CornerRadius="10" Background="#FFF3E0" VerticalAlignment="Top">
                        <materialDesign:PackIcon Kind="ReceiptTextClockOutline" Width="19" Height="19" Foreground="#E65100"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock FontSize="11" Opacity="0.7"><Run Text="مانده (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock>
                        <TextBlock Text="{Binding TotalRemainingDisplay}" FontSize="17" FontWeight="Bold" Foreground="#B71C1C"
                                   FontFamily="{DynamicResource App.CodeFont}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border CornerRadius="12" Padding="14,10" Background="#FFFFFF"
                    BorderBrush="#DCE7F0" BorderThickness="1.2">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Width="34" Height="34" CornerRadius="10" Background="#F3E5F5" VerticalAlignment="Top">
                        <materialDesign:PackIcon Kind="Stethoscope" Width="19" Height="19" Foreground="#7B1FA2"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="جمع ویزیت‌ها" FontSize="11" Opacity="0.7" />
                        <TextBlock Text="{Binding TotalVisitsDisplay}" FontSize="17" FontWeight="Bold" Foreground="#4A148C"
                                   FontFamily="{DynamicResource App.CodeFont}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>

        <!-- ═══ تب‌ها: درآمد روزانه + عملکرد پزشکان ═══ -->
        <TabControl Grid.Row="4" materialDesign:ColorZoneAssist.Mode="PrimaryLight">
            <TabItem Header="📈 درآمد روزانه">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="210" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- نمودار ستونی — با ته‌رنگ گرم و مقدار روی هر ستون -->
                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Hidden">
                        <ItemsControl ItemsSource="{Binding Revenue}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="38" Margin="2,0" VerticalAlignment="Bottom"
                                                ToolTip="{Binding Date, StringFormat=درآمد {0}}">
                                        <TextBlock Text="{Binding Total, Mode=OneWay, Converter={StaticResource CurrencyRial}}"
                                                   FontSize="8.5" HorizontalAlignment="Center"
                                                   Foreground="#37474F" TextTrimming="CharacterEllipsis" />
                                        <Border Height="{Binding BarHeight}"
                                                CornerRadius="4,4,0,0" VerticalAlignment="Bottom" Margin="0,3">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#42A5F5" Offset="0" />
                                                    <GradientStop Color="#1565C0" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="{Binding Date}" FontSize="8" Opacity="0.7"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- جدول درآمد -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Revenue}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" FontSize="12" AlternatingRowBackground="#F7FAFD"
                              GridLinesVisibility="Horizontal"
                              materialDesign:DataGridAssist.CellPadding="8,6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="تاریخ" Binding="{Binding Date, Converter={StaticResource PersianDigits}}" Width="120" />
                            <DataGridTextColumn Binding="{Binding Total, Mode=OneWay, Converter={StaticResource CurrencyRial}}" Width="*">
                                <DataGridTextColumn.Header><TextBlock><Run Text="درآمد (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Paid, Mode=OneWay, Converter={StaticResource CurrencyRial}}" Width="*">
                                <DataGridTextColumn.Header><TextBlock><Run Text="وصولی (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Remaining, Mode=OneWay, Converter={StaticResource CurrencyRial}}" Width="*">
                                <DataGridTextColumn.Header><TextBlock><Run Text="مانده (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="👨‍⚕️ عملکرد پزشکان">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="210" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- نمودار ستونی عملکرد -->
                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Hidden">
                        <ItemsControl ItemsSource="{Binding Performance}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="76" Margin="3,0" VerticalAlignment="Bottom"
                                                ToolTip="{Binding DoctorName}">
                                        <TextBlock Text="{Binding DoctorName}" FontSize="9" HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Foreground="#37474F" />
                                        <Border Height="{Binding BarHeight}"
                                                CornerRadius="4,4,0,0" VerticalAlignment="Bottom" Margin="0,3">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#26A69A" Offset="0" />
                                                    <GradientStop Color="#00695C" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="{Binding VisitsCount, Converter={StaticResource PersianDigits}}"
                                                   FontSize="9" Opacity="0.75" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- جدول عملکرد -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Performance}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" FontSize="12" AlternatingRowBackground="#F7FAFD"
                              GridLinesVisibility="Horizontal"
                              materialDesign:DataGridAssist.CellPadding="8,6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="پزشک" Binding="{Binding DoctorName, Converter={StaticResource PersianDigits}}" Width="2*" />
                            <DataGridTextColumn Header="تعداد ویزیت" Binding="{Binding VisitsCount, Converter={StaticResource PersianDigits}}" Width="110" />
                            <DataGridTextColumn Binding="{Binding TotalRevenue, Mode=OneWay, Converter={StaticResource CurrencyRial}}" Width="*">
                                <DataGridTextColumn.Header><TextBlock><Run Text="درآمد (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding DoctorShare, Mode=OneWay, Converter={StaticResource CurrencyRial}}" Width="*">
                                <DataGridTextColumn.Header><TextBlock><Run Text="سهم پزشک (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
