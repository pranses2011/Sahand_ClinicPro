<UserControl x:Class="Sahand.ClinicPro.Desktop.Views.PrintSettingsDesignView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="774" d:DesignWidth="1030"
             FlowDirection="RightToLeft">
    <!-- مرکز چاپ و تنظیمات چاپگر — بازطراحی بر اساس print-settings.html.
         لایهٔ «نمای تأییدشده» داخل SettingsView؛ بخشهای دیگر تنظیمات در
         لایهٔ دوم (نمای کامل) دستنخورده باقی میمانند. -->
    <UserControl.Resources>
        <DataTemplate x:Key="Ds.BoolChip">
            <Border x:Name="Chip" Style="{StaticResource Ds.Tag}" Background="#E8F5E9" BorderBrush="#A5D6A7">
                <TextBlock x:Name="Txt" Text="فعال" FontSize="9.5" Foreground="#2E7D32" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="False">
                    <Setter TargetName="Chip" Property="Background" Value="#F1F5F9" />
                    <Setter TargetName="Chip" Property="BorderBrush" Value="#D9E2EC" />
                    <Setter TargetName="Txt" Property="Text" Value="غیرفعال" />
                    <Setter TargetName="Txt" Property="Foreground" Value="#6B7C93" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="Ds.PrinterRow">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Ds.Tag}" Background="#E8F5E9" BorderBrush="#A5D6A7">
                    <TextBlock Text="آماده" FontSize="9.5" Foreground="#2E7D32" /></Border>
                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource Ds.PageBackground}" Margin="14,11,14,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- سربرگ -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="#1565C0" Margin="0,0,9,0">
                <TextBlock Text="⚙" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="تنظیمات چاپگر و چاپ" Style="{StaticResource Ds.PageTitle}" />
                <TextBlock Text="چاپگر اختصاصی هر سند، پیشنمایش و چاپ خودکار" Style="{StaticResource Ds.Muted}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="ذخیرهٔ تنظیمات" Style="{StaticResource Ds.FlatPrimary}" Height="32" Padding="14,0" Margin="0,0,7,0" />
                <Button Content="تست چاپ" Style="{StaticResource Ds.OutlineButton}" Height="32" Padding="13,0" />
            </StackPanel>
        </Grid>

        <!-- پنج کارت آماری -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource Ds.StatCard}" Background="#F4FBF4" BorderBrush="#81C784">
                <StackPanel><TextBlock Text="{Binding Kpis.V1}" Style="{StaticResource Ds.StatNumber}" Foreground="#2E7D32" />
                    <TextBlock Text="اسناد قابل چاپ" Style="{StaticResource Ds.StatLabel}" /></StackPanel></Button>
            <Button Grid.Column="2" Style="{StaticResource Ds.StatCard}" Background="#F5FAFF" BorderBrush="#64B5F6">
                <StackPanel><TextBlock Text="{Binding Kpis.V2}" Style="{StaticResource Ds.StatNumber}" Foreground="#1565C0" />
                    <TextBlock Text="چاپگرهای نصبشده" Style="{StaticResource Ds.StatLabel}" /></StackPanel></Button>
            <Button Grid.Column="4" Style="{StaticResource Ds.StatCard}" Background="#FDF7FF" BorderBrush="#BA68C8">
                <StackPanel><TextBlock Text="{Binding Kpis.V3}" Style="{StaticResource Ds.StatNumber}" Foreground="#6A1B9A" />
                    <TextBlock Text="چاپ خودکار" Style="{StaticResource Ds.StatLabel}" /></StackPanel></Button>
            <Button Grid.Column="6" Style="{StaticResource Ds.StatCard}" Background="#FFFAF3" BorderBrush="#FFB74D">
                <StackPanel><TextBlock Text="{Binding Kpis.V4}" Style="{StaticResource Ds.StatNumber}" Foreground="#E65100" />
                    <TextBlock Text="پیشنمایش فعال" Style="{StaticResource Ds.StatLabel}" /></StackPanel></Button>
            <Button Grid.Column="8" Style="{StaticResource Ds.StatCard}" Background="#F0FBFA" BorderBrush="#4DB6AC">
                <StackPanel><TextBlock Text="{Binding Kpis.V5}" Style="{StaticResource Ds.StatNumber}" Foreground="#0D9488" />
                    <TextBlock Text="چاپ امروز" Style="{StaticResource Ds.StatLabel}" /></StackPanel></Button>
        </Grid>

        <!-- تبها -->
        <Border Grid.Row="2" Style="{StaticResource Ds.TabBar}" Padding="0,2,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border BorderBrush="#1565C0" BorderThickness="0,0,0,2" Margin="0,0,4,0">
                    <TextBlock Text="مرکز چاپ" Style="{StaticResource Ds.TabItemActiveText}" /></Border>
                <TextBlock Text="رفتار عمومی چاپ" Style="{StaticResource Ds.TabItemText}" />
                <TextBlock Text="چاپگرها" Style="{StaticResource Ds.TabItemText}" />
                <TextBlock Text="پوسته و ظاهر" Style="{StaticResource Ds.TabItemText}" />
            </StackPanel>
        </Border>

        <!-- نوار ابزار -->
        <Border Grid.Row="3" Style="{StaticResource Ds.Toolbar}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="270" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource Ds.CompactText}" />
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button Content="همهٔ اسناد" Style="{StaticResource Ds.ChipActive}" />
                    <Button Content="چاپ خودکار" Style="{StaticResource Ds.Chip}" />
                    <Button Content="بدون پیشنمایش" Style="{StaticResource Ds.Chip}" />
                </WrapPanel>
                <Button Grid.Column="2" Content="تازهمسازی" Style="{StaticResource Ds.OutlineButton}" Padding="11,0" />
            </Grid>
        </Border>

        <!-- بدنه: جدول اسناد + تنظیمات عمومی -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.75*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Ds.Panel}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="مرکز چاپ — چاپگر اختصاصی هر سند 🖨️" Style="{StaticResource Ds.PanelTitle}" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding PrintJobs}" Style="{StaticResource Ds.TableDataGrid}"
                              ColumnHeaderStyle="{StaticResource Ds.TableColumnHeader}" RowHeight="29" MaxHeight="330">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="سند" Binding="{Binding Title}" Width="1.1*"
                                                ElementStyle="{StaticResource Ds.TableCellText}" />
                            <DataGridTextColumn Header="توضیح" Binding="{Binding Description}" Width="1.3*"
                                                ElementStyle="{StaticResource Ds.TableCellText}" />
                            <DataGridTextColumn Header="چاپگر" Binding="{Binding Printer, TargetNullValue='پیشفرض ویندوز'}" Width="1.1*"
                                                ElementStyle="{StaticResource Ds.TableCellText}" />
                            <DataGridTextColumn Header="کاغذ" Binding="{Binding Paper}" Width="46"
                                                ElementStyle="{StaticResource Ds.TableCellText}" />
                            <DataGridTextColumn Header="نسخه" Binding="{Binding Copies}" Width="42"
                                                ElementStyle="{StaticResource Ds.TableCellText}" />
                            <DataGridTemplateColumn Header="پیشنمایش" Width="64">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><ContentControl Content="{Binding Preview}" ContentTemplate="{StaticResource Ds.BoolChip}" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="خودکار" Width="58">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><ContentControl Content="{Binding AutoPrint}" ContentTemplate="{StaticResource Ds.BoolChip}" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="چاپ خاموش = پیشنمایش ویندوز · ۱۲ سند در جدول چاپگر"
                               Style="{StaticResource Ds.Muted}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Ds.Panel}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="رفتار عمومی چاپ (همهٔ سندها) 🎛️" Style="{StaticResource Ds.PanelTitle}" />
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Ds.Tag}" Background="#E8F5E9" BorderBrush="#A5D6A7"><TextBlock Text="فعال" Style="{StaticResource Ds.TagText}" /></Border>
                            <TextBlock Grid.Column="1" Text="نمایش پیشنمایش قبل از ثبت فاکتور" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Ds.Tag}" Background="#F1F5F9" BorderBrush="#D9E2EC"><TextBlock Text="غیرفعال" FontSize="9.5" Foreground="#6B7C93" /></Border>
                            <TextBlock Grid.Column="1" Text="چاپ خودکار قبض نوبت" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Ds.Tag}" Background="#E8F5E9" BorderBrush="#A5D6A7"><TextBlock Text="فعال" Style="{StaticResource Ds.TagText}" /></Border>
                            <TextBlock Grid.Column="1" Text="چاپ خودکار فیش حقوق" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Ds.Tag}" Background="#E8F5E9" BorderBrush="#A5D6A7"><TextBlock Text="فعال" Style="{StaticResource Ds.TagText}" /></Border>
                            <TextBlock Grid.Column="1" Text="چاپ خودکار نسخهٔ پزشک" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                        <TextBlock Text="چاپگر پیشفرض ویندوز" Style="{StaticResource Ds.FieldLabel}" />
                        <Border Style="{StaticResource Ds.FieldValue}"><TextBlock Text="HP LaserJet P1102" FontSize="10" HorizontalAlignment="Center" /></Border>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <Button Content="ذخیره" Style="{StaticResource Ds.OutlineButton}" Padding="13,0" Margin="0,0,6,0" />
                            <Button Content="تست چاپ" Style="{StaticResource Ds.FlatPrimary}" Height="30" Padding="13,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Ds.Panel}">
                    <StackPanel>
                        <TextBlock Text="چاپگرهای نصبشده 🖨️" Style="{StaticResource Ds.PanelTitle}" />
                        <ItemsControl ItemsSource="{Binding PrinterNames}" ItemTemplate="{StaticResource Ds.PrinterRow}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="5" Text="سهند کلینیکپرو — تنظیمات چاپگر و چاپ · مرکز چاپ · نسخهٔ ۲٫۲۸٫۲۸"
                   Style="{StaticResource Ds.Muted}" HorizontalAlignment="Center" Margin="0,5,0,0" />
    </Grid>
</UserControl>
