<Window x:Class="Sahand.ClinicPro.Desktop.Views.StockInFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:behaviors="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        xmlns:controls="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
        Title="ورود موجودی"
        Height="640" Width="540"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!-- ═══════════════════════════════════════════════════════════
         فرم ورود موجودی — گام V6؛ بازطراحی چرخهٔ ۴۳ (گزارش مالک):
         «در… ورود کالا نباید نوع قلم وجود داشته باشه» — کمبوی نوع حذف شد؛
         جستجو از بافت فرم (مصرفی/دارو) قفل است؛ عنوان و راهنما بافت‌دارند.
         ═══════════════════════════════════════════════════════════ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding FormHint}" FontSize="11.5" Opacity="0.7"
                       Margin="0,0,0,14" TextWrapping="Wrap" />

            <!-- جستجوی قلم -->
            <TextBox materialDesign:HintAssist.Hint="جستجوی قلم: نام ژنریک یا برند *"
                     Text="{Binding MedicationSearchTerm, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,8">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchMedicationCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <ListBox ItemsSource="{Binding MedicationResults}"
                     SelectedItem="{Binding SelectedMedication}"
                     Height="120" Margin="0,0,0,12"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     materialDesign:HintAssist.Hint="نتایج جستجو">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                            <TextBlock FontSize="11" Opacity="0.75">
                                <Run Text="{Binding Form, Mode=OneWay}" />
                                <Run Text=" — " />
                                <Run Text="{Binding Strength, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBox materialDesign:HintAssist.Hint="شماره بچ"
                     Text="{Binding BatchNumber, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12" />
            <TextBox materialDesign:HintAssist.Hint="تعداد *"
                     Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12" />
            <UniformGrid Columns="2" Margin="0,0,0,12">
                <!-- جداکنندهٔ زندهٔ ۳ رقمی هنگام تایپ (چرخه بیست‌ویکم) -->
                <TextBox behaviors:MoneyInput.IsEnabled="True" behaviors:MoneyInput.NumericValue="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MoneyRial}}" Margin="0,0,6,0"><materialDesign:HintAssist.Hint><TextBlock><Run Text="قیمت خرید (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock></materialDesign:HintAssist.Hint></TextBox>
                <TextBox behaviors:MoneyInput.IsEnabled="True" behaviors:MoneyInput.NumericValue="{Binding SellPrice, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MoneyRial}}" Margin="6,0,0,0"><materialDesign:HintAssist.Hint><TextBlock><Run Text="قیمت فروش (" /><Run Text="{DynamicResource App.CurrencyLabel}" /><Run Text=")" /></TextBlock></materialDesign:HintAssist.Hint></TextBox>
            </UniformGrid>
            <!-- تاریخ انقضا — فیلد تاریخ از انتخابگر تاریخ شمسی (چرخه ۲۳) -->
            <controls:PersianDatePicker DateShamsiText="{Binding ExpiryDateShamsi, Mode=TwoWay}"
                                        Placeholder="تاریخ انقضا شمسی *"
                                        HorizontalAlignment="Left" MinWidth="180"
                                        Margin="0,0,0,16" />

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />

            <UniformGrid Columns="2">
                <Button Command="{Binding SaveCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Content="ثبت موجودی" Height="42" Margin="4" />
                <Button Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Content="انصراف" Height="42" Margin="4" />
            </UniformGrid>

            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </ScrollViewer>
</Window>
