<UserControl x:Class="Sahand.ClinicPro.Desktop.Controls.PersianDatePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Sahand.ClinicPro.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="40" d:DesignWidth="200"
             FlowDirection="RightToLeft"

             x:Name="Root">
    <!-- ═══ انتخابگر تاریخ شمسی — چرخهٔ ۷۲: ورودِ دوگانه (تایپ دستی + تقویم بازشو) ═══
         گزارش مالک: «کنترل انتخابگر تاریخ رو طوری اصلاح بکن که بصورت دستی هم بشه
         نوشت و نیازی به باز شدن تقویم نباشه و کنترل یک آیکون تقویم داشته باشه که
         با کلیک روی اون تقویم انتخاب تاریخ رو باز بکنه».
         پیش‌تر جعبهٔ متن فقط-خواندنی بود و کلیک روی خود فیلد هم تقویم را باز
         می‌کرد؛ از این چرخه:
           ۱) جعبهٔ متن قابل تایپ است — قالب‌های پذیرفته‌شده: «۱۴۰۴/۰۷/۲۰»،
              «1404/07/20»، «1404-07-20» و ارقام فارسی/عربی (پارس با
              PersianDateHelper.ToGregorian)؛ اعمال با Enter یا خروج از فیلد.
           ۲) تقویم فقط از آیکون تقویم (سمت چپ) باز می‌شود — نه با کلیک روی فیلد.
           ۳) متن نامعتبر: قاب نارنجی + راهنمای تولتیپ؛ تاریخ انتخابی قبلی
              دست‌نخورده می‌ماند تا اصلاح شود. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- نمایش/ورود شمسی تاریخ — مرکزچین تا تاریخ کامل خوانده شود
             ═══ چرخهٔ ۷۴ ═══ اتصالِ متن حذف شد و همگام‌سازی از کد پشت انجام
             می‌شود (SyncShamsiBox). ریشه: اتصال یک‌طرفهٔ OneWay روی جعبهٔ متنِ
             قابل‌ویرایش، با اولین کاراکتر تایپیِ کاربر «کشته» می‌شود (رفتار
             شناخته‌شدهٔ WPF — مقدار محلی جای اتصال را می‌گیرد) و پس از آن
             انتخاب تاریخ از تقویم هرگز در فیلد منعکس نمی‌شد؛ متنِ نامعتبرِ
             تایپی‌شده هم تا ابد می‌ماند و به نظر می‌رسید «تاریخ غلط پذیرفته
             شده». مسیر کدی در برابر تایپ کاربر مصون است. -->
        <TextBox x:Name="ShamsiBox"
                 Grid.Column="0"
                 Cursor="IBeam"
                 TextAlignment="Center"
                 materialDesign:HintAssist.Hint="{Binding Placeholder, ElementName=Root}"
                 materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                 VerticalContentAlignment="Center"
                 IsReadOnly="False" />

        <!-- دکمه باز کردن تقویم — یگانه راه گشودن تقویم از این چرخه
             Focusable=False تا پیمایش Tab فرم‌ها روی دکمه نایستد -->
        <ToggleButton x:Name="CalendarToggle"
                      Grid.Column="1"
                      Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                      ToolTip="انتخاب از تقویم شمسی" Width="36" Height="32"
                      Focusable="False">
            <materialDesign:PackIcon Kind="CalendarMonth" />
        </ToggleButton>

        <!-- پنجره بازشوی تقویم — چرخهٔ سی‌وسوم: PopupAnimation=Fade حذف شد
             (قانون هم‌کلاسی‌ها با انتخابگر ساعت): ترکیب انیمیشن محو با
             StaysOpen=False در برخی ویندوزها رویداد Closed را به‌تعویق
             می‌اندازد و پاپ‌آپ در حالت باز گیر می‌کند -->
        <Popup x:Name="CalendarPopup"
               PlacementTarget="{Binding ElementName=ShamsiBox}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="{DynamicResource MaterialDesign.Brush.Background}"
                    CornerRadius="10" Padding="6" Margin="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
                </Border.Effect>
                <controls:PersianCalendarControl x:Name="PopupCalendar"
                                                 Width="300"
                                                 SelectedDate="{Binding SelectedDate, ElementName=Root, Mode=TwoWay}" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
