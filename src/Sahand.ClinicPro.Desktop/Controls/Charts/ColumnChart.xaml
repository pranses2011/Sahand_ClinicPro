<UserControl x:Class="Sahand.ClinicPro.Desktop.Controls.Charts.ColumnChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="LeftToRight"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <!-- نمودار ستونی — مناسب ماهیت «مقایسه بین مقوله‌های مجزا» (ساعت روز، ماه‌ها، رده سنی) -->
    <Border Background="Transparent" ClipToBounds="True">
        <Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Canvas x:Name="PlotCanvas" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}" />
            </ScrollViewer>
            <TextBlock x:Name="EmptyHint" Text="داده‌ای برای نمایش نیست"
                       FontSize="11" Opacity="0.35" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
