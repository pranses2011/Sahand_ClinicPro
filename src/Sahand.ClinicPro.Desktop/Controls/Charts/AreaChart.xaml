<UserControl x:Class="Sahand.ClinicPro.Desktop.Controls.Charts.AreaChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="LeftToRight"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <!-- نمودار سطحی/خطی — مناسب ماهیت «روند در طول زمان» (درآمد روزانه/ماهانه و ...) -->
    <Border Background="Transparent"
            ClipToBounds="True">
        <Grid>
            <Canvas x:Name="PlotCanvas" />
            <TextBlock x:Name="EmptyHint" Text="داده‌ای برای نمایش نیست"
                       FontSize="11" Opacity="0.35" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
