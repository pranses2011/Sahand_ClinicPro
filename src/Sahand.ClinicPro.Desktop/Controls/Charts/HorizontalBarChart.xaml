<UserControl x:Class="Sahand.ClinicPro.Desktop.Controls.Charts.HorizontalBarChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <!-- نمودار میله‌ای افقی — مناسب ماهیت «رتبه‌بندی/مقایسه با نام بلند» (لیست برترین‌ها) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ردیف‌ها: برچسب راست (RTL) + میله رو به چپ + مقدار -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="RowsHost">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" MinWidth="72" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />

                            <!-- بستر کم‌رنگ + میله رنگی با عرض نسبی -->
                            <Grid Grid.Column="1" Height="15" Background="#11000000" >
                                <Border HorizontalAlignment="Right" Width="{Binding BarWidth}"
                                        Background="{Binding Brush}" CornerRadius="4,0,0,4" />
                            </Grid>

                            <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="10.5"
                                       FontFamily="Consolas" Opacity="0.8" VerticalAlignment="Center"
                                       Margin="10,0,0,0" HorizontalAlignment="Left" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="داده‌ای برای نمایش نیست" FontSize="11" Opacity="0.35"
                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,2" Visibility="Collapsed" />
    </Grid>
</UserControl>
