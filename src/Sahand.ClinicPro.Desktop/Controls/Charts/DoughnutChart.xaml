<UserControl x:Class="Sahand.ClinicPro.Desktop.Controls.Charts.DoughnutChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <!-- نمودار دونات — مناسب ماهیت «سهم از کل» (سهم پزشکان از درآمد، ترکیب خدمات، روش پرداخت) -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- حلقه مرکزی (LTR تا جهت چرخش هندسه استاندارد بماند) -->
        <Grid Grid.Column="0" Width="{Binding RingSize}" Height="{Binding RingSize, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
              FlowDirection="LeftToRight" VerticalAlignment="Center">
            <Canvas x:Name="RingCanvas" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="CenterValue" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                <TextBlock x:Name="CenterLabel" FontSize="9.5" Opacity="0.6" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- راهنما (legend) — در چیدمان RTL سمت چپ حلقه می‌نشیند -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="10,2,2,2">
            <StackPanel x:Name="LegendPanel" />
        </ScrollViewer>

        <TextBlock x:Name="EmptyHint" Grid.ColumnSpan="2" Text="داده‌ای برای نمایش نیست"
                   FontSize="11" Opacity="0.35" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
