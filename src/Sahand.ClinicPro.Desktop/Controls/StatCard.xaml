<UserControl x:Class="Sahand.ClinicPro.Desktop.Controls.StatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="110" d:DesignWidth="220"
             FlowDirection="RightToLeft"
             FontFamily="pack://application:,,,/Assets/Fonts/#Vazirmatn"
             x:Name="Root">
    <!-- کارت آماری — مشخصات پرامپت UI بخش ۱ (داشبورد):
         نوار رنگی + آیکون + عدد درشت + عنوان + متن مقایسه با دیروز -->
    <Border Background="{DynamicResource MaterialDesign.Brush.Background}"
            BorderBrush="{Binding AccentBrush, ElementName=Root}"
            BorderThickness="0,0,0,4"
            CornerRadius="10" Padding="14,12" Margin="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.12" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <!-- عدد اصلی -->
                <TextBlock Text="{Binding Value, ElementName=Root}"
                           FontSize="26" FontWeight="Black"
                           Foreground="{Binding AccentBrush, ElementName=Root}" />
                <!-- عنوان -->
                <TextBlock Text="{Binding Label, ElementName=Root}"
                           FontSize="12" Opacity="0.75" Margin="0,2,0,0" />
                <!-- مقایسه -->
                <TextBlock Text="{Binding CompareText, ElementName=Root}"
                           FontSize="10" Opacity="0.6" Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- آیکون دایره‌ای -->
            <Border Grid.Column="1"
                    Width="44" Height="44"
                    CornerRadius="22"
                    Background="{Binding AccentBrush, ElementName=Root}"
                    Opacity="0.9"
                    VerticalAlignment="Top">
                <materialDesign:PackIcon Kind="{Binding IconKind, ElementName=Root}"
                                         Width="22" Height="22"
                                         Foreground="White"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</UserControl>
