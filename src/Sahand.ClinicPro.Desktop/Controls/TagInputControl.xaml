<UserControl x:Class="Sahand.ClinicPro.Desktop.Controls.TagInputControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="90" d:DesignWidth="320"
             FlowDirection="RightToLeft"

             x:Name="Root">
    <!-- ورودی تگی — مشخصات پرامپت UI بخش ۱ (تب سوابق پزشکی بیمار):
         تایپ + Enter → افزودن تگ | × روی تگ → حذف | رنگ قابل تنظیم برای آلرژی/مزمن/دارو -->
    <StackPanel>
        <TextBlock Text="{Binding Title, ElementName=Root}"
                   FontSize="11" Opacity="0.7" Margin="2,0,0,4" />

        <!-- تگ‌های موجود -->
        <ItemsControl ItemsSource="{Binding Tags, ElementName=Root}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding TagBackground, ElementName=Root}"
                            CornerRadius="12" Padding="10,3" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding}" FontSize="12" Foreground="White" />
                            <Button Content="✕" FontSize="10"
                                    Margin="6,0,0,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="White"
                                    Cursor="Hand"
                                    Command="{Binding RemoveTagCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    ToolTip="حذف" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ورودی تگ جدید -->
        <TextBox x:Name="NewTagBox"
                 materialDesign:HintAssist.Hint="{Binding Placeholder, ElementName=Root}"
                 FontSize="12"
                 KeyDown="OnTagBoxKeyDown" />
    </StackPanel>
</UserControl>
