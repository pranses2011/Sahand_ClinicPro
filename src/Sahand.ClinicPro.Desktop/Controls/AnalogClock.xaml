<UserControl x:Class="Sahand.ClinicPro.Desktop.Controls.AnalogClock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="280" d:DesignWidth="280"
             FlowDirection="LeftToRight"
             x:Name="Root">
    <!-- ═══ ساعت آنالوگ نمایشگر سالن انتظار — چرخهٔ ۷۴ + اصلاحات چرخهٔ ۷۵ ═══
         گزارش مالک چرخهٔ ۷۵ (دو ایراد):
           ۱) «عقربه ثانیه تمام قطر ساعت است» — عقربهٔ قبلی تا لبهٔ صفحه می‌رسید؛
              اکنون طول عقربهٔ ثانیه ~۷۰٪ شعاع است (هم‌نسبت ساعت‌های واقعی) و
              دُم متعادل‌کنندهٔ کوتاه پشت مرکز دارد.
           ۲) «فقط ۴ شمارهٔ اصلی را دارد؛ خطوط ساعت و دقیقه هم می‌خواهم — خطوط
              ساعت کلفت‌تر» — ۶۰ خط نشانگر اضافه شد: ۱۲ خطِ ساعتِ کلفتِ روشن
              (هر ۳۰ درجه) + ۴۸ خطِ دقیقهٔ نازک کم‌رنگ؛ به‌علاوه همان برچسب‌های
              فارسی ۱۲/۳/۶/۹.
         حرکت پیوستهٔ ثانیه (سوپ نرم) و رنگ‌بندی تیرهٔ کیوسک حفظ شد. -->
    <Grid>
        <!-- هالهٔ بیرونی — حلقهٔ روشن دور صفحه برای جدایی از پس‌زمینهٔ تیره -->
        <Ellipse Fill="#101F31"
                 Stroke="#2C4A6E" StrokeThickness="2"
                 Opacity="0.9" />

        <!-- صفحهٔ اصلی — گرادیان شیشه‌ای تیره -->
        <Ellipse Margin="9">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.35,0.3" Center="0.5,0.45">
                    <GradientStop Color="#22405F" Offset="0" />
                    <GradientStop Color="#152A42" Offset="0.65" />
                    <GradientStop Color="#0E1E31" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#5B87B5" Offset="0" />
                    <GradientStop Color="#27415F" Offset="0.5" />
                    <GradientStop Color="#5B87B5" Offset="1" />
                </LinearGradientBrush>
            </Ellipse.Stroke>
        </Ellipse>

        <!-- ═══ نشانگرهای ساعت و دقیقه — چرخهٔ ۷۵ ═══
             ۱۲ خط کلفتِ ساعت (هر ۳۰ درجه) + ۴۸ خط نازک دقیقه؛ همه در کد
             پشت ساخته می‌شوند (CreateTickMarks) تا هندسه دقیق بماند و
             XAML شلوغ نشود. خطوط ساعت روشن‌تر/کلفت‌ترند (تشخیص فوری از دور). -->
        <Canvas x:Name="TickCanvas"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                IsHitTestVisible="False" />

        <!-- برچسب‌های ساعت — ۱۲ بالا / ۳ / ۶ / ۹ با ارقام فارسی
             (فاصله از لبه کمی بیشتر شد تا روی خطوط ساعتِ جدید ننشیند) -->
        <TextBlock Text="۱۲" FontSize="21" FontWeight="Bold" Foreground="#DCE9F7"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0" />
        <TextBlock Text="۶" FontSize="21" FontWeight="Bold" Foreground="#DCE9F7"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30" />
        <TextBlock Text="۳" FontSize="21" FontWeight="Bold" Foreground="#DCE9F7"
                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="31,0,0,1" />
        <TextBlock Text="۹" FontSize="21" FontWeight="Bold" Foreground="#DCE9F7"
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,31,1" />

        <!-- عقربه‌ها — حول مرکز؛ هر عقربه یک گرید چرخان است.
             نسبت‌های ساعت واقعی: ساعت ~۵۰٪ / دقیقه ~۷۰٪ / ثانیه ~۷۵٪ شعاع. -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
             Width="4" Height="140" RenderTransformOrigin="0.5,0.5"
             x:Name="HourHand">
            <Grid.RenderTransform>
                <RotateTransform x:Name="HourRotation" Angle="0" />
            </Grid.RenderTransform>
            <!-- عقربهٔ ساعت — کوتاه‌تر و پهن‌تر (۷۰px از ۱۴۰ = نصف قطر) -->
            <Rectangle Width="4.5" Height="70" VerticalAlignment="Top" RadiusX="2.5" RadiusY="2.5">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F2F7FC" Offset="0" />
                        <GradientStop Color="#B9CCE0" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
              Width="3" Height="190" RenderTransformOrigin="0.5,0.5"
              x:Name="MinuteHand">
            <Grid.RenderTransform>
                <RotateTransform x:Name="MinuteRotation" Angle="0" />
            </Grid.RenderTransform>
            <!-- عقربهٔ دقیقه — بلندتر (۹۶px از ۱۹۰ ≈ ۷۰٪ شعاع) -->
            <Rectangle Width="3" Height="96" VerticalAlignment="Top" RadiusX="2" RadiusY="2">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F2F7FC" Offset="0" />
                        <GradientStop Color="#AECBE8" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
        <!-- ═══ عقربهٔ ثانیه — اصلاح چرخهٔ ۷۵ ═══
             «تمام قطر ساعت بود» — قبلی ۱۷۰px تا لبه می‌رسید؛ اکنون نوکش
             ۱۰۴px از مرکز است (~۷۵٪ شعاع — نسبت استاندارد ساعت) + دُم ۲۲px
             متعادل‌کننده؛ حلقهٔ لغزش روی نوک حفظ شد (امضای بصری سوپِ نرم). -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
              Width="2" Height="152" RenderTransformOrigin="0.5,0.5"
              x:Name="SecondHand">
            <Grid.RenderTransform>
                <RotateTransform x:Name="SecondRotation" Angle="0" />
            </Grid.RenderTransform>
            <Rectangle Width="2" Height="104" VerticalAlignment="Top" Fill="#FF5252" RadiusX="1" RadiusY="1" />
            <Rectangle Width="2" Height="22" VerticalAlignment="Bottom" Fill="#FF8A80" RadiusX="1" RadiusY="1" />
            <Ellipse Width="9" Height="9" VerticalAlignment="Top" Margin="0,12,0,0"
                     Stroke="#FF5252" StrokeThickness="2" Fill="#152A42" />
        </Grid>

        <!-- مرکز — پیچ نگه‌دارندهٔ عقربه‌ها -->
        <Ellipse Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Fill="#F2F7FC" />
        <Ellipse Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Fill="#FF5252" />
    </Grid>
</UserControl>
