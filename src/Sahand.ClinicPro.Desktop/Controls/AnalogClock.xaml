<UserControl x:Class="Sahand.ClinicPro.Desktop.Controls.AnalogClock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="280" d:DesignWidth="280"
             FlowDirection="LeftToRight"
             x:Name="Root">
    <!-- ═══ ساعت آنالوگ نمایشگر سالن انتظار — چرخهٔ ۷۴ + ۷۵ + ۷۸ + ۷۹ ═══
         چرخهٔ ۷۹ (گزارش مالک: «برای ساعت هم تنظیمات بزار تا هم بتونیم صفحه
         ساعت و هم رنگشو تغییر بدیم»): دو ویژگی‌گی وابستگی تازه —
           • ClockFaceStyle: ۰ کلاسیک (۶۰ خط + اعداد ۱۲/۳/۶/۹) · ۱ اعداد کامل
             (۱۲ عدد فارسی) · ۲ مینیمال (فقط ۱۲ خط کلفت ساعت) — همه در کد
             پشت روی TickCanvas ساخته می‌شوند.
           • ClockColorTheme: ۰ نیلی (پیش‌فرض) · ۱ زمردی · ۲ کهربایی ·
             ۳ یاقوتی · ۴ نقره‌ای — همهٔ رنگ‌های صفحه/خطوط/اعداد/عقربه‌ها از
             پالت کد پشت اعمال می‌شوند؛ رنگ ثابتی در XAML نمانده است.
         اصلاح حیاتی چرخهٔ ۷۹ (گزارش مالک + اسکرین‌شات Clock.png): محور چرخش
         عقربهٔ ثانیه ۴۱px پایین‌تر از مرکز ساعت بود — گرید با مارجین −۴۱ بالا
         رفت تا مرز نوک/دُم دقیقاً روی مرکز بنشیند (شرح در کامنت عقربه).
         حرکت پیوستهٔ ثانیه (سوپ نرم چرخهٔ ۷۴) حفظ شد. -->
    <Grid>
        <!-- هالهٔ بیرونی — حلقهٔ دور صفحه؛ رنگ از پالت (ApplyTheme) -->
        <Ellipse x:Name="OuterRing"
                 StrokeThickness="2"
                 Opacity="0.9" />

        <!-- صفحهٔ اصلی — گرادیان شیشه‌ای؛ گرادیان از پالت ساخته می‌شود -->
        <Ellipse x:Name="FaceEllipse" Margin="9" StrokeThickness="1.4" />

        <!-- نشانگرها و اعداد — چرخهٔ ۷۹: همهٔ اقلام صفحه (خطوط ساعت/دقیقه و
             اعداد فارسی) بسته به ClockFaceStyle در کد پشت ساخته می‌شوند -->
        <Canvas x:Name="TickCanvas"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                IsHitTestVisible="False" />

        <!-- عقربه‌ها — حول مرکز؛ هر عقربه یک گرید چرخان است.
             نسبت‌های ساعت واقعی: ساعت ~۵۰٪ / دقیقه ~۷۰٪ / ثانیه ~۷۵٪ شعاع.
             رنگ مستطیل‌ها از پالت (ApplyTheme) اعمال می‌شود. -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
             Width="4" Height="140" RenderTransformOrigin="0.5,0.5"
             x:Name="HourHand">
            <Grid.RenderTransform>
                <RotateTransform x:Name="HourRotation" Angle="0" />
            </Grid.RenderTransform>
            <!-- عقربهٔ ساعت — کوتاه‌تر و پهن‌تر (۷۰px از ۱۴۰ = نصف قطر) -->
            <Rectangle x:Name="HourRect" Width="4.5" Height="70" VerticalAlignment="Top" RadiusX="2.5" RadiusY="2.5" />
        </Grid>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
              Width="3" Height="190" RenderTransformOrigin="0.5,0.5"
              x:Name="MinuteHand">
            <Grid.RenderTransform>
                <RotateTransform x:Name="MinuteRotation" Angle="0" />
            </Grid.RenderTransform>
            <!-- عقربهٔ دقیقه — بلندتر (۹۶px از ۱۹۰ ≈ ۷۰٪ شعاع) -->
            <Rectangle x:Name="MinuteRect" Width="3" Height="96" VerticalAlignment="Top" RadiusX="2" RadiusY="2" />
        </Grid>
        <!-- عقربهٔ ثانیه حول نقطهٔ مرکزیِ گرید می‌چرخد: گرید ۲۰۸px ارتفاع دارد،
             پس مرکز چرخش در ۱۰۴px از بالا و دقیقاً روی مرکز ساعت است؛ نوک ۱۰۴px
             به سمت بالا و دُم ۲۲px به سمت پایین امتداد می‌یابد. -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
              Width="2" Height="208" RenderTransformOrigin="0.5,0.5"
              x:Name="SecondHand">
            <Grid.RenderTransform>
                <RotateTransform x:Name="SecondRotation" Angle="0" />
            </Grid.RenderTransform>
            <!-- نوک — ۱۰۴px بالای محور (~۷۵٪ شعاع) -->
            <Rectangle x:Name="SecondTipRect" Width="2" Height="104" VerticalAlignment="Top" RadiusX="1" RadiusY="1" />
            <!-- دُم متعادل‌کننده — ۲۲px زیر محور، چسبیده به نوک (بدون شکاف) -->
            <Rectangle x:Name="SecondTailRect" Width="2" Height="22" VerticalAlignment="Top" Margin="0,104,0,0" RadiusX="1" RadiusY="1" />
            <!-- حلقهٔ لغزش روی نوک — امضای بصری سوپِ نرم -->
            <Ellipse x:Name="SecondBalanceRing" Width="9" Height="9" VerticalAlignment="Top" Margin="0,12,0,0"
                     StrokeThickness="2" />
        </Grid>

        <!-- مرکز — پیچ نگه‌دارندهٔ عقربه‌ها -->
        <Ellipse x:Name="CenterOuter" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Ellipse x:Name="CenterInner" Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</UserControl>
