<UserControl x:Class="Sahand.ClinicPro.Desktop.Controls.TimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FlowDirection="RightToLeft"
             Focusable="True">
    <!-- ═══════════════════════════════════════════════════════════
         انتخابگر ساعت — چرخه بیست‌ویکم (گزارش پانزدهم مالک):
         «ساعت‌هایی که برای شروع و پایان و استراحت‌ها تنظیم می‌کنیم را طوری
         بکن که با کلیک روی آن با یک کنترل انتخاب ساعت انتخاب کنیم»
         جعبهٔ متن فقط-خواندنی «08:30» + پاپ‌آپ دوستونی ساعت/دقیقه؛
         خروجی متن HH:mm از طریق وابستگی TimeText (دوطرفه).
         ═══════════════════════════════════════════════════════════ -->
    <Grid>
        <!-- دکمهٔ بازکردن پاپ‌آپ — ظاهر هم‌خانوادهٔ TextBox متریال -->
        <ToggleButton x:Name="Toggle"
                      Checked="OnToggleChecked"
                      Unchecked="OnToggleUnchecked"
                      Cursor="Hand">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{DynamicResource MaterialDesign.Brush.Background}"
                            BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.OutlineBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,5"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClockOutline"
                                                     Width="15" Height="15"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                     Opacity="0.8" />
                            <TextBlock x:Name="TimeTextBlock"
                                       Text="{Binding TimeText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                       Margin="6,0,0,0"
                                       MinWidth="38"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <!-- پاپ‌آپ انتخاب ساعت و دقیقه -->
        <Popup x:Name="PickerPopup"
               PlacementTarget="{Binding ElementName=Toggle}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{DynamicResource MaterialDesign.Brush.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="12"
                    Padding="4"
                    Effect="{StaticResource MaterialDesignShadowDepth2}"
                    Width="236">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- سربرگ ستون‌ها -->
                    <Grid Grid.Row="0" Margin="4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ساعت"
                                   FontSize="11" Opacity="0.6"
                                   HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="دقیقه"
                                   FontSize="11" Opacity="0.6"
                                   HorizontalAlignment="Center" />
                    </Grid>

                    <!-- دو لیست اسکرولی — ساعت ۰ تا ۲۳ و دقیقه ۵ در ۵ -->
                    <Grid Grid.Row="1" Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="HoursList"
                                 Grid.Column="0"
                                 BorderThickness="0"
                                 MaxHeight="186"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 SelectionChanged="OnHoursChanged" />
                        <ListBox x:Name="MinutesList"
                                 Grid.Column="1"
                                 BorderThickness="0"
                                 MaxHeight="186"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 SelectionChanged="OnMinutesChanged" />
                    </Grid>

                    <!-- دکمه‌های تأیید و پاک‌کردن -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,6,0,2">
                        <Button Content="پاک کردن"
                                Click="OnClearClick"
                                FontSize="11"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Padding="10,4" Margin="0,0,6,0" />
                        <Button Content="تأیید"
                                Click="OnAcceptClick"
                                FontSize="11"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Padding="14,4" />
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
