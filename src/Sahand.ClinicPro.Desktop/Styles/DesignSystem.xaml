<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <!-- ═══════════════════════════════════════════════════════════════
         سیستم طراحی واحدِ شش صفحهٔ بازطراحیشده — مستخرج از همان سبکی که
         مالک در صفحهٔ تصویربرداری تأیید کرد و سپس در قالب هشت فایل HTML
         (docs/design/approved/*.html + base.css) برای صفحات هدف گسترش یافت.

         هدف: کارتهای آماری پنجگانهٔ تمامعرض، دکمههای تخت، چیپهای کپسولی،
         تبهای زیرخطدار و جداول راهراه — همگیدر یک بوم ۱۰۳۰×۷۷۴ تا
         اسکرینشات واقعی WPF با رندر طرح HTML پیکسلبهپیکسل قابلمقایسه باشد.
         ═══════════════════════════════════════════════════════════════ -->

    <!-- ── قلمها و رنگهای پایه (همان مقادیر base.css) ── -->
    <SolidColorBrush x:Key="Ds.PageBackground" Color="#EEF3F8" />
    <SolidColorBrush x:Key="Ds.CardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Ds.CardBorder" Color="#D9E2EC" />
    <SolidColorBrush x:Key="Ds.Text" Color="#172B4D" />
    <SolidColorBrush x:Key="Ds.MutedText" Color="#6B7C93" />
    <SolidColorBrush x:Key="Ds.Primary" Color="#1565C0" />
    <SolidColorBrush x:Key="Ds.PrimarySoft" Color="#E3F0FB" />
    <SolidColorBrush x:Key="Ds.RowZebra" Color="#F6F9FC" />
    <SolidColorBrush x:Key="Ds.Green" Color="#0D9488" />
    <SolidColorBrush x:Key="Ds.GreenSoft" Color="#E8F7F4" />
    <SolidColorBrush x:Key="Ds.Amber" Color="#D97706" />
    <SolidColorBrush x:Key="Ds.AmberSoft" Color="#FFF7ED" />
    <SolidColorBrush x:Key="Ds.Violet" Color="#7C3AED" />
    <SolidColorBrush x:Key="Ds.VioletSoft" Color="#F5F0FF" />
    <SolidColorBrush x:Key="Ds.Red" Color="#DC2626" />
    <SolidColorBrush x:Key="Ds.RedSoft" Color="#FEF2F2" />
    <SolidColorBrush x:Key="Ds.BlueSoft" Color="#F5FAFF" />

    <!-- ── سربرگ صفحه ── -->
    <Style x:Key="Ds.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Ds.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Ds.PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource Ds.MutedText}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style x:Key="Ds.Muted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource Ds.MutedText}" />
    </Style>

    <!-- ── کارت آماری (همان StatCard تصویربرداری) ── -->
    <Style x:Key="Ds.StatCard" TargetType="Button">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="1.6" />
        <Setter Property="Height" Value="76" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{DynamicResource App.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Ds.StatNumber" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource App.FontFamily}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="LineHeight" Value="30" />
    </Style>
    <Style x:Key="Ds.StatLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Opacity" Value="0.72" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource Ds.Text}" />
    </Style>

    <!-- ── دکمهها ── -->
    <Style x:Key="Ds.FlatPrimary" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="38" />
        <Setter Property="FontFamily" Value="{DynamicResource App.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="#1565C0" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Ds.FlatGhost" TargetType="Button">
        <Setter Property="Foreground" Value="#1565C0" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="38" />
        <Setter Property="FontFamily" Value="{DynamicResource App.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="#E3F0FB" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Ds.OutlineButton" TargetType="Button">
        <Setter Property="Foreground" Value="#41586C" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FontFamily" Value="{DynamicResource App.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="White" BorderBrush="#C9D6E4" BorderThickness="1"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── چیپها ── -->
    <Style x:Key="Ds.Chip" TargetType="Button">
        <Setter Property="Padding" Value="12,3" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Foreground" Value="#41586C" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="27" />
        <Setter Property="FontFamily" Value="{DynamicResource App.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="White" BorderBrush="#B9C9D8" BorderThickness="1.2"
                            CornerRadius="16" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Ds.ChipActive" TargetType="Button" BasedOn="{StaticResource Ds.Chip}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="#1565C0" BorderBrush="#1565C0" BorderThickness="1.2"
                            CornerRadius="16" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- برچسبهای وضعیت کوچک (غیرقابلکلیک) -->
    <Style x:Key="Ds.Tag" TargetType="Border">
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="#E8F5E9" />
        <Setter Property="BorderBrush" Value="#A5D6A7" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="Ds.TagText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#2E7D32" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ── پنلها و عنوانها ── -->
    <Style x:Key="Ds.Panel" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#D9E2EC" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="9" />
    </Style>
    <Style x:Key="Ds.PanelTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#123352" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="Ds.FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="#6B7C93" />
        <Setter Property="Margin" Value="2,3,2,0" />
    </Style>
    <Style x:Key="Ds.FieldValue" TargetType="Border">
        <Setter Property="Background" Value="#F8FBFE" />
        <Setter Property="BorderBrush" Value="#D9E2EC" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Height" Value="26" />
    </Style>

    <!-- ── نوار تبهای زیرخطدار (طرح تأییدی) ── -->
    <Style x:Key="Ds.TabBar" TargetType="Border">
        <Setter Property="BorderBrush" Value="#D9E2EC" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Ds.TabItemText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#6B7C93" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style x:Key="Ds.TabItemActiveText" TargetType="TextBlock" BasedOn="{StaticResource Ds.TabItemText}">
        <Setter Property="Foreground" Value="#1565C0" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Background" Value="#EAF3FD" />
    </Style>

    <!-- ── فیلدهای فشرده ── -->
    <Style x:Key="Ds.CompactText" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource App.FontFamily}" />
        <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
        <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="9" />
    </Style>
    <Style x:Key="Ds.CompactCombo" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource App.FontFamily}" />
        <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
        <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="9" />
    </Style>

    <!-- ── نوار ابزار و جداول ── -->
    <Style x:Key="Ds.Toolbar" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#D9E2EC" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Ds.TableHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#123352" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="4,5" />
    </Style>
    <Style x:Key="Ds.TableCellText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="#22364F" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="4,4" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- سرستون جدول — طرح تأییدی: تکخط، وسطچین، زمینهٔ آبی بسیار روشن.
         استایل ضمنی MaterialDesign سرستونها را با الگوی App.TableHeaderContentTemplate
         (TextWrapping=Wrap) چندخطی میکند و عنوانهای کوتاهی مثل «دندان» را
         به دوخط میشکند؛ این استایل صریح آن الگو را بازنویسی میکند. -->
    <Style x:Key="Ds.TableColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#EDF3FA" />
        <Setter Property="Foreground" Value="#123352" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="2,4" />
        <Setter Property="BorderBrush" Value="#D9E2EC" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10.5" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Ds.TableHeaderRow" TargetType="Border">
        <Setter Property="Background" Value="#EDF3FA" />
        <Setter Property="BorderBrush" Value="#D9E2EC" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="7,7,0,0" />
    </Style>
    <Style x:Key="Ds.TableDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeight" Value="30" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontFamily" Value="{DynamicResource App.FontFamily}" />
        <Setter Property="AlternatingRowBackground" Value="#F6F9FC" />
    </Style>
    <Style x:Key="Ds.ProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="9" />
        <Setter Property="Foreground" Value="#1565C0" />
        <Setter Property="Background" Value="#E8EEF5" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
</ResourceDictionary>
