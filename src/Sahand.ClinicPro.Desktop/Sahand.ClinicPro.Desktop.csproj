<Project Sdk="Microsoft.NET.Sdk">
  <!-- ═══════════════════════════════════════════════════════════════
       کلاینت دسکتاپ (Desktop) — WPF + Material Design با الگوی MVVM
       نکته: این پروژه به‌صورت دستی ساخته شده است زیرا قالب WPF
       روی محیط لینوکسی CI موجود نیست. ویژگی EnableWindowsTargeting
       (در Directory.Build.props) ساخت آن را روی لینوکس ممکن می‌کند.
       راه‌اندازی کامل (تم، فونت وزیرمتن، ناوبری) در گام ۱۰ انجام می‌شود.
       ═══════════════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- TFM بدون شماره نسخه = پشتیبانی از ویندوز ۷ به بالا؛
         مناسب سیستم‌های قدیمی محیط درمانی که هنوز روی ویندوز ۷/۱۰ هستند -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- انتخاب‌گر پوشهٔ استاندارد ویندوز (FolderBrowserDialog) برای دکمهٔ
         «انتخاب پوشه» بکاپ — توجه: UseWindowsForms فعال نمی‌شود چون usingهای
         سراسری ویندوزفرم (Brush/Color/UserControl و…) با WPF تداخل ساخت
         می‌دهند؛ فقط ارجاع اسمبلی ویندوزفرم افزوده می‌شود (همان فریم‌ورک
         اشتراکی WindowsDesktop که WPF هم از آن می‌آید). -->
    <!-- آیکون رسمی محصول (لوگوی ClinicPro) — در فایل exe جاسازی می‌شود
         تا در Explorer، Taskbar و میانبرها نمایش داده شود -->
    <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <!-- کتابخانه رابط کاربری Material Design (MD3) -->
    <PackageReference Include="MaterialDesignThemes" />
    <!-- MVVM مدرن با Source Generator (ObservableObject، RelayCommand و...) -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- تزریق وابستگی و پیکربندی سمت کلاینت -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <!-- اتصال بلادرنگ SignalR — Hubهای صف و اعلان (گام R1) -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <!-- چرخهٔ ۶۹ (فاز ۳ / F-01/F-02): تولید QR چاپی — نسخه (راستی‌آزمایی) و برچسب نمونه -->
    <PackageReference Include="QRCoder" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <!-- جاسازی آیکون به‌عنوان Resource وردپ‌اف — مرجع سبک سراسری Icon در App.xaml -->
    <Resource Include="Assets\appicon.ico" />
    <!-- چرخه ۲۴: لوگوی بزرگ باکیفیت از docs/assets/ClinicPro.png — سایدبار/لاگین/اسپلش -->
    <Resource Include="Assets\Logo\ClinicPro-512.png" />
    <!-- نقشهٔ بدن فیزیوتراپی (طرح تأییدشدهٔ مالک): تصویر پایهٔ مرد/زن + ماسک ۲۶ ناحیه برای هر پیکر -->
    <Resource Include="Assets\Physio\*.png" />
    <Resource Include="Assets\Logo\ClinicPro-256.png" />
    <!-- فونت وزیرمتن (مجوز آزاد OFL) به‌عنوان Resource داخل exe جاسازی می‌شود تا
         بدون نصب فونت روی ویندوز کاربر، همه فرم‌ها با pack URI زیر آن را ببینند:
         pack://application:,,,/Assets/Fonts/#Vazirmatn
         نکته: ارجاع به «پوشه» (نه فایل تکی) عمدی است تا WPF همه وزن‌های
         خانواده (Regular/SemiBold/Bold/Black) را هم‌زمان بارگیری کند.
         گزارش هشتم مالک: فونت وزیر در هیچ فرمی اعمال نمی‌شد چون ارجاعِ
         نامی «Vazirmatn» فقط فونت‌های نصب‌شدهٔ ویندوز را می‌بیند. -->
    <Resource Include="Assets\Fonts\Vazirmatn-Regular.ttf" />
    <Resource Include="Assets\Fonts\Vazirmatn-SemiBold.ttf" />
    <Resource Include="Assets\Fonts\Vazirmatn-Bold.ttf" />
    <Resource Include="Assets\Fonts\Vazirmatn-Black.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- دسترسی به DTOها و قراردادهای مشترک (ارتباط با API از طریق REST) -->
    <ProjectReference Include="..\Sahand.ClinicPro.Application\Sahand.ClinicPro.Application.csproj" />
    <ProjectReference Include="..\Sahand.ClinicPro.Shared\Sahand.ClinicPro.Shared.csproj" />
  </ItemGroup>
</Project>
