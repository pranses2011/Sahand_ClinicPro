<Project Sdk="Microsoft.NET.Sdk">
  <!-- ═══════════════════════════════════════════════════════════════
       کلاینت دسکتاپ (Desktop) — WPF + Material Design با الگوی MVVM
       نکته: این پروژه به‌صورت دستی ساخته شده است زیرا قالب WPF
       روی محیط لینوکسی CI موجود نیست. ویژگی EnableWindowsTargeting
       (در Directory.Build.props) ساخت آن را روی لینوکس ممکن می‌کند.
       راه‌اندازی کامل (تم، فونت وزیرمتن، ناوبری) در گام ۱۰ انجام می‌شود.
       ═══════════════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- TFM بدون شماره نسخه = پشتیبانی از ویندوز ۷ به بالا؛
         مناسب سیستم‌های قدیمی محیط درمانی که هنوز روی ویندوز ۷/۱۰ هستند -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- آیکون رسمی محصول (لوگوی ClinicPro) — در فایل exe جاسازی می‌شود
         تا در Explorer، Taskbar و میانبرها نمایش داده شود -->
    <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- کتابخانه رابط کاربری Material Design (MD3) -->
    <PackageReference Include="MaterialDesignThemes" />
    <!-- MVVM مدرن با Source Generator (ObservableObject، RelayCommand و...) -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- تزریق وابستگی و پیکربندی سمت کلاینت -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <!-- اتصال بلادرنگ SignalR — Hubهای صف و اعلان (گام R1) -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <!-- جاسازی آیکون به‌عنوان Resource وردپ‌اف — مرجع سبک سراسری Icon در App.xaml -->
    <Resource Include="Assets\appicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- دسترسی به DTOها و قراردادهای مشترک (ارتباط با API از طریق REST) -->
    <ProjectReference Include="..\Sahand.ClinicPro.Application\Sahand.ClinicPro.Application.csproj" />
    <ProjectReference Include="..\Sahand.ClinicPro.Shared\Sahand.ClinicPro.Shared.csproj" />
  </ItemGroup>
</Project>
