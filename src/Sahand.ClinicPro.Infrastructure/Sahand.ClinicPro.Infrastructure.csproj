<Project Sdk="Microsoft.NET.Sdk">
  <!-- ═══════════════════════════════════════════════════════════════
       لایه زیرساخت (Infrastructure Layer) — پیاده‌سازی‌های فنی
       شامل: EF Core (DbContext، ریپازیتوری، UnitOfWork، Migration)،
       امنیت (JWT، BCrypt، AES-256)، پیامک، اتصال به سامانه‌های دولتی،
       کارهای پس‌زمینه Hangfire و سرویس لایسنس
       ═══════════════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- ORM مطابق مستندات: EF Core 8 + SQL Server 2022 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- اجزای زمان‌طراحی ابزار dotnet-ef (چرخه ۲۵) — فقط ابزار، در خروجی
         منتشر نمی‌شود؛ برای اجرای دستورات EF روی همین پروژه با
         DesignTimeDbContextFactory لازم است -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- هش رمز عبور BCrypt با Work Factor 12 (گام ۴) -->
    <PackageReference Include="BCrypt.Net-Next" />
    <!-- کارهای پس‌زمینه: صف پیامک، یادآوری نوبت، بکاپ، Heartbeat لایسنس -->
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.SqlServer" />
    <!-- انتزاع‌های مورد نیاز متد الحاقی AddInfrastructure -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- احراز هویت JWT Bearer -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- خروجی PDF گزارش‌ها با سربرگ درمانگاه (چرخه سیزدهم، D6) -->
    <PackageReference Include="QuestPDF" />
    <!-- دسترسی به HttpContext برای سرویس کاربر فعلی -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- وابستگی به لایه کاربرد (و از آن طریق به لایه دامنه) -->
    <ProjectReference Include="..\Sahand.ClinicPro.Application\Sahand.ClinicPro.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- فونت‌های فارس وزیرمتن به‌عنوان منبع جاسازی‌شده — خروجی PDF گزارش‌ها (چرخه ۱۳، D6) -->
    <EmbeddedResource Include="Assets\Fonts\Vazirmatn-Regular.ttf" />
    <EmbeddedResource Include="Assets\Fonts\Vazirmatn-Bold.ttf" />
  </ItemGroup>
</Project>
