<Project Sdk="Microsoft.NET.Sdk">
  <!-- ═══════════════════════════════════════════════════════════════
       تست‌های واحد ViewModelهای دسکتاپ — چرخه دوازدهم (C1، بند ۴-۱)
       با کلاینت API ساختگی — جریان‌های پول‌ساز بدون نیاز به سرور
       ─────────────────────────────────────────────────────────────
       📌 چرخه بیست‌ودوم — رفع خطای CS0006 در «Rebuild Solution»:
       پیش‌تر این پروژه به‌جای ProjectReference، از ارجاع مستقیم DLL
       (HintPath به پوشهٔ bin دسکتاپ) + هدفِ «اول دسکتاپ را بساز»
       استفاده می‌کرد. عیب بزرگ این الگو:
       ● Visual Studio گراف ترتیب ساخت پروژه‌ها را از روی
           ProjectReferenceها می‌سازد؛ چون این پروژه هیچ
           ProjectReference‌ای به دسکتاپ نداشت، VS می‌توانست تست‌ها
           را هم‌زمان با (یا حتی قبل از) ساخت دسکتاپ بیلد کند.
       ● در Rebuild Solution اول همه‌چیز Clean می‌شود (DLL دسکتاپ
           حذف می‌شود)؛ اگر کامپایل تست‌ها قبل از تولید مجدد DLL
           اجرا شود → خطای آبشاری:
           CS0006 «Metadata file ...Sahand.ClinicPro.Desktop.dll
           could not be found» در همین پروژهٔ UnitTests.
       ● هدفِ BuildDesktopFirst هم در VS وضع را بدتر می‌کرد: با نبود
           DLL، یک بیلدِ تودرتو (nested MSBuild) از همان پروژهٔ
           دسکتاپی که VS خودش به‌صورت موازی در حال بیلدش بود
           راه می‌انداخت → قفل فایل ویندوزی روی خروجی‌های میانی
           (obj\*.g.cs و DLL/PDB) → شکست یکی از دو بیلد.
       ✅ راه‌حل قطعی (این فایل):
       ۱) TargetFramework از net8.0 به net8.0-windows تغییر کرد تا
          ProjectReference به پروژهٔ دسکتاپِ net8.0-windows مجاز
          باشد (ناسازگاری NuGet معروفِ NU1201 فقط در حالت net8.0
          رخ می‌داد — دلیل اصلی هکِ DLL در گذشته همین بود).
       ۲) ارجاع استاندارد ProjectReference جایگزین هک DLL شد؛ اکنون
          MSBuild و VS همیشه دسکتاپ را «قبل از» تست‌ها می‌سازند —
          چه در Build چه در Rebuild — و دیگری ناممکن است.
       ۳) برکود حذف شد: هشدارهای MSB3277 (تعارض اسمبلی‌های
          WindowsBase و ...) و CA1416 مرتبط با ارجاع دستی حذف شدند.
       نکتهٔ اجرا: هیچ تستی در زمان اجرا به نوع‌های WPF دست نمی‌زند
       (ViewModelها فاقد وابستگی به System.Windows هستند)؛ از این‌رو
       اجرای تست روی ویندوز و لینوکس/CI (با EnableWindowsTargeting)
       هر دو ممکن است.
       ═══════════════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <!-- هم‌TFM با پروژهٔ دسکتاپ (net8.0-windows) تا ارجاع استاندارد
         ProjectReference به آن معتبر باشد — پیش‌نیاز رفع CS0006 -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <!-- ساخت پروژهٔ ویندوزی (WPF) روی لینوکس/CI نیز ممکن باشد؛
         زمان اجرای تست‌ها به نوع‌های WPF اشاره‌ای نیست -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- ═══ ارجاع استاندارد به پروژه‌های سورس ═══
         MSBuild از روی همین ارجاع‌ها گراف ترتیب ساخت را می‌سازد:
         ۱) دسکتاپ همیشه پیش از این پروژهٔ تست ساخته می‌شود
            (رفع دائمی CS0006 در Rebuild Solution)
         ۲) وابستگی‌های انتقالی (CommunityToolkit.Mvvm و ...)
            به‌صورت خودکار منتقل می‌شوند
         ۳) همیشه DLL تازهٔ دسکتاپ مبنای کامپایل تست‌هاست؛
            حتی پس از Clean کامل بدون هیچ هک اضافه‌ای -->
    <ProjectReference Include="..\..\src\Sahand.ClinicPro.Desktop\Sahand.ClinicPro.Desktop.csproj" />
    <ProjectReference Include="..\..\src\Sahand.ClinicPro.Application\Sahand.ClinicPro.Application.csproj" />
    <ProjectReference Include="..\..\src\Sahand.ClinicPro.Shared\Sahand.ClinicPro.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- وابستگی‌های آزمون‌سازی (نسخه‌ها در Directory.Packages.props مرکزی‌اند)
         نکته: CommunityToolkit.Mvvm از دسکتاپ هم انتقالی می‌رسد؛
         ذکر صریح برای شفافیت استفادهٔ مستقیم تست‌ها از ObservableObject -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
