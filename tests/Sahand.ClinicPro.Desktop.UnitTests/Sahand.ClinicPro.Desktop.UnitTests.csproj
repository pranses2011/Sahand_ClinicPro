<Project Sdk="Microsoft.NET.Sdk">
  <!-- ═══════════════════════════════════════════════════════════════
       تست‌های واحد ViewModelهای دسکتاپ — چرخه دوازدهم (C1، بند ۴-۱)
       با کلاینت API ساختگی — جریان‌های پول‌ساز بدون نیاز به سرور
       نکته فنی: پروژه دسکتاپ net8.0-windows است و در NuGet با net8.0
       ناسازگار شمرده می‌شود؛ از این‌رو ارجاع مستقیم DLL + هدفِ
       «اول دسکتاپ را بساز» به‌کار رفته تا ترتیب ساخت تضمین شود.
       ViewModelهای هدف هیچ وابستگی به فضای‌نام System.Windows ندارند
       و روی لینوکس هم اجرای تست میسر است.
       ═══════════════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- نکته: ~۶۲ هشدار اطلاع‌رسانی MSB3277 (تعارض نسخه اسمبلی‌های WindowsBase و ...)
         ناشی از ارجاع مستقیم DLL دسکتاپ است — بی‌ضرر و مورد انتظار؛ تست‌ها سبزند.
         پروژه‌های سورس بدون هیچ هشدار بیلد می‌شوند. -->
    <!-- خروجی دسکتاپ برای ارجاع HintPath -->
    <DesktopDll>..\..\src\Sahand.ClinicPro.Desktop\bin\$(Configuration)\net8.0-windows\Sahand.ClinicPro.Desktop.dll</DesktopDll>
  </PropertyGroup>

  <!-- ترتیب ساخت: ابتدا پروژه دسکتاپ ساخته شود تا DLL موجود باشد -->
  <Target Name="BuildDesktopFirst" BeforeTargets="BeforeBuild" Condition="!Exists('$(DesktopDll)')">
    <MSBuild Projects="..\..\src\Sahand.ClinicPro.Desktop\Sahand.ClinicPro.Desktop.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
  </Target>

  <ItemGroup>
    <!-- ارجاع مستقیم به اسمبلی دسکتاپ (بدون بررسی سازگاری NuGet) -->
    <Reference Include="Sahand.ClinicPro.Desktop">
      <HintPath>$(DesktopDll)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- لایه‌های سازگار net8.0 — برای PersianDateHelper و DTOها -->
    <ProjectReference Include="..\..\src\Sahand.ClinicPro.Application\Sahand.ClinicPro.Application.csproj" />
    <ProjectReference Include="..\..\src\Sahand.ClinicPro.Shared\Sahand.ClinicPro.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- وابستگی‌های موردنیام ViewModelها — با ارجاع مستقیم DLL منتقل نمی‌شوند -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
